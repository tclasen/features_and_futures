data: {"type":"response.function_call_arguments.done","sequence_number":885,"item_id":"fc_0273ab5c368f898c016acae7220f3c819484764461a71be87e","output_index":1,"arguments":"{\"path\":\"server.js\",\"edits\":[{\"oldText\":\"if (!db.prepare('PRAGMA table_info(tasks)').all().some(c => c.name === 'notes')) db.exec(\\\"ALTER TABLE tasks ADD COLUMN notes TEXT NOT NULL DEFAULT ''\\\");\",\"newText\":\"if (!db.prepare('PRAGMA table_info(tasks)').all().some(c => c.name === 'notes')) db.exec(\\\"ALTER TABLE tasks ADD COLUMN notes TEXT NOT NULL DEFAULT ''\\\");\\nif (!db.prepare('PRAGMA table_info(tasks)').all().some(c => c.name === 'deleted')) db.exec('ALTER TABLE tasks ADD COLUMN deleted INTEGER NOT NULL DEFAULT 0');\"},{\"oldText\":\"<option>Completed</option></select>\",\"newText\":\"<option>Completed</option><option>Deleted</option></select>\"},{\"oldText\":\"if((filter.value==='Open'&&t.completed)||(filter.value==='Completed'&&!t.completed)||(priorityFilter.value!=='All'&&priorityFilter.value!==(t.priority||'Normal')))continue;\",\"newText\":\"if((filter.value==='Deleted'&&!t.deleted)||(filter.value!=='Deleted'&&t.deleted)||(filter.value==='Open'&&t.completed)||(filter.value==='Completed'&&!t.completed)||(priorityFilter.value!=='All'&&priorityFilter.value!==(t.priority||'Normal')))continue;\"},{\"oldText\":\"checkbox.disabled=!!p.archived;checkbox.setAttribute\",\"newText\":\"checkbox.disabled=!!p.archived||!!t.deleted;checkbox.setAttribute\"},{\"oldText\":\"renameInput.disabled=!!p.archived;const renameButton\",\"newText\":\"renameInput.disabled=!!p.archived||!!t.deleted;const renameButton\"},{\"oldText\":\"renameButton.disabled=!!p.archived;renameForm.append\",\"newText\":\"renameButton.disabled=!!p.archived||!!t.deleted;renameForm.append\"},{\"oldText\":\"priority.disabled=!!p.archived;priority.onchange\",\"newText\":\"priority.disabled=!!p.archived||!!t.deleted;priority.onchange\"},{\"oldText\":\"dueInput.disabled=!!p.archived;const dueButton\",\"newText\":\"dueInput.disabled=!!p.archived||!!t.deleted;const dueButton\"},{\"oldText\":\"dueButton.disabled=!!p.archived;dueForm.append\",\"newText\":\"dueButton.disabled=!!p.archived||!!t.deleted;dueForm.append\"},{\"oldText\":\"moveButton.disabled=!!p.archived||destinations.options.length===0;\",\"newText\":\"moveButton.disabled=!!p.archived||!!t.deleted||destinations.options.length===0;\"},{\"oldText\":\"notes.disabled=!!p.archived;const notesButton\",\"newText\":\"notes.disabled=!!p.archived||!!t.deleted;const notesButton\"},{\"oldText\":\"notesButton.disabled=!!p.archived;notesForm.append\",\"newText\":\"notesButton.disabled=!!p.archived||!!t.deleted;notesForm.append\"},{\"oldText\":\"row.append(title,checkbox,renameForm,priority,dueForm,notesForm,destinations,moveButton);section.append(row)\",\"newText\":\"const deleteButton=document.createElement('button');deleteButton.textContent=t.deleted?'Restore task':'Delete task';deleteButton.disabled=!!p.archived;deleteButton.onclick=async()=>{await fetch('/api/tasks/'+t.id+(t.deleted?'/restore':'/delete'),{method:'POST'});load()};row.append(title,checkbox,renameForm,priority,dueForm,notesForm,destinations,moveButton,deleteButton);section.append(row)\"},{\"oldText\":\"COUNT(t.id) totalCount,COALESCE(SUM(t.completed),0) completedCount\",\"newText\":\"SUM(CASE WHEN t.deleted=0 THEN 1 ELSE 0 END) totalCount,COALESCE(SUM(CASE WHEN t.deleted=0 THEN t.completed ELSE 0 END),0) completedCount\"},{\"oldText\":\"SELECT id,project_id AS projectId,title,completed,priority,due_date AS dueDate,notes FROM tasks WHERE project_id=? ORDER BY project_order,id\",\"newText\":\"SELECT id,project_id AS projectId,title,completed,priority,due_date AS dueDate,notes,deleted FROM tasks WHERE project_id=? ORDER BY project_order,id\"}]}"}

