.append(row)\",\"newText\":\"const deleteButton=document.createElement('button');deleteButton.textContent=t.deleted?'Restore task':'Delete task';deleteButton.disabled=!!p.archived;deleteButton.onclick=async()=>{await fetch('/api/tasks/'+t.id+(t.deleted?'/restore':'/delete'),{method:'POST'});load()};row.append(title,checkbox,renameForm,priority,dueForm,notesForm,destinations,moveButton,deleteButton);section.append(row)\"},{\"oldText\":\"COUNT(t.id) totalCount,COALESCE(SUM(t.completed),0) completedCount\",\"newText\":\"SUM(CASE WHEN t.deleted=0 THEN 1 ELSE 0 END) totalCount,COALESCE(SUM(CASE WHEN t.deleted=0 THEN t.completed ELSE 0 END),0) completedCount\"},{\"oldText\":\"SELECT id,project_id AS projectId,title,completed,priority,due_date AS dueDate,notes FROM tasks WHERE project_id=? ORDER BY project_order,id\",\"newText\":\"SELECT id,project_id AS projectId,title,completed,priority,due_date AS dueDate,notes,deleted FROM tasks WHERE project_id=? ORDER BY project_order,id\"}]}","status":"completed"}],"error":null,"incomplete_details":null,"tools":[{"type":"function","name":"read","description":"Read the contents of a file. Supports text files and images (jpg, png, gif, webp, bmp). Images are sent as attachments. For text files, output is truncated to 2000 lines or 50KB (whichever is hit first). Use offset/limit for large files. When you need the full file, continue with offset until complete.","parameters":{"type":"object","required":["path","offset","limit"],"properties":{"path":{"type":"string","description":"Path to the file to read (relative or absolute)"},"offset":{"anyOf":[{"type":"number","description":"Line number to start reading from (1-indexed)"},{"type":"null"}]},"limit":{"anyOf":[{"type":"number","description":"Maximum number of lines to read"},{"type":"null"}]}},"additionalProperties":false},"output_schema":null,"strict":true},{"type":"function","name":"bash","description":"Execute a bash command in the current working directory. Returns stdout and stder