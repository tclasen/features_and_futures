);\\n    if (!response.ok) throw new Error(result.error || 'Unable to complete request');\\n    return result;\\n  })();\\n  if (options) {\\n    pendingWrites.add(request);\\n    request.then(() => pendingWrites.delete(request), () => pendingWrites.delete(request));\\n  }\\n  return request;\\n}\\n\\nasync function navigate(path) {\\n  // A click on Projects/Open must not cancel a save still in flight.\\n  while (pendingWrites.size) await Promise.allSettled([...pendingWrites]);\\n  location.assign(path);\\n}\"},{\"oldText\":\"open.addEventListener('click', () => location.assign(`/projects/${project.id}`));\",\"newText\":\"open.addEventListener('click', () => navigate(`/projects/${project.id}`));\"},{\"oldText\":\"back.addEventListener('click', () => location.assign('/'));\",\"newText\":\"back.addEventListener('click', () => navigate('/'));\"},{\"oldText\":\"  function drawTasks() {\\n\",\"newText\":\"  const taskRows = new Map();\\n  function drawTasks() {\\n\"},{\"oldText\":\"    list.replaceChildren(...visible.map(task => {\\n      const row = document.createElement('div');\",\"newText\":\"    const rows = visible.map(task => {\\n      const existing = taskRows.get(task.id);\\n      if (existing && existing.deleted === task.deleted) {\\n        // Keep drafts and focused controls intact when another field is saved.\\n        const { row, saved } = existing;\\n        if (saved.title !== task.title) {\\n          row.children[0].textContent = task.title;\\n          row.children[1].setAttribute('aria-label', `Complete ${task.title}`);\\n          row.children[2].querySelector('input').value = '';\\n        }\\n        if (saved.completed !== task.completed) row.children[1].checked = task.completed;\\n        if (saved.priority !== task.priority) row.children[3].value = task.priority;\\n        if (saved.due_date !== task.due_date) row.children[4].querySelector('input').value = task.due_date;\\n        if (saved.notes !== task.notes) row.children[6].querySelector('textarea').value = task.notes;\\n        existing.saved = { ...task };\\n        return row;\\n      }\\n      const row = document.createElement('div');\"},{\"oldText\":\"body: JSON.stringify({ completed: checkbox.checked }),\\n          });\\n          tasks = tasks.map(item => item.id === saved.id ? saved : item);\",\"newText\":\"body: JSON.stringify({ completed: checkbox.checked }),\\n          });\\n          Object.assign(task, saved);\"},{\"oldText\":\"body: JSON.stringify({ title: newTitle }),\\n          });\\n          tasks = tasks.map(item => item.id === saved.id ? saved : item);\",\"newText\":\"body: JSON.stringify({ title: newTitle }),\\n          });\\n          Object.assign(task, saved);\"},{\"oldText\":\"body: JSON.stringify({ priority: priority.value }),\\n          });\\n          tasks = tasks.map(item => item.id === saved.id ? saved : item);\",\"newText\":\"body: JSON.stringify({ priority: priority.value }),\\n          });\\n          Object.assign(task, saved);\"},{\"oldText\":\"body: JSON.stringify({ due_date: dueInput.value.trim() }),\\n          });\\n          tasks = tasks.map(item => item.id === saved.id ? saved : item);\",\"newText\":\"body: JSON.stringify({ due_date: dueInput.value.trim() }),\\n          });\\n          Object.assign(task, saved);\"},{\"oldText\":\"body: JSON.stringify({ notes: notesInput.value }),\\n          });\\n          tasks = tasks.map(item => item.id === saved.id ? saved : item);\",\"newText\":\"body: JSON.stringify({ notes: notesInput.value }),\\n          });\\n          Object.assign(task, saved);\"},{\"oldText\":\"body: JSON.stringify({ deleted: !task.deleted }),\\n          });\\n          tasks = tasks.map(item => item.id === saved.id ? saved : item);\",\"newText\":\"body: JSON.stringify({ deleted: !task.deleted }),\\n          });\\n          Object.assign(task, saved);\"},{\"oldText\":\"      row.append(deletionButton);\\n      return row;\\n    }));\",\"newText\":\"      row.append(deletionButton);\\n      taskRows.set(task.id, { row, saved: { ...task }, deleted: task.deleted });\\n      return row;\\n    });\\n    // Do not detach unchanged rows: that would disrupt focus during a save.\\n    if (rows.length !== list.children.length || rows.some((row, index) => row !== list.children[index])) {\\n      list.replaceChildren(...rows);\\n    }\"},{\"oldText\":\"  app.innerHTML = `\\n    <h1>Workboard</h1>\",\"newText\":\"  // Load first, before exposing controls that have no handlers yet.\\n  let projects = await api('/api/projects');\\n  app.innerHTML = `\\n    <h1>Workboard</h1>\"},{\"oldText\":\"  let projects = await api('/api/projects');\\n  const filter = app.querySelector('#project-filter');\",\"newText\":\"  const filter = app.querySelector('#project-filter');\"}]}","status":"completed"}],"error":null,"incomplete_details":null,"tools":[{"type":"function","name":"read","description":"Read the contents of a file. Supports text files and images (jpg, png, gif, webp, bmp). Images are sent as attachments. For text files, output is truncated to 2000 lines or 50KB (whichever is hit first). Use offset/limit for large files. When you need the full file, continue with offset until complete.","parameters":{"type":"object","required":["path","offset","limit"],"properties":{"path":{"type":"string","description":"Path to the file to read (relative or absolute)"},"offset":{"anyOf":[{"type":"number","description":"Line number to start reading from (1-indexed)"},{"type":"null"}]},"limit":{"anyOf":[{"type":"number","description":"Maximum number of lines to read"},{"type":"null"}]}},"additionalProperties":false},"output_schema":null,"strict":true},{"type":"function","name":"bash","description":"Execute a bash command in the current working directory. Returns stdout and stderr. Output is truncated to last 2000 lines or 50KB (whichever is hit first). If truncated, full output is saved to a temp file. Optionally provide a timeout in seconds.","parameters":{"type":"object","requi