\",\"newText\":\"        renameProject.run(name, id);\\n        redirect(res, projectLocation(id, filter, priority));\"},{\"oldText\":\"        const filter = taskFilter(form.get('filter'));\\n        if (project.archived) {\\n          sendHtml(res, 403, projectPage(project, filter, 'Archived project cannot be changed'));\\n          return;\\n        }\\n        if (match[2])\",\"newText\":\"        const filter = taskFilter(form.get('filter'));\\n        const priority = priorityFilter(form.get('priorityFilter'));\\n        if (project.archived) {\\n          sendHtml(res, 403, projectPage(project, filter, 'Archived project cannot be changed', priority));\\n          return;\\n        }\\n        if (match[2])\"},{\"oldText\":\"projectPage(project, filter, 'Invalid task priority')\",\"newText\":\"projectPage(project, filter, 'Invalid task priority', priority)\"},{\"oldText\":\"            sendHtml(res, 400, projectPage(project, filter, 'Task title is required'));\\n            return;\\n          }\\n          if (existing\",\"newText\":\"            sendHtml(res, 400, projectPage(project, filter, 'Task title is required', priority));\\n            return;\\n          }\\n          if (existing\"},{\"oldText\":\"            sendHtml(res, 400, projectPage(project, filter, 'Task title is required'));\\n            return;\\n          }\\n          createTask\",\"newText\":\"            sendHtml(res, 400, projectPage(project, filter, 'Task title is required', priority));\\n            return;\\n          }\\n          createTask\"},{\"oldText\":\"        redirect(res, `/projects/${id}${filter === 'All' ? '' : `?filter=${filter}`}`);\",\"newText\":\"        redirect(res, projectLocation(id, filter, priority));\"}]}","item_id":"fc_067391788d57754f016acad52690848197ab1f8f110438d1d6","output_index":1,"sequence_number":846}

