data: {"type":"response.function_call_arguments.done","arguments":"{\"path\":\"server.js\",\"edits\":[{\"oldText\":\"const listProjects = db.prepare(`\",\"newText\":\"// Dates are stored as calendar-day strings, never timezone-converted timestamps.\\nif (!db.prepare('PRAGMA table_info(tasks)').all().some(column => column.name === 'due_date')) {\\n  db.exec(\\\"ALTER TABLE tasks ADD COLUMN due_date TEXT NOT NULL DEFAULT ''\\\");\\n}\\nconst listProjects = db.prepare(`\"},{\"oldText\":\"SELECT id, title, completed, priority FROM tasks\",\"newText\":\"SELECT id, title, completed, priority, due_date FROM tasks\"},{\"oldText\":\"const findTask = db.prepare\",\"newText\":\"const setTaskDueDate = db.prepare('UPDATE tasks SET due_date = ? WHERE id = ? AND project_id = ?');\\nconst findTask = db.prepare\"},{\"oldText\":\"function taskFilter(value) {\",\"newText\":\"function validDueDate(value) {\\n  if (value === '') return true;\\n  if (!/^\\\\d{4}-\\\\d{2}-\\\\d{2}$/.test(value)) return false;\\n  const [year, month, day] = value.split('-').map(Number);\\n  if (year < 1 || month < 1 || month > 12) return false;\\n  const leap = year % 4 === 0 && (year % 100 !== 0 || year % 400 === 0);\\n  const days = [31, leap ? 29 : 28, 31, 30, 31, 30, 31, 31, 30, 31, 30, 31];\\n  return day >= 1 && day <= days[month - 1];\\n}\\n\\nfunction taskFilter(value) {\"},{\"oldText\":\"        </form>\\n      </div>`).join('');\\n  return page(project.name, `\",\"newText\":\"        </form>\\n        <form class=\\\"create\\\" action=\\\"/projects/${project.id}/tasks/${task.id}/due-date\\\" method=\\\"post\\\">\\n          ${filterFields}\\n          <label for=\\\"task-due-date-${task.id}\\\">Task due date</label>\\n          <input id=\\\"task-due-date-${task.id}\\\" name=\\\"dueDate\\\" type=\\\"text\\\" value=\\\"${escapeHtml(task.due_date)}\\\" autocomplete=\\\"off\\\"${project.archived ? ' disabled' : ''}>\\n          <button type=\\\"submit\\\"${project.archived ? ' disabled' : ''}>Save due date</button>\\n        </form>\\n      </div>`).join('');\\n  return page(project.name, `\"},{\"oldText\":\"(completion|rename|priority)\",\"newText\":\"(completion|rename|priority|due-date)\"},{\"oldText\":\"          const changes = existing && (match[3] === 'rename'\",\"newText\":\"          const dueDate = (form.get('dueDate') || '').trim();\\n          if (existing && match[3] === 'due-date' && !validDueDate(dueDate)) {\\n            sendHtml(res, 400, projectPage(project, filter, 'Due date must be a valid YYYY-MM-DD date', priority));\\n            return;\\n          }\\n          const changes = existing && (match[3] === 'due-date'\\n            ? setTaskDueDate.run(dueDate, taskId, id).changes\\n            : match[3] === 'rename'\"}]}","item_id":"fc_01e4b3bf71bb0fbb016acad6eb937887d2947b1291f268f860","output_index":2,"sequence_number":771}

