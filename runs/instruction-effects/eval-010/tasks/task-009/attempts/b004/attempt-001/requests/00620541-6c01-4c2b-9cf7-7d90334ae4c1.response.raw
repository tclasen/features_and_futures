name === 'default_priority')) db.exec(\\\"ALTER TABLE projects ADD COLUMN default_priority TEXT NOT NULL DEFAULT 'Normal'\\\");\\nif (!db.prepare('PRAGMA table_info(tasks)').all().some(c => c.name === 'due_date')) db.exec('ALTER TABLE tasks ADD COLUMN due_date TEXT');\"},{\"oldText\":\"row.append(title,checkbox,renameForm,priority);section.append(row)\",\"newText\":\"const dueForm=document.createElement('form');const dueInput=document.createElement('input');dueInput.setAttribute('aria-label','Task due date');dueInput.value=t.dueDate||'';dueInput.disabled=!!p.archived;const dueButton=document.createElement('button');dueButton.type='submit';dueButton.textContent='Save due date';dueButton.disabled=!!p.archived;dueForm.append(dueInput,dueButton);dueForm.onsubmit=async e=>{e.preventDefault();const dueDate=dueInput.value.trim();const response=await fetch('/api/tasks/'+t.id,{method:'PATCH',headers:{'content-type':'application/json'},body:JSON.stringify({dueDate})});if(!response.ok){app.querySelector('#alert').textContent='Due date must be a valid YYYY-MM-DD date';return}app.querySelector('#alert').textContent='';load()};row.append(title,checkbox,renameForm,priority,dueForm);section.append(row)\"},{\"oldText\":\"SELECT id,project_id AS projectId,title,completed,priority FROM tasks WHERE project_id=? ORDER BY id\",\"newText\":\"SELECT id,project_id AS projectId,title,completed,priority,due_date AS dueDate FROM tasks WHERE project_id=? ORDER BY id\"},{\"oldText\":\"if(['Low','Normal','High'].includes(patch.priority)){db.prepare('UPDATE tasks SET priority=? WHERE id=?').run(patch.priority,+m[1]);return res.writeHead(204).end()}return res.writeHead(400).end()\",\"newText\":\"if(['Low','Normal','High'].includes(patch.priority)){db.prepare('UPDATE tasks SET priority=? WHERE id=?').run(patch.priority,+m[1]);return res.writeHead(204).end()}if(typeof patch.dueDate==='string'){const date=patch.dueDate.trim();if(date===''){db.prepare('UPDATE tasks SET due_date=NULL WHERE id=?').run(+m[1]);return res.writeHead(204).end()}const match=date.match(/^(\\\\\\\\d{4})-(\\\\\\\\d{2})-(\\\\\\\\d{2})$/);if(!match)return res.writeHead(400).end();const year=Number(match[1]),month=Number(match[2]),day=Number(match[3]);const days=new Date(Date.UTC(year,month,0)).getUTCDate();if(year<1||month<1||month>12||day<1||day>days)return res.writeHead(400).end();db.prepare('UPDATE tasks SET due_date=? WHERE id=?').run(date,+m[1]);return res.writeHead(204).end()}return res.writeHead(400).end()\"}]}","status":"completed"}],"error":null,"incomplete_details":null,"tools":[{"type":"function","name":"read","description":"Read the contents of a file. Supports text files and images (jpg, png, gif, webp, bmp). Images are sent as attachments. For text files, output is truncated to 2000 lines or 50KB (whichever is hit first). Use offset/limit for large files. When you need the full file, continue with offset until complete.","parameters":{"type":"object","required":["path","offset","limit"],"properties":{"path":{"type":"string","description":"Path to the file to read (relative or absolute)"},"offset":{"anyOf":[{"type":"number","description":"Line number to start reading from (1-indexed)"},{"type":"null"}]},"limit":{"anyOf":[{"type":"number","description":"Maximum number of lines to read"},{"type":"null"}]}},"additionalProperties":false},"output_schema":null,"strict":true},{"type":"function","name":"bash","description":"Execute a bash command in the current working directory. Returns stdout and stderr. Output is truncated to last 2000 lines or 50KB (whichever is hit first). If truncated, full output is saved to a temp file. Optionally provide a timeout in seconds.","parameters":{"type":"object","required":["command","timeout"],"properties":{"command":{"type":"string","description":"Shell command to execute"},"timeout":{"anyOf":[{"type":"number","description":"Timeout in seconds (optional, no default timeout)"},{"type":"null"}]}},"additionalProperties":false},"output_schema":null,"strict":true},{"type":"function","name":"edit","description":"Edit a single file using exact text replacement. Every edits[].oldText must match a unique, non-overlapping region of the original file. If two changes affect the same block or nearby lines, merge them into one edit instead of emitting overlapping edits. Do not include large unchanged regions just to connect distant changes.","parameters":{"type":"object","required":["path","edits"],"properties":{"path":{"type":"string","description":"Path to the file to edit (relative or absolute)"},"edits":{"type":"array","items":{"type":"object","required":["oldText","newText"],"properties":{"oldText":{"type":"string","description":"Exact text for one targeted replacement. It must be unique in the original file and must not overlap with any other edits[].oldText in the same call."},"newText":{"type":"string","description":"Replacement text for this targeted edit."}},"additionalProperties":false},"description":"One or more targeted replacements. Each edit is matched against the original file, not incrementally. Do not include overlapping or nested edits. If two changes touch the same block or nearby lines, merge them into one edit instead."}},"additionalProperties":false},"output_schema":null,"strict":true},{"type":"function","name":"write","description":"Write content to a file. Creates the file if it doesn't exist, overwrites if it does. Automatically creates parent directories.","parameters":{"type":"object","required":["path","content"],"properties":{"path":{"type":"string","description":"Path to the file to write (relative or absolute)"},"content":{"type":"string","description":"Content to write to the file"}},"additionalProperties":false},"output_schema":null,"strict":true}],"tool_choice":"auto","parallel_tool_calls":true,"prompt_cache_key":"0589287e-85c4-4a11-8f60-902a211c18ec","prompt_cache_retention":"24h","text":{"format":{"type":"text"},"verbosity":"low"},"top_p":0.98,"top_logprobs":0,"temperature":1.0,"reasoning":{"effort":"medium","summary":"detailed","context":"all_turns","mode":"standard"},"user":null,"usage":{"input_tokens":7027,"input_tokens_details":{"cached_tokens":1536,"cache_write_tokens":0},"output_tokens":783,"output_tokens_details":{"reasoning_tokens":46},"total_tokens":7810,"attribution":{"items":{"fc_0d16e36df6833433016acad6dd3e348194ba6bdede5f887455":{"input_tokens":57,"cached_tokens":0,"cache_write_tokens":0,"output_tokens":0},"fc_0d16e36df6833433016acad6dee5288194968682003fff17a0":{"input_tokens":28,"cached_tokens":0,"cache_write_tokens":0,"output_tokens":0},"fc_0d16e36df6833433016acad6df7118819499e30baf381eb6df":{"input_tokens":287,"cached_tokens":0,"cache_write_tokens":0,"output_tokens":0,"content":[{"input_tokens":287,"cached_tokens":0,"cache_write_tokens":0,"output_tokens":0}]},"fc_0d16e36df6833433016acad6df711881949dcd98d3d0e55f18":{"input_tokens":3261,"cached_tokens":0,"cache_write_tokens":0,"output_tokens":0,"content":[{"input_tokens":3261,"cached_tokens":0,"cache_write_tokens":0,"output_tokens":0}]},"fc_0d16e36df6833433016acad6e12d788194b45aa8e376054898":{"input_tokens":0,"cached_tokens":0,"cache_write_tokens":0,"output_tokens":737},"msg_0d16e36df6833433016acad6df7118819498fab928addf9c08":{"input_tokens":2282,"cached_tokens":426,"cache_write_tokens":0,"output_tokens":0,"content":[{"input_tokens":2282,"cached_tokens":426,"cache_write_tokens":0,"output_tokens":0}]},"rs_0d16e36df6833433016acad6dfc9d88194bd98e128853b568b":{"input_tokens":2,"cached_tokens":0,"cache_write_tokens":0,"output_tokens":46}},"request_fields":{"instructions":{"input_tokens":617,"cached_tokens":617,"cache_write_tokens":0,"output_tokens":0},"tools":{"input_tokens":493,"cached_tokens":493,"cache_write_tokens":0,"output_tokens":0}}}},"tool_usage":{"image_gen":{"input_tokens":0,"output_tokens":0,"total_tokens":0,"input_tokens_details":{"text_tokens":0,"image_tokens":0},"output_tokens_details":{"image_tokens":0,"text_tokens":0}},"web_search":{"num_requests":0}},"safety_identifier":"