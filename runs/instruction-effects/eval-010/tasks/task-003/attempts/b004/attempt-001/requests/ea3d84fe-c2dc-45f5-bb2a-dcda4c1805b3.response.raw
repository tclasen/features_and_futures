x.checked})});load()};row.append(title,checkbox);section.append(row)}};\\nfilter.onchange=load;app.querySelector('#task-form').onsubmit=async e=>{e.preventDefault();const input=app.querySelector('#task-title'),title=input.value.trim();if(!title){app.querySelector('#alert').textContent='Task title is required';return}await fetch('/api/projects/'+p.id+'/tasks',{method:'POST',headers:{'content-type':'application/json'},body:JSON.stringify({title})});input.value='';app.querySelector('#alert').textContent='';load()};load();return}\\napp.innerHTML='<h1>Workboard</h1><form id=\\\"project-form\\\"><label for=\\\"project-name\\\">Project name</label><input id=\\\"project-name\\\"><button type=\\\"submit\\\">Create project</button></form><div id=\\\"alert\\\" class=\\\"alert\\\" role=\\\"alert\\\"></div><label for=\\\"project-filter\\\">Project filter</label><select id=\\\"project-filter\\\"><option>Active</option><option>Archived</option></select><section id=\\\"projects\\\"></section>';\\nconst form=app.querySelector('#project-form');form.onsubmit=async e=>{e.preventDefault();const input=app.querySelector('#project-name'),name=input.value.trim();if(!name){app.querySelector('#alert').textContent='Project name is required';return}await fetch('/api/projects',{method:'POST',headers:{'content-type':'application/json'},body:JSON.stringify({name})});render()};\\nconst filter=app.querySelector('#project-filter');const draw=async()=>{const list=await projects(),section=app.querySelector('#projects');section.replaceChildren();for(const p of list){if(filter.value==='Active'&&p.archived||filter.value==='Archived'&&!p.archived)continue;const row=document.createElement('div');row.dataset.testid='project-row';row.className='project-row';const name=document.createElement('span');name.className='project-name';name.textContent=p.name;const summary=document.createElement('span');summary.dataset.testid='project-summary';summary.textContent=p.completedCount+'/'+p.totalCount+' completed';const open=document.createElement('button');open.textContent='Open project';open.onclick=()=>go('/projects/'+p.id);const action=document.createElement('button');action.textContent=p.archived?'Restore project':'Archive project';action.onclick=async()=>{await fetch('/api/projects/'+p.id,{method:'PATCH',headers:{'content-type':'application/json'},body:JSON.stringify({archived:!p.archived})});draw()};row.append(name,summary,open,action);section.append(row)}};filter.onchange=draw;draw()\\n}\\nwindow.onpopstate=render;render();\\n</script></body></html>`;\\n\\nconst send=(res,status,data)=>{res.writeHead(status,{'content-type':'application/json'});res.end(JSON.stringify(data))};\\nasync function body(req){let s='';for await(const c of req)s+=c;return JSON.parse(s)}\\nconst server=http.createServer(async(req,res)=>{const url=new URL(req.url,'http://localhost');if(req.method==='GET'&&url.pathname==='/health')return send(res,200,{status:'ok'});\\nif(url.pathname==='/api/projects'&&req.method==='GET'){const rows=db.prepare(`SELECT p.id,p.name,p.archived,COUNT(t.id) totalCount,COALESCE(SUM(t.completed),0) completedCount FROM projects p LEFT JOIN tasks t ON t.project_id=p.id GROUP BY p.id ORDER BY p.id`).all().map(p=>({...p,id:Number(p.id),archived:!!p.archived,totalCount:Number(p.totalCount),completedCount:Number(p.completedCount)}));return send(res,200,rows)}\\nif(url.pathname==='/api/projects'&&req.method==='POST'){try{const name=(await body(req)).name;if(typeof name!=='string'||!name.trim())return res.writeHead(400).end();const x=db.prepare('INSERT INTO projects(name) VALUES (?)').run(name.trim());return send(res,201,{id:Number(x.lastInsertRowid),name:name.trim()})}catch{return res.writeHead(400).end()}}\\nlet m=url.pathname.match(/^\\\\/api\\\\/projects\\\\/(\\\\d+)$/);if(m&&req.method==='PATCH'){try{const archived=(await body(req)).archived;if(typeof archived!=='boolean')return res.writeHead(400).end();const x=db.prepare('UPDATE projects SET archived=? WHERE id=?').run(+archived,+m[1]);return res.writeHead(x.changes?204:404).end()}catch{return res.writeHead(400).end()}}\\nm=url.pathname.match(/^\\\\/api\\\\/projects\\\\/(\\\\d+)\\\\/tasks$/);if(m&&req.method==='GET')return send(res,200,db.prepare('SELECT id,project_id AS projectId,title,completed FROM tasks WHERE project_id=? ORDER BY id').all(+m[1]));if(m&&req.method==='POST'){try{const title=(await body(req)).title;if(typeof title!=='string'||!title.trim())return res.writeHead(400).end();const p=db.prepare('SELECT archived FROM projects WHERE id=?').get(+m[1]);if(!p)return res.writeHead(404).end();if(p.archived)return res.writeHead(403).end();const x=db.prepare('INSERT INTO tasks(project_id,title) VALUES (?,?)').run(+m[1],title.trim());return send(res,201,{id:Number(x.lastInsertRowid),title:title.trim(),completed:0})}catch{return res.writeHead(400).end()}}\\nm=url.pathname.match(/^\\\\/api\\\\/tasks\\\\/(\\\\d+)$/);if(m&&req.method==='PATCH'){try{const completed=(await body(req)).completed;if(typeof completed!=='boolean')return res.writeHead(400).end();const x=db.prepare('UPDATE tasks SET completed=? WHERE id=? AND project_id IN (SELECT id FROM projects WHERE archived=0)').run(+completed,+m[1]);return res.writeHead(x.changes?204:404).end()}catch{return res.writeHead(400).end()}}\\nif(req.method==='GET'){res.writeHead(200,{'content-type':'text/html; charset=utf-8'});return res.end(page)}res.writeHead(404).end()});\\nserver.listen(Number(process.env.PORT)||8080,'0.0.0.0');\\n\"}","status":"completed"}}

