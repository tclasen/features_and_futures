cached_tokens":0,"cache_write_tokens":0,"output_tokens":0,"content":[{"input_tokens":37,"cached_tokens":0,"cache_write_tokens":0,"output_tokens":0}]},"msg_0c634c3ffde7c1df016acae2ef1c2c8194a44eb8f55220740b":{"input_tokens":3981,"cached_tokens":2465,"cache_write_tokens":0,"output_tokens":0,"content":[{"input_tokens":3981,"cached_tokens":2465,"cache_write_tokens":0,"output_tokens":0}]},"rs_0c634c3ffde7c1df016acae2ea4e78819483c34080182ee96a":{"input_tokens":15,"cached_tokens":0,"cache_write_tokens":0,"output_tokens":0},"rs_0c634c3ffde7c1df016acae2f055108194bcdad7c6732e22cb":{"input_tokens":2,"cached_tokens":0,"cache_write_tokens":0,"output_tokens":39}},"request_fields":{"instructions":{"input_tokens":882,"cached_tokens":882,"cache_write_tokens":0,"output_tokens":0},"tools":{"input_tokens":493,"cached_tokens":493,"cache_write_tokens":0,"output_tokens":0}}}},"tool_usage":{"image_gen":{"input_tokens":0,"output_tokens":0,"total_tokens":0,"input_tokens_details":{"text_tokens":0,"image_tokens":0},"output_tokens_details":{"image_tokens":0,"text_tokens":0}},"web_search":{"num_requests":0}},"safety_identifier":"user-ZglLa0AK1sUTDt85g9NsGTX5","store":false,"metadata":{},"max_output_tokens":null,"max_tool_calls":null,"service_tier":"default","truncation":"disabled"}}
