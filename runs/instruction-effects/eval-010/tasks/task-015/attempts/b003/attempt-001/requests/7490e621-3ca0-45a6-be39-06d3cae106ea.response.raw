event: response.reasoning_summary_text.done
data: {"type":"response.reasoning_summary_text.done","sequence_number":100,"item_id":"rs_0e2771e7fef37a44016acae2bf68dc8196ab448bf50e9ae6ef","output_index":0,"summary_index":0,"text":"**Solving newline issues in HTML**\n\nI’m noticing that initial newline issues in a textarea could be linked to HTML stripping the first line feed (LF). To handle this, using an escaped LF &#10; could help ensure it’s preserved. There’s also a potential bug with how CR is normalized to LF; escaping CR as &#13; might prevent unwanted normalization. Additionally, using buffers for handling unicode reliability could be a small but effective change. It’s a bit technical, but I think it’s worth considering!"}

event: response.reasoning_summary_part.done
data: {"type":"response.reasoning_summary_part.done","sequence_number":101,"item_id":"rs_0e2771e7fef37a44016acae2bf68dc8196ab448bf50e9ae6ef","output_index":0,"summary_index":0,"part":{"type":"summary_text","text":"**Solving newline issues in HTML**\n\nI’m noticing that initial newline issues in a textarea could be linked to HTML stripping the first line feed (LF). To handle this, using an escaped LF &#10; could help ensure it’s preserved. There’s also a potential bug with how CR is normalized to LF; escaping CR as &#13; might prevent unwanted normalization. Additionally, using buffers for handling unicode reliability could be a small but effective change. It’s a bit technical, but I think it’s worth considering!"}}

