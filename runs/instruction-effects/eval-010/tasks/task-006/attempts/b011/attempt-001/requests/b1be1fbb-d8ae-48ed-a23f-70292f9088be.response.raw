data: {"type":"response.function_call_arguments.done","sequence_number":574,"item_id":"fc_08afe026f6976ec2016acad47ac14c819483f3ddcb28d80e2a","output_index":0,"arguments":"{\"path\":\"index.html\",\"edits\":[{\"oldText\":\"<form class=\\\"rename-task\\\" data-task-id=\\\"${escapeHtml(t.id)}\\\"><label>New task title<input type=\\\"text\\\" value=\\\"${escapeHtml(t.title)}\\\" ${p.archived?'disabled':''} aria-label=\\\"New task title\\\"></label><button type=\\\"submit\\\" ${p.archived?'disabled':''}>Rename task</button></form><p class=\\\"error\\\" role=\\\"alert\\\" data-rename-error=\\\"${escapeHtml(t.id)}\\\" hidden></p>\",\"newText\":\"<form class=\\\"rename-task\\\" data-task-id=\\\"${escapeHtml(t.id)}\\\"><label>New task title<input type=\\\"text\\\" value=\\\"${escapeHtml(t.title)}\\\" ${p.archived?'disabled':''} aria-label=\\\"New task title\\\"></label><button type=\\\"submit\\\" ${p.archived?'disabled':''}>Rename task</button></form><label>Task priority<select aria-label=\\\"Task priority\\\" data-priority=\\\"${escapeHtml(t.id)}\\\" ${p.archived?'disabled':''}><option ${t.priority==='Low'?'selected':''}>Low</option><option ${t.priority==='Normal'?'selected':''}>Normal</option><option ${t.priority==='High'?'selected':''}>High</option></select></label><p class=\\\"error\\\" role=\\\"alert\\\" data-rename-error=\\\"${escapeHtml(t.id)}\\\" hidden></p>\"} ,{\"oldText\":\"list.onchange=async e=>{if(e.target.matches('[data-task]')){const t=items.find(x=>x.id===e.target.dataset.task);t.completed=e.target.checked?1:0;await fetch(`/api/projects/${encodeURIComponent(projectId)}/tasks/${encodeURIComponent(t.id)}`,{method:'PATCH',headers:{'Content-Type':'application/json'},body:JSON.stringify({completed:!!t.completed})});showTasks()}};\",\"newText\":\"list.onchange=async e=>{if(e.target.matches('[data-task]')){const t=items.find(x=>x.id===e.target.dataset.task);t.completed=e.target.checked?1:0;await fetch(`/api/projects/${encodeURIComponent(projectId)}/tasks/${encodeURIComponent(t.id)}`,{method:'PATCH',headers:{'Content-Type':'application/json'},body:JSON.stringify({completed:!!t.completed})});showTasks()}else if(e.target.matches('[data-priority]')){const t=items.find(x=>x.id===e.target.dataset.priority);t.priority=e.target.value;await fetch(`/api/projects/${encodeURIComponent(projectId)}/tasks/${encodeURIComponent(t.id)}`,{method:'PATCH',headers:{'Content-Type':'application/json'},body:JSON.stringify({priority:t.priority})})}};\"}]}"}

