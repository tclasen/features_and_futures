data: {"type":"response.function_call_arguments.done","sequence_number":642,"item_id":"fc_0bbdfb693255b288016acad4731b6887d2a0d9068297755a88","output_index":0,"arguments":"{\"path\":\"server.js\",\"edits\":[{\"oldText\":\"const listProjects = db.prepare(`\",\"newText\":\"// Existing tasks gain the same default as newly created tasks.\\nif (!db.prepare('PRAGMA table_info(tasks)').all().some(column => column.name === 'priority')) {\\n  db.exec(\\\"ALTER TABLE tasks ADD COLUMN priority TEXT NOT NULL DEFAULT 'Normal' CHECK (priority IN ('Low', 'Normal', 'High'))\\\");\\n}\\nconst listProjects = db.prepare(`\"},{\"oldText\":\"SELECT id, title, completed FROM tasks\",\"newText\":\"SELECT id, title, completed, priority FROM tasks\"},{\"oldText\":\"const findTask = db.prepare(\",\"newText\":\"const setTaskPriority = db.prepare('UPDATE tasks SET priority = ? WHERE id = ? AND project_id = ?');\\nconst findTask = db.prepare(\"},{\"oldText\":\"          <button type=\\\"submit\\\"${project.archived ? ' disabled' : ''}>Rename task</button>\\n        </form>\",\"newText\":\"          <button type=\\\"submit\\\"${project.archived ? ' disabled' : ''}>Rename task</button>\\n        </form>\\n        <form class=\\\"create\\\" action=\\\"/projects/${project.id}/tasks/${task.id}/priority\\\" method=\\\"post\\\">\\n          <input type=\\\"hidden\\\" name=\\\"filter\\\" value=\\\"${filter}\\\">\\n          <label for=\\\"task-priority-${task.id}\\\">Task priority</label>\\n          <select id=\\\"task-priority-${task.id}\\\" name=\\\"priority\\\"${project.archived ? ' disabled' : ''} onchange=\\\"this.form.requestSubmit()\\\">\\n            ${['Low', 'Normal', 'High'].map(value => `<option${value === task.priority ? ' selected' : ''}>${value}</option>`).join('')}\\n          </select>\\n        </form>\"},{\"oldText\":\"(completion|rename))?)?$\",\"newText\":\"(completion|rename|priority))?)?$\"},{\"oldText\":\"          const changes = existing && (match[3] === 'rename'\\n            ? renameTask.run(form.get('title').trim(), taskId, id).changes\\n            : updateTask.run(form.get('completed') === '1' ? 1 : 0, taskId, id).changes);\",\"newText\":\"          if (existing && match[3] === 'priority' && !['Low', 'Normal', 'High'].includes(form.get('priority'))) {\\n            sendHtml(res, 400, projectPage(project, filter, 'Invalid task priority'));\\n            return;\\n          }\\n          const changes = existing && (match[3] === 'rename'\\n            ? renameTask.run(form.get('title').trim(), taskId, id).changes\\n            : match[3] === 'priority'\\n              ? setTaskPriority.run(form.get('priority'), taskId, id).changes\\n              : updateTask.run(form.get('completed') === '1' ? 1 : 0, taskId, id).changes);\"}]}"}

