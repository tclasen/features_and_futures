den\\\" name=\\\"filter\\\" value=\\\"${filter}\\\">\\n      <input type=\\\"hidden\\\" name=\\\"priorityFilter\\\" value=\\\"${priority}\\\">\\n      ${rangeFields}\\n      <label for=\\\"task-search\\\">Task search</label>\\n      <input id=\\\"task-search\\\" name=\\\"search\\\" type=\\\"text\\\" value=\\\"${escapeHtml(search)}\\\">\\n      <button>Search tasks</button>\\n    </form>\\n    <ul aria-label=\\\"Tasks\\\">${rows}</ul>`);\"},{\"oldText\":\"projectsPage('', projectFilter(url.searchParams.get('filter')))\",\"newText\":\"projectsPage('', projectFilter(url.searchParams.get('filter')), (url.searchParams.get('search') || '').trim())\"},{\"oldText\":\"      if (!name) return send(response, 400, projectsPage('Project name is required'));\\n      createProject.run(name);\\n      return redirect(response, '/');\",\"newText\":\"      const filter = projectFilter(form.get('filter'));\\n      const search = (form.get('search') || '').trim();\\n      if (!name) return send(response, 400, projectsPage('Project name is required', filter, search));\\n      createProject.run(name);\\n      return redirect(response, `/?${new URLSearchParams({ filter, search })}`);\"},{\"oldText\":\"      updateArchive.run(archiveMatch[2] === 'archive' ? 1 : 0, id);\\n      return redirect(response, archiveMatch[2] === 'archive' ? '/' : '/?filter=Archived');\",\"newText\":\"      const form = await readForm(request);\\n      updateArchive.run(archiveMatch[2] === 'archive' ? 1 : 0, id);\\n      const filter = archiveMatch[2] === 'archive' ? 'Active' : 'Archived';\\n      return redirect(response, `/?${new URLSearchParams({ filter, search: (form.get('search') || '').trim() })}`);\"},{\"oldText\":\"appliedDueRange(url.searchParams)));\",\"newText\":\"appliedDueRange(url.searchParams), (url.searchParams.get('search') || '').trim()));\"}]}"}

