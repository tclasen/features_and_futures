form))\"},{\"oldText\":\"        setDefaultPriority.run(form.get('priority'), id);\\n        redirect(res, projectLocation(id, filter, priority, dueRange(form)));\",\"newText\":\"        setDefaultPriority.run(form.get('priority'), id);\\n        redirect(res, projectLocation(id, filter, priority, dueRange(form), searchQuery(form)));\"},{\"oldText\":\"        renameProject.run(name, id);\\n        redirect(res, projectLocation(id, filter, priority, dueRange(form)));\",\"newText\":\"        renameProject.run(name, id);\\n        redirect(res, projectLocation(id, filter, priority, dueRange(form), searchQuery(form)));\"},{\"oldText\":\"        redirect(res, projectLocation(id, filter, priority, dueRange(form)));\\n        return;\\n      }\\n    }\\n    sendHtml\",\"newText\":\"        redirect(res, projectLocation(id, filter, priority, dueRange(form), searchQuery(form)));\\n        return;\\n      }\\n    }\\n    sendHtml\"}]}"}

