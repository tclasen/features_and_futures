eted))&&(priorityFilter.value==='All'||t.priority===priorityFilter.value)&&(!appliedFrom&&!appliedThrough||!!t.due_date)&&(!appliedFrom||t.due_date>=appliedFrom)&&(!appliedThrough||t.due_date<=appliedThrough));\"},{\"oldText\":\"filter.onchange=showTasks;priorityFilter.onchange=showTasks;list.onsubmit\",\"newText\":\"filter.onchange=showTasks;priorityFilter.onchange=showTasks;document.querySelector('#apply-due-range').onclick=()=>{const from=document.querySelector('#due-from').value.trim(),through=document.querySelector('#due-through').value.trim(),error=document.querySelector('#range-error');if((from&&!validDate(from))||(through&&!validDate(through))){error.textContent='Due range must use valid YYYY-MM-DD dates';error.hidden=false;return}if(from&&through&&from>through){error.textContent='Due from must not be after Due through';error.hidden=false;return}appliedFrom=from;appliedThrough=through;error.hidden=true;showTasks()};list.onsubmit\"}]}","call_id":"call_pAXVWhHmWyFseYMMUbnPIEH1","name":"edit"},"output_index":1,"sequence_number":682}

