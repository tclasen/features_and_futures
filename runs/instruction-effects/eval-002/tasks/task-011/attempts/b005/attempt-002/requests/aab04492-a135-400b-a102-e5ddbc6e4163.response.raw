event: response.reasoning_summary_text.done
data: {"type":"response.reasoning_summary_text.done","sequence_number":223,"item_id":"rs_06cd5485f0b8e658016aca0fbbc7a88194aa71489f85488976","output_index":2,"summary_index":0,"text":"**Considering project controls**\n\nI’m looking into how polling might affect project control defaults, especially with guard handles. If a task gets rendered, I should keep the destination map in mind when changes occur. There's a risk of losing unrelated draft inputs if I just poll the render without saving any altered task data. So, I definitely want to avoid a reset due to defaults unless changes are truly unavoidable. It’s quite a balancing act!"}

event: response.reasoning_summary_part.done
data: {"type":"response.reasoning_summary_part.done","sequence_number":224,"item_id":"rs_06cd5485f0b8e658016aca0fbbc7a88194aa71489f85488976","output_index":2,"summary_index":0,"part":{"type":"summary_text","text":"**Considering project controls**\n\nI’m looking into how polling might affect project control defaults, especially with guard handles. If a task gets rendered, I should keep the destination map in mind when changes occur. There's a risk of losing unrelated draft inputs if I just poll the render without saving any altered task data. So, I definitely want to avoid a reset due to defaults unless changes are truly unavoidable. It’s quite a balancing act!"}}

