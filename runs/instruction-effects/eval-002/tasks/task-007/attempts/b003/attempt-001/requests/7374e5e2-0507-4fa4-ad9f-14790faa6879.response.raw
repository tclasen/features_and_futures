ity')\",\"newText\":\"projectPage(project, filter, 'Invalid task priority', '', null, selectedPriority)\"},{\"oldText\":\"        setTaskPriority.run(priority, task.id, project.id);\\n        redirect(response, `/projects/${project.id}?filter=${filter}`);\",\"newText\":\"        setTaskPriority.run(priority, task.id, project.id);\\n        redirect(response, projectLocation(project.id, filter, selectedPriority));\"},{\"oldText\":\"        const filter = taskFilter(form.get('filter'));\\n        if (project.archived) {\\n          html(response, 403, projectPage(project, filter, 'Archived project is read-only'));\\n          return;\\n        }\\n        const title = (form.get('title') || '').trim();\",\"newText\":\"        const filter = taskFilter(form.get('filter'));\\n        const selectedPriority = priorityFilter(form.get('priorityFilter'));\\n        if (project.archived) {\\n          html(response, 403, projectPage(project, filter, 'Archived project is read-only', '', null, selectedPriority));\\n          return;\\n        }\\n        const title = (form.get('title') || '').trim();\"},{\"oldText\":\"            id: task.id, message: 'Task title is required'\\n          }));\",\"newText\":\"            id: task.id, message: 'Task title is required'\\n          }, selectedPriority));\"},{\"oldText\":\"        renameTask.run(title, task.id, project.id);\\n        redirect(response, `/projects/${project.id}?filter=${filter}`);\",\"newText\":\"        renameTask.run(title, task.id, project.id);\\n        redirect(response, projectLocation(project.id, filter, selectedPriority));\"},{\"oldText\":\"      if (project) {\\n        if (project.archived) {\\n          html(response, 403, projectPage(project, taskFilter(url.searchParams.get('filter')), 'Archived project is read-only'));\\n          return;\\n        }\\n        const form = await readForm(request);\\n        const filter = taskFilter(form.get('filter'));\",\"newText\":\"      if (project) {\\n        const form = await readForm(request);\\n        const filter = taskFilter(form.get('filter'));\\n        const selectedPriority = priorityFilter(form.get('priorityFilter'));\\n        if (project.archived) {\\n          html(response, 403, projectPage(project, filter, 'Archived project is read-only', '', null, selectedPriority));\\n          return;\\n        }\"},{\"oldText\":\"projectPage(project, filter, 'Task title is required')\",\"newText\":\"projectPage(project, filter, 'Task title is required', '', null, selectedPriority)\"},{\"oldText\":\"        redirect(response, `/projects/${project.id}?filter=${filter}`);\",\"newText\":\"        redirect(response, projectLocation(project.id, filter, selectedPriority));\"},{\"oldText\":\"projectPage(project, taskFilter(url.searchParams.get('filter')))\",\"newText\":\"projectPage(project, taskFilter(url.searchParams.get('filter')), '', '', null, priorityFilter(url.searchParams.get('priorityFilter')))\"}]}","status":"completed"}}

