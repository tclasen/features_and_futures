data: {"type":"response.function_call_arguments.done","sequence_number":938,"item_id":"fc_0123a7d864a31cf3016aca0929d8ec819791baf33eae2ee950","output_index":2,"arguments":"{\"path\":\"server.js\",\"edits\":[{\"oldText\":\"const listProjects = db.prepare\",\"newText\":\"if (!db.prepare('PRAGMA table_info(tasks)').all().some(column => column.name === 'due_date')) {\\n  db.exec(\\\"ALTER TABLE tasks ADD COLUMN due_date TEXT NOT NULL DEFAULT ''\\\");\\n}\\nconst setTaskDueDate = db.prepare('UPDATE tasks SET due_date = ? WHERE id = ? AND project_id = ?');\\nconst listProjects = db.prepare\"},{\"oldText\":\"SELECT id, title, completed, priority FROM tasks\",\"newText\":\"SELECT id, title, completed, priority, due_date FROM tasks\"},{\"oldText\":\"function projectFilter(value) {\",\"newText\":\"function validDueDate(value) {\\n  if (!/^\\\\d{4}-\\\\d{2}-\\\\d{2}$/.test(value)) return false;\\n  const [year, month, day] = value.split('-').map(Number);\\n  if (year < 1 || month < 1 || month > 12 || day < 1) return false;\\n  const leap = year % 4 === 0 && (year % 100 !== 0 || year % 400 === 0);\\n  return day <= [31, leap ? 29 : 28, 31, 30, 31, 30, 31, 31, 30, 31, 30, 31][month - 1];\\n}\\n\\nfunction projectFilter(value) {\"},{\"oldText\":\"    <form action=\\\"/projects/${project.id}/tasks/${task.id}/rename\\\" method=\\\"post\\\">\",\"newText\":\"    <form action=\\\"/projects/${project.id}/tasks/${task.id}/due-date\\\" method=\\\"post\\\">\\n      ${filterFields}\\n      <label for=\\\"task-due-date-${task.id}\\\">Task due date</label>\\n      <input id=\\\"task-due-date-${task.id}\\\" name=\\\"dueDate\\\" type=\\\"text\\\" value=\\\"${escapeHtml(task.due_date)}\\\"${project.archived ? ' disabled' : ''}>\\n      <button type=\\\"submit\\\"${project.archived ? ' disabled' : ''}>Save due date</button>\\n    </form>\\n    <form action=\\\"/projects/${project.id}/tasks/${task.id}/rename\\\" method=\\\"post\\\">\"},{\"oldText\":\"    const taskRenameMatch =\",\"newText\":\"    const dueDateMatch = /^\\\\/projects\\\\/(\\\\d+)\\\\/tasks\\\\/(\\\\d+)\\\\/due-date$/.exec(url.pathname);\\n    if (request.method === 'POST' && dueDateMatch) {\\n      const project = findProject.get(dueDateMatch[1]);\\n      const task = project && findTask.get(dueDateMatch[2], project.id);\\n      if (task) {\\n        const form = await readForm(request);\\n        const filter = taskFilter(form.get('filter'));\\n        const selectedPriority = priorityFilter(form.get('priorityFilter'));\\n        if (project.archived) {\\n          html(response, 403, projectPage(project, filter, 'Archived project is read-only', '', null, selectedPriority));\\n          return;\\n        }\\n        const dueDate = (form.get('dueDate') || '').trim();\\n        if (dueDate && !validDueDate(dueDate)) {\\n          html(response, 400, projectPage(project, filter, 'Due date must be a valid YYYY-MM-DD date', '', null, selectedPriority));\\n          return;\\n        }\\n        setTaskDueDate.run(dueDate, task.id, project.id);\\n        redirect(response, projectLocation(project.id, filter, selectedPriority));\\n        return;\\n      }\\n    }\\n    const taskRenameMatch =\"}]}"}

