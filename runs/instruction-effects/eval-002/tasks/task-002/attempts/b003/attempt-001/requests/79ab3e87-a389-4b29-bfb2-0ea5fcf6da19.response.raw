xt\":\"function projectPage(project, filter = 'All', error = '') {\\n  const tasks = listTasks.all(project.id).filter(task =>\\n    filter === 'All' || Boolean(task.completed) === (filter === 'Completed'));\\n  const rows = tasks.map(task => `<li data-testid=\\\"task-row\\\">\\n    <span>${escapeHtml(task.title)}</span>\\n    <form action=\\\"/projects/${project.id}/tasks/${task.id}\\\" method=\\\"post\\\">\\n      <input type=\\\"hidden\\\" name=\\\"filter\\\" value=\\\"${filter}\\\">\\n      <input type=\\\"checkbox\\\" name=\\\"completed\\\" value=\\\"1\\\" aria-label=\\\"${escapeHtml(`Complete ${task.title}`)}\\\" ${task.completed ? 'checked' : ''} onchange=\\\"this.form.requestSubmit()\\\">\\n    </form>\\n  </li>`).join('');\\n  return page(project.name, `<h1>${escapeHtml(project.name)}</h1>\\n    <form action=\\\"/\\\" method=\\\"get\\\"><button type=\\\"submit\\\">Projects</button></form>\\n    <h2>Tasks</h2>\\n    <form class=\\\"create\\\" action=\\\"/projects/${project.id}/tasks\\\" method=\\\"post\\\">\\n      <input type=\\\"hidden\\\" name=\\\"filter\\\" value=\\\"${filter}\\\">\\n      <label for=\\\"task-title\\\">Task title</label>\\n      <input id=\\\"task-title\\\" name=\\\"title\\\" type=\\\"text\\\">\\n      ${error ? `<p role=\\\"alert\\\">${escapeHtml(error)}</p>` : ''}\\n      <button type=\\\"submit\\\">Create task</button>\\n    </form>\\n    <form class=\\\"filter\\\" action=\\\"/projects/${project.id}\\\" method=\\\"get\\\">\\n      <label for=\\\"task-filter\\\">Task filter</label>\\n      <select id=\\\"task-filter\\\" name=\\\"filter\\\" onchange=\\\"this.form.requestSubmit()\\\">\\n        ${['All', 'Open', 'Completed'].map(option => `<option${option === filter ? ' selected' : ''}>${option}</option>`).join('')}\\n      </select>\\n    </form>\\n    ${rows ? `<ul>${rows}</ul>` : '<p>No matching tasks.</p>'}`);\\n}\\n\\nfunction html(response, status, content) {\"},{\"oldText\":\"      let body = '';\\n      for await (const chunk of request) {\\n        body += chunk.toString();\\n        if (Buffer.byteLength(body) > 65536) {\\n          html(response, 413, page('Request too large', '<h1>Request too large</h1>'));\\n          return;\\n        }\\n      }\\n      const name = (new URLSearchParams(body).get('name') || '').trim();\",\"newText\":\"      const form = await readForm(request);\\n      const name = (form.get('name') || '').trim();\"},{\"oldText\":\"      response.writeHead(303, { Location: '/' });\\n      response.end();\",\"newText\":\"      redirect(response, '/');\"},{\"oldText\":\"    const match = /^\\\\/projects\\\\/(\\\\d+)$/.exec(url.pathname);\",\"newText\":\"    const taskMatch = /^\\\\/projects\\\\/(\\\\d+)\\\\/tasks(?:\\\\/(\\\\d+))?$/.exec(url.pathname);\\n    if (request.method === 'POST' && taskMatch) {\\n      const project = findProject.get(taskMatch[1]);\\n      if (project) {\\n        const form = await readForm(request);\\n        const filter = taskFilter(form.get('filter'));\\n        if (taskMatch[2]) {\\n          const result = updateTask.run(form.get('completed') === '1' ? 1 : 0, taskMatch[2], project.id);\\n          if (!result.changes) {\\n            html(response, 404, page('Not found', '<h1>Not found</h1>'));\\n            return;\\n          }\\n        } else {\\n          const title = (form.get('title') || '').trim();\\n          if (!title) {\\n            html(response, 400, projectPage(project, filter, 'Task title is required'));\\n            return;\\n          }\\n          createTask.run(project.id, title);\\n        }\\n        redirect(response, `/projects/${project.id}?filter=${filter}`);\\n        return;\\n      }\\n    }\\n    const match = /^\\\\/projects\\\\/(\\\\d+)$/.exec(url.pathname);\"},{\"oldText\":\"        html(response, 200, page(project.name, `<h1>${escapeHtml(project.name)}</h1>\\n          <form action=\\\"/\\\" method=\\\"get\\\"><button type=\\\"submit\\\">Projects</button></form>`));\",\"newText\":\"        html(respon