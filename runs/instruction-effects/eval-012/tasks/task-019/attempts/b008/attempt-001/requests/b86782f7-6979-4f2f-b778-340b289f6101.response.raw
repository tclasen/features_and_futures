querySelector('#from').value.trim(), through = app.querySelector('#through').value.trim(), alert = app.querySelector('#alert'); if ((from && !valid(from)) || (through && !valid(through))) { alert.textContent = 'Due range must use valid YYYY-MM-DD dates'; return; } if (from && through && from > through) { alert.textContent = 'Due from must not be after Due through'; return; } range = { from, through }; alert.textContent = ''; renderDirectory(); };\\n    for (const id of ['scope','filter','priority']) app.querySelector(`#${id}`).onchange = renderDirectory;\\n    renderDirectory();\\n  } else if (projectPath) {\\n    loadProjects().then(projects => {\"},{\"oldText\":\"      <form id=\\\"create-form\\\"><label>Project name<input name=\\\"name\\\" aria-label=\\\"Project name\\\"></label><button type=\\\"submit\\\">Create project</button></form>\",\"newText\":\"      <button type=\\\"button\\\" id=\\\"directory-link\\\">Task directory</button>\\n      <form id=\\\"create-form\\\"><label>Project name<input name=\\\"name\\\" aria-label=\\\"Project name\\\"></label><button type=\\\"submit\\\">Create project</button></form>\"} ,{\"oldText\":\"    const alert = app.querySelector('#alert');\\n    const form = app.querySelector('#create-form');\",\"newText\":\"    const alert = app.querySelector('#alert');\\n    app.querySelector('#directory-link').onclick = () => go('/directory');\\n    const form = app.querySelector('#create-form');\"}]}","call_id":"call_er4i8UqrkKEP83MJ6I9ja4oq","name":"edit"},"output_index":0,"sequence_number":1340}

