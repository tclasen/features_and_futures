= p.id\\n  WHERE p.archived = ? ORDER BY p.id, t.position, t.id\\n`);\\nconst insertTask = database.prepare\"},{\"oldText\":\"function searchQuery(params) {\",\"newText\":\"function taskMatches(task, filter, priority, range) {\\n  return searchMatches(task.title, range.search || '')\\n    && (filter === 'Deleted' ? Boolean(task.deleted) : !task.deleted\\n      && (filter === 'All' || Boolean(task.completed) === (filter === 'Completed')))\\n    && (priority === 'All' || task.priority === priority)\\n    && ((!range.from && !range.through) || (task.due_date\\n      && (!range.from || task.due_date >= range.from)\\n      && (!range.through || task.due_date <= range.through)));\\n}\\n\\nfunction searchQuery(params) {\"},{\"oldText\":\"    <h1>Workboard</h1>\",\"newText\":\"    <h1>Workboard</h1>\\n    <form action=\\\"/directory\\\" method=\\\"get\\\"><button type=\\\"submit\\\">Task directory</button></form>\"},{\"oldText\":\"    .filter(task => searchMatches(task.title, search)\\n      && (filter === 'Deleted' ? Boolean(task.deleted) : !task.deleted\\n        && (filter === 'All' || Boolean(task.completed) === (filter === 'Completed')))\\n      && (priority === 'All' || task.priority === priority)\\n      && ((!range.from && !range.through) || (task.due_date\\n        && (!range.from || task.due_date >= range.from)\\n        && (!range.through || task.due_date <= range.through))))\",\"newText\":\"    .filter(task => taskMatches(task, filter, priority, range))\"},{\"oldText\":\"function sendHtml(response, status, html) {\",\"newText\":\"function directoryPage(scope, filter, priority, range, error = '') {\\n  const search = range.search || '';\\n  const hidden = (name, value) => `<input type=\\\"hidden\\\" name=\\\"${name}\\\" value=\\\"${escapeHtml(value)}\\\">`;\\n  const selections = hidden('scope', scope) + hidden('filter', filter) + hidden('priorityFilter', priority);\\n  const boundaries = hidden('dueFrom', range.from) + hidden('dueThrough', range.through);\\n  const select = (label, id, name, options, selected) => `\\n    <label for=\\\"${id}\\\">${label}</label>\\n    <select id=\\\"${id}\\\" name=\\\"${name}\\\" onchange=\\\"this.form.requestSubmit()\\\">\\n      ${options.map(value => `<option${value === selected ? ' selected' : ''}>${value}</option>`).join('')}\\n    </select>`;\\n  const rows = listDirectoryTasks.all(scope === 'Archived' ? 1 : 0)\\n    .filter(task => taskMatches(task, filter, priority, range))\\n    .map(task => `\\n      <li data-testid=\\\"directory-task-row\\\">\\n        <span data-testid=\\\"directory-task-title\\\">${escapeHtml(task.title)}</span>\\n        <span data-testid=\\\"directory-project-name\\\">${escapeHtml(task.project_name)}</span>\\n        <span data-testid=\\\"directory-task-completion\\\">${task.completed ? 'Completed' : 'Open'}</span>\\n        <span data-testid=\\\"directory-task-priority\\\">${escapeHtml(task.priority)}</span>\\n        <span data-testid=\\\"directory-task-due-date\\\">${escapeHtml(task.due_date)}</span>\\n        <div data-testid=\\\"directory-task-notes\\\" style=\\\"white-space: pre-wrap\\\">${escapeHtml(task.notes)}</div>\\n        <form action=\\\"/projects/${task.project_id}\\\" method=\\\"get\\\"><button type=\\\"submit\\\">Open project</button></form>\\n      </li>`).join('');\\n  return page('Task directory', `\\n    <h1>Task directory</h1>\\n    <form action=\\\"/\\\" method=\\\"get\\\"><button type=\\\"submit\\\">Projects</button></form>\\n    ${error ? `<p role=\\\"alert\\\">${escapeHtml(error)}</p>` : ''}\\n    <form action=\\\"/directory\\\" method=\\\"get\\\" class=\\\"filter-form\\\">\\n      ${boundaries}${hidden('search', search)}\\n      ${select('Project scope', 'project-scope', 'scope', ['Active', 'Archived'], scope)}\\n      ${select('Task filter', 'task-filter', 'filter', ['All', 'Open', 'Completed', 'Deleted'], filter)}\\n      ${select('Priority filter', 'priority-filter', 'priorityFilter', ['All', ...priorities], priority)}\\n    </form>\\n    <form action=\\\"/directory\\\" method=\\\"get\\\" class=\\\"filter-form\\\">\\n      ${selections}${boundaries}\\n      <label for=\\\"directory-search\\\">Directory search</label>\\n      <input id=\\\"directory-search\\\" name=\\\"search\\\" type=\\\"text\\\" value=\\\"${escapeHtml(search)}\\\">\\n      <button type=\\\"submit\\\">Search directory</button>\\n    </form>\\n    <form action=\\\"/directory/due-range\\\" method=\\\"get\\\" class=\\\"filter-form\\\">\\n      ${selections}${boundaries}${hidden('search', search)}\\n      <label for=\\\"due-from\\\">Due from</label>\\n      <input id=\\\"due-from\\\" name=\\\"from\\\" type=\\\"text\\\" value=\\\"${escapeHtml(range.from)}\\\">\\n      <label for=\\\"due-through\\\">Due through</label>\\n      <input id=\\\"due-through\\\" name=\\\"through\\\" type=\\\"text\\\" value=\\\"${escapeHtml(range.through)}\\\">\\n      <button type=\\\"submit\\\">Apply due range</button>\\n    </form>\\n    <ul class=\\\"projects tasks\\\">${rows}</ul>`);\\n}\\n\\nfunction sendHtml(response, status, html) {\"},{\"oldText\":\"    } else if (request.method === 'POST' && url.pathname === '/projects/import') {\",\"newText\":\"    } else if (request.method === 'GET' && ['/directory', '/directory/due-range'].includes(url.pathname)) {\\n      const params = url.searchParams;\\n      const scope = projectFilter(params.get('scope'));\\n      const filter = taskFilter(params.get('filter'));\\n      const priority = priorityFilter(params.get('priorityFilter'));\\n      const previous = dueRange(params);\\n      const range = url.pathname === '/directory/due-range'\\n        ? { from: (params.get('from') || '').trim(), through: (params.get('through') || '').trim(), search: previous.search }\\n        : previous;\\n      const error = rangeError(range);\\n      sendHtml(response, error ? 422 : 200, directoryPage(scope, filter, priority, error ? previous : range, error));\\n    } else if (request.method === 'POST' && url.pathname === '/projects/import') {\"}]}","status":"completed"}],"error":null,"incomplete_details":null,"tools":[{"type":"function","name":"read","description":"Read the contents of a file. Supports text files and images (jpg, png, gif, webp, bmp). Images are sent as attachments. For text files, output is truncated to 2000 lines or 50KB (whichever is hit first). Use offset/limit for large files. When you need the full file, continue with offset until complete.","parameters":{"type":"object","required":["path","offset","limit"],"properties":{"path":{"type":"string","description":"Path to the file to read (relative or absolute)"},"offset":{"anyOf":[{"type":"number","description":"Line number to start reading from (1-indexed)"},{"type":"null"}]},"limit":{"anyOf":[{"type":"number","description":"Maximum number of lines to read"},{"type":"null"}]}},"additionalProperties":false},"output_schema":null,"strict":true},{"type":"function","name":"bash","description":"Execute a bash command in the current working directory. Returns stdout and stderr. Output is truncated to last 2000 lines or 50KB (whichever is hit first). If truncated, full output is saved to a temp file. Optionally provide a timeout in seconds.","parameters":{"type":"object","required":["command","timeout"],"properties":{"command":{"type":"string","description":"Shell command to execute"},"timeout":{"anyOf":[{"type":"number","description":"Timeout in seconds (optional, no default timeout)"},{"type":"null"}]}},"additionalProperties":false},"output_schema":null,"strict":true},{"type":"function","name":"edit","description":"Edit a single file using exact text replacement. Every edits[].oldText must match a unique, non-overlapping region of the original file. If two changes affect the same block or nearby lines, merge them into one edit instead of emitting overlapping edits. Do not include large unchanged regions just to connect distant changes.","parameters":{"type":"object","required":["path","edits"],"properties":{"path":{"