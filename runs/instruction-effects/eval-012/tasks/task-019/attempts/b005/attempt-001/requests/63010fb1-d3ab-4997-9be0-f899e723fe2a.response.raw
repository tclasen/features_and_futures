, filters, search.form, list);\",\"newText\":\"  const directory = element('button', 'Task directory');\\n  directory.type = 'button';\\n  directory.addEventListener('click', () => location.assign('/directory'));\\n  app.append(directory, form, projectImportControl(), filters, search.form, list);\"},{\"oldText\":\"async function showTasks(project) {\",\"newText\":\"// Shared controls keep directory and project filtering/validation semantics identical.\\nfunction taskFilters(onChange) {\\n  const filters = element('div');\\n  filters.className = 'task-filter';\\n  function selectControl(labelText, id, values) {\\n    const label = element('label', labelText);\\n    label.htmlFor = id;\\n    const select = element('select');\\n    select.id = id;\\n    for (const value of values) {\\n      const option = element('option', value);\\n      option.value = value;\\n      select.append(option);\\n    }\\n    select.addEventListener('change', onChange);\\n    filters.append(label, select);\\n    return select;\\n  }\\n  const completion = selectControl('Task filter', 'task-filter', ['All', 'Open', 'Completed', 'Deleted']);\\n  const priority = selectControl('Priority filter', 'priority-filter', ['All', 'Low', 'Normal', 'High']);\\n  const rangeForm = element('form');\\n  function boundary(labelText, id) {\\n    const label = element('label', labelText);\\n    label.htmlFor = id;\\n    const input = element('input');\\n    input.id = id;\\n    input.type = 'text';\\n    rangeForm.append(label, input);\\n    return input;\\n  }\\n  const fromInput = boundary('Due from', 'due-from');\\n  const throughInput = boundary('Due through', 'due-through');\\n  const apply = element('button', 'Apply due range');\\n  apply.type = 'submit';\\n  rangeForm.append(apply);\\n  let from = '';\\n  let through = '';\\n  rangeForm.addEventListener('submit', (event) => {\\n    event.preventDefault();\\n    app.querySelector('[role=\\\"alert\\\"]')?.remove();\\n    const nextFrom = normalizeDueDate(fromInput.value);\\n    const nextThrough = normalizeDueDate(throughInput.value);\\n    if (nextFrom === null || nextThrough === null) {\\n      showAlert('Due range must use valid YYYY-MM-DD dates');\\n      return;\\n    }\\n    if (nextFrom && nextThrough && nextFrom > nextThrough) {\\n      showAlert('Due from must not be after Due through');\\n      return;\\n    }\\n    fromInput.value = from = nextFrom;\\n    throughInput.value = through = nextThrough;\\n    onChange();\\n  });\\n  return {\\n    filters, rangeForm,\\n    matches: (task) =>\\n      (completion.value === 'Deleted' ? task.deleted : !task.deleted\\n        && (completion.value === 'All'\\n          || (completion.value === 'Completed' ? task.completed : !task.completed)))\\n      && (priority.value === 'All' || task.priority === priority.value)\\n      && ((!from && !through) || (task.dueDate\\n        && (!from || task.dueDate >= from)\\n        && (!through || task.dueDate <= through))),\\n  };\\n}\\n\\nasync function showDirectory() {\\n  document.title = 'Task directory — Workboard';\\n  app.replaceChildren(element('h1', 'Task directory'));\\n  const back = element('button', 'Projects');\\n  back.type = 'button';\\n  back.addEventListener('click', () => location.assign('/'));\\n  const scopeLabel = element('label', 'Project scope');\\n  scopeLabel.htmlFor = 'project-scope';\\n  const scope = element('select');\\n  scope.id = scopeLabel.htmlFor;\\n  for (const value of ['Active', 'Archived']) {\\n    const option = element('option', value);\\n    option.value = value;\\n    scope.append(option);\\n  }\\n  const scopeControl = element('div');\\n  scopeControl.className = 'project-filter';\\n  scopeControl.append(scopeLabel, scope);\\n  const controls = taskFilters(renderDirectory);\\n  const search = searchControl('Directory search', 'Search directory', 'directory-search', renderDirectory);\\n  const list = element('ul');\\n  list.className = 'directory';\\n  let tasks = [];\\n  function renderDirectory() {\\n    list.replaceChildren(...tasks.filter((task) =>\\n      task.projectArchived === (scope.value === 'Archived')\\n      && controls.matches(task) && search.matches(task.title)).map((task) => {\\n      const row = element('li');\\n      row.dataset.testid = 'directory-task-row';\\n      for (const [field, text] of [\\n        ['title', task.title], ['project-name', task.projectName],\\n        ['completion', task.completed ? 'Completed' : 'Open'],\\n        ['priority', task.priority], ['due-date', task.dueDate], ['notes', task.notes],\\n      ]) {\\n        const value = element('div', text);\\n        value.dataset.testid = field === 'project-name' ? 'directory-project-name' : `directory-task-${field}`;\\n        row.append(value);\\n      }\\n      const open = element('button', 'Open project');\\n      open.type = 'button';\\n      open.addEventListener('click', () => location.assign(`/projects/${task.projectId}`));\\n      row.append(open);\\n      return row;\\n    }));\\n  }\\n  scope.addEventListener('change', renderDirectory);\\n  app.append(back, scopeControl, controls.filters, controls.rangeForm, search.form, list);\\n  try {\\n    tasks = await api('/api/directory');\\n    renderDirectory();\\n  } catch (error) {\\n    showAlert(error.message);\\n  }\\n}\\n\\nasync function showTasks(project) {\"},{\"oldText\":\"(match ? showProject(match[1]) : showProjects()).finally(() => {\",\"newText\":\"(match ? showProject(match[1]) : location.pathname === '/directory' ? showDirectory() : showProjects()).finally(() => {\"}]}","status":"completed"}],"error":null,"incomplete_details":null,"tools":[{"type":"function","name":"read","description":"Read the contents of a file. Supports text files and images (jpg, png, gif, webp, bmp). Images are sent as attachments. For text files, output is truncated to 2000 lines or 50KB (whichever is hit first). Use offset/limit for large files. When you need the full file, continue with offset until complete.","parameters":{"type":"object","required":["path","offset","limit"],"properties":{"path":{"type":"string","description":"Path to the file to read (relative or absolute)"},"offset":{"anyOf":[{"type":"number","description":"Line number to start reading from (1-indexed)"},{"type":"null"}]},"limit":{"anyOf":[{"type":"number","description":"Maximum number of lines to read"},{"type":"null"}]}},"additionalProperties":false},"output_schema":null,"strict":true},{"type":"function","name":"bash","description":"Execute a bash command in the current working directory. Returns stdout and stderr. Output is truncated to last 2000 lines or 50KB (whichever is hit first). If truncated, full output is saved to a temp file. Optionally provide a timeout in seconds.","parameters":{"type":"object","required":["command","timeout"],"properties":{"command":{"type":"string","description":"Shell command to execute"},"timeout":{"anyOf":[{"type":"number","description":"Timeout in seconds (optional, no default timeout)"},{"type":"null"}]}},"additionalProperties":false},"output_schema":null,"strict":true},{"type":"function","name":"edit","description":"Edit a single file using exact text replacement. Every edits[].oldText must match a unique, non-overlapping region of the original file. If two changes affect the same block or nearby lines, merge them into one edit instead of emitting overlapping edits. Do not include large unchanged regions just to connect distant changes.","parameters":{"type":"object","required":["path","edits"],"properties":{"path":{"type":"string","description":"Path to the file to edit (relative or absolute)"},"edits":{"type":"array","items":{"type":"object","required":["oldText","newText"],"properties":{"oldText":{"type":"string","description":"Exact text for one targeted replacement. It must be unique in the original file and must not overlap with any other edits[].oldText in the same call."},"newText":{"type":"string","description":"Replacement text for this targeted edit."}},"additionalProperties":false},"description":"One or more targeted replacements. Each edit is matched against the original file, not incrementally. Do not include overlapping or nested edits. If two changes touch the same block or nearby lines, merge them into one edit instead."}},"additionalProperties":false},"output_schema":null,"strict":true},{"type":"function","name":"write","description":"Write content to a file. Creates the file if it doesn't exist, overwrites if it does. Automatically creates parent directories.","parameters":{"type":"object","required":["path","content"],"properties":{"path":{"type":"string","description":"Path to the file to write (relative or absolute)"},"content":{"type":"string","description":"Content to write to the file"}},"additionalProperties":false},"output_schema":null,"strict":true}],"tool_choice":"auto","parallel_tool_calls":true,"prompt_cache_key":"41b267cd-24e0-468e-aa02-862e9a84e7aa","prompt_cache_retention":"24h","text":{"format":{"type":"text"},"verbosity":"low"},"top_p":0.98,"top_logprobs":0,"temperature":1.0,"reasoning":{"effort":"medium","summary":"detailed","context":"all_turns","mode":"standard"},"user":null,"usage":{"input_tokens":23647,"input_tokens_details":{"cached_tokens":0,"cache_write_tokens":0},"output_tokens":1503,"output_tokens_details":{"reasoning_tokens":49},"total_tokens":25150,"attribution":{"items":{"fc_039b364c56a36d44016acb5a3f40d88197af3dc04376083748":{"input_tokens":34,"cached_tokens":0,"cache_write_tokens":0,"output_tokens":0},"fc_039b364c56a36d44016acb5a4305988197bd0f6a1790061912":{"input_tokens":28,"cached_tokens":0,"cache_write_tokens":0,"output_tokens":0},"fc_039b364c56a36d44016acb5a456f0481978fcbb2e20a357eca":{"input_tokens":29,"cached_tokens":0,"cache_write_tokens":0,"output_tokens":0},"fc_039b364c56a36d44016acb5a4ae9fc819789c5e66552894f7b":{"input_tokens":51,"cached_tokens":0,"cache_write_tokens":0,"output_tokens":0},"fc_039b364c56a36d44016acb5a4d87cc81978c087366dd0296b6":{"input_tokens":24,"cache