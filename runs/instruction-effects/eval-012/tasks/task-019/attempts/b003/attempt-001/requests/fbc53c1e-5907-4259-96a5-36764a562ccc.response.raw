de:fs/promises';\\nimport { tmpdir } from 'node:os';\\nimport { join } from 'node:path';\\nimport { once } from 'node:events';\\nimport { DatabaseSync } from 'node:sqlite';\\n\\ntest('directory is read-only, ordered, intersects filters and preserves portable task values', async () => {\\n  const dir = await mkdtemp(join(tmpdir(), 'workboard-directory-'));\\n  const dbPath = join(dir, 'db.sqlite');\\n  let child, base;\\n  const start = async () => {\\n    child = spawn(process.execPath, ['server.js'], { env: { ...process.env, PORT: '0', DB_PATH: dbPath }, stdio: ['ignore', 'pipe', 'inherit'] });\\n    base = await new Promise((resolve, reject) => {\\n      const timer = setTimeout(() => reject(new Error('Startup timeout')), 5000);\\n      child.stdout.on('data', chunk => {\\n        const match = /listening on port (\\\\d+)/.exec(String(chunk));\\n        if (match) { clearTimeout(timer); resolve(`http://127.0.0.1:${match[1]}`); }\\n      });\\n    });\\n  };\\n  const stop = async () => { const exit = once(child, 'exit'); child.kill(); await exit; };\\n  const post = (path, data) => fetch(base + path, { method: 'POST', body: new URLSearchParams(data), redirect: 'manual' });\\n  const html = async path => (await fetch(base + path)).text();\\n  const titles = text => [...text.matchAll(/data-testid=\\\"directory-task-title\\\"[^>]*>(.*?)<\\\\/div>/gs)].map(match => match[1]);\\n  const snapshot = () => {\\n    const db = new DatabaseSync(dbPath);\\n    try { return ['projects', 'tasks', 'task_positions'].map(table => db.prepare(`SELECT * FROM ${table} ORDER BY rowid`).all()); }\\n    finally { db.close(); }\\n  };\\n  const task = (title, extra = {}) => ({ title, completed: false, priority: 'Normal', dueDate: '', notes: '', deleted: false, ...extra });\\n  const importProject = (name, archived, tasks) => post('/projects/import', { importName: name, json: JSON.stringify({ format: 'workboard-project', version: 1, project: { name, archived, defaultPriority: 'Low', tasks } }) });\\n  try {\\n    await start();\\n    assert.match(await html('/'), /action=\\\"\\\\/directory\\\"><button type=\\\"submit\\\">Task directory/);\\n    await importProject('Owner needle', false, [\\n      task('First', { notes: 'needle only in notes' }),\\n      task('  MiXeD  \\\\t Title 雪  ', { completed: true, priority: 'High', dueDate: '2024-02-29', notes: '  <b>&雪</div>\\\\nnext\\\\n ' }),\\n      task('Deleted one', { deleted: true, priority: 'High', dueDate: '2024-02-29' }),\\n      task('Deleted two', { deleted: true })\\n    ]);\\n    await importProject('Second owner', false, [task('Last', { priority: 'High', dueDate: '2024-03-01' })]);\\n    await importProject('Archived owner', true, [task('Archived live'), task('Archived deleted', { deleted: true })]);\\n    const before = snapshot();\\n    let result = await html('/directory');\\n    assert.deepEqual(titles(result), ['First', '  MiXeD  \\\\t Title 雪  ', 'Last']);\\n    for (const id of ['directory-project-name', 'directory-task-completion', 'directory-task-priority', 'directory-task-due-date', 'directory-task-notes']) assert.ok(result.includes(`data-testid=\\\"${id}\\\"`));\\n    assert.ok(result.includes('  &lt;b&gt;&amp;雪&lt;/div&gt;\\\\nnext\\\\n '));\\n    assert.match(result, /data-testid=\\\"directory-task-completion\\\">Completed/);\\n    assert.match(result, /action=\\\"\\\\/projects\\\\/1\\\"><button type=\\\"submit\\\">Open project/);\\n    assert.doesNotMatch(result, /<textarea|type=\\\"checkbox\\\"|Rename task|Save notes|Move task|Delete task|Restore task/);\\n    assert.match(result, /<option selected>Active<\\\\/option><option>Archived<\\\\/option>/);\\n    assert.match(result, /<option selected>All<\\\\/option><option>Open<\\\\/option><option>Completed<\\\\/option><option>Deleted<\\\\/option>/);\\n    assert.match(result, /<option selected>All<\\\\/option><option>Low<\\\\/option><option>Normal<\\\\/option><option>High<\\\\/option>/);\\n    assert.deepEqual(titles(await html('/directory?search=needle')), []);\\n    const params = new URLSearchParams({ filter: 'Completed', priorityFilter: 'High', search: '  mixed\\\\t title  ', dueFrom: '2024-02-29', dueThrough: '2024-02-29' });\\n    result = await html('/directory?' + params);\\n    assert.deepEqual(titles(result), ['  MiXeD  \\\\t Title 雪  ']);\\n    assert.match(result, /value=\\\"2024-02-29\\\"/);\\n    assert.match(result, /<option selected>Completed/);\\n    assert.match(result, /<option selected>High/);\\n    assert.deepEqual(titles(await html('/directory?filter=Deleted')), ['Deleted one', 'Deleted two']);\\n    assert.deepEqual(titles(await html('/directory?filter=Deleted&priorityFilter=High&dueFrom=2024-02-29&dueThrough=2024-02-29')), ['Deleted one']);\\n    assert.deepEqual(titles(await html('/directory?scope=Archived')), ['Archived live']);\\n    assert.deepEqual(titles(await html('/directory?scope=Archived&filter=Deleted')), ['Archived deleted']);\\n    assert.deepEqual(titles(await html('/directory?filter=Open&priorityFilter=High&dueThrough=2024-03-01')), ['Last']);\\n    for (const [from, through, message] of [\\n      ['1900-02-29', '', 'Due range must use valid YYYY-MM-DD dates'],\\n      ['2024-03-01', '2024-02-29', 'Due from must not be after Due through']\\n    ]) {\\n      const invalid = new URLSearchParams(params);\\n      invalid.set('applyRange', '1'); invalid.set('rangeFrom', from); invalid.set('rangeThrough', through);\\n      result = await html('/directory?' + invalid);\\n      assert.ok(result.includes('role=\\\"alert\\\">' + message));\\n      assert.deepEqual(titles(result), ['  MiXeD  \\\\t Title 雪  ']);\\n    }\\n    const valid = new URLSearchParams(params);\\n    valid.set('applyRange', '1'); valid.set('rangeFrom', ' 2024-02-29 '); valid.set('rangeThrough', '');\\n    const response = await fetch(base + '/directory?' + valid, { redirect: 'manual' });\\n    assert.equal(response.status, 303);\\n    const location = response.headers.get('location');\\n    const applied = new URL(location, base).searchParams;\\n    assert.equal(applied.get('filter'), 'Completed'); assert.equal(applied.get('priorityFilter'), 'High');\\n    assert.equal(applied.get('dueFrom'), '2024-02-29'); assert.equal(applied.get('dueThrough'), '');\\n    assert.equal(applied.get('search'), 'mixed\\\\t title');\\n    assert.deepEqual(titles(await html(location)), ['  MiXeD  \\\\t Title 雪  ']);\\n    assert.deepEqual(snapshot(), before);\\n    await stop(); await start();\\n    assert.deepEqual(titles(await html('/directory')), ['First', '  MiXeD  \\\\t Title 雪  ', 'Last']);\\n    assert.deepEqual(snapshot(), before);\\n  } finally { if (child && child.exitCode === null) await stop(); await rm(dir, { recursive: true, force: true }); }\\n});\\n\"}","status":"completed"}],"error":null,"incomplete_details":null,"tools":[{"type":"function","name":"read","description":"Read the contents of a file. Supports text files and images (jpg, png, gif, webp, bmp). Images are sent as attachments. For text files, output is truncated to 2000 lines or 50KB (whichever is hit first). Use offset/limit for large files. When you need the full file, continue with offset until complete.","parameters":{"type":"object","required":["path","offset","limit"],"properties":{"path":{"type":"string","description":"Path to the file to read (relative or absolute)"},"offset":{"anyOf":[{"type":"number","description":"Line number to start reading from (1-indexed)"},{"type":"null"}]},"limit":{"anyOf":[{"type":"number","description":"Maximum number of lines to read"},{"type":"null"}]}},"additionalProperties":false},"output_schema":null,"strict":true},{"type":"function","name":"bash","description":"Execute a bash command in the current working directory. Returns stdout and stderr. Output is truncated to last 2000 lines or 50KB (whichever is hit first). If truncated, full output is saved to a temp file. Optionally provide a timeout in seconds.","parameters":{"type":"object","required":["command","timeout"],"properties":{"command":{"type":"string","description":"Shell command to execute"},"timeout":{"anyOf":[{"type":"number","description":"Timeout in seconds (optional, no default timeout)"},{"type":"null"}]}},"additionalProperties":false},"output_schema":null,"strict":true},{"type":"function","name":"edit","description":"Edit a single file using exact text replacement. Every edits[].oldText must match a unique, non-overlapping region of the original file. If two changes affect the same block or nearby lines, merge them into one edit instead of emitting overlapping edits. Do not include large unchanged regions just to connect distant changes.","parameters":{"type":"object","required":["path","edits"],"properties":{"path":{"type":"string","description":"Path to the file to edit (relative or absolute)"},"edits":{"type":"array","items":{"type":"object","required":["oldText","newText"],"properties":{"oldText":{"type":"string","description":"Exact text for one targeted replacement. It must be unique in the original file and must not overlap with any other edits[].oldText in the same call."},"newText":{"type":"string","description":"Replacement text for this targeted edit."}},"additionalProperties":false},"description":"One or more targeted replacements. Each edit is matched against the original file, not incrementally. Do not include overlapping or nested edits. If two changes touch the same block or nearby lines, merge them into one edit instead."}},"additionalProperties":false},"output_schema":null,"strict":true},{"type":"function","name":"write","description":"Write content to a file. Creates the file if it doesn't exist, overwrites if it does. Automatically creates parent directories.","parameters":{"type":"object","required":["path","content"],"properties":{"path":{"type":"string","description":"Path to the file to write (relative or absolute)"},"content":{"type":"string","description":"Content to write to the file"}},"additionalProperties":false},"output_schema":null,"strict":true}],"tool_choice":"auto","parallel_tool_calls":true,"prompt_cache_key":"0f1502ee-ba66-4771-9ec3-6d1d62e987f1","prompt_cache_retention":"24h","text":{"format":{"type":"text"},"verbosity":"low"},"top_p":0.98,"top_logprobs":0,"temperature":1.0,"reasoning":{"effort":"medium","summary":"detailed","context":"all_turns","mode":"standard"},"user":null,"usage":{"input_tokens":17459,"input_tokens_details":{"cached_tokens":0,"cache_write_tokens":0},"output_tokens":1961,"output_tokens_details":{"reasoning_tokens":16},"total_tokens":19420,"attribution":{"items":{"fc_00d20d1b08180855016acb5a40f1dc87d1a66cd7f70e89d91b":{"input_tokens":34,"cached_tokens":0,"cache_write_tokens":0,"output_tokens":0},"fc_00d20d1b08180855016acb5a439efc87d1a5e7347d4896ddd4":{"input_tokens":28,"cached_tokens":0,"cache_write_tokens":0,"output_tokens":0},"fc_00d20d1b08180855016acb5a45cb9487d1873a405afbdc6880":{"input_tokens":28,"cached_tokens":0,"cache_write_tokens":0,"output_tokens":0},"fc_00d20d1b08180855016acb5a48e93487d189f185ff5e0b7a42":{"input_tokens":28,"cached_tokens":0,"cache_write_tokens":0,"output_tokens":0},"fc_00d20d1b08180855016acb5a4e28b487d1af20ab699f32e125":{"input_tokens":37,"cached_tokens":0,"cache_write_tokens":0,"output_tokens":0},"fc_00d20d1b08180855016acb5a5150a887d1badff09725188e51":{"input_tokens":30,"cached_tokens":0,"cache_write_tokens":0,"output_tokens":0},"fc_00d20d1b08180855016acb5a53b27487d1959648f90fe93531":{"input_tokens":1505,"cached_tokens":0,"cache_write_tokens":0,"output_tokens":0},"fc_00d20d1b08180855016acb5a700e4887d180c90f7f11e64afd":{"input_tokens":1519,"cached_tokens":0,"cache_write_tokens":0,"output_tokens":0,"content":[{"input_tokens":1519,"cached_tokens":0,"cache_write_tokens":0,"output_tokens":0}]},"fc_00d20d1b08180855016acb5a700e4887d1816530fd8e2fe84f":{"input_tokens":3312,"cached_tokens":0,"cache_write_tokens":0,"output_tokens":0,"content":[{"input_tokens":3312,"cached_tokens":0,"cache_write_tokens":0,"output_tokens":0}]},"fc_00d20d1b0818