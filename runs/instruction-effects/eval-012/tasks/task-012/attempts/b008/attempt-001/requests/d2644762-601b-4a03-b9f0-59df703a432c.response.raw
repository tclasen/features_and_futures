tasks WHERE project_id = ? ORDER BY sort_order, id');\\nconst createTask = database.prepare(\\\"INSERT INTO tasks (project_id, title, priority, sort_order) VALUES (?, ?, (SELECT default_priority FROM projects WHERE id = ?), COALESCE((SELECT MAX(sort_order) + 1 FROM tasks WHERE project_id = ?), 1))\\\");\\nconst rememberPosition = database.prepare('INSERT INTO task_project_positions (project_id, task_id, sort_order) VALUES (?, ?, ?)');\\nconst getRememberedPosition = database.prepare('SELECT sort_order AS sortOrder FROM task_project_positions WHERE project_id = ? AND task_id = ?');\\nconst nextProjectPosition = database.prepare('SELECT COALESCE(MAX(sort_order), 0) + 1 AS position FROM task_project_positions WHERE project_id = ?');\\nconst updateTaskProject = database.prepare('UPDATE tasks SET project_id = ?, sort_order = ? WHERE id = ? AND project_id = ?');\"},{\"oldText\":\"const moveTask = database.prepare('UPDATE tasks SET project_id = ?, sort_order = COALESCE((SELECT MAX(sort_order) + 1 FROM tasks WHERE project_id = ?), 1) WHERE id = ? AND project_id = ?');\",\"newText\":\"\"},{\"oldText\":\"        const result = moveTask.run(destinationId, destinationId, Number(taskRoute[2]), projectId);\\n        if (!result.changes) return send(res, 404, JSON.stringify({ error: 'Task not found' }));\\n        return send(res, 200, JSON.stringify({ success: true }));\",\"newText\":\"        const taskId = Number(taskRoute[2]);\\n        const position = getRememberedPosition.get(destinationId, taskId)?.sortOrder ?? nextProjectPosition.get(destinationId).position;\\n        database.exec('BEGIN');\\n        try {\\n          const result = updateTaskProject.run(destinationId, position, taskId, projectId);\\n          if (!result.changes) { database.exec('ROLLBACK'); return send(res, 404, JSON.stringify({ error: 'Task not found' })); }\\n          if (!getRememberedPosition.get(destinationId, taskId)) rememberPosition.run(destinationId, taskId, position);\\n          database.exec('COMMIT');\\n        } catch (error) { database.exec('ROLLBACK'); throw error; }\\n        return send(res, 200, JSON.stringify({ success: true }));\"},{\"oldText\":\"        const result = createTask.run(projectId, title, projectId, projectId);\\n        return send(res, 201, JSON.stringify(listTasks.all(projectId).find(task => task.id === Number(result.lastInsertRowid))));\",\"newText\":\"        const result = createTask.run(projectId, title, projectId, projectId);\\n        const taskId = Number(result.lastInsertRowid);\\n        const position = nextProjectPosition.get(projectId).position;\\n        rememberPosition.run(projectId, taskId, position);\\n        database.prepare('UPDATE tasks SET sort_order = ? WHERE id = ?').run(position, taskId);\\n        return send(res, 201, JSON.stringify(listTasks.all(projectId).find(task => task.id === taskId)));\"}]}","status":"completed"}],"error":null,"incomplete_details":null,"tools":[{"type":"function","name":"read","description":"Read the contents of a file. Supports text files and images (jpg, png, gif, webp, bmp). Images are sent as attachments. For text files, output is truncated to 2000 lines or 50KB (whichever is hit first). Use offset/limit for large files. When you need the full file, continue with offset until complete.","parameters":{"type":"object","required":["path","offset","limit"],"properties":{"path":{"type":"string","description":"Path to the file to read (relative or absolute)"},"offset":{"anyOf":[{"type":"number","description":"Line number to start reading from (1-indexed)"},{"type":"null"}]},"limit":{"anyOf":[{"type":"number","description":"Maximum number of lines to read"},{"type":"null"}]}},"additionalProperties":false},"output_schema":null,"strict":true},{"type":"function","name":"bash","description":"Execute a bash command in the current working directory. Returns stdout and stderr. Output is truncated to last 2000 lines or 50KB (whichever is hit first). If truncated, full output is saved to