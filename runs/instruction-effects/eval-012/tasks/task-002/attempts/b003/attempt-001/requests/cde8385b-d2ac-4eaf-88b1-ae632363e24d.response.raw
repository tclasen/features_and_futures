data: {"type":"response.function_call_arguments.done","sequence_number":1554,"item_id":"fc_0f372098bcfd90ee016acb456fe3e487d1b22778d6288beb0a","output_index":0,"arguments":"{\"path\":\"server.js\",\"edits\":[{\"oldText\":\"db.exec(`CREATE TABLE IF NOT EXISTS projects (\",\"newText\":\"db.exec(`PRAGMA foreign_keys = ON;\\nCREATE TABLE IF NOT EXISTS projects (\"},{\"oldText\":\"  name TEXT NOT NULL\\n)`);\",\"newText\":\"  name TEXT NOT NULL\\n);\\nCREATE TABLE IF NOT EXISTS tasks (\\n  id INTEGER PRIMARY KEY AUTOINCREMENT,\\n  project_id INTEGER NOT NULL REFERENCES projects(id),\\n  title TEXT NOT NULL,\\n  completed INTEGER NOT NULL DEFAULT 0 CHECK (completed IN (0, 1))\\n)`);\"},{\"oldText\":\"button:focus-visible, input:focus-visible\",\"newText\":\"select { padding: 10px; font: inherit; }\\ninput[type=checkbox] { width: auto; }\\n.task label { display: flex; align-items: center; gap: 12px; margin: 0; overflow-wrap: anywhere; }\\n.task { padding: 16px 0; border-top: 1px solid #dfe5ed; }\\n.task-create { margin-top: 28px; margin-bottom: 24px; }\\nbutton:focus-visible, input:focus-visible, select:focus-visible\"},{\"oldText\":\"const server = http.createServer(async (req, res) => {\",\"newText\":\"function taskFilter(value) {\\n  return ['All', 'Open', 'Completed'].includes(value) ? value : 'All';\\n}\\n\\nfunction projectPage(res, project, filter = 'All', error = '') {\\n  const tasks = db.prepare(`SELECT id, title, completed FROM tasks WHERE project_id = ?\\n    ${filter === 'All' ? '' : 'AND completed = ?'} ORDER BY id`)\\n    .all(...(filter === 'All' ? [project.id] : [project.id, filter === 'Completed' ? 1 : 0]));\\n  sendHtml(res, 200, page(project.name, `<h1>${escape(project.name)}</h1>\\n<form method=\\\"get\\\" action=\\\"/\\\"><button type=\\\"submit\\\">Projects</button></form>\\n${error ? `<p role=\\\"alert\\\">${escape(error)}</p>` : ''}\\n<form class=\\\"task-create\\\" method=\\\"post\\\" action=\\\"/projects/${project.id}/tasks\\\">\\n<input type=\\\"hidden\\\" name=\\\"filter\\\" value=\\\"${filter}\\\">\\n<label for=\\\"task-title\\\">Task title</label>\\n<div class=\\\"create\\\"><input id=\\\"task-title\\\" name=\\\"title\\\" type=\\\"text\\\"><button type=\\\"submit\\\">Create task</button></div>\\n</form>\\n<form method=\\\"get\\\" action=\\\"/projects/${project.id}\\\">\\n<label for=\\\"task-filter\\\">Task filter</label>\\n<select id=\\\"task-filter\\\" name=\\\"filter\\\" onchange=\\\"this.form.requestSubmit()\\\">\\n${['All', 'Open', 'Completed'].map(option => `<option${filter === option ? ' selected' : ''}>${option}</option>`).join('')}\\n</select></form>\\n<section class=\\\"projects\\\" aria-label=\\\"Tasks\\\">${tasks.map(task => `\\n<div class=\\\"task\\\" data-testid=\\\"task-row\\\">\\n<form method=\\\"post\\\" action=\\\"/projects/${project.id}/tasks/${task.id}\\\">\\n<input type=\\\"hidden\\\" name=\\\"filter\\\" value=\\\"${filter}\\\">\\n<label><input type=\\\"checkbox\\\" name=\\\"completed\\\" value=\\\"1\\\" aria-label=\\\"${escape(`Complete ${task.title}`)}\\\"${task.completed ? ' checked' : ''} onchange=\\\"this.form.requestSubmit()\\\"><span>${escape(task.title)}</span></label>\\n</form></div>`).join('')}\\n${tasks.length ? '' : '<p>No tasks to show.</p>'}</section>`));\\n}\\n\\nasync function formBody(req) {\\n  let body = '';\\n  for await (const chunk of req) {\\n    body += chunk.toString();\\n    if (Buffer.byteLength(body) > 1024 * 1024) {\\n      const error = new Error('Request too large');\\n      error.status = 413;\\n      throw error;\\n    }\\n  }\\n  return new URLSearchParams(body);\\n}\\n\\nconst server = http.createServer(async (req, res) => {\"},{\"oldText\":\"      let body = '';\\n      for await (const chunk of req) {\\n        body += chunk.toString();\\n        if (Buffer.byteLength(body) > 1024 * 1024) {\\n          res.writeHead(413);\\n          res.end('Request too large');\\n          return;\\n        }\\n      }\\n      const name = (new URLSearchParams(body).get('name') || '').trim();\",\"newText\":\"      const body = await formBody(req);\\n      const name = (body.get('name') || '').trim();\"},{\"oldText\":\"    const match = /^\\\\/projects\\\\/(\\\\d+)$/.exec(url.pathname);\",\"newText\":\"    const taskMatch = /^\\\\/projects\\\\/(\\\\d+)\\\\/tasks(?:\\\\/(\\\\d+))?$/.exec(url.pathname);\\n    if (req.method === 'POST' && taskMatch) {\\n      const project = db.prepare('SELECT id, name FROM projects WHERE id = ?').get(taskMatch[1]);\\n      if (project) {\\n        const body = await formBody(req);\\n        const filter = taskFilter(body.get('filter'));\\n        if (taskMatch[2]) {\\n          const result = db.prepare('UPDATE tasks SET completed = ? WHERE id = ? AND project_id = ?')\\n            .run(body.get('completed') === '1' ? 1 : 0, taskMatch[2], project.id);\\n          if (!result.changes) {\\n            sendHtml(res, 404, page('Not found', '<h1>Not found</h1>'));\\n            return;\\n          }\\n        } else {\\n          const title = (body.get('title') || '').trim();\\n          if (!title) {\\n            projectPage(res, project, filter, 'Task title is required');\\n            return;\\n          }\\n          db.prepare('INSERT INTO tasks (project_id, title) VALUES (?, ?)').run(project.id, title);\\n        }\\n        res.writeHead(303, { Location: `/projects/${project.id}?filter=${filter}` });\\n        res.end();\\n        return;\\n      }\\n    }\\n    const match = /^\\\\/projects\\\\/(\\\\d+)$/.exec(url.pathname);\"},{\"oldText\":\"        sendHtml(res, 200, page(project.name, `<h1>${escape(project.name)}</h1>\\n<form method=\\\"get\\\" action=\\\"/\\\"><button type=\\\"submit\\\">Projects</button></form>`));\",\"newText\":\"        projectPage(res, project, taskFilter(url.searchParams.get('filter')));\"},{\"oldText\":\"    console.error(error);\\n    if (!res.headersSent)\",\"newText\":\"    if (error.status === 413) {\\n      res.writeHead(413);\\n      res.end('Request too large');\\n      return;\\n    }\\n    console.error(error);\\n    if (!res.headersSent)\"}]}"}

