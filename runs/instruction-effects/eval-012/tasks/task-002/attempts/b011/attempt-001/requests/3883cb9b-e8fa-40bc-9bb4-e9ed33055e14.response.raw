+)$/);\\n      if (match) {\\n        const projectResponse = await fetch(`/api/projects/${match[1]}`);\\n        const project = projectResponse.ok ? await projectResponse.json() : null;\\n        if (!project) {\\n          app.innerHTML = `<h1>Project not found</h1><button type=\\\"button\\\" id=\\\"back\\\">Projects</button>`;\\n          app.querySelector('#back').addEventListener('click', () => navigate('/'));\\n          return;\\n        }\\n        const tasksResponse = await fetch(`/api/projects/${match[1]}/tasks`);\\n        const tasks = await tasksResponse.json();\\n        app.innerHTML = `<button type=\\\"button\\\" id=\\\"back\\\">Projects</button><h1>${escapeHtml(project.name)}</h1>\\n          <form id=\\\"task-form\\\"><label for=\\\"task-title\\\">Task title</label><input id=\\\"task-title\\\" name=\\\"title\\\" type=\\\"text\\\"><button type=\\\"submit\\\">Create task</button></form>\\n          <div id=\\\"message\\\" role=\\\"alert\\\" aria-live=\\\"polite\\\"></div>\\n          <div class=\\\"filter\\\"><label for=\\\"task-filter\\\">Task filter</label><select id=\\\"task-filter\\\"><option>All</option><option>Open</option><option>Completed</option></select></div>\\n          <section id=\\\"task-list\\\" aria-label=\\\"Tasks\\\"></section>`;\\n        app.querySelector('#back').addEventListener('click', () => navigate('/'));\\n        const filter = app.querySelector('#task-filter');\\n        const paintTasks = () => {\\n          const visible = tasks.filter(task => filter.value === 'All' || (filter.value === 'Completed') === Boolean(task.completed));\\n          app.querySelector('#task-list').innerHTML = visible.map(task => `<div class=\\\"row task-row\\\" data-testid=\\\"task-row\\\"><input type=\\\"checkbox\\\" id=\\\"task-${task.id}\\\" aria-label=\\\"Complete ${escapeHtml(task.title)}\\\" ${task.completed ? 'checked' : ''}><label for=\\\"task-${task.id}\\\">${escapeHtml(task.title)}</label></div>`).join('');\\n          app.querySelectorAll('#task-list input[type=\\\"checkbox\\\"]').forEach(box => box.addEventListener('change', async () => {\\n            const task = tasks.find(item => String(item.id) === box.id.slice(5));\\n            const response = await fetch(`/api/projects/${match[1]}/tasks/${task.id}`, { method: 'PATCH', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ completed: box.checked }) });\\n            if (response.ok) { task.completed = box.checked ? 1 : 0; paintTasks(); }\\n          }));\\n        };\\n        filter.addEventListener('change', paintTasks);\\n        paintTasks();\\n        app.querySelector('#task-form').addEventListener('submit', async event => {\\n          event.preventDefault();\\n          const input = app.querySelector('#task-title');\\n          const title = input.value.trim();\\n          if (!title) { app.querySelector('#message').textContent = 'Task title is required'; input.focus(); return; }\\n          const result = await fetch(`/api/projects/${match[1]}/tasks`, { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ title }) });\\n          if (result.ok) { tasks.push(await result.json()); input.value = ''; app.querySelector('#message').textContent = ''; paintTasks(); }\\n        });\\n        return;\\n      }\\n      const response = await fetch('/api/projects');\\n      const projects = await response.json();\\n      app.innerHTML = `<h1>Workboard</h1>\\n        <form id=\\\"create-form\\\"><label for=\\\"project-name\\\">Project name</label><input id=\\\"project-name\\\" name=\\\"name\\\" type=\\\"text\\\"><button type=\\\"submit\\\">Create project</button></form>\\n        <div id=\\\"message\\\" role=\\\"alert\\\" aria-live=\\\"polite\\\"></div>\\n        <section aria-label=\\\"Projects\\\">${projects.map(project => `<div class=\\\"row\\\" data-testid=\\\"project-row\\\"><span>${escapeHtml(project.name)}</span><button type=\\\"button\\\" data-open=\\\"${project.id}\\\">Open project</button></div>`).join('')}</section>`;\\n      app.querySelector('#create-form').addEventListener('submit', async event => {\\n        event.preventDefault();\\n        const input = app.querySelector('#project-name');\\n        const name = input.value.trim();\\n        if (!name) { app.querySelector('#message').textContent = 'Project name is required'; input.focus(); return; }\\n        const result = await fetch('/api/projects', { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ name }) });\\n        if (result.ok) render();\\n      });\\n      app.querySelectorAll('[data-open]').forEach(button => button.addEventListener('click', () => navigate(`/projects/${button.dataset.open}`)));\\n    }\\n    function navigate(path) { history.pushState({}, '', path); render(); }\\n    addEventListener('popstate', render);\\n    render();\\n  </script>\\n</body>\\n</html>\\n\"}","status":"completed"}}

