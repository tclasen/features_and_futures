data: {"type":"response.function_call_arguments.done","sequence_number":617,"item_id":"fc_0b471671a0bdb633016acb47fd0aac8194bd85ad8ebd335b06","output_index":1,"arguments":"{\"path\":\"server.js\",\"edits\":[{\"oldText\":\"const updateTask = database.prepare('UPDATE tasks SET completed = ? WHERE id = ? AND project_id = ?');\",\"newText\":\"const updateTask = database.prepare('UPDATE tasks SET completed = ? WHERE id = ? AND project_id = ?');\\nconst updateTaskTitle = database.prepare('UPDATE tasks SET title = ? WHERE id = ? AND project_id = ?');\"},{\"oldText\":\"  if (taskRoute && request.method === 'PATCH') {\",\"newText\":\"  if (taskRoute && request.method === 'PATCH') {\"},{\"oldText\":\"    if (typeof data.completed !== 'boolean') return send(response, 400, { error: 'Invalid completion state' });\\n    updateTask.run(data.completed ? 1 : 0, taskId, projectId);\\n    return send(response, 200, { ok: true });\",\"newText\":\"    if (typeof data.completed !== 'boolean') return send(response, 400, { error: 'Invalid completion state' });\\n    updateTask.run(data.completed ? 1 : 0, taskId, projectId);\\n    return send(response, 200, { ok: true });\"},{\"oldText\":\"  const renameRoute = url.pathname.match(/^\\\\/api\\\\/projects\\\\/([^/]+)\\\\/rename$/);\",\"newText\":\"  const taskRenameRoute = url.pathname.match(/^\\\\/api\\\\/projects\\\\/([^/]+)\\\\/tasks\\\\/([^/]+)\\\\/rename$/);\\n  if (taskRenameRoute && request.method === 'PATCH') {\\n    const projectId = decodeURIComponent(taskRenameRoute[1]);\\n    const taskId = decodeURIComponent(taskRenameRoute[2]);\\n    const project = findProject.get(projectId);\\n    if (!project) return send(response, 404, { error: 'Project not found' });\\n    if (project.archived) return send(response, 403, { error: 'Archived project' });\\n    if (!findTask.get(taskId, projectId)) return send(response, 404, { error: 'Task not found' });\\n    let input = '';\\n    for await (const chunk of request) input += chunk;\\n    let data;\\n    try { data = JSON.parse(input); } catch { return send(response, 400, { error: 'Invalid request' }); }\\n    const title = typeof data.title === 'string' ? data.title.trim() : '';\\n    if (!title) return send(response, 400, { error: 'Task title is required' });\\n    updateTaskTitle.run(title, taskId, projectId);\\n    return send(response, 200, { id: taskId, projectId, title });\\n  }\\n  const renameRoute = url.pathname.match(/^\\\\/api\\\\/projects\\\\/([^/]+)\\\\/rename$/);\"}]}"}

