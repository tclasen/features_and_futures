data: {"type":"response.function_call_arguments.done","sequence_number":1011,"item_id":"fc_033fedc7c1178dd3016acb4a51b2a8819693f38293747451cc","output_index":2,"arguments":"{\"path\":\"server.js\",\"edits\":[{\"oldText\":\"if (!db.prepare('PRAGMA table_info(tasks)').all().some(column => column.name === 'priority')) {\",\"newText\":\"if (!db.prepare('PRAGMA table_info(projects)').all().some(column => column.name === 'default_priority')) {\\n  db.exec(\\\"ALTER TABLE projects ADD COLUMN default_priority TEXT NOT NULL DEFAULT 'Normal' CHECK (default_priority IN ('Low', 'Normal', 'High'))\\\");\\n}\\n\\nif (!db.prepare('PRAGMA table_info(tasks)').all().some(column => column.name === 'priority')) {\"},{\"oldText\":\"<form class=\\\"task-create\\\" method=\\\"post\\\" action=\\\"/projects/${project.id}/tasks\\\">\",\"newText\":\"<form method=\\\"post\\\" action=\\\"/projects/${project.id}/default-priority\\\">\\n<input type=\\\"hidden\\\" name=\\\"filter\\\" value=\\\"${filter}\\\">\\n<input type=\\\"hidden\\\" name=\\\"priorityFilter\\\" value=\\\"${priority}\\\">\\n<label for=\\\"default-task-priority\\\">Default task priority</label>\\n<select id=\\\"default-task-priority\\\" name=\\\"priority\\\"${project.archived ? ' disabled' : ''} onchange=\\\"this.form.requestSubmit()\\\">\\n${['Low', 'Normal', 'High'].map(option => `<option${project.default_priority === option ? ' selected' : ''}>${option}</option>`).join('')}\\n</select></form>\\n<form class=\\\"task-create\\\" method=\\\"post\\\" action=\\\"/projects/${project.id}/tasks\\\">\"},{\"oldText\":\"const project = db.prepare('SELECT id, name, archived FROM projects WHERE id = ?').get(renameMatch[1]);\",\"newText\":\"const project = db.prepare('SELECT id, name, archived, default_priority FROM projects WHERE id = ?').get(renameMatch[1]);\"},{\"oldText\":\"    const archiveMatch = /^\\\\/projects\\\\/(\\\\d+)\\\\/(archive|restore)$/.exec(url.pathname);\",\"newText\":\"    const defaultMatch = /^\\\\/projects\\\\/(\\\\d+)\\\\/default-priority$/.exec(url.pathname);\\n    if (req.method === 'POST' && defaultMatch) {\\n      const project = db.prepare('SELECT id, archived FROM projects WHERE id = ?').get(defaultMatch[1]);\\n      if (project) {\\n        if (project.archived) {\\n          sendHtml(res, 403, page('Archived project', '<h1>Archived project</h1><p>Archived projects cannot be changed.</p>'));\\n          return;\\n        }\\n        const body = await formBody(req);\\n        const priority = body.get('priority');\\n        if (!['Low', 'Normal', 'High'].includes(priority)) {\\n          sendHtml(res, 400, page('Invalid priority', '<p role=\\\"alert\\\">Invalid task priority</p>'));\\n          return;\\n        }\\n        db.prepare('UPDATE projects SET default_priority = ? WHERE id = ?').run(priority, project.id);\\n        res.writeHead(303, { Location: projectLocation(project.id, taskFilter(body.get('filter')), priorityFilter(body.get('priorityFilter'))) });\\n        res.end();\\n        return;\\n      }\\n    }\\n    const archiveMatch = /^\\\\/projects\\\\/(\\\\d+)\\\\/(archive|restore)$/.exec(url.pathname);\"},{\"oldText\":\"const project = db.prepare('SELECT id, name, archived FROM projects WHERE id = ?').get(taskMatch[1]);\",\"newText\":\"const project = db.prepare('SELECT id, name, archived, default_priority FROM projects WHERE id = ?').get(taskMatch[1]);\"},{\"oldText\":\"db.prepare('INSERT INTO tasks (project_id, title) VALUES (?, ?)').run(project.id, title);\",\"newText\":\"db.prepare('INSERT INTO tasks (project_id, title, priority) VALUES (?, ?, ?)').run(project.id, title, project.default_priority);\"},{\"oldText\":\"const project = db.prepare('SELECT id, name, archived FROM projects WHERE id = ?').get(match[1]);\",\"newText\":\"const project = db.prepare('SELECT id, name, archived, default_priority FROM projects WHERE id = ?').get(match[1]);\"}]}"}

