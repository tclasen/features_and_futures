athname);\",\"newText\":\"    const defaultMatch = /^\\\\/projects\\\\/(\\\\d+)\\\\/default-priority$/.exec(url.pathname);\\n    if (req.method === 'POST' && defaultMatch) {\\n      const project = db.prepare('SELECT id, archived FROM projects WHERE id = ?').get(defaultMatch[1]);\\n      if (project) {\\n        if (project.archived) {\\n          sendHtml(res, 403, page('Archived project', '<h1>Archived project</h1><p>Archived projects cannot be changed.</p>'));\\n          return;\\n        }\\n        const body = await formBody(req);\\n        const priority = body.get('priority');\\n        if (!['Low', 'Normal', 'High'].includes(priority)) {\\n          sendHtml(res, 400, page('Invalid priority', '<p role=\\\"alert\\\">Invalid task priority</p>'));\\n          return;\\n        }\\n        db.prepare('UPDATE projects SET default_priority = ? WHERE id = ?').run(priority, project.id);\\n        res.writeHead(303, { Location: projectLocation(project.id, taskFilter(body.get('filter')), priorityFilter(body.get('priorityFilter'))) });\\n        res.end();\\n        return;\\n      }\\n    }\\n    const archiveMatch = /^\\\\/projects\\\\/(\\\\d+)\\\\/(archive|restore)$/.exec(url.pathname);\"},{\"oldText\":\"const project = db.prepare('SELECT id, name, archived FROM projects WHERE id = ?').get(taskMatch[1]);\",\"newText\":\"const project = db.prepare('SELECT id, name, archived, default_priority FROM projects WHERE id = ?').get(taskMatch[1]);\"},{\"oldText\":\"db.prepare('INSERT INTO tasks (project_id, title) VALUES (?, ?)').run(project.id, title);\",\"newText\":\"db.prepare('INSERT INTO tasks (project_id, title, priority) VALUES (?, ?, ?)').run(project.id, title, project.default_priority);\"},{\"oldText\":\"const project = db.prepare('SELECT id, name, archived FROM projects WHERE id = ?').get(match[1]);\",\"newText\":\"const project = db.prepare('SELECT id, name, archived, default_priority FROM projects WHERE id = ?').get(match[1]);\"}]}","status":"completed"}}

