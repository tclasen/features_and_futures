 (await request(`/${first.id}`)).json(), summary);\\n  } finally {\\n    if (server) await server.stop();\\n    await rm(directory, { recursive: true, force: true });\\n  }\\n});\",\"newText\":\"    assert.deepEqual(await (await request(path)).json(), [{ ...saved, priority: 'Low' }, next]);\\n    assert.deepEqual(await (await request(`/${first.id}`)).json(), summary);\\n  } finally {\\n    if (server) await server.stop();\\n    await rm(directory, { recursive: true, force: true });\\n  }\\n});\\n\\ntest('project defaults apply only to future tasks and survive rename, archive and restart', async () => {\\n  const directory = await mkdtemp(join(tmpdir(), 'workboard-default-'));\\n  const databasePath = join(directory, 'workboard.sqlite');\\n  let server;\\n  try {\\n    server = await start(databasePath);\\n    const request = (path, method, body) => fetch(`${server.url}/api/projects${path}`, method ? {\\n      method, headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(body),\\n    } : undefined);\\n    const first = await (await request('', 'POST', { name: 'First' })).json();\\n    const other = await (await request('', 'POST', { name: 'Other' })).json();\\n    assert.equal(first.defaultTaskPriority, 'Normal');\\n    assert.equal(other.defaultTaskPriority, 'Normal');\\n    const path = `/${first.id}`;\\n    const createTask = async (title) => (await request(`${path}/tasks`, 'POST', { title })).json();\\n    const original = await createTask('Original');\\n    await request(`${path}/tasks/${original.id}`, 'PATCH', { completed: true });\\n    const patchDefault = (defaultTaskPriority) => request(path, 'PATCH', { defaultTaskPriority });\\n    for (const value of ['', 'high', ' High ', null, 42]) {\\n      assert.equal((await patchDefault(value)).status, 400);\\n    }\\n    const tasks = [{ ...original, completed: true }];\\n    for (const priority of ['Low', 'Normal', 'High']) {\\n      const response = await patchDefault(priority);\\n      assert.equal(response.status, 200);\\n      assert.equal((await response.json()).defaultTaskPriority, priority);\\n      assert.deepEqual(await (await request(`${path}/tasks`)).json(), tasks);\\n      const task = await createTask(priority);\\n      assert.equal(task.priority, priority);\\n      tasks.push(task);\\n    }\\n    assert.deepEqual(await (await request(`/${other.id}`)).json(), other);\\n    await request(path, 'PATCH', { name: 'Renamed' });\\n    const summary = await (await request(path)).json();\\n    assert.equal(summary.defaultTaskPriority, 'High');\\n    assert.equal(summary.completedCount, 1);\\n    assert.equal(summary.totalCount, 4);\\n    await request(path, 'PATCH', { archived: true });\\n    assert.equal((await patchDefault('Low')).status, 409);\\n    await server.stop();\\n    server = await start(databasePath);\\n    assert.deepEqual(await (await request(path)).json(), { ...summary, archived: true });\\n    assert.deepEqual(await (await request(`${path}/tasks`)).json(), tasks);\\n    await request(path, 'PATCH', { archived: false });\\n    assert.deepEqual(await (await request(path)).json(), summary);\\n    const inherited = await createTask('After restore');\\n    assert.equal(inherited.priority, 'High');\\n    await patchDefault('Low');\\n    await server.stop();\\n    server = await start(databasePath);\\n    assert.equal((await (await request(path)).json()).defaultTaskPriority, 'Low');\\n    assert.deepEqual(await (await request(`${path}/tasks`)).json(), [...tasks, inherited]);\\n    assert.equal((await createTask('After restart')).priority, 'Low');\\n  } finally {\\n    if (server) await server.stop();\\n    await rm(directory, { recursive: true, force: true });\\n  }\\n});\"}]}","status":"completed"}],"error":null,"incomplete_details":null,"tools":[{"type":"function","name":"read","description":"Read the contents of a file. Supports text files and images (jpg, png, gif, webp, bmp). Images are sent as attachments. For text files, output is truncated to 2000 lines or 50KB (whichever is hit first). Use offset/limit for large files. When you need the full file, continue with offset until complete.","parameters":{"type":"object","required":["path","offset","limit"],"properties":{"path":{"type":"string","description":"Path to the file to read (relative or absolute)"},"offset":{"anyOf":[{"type":"number","description":"Line number to start reading from (1-indexed)"},{"type":"null"}]},"limit":{"anyOf":[{"type":"number","description":"Maximum number of lines to read"},{"type":"null"}]}},"additionalProperties":false},"output_schema":null,"strict":true},{"type":"function","name":"bash","description":"Execute a bash command in the current working directory. Returns stdout and stderr. Output is truncated to last 2000 lines or 50KB (whichever is hit first). If truncated, full output is saved to a temp file. Optionally provide a timeout in seconds.","parameters":{"type":"object","required":["command","timeout"],"properties":{"command":{"type":"string","description":"Shell command to execute"},"timeout":{"anyOf":[{"type":"number","description":"Timeout in seconds (optional, no default timeout)"},{"type":"null"}]}},"additionalProperties":false},"output_schema":null,"strict":true},{"type":"function","name":"edit","description":"Edit a single file using exact text replacement. Every edits[].oldText must match a unique, non-overlapping region of the original file. If two changes affect the same block or nearby lines, merge them into one edit instead of emitting overlapping edits. Do not include large unchanged regions just to connect distant changes.","parameters":{"type":"object","required":["path","edits"],"properties":{"path":{"type":"string","description":"Path to the file to edit (relative or absolute)"},"edits":{"type":"array","items":{"type":"object","required":["oldText","newText"],"properties":{"oldText":{"type":"string","description":"Exact text for one targeted replacement. It must be unique in the original file and must not overlap with any other edits[].oldText in the same call."},"newText":{"type":"string","description":"Replacement text for this targeted edit."}},"additionalProperties":false},"description":"One or more targeted replacements. Each edit is matched against the original file, not incrementally. Do not include overlapping or nested edits. If two changes touch the same block or nearby lines, merge them into one edit instead."}},"additionalProperties":false},"output_schema":null,"strict":true},{"type":"function","name":"write","description":"Write content to a file. Creates the file if it doesn't exist, overwrites if it does. Automatically creates parent directories.","parameters":{"type":"object","required":["path","content"],"properties":{"path":{"type":"string","description":"Path to the file to write (relative or absolute)"},"content":{"type":"string","description":"Content to write to the file"}},"additionalProperties":false},"output_schema":null,"strict":true}],"tool_choice":"auto","parallel_tool_calls":true,"prompt_cache_key":"81d6a88c-02f4-4f5d-8eb9-5f860eefe796","prompt_cache_retention":"24h","text":{"format":{"type":"text"},"verbosity":"low"},"top_p":0.98,"top_logprobs":0,"temperature":1.0,"reasoning":{"effort":"medium","summary":"detailed","context":"all_turns","mode":"standard"},"user":null,"usage":{"input_tokens":20044,"input_tokens_details":{"cached_tokens":2816,"cache_write_tokens":0},"output_tokens":1049,"output_tokens_details":{"reasoning_tokens":46},"total_tokens":21093,"attribution":{"items":{"fc_058bd2a35b6ec78e016acb4a4499dc87d18b918cbdbc8bcfae":{"input_tokens":46,"cached_tokens":0,"cache_write_tokens":0,"output_tokens":0},"fc_058bd2a35b6ec78e016acb4a47af7087d1ba8c05b498706581":{"input_tokens":42,"cached_tokens":0,"cache_write_tokens":0,"output_tokens":0},"fc_058bd2a35b6ec78e016acb4a4a0dbc87d1b845fa44658699dd":{"input_tokens":23,"cached_tokens":0,"cache_write_tokens":0,"output_tokens":0},"fc_058bd2a35b6ec78e016acb4a4a0dc087d185a59f4c522f63e0"