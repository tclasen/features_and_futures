rd.sqlite');\\n  let server;\\n  try {\\n    server = await start(databasePath);\\n    const request = (path, method, body) => fetch(`${server.url}/api/projects${path}`, method ? {\\n      method, headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(body),\\n    } : undefined);\\n    const source = await (await request('', 'POST', { name: 'Source' })).json();\\n    const destination = await (await request('', 'POST', { name: 'Destination' })).json();\\n    const path = `/${source.id}/tasks`;\\n    const task = await (await request(path, 'POST', { title: 'First' })).json();\\n    const second = await (await request(path, 'POST', { title: 'Second' })).json();\\n    assert.equal(task.deleted, false);\\n    const patch = (changes, projectId = source.id) => request(`/${projectId}/tasks/${task.id}`, 'PATCH', changes);\\n    for (const changes of [{ completed: true }, { priority: 'High' }, { dueDate: '0001-01-01' }, { notes: '  雪\\\\n<literal>  ' }]) {\\n      Object.assign(task, await (await patch(changes)).json());\\n    }\\n    await patch({ destinationProjectId: destination.id });\\n    await patch({ destinationProjectId: source.id }, destination.id);\\n    const deleted = { ...task, deleted: true };\\n    assert.deepEqual(await (await patch({ deleted: true })).json(), deleted);\\n    for (const changes of [{ title: 'Changed' }, { completed: false }, { priority: 'Low' }, { dueDate: '' }, { notes: '' }, { destinationProjectId: destination.id }]) {\\n      assert.equal((await patch(changes)).status, 409);\\n    }\\n    assert.equal((await patch({ deleted: 'false' })).status, 400);\\n    assert.equal((await patch({ deleted: false, title: 'Changed' })).status, 400);\\n    assert.equal((await request(`${path}/${second.id}`, 'PATCH', { deleted: true })).status, 200);\\n    const summary = await (await request(`/${source.id}`)).json();\\n    assert.equal(summary.totalCount, 0);\\n    assert.equal(summary.completedCount, 0);\\n    await request(`/${source.id}`, 'PATCH', { archived: true });\\n    assert.equal((await patch({ deleted: false })).status, 409);\\n    assert.equal((await patch({ deleted: true })).status, 409);\\n    await server.stop();\\n    server = await start(databasePath);\\n    assert.deepEqual(await (await request(path)).json(), [deleted, { ...second, deleted: true }]);\\n    await request(`/${source.id}`, 'PATCH', { archived: false });\\n    await request(`/${source.id}`, 'PATCH', { defaultTaskPriority: 'Low' });\\n    const later = await (await request(path, 'POST', { title: 'Later' })).json();\\n    await request(`${path}/${second.id}`, 'PATCH', { deleted: false });\\n    assert.deepEqual(await (await patch({ deleted: false })).json(), task);\\n    assert.deepEqual(await (await request(path)).json(), [task, second, later]);\\n    const restoredSummary = await (await request(`/${source.id}`)).json();\\n    assert.equal(restoredSummary.totalCount, 3);\\n    assert.equal(restoredSummary.completedCount, 1);\\n    await patch({ destinationProjectId: destination.id });\\n    await patch({ deleted: true }, destination.id);\\n    assert.equal((await patch({ destinationProjectId: source.id }, destination.id)).status, 409);\\n    await server.stop();\\n    server = await start(databasePath);\\n    await patch({ deleted: false }, destination.id);\\n    await patch({ destinationProjectId: source.id }, destination.id);\\n    assert.deepEqual(await (await request(path)).json(), [task, second, later]);\\n  } finally {\\n    if (server) await server.stop();\\n    await rm(directory, { recursive: true, force: true });\\n  }\\n});\\n\\ntest('notes preserve exact text, task data, remembered positions and restart persistence', async () => {\"}]}","status":"completed"}],"error":null,"incomplete_details":null,"tools":[{"type":"function","name":"read","description":"Read the contents of a file. Supports text files and images (jpg, png, gif, webp, bmp). Images are sent as attachments. For text files, output is truncated to 2000 lines or 50KB (whichever is hit first). Use offset/limit for large files. When you need the full file, continue with offset until complete.","parameters":{"type":"object","required":["path","offset","limit"],"properties":{"path":{"type":"string","description":"Path to the file to read (relative or absolute)"},"offset":{"anyOf":[{"type":"number","description":"Line number to start reading from (1-indexed)"},{"type":"null"}]},"limit":{"anyOf":[{"type":"number","description":"Maximum number of lines to read"},{"type":"null"}]}},"additionalProperties":false},"output_schema":null,"strict":true},{"type":"function","name":"bash","description":"Execute a bash command in the current working directory. Returns stdout and stderr. Output is truncated to last 2000 lines or 50KB (whichever is hit first). If truncated, full output is saved to a temp file. Optionally provide a timeout in seconds.","parameters":{"type":"object","required":["command","timeout"],"properties":{"command":{"type":"string","description":"Shell command to execute"},"timeout":{"anyOf":[{"type":"number","description":"Timeout in seconds (optional, no default timeout)"},{"type":"null"}]}},"additionalProperties":false},"output_schema":null,"strict":true},{"type":"function","name":"edit","description":"Edit a single file using exact text replacement. Every edits[].oldText must match a unique, non-overlapping region of the original file. If two changes affect the same block or nearby lines, merge them into one edit instead of emitting overlapping edits. Do not include large unchanged regions just to connect distant changes.","parameters":{"type":"object","required":["path","edits"],"properties":{"path":{"type":"string","description":"Path to the file to edit (relative or absolute)"},"edits":{"type":"array","items":{"type":"object","required":["oldText","newText"],"properties":{"oldText":{"type":"string","description":"Exact text for one targeted replacement. It must be unique in the original file and must n