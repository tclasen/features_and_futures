ntListener('click', async () => {\\n            const task = tasks.find(item => String(item.id) === button.dataset.delete);\\n            const response = await fetch(`/api/projects/${match[1]}/tasks/${task.id}`, { method: 'PATCH', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ deleted: !task.deleted }) });\\n            if (response.ok) { Object.assign(task, await response.json()); paintTasks(); }\\n          }));\\n\\\"\\\"\\\"\\ns=s.replace(needle,handler+needle)\\nopen(p,'w').write(s)\\nPY\\nnode --check server.js; node --version; cat package.json;\",\"timeout\":10000}","status":"completed"}}

