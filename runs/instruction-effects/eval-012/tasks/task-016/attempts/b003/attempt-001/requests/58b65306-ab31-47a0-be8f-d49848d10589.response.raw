e(/\\\\r/g, '&#13;').replace(/\\\\n/g, '&#10;')}</textarea><button type=\\\"submit\\\"${project.archived ? ' disabled' : ''}>Save notes</button></div>\",\"newText\":\"<div class=\\\"create\\\"><textarea id=\\\"task-notes-${task.id}\\\" name=\\\"notes\\\" rows=\\\"4\\\"${project.archived || task.deleted ? ' disabled' : ''}>\\n${escape(task.notes).replace(/\\\\r/g, '&#13;').replace(/\\\\n/g, '&#10;')}</textarea><button type=\\\"submit\\\"${project.archived || task.deleted ? ' disabled' : ''}>Save notes</button></div>\"},{\"oldText\":\"<select id=\\\"destination-project-${task.id}\\\" name=\\\"destination\\\"${moveDisabled ? ' disabled' : ''}>\",\"newText\":\"<select id=\\\"destination-project-${task.id}\\\" name=\\\"destination\\\"${moveDisabled || task.deleted ? ' disabled' : ''}>\"},{\"oldText\":\"<button type=\\\"submit\\\"${moveDisabled ? ' disabled' : ''}>Move task</button>\\n</form></div>\",\"newText\":\"<button type=\\\"submit\\\"${moveDisabled || task.deleted ? ' disabled' : ''}>Move task</button>\\n</form>\\n<form method=\\\"post\\\" action=\\\"/projects/${project.id}/tasks/${task.id}/${task.deleted ? 'restore' : 'delete'}\\\">\\n${rangeFields(range)}\\n<input type=\\\"hidden\\\" name=\\\"filter\\\" value=\\\"${filter}\\\">\\n<input type=\\\"hidden\\\" name=\\\"priorityFilter\\\" value=\\\"${priority}\\\">\\n<button type=\\\"submit\\\"${project.archived ? ' disabled' : ''}>${task.deleted ? 'Restore task' : 'Delete task'}</button>\\n</form></div>\"}]}","item_id":"fc_05fb342dc45f1aac016acb54b168ec81979f146d16d9b987a5","output_index":1,"sequence_number":850}

