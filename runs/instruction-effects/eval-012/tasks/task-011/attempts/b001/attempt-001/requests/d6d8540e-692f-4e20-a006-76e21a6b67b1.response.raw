data: {"type":"response.function_call_arguments.done","sequence_number":791,"item_id":"fc_0fa1d298b5b5615e016acb4d1742a88194bb8354f239aaad0d","output_index":0,"arguments":"{\"path\":\"server.js\",\"edits\":[{\"oldText\":\"const priorities = ['Low', 'Normal', 'High'];\",\"newText\":\"// Separate ordering from identity so moved tasks append without changing their IDs.\\nif (!database.prepare('PRAGMA table_info(tasks)').all().some(column => column.name === 'position')) {\\n  database.exec('ALTER TABLE tasks ADD COLUMN position INTEGER NOT NULL DEFAULT 0; UPDATE tasks SET position = id');\\n}\\nconst priorities = ['Low', 'Normal', 'High'];\"},{\"oldText\":\"const listTasks = database.prepare('SELECT id, title, completed, priority, due_date FROM tasks WHERE project_id = ? ORDER BY id');\\nconst createTask = database.prepare('INSERT INTO tasks (project_id, title, priority) VALUES (?, ?, ?)');\",\"newText\":\"const listTasks = database.prepare('SELECT id, title, completed, priority, due_date FROM tasks WHERE project_id = ? ORDER BY position, id');\\nconst createTask = database.prepare(`\\n  INSERT INTO tasks (project_id, title, priority, position)\\n  VALUES (?, ?, ?, (SELECT COALESCE(MAX(position), 0) + 1 FROM tasks WHERE project_id = ?))\\n`);\\nconst destinations = database.prepare('SELECT id, name FROM projects WHERE archived = 0 AND id != ? ORDER BY id');\\nconst moveTask = database.prepare(`\\n  UPDATE tasks SET project_id = ?,\\n    position = (SELECT COALESCE(MAX(position), 0) + 1 FROM tasks WHERE project_id = ?)\\n  WHERE id = ? AND project_id = ?\\n`);\"},{\"oldText\":\"  const rows = listTasks.all(project.id)\",\"newText\":\"  const eligibleDestinations = destinations.all(project.id);\\n  const moveDisabled = project.archived || eligibleDestinations.length === 0;\\n  const rows = listTasks.all(project.id)\"},{\"oldText\":\"      </li>`).join('');\\n  return page(project.name,\",\"newText\":\"        <form action=\\\"/projects/${project.id}/tasks/${task.id}/move\\\" method=\\\"post\\\">\\n          ${filterInputs}\\n          <label for=\\\"destination-project-${task.id}\\\">Destination project</label>\\n          <select id=\\\"destination-project-${task.id}\\\" name=\\\"destination\\\"${moveDisabled ? ' disabled' : ''}>\\n            ${eligibleDestinations.map(destination => `<option value=\\\"${destination.id}\\\">${escapeHtml(destination.name)}</option>`).join('')}\\n          </select>\\n          <button type=\\\"submit\\\"${moveDisabled ? ' disabled' : ''}>Move task</button>\\n        </form>\\n      </li>`).join('');\\n  return page(project.name,\"},{\"oldText\":\"(?:\\\\/(rename|priority|due-date))?\",\"newText\":\"(?:\\\\/(rename|priority|due-date|move))?\"},{\"oldText\":\"        const result = action === 'due-date'\",\"newText\":\"        const destination = action === 'move' ? getProject.get(form.get('destination') || '') : null;\\n        if (action === 'move' && (!destination || destination.archived || destination.id === project.id)) {\\n          sendHtml(response, 422, projectPage(project, filter, 'Choose an active destination project', selectedPriority, range));\\n          return;\\n        }\\n        const result = action === 'move'\\n          ? moveTask.run(destination.id, destination.id, taskId, project.id)\\n          : action === 'due-date'\"},{\"oldText\":\"        createTask.run(project.id, title, project.default_priority);\",\"newText\":\"        createTask.run(project.id, title, project.default_priority, project.id);\"}]}"}

