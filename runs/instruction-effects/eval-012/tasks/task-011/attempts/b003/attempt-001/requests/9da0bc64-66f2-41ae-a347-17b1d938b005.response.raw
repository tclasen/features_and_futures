data: {"type":"response.function_call_arguments.done","sequence_number":822,"item_id":"fc_08f357202fd6e44d016acb4d25737881909984d0e2a72e1af3","output_index":0,"arguments":"{\"path\":\"server.js\",\"edits\":[{\"oldText\":\"function validDueDate(value) {\",\"newText\":\"if (!db.prepare('PRAGMA table_info(tasks)').all().some(column => column.name === 'position')) {\\n  db.exec('ALTER TABLE tasks ADD COLUMN position INTEGER NOT NULL DEFAULT 0; UPDATE tasks SET position = id');\\n}\\n\\nfunction validDueDate(value) {\"},{\"oldText\":\"function projectPage(res, project, filter = 'All', error = '', priority = 'All', range = { from: '', through: '' }) {\\n  const tasks\",\"newText\":\"function projectPage(res, project, filter = 'All', error = '', priority = 'All', range = { from: '', through: '' }) {\\n  const destinations = db.prepare('SELECT id, name FROM projects WHERE archived = 0 AND id <> ? ORDER BY id').all(project.id);\\n  const moveDisabled = project.archived || !destinations.length;\\n  const tasks\"},{\"oldText\":\"${range.through ? 'AND due_date <= ?' : ''} ORDER BY id`)\",\"newText\":\"${range.through ? 'AND due_date <= ?' : ''} ORDER BY position, id`)\"},{\"oldText\":\"</form></div>`).join('')}\\n${tasks.length\",\"newText\":\"</form>\\n<form method=\\\"post\\\" action=\\\"/projects/${project.id}/tasks/${task.id}/move\\\">\\n${rangeFields(range)}\\n<input type=\\\"hidden\\\" name=\\\"filter\\\" value=\\\"${filter}\\\">\\n<input type=\\\"hidden\\\" name=\\\"priorityFilter\\\" value=\\\"${priority}\\\">\\n<label for=\\\"destination-project-${task.id}\\\">Destination project</label>\\n<select id=\\\"destination-project-${task.id}\\\" name=\\\"destination\\\"${moveDisabled ? ' disabled' : ''}>\\n${destinations.map(destination => `<option value=\\\"${destination.id}\\\">${escape(destination.name)}</option>`).join('')}\\n</select>\\n<button type=\\\"submit\\\"${moveDisabled ? ' disabled' : ''}>Move task</button>\\n</form></div>`).join('')}\\n${tasks.length\"},{\"oldText\":\"(?:rename|priority|due-date)\",\"newText\":\"(?:rename|priority|due-date|move)\"},{\"oldText\":\"if (taskMatch[3] === '/due-date') {\",\"newText\":\"if (taskMatch[3] === '/move') {\\n          const destination = db.prepare('SELECT id FROM projects WHERE id = ? AND archived = 0 AND id <> ?')\\n            .get(body.get('destination') || '', project.id);\\n          if (!destination) {\\n            projectPage(res, project, filter, 'Choose an active destination project', selectedPriority, dueRange(body));\\n            return;\\n          }\\n          const result = db.prepare(`UPDATE tasks SET project_id = ?,\\n            position = (SELECT COALESCE(MAX(position), 0) + 1 FROM tasks WHERE project_id = ?)\\n            WHERE id = ? AND project_id = ?`).run(destination.id, destination.id, taskMatch[2], project.id);\\n          if (!result.changes) {\\n            sendHtml(res, 404, page('Not found', '<h1>Not found</h1>'));\\n            return;\\n          }\\n        } else if (taskMatch[3] === '/due-date') {\"},{\"oldText\":\"db.prepare('INSERT INTO tasks (project_id, title, priority) VALUES (?, ?, ?)').run(project.id, title, project.default_priority);\",\"newText\":\"db.prepare(`INSERT INTO tasks (project_id, title, priority, position)\\n            VALUES (?, ?, ?, (SELECT COALESCE(MAX(position), 0) + 1 FROM tasks WHERE project_id = ?))`)\\n            .run(project.id, title, project.default_priority, project.id);\"}]}"}

