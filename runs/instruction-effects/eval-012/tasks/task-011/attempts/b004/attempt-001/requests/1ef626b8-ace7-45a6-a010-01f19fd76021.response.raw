utton></div>`).join('');\"},{\"oldText\":\"          document.querySelectorAll('[data-due-task]').forEach(form => form.addEventListener('submit', async event => {\",\"newText\":\"          document.querySelectorAll('[data-move-task]').forEach(button => button.addEventListener('click', async () => {\\n            const select = document.querySelector(`[data-destination-task=\\\"${CSS.escape(button.dataset.moveTask)}\\\"]`);\\n            await fetch(`/api/projects/${encodeURIComponent(id)}/tasks/${encodeURIComponent(button.dataset.moveTask)}`, { method: 'PATCH', headers: {'Content-Type':'application/json'}, body: JSON.stringify({ destinationProjectId: select.value }) });\\n            await loadTasks();\\n          }));\\n          document.querySelectorAll('[data-due-task]').forEach(form => form.addEventListener('submit', async event => {\"}]}","status":"completed"}}

