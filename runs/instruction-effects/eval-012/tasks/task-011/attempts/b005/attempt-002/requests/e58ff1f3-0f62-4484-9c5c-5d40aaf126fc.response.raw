inations' },\\n      { id: 3, name: 'Archived destination', archived: true },\\n      { id: 4, name: 'Last destination', archived: scenario === 'no destinations' },\\n    ];\\n    const tasks = [1, 2].map((id) => ({\\n      id, title: `Task ${id}`, completed: true, priority: 'High', dueDate: '2000-02-29',\\n    }));\\n    const moves = [];\\n    runInNewContext(source, {\\n      document: { querySelector: () => app, createElement: (tag) => new Node(tag) },\\n      location: { pathname: '/projects/1', assign() { assert.fail('Moving must not navigate'); } },\\n      async fetch(path, options) {\\n        let data;\\n        if (!options) data = path === '/api/projects' ? projects\\n          : path === '/api/projects/1' ? projects[0] : tasks.map((task) => ({ ...task }));\\n        else {\\n          const changes = JSON.parse(options.body);\\n          moves.push({ path, ...changes });\\n          data = { ...tasks[0] };\\n        }\\n        return { ok: true, json: async () => data };\\n      },\\n    });\\n    await new Promise((resolve) => setImmediate(resolve));\\n    const filters = app.children.find((node) => node.className === 'task-filter');\\n    filters.children[1].value = 'Completed';\\n    await filters.children[1].fire('change');\\n    filters.children[3].value = 'High';\\n    await filters.children[3].fire('change');\\n    const range = app.children.find((node) => node.children[0]?.textContent === 'Due from');\\n    range.children[1].value = range.children[3].value = '2000-02-29';\\n    await range.fire('submit');\\n    const list = app.querySelector('ul');\\n    const moveForm = list.children[0].children[6];\\n    const [label, select, button] = moveForm.children;\\n    assert.equal(label.textContent, 'Destination project');\\n    assert.equal(label.htmlFor, select.id);\\n    assert.equal(button.textContent, 'Move task');\\n    assert.deepEqual(select.children.map((option) => option.textContent), scenario === 'no destinations'\\n      ? [] : ['Renamed destination', 'Last destination']);\\n    assert.deepEqual(select.children.map((option) => option.value), scenario === 'no destinations' ? [] : ['2', '4']);\\n    assert.equal(select.disabled, scenario !== 'active');\\n    assert.equal(button.disabled, scenario !== 'active');\\n    select.value = '4';\\n    await moveForm.fire('submit');\\n    if (scenario === 'active') {\\n      assert.deepEqual(moves, [{ path: '/api/projects/1/tasks/1', destinationProjectId: 4 }]);\\n      assert.deepEqual(list.children.map((row) => row.children[1].textContent), ['Task 2']);\\n    } else {\\n      assert.equal(moves.length, 0);\\n      assert.equal(list.children.length, 2);\\n    }\\n    assert.equal(filters.children[1].value, 'Completed');\\n    assert.equal(filters.children[3].value, 'High');\\n    assert.equal(range.children[1].value, '2000-02-29');\\n    assert.equal(range.children[3].value, '2000-02-29');\\n    filters.children[3].value = 'All';\\n    await filters.children[3].fire('change');\\n    assert.equal(list.children.length, scenario === 'active' ? 1 : 2);\\n  });\\n}\\n\\nfor (const archived of [false, true]) {\\n  test(`inclusive due ranges intersect filters\"}]}","status":"completed"}],"error":null,"incomplete_details":null,"tools":[{"type":"function","name":"read","description":"Read the contents of a file. Supports text files and images (jpg, png, gif, webp, bmp). Images are sent as attachments. For text files, output is truncated to 2000 lines or 50KB (whichever is hit first). Use offset/limit for large files. When you need the full file, continue with offset until complete.","parameters":{"type":"object","required":["path","offset","limit"],"properties":{"path":{"type":"string","description":"Path to the file to read (relative or absolute)"},"offset":{"anyOf":[{"type":"number","description":"Line number to start reading from (1-indexed)"},{"type":"null"}]},"limit":{"anyOf":[{"type":"number","description":"Maximum number of lines to read"},{"type":"null"}]}},"additionalProperties":false},"output_schema":null,"strict":true},{"type":"function","name":"bash","description":"Execute a bash command in the current working directory. Returns stdout and stderr. Output is truncated to last 2000 lines or 50KB (whichever is hit first). If truncated, full output is saved to a temp file. Optionally provide a timeout in seconds.","parameters":{"type":"object","required":["command","timeout"],"properties":{"command":{"type":"string","description":"Shell command to execute"},"timeout":{"anyOf":[{"type":"number","description":"Timeout in seconds (optional, no default timeout)"},{"type":"null"}]}},"additionalProperties":false},"output_schema":null,"strict":true},{"type":"function","name":"edit","description":"Edit a single file using exact text replacement. Every edits[].oldText must match a unique, non-overlapping region of the original file. If two changes affect the same block or nearby lines, merge them into one edit instead of emitting overlapping edits. Do not include large unchanged regions just to connect distant changes.","parameters":{"type":"object","required":["path","edits"],"properties":{"path":{"type":"string","description":"Path to the file to edit (relative or absolute)"},"edits":{"type":"array","items":{"type":"object","required":["oldText","newText"],"properties":{"oldText":{"type":"string","description":"Exact text for one targeted replacement. It must be unique in the original file and must not overlap with any other edits[].oldText in the same call."},"newText":{"type":"string","description":"Replacement text for this targeted edit."}},"additionalProperties":false},"description":"One or more targeted replacements. Each edit is matched against the original file, not incrementally. Do not include overlapping or nested edits. If two changes touch the same block or nearby lines, merge them into one edit instead."}},"additionalProperties":false},"output_schema":null,"strict":true},{"type":"function","name":"write","descripti