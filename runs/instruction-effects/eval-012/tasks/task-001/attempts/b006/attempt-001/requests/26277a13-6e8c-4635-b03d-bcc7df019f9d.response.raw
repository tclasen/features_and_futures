data: {"type":"response.completed","sequence_number":2933,"safety_buffering":false,"response":{"id":"resp_096e002456be8650016acb40ee65e88195b5bd3eb4bc0dce3f","object":"response","created_at":1791705326,"completed_at":1791705381,"status":"completed","background":false,"frequency_penalty":0.0,"presence_penalty":0.0,"moderation":null,"model":"gpt-6.1-sol","access_programs":{"cyber":"standard"},"previous_response_id":null,"instructions":null,"output":[{"type":"reasoning","id":"rs_096e002456be8650016acb40f256688195804beab38931e507","metadata":{"turn_id":"01a129f5-8629-7363-99d6-691836eddfc3"},"internal_chat_message_metadata_passthrough":{"turn_id":"01a129f5-8629-7363-99d6-691836eddfc3"},"summary":[],"content":[],"encrypted_content":"gAAAAABqy0DyiFhgm5n7yZbXr_oYuROjS-nPhJZRPpTqzN8VBofXTerTYCHxsisJsbXr5CJohYmANlQNaEzRTy6c-tVYZW-5UXYstgQUDAtPG3NUnY2F1WI8aoc58KWlEk1oXqYmmwQ3LU6Ng-yhXPOYO56ikZgzISNzCfTY1aM-hMPnGM0FXgqe07N8OVKygH64VZHmBba6N3-cWepeUZ76ej1VzoHE-0EwIC9LgaYJm5GRL861sGPSKF_gCex4cAopRurST-G2pmzEae2qFEowINg_ffOyrTkroyIQyVqWX-LQe7GIzSkfJTSIC7zj2_Yo9dm7gPlxSusnDZloZplpTtyyW384JQtXlkplTkEIW9NoinMMsF--Jv4iYP6945XFkpEEqVAKdmIJJWlnn_VMU1OEupc-Uvj9QomlIJs78Pe6ZZQjLAuyz6iVWRRzchyPFuV1TV4Q54R_svSw2huUdY39oJh_KukLQIA3fAg697HZcUekXg3ideTTO0_Rw0BIBT6ilVexGUfzKz_nfFbluC8LYao-_4aD5-iMDVRxR3fswM7YcgEjyA37Ig5hYvAWyK30fOM22M8TAgId4VFj0v4PgcyYwL_k0kGcmSjbGigmvYr78wwfFC_djmDrIfIddeS3VMfJ5s9LyMgPnwtvnJ-3xdHJk31wg1hoEUE_3ZzW2UbU4pDAeRGoYp1DHL6XAM5YRY613JV-WZEg5P0QVGEEVkrH_tvBtzBtwiO3ihG7j2Fr7ykXCefWSf9WuGvYtcqD_MwVRdUcQXCgvGNh6YUoJy5N3JSCsDHQ43Qwnj2dx7mXxK6OsZjqx1h_b4iy-Te84psK1VqP7U-ksTaqtKCBIOeHdfXy5wivbBWOcGXwruGLh5Ofw9Km449w8ofFPu36ydmyBvuRjFaAkZ24os_gp_OqYi73Z6wnzVZv2EFGZcWeZ5JR4OJ91D_nzExpCpWLiOhW4ogLORoeCRiRSlJuCpOcl3DEGRCpXqPDToCX3IRkOLdoKAeC1i_ufDvanENvc4cDzTAe73S68r3APucZaHi5zNO8kw-3UD6mTY6REMYv6O7I6al6LTnHkU-UBA9_LjGRu34bQnG_rGsS36IDwgr6IlbLlKRdnmAI33T8OdOZ4AyfIdsCsjAAKq_jV_JNbXjOq7N1BCQyN9hi8hMht6ogIlyRIvd-4DkQhCPi3YoVpNuWDQcSZrEntIzxi5miUy0jEtEFOHgiKmUQu-iGNc8cm5_lRj-v3HzRuj