\\n          : `<h1>Project not found</h1><button type=\\\"button\\\" id=\\\"back\\\">Projects</button>`;\\n        app.querySelector('#back').addEventListener('click', () => navigate('/'));\\n        return;\\n      }\\n      const response = await fetch('/api/projects');\\n      const projects = await response.json();\\n      app.innerHTML = `<h1>Workboard</h1>\\n        <form id=\\\"create-form\\\"><label for=\\\"project-name\\\">Project name</label><input id=\\\"project-name\\\" name=\\\"name\\\" type=\\\"text\\\"><button type=\\\"submit\\\">Create project</button></form>\\n        <div id=\\\"message\\\" role=\\\"alert\\\" aria-live=\\\"polite\\\"></div>\\n        <section aria-label=\\\"Projects\\\">${projects.map(project => `<div class=\\\"project-row\\\" data-testid=\\\"project-row\\\"><span>${escapeHtml(project.name)}</span><button type=\\\"button\\\" data-open=\\\"${project.id}\\\">Open project</button></div>`).join('')}</section>`;\\n      app.querySelector('#create-form').addEventListener('submit', async (event) => {\\n        event.preventDefault();\\n        const input = app.querySelector('#project-name');\\n        const name = input.value.trim();\\n        if (!name) {\\n          app.querySelector('#message').textContent = 'Project name is required';\\n          input.focus();\\n          return;\\n        }\\n        const result = await fetch('/api/projects', { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ name }) });\\n        if (result.ok) render();\\n      });\\n      app.querySelectorAll('[data-open]').forEach(button => button.addEventListener('click', () => navigate(`/projects/${button.dataset.open}`)));\\n    }\\n    function navigate(path) { history.pushState({}, '', path); render(); }\\n    addEventListener('popstate', render);\\n    render();\\n  </script>\\n</body>\\n</html>\\n\"}","call_id":"call_pcK8FFhOYzG4hzjf6rNSbLlM","name":"write"},"output_index":0,"sequence_number":1017}

