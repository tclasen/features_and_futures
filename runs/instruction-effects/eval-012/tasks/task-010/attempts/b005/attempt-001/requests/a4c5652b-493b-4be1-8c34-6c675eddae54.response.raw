controls\",\"newText\":\"for (const archived of [false, true]) {\\n  test(`inclusive due ranges intersect filters (${archived ? 'archived' : 'active'})`, async () => {\\n    const app = new Node('main');\\n    const tasks = [\\n      { id: 1, title: 'Undated', completed: false, priority: 'High', dueDate: '' },\\n      { id: 2, title: 'Early', completed: false, priority: 'High', dueDate: '0001-01-01' },\\n      { id: 3, title: 'Leap', completed: false, priority: 'High', dueDate: '2000-02-29' },\\n      { id: 4, title: 'Done', completed: true, priority: 'High', dueDate: '2000-02-29' },\\n      { id: 5, title: 'Normal', completed: false, priority: 'Normal', dueDate: '2000-02-29' },\\n      { id: 6, title: 'Late', completed: false, priority: 'High', dueDate: '9999-12-31' },\\n    ];\\n    const original = structuredClone(tasks);\\n    const project = { id: 1, name: 'Ranges', archived, defaultTaskPriority: 'High' };\\n    let writes = 0;\\n    runInNewContext(source, {\\n      document: { querySelector: () => app, createElement: (tag) => new Node(tag) },\\n      location: { pathname: '/projects/1', assign() {} },\\n      async fetch(path, options) {\\n        let data;\\n        if (!options) data = path === '/api/projects/1' ? { ...project } : tasks.map((task) => ({ ...task }));\\n        else {\\n          writes++;\\n          const changes = JSON.parse(options.body);\\n          if (path === '/api/projects/1') {\\n            Object.assign(project, changes);\\n            data = { ...project };\\n          } else if (options.method === 'POST') {\\n            data = { id: 7, ...changes, priority: project.defaultTaskPriority, completed: false, dueDate: '' };\\n            tasks.push({ ...data });\\n          } else {\\n            const task = tasks.find((task) => path.endsWith(`/${task.id}`));\\n            Object.assign(task, changes);\\n            data = { ...task };\\n          }\\n        }\\n        return { ok: true, json: async () => data };\\n      },\\n    });\\n    await new Promise((resolve) => setImmediate(resolve));\\n    const filters = app.children.find((node) => node.className === 'task-filter');\\n    const completion = filters.children[1];\\n    const priority = filters.children[3];\\n    const range = app.children.find((node) => node.children[0]?.textContent === 'Due from');\\n    const from = range.children[1];\\n    const through = range.children[3];\\n    const titles = () => app.querySelector('ul').children.map((row) => row.children[1].textContent);\\n    const apply = async (start, end) => {\\n      from.value = start;\\n      through.value = end;\\n      await range.fire('submit');\\n    };\\n    assert.equal(from.value, '');\\n    assert.equal(through.value, '');\\n    assert.equal(from.type, 'text');\\n    assert.equal(through.type, 'text');\\n    assert.equal(range.children[0].htmlFor, from.id);\\n    assert.equal(range.children[2].textContent, 'Due through');\\n    assert.equal(range.children[2].htmlFor, through.id);\\n    assert.equal(range.children[4].textContent, 'Apply due range');\\n    assert.ok(!from.disabled && !through.disabled && !range.children[4].disabled);\\n    assert.deepEqual(titles(), tasks.map((task) => task.title));\\n    await apply('', '0001-01-01');\\n    assert.deepEqual(titles(), ['Early']);\\n    await apply('9999-12-31', '');\\n    assert.deepEqual(titles(), ['Late']);\\n    await apply(' 2000-02-29 ', ' 2000-02-29 ');\\n    assert.equal(from.value, '2000-02-29');\\n    assert.equal(through.value, '2000-02-29');\\n    assert.deepEqual(titles(), ['Leap', 'Done', 'Normal']);\\n    completion.value = 'Open';\\n    await completion.fire('change');\\n    priority.value = 'High';\\n    await priority.fire('change');\\n    assert.deepEqual(titles(), ['Leap']);\\n    for (const invalid of ['1900-02-29', '0000-01-01', '2000-2-29', '2000-04-31', 'bad']) {\\n      await apply(invalid, '');\\n      assert.equal(app.querySelector('[role=\\\"alert\\\"]').textContent, 'Due range must use valid YYYY-MM-DD dates');\\n      assert.deepEqual(titles(), ['Leap']);\\n    }\\n    await apply('', '2001-02-29');\\n    assert.equal(app.querySelector('[role=\\\"alert\\\"]').textContent, 'Due range must use valid YYYY-MM-DD dates');\\n    await apply('2000-03-01', '2000-02-29');\\n    assert.equal(app.querySelector('[role=\\\"alert\\\"]').textContent, 'Due from must not be after Due through');\\n    assert.deepEqual(titles(), ['Leap']);\\n    // Draft (including invalid) boundaries do not replace the applied range.\\n    priority.value = 'All';\\n    await priority.fire('change');\\n    assert.deepEqual(titles(), ['Leap', 'Normal']);\\n    assert.equal(completion.value, 'Open');\\n    assert.equal(writes, 0);\\n    assert.deepEqual(tasks, original);\\n    if (!archived) {\\n      priority.value = 'High';\\n      await priority.fire('change');\\n      const row = () => app.querySelector('ul').children[0];\\n      const rename = row().children[2];\\n      rename.children[1].value = 'Renamed';\\n      await rename.fire('submit');\\n      assert.deepEqual(titles(), ['Renamed']);\\n      const renameProject = app.children.find((node) => node.children[0]?.textContent === 'New project name');\\n      renameProject.children[1].value = 'New name';\\n      await renameProject.fire('submit');\\n      const defaults = app.children.find((node) => node.children[0]?.textContent === 'Default task priority');\\n      defaults.children[1].value = 'Low';\\n      await defaults.children[1].fire('change');\\n      const create = app.children.find((node) => node.children[0]?.textContent === 'Task title');\\n      create.children[1].value = 'New undated';\\n      await create.fire('submit');\\n      assert.deepEqual(titles(), ['Renamed']);\\n      const date = row().children[5];\\n      date.children[1].value = '2000-03-01';\\n      await date.fire('submit');\\n      assert.deepEqual(titles(), []);\\n      await apply('2000-03-01', '2000-03-01');\\n      assert.deepEqual(titles(), ['Renamed']);\\n      const taskPriority = row().children[4];\\n      taskPriority.value = 'Low';\\n      await taskPriority.fire('change');\\n      assert.deepEqual(titles(), []);\\n      priority.value = 'Low';\\n      await priority.fire('change');\\n      assert.deepEqual(titles(), ['Renamed']);\\n      const checkbox = row().children[0];\\n      checkbox.checked = true;\\n      await checkbox.fire('change');\\n      assert.deepEqual(titles(), []);\\n      completion.value = 'Completed';\\n      await completion.fire('change');\\n      assert.deepEqual(titles(), ['Renamed']);\\n      assert.equal(priority.value, 'Low');\\n      assert.equal(from.value, '2000-03-01');\\n      assert.equal(through.value, '2000-03-01');\\n    }\\n    await apply('  ', '\\\\t');\\n    completion.value = 'All';\\n    await completion.fire('change');\\n    priority.value = 'All';\\n    await priority.fire('change');\\n    assert.deepEqual(titles(), tasks.map((task) => task.title));\\n  });\\n}\\n\\nfor (const archived of [false, true]) {\\n  test(`due date controls\"}]}","status":"completed"}],"error":null,"incomplete_details":null,"tools":[{"type":"function","name":"read","description":"Read the contents of a file. Supports text files and images (jpg, png, gif, webp, bmp). Images are sent as attachments. For text files, output is truncated to 2000 lines or 50KB (whichever is hit first). Use offset/limit for large files. When you need the full file, continue with offset until complete.","parameters":{"type":"object","required":["path","offset","limit"],"properties":{"path":{"type":"string","description":"Path to the file to read (relative or absolute)"},"offset":{"anyOf":[{"type":"number","description":"Line number to start reading from (1-indexed)"},{"type":"null"}]},"limit":{"anyOf":[{"type":"number","description":"Maximum number of lines to read"},{"type":"null"}]}},"additionalProperties":false},"output_schema":null,"strict":true},{"type":"function","name":"bash","description":"Execute a bash command in the current working directory. Returns stdout and stderr. Output is truncated to last 2000 lines or 50KB (whichever is hit first). If truncated, full output is saved to a temp file. Optionally provide a timeout in seconds.","parameters":{"type":"object","required":["command","timeout"],"properties":{"command":{"type":"string","description":"Shell command to execute"},"timeout":{"anyOf":[{"type":"number","description":"Timeout in seconds (optional, no default timeout)"},{"type":"null"}]}},"additionalProperties":false},"output_schema":null,"strict":true},{"type":"function","name":"edit","description":"Edit a single file using exact text replacement. Every edits[].oldText must match a unique, non-overlapping region of the original file. If two changes affect the same block or nearby lines, merge them into one edit instead of emitting overlapping edits. Do not include large unchanged regions just to connect distant changes.","parameters":{"type":"object","required":["path","edits"],"properties":{"path":{"type":"string","description":"Path to the file to edit (relative or absolute)"},"edits":{"type":"array","items":{"type":"object","required":["oldText","newText"],"properties":{"oldText":{"type":"string","description":"Exact text for one targeted replacement. It must be unique in the original file and must not overlap with any other edits[].oldText in the same call."},"newText":{"type":"string","description":"Replacement text for this targeted edit."}},"additionalProperties":false},"description":"One or more targeted replacements. Each edit is matched against the original file, not incrementally. Do not include overlapping or nested edits. If two changes touch the same block or nearby lines, merge them into one edit instead."}},"additionalProperties":false},"output_schema":null,"strict":true},{"type":"function","name":"write","description":"Write content to a file. Creates the file if it doesn't exist, overwrites if it does. Automatically creates parent directories.","parameters":{"type":"object","required":["path","content"],"properties":{"path":{"type":"string","description":"Path to the file to write (relative or absolute)"},"content":{"type":"string","description":"Content to write to the file"}},"additionalProperties":false},"output_schema":null,"strict":true}],"tool_choice":"auto","parallel_tool_calls":true,"prompt_cache_key":"27a90b0a-011d-4c12-b99b-ab5f530b56f4","prompt_cache_retention":"24h","text":{"format":{"type":"text"},"verbosity":"low"},"top_p":0.98,"top_logprobs":0,"temperature":1.0,"reasoning":{"effort":"medium","summary":"detailed","context":"all_turns","mode":"standard"},"user":null,"usage":{"input_tokens":16014,"input_tokens_details":{"cached_tokens":14464,"cache_write_tokens":0},"output_tokens":2076,"output_tokens_details":{"reasoning_tokens":50},"total_tokens":18090,"attribution":{"items":{"fc_0f24718771fe6fac016acb4bf4a72481968e34d7739753bfd8":{"input_tokens":38,"cached_tokens":38,"cache_write_tokens":0,"output_tokens":0},"fc_0f24718771fe6fac016acb4bfa221081968877b34b71d16893":{"input_tokens":43,"cached_tokens":43,"cache_write_tokens":0,"output_tokens":0},"fc_0f24718771fe6fac016acb4bfa22248196b2fafe0aadd81181":{"input_tokens":22,"cached_tokens":22,"cache_write_tokens":0,"output_tokens":0},"fc_0f24718771fe6fac016acb4bfa222c819682fa314c0c9a99f7":{"input_tokens":24,"cached_tokens":24,"cache_write_tokens":0,"output_tokens":0},"fc_0f24718771fe6fac016acb4bfa223481968c3ffc80f4789fb2":{"input_tokens":23,"cached_tokens":23,"cache_write_tokens":0,"output_tokens":0},"fc_0f24718771fe6fac016acb4bfa223c81968e03a1a9ac3e8df2":{"input_tokens":24,"cached_tokens":24,"cache_write_tokens":0,"output_tokens":0},"fc_0f24718771fe6fac016acb4bfe05d08196923f4ccf3edfb51b":{"input_tokens":37,"cached_tokens":37,"cache_write_tokens":0,"output_tokens":0},"fc_0f24718771fe6fac016acb4c00f844819686081d898a6b8214":{"input_tokens":30,"cached_tokens":30,"cache_write_tokens":0,"output_tokens":0},"fc_0f24718771fe6fac016acb4c070ef