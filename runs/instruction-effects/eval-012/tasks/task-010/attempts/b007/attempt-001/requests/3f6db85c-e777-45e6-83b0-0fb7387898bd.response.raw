hrough }), expected);\\n        }\\n      }\\n    }\\n    assert.deepEqual(projects.listTasks(1), original);\\n    assert.deepEqual(projects.list(), summary);\\n  } finally {\\n    projects.close();\\n  }\\n});\\nEOF\\npython3 - <<'PY'\\nfrom pathlib import Path\\np=Path('test/task-dates.test.js')\\ns=p.read_text().replace(\\\"import { normalizeDueDate }\\\", \\\"import { normalizeDueDate, normalizeDueRange, INVALID_DUE_RANGE_MESSAGE, REVERSED_DUE_RANGE_MESSAGE }\\\")\\ns+='''\\ntest('due range normalization shares calendar rules and distinguishes reversed boundaries', () => {\\n  assert.deepEqual(normalizeDueRange(' 2024-02-29 ', ' 2024-03-01 '), {\\n    dueFrom: '2024-02-29', dueThrough: '2024-03-01',\\n  });\\n  assert.deepEqual(normalizeDueRange(' \\\\\\\\t ', ''), { dueFrom: '', dueThrough: '' });\\n  for (const invalid of ['1900-02-29', '0000-01-01', '10000-01-01', '2024-2-29', '2024-04-31']) {\\n    assert.deepEqual(normalizeDueRange(invalid, ''), { error: INVALID_DUE_RANGE_MESSAGE });\\n    assert.deepEqual(normalizeDueRange('', invalid), { error: INVALID_DUE_RANGE_MESSAGE });\\n  }\\n  assert.deepEqual(normalizeDueRange('2024-03-01', '2024-02-29'), { error: REVERSED_DUE_RANGE_MESSAGE });\\n});\\n'''\\np.write_text(s)\\np=Path('views.js'); s=p.read_text().replace('method=\\\"post\\\" data-auto-submit>\\\\n      ${filterFields}\\\\n            ', 'method=\\\"post\\\" data-auto-submit>\\\\n            ${filterFields}\\\\n            ').replace('class=\\\"task-rename\\\">\\\\n      ${filterFields}', 'class=\\\"task-rename\\\">\\\\n            ${filterFields}').replace('class=\\\"task-due-date\\\">\\\\n      ${filterFields}', 'class=\\\"task-due-date\\\">\\\\n            ${filterFields}'); p.write_text(s)\\nPY\\ncat >> test/server.test.js <<'EOF'\\n\\ntest('applied due ranges survive all edits and validation, reset on reopening and work when archived', async () => {\\n  const directory = await mkdtemp(join(tmpdir(), 'workboard-range-'));\\n  const databasePath =