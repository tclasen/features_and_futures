data: {"type":"response.function_call_arguments.done","sequence_number":332,"item_id":"fc_07239f830d7d4c21016acb58dc68e48197bb1d3a7fe47229a3","output_index":1,"arguments":"{\"path\":\"README.md\",\"edits\":[{\"oldText\":\"## Checks\",\"newText\":\"On the home page, paste a version-1 portable document into Project JSON, supply an Imported project name, and select Import project. The trimmed override names a new independent project and opens it; the imported archive state, default priority, task order, exact titles, completion, priorities, dates, LF-normalized notes, and deletion flags are retained. Required fields and calendar dates are validated before a single atomic transaction creates any data. Invalid documents show Invalid project JSON; blank overrides show Project name is required. Rejections retain both entered fields and leave existing data unchanged. Extra properties cannot supply application identities. Imported tasks receive their own reserved positions for later moves and returns.\\n\\n## Checks\"},{\"oldText\":\"Export checks cover older-record defaults\",\"newText\":\"Import checks cover required fields, malformed JSON, unsupported format/version, incorrect types, invalid Gregorian dates, invalid later tasks without partial writes, blank overrides, independent identities, portable field preservation, live summaries, restoration order, moves/returns, archived and empty imports, and restart persistence.\\n\\nExport checks cover older-record defaults\"}]}"}

