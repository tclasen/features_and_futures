le.project, tasks: [...portable.project.tasks, { ...portable.project.tasks[0], dueDate: '1900-02-29' }] },\\n    })]) {\\n      assert.deepEqual(await importDocument('Rejected', text), { status: 400, data: { error: 'Invalid project JSON' } });\\n      assert.deepEqual((await request('')).data, before);\\n      assert.equal((await request(`/${original.id}/tasks`)).data.length, 1);\\n    }\\n    assert.deepEqual(await importDocument(' \\\\t ', '{'), { status: 400, data: { error: 'Project name is required' } });\\n    portable.project.id = original.id;\\n    portable.project.tasks[0].id = savedTask.id;\\n    const importedResponse = await importDocument('  Independent copy  ', JSON.stringify(portable));\\n    assert.equal(importedResponse.status, 201);\\n    const imported = importedResponse.data;\\n    assert.notEqual(imported.id, original.id);\\n    assert.equal(imported.name, 'Independent copy');\\n    assert.equal(imported.totalCount, 1);\\n    assert.equal(imported.completedCount, 1);\\n    const path = `/${imported.id}`;\\n    const tasks = (await request(`${path}/tasks`)).data;\\n    assert.notEqual(tasks[0].id, savedTask.id);\\n    const expected = { ...portable, project: { name: imported.name, archived: false, defaultPriority: 'Low', tasks: portable.project.tasks.map(({ id, ...task }) => task) } };\\n    assert.deepEqual((await request(`${path}/export`)).data, expected);\\n    const later = (await request(`${path}/tasks`, 'POST', { title: 'Later' })).data;\\n    assert.equal(later.priority, 'Low');\\n    assert.equal((await request(`${path}/tasks/${tasks[1].id}`, 'PATCH', { title: 'Forbidden' })).status, 409);\\n    await request(`${path}/tasks/${tasks[1].id}`, 'PATCH', { deleted: false });\\n    await request(`${path}/tasks/${tasks[0].id}`, 'PATCH', { destinationProjectId: original.id });\\n    await request(`/${original.id}/tasks/${tasks[0].id}`, 'PATCH', { destinationProjectId: imported.id });\\n    assert.deepEqual((await request(`${path}/tasks`)).data.map((task) => task.id), [tasks[0].id, tasks[1].id, later.id]);\\n    await request(`${path}/tasks/${tasks[0].id}`, 'PATCH', { notes: 'Independent edit' });\\n    assert.equal((await request(`/${original.id}/tasks`)).data[0].notes, '  α <b>\\\\r\\\\nsecond  ');\\n\\n    portable.project.archived = true;\\n    const archived = (await importDocument('Archived copy', JSON.stringify(portable))).data;\\n    const archivedTasks = (await request(`/${archived.id}/tasks`)).data;\\n    assert.equal((await request(`/${archived.id}/tasks/${archivedTasks[1].id}`, 'PATCH', { deleted: false })).status, 409);\\n    await request(`/${archived.id}`, 'PATCH', { archived: false });\\n    await request(`/${archived.id}/tasks/${archivedTasks[1].id}`, 'PATCH', { deleted: false });\\n    assert.equal((await request(`/${archived.id}`)).data.totalCount, 2);\\n    const empty = (await importDocument('Empty copy', JSON.stringify({ ...portable, project: { ...portable.project, tasks: [] } }))).data;\\n    assert.equal(empty.totalCount, 0);\\n    const snapshot = (await request('')).data;\\n    const saved = (await request(`${path}/tasks`)).data;\\n    await server.stop();\\n    server = await start(databasePath);\\n    assert.deepEqual((await request('')).data, snapshot);\\n    assert.deepEqual((await request(`${path}/tasks`)).data, saved);\\n    assert.deepEqual((await request(`/${empty.id}/tasks`)).data, []);\\n  } finally {\\n    if (server) await server.stop();\\n    await rm(directory, { recursive: true, force: true });\\n  }\\n});\"}]}","status":"completed"}],"error":null,"incomplete_details":null,"tools":[{"type":"function","name":"read","description":"Read the contents of a file. Supports text files and images (jpg, png, gif, webp, bmp). Images are sent as attachments. For text files, output is truncated to 2000 lines or 50KB (whichever is hit first). Use offset/limit for large files. When you need the full file, continue with offset until complete.","parameters":{"type":"object","required":["path","offset","limit"],"properties":{"path":{"type":"string","description":"Path to the file to read (relative or absolute)"},"offset":{"anyOf":[{"type":"number","description":"Line number to start reading from (1-indexed)"},{"type":"null"}]},"limit":{"anyOf":[{"type":"number","description":"Maximum number of lines to read"},{"type":"null"}]}},"additionalProperties":false},"output_schema":null,"strict":true},{"type":"function","name":"bash","description":"Execute a bash command in the current working directory. Returns stdout and stderr. Output is truncated to last 2000 lines or 50KB (whichever is hit first). If truncated, full output is saved to a temp file. Optionally provide a timeout in seconds.","parameters":{"type":"object","required":["command","timeout"],"properties":{"command":{"type":"string","description":"Shell command to execute"},"timeout":{"anyOf":[{"type":"number","description":"Timeout in seconds (optional, no default timeout)"},{"type":"null"}]}},"additionalProperties":false},"output_schema":null,"strict":true},{"type":"function","name":"edit","description":"Edit a single file using exact text replacement. Every edits[].oldText must match a unique, non-overlapping region of the original file. If two changes affect the same block or nearby lines, merge them into one edit instead of emitting overlapping edits. Do not include large unchanged regions just to connect distant changes.","parameters":{"type":"object","required":["path","edits"],"properties":{"path":{"type":"string","description":"Path to the file to edit (relative or absolute)"},"edits":{"type":"array","items":{"type":"object","required":["oldText","newText"],"properties":{"oldText":{"type":"string","description":"Exact text for one targeted replacement. It must be unique in the original file and must not overlap with any other edits[].oldText in the same call."},"newText":{"type":"string","description":"Replacement text for this targeted edit."}},"additionalProperties":false},"description":"One or more targeted replacements. Each edit is matched against the original file, not incrementally. Do not include overlapping or nested edits. If two changes touch the same block or nearby lines, merge them into one edit instead."}},"additionalProperties":false},"output_schema":null,"strict":true},{"type":"function","name":"write","description":"Write content to a file. Creates the file if it doesn't exist, overwrites if it does. Automatically creates parent directories.","parameters":{"type":"object","required":["path","content"],"properties":{"path":{"type":"string","description":"Path to the file to write (relative or absolute)"},"content":{"type":"string","description":"Content to write to the file"}},"additionalProperties":false},"output_schema":null,"strict":true}],"tool_choice":"auto","parallel_tool_calls":true,"prompt_cache_key":"7af4fae4-b8c0-4cec-a8ac-d9c47e332fda","prompt_cache_retention":"24h","text":{"format":{"type":"text"},"verbosity":"low"},"top_p":0.98,"top_logprobs":0,"temperature":1.0,"reasoning":{"effort":"medium","summary":"detailed","context":"all_turns","mode":"standard"},"user":null,"usage":{"input_tokens":23355,"input_tokens_details":{"cached_tokens":2688,"cache_write_tokens":0},"output_tokens":1596,"output_tokens_details":{"reasoning_tokens":41},"total_tokens":24951,"attribution":{"items":{"fc_019da4a6741996f3016acb587542fc81968f1c4be0d8e13598":{"input_tokens":34,"cached_tokens":0,"cache_write_tokens":0,"output_tokens":0},"fc_019da4a6741996f3016acb587a68888196add748d5d3dbe927":{"input_tokens":42,"cached_tokens":0,"cache_write_tokens":0,"output_tokens":0},"fc_019da4a6741996f3016acb587a689881968a3fb7e8c518a420":{"input_tokens":23,"cached_tokens":0,"cache_write_tokens":0,"output_tokens":0},"fc_019da4a6741996f3016acb587a689c819686fd5c99aa9345dc":{"input_tokens":22,"cached_tokens":0,"cache_write_tokens":0,"output_tokens":0},"fc_019da4a6741996f3016acb587a68a48196acf7c13d4b20cab4":{"input_tokens":22,"cached_tokens":0,"cache_write_tokens":