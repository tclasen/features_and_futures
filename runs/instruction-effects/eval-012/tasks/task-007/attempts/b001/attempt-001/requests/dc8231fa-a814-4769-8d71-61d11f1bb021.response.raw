dText\":\"test('priorities migrate, remain independent, preserve task state and persist through archive and restart', async () => {\",\"newText\":\"test('combined filters preserve selections, intersect in creation order and re-evaluate edits', async () => {\\n  await mkdir('data', { recursive: true });\\n  const directory = await mkdtemp('data/test-');\\n  let server;\\n  try {\\n    const databasePath = resolve(directory, 'filters.sqlite');\\n    server = await start(databasePath);\\n    const get = async path => (await fetch(`${server.url}${path}`)).text();\\n    const post = (path, values = {}) => fetch(`${server.url}${path}`, {\\n      method: 'POST', body: new URLSearchParams(values), redirect: 'manual',\\n    });\\n    const titles = html => [...html.matchAll(/data-testid=\\\"task-row\\\">\\\\s*<span>([^<]*)<\\\\/span>/g)].map(match => match[1]);\\n    const selections = (html, completion, priority) => {\\n      assert.match(html, new RegExp(`<select id=\\\"task-filter\\\"[^>]*>[\\\\\\\\s\\\\\\\\S]*?<option selected>${completion}</option>`));\\n      const prioritySelect = html.match(/<select id=\\\"priority-filter\\\"[^>]*>([\\\\s\\\\S]*?)<\\\\/select>/)[1];\\n      assert.equal(prioritySelect.replace(/\\\\s+/g, ''), ['All', 'Low', 'Normal', 'High'].map(value => `<option${value === priority ? ' selected' : ''}>${value}</option>`).join('').replace(/\\\\s+/g, ''));\\n    };\\n    await post('/projects', { name: 'One' });\\n    const tasks = [];\\n    for (const priority of ['Low', 'Normal', 'High']) {\\n      for (const completed of [false, true]) {\\n        const id = tasks.length + 1;\\n        const title = `Task ${id}`;\\n        await post('/projects/1/tasks', { title });\\n        await post(`/projects/1/tasks/${id}/priority`, { priority });\\n        if (completed) await post(`/projects/1/tasks/${id}`, { completed: '1' });\\n        tasks.push({ title, priority, completed });\\n      }\\n    }\\n    selections(await get('/projects/1'), 'All', 'All');\\n    const summary = await get('/');\\n    for (const filter of ['All', 'Open', 'Completed']) {\\n      for (const priorityFilter of ['All', 'Low', 'Normal', 'High']) {\\n        const html = await get(`/projects/1?filter=${filter}&priorityFilter=${priorityFilter}`);\\n        selections(html, filter, priorityFilter);\\n        assert.deepEqual(titles(html), tasks.filter(task =>\\n          (filter === 'All' || task.completed === (filter === 'Completed')) &&\\n          (priorityFilter === 'All' || task.priority === priorityFilter)).map(task => task.title));\\n      }\\n    }\\n    assert.equal(await get('/'), summary);\\n    const selected = { filter: 'Open', priorityFilter: 'High' };\\n    const location = '/projects/1?filter=Open&priorityFilter=High';\\n    let response = await post('/projects/1/tasks/5/rename', { ...selected, title: '  Renamed  ' });\\n    assert.equal(response.headers.get('location'), location);\\n    assert.deepEqual(titles(await get(location)), ['Renamed']);\\n    response = await post('/projects/1/tasks/5/rename', { ...selected, title: ' ' });\\n    assert.equal(response.status, 422);\\n    const invalid = await response.text();\\n    selections(invalid, 'Open', 'High');\\n    assert.match(invalid, /Task title is required/);\\n    assert.match(invalid, /name=\\\"priorityFilter\\\" value=\\\"High\\\"/);\\n    assert.equal(await get('/'), summary);\\n    response = await post('/projects/1/tasks/5/priority', { ...selected, priority: 'Low' });\\n    assert.equal(response.headers.get('location'), location);\\n    selections(await get(location), 'Open', 'High');\\n    assert.deepEqual(titles(await get(location)), []);\\n    await post('/projects/1/tasks/5/priority', { ...selected, priority: 'High' });\\n    response = await post('/projects/1/tasks/5', { ...selected, completed: '1' });\\n    assert.equal(response.headers.get('location'), location);\\n    assert.deepEqual(titles(await get(location)), []);\\n    selections(await get(location), 'Open', 'High');\\n    assert.deepEqual(titles(await get('/projects/1?filter=Completed&priorityFilter=High')), ['Renamed', 'Task 6']);\\n    assert.match(await get('/'), /4\\\\/6 completed/);\\n    await post('/projects/1/archive');\\n    const archived = await get('/projects/1?filter=Completed&priorityFilter=High');\\n    selections(archived, 'Completed', 'High');\\n    assert.doesNotMatch(archived, /<select id=\\\"(?:task-filter|priority-filter)\\\"[^>]*disabled/);\\n    assert.equal((archived.match(/<select id=\\\"task-priority-\\\\d+\\\"[^>]*disabled/g) || []).length, 2);\\n    response = await post('/projects/1/tasks/5/priority', { ...selected, priority: 'Normal' });\\n    assert.equal(response.status, 403);\\n    selections(await response.text(), 'Open', 'High');\\n    await server.stop();\\n    server = await start(databasePath);\\n    assert.equal(await get('/projects/1?filter=Completed&priorityFilter=High'), archived);\\n    await post('/projects/1/restore');\\n    const restored = await get('/projects/1?filter=Completed&priorityFilter=High');\\n    assert.deepEqual(titles(restored), ['Renamed', 'Task 6']);\\n    assert.doesNotMatch(restored, /disabled/);\\n    selections(await get('/projects/1'), 'All', 'All');\\n  } finally {\\n    if (server) await server.stop();\\n    await rm(directory, { recursive: true, force: true });\\n  }\\n});\\n\\ntest('priorities migrate, remain independent, preserve task state and persist through archive and restart', async () => {\"}]}","status":"completed"}],"error":null,"incomplete_details":null,"tools":[{"type":"function","name":"read","description":"Read the contents of a file. Supports text files and images (jpg, png, gif, webp, bmp). Images are sent as attachments. For text files, output is truncated to 2000 lines or 50KB (whichever is hit first). Use offset/limit for large files. When you need the full file, continue with offset until complete.","parameters":{"type":"object","required":["path","offset","limit"],"properties":{"path":{"type":"string","description":"Path to the file to read (relative or absolute)"},"offset":{"anyOf":[{"type":"number","description":"Line number to start reading from (1-indexed)"},{"type":"null"}]},"limit":{"anyOf":[{"type":"number","description":"Maximum number of lines to read"},{"type":"null"}]}},"additionalProperties":false},"output_schema":null,"strict":true},{"type":"function","name":"bash","description":"Execute a bash command in the current working directory. Returns stdout and stderr. Output is truncated to last 2000 lines or 50KB (whichever is hit first). If truncated, full output is saved to a temp file. Optionally provide a timeout in seconds.","parameters":{"type":"object","required":["command","timeout"],"properties":{"command":{"type":"string","description":"Shell command to execute"},"timeout":{"anyOf":[{"type":"number","description":"Timeout in seconds (optional, no default timeout)"},{"type":"null"}]}},"additionalProperties":false},"output_schema":null,"strict":true},{"type":"function","name":"edit","description":"Edit a single file using exact text replacement. Every edits[].oldText must match a unique, non-overlapping region of the original file. If two changes affect the same block or nearby lines, merge them into one edit instead of emitting overlapping edits. Do not include large unchanged regions just to connect distant changes.","parameters":{"type":"object","required":["path","edits"],"properties":{"path":{"type":"string","description":"Path to the file to edit (relative or absolute)"},"edits":{"type":"array","items":{"type":"object","required":["oldText","newText"],"properties":{"oldText":{"type":"string","description":"Exact text for one targeted replacement. It must be unique in the original file and must not overlap with any other edits[].oldText in the same call."},"newText":{"type":"string","description":"Replacement text for this targeted edit."}},"additionalProperties":false},"description":"One or more targeted replacements.