\\" name=\\\"search\\\" value=\\\"${escapeHtml(search)}\\\">\\n      <label\"},{\"oldText\":\"    <form action=\\\"/\\\" method=\\\"get\\\" class=\\\"filter-form\\\">\\n      <label\",\"newText\":\"    <form action=\\\"/\\\" method=\\\"get\\\" class=\\\"filter-form\\\">\\n      <input type=\\\"hidden\\\" name=\\\"search\\\" value=\\\"${escapeHtml(search)}\\\">\\n      <label\"},{\"oldText\":\"    <ul class=\\\"projects\\\">${rows}</ul>`);\",\"newText\":\"    <form action=\\\"/\\\" method=\\\"get\\\" class=\\\"filter-form\\\">\\n      <input type=\\\"hidden\\\" name=\\\"filter\\\" value=\\\"${filter}\\\">\\n      <label for=\\\"project-search\\\">Project search</label>\\n      <input id=\\\"project-search\\\" name=\\\"search\\\" type=\\\"text\\\" value=\\\"${escapeHtml(search)}\\\">\\n      <button type=\\\"submit\\\">Search projects</button>\\n    </form>\\n    <ul class=\\\"projects\\\">${rows}</ul>`);\"},{\"oldText\":\"function projectPage(project, filter = 'All', error = '', priority = 'All', range = { from: '', through: '' }) {\\n  const rangeInputs = `<input\",\"newText\":\"function projectPage(project, filter = 'All', error = '', priority = 'All', range = { from: '', through: '' }, search = '') {\\n  const searchInput = `<input type=\\\"hidden\\\" name=\\\"search\\\" value=\\\"${escapeHtml(search)}\\\">`;\\n  const rangeInputs = `${searchInput}<input\"},{\"oldText\":\"    .filter(task => (filter === 'All'\",\"newText\":\"    .filter(task => searchMatches(task.title, search) && (filter === 'All'\"},{\"oldText\":\"    <ul class=\\\"projects tasks\\\">${rows}</ul>`);\",\"newText\":\"    <form action=\\\"/projects/${project.id}\\\" method=\\\"get\\\" class=\\\"filter-form\\\">\\n      <input type=\\\"hidden\\\" name=\\\"filter\\\" value=\\\"${filter}\\\">\\n      <input type=\\\"hidden\\\" name=\\\"priorityFilter\\\" value=\\\"${priority}\\\">\\n      <input type=\\\"hidden\\\" name=\\\"dueFrom\\\" value=\\\"${escapeHtml(range.from)}\\\">\\n      <input type=\\\"hidden\\\" name=\\\"dueThrough\\\" value=\\\"${escapeHtml(range.through)}\\\">\\n      <label for=\\\"task-search\\\">Task search</label>\\n      <input id=\\\"task-search\\\" name=\\\"search\\\" type=\\\"text\\\" value=\\\"${escapeHtml(search)}\\\">\\n      <button type=\\\"submit\\\">Search tasks</button>\\n    </form>\\n    <ul class=\\\"projects tasks\\\">${rows}</ul>`);\"},{\"oldText\":\"      sendHtml(response, 200, projectList('', projectFilter(url.searchParams.get('filter'))));\",\"newText\":\"      sendHtml(response, 200, projectList('', projectFilter(url.searchParams.get('filter')), searchQuery(url.searchParams)));\"},{\"oldText\":\"      const name = (form.get('name') || '').trim();\\n      if (!name) {\\n        sendHtml(response, 422, projectList('Project name is required'));\",\"newText\":\"      const name = (form.get('name') || '').trim();\\n      const filter = projectFilter(form.get('filter'));\\n      const search = searchQuery(form);\\n      if (!name) {\\n        sendHtml(response, 422, projectList('Project name is required', filter, search));\"},{\"oldText\":\"      response.writeHead(303, { Location: '/' });\",\"newText\":\"      response.writeHead(303, { Location: `/?${new URLSearchParams({ filter, search })}` });\"},{\"oldText\":\"      response.writeHead(303, { Location: action === 'archive' ? '/' : '/?filter=Archived' });\",\"newText\":\"      const form = await readForm(request);\\n      response.writeHead(303, { Location: `/?${new URLSearchParams({ filter: action === 'archive' ? 'Active' : 'Archived', search: searchQuery(form) })}` });\"}]}"}

