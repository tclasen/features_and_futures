pleted INTEGER NOT NULL DEFAULT 0);\\n    INSERT INTO projects (name) VALUES ('First  PROJECT'), ('Second'), ('Empty');\\n    INSERT INTO tasks (project_id, title, completed) VALUES (1, 'Original  TITLE', 1), (1, 'Later', 0), (2, 'Other project', 0);`);\\n  legacy.close();\\n  const base = 'http://127.0.0.1:18090';\\n  let child;\\n  async function start() {\\n    child = spawn(process.execPath, ['server.js'], {\\n      env: { ...process.env, PORT: '18090', DB_PATH: dbPath }, stdio: 'ignore'\\n    });\\n    for (let i = 0; i < 100; i++) {\\n      if (child.exitCode !== null) throw new Error('Server exited');\\n      try { if ((await fetch(base + '/health')).ok) return; } catch {}\\n      await new Promise(resolve => setTimeout(resolve, 25));\\n    }\\n    throw new Error('Server not ready');\\n  }\\n  async function stop() {\\n    if (child && child.exitCode === null) {\\n      const exited = once(child, 'exit');\\n      child.kill('SIGTERM');\\n      await exited;\\n    }\\n  }\\n  const post = (path, values = {}) => fetch(base + path, {\\n    method: 'POST', body: new URLSearchParams(values), redirect: 'manual'\\n  });\\n  const exported = async (id, query = '') => {\\n    const response = await fetch(`${base}/projects/${id}/download${query}`);\\n    assert.equal(response.status, 200);\\n    assert.equal(response.headers.get('content-disposition'), 'attachment; filename=\\\"workboard-project.json\\\"');\\n    assert.match(response.headers.get('content-type'), /application\\\\/json; charset=utf-8/);\\n    return response.json();\\n  };\\n  try {\\n    await start();\\n    const defaults = await exported(1);\\n    assert.deepEqual(defaults, {\\n      format: 'workboard-project', version: 1,\\n      project: { name: 'First  PROJECT', archived: false, defaultPriority: 'Normal', tasks: [\\n        { title: 'Original  TITLE', completed: true, priority: 'Normal', dueDate: '', notes: '', deleted: false },\\n        { title: 'Later', completed: false, priority: 'Normal', dueDate: '', notes: '', deleted: false }\\n      ] }\\n    });\\n    assert.deepEqual((await exported(3)).project.tasks, []);\\n    await post('/projects/1/tasks/1/priority', { priority: 'High' });\\n    await post('/projects/1/tasks/1/due-date', { dueDate: '0001-01-01' });\\n    const notes = '  café 🐱 <b>& literal</b>\\\\r\\\\nsecond\\\\rthird\\\\n tail  ';\\n    await post('/projects/1/tasks/1/notes', { notes });\\n    await post('/projects/1/tasks/1/move', { destination: '2' });\\n    await post('/projects/1/tasks', { title: 'Newest' });\\n    await post('/projects/2/tasks/1/move', { destination: '1' });\\n    await post('/projects/1/tasks/1/delete');\\n    await post('/projects/1/default-priority', { priority: 'Low' });\\n    const query = '?filter=Open&priorityFilter=Low&search=absent&dueFrom=2025-01-01';\\n    const beforePage = await (await fetch(base + '/projects/1' + query)).text();\\n    assert.match(beforePage, /<button type=\\\"submit\\\">Download project<\\\\/button>/);\\n    const expected = await exported(1, query);\\n    assert.deepEqual(expected.project.tasks.map(t => t.title), ['Original  TITLE', 'Later', 'Newest']);\\n    assert.deepEqual(expected.project.tasks[0], {\\n      title: 'Original  TITLE', completed: true, priority: 'High', dueDate: '0001-01-01',\\n      notes: notes.replace(/\\\\r\\\\n?/g, '\\\\n'), deleted: true\\n    });\\n    assert.equal(expected.project.defaultPriority, 'Low');\\n    assert.equal(await (await fetch(base + '/projects/1' + query)).text(), beforePage);\\n    const check = new DatabaseSync(dbPath);\\n    assert.equal(check.prepare('SELECT notes FROM tasks WHERE id = 1').get().notes, notes);\\n    check.close();\\n    await post('/projects/1/tasks/2/delete');\\n    await post('/projects/1/tasks/4/delete');\\n    await post('/projects/1/archive');\\n    const archived = await exported(1);\\n    assert.equal(archived.project.archived, true);\\n    assert.ok(archived.project.tasks.every(t => t.deleted));\\n    assert.match(await (await fetch(base + '/projects/1')).text(), /<button type=\\\"submit\\\">Download project<\\\\/button>/);\\n    await stop();\\n    await start();\\n    assert.deepEqual(await exported(1), archived);\\n    assert.equal((await fetch(base + '/projects/999/download')).status, 404);\\n  } finally {\\n    await stop();\\n    await rm(dir, { recursive: true, force: true });\\n  }\\n});\\n\"}","status":"completed"}],"error":null,"incomplete_details":null,"tools":[{"type":"function","name":"read","description":"Read the contents of a file. Supports text files and images (jpg, png, gif, webp, bmp). Images are sent as attachments. For text files, output is truncated to 2000 lines or 50KB (whichever is hit first). Use offset/limit for large files. When you need the full file, continue with offset until complete.","parameters":{"type":"object","required":["path","offset","limit"],"properties":{"path":{"type":"string","description":"Path to the file to read (relative or absolute)"},"offset":{"anyOf":[{"type":"number","description":"Line number to start reading from (1-indexed)"},{"type":"null"}]},"limit":{"anyOf":[{"type":"number","description":"Maximum number of lines to read"},{"type":"null"}]}},"additionalProperties":false},"output_schema":null,"strict":true},{"type":"function","name":"bash","description":"Execute a bash command in the current working directory. Returns stdout and stderr. Output is truncated to last 2000 lines or 50KB (whichever is hit first). If truncated, full output is saved to a temp file. Optionally provide a timeout in seconds.","parameters":{"type":"object","required":["command","timeout"],"properties":{"command":{"type":"string","description":"Shell command to execute"},"timeout":{"anyOf":[{"type":"number","description":"Timeout in seconds (optional, no default timeout)"},{"type":"null"}]}},"additionalProperties":false},"output_schema":null,"strict":true},{"type":"function","name":"edit","description":"Edit a single file using exact text replacement. Every edits[].oldText must match a unique, non-overlapping region of the original file. If two changes affect the same block or nearby lines, merge them into one edit instead of emitting overlapping edits. Do not include large unchanged regions just to connect distant changes.","parameters":{"type":"object","required":["path","edits"],"properties":{"path":{"type":"string","description":"Path to the file to edit (relative or absolute)"},"edits":{"type":"array","items":{"type":"object","required":["oldText","newText"],"properties":{"oldText":{"type":"string","description":"Exact text for one targeted replacement. It must be unique in the original file and must not overlap with any other edits[].oldText in the same call."},"newText":{"type":"string","description":"Replacement text for this targeted edit."}},"additionalProperties":false},"description":"One or more targeted replacements. Each edit is matched against the original file, not incrementally. Do not include overlapping or nested edits. If two changes touch the same block or nearby lines, merge them into one edit instead."}},"additionalProperties":false},"output_schema":null,"strict":true},{"type":"function","name":"write","description":"Write content to a file. Creates the file if it doesn't exist, overwrites if it does. Automatically creates parent directories.","parameters":{"type":"object","required":["path","content"],"properties":{"path":{"type":"string","description":"Path to the file to write (relative or absolute)"},"content":{"type":"string","description":"Content to write to the file"}},"additionalProperties":false},"output_schema":null,"strict":true}],"tool_choice":"auto","parallel_tool_calls":true,"prompt_cache_key":"8e960411-751e-44d4-a6d2-4a902b0111da","prompt_cache_retention":"24h","text":{"format":{"type":"text"},"verbosity":"low"},"top_p":0.98,"top_logprobs":0,"temperature":1.0,"reasoning":{"effort":"medium","summary":"detailed","context":"all_turns","mode":"standard"},"user":null,"usa