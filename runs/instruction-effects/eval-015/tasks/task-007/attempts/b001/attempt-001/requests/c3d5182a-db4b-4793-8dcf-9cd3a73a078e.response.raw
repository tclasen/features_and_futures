ponse, 403, projectPage(project, filter, 'Archived project is read-only', priority));\\n        return;\\n      }\\n      const name\"},{\"oldText\":\"projectPage(project, filter, 'Project name is required')\",\"newText\":\"projectPage(project, filter, 'Project name is required', priority)\"},{\"oldText\":\"      renameProject.run(name, id);\\n      response.writeHead(303, { Location: `/projects/${id}?filter=${filter}` });\",\"newText\":\"      renameProject.run(name, id);\\n      response.writeHead(303, { Location: projectLocation(id, filter, priority) });\"},{\"oldText\":\"      const filter = taskFilter(form.get('filter'));\\n      if (project.archived) {\\n        html(response, 403, projectPage(project, filter, 'Archived project is read-only'));\\n        return;\\n      }\\n      if (action\",\"newText\":\"      const filter = taskFilter(form.get('filter'));\\n      const selectedPriority = priorityFilter(form.get('priorityFilter'));\\n      if (project.archived) {\\n        html(response, 403, projectPage(project, filter, 'Archived project is read-only', selectedPriority));\\n        return;\\n      }\\n      if (action\"},{\"oldText\":\"projectPage(project, filter, 'Invalid task priority')\",\"newText\":\"projectPage(project, filter, 'Invalid task priority', selectedPriority)\"},{\"oldText\":\"        createTask.run(id, title);\\n      }\\n      response.writeHead(303, { Location: `/projects/${id}?filter=${filter}` });\",\"newText\":\"        createTask.run(id, title);\\n      }\\n      response.writeHead(303, { Location: projectLocation(id, filter, selectedPriority) });\"},{\"oldText\":\"        if (!title) {\\n          html(response, 400, projectPage(project, filter, 'Task title is required'));\\n          return;\\n        }\\n        renameTask.run\",\"newText\":\"        if (!title) {\\n          html(response, 400, projectPage(project, filter, 'Task title is required', selectedPriority));\\n          return;\\n        }\\n        renameTask.run\"},{\"oldText\":\"        if (!title) {\\n          html(response, 400, projectPage(project, filter, 'Task title is required'));\\n          return;\\n        }\\n        createTask.run\",\"newText\":\"        if (!title) {\\n          html(response, 400, projectPage(project, filter, 'Task title is required', selectedPriority));\\n          return;\\n        }\\n        createTask.run\"}]}","status":"completed"}}

