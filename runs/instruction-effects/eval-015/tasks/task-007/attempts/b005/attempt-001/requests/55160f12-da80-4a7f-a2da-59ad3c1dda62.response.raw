\ntest('combined filters retain selections through edits, validation, archives and restart', async () => {\\n  const directory = await mkdtemp(join(tmpdir(), 'workboard-filters-'));\\n  let server;\\n  let url;\\n  const start = async () => {\\n    server = createApplication(join(directory, 'db.sqlite'));\\n    server.listen(0, '127.0.0.1');\\n    await once(server, 'listening');\\n    url = `http://127.0.0.1:${server.address().port}`;\\n  };\\n  const stop = () => new Promise(resolve => server.close(resolve));\\n  const html = async path => (await fetch(`${url}${path}`)).text();\\n  const post = (path, values = {}) => fetch(`${url}${path}`, {\\n    method: 'POST', body: new URLSearchParams(values), redirect: 'manual',\\n  });\\n  const titles = text => [...text.matchAll(/aria-label=\\\"Complete ([^\\\"]+)\\\"/g)].map(match => match[1]);\\n  const selected = (text, id) => text.match(new RegExp(`<select id=\\\"${id}\\\"[^>]*>([\\\\\\\\s\\\\\\\\S]*?)</select>`))[1].match(/<option selected>(.*?)<\\\\/option>/)[1];\\n  const view = (filter, priorityFilter) => html(`/projects/1?${new URLSearchParams({ filter, priorityFilter })}`);\\n  try {\\n    await start();\\n    await post('/projects', { name: 'First' });\\n    await post('/projects', { name: 'Other' });\\n    const priorities = ['Low', 'Normal', 'High', 'Low', 'Normal', 'High'];\\n    for (let index = 0; index < priorities.length; index++) {\\n      await post('/projects/1/tasks', { title: `Task ${index + 1}` });\\n      await post(`/projects/1/tasks/${index + 1}/priority`, { priority: priorities[index] });\\n      if (index >= 3) await post(`/projects/1/tasks/${index + 1}/completion`, { completed: '1' });\\n    }\\n    const summary = await html('/');\\n    assert.match(summary, /3\\\\/6 completed/);\\n    for (const filter of ['All', 'Open', 'Completed']) {\\n      for (const priorityFilter of ['All', 'Low', 'Normal', 'High']) {\\n        const text = await view(filter, priorityFilter);\\n        assert.equal(selected(text, 'task-filter'), filter);\\n        assert.equal(selected(text, 'priority-filter'), priorityFilter);\\n        assert.deepEqual(titles(text), priorities.flatMap((priority, index) =>\\n          (priorityFilter === 'All' || priority === priorityFilter) &&\\n          (filter === 'All' || (index >= 3) === (filter === 'Completed')) ? [`Task ${index + 1}`] : []));\\n      }\\n    }\\n    const initial = await html('/projects/1');\\n    assert.equal(selected(initial, 'priority-filter'), 'All');\\n    assert.match(initial, /<option selected>All<\\\\/option><option>Low<\\\\/option><option>Normal<\\\\/option><option>High<\\\\/option>/);\\n    assert.deepEqual(titles(await html('/projects/2')), []);\\n    const filters = { filter: 'Open', priorityFilter: 'High' };\\n    const edit = async (action, values) => {\\n      const response = await post(`/projects/1/tasks/3/${action}`, { ...filters, ...values });\\n      assert.equal(response.status, 303);\\n      assert.equal(response.headers.get('location'), '/projects/1?filter=Open&priorityFilter=High');\\n      const text = await html(response.headers.get('location'));\\n      assert.equal(selected(text, 'task-filter'), 'Open');\\n      assert.equal(selected(text, 'priority-filter'), 'High');\\n      return text;\\n    };\\n    assert.deepEqual(titles(await edit('rename', { title: ' Renamed ' })), ['Renamed']);\\n    assert.equal(await html('/'), summary);\\n    const invalid = await post('/projects/1/tasks/3/rename', { ...filters, title: ' ' });\\n    assert.equal(invalid.status, 400);\\n    const invalidHtml = await invalid.text();\\n    assert.match(invalidHtml, /role=\\\"alert\\\">Task title is required/);\\n    assert.equal(selected(invalidHtml, 'priority-filter'), 'High');\\n    assert.deepEqual(titles(await edit('priority', { priority: 'Low' })), []);\\n    assert.equal(await html('/'), summary);\\n    assert.deepEqual(titles(await edit('priority', { priority: 'High' })), ['Renamed']);\\n    assert.deepEqual(titles(await edit('completion', { completed: '1' })), []);\\n    assert.deepEqual(titles(await view('Completed', 'High')), ['Renamed', 'Task 6']);\\n    const persisted = await view('Completed', 'High');\\n    await stop();\\n    await start();\\n    assert.equal(await view('Completed', 'High'), persisted);\\n    await post('/projects/1/archive');\\n    const archived = await view('Completed', 'High');\\n    assert.equal(selected(archived, 'priority-filter'), 'High');\\n    assert.match(archived, /name=\\\"priority\\\" disabled data-auto-submit/);\\n    assert.doesNotMatch(archived, /id=\\\"(?:task-filter|priority-filter)\\\"[^>]*disabled/);\\n    const rejected = await post('/projects/1/tasks/3/priority', { ...filters, priority: 'Normal' });\\n    assert.equal(rejected.status, 403);\\n    assert.equal(selected(await rejected.text(), 'priority-filter'), 'High');\\n    assert.deepEqual(titles(await view('Open', 'Low')), ['Task 1']);\\n    await post('/projects/1/restore');\\n    assert.equal(await view('Completed', 'High'), persisted);\\n    assert.equal(selected(await html('/projects/1'), 'priority-filter'), 'All');\\n    const fallback = await view('invalid', 'invalid');\\n    assert.equal(selected(fallback, 'task-filter'), 'All');\\n    assert.equal(selected(fallback, 'priority-filter'), 'All');\\n  } finally {\\n    if (server?.listening) await stop();\\n    await rm(directory, { recursive: true, force: true });\\n  }\\n});\\n\"}","status":"completed"}],"error":null,"incomplete_details":null,"tools":[{"type":"function","name":"read","description":"Read the contents of a file. Supports text files and images (jpg, png, gif, webp, bmp). Images are sent as attachments. For text files, output is truncated to 2000 lines or 50KB (whichever is hit first). Use offset/limit for large files. When you need the full file, continue with offset until complete.","parameters":{"type":"object","required":["path","offset","limit"],"properties":{"path":{"type":"string","description":"Path to the file to read (relative or absolute)"},"offset":{"anyOf":[{"type":"number","description":"Line number to start reading from (1-indexed)"},{"type":"null"}]},"limit":{"anyOf":[{"type":"number","description":"Maximum number of lines to read"},{"type":"null"}]}},"additionalProperties":false},"output_schema":null,"strict":true},{"type":"function","name":"bash","description":"Execute a bash command in the current working directory. Returns stdout and stderr. Output is truncated to last 2000 lines or 50KB (whichever is hit first). If truncated, full output is saved to a temp file. Optionally provide a timeout in seconds.","parameters":{"type":"object","required":["command","timeout"],"properties":{"command":{"type":"string","description":"Shell command to execute"},"timeout":{"anyOf":[{"type":"number","description":"Timeout in seconds (optional, no default timeout)"},{"type":"null"}]}},"additionalProperties":false},"output_schema":null,"strict":true},{"type":"function","name":"edit","description":"Edit a single file using exact text replacement. Every edits[].oldText must match a unique, non-overlapping region of the original file. If two changes affect the same block or nearby lines, merge them into one edit instead of emitting overlapping edits. Do not include large unchanged regions just to connect distant changes.","parameters":{"type":"object","required":["path","edits"],"properties":{"path":{"type":"string","description":"Path to the file to edit (relative or absolute)"},"edits":{"type":"array","items":{"type":"object","required":["oldText","newText"],"properties":{"oldText":{"type":"string","description":"Exact text for one targeted replacement. It must be unique in the original file and must not overlap with any other edits[].oldText in the same call."},"newText":{"type":"string","description":"Replacement text for this targeted edit."}},"additionalProperties":false},"description":"One or more targeted replacements. Each edit is matched against the original file, not incrementally. Do not include overlapping or nested edits. If two changes touch the same block or nearby lines, merge them into one edit instead."}},"additionalProperties":false},"output_schema":null,"strict":true},{"type":"function","name":"write","description":"Write content to a file. Creates the file if it doesn't exist, overwrites if it does. Automatically creates parent directories.","parameters":{"type":"object","required":["path","content"],"properties":{"path":{"type":"string","description":"Path to the file to write (relative or absolute)"},"content":{"type":"string","description":"Content to write to the file"}},"additionalProperties":false},"output_schema":null,"strict":true}],"tool_choice":"auto","parallel_tool_calls":true,"prompt_cache_key":"b0b6d7d9-091b-4c24-9481-44aaeda10250","prompt_cache_retention":"24h","text":{"format":{"type":"text"},"verbosity":"low"},"top_p":0.98,"top_logprobs":0,"temperature":1.0,"reasoning":{"effort":"medium","summary":"detailed","context":"all_turns","mode":"standard"},"user":null,"usage":{"input_tokens":12897,"input_tokens_details":{"cached_tokens":0,"cache_write_tokens":0},"output_tokens":1605,"output_tokens_details":{"reasoning_tokens":30},"total_tokens":14502,"attribution":{"items":{"fc_05b20bb7fa99f3fc016acc32aca1e48193bdf029e1ee974d5f":{"input_tokens":42,"cached_tokens":0,"cache_write_tokens":0,"output_tokens":0},"fc_05b20bb7fa99f3fc016acc32b031f08193aacf89225b0c8772":{"input_tokens":42,"cached_tokens":0,"cache_write_tokens":0,"output_tokens":0},"fc_05b20bb7fa99f3fc016acc32b2209c81938aa3c8ca0b09134b":{"input_tokens":24,"cached_tokens":0,"cache_write_tokens":0,"output_tokens":0},"fc_05b20bb7fa99f3fc016acc32b2209c81939c3cbf89e3ddb44d":{"input_tokens":22,"cached_tokens":0,"cache_write_tokens":0,"output_tokens":0},"fc_05b20bb7fa99f3fc016acc32b2209c8193b059efad9946d48b":{"input_tokens":24,"cached_tokens":0,"cache_write_tokens":0,"output_tokens":0},"fc_05b20bb7fa99f3fc016acc32b6e9408193bf7b853f5d61e4ab":{"inp