..priorities].map(value => `<option${priorityFilter === value ? ' selected' : ''}>${value}</option>`).join('')}\\n        </select>\\n      </form>\"},\n{\"oldText\":\"          <input type=\\\"hidden\\\" name=\\\"filter\\\" value=\\\"${filter}\\\">\\n          <input type=\\\"hidden\\\" name=\\\"completed\\\"\",\"newText\":\"          ${filterFields}\\n          <input type=\\\"hidden\\\" name=\\\"completed\\\"\"},\n{\"oldText\":\"          <input type=\\\"hidden\\\" name=\\\"filter\\\" value=\\\"${filter}\\\">\\n          <label for=\\\"task-priority-\",\"newText\":\"          ${filterFields}\\n          <label for=\\\"task-priority-\"},\n{\"oldText\":\"          <input type=\\\"hidden\\\" name=\\\"filter\\\" value=\\\"${filter}\\\">\\n          <label for=\\\"new-task-title-\",\"newText\":\"          ${filterFields}\\n          <label for=\\\"new-task-title-\"},\n{\"oldText\":\"  async function readForm(request) {\",\"newText\":\"  function priorityFilterValue(value) {\\n    return priorities.includes(value) ? value : 'All';\\n  }\\n\\n  function projectLocation(id, filter, priorityFilter) {\\n    return `/projects/${id}?${new URLSearchParams({ filter, priorityFilter })}`;\\n  }\\n\\n  async function readForm(request) {\"},\n{\"oldText\":\"sendHtml(200, projectPage(project, taskFilter(url.searchParams.get('filter'))));\",\"newText\":\"sendHtml(200, projectPage(project, taskFilter(url.searchParams.get('filter')),\\n          priorityFilterValue(url.searchParams.get('priorityFilter'))));\"},\n{\"oldText\":\"        const filter = taskFilter(body.get('filter'));\\n        if (project.archived) {\\n          sendHtml(403, projectPage(project, filter, 'Archived projects cannot be changed'));\\n          return;\\n        }\\n        const name\",\"newText\":\"        const filter = taskFilter(body.get('filter'));\\n        const priorityFilter = priorityFilterValue(body.get('priorityFilter'));\\n        if (project.archived) {\\n          sendHtml(403, projectPage(project, filter, priorityFilter, 'Archived projects cannot be changed'));\\n          return;\\n        }\\n        const name\"},\n{\"oldText\":\"projectPage(project, filter, 'Project name is required')\",\"newText\":\"projectPage(project, filter, priorityFilter, 'Project name is required')\"},\n{\"oldText\":\"Location: `/projects/${id}?filter=${filter}`\",\"newText\":\"Location: projectLocation(id, filter, priorityFilter)\"},\n{\"oldText\":\"        const filter = taskFilter(body.get('filter'));\\n        if (project.archived) {\\n          sendHtml(403, projectPage(project, filter, 'Archived projects cannot be changed'));\\n          return;\\n        }\\n        if (parts.length\",\"newText\":\"        const filter = taskFilter(body.get('filter'));\\n        const priorityFilter = priorityFilterValue(body.get('priorityFilter'));\\n        if (project.archived) {\\n          sendHtml(403, projectPage(project, filter, priorityFilter, 'Archived projects cannot be changed'));\\n          return;\\n        }\\n        if (parts.length\"},\n{\"oldText\":\"            sendHtml(400, projectPage(project, filter, 'Task title is required'));\\n            return;\\n          }\\n          insertTask\",\"newText\":\"            sendHtml(400, projectPage(project, filter, priorityFilter, 'Task title is required'));\\n            return;\\n          }\\n          insertTask\"},\n{\"oldText\":\"projectPage(project, filter, 'Invalid task priority')\",\"newText\":\"projectPage(project, filter, priorityFilter, 'Invalid task priority')\"},\n{\"oldText\":\"            sendHtml(400, projectPage(project, filter, 'Task title is required'));\\n            return;\\n          }\\n          if (!Number.isSafeInteger\",\"newText\":\"            sendHtml(400, projectPage(project, filter, priorityFilter, 'Task title is required'));\\n            return;\\n          }\\n          if (!Number.isSafeInteger\"},\n{\"oldText\":\"Location: `/projects/${projectId}?filter=${filter}`\",\"newText\":\"Location: projectLocation(projectId, filter, priorityFilter)\"}]}","status":"completed"}}

