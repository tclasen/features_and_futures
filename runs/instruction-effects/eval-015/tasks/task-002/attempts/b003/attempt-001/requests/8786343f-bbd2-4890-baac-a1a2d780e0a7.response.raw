data: {"type":"response.output_item.done","item":{"id":"fc_071c73c6fd4eedb7016acc2b838a6c81948cf86b308cab11e0","type":"function_call","status":"completed","arguments":"{\"path\":\"server.js\",\"edits\":[{\"oldText\":\"const listProjects = db.prepare\",\"newText\":\"db.exec(`CREATE TABLE IF NOT EXISTS tasks (\\n  id INTEGER PRIMARY KEY AUTOINCREMENT,\\n  project_id INTEGER NOT NULL REFERENCES projects(id),\\n  title TEXT NOT NULL,\\n  completed INTEGER NOT NULL DEFAULT 0 CHECK (completed IN (0, 1))\\n)`);\\nconst listTasks = db.prepare('SELECT id, title, completed FROM tasks WHERE project_id = ? ORDER BY id');\\nconst createTask = db.prepare('INSERT INTO tasks (project_id, title) VALUES (?, ?)');\\nconst updateTask = db.prepare('UPDATE tasks SET completed = ? WHERE id = ? AND project_id = ?');\\nconst listProjects = db.prepare\"},{\"oldText\":\"  .create button { margin-top: 12px; }\",\"newText\":\"  .create button { margin-top: 12px; }\\n  .filter { margin-top: 24px; }\\n  select { padding: 10px; font: inherit; }\\n  .task-check { width: 22px; height: 22px; }\\n  .task-title { flex: 1; margin: 0; overflow-wrap: anywhere; }\"},{\"oldText\":\"function html(res, status, body) {\",\"newText\":\"function taskFilter(value) {\\n  return ['All', 'Open', 'Completed'].includes(value) ? value : 'All';\\n}\\n\\nfunction projectPage(project, filter = 'All', error = '') {\\n  const rows = listTasks.all(project.id)\\n    .filter(task => filter === 'All' || Boolean(task.completed) === (filter === 'Completed'))\\n    .map(task => `<form class=\\\"row\\\" data-testid=\\\"task-row\\\" method=\\\"post\\\" action=\\\"/projects/${project.id}/tasks/${task.id}\\\">\\n      <label class=\\\"task-title\\\" for=\\\"task-${task.id}\\\">${escape(task.title)}</label>\\n      <input type=\\\"hidden\\\" name=\\\"filter\\\" value=\\\"${filter}\\\">\\n      <input class=\\\"task-check\\\" id=\\\"task-${task.id}\\\" type=\\\"checkbox\\\" name=\\\"completed\\\" value=\\\"1\\\"\\n        aria-label=\\\"Complete ${escape(task.title)}\\\" ${task.completed ? 'checked' : ''} onchange=\\\"this.form.submit()\\\">\\n    </form>`).join('');\\n  return page(`<h1>${escape(project.name)}</h1>\\n    <form action=\\\"/\\\" method=\\\"get\\\"><button type=\\\"submit\\\">Projects</button></form>\\n    ${error ? `<p role=\\\"alert\\\">${escape(error)}</p>` : ''}\\n    <form class=\\\"create\\\" action=\\\"/projects/${project.id}/tasks\\\" method=\\\"post\\\">\\n      <label for=\\\"task-title\\\">Task title</label>\\n      <input id=\\\"task-title\\\" name=\\\"title\\\" type=\\\"text\\\">\\n      <input type=\\\"hidden\\\" name=\\\"filter\\\" value=\\\"${filter}\\\">\\n      <button type=\\\"submit\\\">Create task</button>\\n    </form>\\n    <form class=\\\"filter\\\" action=\\\"/projects/${project.id}\\\" method=\\\"get\\\">\\n      <label for=\\\"task-filter\\\">Task filter</label>\\n      <select id=\\\"task-filter\\\" name=\\\"filter\\\" onchange=\\\"this.form.submit()\\\">\\n        ${['All', 'Open', 'Completed'].map(option => `<option${option === filter ? ' selected' : ''}>${option}</option>`).join('')}\\n      </select>\\n    </form>\\n    <section aria-label=\\\"Tasks\\\">${rows || '<p>No matching tasks.</p>'}</section>`);\\n}\\n\\nasync function formBody(req) {\\n  let body = '';\\n  for await (const chunk of req) {\\n    body += chunk;\\n    if (Buffer.byteLength(body) > 1024 * 1024) {\\n      const error = new Error('Request too large');\\n      error.status = 413;\\n      throw error;\\n    }\\n  }\\n  return new URLSearchParams(body);\\n}\\n\\nfunction html(res, status, body) {\"},{\"oldText\":\"      let body = '';\\n      for await (const chunk of req) {\\n        body += chunk;\\n        if (Buffer.byteLength(body) > 1024 * 1024) {\\n          return html(res, 413, page('<h1>Request too large</h1>'));\\n        }\\n      }\\n      const name = (new URLSearchParams(body).get('name') || '').trim();\",\"newText\":\"      const body = await formBody(req);\\n      const name = (body.get('name') || '').trim();\"},{\"oldText\":\"    const match = url.pathname.match(/^\\\\/projects\\\\/(\\\\d+)$/);\",\"newText\":\"    const taskMatch = url.pathname.match(/^\\\\/projects\\\\/(\\\\d+)\\\\/tasks(?:\\\\/(\\\\d+))?$/);\\n    if (req.method === 'POST' && taskMatch) {\\n      const project = findProject.get(taskMatch[1]);\\n      if (!project) return html(res, 404, page('<h1>Page not found</h1>'));\\n      const body = await formBody(req);\\n      const filter = taskFilter(body.get('filter'));\\n      if (taskMatch[2]) {\\n        const result = updateTask.run(body.get('completed') === '1' ? 1 : 0, taskMatch[2], project.id);\\n        if (!result.changes) return html(res, 404, page('<h1>Task not found</h1>'));\\n      } else {\\n        const title = (body.get('title') || '').trim();\\n        if (!title) return html(res, 422, projectPage(project, filter, 'Task title is required'));\\n        createTask.run(project.id, title);\\n      }\\n      res.writeHead(303, { Location: `/projects/${project.id}?filter=${filter}` });\\n      return res.end();\\n    }\\n    const match = url.pathname.match(/^\\\\/projects\\\\/(\\\\d+)$/);\"},{\"oldText\":\"      if (project) return html(res, 200, page(`<h1>${escape(project.name)}</h1>\\n        <form action=\\\"/\\\" method=\\\"get\\\"><button type=\\\"submit\\\">Projects</button></form>`));\",\"newText\":\"      if (project) return html(res, 200, projectPage(project, taskFilter(url.searchParams.get('filter'))));\"},{\"oldText\":\"    if (!res.headersSent) html(res, 500, page('<h1>Something went wrong</h1>'));\",\"newText\":\"    if (!res.headersSent) html(res, error.status || 500, page(`<h1>${error.status === 413 ? 'Request too large' : 'Something went wrong'}</h1>`));\"}]}","call_id":"call_QsqOSMdfKM83DqBhXHkPWkMQ","name":"edit"},"output_index":0,"sequence_number":1493}

