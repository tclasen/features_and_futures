data: {"type":"response.function_call_arguments.done","sequence_number":1028,"item_id":"fc_03443a67a91c79fa016acc3488e6cc8193a887382f278dddda","output_index":2,"arguments":"{\"path\":\"server.js\",\"edits\":[{\"oldText\":\"const setDefaultPriority = db.prepare\",\"newText\":\"// Empty dates represent tasks with no due date, including migrated tasks.\\nif (!db.prepare('PRAGMA table_info(tasks)').all().some(column => column.name === 'due_date')) {\\n  db.exec(\\\"ALTER TABLE tasks ADD COLUMN due_date TEXT NOT NULL DEFAULT ''\\\");\\n}\\nconst setTaskDueDate = db.prepare('UPDATE tasks SET due_date = ? WHERE id = ? AND project_id = ?');\\nconst setDefaultPriority = db.prepare\"},{\"oldText\":\"SELECT id, title, completed, priority FROM tasks\",\"newText\":\"SELECT id, title, completed, priority, due_date FROM tasks\"},{\"oldText\":\"function projectPage(project, filter = 'All', error = '', priority = 'All') {\",\"newText\":\"function validDueDate(value) {\\n  if (!/^\\\\d{4}-\\\\d{2}-\\\\d{2}$/.test(value)) return false;\\n  const [year, month, day] = value.split('-').map(Number);\\n  if (year < 1 || month < 1 || month > 12 || day < 1) return false;\\n  const leap = year % 4 === 0 && (year % 100 !== 0 || year % 400 === 0);\\n  const days = [31, leap ? 29 : 28, 31, 30, 31, 30, 31, 31, 30, 31, 30, 31];\\n  return day <= days[month - 1];\\n}\\n\\nfunction projectPage(project, filter = 'All', error = '', priority = 'All') {\"},{\"oldText\":\"      <form method=\\\"post\\\" action=\\\"/projects/${project.id}/tasks/${task.id}/rename\\\">\",\"newText\":\"      <form method=\\\"post\\\" action=\\\"/projects/${project.id}/tasks/${task.id}/due-date\\\">\\n        <label for=\\\"task-due-date-${task.id}\\\">Task due date</label>\\n        <input id=\\\"task-due-date-${task.id}\\\" name=\\\"dueDate\\\" type=\\\"text\\\" value=\\\"${escape(task.due_date)}\\\"${project.archived ? ' disabled' : ''}>\\n        <input type=\\\"hidden\\\" name=\\\"filter\\\" value=\\\"${filter}\\\">\\n        <input type=\\\"hidden\\\" name=\\\"priorityFilter\\\" value=\\\"${priority}\\\">\\n        <button type=\\\"submit\\\"${project.archived ? ' disabled' : ''}>Save due date</button>\\n      </form>\\n      <form method=\\\"post\\\" action=\\\"/projects/${project.id}/tasks/${task.id}/rename\\\">\"},{\"oldText\":\"    const taskRenameMatch = url.pathname.match\",\"newText\":\"    const dueDateMatch = url.pathname.match(/^\\\\/projects\\\\/(\\\\d+)\\\\/tasks\\\\/(\\\\d+)\\\\/due-date$/);\\n    if (req.method === 'POST' && dueDateMatch) {\\n      const project = findProject.get(dueDateMatch[1]);\\n      if (!project || !findTask.get(dueDateMatch[2], project.id)) {\\n        return html(res, 404, page('<h1>Task not found</h1>'));\\n      }\\n      const body = await formBody(req);\\n      const filter = taskFilter(body.get('filter'));\\n      const priority = priorityFilter(body.get('priorityFilter'));\\n      if (project.archived) return html(res, 403, projectPage(project, filter, 'Archived project cannot be changed', priority));\\n      const dueDate = (body.get('dueDate') || '').trim();\\n      if (dueDate && !validDueDate(dueDate)) {\\n        return html(res, 422, projectPage(project, filter, 'Due date must be a valid YYYY-MM-DD date', priority));\\n      }\\n      setTaskDueDate.run(dueDate, dueDateMatch[2], project.id);\\n      res.writeHead(303, { Location: `/projects/${project.id}?filter=${filter}&priorityFilter=${priority}` });\\n      return res.end();\\n    }\\n    const taskRenameMatch = url.pathname.match\"}]}"}

