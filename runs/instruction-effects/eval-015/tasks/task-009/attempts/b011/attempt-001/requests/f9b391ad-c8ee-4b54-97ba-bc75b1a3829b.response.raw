data: {"type":"response.function_call_arguments.done","sequence_number":709,"item_id":"fc_06f61324b33b945b016acc347c4fb48196b1d3232b538f2544","output_index":1,"arguments":"{\"path\":\"server.js\",\"edits\":[{\"oldText\":\"try { db.exec(\\\"ALTER TABLE tasks ADD COLUMN priority TEXT NOT NULL DEFAULT 'Normal'\\\"); } catch {}\",\"newText\":\"try { db.exec(\\\"ALTER TABLE tasks ADD COLUMN priority TEXT NOT NULL DEFAULT 'Normal'\\\"); } catch {}\\ntry { db.exec('ALTER TABLE tasks ADD COLUMN due_date TEXT'); } catch {}\"},{\"oldText\":\"const listTasks = db.prepare('SELECT id, project_id AS projectId, title, completed, priority FROM tasks WHERE project_id = ? ORDER BY id');\",\"newText\":\"const listTasks = db.prepare('SELECT id, project_id AS projectId, title, completed, priority, due_date AS dueDate FROM tasks WHERE project_id = ? ORDER BY id');\"},{\"oldText\":\"const getTask = db.prepare('SELECT id, project_id AS projectId, title, completed, priority FROM tasks WHERE id = ? AND project_id = ?');\",\"newText\":\"const getTask = db.prepare('SELECT id, project_id AS projectId, title, completed, priority, due_date AS dueDate FROM tasks WHERE id = ? AND project_id = ?');\"},{\"oldText\":\"const updatePriority = db.prepare('UPDATE tasks SET priority = ? WHERE id = ? AND project_id = ?');\",\"newText\":\"const updatePriority = db.prepare('UPDATE tasks SET priority = ? WHERE id = ? AND project_id = ?');\\nconst updateDueDate = db.prepare('UPDATE tasks SET due_date = ? WHERE id = ? AND project_id = ?');\"},{\"oldText\":\"      } else if (typeof body.title === 'string' && body.title.trim()) {\",\"newText\":\"      } else if (Object.hasOwn(body, 'dueDate') && (body.dueDate === null || typeof body.dueDate === 'string')) {\\n        const date = body.dueDate === null ? '' : body.dueDate.trim();\\n        if (date && !validDate(date)) return send(400, JSON.stringify({ error: 'Due date must be a valid YYYY-MM-DD date' }));\\n        result = updateDueDate.run(date || null, taskId, Number(taskUpdateMatch[1]));\\n      } else if (typeof body.title === 'string' && body.title.trim()) {\"},{\"oldText\":\"const port = Number(process.env.PORT || 8080);\",\"newText\":\"function validDate(value) {\\n  const match = value.match(/^(\\\\\\\\d{4})-(\\\\\\\\d{2})-(\\\\\\\\d{2})$/);\\n  if (!match) return false;\\n  const year = Number(match[1]), month = Number(match[2]), day = Number(match[3]);\\n  if (year < 1 || month < 1 || month > 12) return false;\\n  const leap = year % 4 === 0 && (year % 100 !== 0 || year % 400 === 0);\\n  const days = [31, leap ? 29 : 28, 31, 30, 31, 30, 31, 31, 30, 31, 30, 31];\\n  return day >= 1 && day <= days[month - 1];\\n}\\n\\nconst port = Number(process.env.PORT || 8080);\"}]}"}

