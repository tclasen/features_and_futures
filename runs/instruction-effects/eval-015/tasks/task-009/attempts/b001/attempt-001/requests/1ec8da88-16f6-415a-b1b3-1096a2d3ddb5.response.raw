data: {"type":"response.function_call_arguments.done","sequence_number":765,"item_id":"fc_0859540f59eb6bdb016acc34854e348190ba4e666efdeb47bc","output_index":1,"arguments":"{\"path\":\"server.js\",\"edits\":[{\"oldText\":\"const priorities = ['Low', 'Normal', 'High'];\",\"newText\":\"if (!db.prepare('PRAGMA table_info(tasks)').all().some((column) => column.name === 'due_date')) {\\n  db.exec(\\\"ALTER TABLE tasks ADD COLUMN due_date TEXT NOT NULL DEFAULT ''\\\");\\n}\\nconst priorities = ['Low', 'Normal', 'High'];\"},{\"oldText\":\"SELECT id, title, completed, priority FROM tasks\",\"newText\":\"SELECT id, title, completed, priority, due_date FROM tasks\"},{\"oldText\":\"function projectFilter(value) {\",\"newText\":\"const setTaskDueDate = db.prepare('UPDATE tasks SET due_date = ? WHERE id = ? AND project_id = ?');\\n\\nfunction validDueDate(value) {\\n  if (!/^\\\\d{4}-\\\\d{2}-\\\\d{2}$/.test(value)) return false;\\n  const [year, month, day] = value.split('-').map(Number);\\n  if (year < 1 || month < 1 || month > 12) return false;\\n  const leap = year % 4 === 0 && (year % 100 !== 0 || year % 400 === 0);\\n  const days = [31, leap ? 29 : 28, 31, 30, 31, 30, 31, 31, 30, 31, 30, 31];\\n  return day >= 1 && day <= days[month - 1];\\n}\\n\\nfunction projectFilter(value) {\"},{\"oldText\":\"          <form class=\\\"create\\\" method=\\\"post\\\" action=\\\"/projects/${project.id}/tasks/${task.id}/rename\\\">\",\"newText\":\"          <form class=\\\"create\\\" method=\\\"post\\\" action=\\\"/projects/${project.id}/tasks/${task.id}/due-date\\\">\\n            ${filterFields}\\n            <label for=\\\"task-due-date-${task.id}\\\">Task due date</label>\\n            <input id=\\\"task-due-date-${task.id}\\\" name=\\\"dueDate\\\" type=\\\"text\\\" value=\\\"${escapeHtml(task.due_date)}\\\"${project.archived ? ' disabled' : ''}>\\n            <button type=\\\"submit\\\"${project.archived ? ' disabled' : ''}>Save due date</button>\\n          </form>\\n          <form class=\\\"create\\\" method=\\\"post\\\" action=\\\"/projects/${project.id}/tasks/${task.id}/rename\\\">\"},{\"oldText\":\"(?:rename|priority)\",\"newText\":\"(?:rename|priority|due-date)\"},{\"oldText\":\"      if (action === 'priority') {\",\"newText\":\"      if (action === 'due-date') {\\n        if (!findTask.get(Number(taskId), id)) {\\n          html(response, 404, page('Not found', '<h1>Task not found</h1>'));\\n          return;\\n        }\\n        const dueDate = (form.get('dueDate') || '').trim();\\n        if (dueDate && !validDueDate(dueDate)) {\\n          html(response, 400, projectPage(project, filter, 'Due date must be a valid YYYY-MM-DD date', selectedPriority));\\n          return;\\n        }\\n        setTaskDueDate.run(dueDate, Number(taskId), id);\\n      } else if (action === 'priority') {\"}]}"}

