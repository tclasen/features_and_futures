data: {"type":"response.function_call_arguments.done","arguments":"{\"path\":\"server.js\",\"edits\":[{\"oldText\":\"  priority TEXT NOT NULL DEFAULT 'Normal' CHECK (priority IN ('Low', 'Normal', 'High'))\\n)`);\",\"newText\":\"  priority TEXT NOT NULL DEFAULT 'Normal' CHECK (priority IN ('Low', 'Normal', 'High')),\\n  due_date TEXT\\n)`);\"},{\"oldText\":\"try { db.exec(\\\"ALTER TABLE tasks ADD COLUMN priority TEXT NOT NULL DEFAULT 'Normal' CHECK (priority IN ('Low', 'Normal', 'High'))\\\"); } catch (error) { if (!String(error.message).includes('duplicate column')) throw error; }\",\"newText\":\"try { db.exec(\\\"ALTER TABLE tasks ADD COLUMN priority TEXT NOT NULL DEFAULT 'Normal' CHECK (priority IN ('Low', 'Normal', 'High'))\\\"); } catch (error) { if (!String(error.message).includes('duplicate column')) throw error; }\\ntry { db.exec('ALTER TABLE tasks ADD COLUMN due_date TEXT'); } catch (error) { if (!String(error.message).includes('duplicate column')) throw error; }\"},{\"oldText\":\"SELECT id, project_id AS projectId, title, completed, priority FROM tasks WHERE project_id = ? ORDER BY id\",\"newText\":\"SELECT id, project_id AS projectId, title, completed, priority, due_date AS dueDate FROM tasks WHERE project_id = ? ORDER BY id\"},{\"oldText\":\"      if (typeof data.title === 'string') {\\n        const title = data.title.trim();\",\"newText\":\"      if (Object.hasOwn(data, 'dueDate')) {\\n        const raw = typeof data.dueDate === 'string' ? data.dueDate.trim() : '';\\n        let dueDate = raw || null;\\n        if (dueDate !== null) {\\n          const match = dueDate.match(/^(\\\\\\\\d{4})-(\\\\\\\\d{2})-(\\\\\\\\d{2})$/);\\n          if (!match) return send(400, 'application/json; charset=utf-8', JSON.stringify({ error: 'Due date must be a valid YYYY-MM-DD date' }));\\n          const year = Number(match[1]), month = Number(match[2]), day = Number(match[3]);\\n          const date = new Date(Date.UTC(year, month - 1, day));\\n          if (year < 1 || date.getUTCFullYear() !== year || date.getUTCMonth() !== month - 1 || date.getUTCDate() !== day) return send(400, 'application/json; charset=utf-8', JSON.stringify({ error: 'Due date must be a valid YYYY-MM-DD date' }));\\n        }\\n        const result = db.prepare('UPDATE tasks SET due_date = ? WHERE id = ? AND project_id IN (SELECT id FROM projects WHERE archived = 0)').run(dueDate, id);\\n        if (!result.changes) return send(404, 'application/json; charset=utf-8', JSON.stringify({ error: 'Not found' }));\\n        return send(200, 'application/json; charset=utf-8', JSON.stringify({ ok: true, dueDate }));\\n      }\\n      if (typeof data.title === 'string') {\\n        const title = data.title.trim();\"}]}","item_id":"fc_07007f1e3e1959a1016acc347bbcc087d1b6c6302e89bc66a0","output_index":1,"sequence_number":698}

