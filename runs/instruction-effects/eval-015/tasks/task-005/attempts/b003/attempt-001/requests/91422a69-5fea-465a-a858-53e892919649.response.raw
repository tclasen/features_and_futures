data: {"type":"response.output_item.done","sequence_number":993,"output_index":2,"item":{"type":"function_call","id":"fc_0495da04456a4b3f016acc3162712c8194adc60d2d74e5df5a","call_id":"call_c7df30632e5344248f4b1c2ccc086649","name":"edit","arguments":"{\"path\":\"server.js\",\"edits\":[{\"oldText\":\"const updateTask = db.prepare('UPDATE tasks SET completed = ? WHERE id = ? AND project_id = ?');\",\"newText\":\"const updateTask = db.prepare('UPDATE tasks SET completed = ? WHERE id = ? AND project_id = ?');\\nconst renameTask = db.prepare('UPDATE tasks SET title = ? WHERE id = ? AND project_id = ?');\\nconst findTask = db.prepare('SELECT id FROM tasks WHERE id = ? AND project_id = ?');\"},{\"oldText\":\"    .map(task => `<form class=\\\"row\\\" data-testid=\\\"task-row\\\" method=\\\"post\\\" action=\\\"/projects/${project.id}/tasks/${task.id}\\\">\\n      <label class=\\\"task-title\\\" for=\\\"task-${task.id}\\\">${escape(task.title)}</label>\\n      <input type=\\\"hidden\\\" name=\\\"filter\\\" value=\\\"${filter}\\\">\\n      <input class=\\\"task-check\\\" id=\\\"task-${task.id}\\\" type=\\\"checkbox\\\" name=\\\"completed\\\" value=\\\"1\\\"\\n        aria-label=\\\"Complete ${escape(task.title)}\\\" ${task.completed ? 'checked' : ''} ${project.archived ? 'disabled' : ''} onchange=\\\"this.form.submit()\\\">\\n    </form>`).join('');\",\"newText\":\"    .map(task => `<div class=\\\"row\\\" data-testid=\\\"task-row\\\">\\n      <label class=\\\"task-title\\\" for=\\\"task-${task.id}\\\">${escape(task.title)}</label>\\n      <form method=\\\"post\\\" action=\\\"/projects/${project.id}/tasks/${task.id}\\\">\\n        <input type=\\\"hidden\\\" name=\\\"filter\\\" value=\\\"${filter}\\\">\\n        <input class=\\\"task-check\\\" id=\\\"task-${task.id}\\\" type=\\\"checkbox\\\" name=\\\"completed\\\" value=\\\"1\\\"\\n          aria-label=\\\"Complete ${escape(task.title)}\\\" ${task.completed ? 'checked' : ''} ${project.archived ? 'disabled' : ''} onchange=\\\"this.form.submit()\\\">\\n      </form>\\n      <form method=\\\"post\\\" action=\\\"/projects/${project.id}/tasks/${task.id}/rename\\\">\\n        <label for=\\\"new-task-title-${task.id}\\\">New task title</label>\\n        <input id=\\\"new-task-title-${task.id}\\\" name=\\\"title\\\" type=\\\"text\\\" value=\\\"${escape(task.title)}\\\"${project.archived ? ' disabled' : ''}>\\n        <input type=\\\"hidden\\\" name=\\\"filter\\\" value=\\\"${filter}\\\">\\n        <button type=\\\"submit\\\"${project.archived ? ' disabled' : ''}>Rename task</button>\\n      </form>\\n    </div>`).join('');\"},{\"oldText\":\"    const taskMatch = url.pathname.match(/^\\\\/projects\\\\/(\\\\d+)\\\\/tasks(?:\\\\/(\\\\d+))?$/);\",\"newText\":\"    const taskRenameMatch = url.pathname.match(/^\\\\/projects\\\\/(\\\\d+)\\\\/tasks\\\\/(\\\\d+)\\\\/rename$/);\\n    if (req.method === 'POST' && taskRenameMatch) {\\n      const project = findProject.get(taskRenameMatch[1]);\\n      if (!project || !findTask.get(taskRenameMatch[2], project.id)) {\\n        return html(res, 404, page('<h1>Task not found</h1>'));\\n      }\\n      const body = await formBody(req);\\n      const filter = taskFilter(body.get('filter'));\\n      if (project.archived) return html(res, 403, projectPage(project, filter, 'Archived project cannot be changed'));\\n      const title = (body.get('title') || '').trim();\\n      if (!title) return html(res, 422, projectPage(project, filter, 'Task title is required'));\\n      renameTask.run(title, taskRenameMatch[2], project.id);\\n      res.writeHead(303, { Location: `/projects/${project.id}?filter=${filter}` });\\n      return res.end();\\n    }\\n    const taskMatch = url.pathname.match(/^\\\\/projects\\\\/(\\\\d+)\\\\/tasks(?:\\\\/(\\\\d+))?$/);\"}]}","status":"completed"}}

