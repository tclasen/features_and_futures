:1354,"output_tokens":0},"ctco_01a12dc6-42d6-7500-a650-b8b7df7dff39":{"cache_write_tokens":0,"cached_tokens":0,"content":[{"cache_write_tokens":0,"cached_tokens":0,"input_tokens":20,"output_tokens":0},{"cache_write_tokens":0,"cached_tokens":0,"input_tokens":100,"output_tokens":0}],"input_tokens":120,"output_tokens":0},"rs_0fa44cc58c01b0fb016acc3af520b88197b58a7a2de5cc1483":{"cache_write_tokens":0,"cached_tokens":0,"input_tokens":42,"output_tokens":0},"ctc_0fa44cc58c01b0fb016acc3af682fc81978a23837815dabd59":{"cache_write_tokens":0,"cached_tokens":0,"input_tokens":68,"output_tokens":0},"ctco_01a12dc6-5d19-7a62-9cd0-5d1d11452532":{"cache_write_tokens":0,"cached_tokens":0,"content":[{"cache_write_tokens":0,"cached_tokens":0,"input_tokens":20,"output_tokens":0},{"cache_write_tokens":0,"cached_tokens":0,"input_tokens":5547,"output_tokens":0},{"cache_write_tokens":0,"cached_tokens":0,"input_tokens":869,"output_tokens":0}],"input_tokens":6436,"output_tokens":0},"rs_0fa44cc58c01b0fb016acc3afb3b388197bdaaf9a3ab3d157a":{"cache_write_tokens":0,"cached_tokens":0,"input_tokens":2,"output_tokens":70},"ctc_0fa44cc58c01b0fb016acc3afddaf4819799941f3f8d88950b":{"cache_write_tokens":0,"cached_tokens":0,"input_tokens":0,"output_tokens":3132}}},"input_tokens":39752,"input_tokens_details":{"cache_write_tokens":0,"cached_tokens":9088},"output_tokens":3202,"output_tokens_details":{"reasoning_tokens":70},"total_tokens":42954},"user":null,"metadata":{}},"sequence_number":3127}
