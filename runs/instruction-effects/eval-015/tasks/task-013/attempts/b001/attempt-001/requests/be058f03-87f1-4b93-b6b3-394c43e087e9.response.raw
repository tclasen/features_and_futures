cPath, ['server.js'], {\\n    env: { ...process.env, PORT: '0', DB_PATH: join(directory, 'db.sqlite') },\\n    stdio: ['ignore', 'pipe', 'pipe'],\\n  });\\n  try {\\n    const base = await new Promise((resolve, reject) => {\\n      child.once('error', reject);\\n      child.once('exit', () => reject(new Error('Server exited')));\\n      child.stdout.on('data', (data) => {\\n        const port = String(data).match(/port (\\\\d+)/);\\n        if (port) resolve(`http://127.0.0.1:${port[1]}`);\\n      });\\n    });\\n    const post = (path, data = {}) => fetch(base + path, {\\n      method: 'POST', body: new URLSearchParams(data), redirect: 'manual',\\n    });\\n    const get = async (path) => (await fetch(base + path)).text();\\n    const rows = (html) => [...html.matchAll(/aria-label=\\\"Complete ([^\\\"]+)\\\"/g)].map((m) => m[1]);\\n    const projects = (html) => [...html.matchAll(/data-testid=\\\"project-row\\\">\\\\s*<span>([^<]+)<\\\\/span>/g)].map((m) => m[1]);\\n    for (const name of ['Alpha  Team', 'ALPHA team', 'Älpha', 'Other']) await post('/projects', { name });\\n    assert.deepEqual(projects(await get('/?search=%20aLpHa%20')), ['Alpha  Team', 'ALPHA team']);\\n    assert.deepEqual(projects(await get('/?search=alpha%20team')), ['ALPHA team']);\\n    assert.deepEqual(projects(await get('/?search=älpha')), []);\\n    await post('/projects/2/archive', { search: 'alpha' });\\n    assert.deepEqual(projects(await get('/?search=alpha')), ['Alpha  Team']);\\n    assert.deepEqual(projects(await get('/?filter=Archived&search=alpha')), ['ALPHA team']);\\n    assert.match(await get('/?search=alpha'), /name=\\\"search\\\" value=\\\"alpha\\\"/);\\n    assert.equal(projects(await get('/')).length, 3);\\n\\n    for (const title of ['Plan  One', 'PLAN Two', 'Other', 'ÄPLAN']) await post('/projects/1/tasks', { title });\\n    await post('/projects/1/tasks/1/priority', { priority: 'High' });\\n    await post('/projects/1/tasks/1/due-date', { dueDate: '2024-02-29' });\\n    await post('/projects/1/tasks/1', { completed: '1' });\\n    assert.deepEqual(rows(await get('/projects/1?search=%20plan%20')), ['Plan  One', 'PLAN Two', 'ÄPLAN']);\\n    assert.deepEqual(rows(await get('/projects/1?search=plan%20one')), []);\\n    const state = { filter: 'Completed', priorityFilter: 'High', dueFrom: '2024-02-29', dueThrough: '2024-02-29', search: 'plan' };\\n    const location = '/projects/1?' + new URLSearchParams(state);\\n    assert.deepEqual(rows(await get(location)), ['Plan  One']);\\n    // Every edit form carries the query, while search carries the other applied filters.\\n    const html = await get(location);\\n    for (const form of html.matchAll(/<form[^>]*>([\\\\s\\\\S]*?)<\\\\/form>/g)) {\\n      if (!form[0].includes('action=\\\"/\\\"')) assert.match(form[1], /name=\\\"search\\\"[^>]*value=\\\"plan\\\"/);\\n    }\\n    for (const [endpoint, data] of [\\n      ['rename', { name: 'Renamed project' }],\\n      ['default-priority', { priority: 'Low' }],\\n      ['tasks', { title: 'Plan new' }],\\n      ['tasks/1/rename', { title: 'Plan renamed' }],\\n      ['tasks/1/due-date', { dueDate: '2024-02-29' }],\\n      ['tasks/1/priority', { priority: 'High' }],\\n      ['tasks/1', { completed: '1' }],\\n      ['due-range', { rangeFrom: '2024-02-29', rangeThrough: '2024-02-29' }],\\n    ]) {\\n      const response = await post(`/projects/1/${endpoint}`, { ...state, ...data });\\n      assert.equal(response.headers.get('location'), location);\\n    }\\n    assert.deepEqual(rows(await get(location)), ['Plan renamed']);\\n    let response = await post('/projects/1/tasks/1/rename', { ...state, title: 'No match' });\\n    assert.deepEqual(rows(await get(response.headers.get('location'))), []);\\n    response = await post('/projects/1/tasks/1/rename', { ...state, title: 'Plan returned' });\\n    assert.deepEqual(rows(await get(response.headers.get('location'))), ['Plan returned']);\\n    response = await post('/projects/1/tasks/1/move', { ...state, destination: '4' });\\n    assert.equal(response.headers.get('location'), location);\\n    assert.deepEqual(rows(await get(location)), []);\\n    await post('/projects/4/tasks/1/move', { destination: '1' });\\n    assert.deepEqual(rows(await get('/projects/1?search=plan')), ['Plan returned', 'PLAN Two', 'ÄPLAN', 'Plan new']);\\n    assert.match(await get('/'), /project-summary\\\">1\\\\/5 completed/);\\n    await post('/projects/1/archive');\\n    const archived = await get(location);\\n    assert.deepEqual(rows(archived), ['Plan returned']);\\n    assert.match(archived, /id=\\\"task-search\\\"[^>]*value=\\\"plan\\\">/);\\n    assert.match(archived, /aria-label=\\\"Complete Plan returned\\\" checked disabled/);\\n    await post('/projects/1/restore');\\n    const reopened = await get('/projects/1');\\n    assert.match(reopened, /id=\\\"task-search\\\"[^>]*value=\\\"\\\">/);\\n    assert.equal(rows(reopened).length, 5);\\n  } finally {\\n    const exited = new Promise((resolve) => child.once('exit', resolve));\\n    child.kill('SIGTERM');\\n    await exited;\\n    await rm(directory, { recursive: true, force: true });\\n  }\\n});\\n\"}","status":"completed"}],"error":null,"incomplete_details":null,"tools":[{"type":"function","name":"read","description":"Read the contents of a file. Supports text files and images (jpg, png, gif, webp, bmp). Images are sent as attachments. For text files, output is truncated to 2000 lines or 50KB (whichever is hit first). Use offset/limit for large files. When you need the full file, continue with offset until complete.","parameters":{"type":"object","required":["path","offset","limit"],"properties":{"path":{"type":"string","description":"Path to the file to read (relative or absolute)"},"offset":{"anyOf":[{"type":"number","description":"Line number to start reading from (1-indexed)"},{"type":"null"}]},"limit":{"anyOf":[{"type":"number","description":"Maximum number of lines to read"},{"type":"null"}]}},"additionalProperties":false},"output_schema":null,"strict":true},{"type":"function","name":"bash","description":"Execute a bash command in the current working directory. Returns stdout and stderr. Output is truncated to last 2000 lines or 50KB (whichever is hit first). If truncated, full output is saved to a temp file. Optionally provide a timeout in seconds.","parameters":{"type":"object","required":["command","timeout"],"properties":{"command":{"type":"string","description":"Shell command to execute"},"timeout":{"anyOf":[{"type":"number","description":"Timeout in seconds (optional, no default timeout)"},{"type":"null"}]}},"additionalProperties":false},"output_schema":null,"strict":true},{"type":"function","name":"edit","description":"Edit a single file using exact text replacement. Every edits[].oldText must match a unique, non-overlapping region of the original file. If two changes affect the same block or nearby lines, merge them into one edit instead of emitting overlapping edits. Do not include large unchanged regions just to connect distant changes.","parameters":{"type":"object","required":["path","edits"],"properties":{"path":{"type":"string","description":"Path to the file to edit (relative or absolute)"},"edits":{"type":"array","items":{"type":"object","required":["oldText","newText"],"properties":{"oldText":{"type":"string","description":"Exact text for one targeted replacement. It must be unique in the original file and must not overlap with any other edits[].oldText in the same call."},"newText":{"type":"string","description":"Replacement text for this targeted edit."}},"additionalProperties":false},"description":"One or more targeted replacements. Each edit is matched against the original file, not incrementally. Do not include overlapping or nested edits. If two changes touch the same block or nearby lines, merge them into one edit instead."}},"additionalProperties":false},"output_schema":null,"strict":true},{"type":"function","name":"write","description":"Write content to a file. Creates the file if it doesn't exist, overwrites if it does. Automatically creates parent directories.","parameters":{"type":"object","required":["path","content"],"properties":{"path":{"type":"string","description":"Path to the file to write (relative or absolute)"},"content":{"type":"string","description":"Content to write to the file"}},"additionalProperties":false},"output_schema":null,"strict":true}],"tool_choice":"auto","parallel_tool_calls":true,"prompt_cache_key":"61c40026-5b3d-42e1-8a39-109ef95bb7d8","prompt_cache_retention":"24h","text":{"format":{"type":"text"},"verbosity":"low"},"top_p":0.98,"top_logprobs":0,"temperature":1.0,"reasoning":{"effort":"medium","summary":"detailed","context":"all_turns","mode":"standard"},"user":null,"usage":{"input_tokens":15716,"input_tokens_details":{"cached_tokens":0,"cache_write_tokens":0},"output_tokens":1664,"output_tokens_details":{"reasoning_tokens":17},"total_tokens":17380,"attribution":{"items":{"fc_0421852e677bf157016acc3a9e254081979767a0c315445849":{"input_tokens":42,"cached_tokens":0,"cache_write_tokens":0,"output_tokens":0},"fc_0421852e677bf157016acc3aa14dc081979891a0e12aef244a":{"input_tokens":28,"cached_tokens":0,"cache_write_tokens":0,"output_tokens":0},"fc_0421852e677bf157016acc3aa4188c81978f7fee0d8d15a92c":{"input_tokens":28,"cached_tokens":0,"cache_write_tokens":0,"output_tokens":0},"fc_0421852e677bf157016acc3aa9171081979cd3f848092b9326":{"input_tokens":29,"cached_tokens":0,"cache_write_tokens":0,"output_tokens":0},"fc_0421852e677bf157016acc3aac7bdc81979531b648f84cd9d9":{"input_tokens":32,"cached_tokens":0,"cache_write_tokens":0,"output_tokens":0},"fc_0421852e677bf157016acc3aaf91e881978a94829bb34da166":{"input_tokens":1520,"cached_tokens":0,"cache_write_tokens":0,"output_tokens":0},"fc_0421852e677bf157016acc3ad14d408197837bc0c8d4b68170":{"input_tokens":25,"cached_tokens":0,"cache_write_tokens":0,"output_tokens":0},"fc_0421852e677bf157016acc3ad55234819792a33ff2f5b0d1f7":{"input_tokens":3571,"cached_tokens":0