tion projectListLocation(filter, search) {\\n    return `/?${new URLSearchParams({ filter, search })}`;\\n  }\\n\\n  function projectLocation(id, filter, priorityFilter, range, search = '') {\"},{\"oldText\":\"    if (range.through) query.set('rangeThrough', range.through);\",\"newText\":\"    if (range.through) query.set('rangeThrough', range.through);\\n    if (search) query.set('search', search);\"},{\"oldText\":\"sendHtml(200, projectList('', '', url.searchParams.get('filter') === 'Archived' ? 'Archived' : 'Active'));\",\"newText\":\"sendHtml(200, projectList('', '', url.searchParams.get('filter') === 'Archived' ? 'Archived' : 'Active',\\n          (url.searchParams.get('search') ?? '').trim()));\"},{\"oldText\":\"        const name = (body.get('name') ?? '').trim();\\n        if (!name) {\\n          sendHtml(400, projectList('Project name is required'));\",\"newText\":\"        const name = (body.get('name') ?? '').trim();\\n        const filter = body.get('filter') === 'Archived' ? 'Archived' : 'Active';\\n        const search = (body.get('search') ?? '').trim();\\n        if (!name) {\\n          sendHtml(400, projectList('Project name is required', '', filter, search));\"},{\"oldText\":\"response.writeHead(303, { Location: '/' });\",\"newText\":\"response.writeHead(303, { Location: projectListLocation(filter, search) });\"},{\"oldText\":\"        response.writeHead(303, { Location: action === 'restore' ? '/?filter=Archived' : '/' });\",\"newText\":\"        const body = await readForm(request);\\n        const filter = action === 'restore' ? 'Archived' : 'Active';\\n        response.writeHead(303, { Location: projectListLocation(filter, (body.get('search') ?? '').trim()) });\"},{\"oldText\":\"priorityFilterValue(url.searchParams.get('priorityFilter')), '', readRange(url.searchParams)));\",\"newText\":\"priorityFilterValue(url.searchParams.get('priorityFilter')), '', readRange(url.searchParams),\\n          (url.searchParams.get('search') ?? '').trim()));\"}