data: {"type":"response.function_call_arguments.done","sequence_number":1301,"item_id":"fc_05bc1f7c5c542594016acc3eeeb548819089bfe3af2a2ffefd","output_index":1,"arguments":"{\"path\":\"public/index.html\",\"edits\":[{\"oldText\":\"        return `<div class=\\\"task-row\\\" data-testid=\\\"task-row\\\"><input type=\\\"checkbox\\\" aria-label=\\\"Complete ${escapeHtml(task.title)}\\\" data-task-id=\\\"${task.id}\\\" ${task.completed ? 'checked' : ''} ${window.currentProjectArchived ? 'disabled' : ''}><span>${escapeHtml(task.title)}</span><form class=\\\"task-rename-form\\\" data-task-id=\\\"${task.id}\\\"><label for=\\\"new-task-title-${task.id}\\\">New task title</label><input id=\\\"new-task-title-${task.id}\\\" name=\\\"title\\\" type=\\\"text\\\" autocomplete=\\\"off\\\" ${window.currentProjectArchived ? 'disabled' : ''}><button type=\\\"submit\\\" ${window.currentProjectArchived ? 'disabled' : ''}>Rename task</button></form><label for=\\\"task-priority-${task.id}\\\">Task priority</label><select id=\\\"task-priority-${task.id}\\\" data-priority-task-id=\\\"${task.id}\\\" ${window.currentProjectArchived ? 'disabled' : ''}><option ${task.priority === 'Low' ? 'selected' : ''}>Low</option><option ${task.priority === 'Normal' ? 'selected' : ''}>Normal</option><option ${task.priority === 'High' ? 'selected' : ''}>High</option></select><form class=\\\"due-date-form\\\" data-task-id=\\\"${task.id}\\\"><label for=\\\"due-date-${task.id}\\\">Task due date</label><input id=\\\"due-date-${task.id}\\\" name=\\\"dueDate\\\" type=\\\"text\\\" value=\\\"${escapeHtml(task.dueDate || '')}\\\" ${window.currentProjectArchived ? 'disabled' : ''}><button type=\\\"submit\\\" ${window.currentProjectArchived ? 'disabled' : ''}>Save due date</button></form><label for=\\\"destination-${task.id}\\\">Destination project</label><select id=\\\"destination-${task.id}\\\" data-destination-task-id=\\\"${task.id}\\\" ${window.currentProjectArchived || destinations.length === 0 ? 'disabled' : ''}>${destinations.map(project => `<option value=\\\"${project.id}\\\">${escapeHtml(project.name)}</option>`).join('')}</select><button type=\\\"button\\\" data-move-task-id=\\\"${task.id}\\\" ${window.currentProjectArchived || destinations.length === 0 ? 'disabled' : ''}>Move task</button><form class=\\\"notes-form\\\" data-task-id=\\\"${task.id}\\\"><label for=\\\"task-notes-${task.id}\\\">Task notes</label><textarea id=\\\"task-notes-${task.id}\\\" name=\\\"notes\\\" ${window.currentProjectArchived ? 'disabled' : ''}>${escapeHtml(task.notes || '')}</textarea><button type=\\\"submit\\\" ${window.currentProjectArchived ? 'disabled' : ''}>Save notes</button></form></div>`\\n        <button type=\\\"button\\\" data-delete-task-id=\\\"${task.id}\\\" ${window.currentProjectArchived || task.deleted ? 'disabled' : ''}>Delete task</button><button type=\\\"button\\\" data-restore-task-id=\\\"${task.id}\\\" ${window.currentProjectArchived || !task.deleted ? 'disabled' : ''}>Restore task</button></div>`;\",\"newText\":\"        return `<div class=\\\"task-row\\\" data-testid=\\\"task-row\\\"><input type=\\\"checkbox\\\" aria-label=\\\"Complete ${escapeHtml(task.title)}\\\" data-task-id=\\\"${task.id}\\\" ${task.completed ? 'checked' : ''} ${locked ? 'disabled' : ''}><span>${escapeHtml(task.title)}</span><form class=\\\"task-rename-form\\\" data-task-id=\\\"${task.id}\\\"><label for=\\\"new-task-title-${task.id}\\\">New task title</label><input id=\\\"new-task-title-${task.id}\\\" name=\\\"title\\\" type=\\\"text\\\" autocomplete=\\\"off\\\" ${locked ? 'disabled' : ''}><button type=\\\"submit\\\" ${locked ? 'disabled' : ''}>Rename task</button></form><label for=\\\"task-priority-${task.id}\\\">Task priority</label><select id=\\\"task-priority-${task.id}\\\" data-priority-task-id=\\\"${task.id}\\\" ${locked ? 'disabled' : ''}><option ${task.priority === 'Low' ? 'selected' : ''}>Low</option><option ${task.priority === 'Normal' ? 'selected' : ''}>Normal</option><option ${task.priority === 'High' ? 'selected' : ''}>High</option></select><form class=\\\"due-date-form\\\" data-task-id=\\\"${task.id}\\\"><label for=\\\"due-date-${task.id}\\\">Task due date</label><input id=\\\"due-date-${task.id}\\\" name=\\\"dueDate\\\" type=\\\"text\\\" value=\\\"${escapeHtml(task.dueDate || '')}\\\" ${locked ? 'disabled' : ''}><button type=\\\"submit\\\" ${locked ? 'disabled' : ''}>Save due date</button></form><label for=\\\"destination-${task.id}\\\">Destination project</label><select id=\\\"destination-${task.id}\\\" data-destination-task-id=\\\"${task.id}\\\" ${locked || destinations.length === 0 ? 'disabled' : ''}>${destinations.map(project => `<option value=\\\"${project.id}\\\">${escapeHtml(project.name)}</option>`).join('')}</select><button type=\\\"button\\\" data-move-task-id=\\\"${task.id}\\\" ${locked || destinations.length === 0 ? 'disabled' : ''}>Move task</button><form class=\\\"notes-form\\\" data-task-id=\\\"${task.id}\\\"><label for=\\\"task-notes-${task.id}\\\">Task notes</label><textarea id=\\\"task-notes-${task.id}\\\" name=\\\"notes\\\" ${locked ? 'disabled' : ''}>${escapeHtml(task.notes || '')}</textarea><button type=\\\"submit\\\" ${locked ? 'disabled' : ''}>Save notes</button></form><button type=\\\"button\\\" data-delete-task-id=\\\"${task.id}\\\" ${window.currentProjectArchived || task.deleted ? 'disabled' : ''}>Delete task</button><button type=\\\"button\\\" data-restore-task-id=\\\"${task.id}\\\" ${window.currentProjectArchived || !task.deleted ? 'disabled' : ''}>Restore task</button></div>`;\"}]}"}

