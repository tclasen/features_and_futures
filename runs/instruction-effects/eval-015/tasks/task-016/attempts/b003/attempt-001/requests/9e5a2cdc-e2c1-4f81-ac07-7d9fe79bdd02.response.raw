data: {"type":"response.function_call_arguments.done","sequence_number":615,"item_id":"fc_08583bafccc1740b016acc3ef7ced487d18897ccfa029a10ee","output_index":1,"arguments":"{\"path\":\"server.js\",\"edits\":[{\"oldText\":\"${task.completed ? 'checked' : ''} ${project.archived ? 'disabled' : ''}\",\"newText\":\"${task.completed ? 'checked' : ''} ${project.archived || task.deleted ? 'disabled' : ''}\"},{\"oldText\":\"name=\\\"priority\\\"${project.archived ? ' disabled' : ''} onchange=\\\"this.form.submit()\\\">\\n          ${['Low'\",\"newText\":\"name=\\\"priority\\\"${project.archived || task.deleted ? ' disabled' : ''} onchange=\\\"this.form.submit()\\\">\\n          ${['Low'\"},{\"oldText\":\"value=\\\"${escape(task.due_date)}\\\"${project.archived ? ' disabled' : ''}\",\"newText\":\"value=\\\"${escape(task.due_date)}\\\"${project.archived || task.deleted ? ' disabled' : ''}\"},{\"oldText\":\"${project.archived ? ' disabled' : ''}>Save due date\",\"newText\":\"${project.archived || task.deleted ? ' disabled' : ''}>Save due date\"},{\"oldText\":\"name=\\\"notes\\\" rows=\\\"4\\\"${project.archived ? ' disabled' : ''}\",\"newText\":\"name=\\\"notes\\\" rows=\\\"4\\\"${project.archived || task.deleted ? ' disabled' : ''}\"},{\"oldText\":\"${project.archived ? ' disabled' : ''}>Save notes\",\"newText\":\"${project.archived || task.deleted ? ' disabled' : ''}>Save notes\"},{\"oldText\":\"${moveDisabled ? ' disabled' : ''}\",\"newText\":\"${moveDisabled || task.deleted ? ' disabled' : ''}\"},{\"oldText\":\"<button type=\\\"submit\\\"${moveDisabled ? ' disabled' : ''}>Move task\",\"newText\":\"<button type=\\\"submit\\\"${moveDisabled || task.deleted ? ' disabled' : ''}>Move task\"},{\"oldText\":\"value=\\\"${escape(task.title)}\\\"${project.archived ? ' disabled' : ''}\",\"newText\":\"value=\\\"${escape(task.title)}\\\"${project.archived || task.deleted ? ' disabled' : ''}\"},{\"oldText\":\"<button type=\\\"submit\\\"${project.archived ? ' disabled' : ''}>Rename task</button>\\n      </form>\",\"newText\":\"<button type=\\\"submit\\\"${project.archived || task.deleted ? ' disabled' : ''}>Rename task</button>\\n      </form>\\n      <form method=\\\"post\\\" action=\\\"/projects/${project.id}/tasks/${task.id}/${task.deleted ? 'restore' : 'delete'}\\\">\\n        <input type=\\\"hidden\\\" name=\\\"filter\\\" value=\\\"${filter}\\\">\\n        <input type=\\\"hidden\\\" name=\\\"priorityFilter\\\" value=\\\"${priority}\\\">\\n        <button type=\\\"submit\\\"${project.archived ? ' disabled' : ''}>${task.deleted ? 'Restore task' : 'Delete task'}</button>\\n      </form>\"}]}"}

