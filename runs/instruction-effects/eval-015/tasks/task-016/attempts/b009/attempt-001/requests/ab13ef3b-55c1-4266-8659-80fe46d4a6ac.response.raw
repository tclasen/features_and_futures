data: {"type":"response.completed","sequence_number":3024,"safety_buffering":false,"response":{"id":"resp_0dd68326c5c382d0016acc3f0f858887d29684eeb2f02a0acc","object":"response","created_at":1791770383,"completed_at":1791770446,"status":"completed","background":false,"frequency_penalty":0.0,"presence_penalty":0.0,"moderation":null,"model":"gpt-6.1-sol","access_programs":{"cyber":"standard"},"previous_response_id":null,"instructions":null,"output":[{"type":"reasoning","id":"rs_0dd68326c5c382d0016acc3f119a1487d28f744467b64b0154","metadata":{"turn_id":"01a12dd5-567b-7682-ab11-5c5ef6929e17"},"internal_chat_message_metadata_passthrough":{"turn_id":"01a12dd5-567b-7682-ab11-5c5ef6929e17"},"summary":[],"content":[],"encrypted_content":"gAAAAABqzD8RGhAIrGHQ2IhOfr5VHTaWr8jNkA5oVb8QVeTwz1fCG26B2DTMygkx8bV5XFIfdu1Liv3ufjP_UluOl9mhiGLiU-OH8IkA5UQrpWDnzbVbD1hVW8jmXnrmjxsAZMkjaNDHaJfYeXYZNXnyT-sdNxDXRaOAPyjznFW177OHmgTnfwJ3QnMqlMdtbAc8IFnrXXUGzNRF9MvCOXVV4QzTnJslRlFQdPhF9-Xa4tK9-NhilzIWEyV7SiPbLPm6wrozxlyjyfVEWOaU-xICopZRYjG0JC5vyShTMah4B5d2b6tEl8kwHGddiLPatC0nlbuDMcaAc4ALYB65j79WKCm5ctUGsLwRykL0oFEqQuOPTNV-DhsDQP6U5sJP-IA_mluB9hKOE-giSlegbYn0eorTN6wqP2tr57u-E4qbcxw_xrEIhu_0uWFsrBI6H0lHID2eMYzLiVvZ7GtOa9Tg5EHInlAIHZLjDtAXnSwXp89j4dwG1v6tfHiBVJNvr8uK-3z9PGTfHsWyHP_mRsMH2j_rCVz5-V-DQmsSi-dqd7HlLsDJh5359TX67sGKSTsnBRRAVBvsj4LC8F58CeJH8my4Ch5E5UxzRJ9ROHNaoXxmermKpBsPHNrpPrlzh7eg-60ydVdxAneda8e1yt2deswfEBPWuQQKYc1zjTy-2BcjgXF98T6K0Xt0gYVaHqMP5ki5291bAD6yXNMaHcvtDuAQUIZ496OX1kC-6mP8OqQ26Ywhv_R168LKsQeEXDRWVkF4_2RX5METM-pxJcO4cjkDuE85-yGfi9SZEwo8zPuUyWWCUH9oe9128vZcJWjyktHSrjzSa-uhar7RbqAw9aSHLMbCqyTePZf6-3NIvgMYCF4DTKJKfjmKVMQXclM3OfXItJi_Cq7uLsCsjrBhqNZlDsCVJOK28bj4cspXb8ibtOfQDZBvUTJu9JeyvIudvLo8e_aVnrUh6SDLT_6ReV-TWIX4FMyMQ4cXs7ucEg6wNMu9FQDB_fyFrO2ts8HH5Ul1vd5azo23QsN1eDqpditjBgEhUta_CA8dhSwGoQBCTFuWg7BzWK_2W5z5zVmgAwxsZ1K6XtN331QPIFppL530AXlxAHtYTf_z3M-RSjcX8JMbVXLEHehhrYAKYRAbtmlRG43wrA4nMZkwFlLVE4zltuxCqAuZ0y2143KtLyz1tkQ9YKkhMOklTv2ryDtE5wJH9Zv86Smd7YScbrPw9qvGxbDzLCYeE0y64czdx7VUs2wsVM0_Rccshk7I__jjBJfuz_c53C7rqlM4eNOzR5tk9dJ4ZPT4VxyPnKPVZyE0srcNPv6RVWOusG2WjIM6GqyI2pXXkARAXdygm_Sn6fI-X08JiDgcSZK8HW0vcGOIMa21unPFk6RD4stSwhc-jp_jIARIjXozJkFWJFSU-Hv6uGUOZq0rdhpYNJVTECxoS78OzTiuBTKLd1DtB8p6zZziHWOqaye6hPV0OiNXFw3D1j3bNB4kMd-qAH6tWhHjRHQBEUnY8wM2o2Vd_T3ggxhAirRK4RVU3mT3Ovt61B_9zIZnaA5wqC3TlfeP-wwIR0cvWsUknP-MoKiWo0zm1nKWEkfpdpkzeARCAhvfImyrmZMNfsVT2tlb3JLuWMRTehAOOhgXk7CJWLFRR5WvAivOfKtD"},{"type":"custom_tool_call","id":"ctc_0dd68326c5c382d0016acc3f11bfa887d2a6f417e9ba32260d","metadata":{"turn_id":"01a12dd5-567b-7682-ab11-5c5ef6929e17"},"internal_chat_message_metadata_passthrough":{"create_time":1791770385.7512403,"turn_id":"01a12dd5-567b-7682-ab11-5c5ef6929e17"},"call_id":"call_bd516a658e7046e38bf2b166ed217c24","name":"exec","input":"text(await tools.exec_command({cmd:\"cat >> test/moves.test.js <<'EOF'\\n\\ntest('deletion preserves fields, summaries and reserved positions across restore, moves and restarts', async () => {\\n  await withServer(async ({ api, taskPath, move, restart }) => {\\n    const source = await api('', 'POST', { name: 'Source' }, 201);\\n    const destination = await api('', 'POST', { name: 'Destination' }, 201);\\n    const first = await api(taskPath(source), 'POST', { title: 'First' }, 201);\\n    const second = await api(taskPath(source), 'POST', { title: 'Second' }, 201);\\n    assert.equal(first.deleted, false);\\n    const path = `${taskPath(source)}/${first.id}`;\\n    const saved = await api(path, 'PATCH', {\\n      completed: true, priority: 'High', dueDate: '0001-01-01', notes: '  Notes\\\\n日本語 <b>literal</b>  ',\\n    });\\n    const deleted = await api(`${path}/delete`, 'POST');\\n    assert.deepEqual(deleted, { ...saved, deleted: true });\\n    const summary = async (project, counts) => {\\n      const current = await api(`/${project.id}`);\\n      assert.deepEqual([current.completedCount, current.totalCount], counts);\\n      const listed = (await api('')).find(row => row.id === project.id);\\n      assert.deepEqual([listed.completedCount, listed.totalCount], counts);\\n    };\\n    await summary(source, [0, 1]);\\n    await api(`${taskPath(source)}/${second.id}/delete`, 'POST');\\n    await summary(source, [0, 0]);\\n    await api(`${taskPath(destination)}/${first.id}/restore`, 'POST', undefined, 404);\\n    await api(`${taskPath(source)}/999999/delete`, 'POST', undefined, 404);\\n    await api('/999999/tasks/1/restore', 'POST', undefined, 404);\\n    for (const edit of [{ title: 'Blocked' }, { completed: false }, { priority: 'Low' },\\n      { dueDate: '' }, { notes: '' }, { title: 'Blocked', deleted: false }]) {\\n      await api(path, 'PATCH', edit, 409);\\n    }\\n    await move(source, first, destination, 409);\\n    await api(`/${source.id}`, 'PATCH', { defaultPriority: 'Low', name: 'Renamed source', archived: true });\\n    await api(`${path}/restore`, 'POST', undefined, 409);\\n    await api(`${taskPath(source)}/${second.id}/delete`, 'POST', undefined, 409);\\n    await restart();\\n    assert.deepEqual(await api(taskPath(source)), [deleted, { ...second, deleted: true }]);\\n    await summary(source, [0, 0]);\\n    await api(`/${source.id}`, 'PATCH', { archived: false });\\n    const later = await api(taskPath(source), 'POST', { title: 'Created after deletion' }, 201);\\n    assert.equal(later.priority, 'Low');\\n    await api(`${taskPath(source)}/${second.id}/restore`, 'POST');\\n    assert.deepEqual(await api(`${path}/restore`, 'POST'), saved);\\n    assert.deepEqual(await api(taskPath(source)), [saved, second, later]);\\n    await summary(source, [1, 3]);\\n    await move(source, first, destination);\\n    const destinationPath = `${taskPath(destination)}/${first.id}`;\\n    assert.deepEqual(await api(`${destinationPath}/delete`, 'POST'), deleted);\\n    await summary(destination, [0, 0]);\\n    const arriving = await api(taskPath(destination), 'POST', { title: 'Later destination task' }, 201);\\n    await restart();\\n    assert.deepEqual(await api(`${destinationPath}/restore`, 'POST'), saved);\\n    assert.deepEqual(await api(taskPath(destination)), [saved, arriving]);\\n    await summary(destination, [1, 2]);\\n    await move(destination, first, source);\\n    assert.deepEqual(await api(taskPath(source)), [saved, second, later]);\\n    await restart();\\n    assert.deepEqual(await api(taskPath(source)), [saved, second, later]);\\n    await summary(source, [1, 3]);\\n    await summary(destination, [0, 1]);\\n  });\\n});\\n\\ntest('deletion upgrade preserves notes and independent remembered positions and initializes tasks live', async () => {\\n  await withServer(async ({ api, taskPath, move, restart }) => {\\n    const first = { id: 1 };\\n    const second = { id: 2 };\\n    const tasks = await api(taskPath(first));\\n    assert.deepEqual(tasks, [{ id: 8, title: 'Saved title', completed: true, priority: 'High',\\n      dueDate: '2024-02-29', notes: '  Existing\\\\nnotes <b>🌱</b>  ', deleted: false }]);\\n    const other = await api(taskPath(second));\\n    const path = `${taskPath(first)}/8`;\\n    await api(`${path}/delete`, 'POST');\\n    const later = await api(taskPath(first), 'POST', { title: 'Later' }, 201);\\n    await restart();\\n    assert.deepEqual(await api(`${path}/restore`, 'POST'), tasks[0]);\\n    assert.deepEqual(await api(taskPath(first)), [tasks[0], later]);\\n    await move(first, tasks[0], second);\\n    assert.deepEqual(await api(taskPath(second)), [tasks[0], ...other]);\\n  }, databasePath => {\\n    const db = new DatabaseSync(databasePath);\\n    db.exec(`CREATE TABLE projects (id INTEGER PRIMARY KEY AUTOINCREMENT, name TEXT NOT NULL,\\n      archived INTEGER NOT NULL DEFAULT 0, default_priority TEXT NOT NULL DEFAULT 'Normal');\\n      CREATE TABLE tasks (id INTEGER PRIMARY KEY AUTOINCREMENT, project_id INTEGER NOT NULL,\\n      title TEXT NOT NULL, completed INTEGER NOT NULL DEFAULT 0, priority TEXT NOT NULL DEFAULT 'Normal',\\n      due_date TEXT NOT NULL DEFAULT '', notes TEXT NOT NULL DEFAULT '', position INTEGER NOT NULL);\\n      CREATE TABLE task_positions (task_id INTEGER NOT NULL, project_id INTEGER NOT NULL,\\n      position INTEGER NOT NULL, PRIMARY KEY (task_id, project_id));\\n      INSERT INTO projects (id, name) VALUES (1, 'First'), (2, 'Second');\\n      INSERT INTO tasks VALUES (8, 1, 'Saved title', 1, 'High', '2024-02-29', '  Existing\\nnotes <b>🌱</b>  ', 5), (9, 2, 'Other', 0, 'Low', '', '', 3);\\n      INSERT INTO task_positions VALUES (8, 1, 5), (8, 2, 1), (9, 2, 3);`);\\n    db.close();\\n  });\\n});\\nEOF\\ncat >> test/filters.test.js <<'EOF'\\n\\nfunction deletionButton(row) {\\n  return row.querySelectorAll('button').find(button => ['Delete task', 'Restore task'].includes(button.textContent));\\n}\\n\\ntest('delete and restore keep filters, range and search and expose deleted rows read-only', async () => {\\n  const page = await projectPage();\\n  assert.deepEqual(page.completion.children.map(option => option.textContent), ['All', 'Open', 'Completed', 'Deleted']);\\n  const range = page.app.querySelector('#due-range');\\n  page.app.querySelector('#due-from').value = '0001-01-01';\\n  page.app.querySelector('#due-through').value = '0001-01-01';\\n  await range.trigger('submit');\\n  const search = page.app.querySelector('#task-search-form');\\n  page.app.querySelector('#task-search').value = '  SECOND\\\\t high  ';\\n  await search.trigger('submit');\\n  await page.select(page.priority, 'High');\\n  await page.select(page.completion, 'Open');\\n  const original = structuredClone(page.tasks[6]);\\n  const assertSelections = () => {\\n    assert.equal(page.priority.value, 'High');\\n    assert.equal(page.app.querySelector('#due-from').value, '0001-01-01');\\n    assert.equal(page.app.querySelector('#due-through').value, '0001-01-01');\\n    assert.equal(page.app.querySelector('#task-search').value, '  SECOND\\\\t high  ');\\n  };\\n  await deletionButton(page.rows()[0]).trigger('click');\\n  assert.deepEqual(page.titles(), []);\\n  assert.equal(page.completion.value, 'Open');\\n  assertSelections();\\n  for (const filter of ['All', 'Open', 'Completed']) {\\n    await page.select(page.completion, filter);\\n    assert.deepEqual(page.titles(), []);\\n  }\\n  await page.select(page.completion, 'Deleted');\\n  assert.deepEqual(page.titles(), ['Second high open']);\\n  assert.deepEqual(page.tasks[6], { ...original, deleted: true });\\n  const row = page.rows()[0];\\n  for (const tag of ['input', 'select', 'textarea']) {\\n    assert.ok(row.querySelectorAll(tag).every(control => control.disabled));\\n  }\\n  assert.ok(row.querySelectorAll('form').every(form => form.querySelector('button').disabled));\\n  assert.equal(deletionButton(row).textContent, 'Restore task');\\n  assert.equal(deletionButton(row).disabled, false);\\n  await page.select(page.priority, 'Low');\\n  assert.deepEqual(page.titles(), []);\\n  await page.select(page.priority, 'High');\\n  page.app.querySelector('#due-from').value = '0001-01-02';\\n  page.app.querySelector('#due-through').value = '';\\n  await range.trigger('submit');\\n  assert.deepEqual(page.titles(), []);\\n  page.app.querySelector('#due-from').value = '0001-01-01';\\n  page.app.querySelector('#due-through').value = '0001-01-01';\\n  await range.trigger('submit');\\n  page.app.querySelector('#task-search').value = 'not a match';\\n  await search.trigger('submit');\\n  assert.deepEqual(page.titles(), []);\\n  page.app.querySelector('#task-search').value = '  SECOND\\\\t high  ';\\n  await search.trigger('submit');\\n  await deletionButton(page.rows()[0]).trigger('click');\\n  assert.deepEqual(page.titles(), []);\\n  assert.equal(page.completion.value, 'Deleted');\\n  assertSelections();\\n  await page.select(page.completion, 'Open');\\n  assert.deepEqual(page.titles(), ['Second high open']);\\n  assert.deepEqual(page.tasks[6], original);\\n  assert.ok(page.rows()[0].querySelectorAll('form').every(form => !form.querySelector('button').disabled));\\n});\\n\\ntest('deletion failures leave membership intact and archived projects disable both actions', async () => {\\n  const page = await projectPage();\\n  const originalTitles = page.titles();\\n  page.rejectNext('Unable to delete');\\n  await deletionButton(page.rows()[0]).trigger('click');\\n  assert.deepEqual(page.titles(), originalTitles);\\n  assert.equal(page.tasks[0].deleted, false);\\n  assert.equal(deletionButton(page.rows()[0]).disabled, false);\\n  assert.equal(page.app.querySelector('[role=\\\"alert\\\"]').textContent, 'Unable to delete');\\n  await deletionButton(page.rows()[0]).trigger('click');\\n  await deletionButton(page.rows()[0]).trigger('click');\\n  await page.select(page.completion, 'Deleted');\\n  assert.deepEqual(page.titles(), ['Low open', 'Low done']);\\n  page.rejectNext('Unable to restore');\\n  await deletionButton(page.rows()[0]).trigger('click');\\n  assert.deepEqual(page.titles(), ['Low open', 'Low done']);\\n  await deletionButton(page.rows()[1]).trigger('click');\\n  await deletionButton(page.rows()[0]).trigger('click');\\n  await page.select(page.completion, 'All');\\n  assert.deepEqual(page.titles(), originalTitles);\\n  const archived = await projectPage(true);\\n  assert.equal(deletionButton(archived.rows()[0]).disabled, true);\\n  archived.tasks[0].deleted = true;\\n  await archived.select(archived.completion, 'Deleted');\\n  assert.deepEqual(archived.titles(), ['Low open']);\\n  assert.equal(deletionButton(archived.rows()[0]).textContent, 'Restore task');\\n  assert.ok(archived.rows()[0].querySelectorAll('button').every(button => button.disabled));\\n  const requests = archived.requests.length;\\n  await deletionButton(archived.rows()[0]).trigger('click');\\n  assert.equal(archived.requests.length, requests);\\n  for (const id of ['task-filter', 'priority-filter', 'due-range', 'task-search-form']) {\\n    const control = archived.app.querySelector(`#${id}`);\\n    assert.equal(control.disabled, false);\\n  }\\n});\\nEOF\\nnpm test\",\"max_output_tokens\":3000}));\n","status":"completed"}],"error":null,"incomplete_details":null,"tools":[{"type":"namespace","name":"functions","description":"","tools":[{"type":"function","strict":false,"name":"wait","description":"Waits on a yielded `exec` cell and returns new output or completion.\n- Use `wait` only after `exec` returns `Script running with cell ID ...`.\n- `cell_id` identifies the running `exec` cell to resume.\n- `yield_time_ms` controls how long to wait for more output before yielding again. Defaults to 10000 ms.\n- `max_tokens` limits how much new output this wait call returns. Defaults to 10000 tokens.\n- `terminate: true` stops the running cell; false or omitted waits for output.\n- `wait` returns only the new output since the last yield, or the final completion or termination result for that cell.\n- If the cell is still running, `wait` may yield again with the same `cell_id`.\n- If the cell has already finished, `wait` returns the completed result and closes the cell.","output_schema":null,"parameters":{"type":"object","properties":{"cell_id":{"type":"string","description":"Identifier of the running exec cell."},"max_tokens":{"type":"number","description":"Output token budget for this wait call. Defaults to 10000 tokens."},"terminate":{"type":"boolean","description":"True stops the running exec cell; false or omitted waits for output."},"yield_time_ms":{"type":"number","description":"Wait before yielding more output. Defaults to 10000 ms."}},"required":["cell_id"],"additionalProperties":false}},{"type":"function","strict":false,"name":"request_user_input","description":"Request user input for one to three short questions and wait for the response. This tool is only available in Plan mode.","output_schema":null,"parameters":{"type":"object","properties":{"questions":{"type":"array","description":"Questions to show the user. Prefer 1 and do not exceed 3","items":{"type":"object","properties":{"header":{"type":"string","description":"Short header label shown in the UI (12 or fewer chars)."},"id":{"type":"string","description":"Stable identifier for mapping answers (snake_case)."},"options":{"type":"array","description":"Provide 2-3 mutually exclusive choices. Put the recommended option first and suffix its label with \"(Recommended)\". Do not include an \"Other\" option in this list; the client will add a free-form \"Other\" option automatically.","items":{"type":"object","properties":{"description":{"type":"string","description":"One short sentence explaining impact/tradeoff if selected."},"label":{"type":"string","description":"User-facing label (1-5 words)."}},"required":["label","description"],"additionalProperties":false}},"question":{"type":"string","description":"Single-sentence prompt shown to the user."}},"required":["id","header","question","options"],"additionalProperties":false}}},"required":["questions"],"additionalProperties":false}},{"type":"function","strict":false,"name":"request_user_input_async","description":"Ask the user one or more questions during ongoing work. Use this tool only to request missing information, preferences, constraints, clarification, or approval. The tool returns immediately without ending the turn or waiting for a reply; any reply arrives asynchronously as a new user message. Keep questions concise, self-contained, and easy to understand, using a level of detail appropriate to the user and task. The UI always allows a free-text answer, including when suggested options are provided. A preselected option is not submitted automatically.","output_schema":null,"parameters":{"type":"object","properties":{"questions":{"type":"array","description":"One or more self-contained questions to present together, in display order.","items":{"type":"object","properties":{"options":{"type":"array","description":"Suggested answers, in display order. Put the recommended answer first; the first option is preselected by default. The user can select one option or enter a free-text answer. Do not include an Other option or a free-text placeholder; the UI provides free-text input automatically. Omit options for a free-text-only question.","items":{"type":"string"},"minItems":1},"title":{"type":"string","description":"The complete question shown to the user, including any context needed to answer it."}},"required":["title"],"additionalProperties":false},"minItems":1}},"required":["questions"],"additionalProperties":false}},{"type":"custom","name":"exec","description":"Run JavaScript code to orchestrate/compose tool calls\n- Evaluates the provided JavaScript code in a fresh V8 isolate as an async module.\n- All nested tools are available on the global `tools` object, for example `await tools.exec_command(...)`. Tool names are exposed as normalized JavaScript identifiers, for example `await tools.mcp__ologs__get_profile(...)`.\n- Nested tool methods take either a string or an object as their input argument.\n- Nested tools return either an object or a string, based on the description.\n- Runs raw JavaScript -- no Node, no file system, no network access, no console.\n- Accepts raw JavaScript source text, not JSON, quoted strings, or markdown code fences.\n- You may optionally start the tool input with a first-line pragma like `// @exec: {\"yield_time_ms\": 10000, \"max_output_tokens\": 1000}`.\n- `yield_time_ms` asks `exec` to yield early if the script is still running. Defaults to 30000 ms.\n- `max_output_tokens` sets the token budget for direct `exec` results. Defaults to 10000 tokens.\n- When the JS code is fully evaluated, the isolate's lifetime ends and unawaited promises are silently discarded.\n\n- Global helpers:\n- `exit()`: Immediately ends the current script successfully (like an early return from the top level).\n- `text(value: string | number | boolean | undefined | null)`: Appends a text item. Non-string values are stringified with `JSON.stringify(...)` when possible.\n- `image(imageUrlOrItem: string | { image_url: string; detail?: \"auto\" | \"low\" | \"high\" | \"original\" | null } | ImageContent, detail?: \"auto\" | \"low\" | \"high\" | \"original\" | null)`: Appends an image item. `image_url` should be a base64-encoded `data:` URL. To forward an MCP tool image, pass an individual `ImageContent` block from `result.content`, for example `image(result.content[0])`. MCP image blocks may request detail with `_meta: { \"codex/imageDetail\": \"original\" }`. When provided, the second `detail` argument overrides any detail embedded in the first argument.\n- `audio(audioUrlOrItem: string | { audio_url: string } | AudioContent)`: Appends an audio item. `audio_url` should be a base64-encoded `data:` URL. To forward an MCP tool audio block, pass an individual `AudioContent` block from `result.content`, for example `audio(result.content[0])`.\n- `generatedImage(result: { image_url: string; output_hint?: string })`: Appends an image-generation result and its optional output hint. HTTP(S) URLs are not supported.\n- `store(key: string, value: any)`: stores a serializable value under a string key for later `exec` calls in the same session.\n- `load(key: string)`: returns the stored value for a string key, or `undefined` if it is missing.\n- `notify(value: string | number | boolean | undefined | null)`: immediately injects an extra `custom_tool_call_output` for the current `exec` call. Values are stringified like `text(...)`.\n- `setTimeout(callback: () => void, delayMs?: number)`: schedules a callback to run later and returns a timeout id. Pending timeouts do not keep `exec` alive by themselves; await an explicit promise if you need to wait for one.\n- `clearTimeout(timeoutId?: number)`: cancels a timeout created by `setTimeout`.\n- `ALL_TOOLS`: metadata for the enabled nested tools as `{ name, description }` entries.\n- `yield_control()`: yields the accumulated output to the model immediately while the script keeps running.\n\nSome deferred nested tools may be omitted from this description. They are still available on the global `tools` object and listed in `ALL_TOOLS`.\nTo find one, filter `ALL_TOOLS` by `name` and `description`.\n\nTool availability can change between calls.\n\nShared MCP Types:\n```ts\ntype Role = \"user\" | \"assistant\";\ntype MetaObject = Record<string, unknown>;\ntype Annotations = {\n  audience?: Role[];\n  priority?: number;\n  lastModified?: string;\n};\ntype Icon = {\n  src: string;\n  mimeType?: string;\n  sizes?: string[];\n  theme?: \"light\" | \"dark\";\n};\ntype TextResourceContents = {\n  uri: string;\n  mimeType?: string;\n  _meta?: MetaObject;\n  text: string;\n};\ntype BlobResourceContents = {\n  uri: string;\n  mimeType?: string;\n  _meta?: MetaObject;\n  blob: string;\n};\ntype TextContent = {\n  type: \"text\";\n  text: string;\n  annotations?: Annotations;\n  _meta?: MetaObject;\n};\ntype ImageContent = {\n  type: \"image\";\n  data: string;\n  mimeType: string;\n  annotations?: Annotations;\n  _meta?: MetaObject;\n};\ntype AudioContent = {\n  type: \"audio\";\n  data: string;\n  mimeType: string;\n  annotations?: Annotations;\n  _meta?: MetaObject;\n};\ntype ResourceLink = {\n  icons?: Icon[];\n  name: string;\n  title?: string;\n  uri: string;\n  description?: string;\n  mimeType?: string;\n  annotations?: Annotations;\n  size?: number;\n  _meta?: MetaObject;\n  type: \"resource_link\";\n};\ntype EmbeddedResource = {\n  type: \"resource\";\n  resource: TextResourceContents | BlobResourceContents;\n  annotations?: Annotations;\n  _meta?: MetaObject;\n};\ntype ContentBlock =\n  | TextContent\n  | ImageContent\n  | AudioContent\n  | ResourceLink\n  | EmbeddedResource;\ntype CallToolResult<TStructured = { [key: string]: unknown }> = {\n  _meta?: MetaObject;\n  content: ContentBlock[];\n  isError?: boolean;\n  structuredContent?: TStructured;\n  [key: string]: unknown;\n};\n```\n\n### `apply_patch`\nThe `apply_patch` tool can be used to edit files. This is a FREEFORM tool, so do not wrap the patch in JSON.\n\nexec tool declaration:\n```ts\ndeclare const tools: { apply_patch(input: string): Promise<unknown>; };\n```\n\n### `create_goal`\nCreate a goal only when explicitly requested by the user or system/developer instructions; do not infer goals from ordinary tasks.\nSet token_budget only when an explicit token budget is requested. Fails if an unfinished goal exists; use update_goal only for status.\n\nexec tool declaration:\n```ts\ndeclare const tools: { create_goal(args: {\n  // Required. The concrete objective to start pursuing. This starts a new active goal when no goal exists or replaces the current goal when it is complete.\n  objective: string;\n  // Positive token budget for the new goal. Omit unless explicitly requested.\n  token_budget?: number;\n}): Promise<unknown>; };\n```\n\n### `exec_command`\nRuns a command in a PTY, returning output or a session ID for ongoing interaction.\n\nexec tool declaration:\n```ts\ndeclare const tools: { exec_command(args: {\n  // Shell command to execute.\n  cmd: string;\n  // User-facing approval question for `require_escalated`; omit otherwise.\n  justification?: string;\n  // True runs the shell with -l/-i semantics; false disables them. Defaults to true.\n  login?: boolean;\n  // Output token budget. Defaults to 10000 tokens; larger requests may be capped by policy.\n  max_output_tokens?: number;\n  // Reusable approval prefix for `cmd`, only with `sandbox_permissions: \"require_escalated\"`; for example [\"git\", \"pull\"].\n  prefix_rule?: Array<string>;\n  // Per-command sandbox override. Defaults to `use_default`; use `require_escalated` for unsandboxed execution.\n  sandbox_permissions?: \"use_default\" | \"require_escalated\";\n  // Shell binary to launch. Defaults to the user's default shell.\n  shell?: string;\n  // True allocates a PTY for the command; false or omitted uses plain pipes.\n  tty?: boolean;\n  // Working directory for the command. Defaults to the turn cwd.\n  workdir?: string;\n  // Wait before yielding output. Defaults to 10000 ms; effective range is 250-30000 ms.\n  yield_time_ms?: number;\n}): Promise<{\n  // Chunk identifier included when the response reports one.\n  chunk_id?: string;\n  // Process exit code when the command finished during this call.\n  exit_code?: number;\n  // Approximate token count before output truncation.\n  original_token_count?: number;\n  // Command output text, possibly truncated.\n  output: string;\n  // Session identifier to pass to write_stdin when the process is still running.\n  session_id?: number;\n  // Elapsed wall time spent waiting for output in seconds.\n  wall_time_seconds: number;\n}>; };\n```\n\n### `get_goal`\nGet the current goal for this thread, including status, budgets, token and elapsed-time usage, and remaining token budget.\n\nexec tool declaration:\n```ts\ndeclare const tools: { get_goal(args: {}): Promise<unknown>; };\n```\n\n### `list_mcp_resource_templates`\nLists resource templates provided by MCP servers. Parameterized resource templates allow servers to share data that takes parameters and provides context to language models, such as files, database schemas, or application-specific information. Prefer resource templates over web search when possible.\n\nexec tool declaration:\n```ts\ndeclare const tools: { list_mcp_resource_templates(args: {\n  // Opaque cursor from a previous list_mcp_resource_templates call; omit for the first page.\n  cursor?: string;\n  // MCP server name. Omit to list resource templates from every configured server.\n  server?: string;\n}): Promise<unknown>; };\n```\n\n### `list_mcp_resources`\nLists resources provided by MCP servers. Resources allow servers to share data that provides context to language models, such as files, database schemas, or application-specific information. Prefer resources over web search when possible.\n\nexec tool declaration:\n```ts\ndeclare const tools: { list_mcp_resources(args: {\n  // Opaque cursor from a previous list_mcp_resources call; omit for the first page.\n  cursor?: string;\n  // MCP server name. Omit to list resources from every configured server.\n  server?: string;\n}): Promise<unknown>; };\n```\n\n### `read_mcp_resource`\nRead a specific resource from an MCP server given the server name and resource URI.\n\nexec tool declaration:\n```ts\ndeclare const tools: { read_mcp_resource(args: {\n  // MCP server name exactly as configured. Must match the 'server' field returned by list_mcp_resources.\n  server: string;\n  // Resource URI to read. Must be one of the URIs returned by list_mcp_resources.\n  uri: string;\n}): Promise<unknown>; };\n```\n\n### `update_goal`\nUpdate the existing goal.\nSet status to `paused` only at the user's explicit request to pause this goal, never on your own initiative. Ask if unclear; a later resume revokes that request. Report the returned status and stop goal work. Budget limits take precedence over pausing.\nSet status to `complete` only when the objective has actually been achieved and no required work remains.\nSet status to `blocked` only when the same blocking condition has repeated for at least three consecutive goal turns, counting the original/user-triggered turn and any automatic continuations, and the agent cannot make meaningful progress without user input or an external-state change.\nIf the user resumes a goal that was previously marked `blocked`, treat the resumed run as a fresh blocked audit. If the same blocking condition then repeats for at least three consecutive resumed goal turns, set status to `blocked` again.\nOnce the blocked threshold is satisfied, do not keep reporting that you are still blocked while leaving the goal active; set status to `blocked`.\nDo not use `blocked` merely because the work is hard, slow, uncertain, incomplete, or would benefit from clarification.\nDo not mark a goal complete merely because its budget is nearly exhausted or because you are stopping work.\nYou cannot use this tool to resume, budget-limit, or usage-limit a goal; those status changes are controlled by the user or system.\nWhen marking a budgeted goal achieved with status `complete`, report the final token usage from the tool result to the user.\n\nexec tool declaration:\n```ts\ndeclare const tools: { update_goal(args: {\n  // Required. `paused` requires an explicit user request. Set to `complete` only when the objective is achieved and no required work remains. Set to `blocked` only after the same blocking condition has recurred for at least three consecutive goal turns and the agent is at an impasse. After a previously blocked goal is resumed, the resumed run starts a fresh blocked audit.\n  status: \"complete\" | \"blocked\" | \"paused\";\n}): Promise<unknown>; };\n```\n\n### `view_image`\nView a local image file from the filesystem when visual inspection is needed. Use this for images already available on disk.\n\nexec tool declaration:\n```ts\ndeclare const tools: { view_image(args: {\n  // Image detail level. Defaults to `high`; use `original` to preserve exact resolution.\n  detail?: \"high\" | \"original\";\n  // Local filesystem path to an image file.\n  path: string;\n}): Promise<{\n  // Image detail hint returned by view_image. Returns `high` for default resized behavior or `original` when original resolution is preserved.\n  detail: \"high\" | \"original\";\n  // Data URL for the loaded image.\n  image_url: string;\n}>; };\n```\n\n### `write_stdin`\nWrites characters to an existing unified exec session and returns recent output.\n\nexec tool declaration:\n```ts\ndeclare const tools: { write_stdin(args: {\n  // Bytes to write to stdin. Defaults to empty, which polls without writing.\n  chars?: string;\n  // Output token budget. Defaults to 10000 tokens; larger requests may be capped by policy.\n  max_output_tokens?: number;\n  // Identifier of the running unified exec session.\n  session_id: number;\n  // Wait before yielding output. Non-empty writes default to 250 ms and cap at 30000 ms; empty polls wait 5000-300000 ms by default.\n  yield_time_ms?: number;\n}): Promise<{\n  // Chunk identifier included when the response reports one.\n  chunk_id?: string;\n  // Process exit code when the command finished during this call.\n  exit_code?: number;\n  // Approximate token count before output truncation.\n  original_token_count?: number;\n  // Command output text, possibly truncated.\n  output: string;\n  // Session identifier to pass to write_stdin when the process is still running.\n  session_id?: number;\n  // Elapsed wall time spent waiting for output in seconds.\n  wall_time_seconds: number;\n}>; };\n```\n\n## clock\nTools for reading and waiting on time.\n\n### `clock__curr_time`\nReturn the current time in UTC.\n\nexec tool declaration:\n```ts\ndeclare const tools: { clock__curr_time(args: {}): Promise<{\n  // Current UTC time formatted as YYYY-MM-DD HH:MM:SS UTC.\n  current_time: string;\n}>; };\n```","format":{"type":"grammar","syntax":"lark","definition":"\nstart: pragma_source | plain_source\npragma_source: PRAGMA_LINE NEWLINE SOURCE\nplain_source: SOURCE\n\nPRAGMA_LINE: /[ \\t]*\\/\\/ @exec:[^\\r\\n]*/\nNEWLINE: /\\r?\\n/\nSOURCE: /[\\s\\S]+/\n"}}]},{"type":"namespace","name":"clock","description":"Tools for reading and waiting on time.","tools":[{"type":"function","strict":false,"name":"sleep","description":"Pause execution for a specified duration. The sleep ends early when new input arrives for the active turn. Returns the elapsed wall-clock time.","output_schema":null,"parameters":{"type":"object","properties":{"duration_ms":{"type":"number","description":"How long to sleep in milliseconds. Must be between 1 and 43200000."}},"required":["duration_ms"],"additionalProperties":false}}]},{"type":"namespace","name":"collaboration","description":"Tools for spawning and managing sub-agents.","tools":[{"type":"function","strict":false,"name":"followup_task","description":"Send a follow-up task to an existing non-root target agent and trigger a turn if it is idle. If the target is already running, deliver the task promptly at message boundaries while sampling, or after the pending tool call completes.","output_schema":null,"parameters":{"type":"object","properties":{"message":{"type":"string","description":"Message text to send to the target agent.","encrypted":true},"target":{"type":"string","description":"Agent id or canonical task name to send a follow-up task to (from spawn_agent)."}},"required":["target","message"],"additionalProperties":false}},{"type":"function","strict":false,"name":"interrupt_agent","description":"Interrupt an agent's current turn, if any, and return its previous status. The agent remains available for messages and follow-up tasks.","output_schema":null,"parameters":{"type":"object","properties":{"target":{"type":"string","description":"Agent id or canonical task name to interrupt (from spawn_agent)."}},"required":["target"],"additionalProperties":false}},{"type":"function","strict":false,"name":"list_agents","description":"List live agents in the current root thread tree. Optionally filter by task-path prefix.","output_schema":null,"parameters":{"type":"object","properties":{"path_prefix":{"type":"string","description":"Task-path prefix filter without a trailing slash. Omit to list all live agents."}},"additionalProperties":false}},{"type":"function","strict":false,"name":"send_message","description":"Send a message to an existing agent. The message will be delivered promptly. Does not trigger a new turn.","output_schema":null,"parameters":{"type":"object","properties":{"message":{"type":"string","description":"Message text to queue on the target agent.","encrypted":true},"target":{"type":"string","description":"Relative or canonical task name to message (from spawn_agent)."}},"required":["target","message"],"additionalProperties":false}},{"type":"function","strict":false,"name":"spawn_agent","description":"\n        Available model overrides (optional; inherited parent model is preferred):\n- `gpt-6.1-sol`: Latest workhorse model for coding and everyday work. Reasoning efforts: low (default), medium, high, xhigh, max, ultra. Service tiers: priority.\n- `gpt-6-astra`: Frontier intelligence for the most demanding work. Reasoning efforts: low (default), medium, high, xhigh, max, ultra. Service tiers: priority.\n- `gpt-6-sol`: Previous generation workhorse model. Reasoning efforts: low, medium (default), high, xhigh, max, ultra. Service tiers: priority.\n- `gpt-6-luna`: Fast and affordable model for easier tasks. Reasoning efforts: low, medium (default), high, xhigh, max. Service tiers: priority.\n- `gpt-5.6-sol`: Older generation workhorse model. Reasoning efforts: low (default), medium, high, xhigh, max, ultra. Service tiers: priority.\n        Spawns an agent to work on the specified task. If your current task is `/root/task1` and you spawn_agent with task_name \"task_3\" the agent will have canonical task name `/root/task1/task_3`.\nYou are then able to refer to this agent as `task_3` or `/root/task1/task_3` interchangeably. However an agent `/root/task2/task_3` would only be able to communicate with this agent via its canonical name `/root/task1/task_3`.\nThe spawned agent will have the same tools as you and the ability to spawn its own subagents.\n\nIt will be able to send you and other running agents messages, and its final answer will be provided to you when it finishes.\nThe new agent's canonical task name will be provided to it along with the message.\n\nNote that passing `fork_turns=\"none\"` will not pass any surrounding context to the spawned subagent, which may cause the agent to lack the context it needs to complete its task, whereas `fork_turns=\"all\"` will provide the subagent with all surrounding context.","output_schema":null,"parameters":{"type":"object","properties":{"fork_turns":{"type":"string","description":"Parent history to inherit. Defaults to `all`; use `none` to start without parent history. Only `all` and `none` are supported."},"message":{"type":"string","description":"Initial plain-text task for the new agent.","encrypted":true},"model":{"type":"string","description":"Model override for the new agent. Omit unless an explicit override is needed."},"reasoning_effort":{"type":"string","description":"Reasoning effort override for the new agent. Omit to inherit the parent effort."},"task_name":{"type":"string","description":"Task name for the new agent. Use lowercase letters, digits, and underscores."}},"required":["task_name","message"],"additionalProperties":false}},{"type":"function","strict":false,"name":"wait_agent","description":"Wait for a mailbox update from any live agent, including queued messages and final-status notifications. The wait also ends early when new user input is steered into the active turn. Does not return the content; returns either a summary of which agents have updates (if any), an interruption summary for steered input, or a timeout summary if no activity arrives before the deadline.","output_schema":null,"parameters":{"type":"object","properties":{"timeout_ms":{"type":"number","description":"Timeout in milliseconds. Defaults to 30000, min 10000, max 3600000."}},"additionalProperties":false}}]}],"tool_choice":"auto","parallel_tool_calls":false,"prompt_cache_key":"fb82b0e8-5c4a-4a93-9012-796bc1d0be68","prompt_cache_retention":"24h","text":{"format":{"type":"text"},"verbosity":"low"},"top_p":0.98,"top_logprobs":0,"temperature":1.0,"reasoning":{"effort":"medium","context":"all_turns","summary":null,"mode":"standard"},"user":null,"usage":{"input_tokens":44485,"input_tokens_details":{"cached_tokens":9088,"cache_write_tokens":0},"output_tokens":3044,"output_tokens_details":{"reasoning_tokens":13},"total_tokens":47529,"attribution":{"items":{"at_d9158481-81eb-532a-8650-772878150a05":{"input_tokens":5096,"cached_tokens":5096,"cache_write_tokens":0,"output_tokens":0},"ctc_0dd68326c5c382d0016acc3ed1ca3487d2961f8e6d84a9b2cf":{"input_tokens":122,"cached_tokens":0,"cache_write_tokens":0,"output_tokens":0},"ctc_0dd68326c5c382d0016acc3ed6c6ec87d298da650d29652ece":{"input_tokens":65,"cached_tokens":0,"cache_write_tokens":0,"output_tokens":0},"ctc_0dd68326c5c382d0016acc3eda2ad887d282ec4deef96355a9":{"input_tokens":119,"cached_tokens":0,"cache_write_tokens":0,"output_tokens":0},"ctc_0dd68326c5c382d0016acc3ee560c087d2a8e0abfac18aee6e":{"input_tokens":1238,"cached_tokens":0,"cache_write_tokens":0,"output_tokens":0},"ctc_0dd68326c5c382d0016acc3f04e48887d2b7868084f6eb8039":{"input_tokens":448,"cached_tokens":0,"cache_write_tokens":0,"output_tokens":0},"ctc_0dd68326c5c382d0016acc3f11bfa887d2a6f417e9ba32260d":{"input_tokens":0,"cached_tokens":0,"cache_write_tokens":0,"output_tokens":3031},"ctco_01a12dd5-6f0b-77b2-86fe-eabc74ad09f8":{"input_tokens":176,"cached_tokens":0,"cache_write_tokens":0,"output_tokens":0,"content":[{"input_tokens":20,"cached_tokens":0,"cache_write_tokens":0,"output_tokens":0},{"input_tokens":81,"cached_tokens":0,"cache_write_tokens":0,"output_tokens":0},{"input_tokens":75,"cached_tokens":0,"cache_write_tokens":0,"output_tokens":0}]},"ctco_01a12dd5-7c83-7c71-a731-8eba23f2ba91":{"input_tokens":10767,"cached_tokens":0,"cache_write_tokens":0,"output_tokens":0,"content":[{"input_tokens":20,"cached_tokens":0,"cache_write_tokens":0,"output_tokens":0},{"input_tokens":10747,"cached_tokens":0,"cache_write_tokens":0,"output_tokens":0}]},"ctco_01a12dd5-8fdb-7610-bda7-a24521f74b73":{"input_tokens":9323,"cached_tokens":0,"cache_write_tokens":0,"output_tokens":0,"content":[{"input_tokens":20,"cached_tokens":0,"cache_write_tokens":0,"output_tokens":0},{"input_tokens":4865,"cached_tokens":0,"cache_write_tokens":0,"output_tokens":0},{"input_tokens":4438,"cached_tokens":0,"cache_write_tokens":0,"output_tokens":0}]},"ctco_01a12dd6-173b-73c0-b219-941a1e6e97e9":{"input_tokens":2992,"cached_tokens":0,"cache_write_tokens":0,"output_tokens":0,"content":[{"input_tokens":20,"cached_tokens":0,"cache_write_tokens":0,"output_tokens":0},{"input_tokens":2972,"cached_tokens":0,"cache_write_tokens":0,"output_tokens":0}]},"ctco_01a12dd6-52d3-7591-9e94-3ef67664c25e":{"input_tokens":4070,"cached_tokens":0,"cache_write_tokens":0,"output_tokens":0,"content":[{"input_tokens":20,"cached_tokens":0,"cache_write_tokens":0,"output_tokens":0},{"input_tokens":34,"cached_tokens":0,"cache_write_tokens":0,"output_tokens":0},{"input_tokens":4016,"cached_tokens":0,"cache_write_tokens":0,"output_tokens":0}]},"msg_01a12dd5-567f-7752-862f-6731091101de":{"input_tokens":748,"cached_tokens":0,"cache_write_tokens":0,"output_tokens":0,"content":[{"input_tokens":27,"cached_tokens":0,"cache_write_tokens":0,"output_tokens":0},{"input_tokens":475,"cached_tokens":0,"cache_write_tokens":0,"output_tokens":0},{"input_tokens":67,"cached_tokens":0,"cache_write_tokens":0,"output_tokens":0},{"input_tokens":179,"cached_tokens":0,"cache_write_tokens":0,"output_tokens":0}]},"msg_01a12dd5-567f-7752-862f-674e78cedddf":{"input_tokens":534,"cached_tokens":0,"cache_write_tokens":0,"output_tokens":0,"content":[{"input_tokens":534,"cached_tokens":0,"cache_write_tokens":0,"output_tokens":0}]},"msg_01a12dd5-567f-7752-862f-675899960729":{"input_tokens":56,"cached_tokens":0,"cache_write_tokens":0,"output_tokens":0,"content":[{"input_tokens":56,"cached_tokens":0,"cache_write_tokens":0,"output_tokens":0}]},"msg_01a12dd5-567f-7752-862f-676a544cb3c8":{"input_tokens":97,"cached_tokens":0,"cache_write_tokens":0,"output_tokens":0,"content":[{"input_tokens":97,"cached_tokens":0,"cache_write_tokens":0,"output_tokens":0}]},"msg_01a12dd5-567f-7752-862f-678f0567aee1":{"input_tokens":4197,"cached_tokens":0,"cache_write_tokens":0,"output_tokens":0,"content":[{"input_tokens":4197,"cached_tokens":0,"cache_write_tokens":0,"output_tokens":0}]},"msg_0dd68326c5c382d0016acc3ed12db087d2ab5a3515cc1181c7":{"input_tokens":30,"cached_tokens":0,"cache_write_tokens":0,"output_tokens":0,"content":[{"input_tokens":30,"cached_tokens":0,"cache_write_tokens":0,"output_tokens":0}]},"msg_0dd68326c5c382d0016acc3ee324a087d29fd24150e5ec5c9a":{"input_tokens":45,"cached_tokens":0,"cache_write_tokens":0,"output_tokens":0,"content":[{"input_tokens":45,"cached_tokens":0,"cache_write_tokens":0,"output_tokens":0}]},"msg_964e58c1-b9e7-511d-b134-49bcca6a7dda":{"input_tokens":4216,"cached_tokens":3992,"cache_write_tokens":0,"output_tokens":0,"content":[{"input_tokens":4216,"cached_tokens":3992,"cache_write_tokens":0,"output_tokens":0}]},"rs_0dd68326c5c382d0016acc3ee2fed887d299a70bbe0f7484bb":{"input_tokens":51,"cached_tokens":0,"cache_write_tokens":0,"output_tokens":0},"rs_0dd68326c5c382d0016acc3f04be9487d2bce23a9f1787cd28":{"input_tokens":93,"cached_tokens":0,"cache_write_tokens":0,"output_tokens":0},"rs_0dd68326c5c382d0016acc3f119a1487d28f744467b64b0154":{"input_tokens":2,"cached_tokens":0,"cache_write_tokens":0,"output_tokens":13}}}},"tool_usage":{"image_gen":{"input_tokens":0,"output_tokens":0,"total_tokens":0,"input_tokens_details":{"text_tokens":0,"image_tokens":0},"output_tokens_details":{"image_tokens":0,"text_tokens":0}},"web_search":{"num_requests":0}},"safety_identifier":"user-ZglLa0AK1sUTDt85g9NsGTX5","store":false,"metadata":{},"max_output_tokens":null,"max_tool_calls":null,"service_tier":"default","truncation":"disabled"}}
