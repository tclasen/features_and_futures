sk.deleted?'Restore task':'Delete task');deleteButton.disabled=project.archived;deleteButton.onclick=async()=>{await fetch('/api/tasks/'+task.id,{method:'PATCH',headers:{'Content-Type':'application/json'},body:JSON.stringify({deleted:!task.deleted})});await load()};row.append(title,check,priority,dueForm,renameForm,destinationSelect,moveButton,notesForm,deleteButton);list.append(row)\"}]}"}

