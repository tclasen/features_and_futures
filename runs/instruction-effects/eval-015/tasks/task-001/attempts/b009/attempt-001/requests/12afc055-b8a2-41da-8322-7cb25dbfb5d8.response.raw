+for (const signal of ['SIGINT', 'SIGTERM']) {\\n+  process.on(signal, () => server.close(() => {\\n+    db.close();\\n+    process.exit(0);\\n+  }));\\n+}\\n*** Add File: /home/agent/work/public/index.html\\n+<!doctype html>\\n+<html lang=\\\"en\\\">\\n+  <head>\\n+    <meta charset=\\\"utf-8\\\">\\n+    <meta name=\\\"viewport\\\" content=\\\"width=device-width, initial-scale=1\\\">\\n+    <title>Workboard</title>\\n+    <link rel=\\\"stylesheet\\\" href=\\\"/style.css\\\">\\n+    <script type=\\\"module\\\" src=\\\"/app.js\\\"></script>\\n+  </head>\\n+  <body>\\n+    <main id=\\\"app\\\" aria-busy=\\\"true\\\"><p>Loading projects…</p></main>\\n+  </body>\\n+</html>\\n*** Add File: /home/agent/work/public/app.js\\n+const app = document.querySelector('#app');\\n+\\n+async function request(path, options) {\\n+  const response = await fetch(path, options);\\n+  const data = await response.json();\\n+  if (!response.ok) throw new Error(data.error || 'Unable to complete request');\\n+  return data;\\n+}\\n+\\n+function showError(container, message) {\\n+  container.textContent = message;\\n+  container.hidden = false;\\n+}\\n+\\n+function projectRow(project) {\\n+  const row = document.createElement('div');\\n+  row.className = 'project-row';\\n+  row.dataset.testid = 'project-row';\\n+  const name = document.createElement('span');\\n+  name.textContent = project.name;\\n+  const open = document.createElement('button');\\n+  open.type = 'button';\\n+  open.textContent = 'Open project';\\n+  open.addEventListener('click', () => location.assign(`/projects/${project.id}`));\\n+  row.append(name, open);\\n+  return row;\\n+}\\n+\\n+async function render() {\\n+  const match = location.pathname.match(/^\\\\/projects\\\\/(\\\\d+)$/);\\n+  if (match) {\\n+    app.innerHTML = '<button type=\\\"button\\\" id=\\\"projects\\\">Projects</button><h1></h1><p role=\\\"alert\\\" hidden></p>';\\n+    app.querySelector('#projects').addEventListener('click', () => location.assign('/'));\\n+    try {\\n+      const project = await request(`/api/projects/${match[1]}`);\\n+      app.querySelector('h1').textContent = project.name;\\n+      document.title = `${project.name} · Workboard`;\\n+    } catch (error) {\\n+      showError(app.querySelector('[role=\\\"alert\\\"]'), error.message);\\n+    }\\n+  } else {\\n+    app.innerHTML = `\\n+      <h1>Workboard</h1>\\n+      <form>\\n+        <label for=\\\"project-name\\\">Project name</label>\\n+        <div class=\\\"create-fields\\\">\\n+          <input id=\\\"project-name\\\" name=\\\"name\\\" type=\\\"text\\\" autocomplete=\\\"off\\\">\\n+          <button type=\\\"submit\\\">Create project</button>\\n+        </div>\\n+      </form>\\n+      <p role=\\\"alert\\\" hidden></p>\\n+      <section aria-label=\\\"Projects\\\" id=\\\"project-list\\\"></section>`;\\n+    const form = app.querySelector('form');\\n+    const input = app.querySelector('input');\\n+    const alert = app.querySelector('[role=\\\"alert\\\"]');\\n+    const list = app.querySelector('#project-list');\\n+    // Load the existing rows before accepting creations to preserve their order.\\n+    const button = form.querySelector('button');\\n+    button.disabled = true;\\n+    try {\\n+      const projects = await request('/api/projects');\\n+      list.append(...projects.map(projectRow));\\n+    } catch (error) {\\n+      showError(alert, error.message);\\n+      return;\\n+    } finally {\\n+      app.setAttribute('aria-busy', 'false');\\n+    }\\n+    button.disabled = false;\\n+    form.addEventListener('submit', async (event) => {\\n+      event.preventDefault();\\n+      const name = input.value.trim();\\n+      if (!name) {\\n+        showError(alert, 'Project name is required');\\n+        input.focus();\\n+        return;\\n+      }\\n+      button.disabled = true;\\n+      alert.hidden = true;\\n+      try {\\n+        const project = await request('/api/projects', {\\n+          method: 'POST',\\n+          headers: { 'Content-Type': 'application/json' },\\n+          body: JSON.stringify({ name }),\\n+        });\\n+        list.append(projectRow(project));\\n+        input.value = '';\\n+        input.focus();\\n+      } catch (error) {\\n+        showError(alert, error.message);\\n+      } finally {\\n+        button.disabled = false;\\n+      }\\n+    });\\n+  }\\n+  app.setAttribute('aria-busy', 'false');\\n+}\\n+\\n+render();\\n*** Add File: /home/agent/work/public/style.css\\n+:root { font-family: system-ui, sans-serif; color: #203047; background: #f4f6fa; }\\n+body { margin: 0; }\\n+main { max-width: 760px; margin: 64px auto; padding: 32px; background: white; border: 1px solid #d9e0eb; border-radius: 12px; }\\n+h1 { margin: 0 0 32px; font-size: 2rem; overflow-wrap: anywhere; }\\n+label { display: block; font-weight: 600; margin-bottom: 8px; }\\n+.create-fields { display: flex; gap: 12px; }\\n+input, button { font: inherit; border-radius: 6px; padding: 10px 14px; }\\n+input { flex: 1; min-width: 0; border: 1px solid #8b98ac; }\\n+button { cursor: pointer; background: #244fc4; color: white; border: 1px solid #244fc4; }\\n+button:hover { background: #193d9e; }\\n+button:disabled { opacity: .6; cursor: wait; }\\n+:focus-visible { outline: 3px solid #dc8c19; outline-offset: 3px; }\\n+[role=\\\"alert\\\"] { color: #a51d27; }\\n+#project-list { margin-top: 32px; }\\n+.project-row { display: flex; align-items: center; justify-content: space-between; gap: 20px; padding: 16px 0; border-top: 1px solid #d9e0eb; }\\n+.project-row span { overflow-wrap: anywhere; min-width: 0; }\\n+.project-row button { flex-shrink: 0; }\\n+#projects { margin-bottom: 24px; }\\n+@media (max-width: 560px) { main { margin: 20px 12px; padding: 20px; } .create-fields { flex-direction: column; } }\\n*** End Patch\"));\n","status":"completed"}}

