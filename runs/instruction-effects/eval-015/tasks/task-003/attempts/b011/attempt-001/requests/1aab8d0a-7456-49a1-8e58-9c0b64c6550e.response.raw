Project.get(Number(archiveMatch[1])))) : send(404, JSON.stringify({ error: 'Not found' }));\\n    } catch { return send(400, JSON.stringify({ error: 'Invalid request' })); }\\n  }\"},{\"oldText\":\"      if (!getProject.get(Number(taskMatch[1]))) return send(404, JSON.stringify({ error: 'Project not found' }));\",\"newText\":\"      const owner = getProject.get(Number(taskMatch[1]));\\n      if (!owner) return send(404, JSON.stringify({ error: 'Project not found' }));\\n      if (owner.archived) return send(403, JSON.stringify({ error: 'Archived project' }));\"},{\"oldText\":\"      if (typeof body.completed !== 'boolean') return send(400, JSON.stringify({ error: 'Invalid completion state' }));\\n      const result = updateTask.run\",\"newText\":\"      if (typeof body.completed !== 'boolean') return send(400, JSON.stringify({ error: 'Invalid completion state' }));\\n      const owner = getProject.get(Number(taskUpdateMatch[1]));\\n      if (!owner) return send(404, JSON.stringify({ error: 'Not found' }));\\n      if (owner.archived) return send(403, JSON.stringify({ error: 'Archived project' }));\\n      const result = updateTask.run\"}]}"}

