data: {"type":"response.function_call_arguments.done","sequence_number":851,"item_id":"fc_0d2280f148ee62b9016acc338e2c8087d1aca4fa87f5d32607","output_index":2,"arguments":"{\"path\":\"server.js\",\"edits\":[{\"oldText\":\"const listTasks = db.prepare\",\"newText\":\"// Project defaults affect only future tasks; existing task priorities stay intact.\\nif (!db.prepare('PRAGMA table_info(projects)').all().some(column => column.name === 'default_priority')) {\\n  db.exec(\\\"ALTER TABLE projects ADD COLUMN default_priority TEXT NOT NULL DEFAULT 'Normal' CHECK (default_priority IN ('Low', 'Normal', 'High'))\\\");\\n}\\nconst setDefaultPriority = db.prepare('UPDATE projects SET default_priority = ? WHERE id = ?');\\nconst listTasks = db.prepare\"},{\"oldText\":\"const createTask = db.prepare('INSERT INTO tasks (project_id, title) VALUES (?, ?)');\",\"newText\":\"const createTask = db.prepare('INSERT INTO tasks (project_id, title, priority) VALUES (?, ?, ?)');\"},{\"oldText\":\"SELECT id, name, archived FROM projects WHERE id = ?\",\"newText\":\"SELECT id, name, archived, default_priority FROM projects WHERE id = ?\"},{\"oldText\":\"    <form class=\\\"create\\\" action=\\\"/projects/${project.id}/tasks\\\" method=\\\"post\\\">\",\"newText\":\"    <form class=\\\"filter\\\" action=\\\"/projects/${project.id}/default-priority\\\" method=\\\"post\\\">\\n      <label for=\\\"default-task-priority\\\">Default task priority</label>\\n      <select id=\\\"default-task-priority\\\" name=\\\"priority\\\"${project.archived ? ' disabled' : ''} onchange=\\\"this.form.submit()\\\">\\n        ${['Low', 'Normal', 'High'].map(option => `<option${option === project.default_priority ? ' selected' : ''}>${option}</option>`).join('')}\\n      </select>\\n      <input type=\\\"hidden\\\" name=\\\"filter\\\" value=\\\"${filter}\\\">\\n      <input type=\\\"hidden\\\" name=\\\"priorityFilter\\\" value=\\\"${priority}\\\">\\n    </form>\\n    <form class=\\\"create\\\" action=\\\"/projects/${project.id}/tasks\\\" method=\\\"post\\\">\"},{\"oldText\":\"    const priorityMatch = url.pathname.match\",\"newText\":\"    const defaultPriorityMatch = url.pathname.match(/^\\\\/projects\\\\/(\\\\d+)\\\\/default-priority$/);\\n    if (req.method === 'POST' && defaultPriorityMatch) {\\n      const project = findProject.get(defaultPriorityMatch[1]);\\n      if (!project) return html(res, 404, page('<h1>Page not found</h1>'));\\n      const body = await formBody(req);\\n      const filter = taskFilter(body.get('filter'));\\n      const selectedPriority = priorityFilter(body.get('priorityFilter'));\\n      if (project.archived) return html(res, 403, projectPage(project, filter, 'Archived project cannot be changed', selectedPriority));\\n      const priority = body.get('priority');\\n      if (!['Low', 'Normal', 'High'].includes(priority)) {\\n        return html(res, 422, projectPage(project, filter, 'Invalid task priority', selectedPriority));\\n      }\\n      setDefaultPriority.run(priority, project.id);\\n      res.writeHead(303, { Location: `/projects/${project.id}?filter=${filter}&priorityFilter=${selectedPriority}` });\\n      return res.end();\\n    }\\n    const priorityMatch = url.pathname.match\"},{\"oldText\":\"createTask.run(project.id, title);\",\"newText\":\"createTask.run(project.id, title, project.default_priority);\"}]}"}

