rojects', { name: 'Third' });\\n    await post('/projects/2/rename', { name: 'Renamed destination' });\\n    await post('/projects/1/tasks', { title: 'Remaining' });\\n    await post('/projects/2/tasks', { title: 'Older destination task' });\\n    await post('/projects/2/default-priority', { priority: 'Low' });\\n    await post('/projects/1/tasks/1', { completed: '1' });\\n    await post('/projects/1/tasks/1/priority', { priority: 'High' });\\n    await post('/projects/1/tasks/1/due-date', { dueDate: '2024-02-29' });\\n    html = await get('/projects/1');\\n    const options = html.match(/name=\\\"destination\\\"[^>]*>([\\\\s\\\\S]*?)<\\\\/select>/)[1];\\n    assert.deepEqual([...options.matchAll(/<option value=\\\"(\\\\d+)\\\">([^<]+)<\\\\/option>/g)].map((m) => [m[1], m[2]]),\\n      [['2', 'Renamed destination'], ['3', 'Third']]);\\n    const state = { filter: 'Completed', priorityFilter: 'High', dueFrom: '2024-02-29', dueThrough: '2024-03-01' };\\n    let response = await post('/projects/1/tasks/1/move', { ...state, destination: '2' });\\n    assert.equal(response.status, 303);\\n    assert.equal(response.headers.get('location'), '/projects/1?' + new URLSearchParams(state));\\n    assert.deepEqual(rows(await get(response.headers.get('location'))), []);\\n    assert.deepEqual(rows(await get('/projects/1')), ['Remaining']);\\n    html = await get('/projects/2');\\n    assert.deepEqual(rows(html), ['Older destination task', 'Moved']);\\n    assert.match(html, /aria-label=\\\"Complete Moved\\\" checked/);\\n    assert.match(html, /<option selected>High<\\\\/option>/);\\n    assert.match(html, /name=\\\"dueDate\\\" type=\\\"text\\\" value=\\\"2024-02-29\\\"/);\\n    assert.match(await get('/'), /project-summary\\\">1\\\\/2 completed/);\\n    await post('/projects/1/tasks', { title: 'New source task' });\\n    await post('/projects/2/tasks', { title: 'New destination task' });\\n    assert.deepEqual(rows(await get('/projects/2')), ['Older destination task', 'Moved', 'New destination task']);\\n    await post('/projects/3/archive');\\n    assert.equal((await post('/projects/2/tasks/1/move', { destination: '3' })).status, 400);\\n    assert.equal((await post('/projects/2/tasks/1/move', { destination: '2' })).status, 400);\\n    assert.equal((await post('/projects/1/tasks/1/move', { destination: '2' })).status, 404);\\n    await post('/projects/2/archive');\\n    html = await get('/projects/2');\\n    assert.match(html, /name=\\\"destination\\\" disabled/);\\n    assert.match(html, /disabled>Move task/);\\n    assert.equal((await post('/projects/2/tasks/1/move', { destination: '1' })).status, 403);\\n    await post('/projects/2/restore');\\n    await stop();\\n    await start();\\n    html = await get('/projects/2');\\n    assert.deepEqual(rows(html), ['Older destination task', 'Moved', 'New destination task']);\\n    assert.match(html, /aria-label=\\\"Complete Moved\\\" checked/);\\n    assert.match(html, /value=\\\"2024-02-29\\\"/);\\n    await post('/projects/2/tasks/1/move', { destination: '1' });\\n    assert.deepEqual(rows(await get('/projects/1')), ['Remaining', 'New source task', 'Moved']);\\n    await post('/projects/2/tasks/3/move', { destination: '1' });\\n    html = await get('/projects/1');\\n    assert.deepEqual(rows(html), ['Remaining', 'New source task', 'Moved', 'Older destination task']);\\n    assert.match(html, /id=\\\"task-due-date-3\\\" name=\\\"dueDate\\\" type=\\\"text\\\" value=\\\"\\\"/);\\n    await stop();\\n    await start();\\n    assert.deepEqual(rows(await get('/projects/1')), ['Remaining', 'New source task', 'Moved', 'Older destination task']);\\n  } finally {\\n    if (child) await stop();\\n    await rm(directory, { recursive: true, force: true });\\n  }\\n});\\n\"}","status":"completed"}],"error":null,"incomplete_details":null,"tools":[{"type":"function","name":"read","description":"Read the contents of a file. Supports text files and images (jpg, png, gif, webp, bmp). Images are sent as attachments. For text files, output is truncated to 2000 lines or 50KB (whichever is hit first). Use offset/limit for large files. When you need the full file, continue with offset until complete.","parameters":{"type":"object","required":["path","offset","limit"],"properties":{"path":{"type":"string","description":"Path to the file to read (relative or absolute)"},"offset":{"anyOf":[{"type":"number","description":"Line number to start reading from (1-indexed)"},{"type":"null"}]},"limit":{"anyOf":[{"type":"number","description":"Maximum number of lines to read"},{"type":"null"}]}},"additionalProperties":false},"output_schema":null,"strict":true},{"type":"function","name":"bash","description":"Execute a bash command in the current working directory. Returns stdout and stderr. Output is truncated to last 2000 lines or 50KB (whichever is hit first). If truncated, full output is saved to a temp file. Optionally provide a timeout in seconds.","parameters":{"type":"object","required":["command","timeout"],"properties":{"command":{"type":"string","description":"Shell command to execute"},"timeout":{"anyOf":[{"type":"number","description":"Timeout in seconds (optional, no default timeout)"},{"type":"null"}]}},"additionalProperties":false},"output_schema":null,"strict":true},{"type":"function","name":"edit","description":"Edit a single file using exact text replacement. Every edits[].oldText must match a unique, non-overlapping region of the original file. If two changes affect the same block or nearby lines, merge them into one edit instead of emitting overlapping edits. Do not include large unchanged regions just to connect distant changes.","parameters":{"type":"object","required":["path","edits"],"properties":{"path":{"type":"string","description":"Path to the file to edit (relative or absolute)"},"edits":{"type":"array","items":{"type":"object","required":["oldText","newText"],"properties":{"oldText":{"type":"string","description":"Exact text for one targeted replacement. It must be unique in the original file and must not overlap with any other edits[].oldText in the same call."},"newText":{"type":"string","description":"Replacement text for this targeted edit."}},"additionalProperties":false},"description":"One or more targeted replacements. Each edit is matched against the original file, not incrementally. Do not include overlapping or nested edits. If two changes touch the same block or nearby lines, merge them into one edit instead."}},"additionalProperties":false},"output_schema":null,"strict":true},{"type":"function","name":"write","description":"Write content to a file. Creates the file if it doesn't exist, overwrites if it does. Automatically creates parent directories.","parameters":{"type":"object","required":["path","content"],"properties":{"path":{"type":"string","description":"Path to the file to write (relative or absolute)"},"content":{"type":"string","description":"Content to write to the file"}},"additionalProperties":false},"output_schema":null,"strict":true}],"tool_choice":"auto","parallel_tool_calls":true,"prompt_cache_key":"de6d16a0-6423-49c5-98d1-2d19283bb08c","prompt_cache_retention":"24h","text":{"format":{"type":"text"},"verbosity":"low"},"top_p":0.98,"top_logprobs":0,"temperature":1.0,"reasoning":{"effort":"medium","summary":"detailed","context":"all_turns","mode":"standard"},"user":null,"usage":{"input_tokens":13207,"input_tokens_details":{"cached_tokens":0,"cache_write_tokens":0},"output_tokens":1668,"output_tokens_details":{"reasoning_tokens":26},"total_tokens":14875,"attribution":{"items":{"fc_0c9cabb3f1a4c4e2016acc36ff8d5881939ef6382bb7fa6ddb":{"input_tokens":34,"cached_tokens":0,"cache_write_tokens":0,"output_tokens":0},"fc_0c9cabb3f1a4c4e2016acc37021ea081939b7cae9daf221d7e":{"input_tokens":28,"cached_tokens":0,"cache_write_tokens":0,"output_tokens":0},"fc_0c9cabb3f1a4c4e2016acc3704d20081938a6058a52684016d":{"input_tokens":28,"cached_tokens":0,"cache_write_tokens":0,"output_tokens":0},"fc_0c9cabb3f1a4c4e20