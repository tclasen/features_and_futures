`Restore visible tasks` restores matching deleted tasks only under Active scope and Deleted. Both resolve all current filters/search/range on the server and update flags atomically across original owners. Controls are disabled outside their eligible scope/filter or for empty results, and direct requests enforce the same scope/filter restrictions. Actions retain directory ordering and all controls, refresh task and owner rows, totals and eligibility, and preserve every other field, original identity and reserved position. Project summaries exclude deleted tasks; restored tasks regain their reserved order even after later creation or moves. Duplicate owner names remain independent. Integration tests cover all live filters, exact field preservation, nonmatching and archived protection, empty results, independent same-name owners, exports, moves/returns and real process restarts.\\n\\n`Directory order` offers Original,\"}]}","status":"completed"}],"error":null,"incomplete_details":null,"tools":[{"type":"function","name":"read","description":"Read the contents of a file. Supports text files and images (jpg, png, gif, webp, bmp). Images are sent as attachments. For text files, output is truncated to 2000 lines or 50KB (whichever is hit first). Use offset/limit for large files. When you need the full file, continue with offset until complete.","parameters":{"type":"object","required":["path","offset","limit"],"properties":{"path":{"type":"string","description":"Path to the file to read (relative or absolute)"},"offset":{"anyOf":[{"type":"number","description":"Line number to start reading from (1-indexed)"},{"type":"null"}]},"limit":{"anyOf":[{"type":"number","description":"Maximum number of lines to read"},{"type":"null"}]}},"additionalProperties":false},"output_schema":null,"strict":true},{"type":"function","name":"bash","description":"Execute a bash command in the current working directory. Returns stdout and stderr. Output is truncated to last 2000 lines or 50KB (whichever is hit first). If truncated, full output is saved to a temp file. Optionally provide a timeout in seconds.","parameters":{"type":"object","required":["command","timeout"],"properties":{"command":{"type":"string","description":"Shell command to execute"},"timeout":{"anyOf":[{"type":"number","description":"Timeout in seconds (optional, no default timeout)"},{"type":"null"}]}},"additionalProperties":false},"output_schema":null,"strict":true},{"type":"function","name":"edit","description":"Edit a single file using exact text replacement. Every edits[].oldText must match a unique, non-overlapping region of the original file. If two changes affect the same block or nearby lines, merge them into one edit instead of emitting overlapping edits. Do not include large unchanged regions just to connect distant changes.","parameters":{"type":"object","required":["path","edits"],"properties":{"path":{"type":"string","description":"Path to the file to edit (relative or absolute)"},"edits":{"type":"array","items":{"type":"object","required":["oldText","newText"],"properties":{"oldText":{"type":"string","description":"Exact text for one targeted replacement. It must be unique in the original file and must not overlap with any other edits[].oldText in the same call."},"newText":{"type":"string","description":"Replacement text for this targeted edit."}},"additionalProperties":false},"description":"One or more targeted replacements. Each edit is matched against the original file, not incrementally. Do not include overlapping or nested edits. If two changes touch the same block or nearby lines, merge them into one edit instead."}},"additionalProperties":false},"output_schema":null,"strict":true},{"type":"function","name":"write","description":"Write content to a file. Creates the file if it doesn't exist, overwrites if it does. Automatically creates parent directories.","parameters":{"type":"object","required":["path","content"],"properties":{"path":{"type":"string","description":"Path to the file to write (relative or absolute)"},"content":{"type":"string","description":"Content to write to the file"}},"additionalProperties":false},"output_schema":null,"strict":true}],"tool_choice":"auto","parallel_tool_calls":true,"prompt_cache_key":"0215c8d2-f27c-4726-a664-4df2e60ab560","prompt_cache_retention":"24h","text":{"format":{"type":"text"},"verbosity":"low"},"top_p":0.98,"top_logprobs":0,"temperature":1.0,"reasoning":{"effort":"medium","summary":"detailed","context":"all_turns","mode":"standard"},"user":null,"usage":{"input_tokens":36557,"input_tokens_details":{"cached_tokens":0,"cache_write_tokens":0},"output_tokens":284,"output_tokens_details":{"reasoning_tokens":27},"total_tokens":36841,"attribution":{"items":{"fc_06c7cccdf15eb6f8016acbd85923c88197afc25c8306204032":{"input_tokens":42,"cached_tokens":0,"cache_write_tokens":0,"output_tokens":0},"fc_06c7cccdf15eb6f8016acbd85cdef08197b4435fd4ef5b0d13":{"input_tokens":28,"cached_tokens":0,"cache_write_tokens":0,"output_tokens":0},"fc_06c7cccdf15eb6f8016acbd85f5f008197a3d52a3e45681358":{"input_tokens":57,"cached_tokens":0,"cache_write_tokens":0,"output_tokens":0},"fc_06c7cccdf15eb6f8016acbd86541c08197a0b710cbafff8e9f":{"input_tokens":42,"cached_tokens":0,"cache_write_tokens":0,"output_tokens":0},"fc_06c7cccdf15eb6f8016acbd86747d08197981a069906c0b77c":{"input_tokens":25,"cached_tokens":0,"cache_write_tokens":0,"output_tokens":0},"fc_06c7cccdf15eb6f8016acbd86747d08197996a1c507cc0fd0a":{"input_tokens":24,"cached_tokens":0,"cache_write_tokens":0,"output_tokens":0},"fc_06c7cccdf15eb6f8016acbd86747d081979c3d91c71fb73080":{"input_tokens":27,"cached_tokens":0,"cache_write_tokens":0,"output_tokens":0},"fc_06c7cccdf15eb6f8016acbd86dc8b881978ccfe7d1cf1c9bd1":{"input_tokens":305,"cached_tokens":0,"cache_write_tokens":0,"output_tokens":0},"fc_06c7cccdf15eb6f8016acbd876130c8197a75f1c0eefcc8952":{"input_tokens":309,"cached_tokens":0,"cache_write_tokens":0,"output_tokens":0},"fc_06c7cccdf15eb6f8016acbd87e427081979cd