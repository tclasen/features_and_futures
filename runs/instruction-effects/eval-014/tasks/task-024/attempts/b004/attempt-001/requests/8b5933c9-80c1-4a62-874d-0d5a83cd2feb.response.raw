&(pf.value==='All'||x.priority===pf.value)&&normalizeSearch(x.title).includes(q)&&(!range.from&&!range.through||Boolean(x.due_date)&&(!range.from||x.due_date>=range.from)&&(!range.through||x.due_date<=range.through))&&(completed? !x.completed:x.completed)).map(x=>x.id);const response=await fetch('/api/directory/bulk',{method:'PATCH',headers:{'content-type':'application/json'},body:JSON.stringify({ids,completed})});\",\"newText\":\"async function bulk(completed){const q=normalizeSearch(query);const ids=all.filter(x=>!x.archived&&!x.deleted&&(tf.value==='All'||(tf.value==='Completed')===Boolean(x.completed))&&(pf.value==='All'||x.priority===pf.value)&&normalizeSearch(x.title).includes(q)&&(!range.from&&!range.through||Boolean(x.due_date)&&(!range.from||x.due_date>=range.from)&&(!range.through||x.due_date<=range.through))&&(completed? !x.completed:x.completed)).map(x=>x.id);const response=await fetch('/api/directory/bulk',{method:'PATCH',headers:{'content-type':'application/json'},body:JSON.stringify({ids,completed})});\"},{\"oldText\":\"document.getElementById('complete-visible').onclick=()=>bulk(true);document.getElementById('reopen-visible').onclick=()=>bulk(false);\",\"newText\":\"document.getElementById('complete-visible').onclick=()=>bulk(true);document.getElementById('reopen-visible').onclick=()=>bulk(false);async function changeDeleted(deleted){const ids=all.filter(x=>!x.archived&&Boolean(x.deleted)!==deleted&&(tf.value==='Deleted'?Boolean(x.deleted):!x.deleted)&&(scope.value==='Archived')===Boolean(x.archived)&&(pf.value==='All'||x.priority===pf.value)&&normalizeSearch(x.title).includes(normalizeSearch(query))&&(!range.from&&!range.through||Boolean(x.due_date)&&(!range.from||x.due_date>=range.from)&&(!range.through||x.due_date<=range.through))).map(x=>x.id);const response=await fetch('/api/directory/bulk',{method:'PATCH',headers:{'content-type':'application/json'},body:JSON.stringify({ids,deleted})});if(!response.ok)return;const fresh=await(await fetch('/api/directory')).json();all.splice(0,all.length,...fresh);draw()}document.getElementById('delete-visible').onclick=()=>changeDeleted(true);document.getElementById('restore-visible').onclick=()=>changeDeleted(false);\"},{\"oldText\":\"if (req.method === 'PATCH' && url.pathname === '/api/directory/bulk') { try { const b=await readBody(req); if(!Array.isArray(b.ids)||typeof b.completed!=='boolean')return send(res,400,{error:'Invalid request'}); const update=db.prepare('UPDATE tasks SET completed=? WHERE id=? AND deleted=0 AND project_id IN (SELECT id FROM projects WHERE archived=0)'); db.exec('BEGIN'); try { for(const id of new Set(b.ids)) if(Number.isInteger(id)) update.run(b.completed?1:0,id); db.exec('COMMIT'); } catch(e){db.exec('ROLLBACK');throw e;} return send(res,200,{status:'ok'}); } catch { return send(res,400,{error:'Invalid request'}); } }\",\"newText\":\"if (req.method === 'PATCH' && url.pathname === '/api/directory/bulk') { try { const b=await readBody(req); if(!Array.isArray(b.ids))return send(res,400,{error:'Invalid request'}); const completion=typeof b.completed==='boolean', deletion=typeof b.deleted==='boolean'; if(completion===deletion)return send(res,400,{error:'Invalid request'}); const update=completion?db.prepare('UPDATE tasks SET completed=? WHERE id=? AND deleted=0 AND project_id IN (SELECT id FROM projects WHERE archived=0)'):db.prepare('UPDATE tasks SET deleted=? WHERE id=? AND project_id IN (SELECT id FROM projects WHERE archived=0)'); db.exec('BEGIN'); try { for(const id of new Set(b.ids)) if(Number.isInteger(id)) update.run((completion?b.completed:b.deleted)?1:0,id); db.exec('COMMIT'); } catch(e){db.exec('ROLLBACK');throw e;} return send(res,200,{status:'ok'}); } catch { return send(res,400,{error:'Invalid request'}); } }\"}]}","status":"completed"}],"error":null,"incomplete_details":null,"tools":[{"type":"function","name":"read","description":"Read the contents of a file. Supports text files and images (jpg, png, gif, webp, bmp). Images are sent as attachments. For text files, output is truncated to 2000 lines or 50KB (whichever is hit first). Use offset/limit for large files. When you need the full file, continue with offset until complete.","parameters":{"type":"object","required":["path","offset","limit"],"properties":{"path":{"type":"string","description":"Path to the file to read (relative or absolute)"},"offset":{"anyOf":[{"type":"number","description":"Line number to start reading from (1-indexed)"},{"type":"null"}]},"limit":{"anyOf":[{"type":"number","description":"Maximum number of lines to read"},{"type":"null"}]}},"additionalProperties":false},"output_schema":null,"strict":true},{"type":"function","name":"bash","description":"Execute a bash command in the current working directory. Returns stdout and stderr. Output is truncated to last 2000 lines or 50KB (whichever is hit first). If truncated, full output is saved to a temp file. Optionally provide a timeout in seconds.","parameters":{"type":"object","required":["command","timeout"],"properties":{"command":{"type":"string","description":"Shell command to execute"},"timeout":{"anyOf":[{"type":"number","description":"Timeout in seconds (optional, no default timeout)"},{"type":"null"}]}},"additionalProperties":false},"output_schema":null,"strict":true},{"type":"function","name":"edit","description":"Edit a single file using exact text replacement. Every edits[].oldText must match a unique, non-overlapping region of the original file. If two changes affect the same block or nearby lines, merge them into one edit instead of emitting overlapping edits. Do not include large unchanged regions just to connect distant changes.","parameters":{"type":"object","required":["path","edits"],"properties":{"path":{"type":"string","description":"Path to the file to edit (relative or absolute)"},"edits":{"type":"array","items":{"type":"object","required":["oldText","newText"],"properties":{"oldText":{"type":"string","description":"Exact text for one targeted replacement. It must be unique in the original file and must not overlap with any other edits[].oldText in the same call."},"newText":{"type":"string","description":"Replacement text for this targeted edit."}},"additionalProperties":false},"description":"One or more targeted replacements. Each edit is matched against the original file, not incrementally. Do not include overlapping or nested edits. If two changes touch the same block or nearby lines, merge them into one edit instead."}},"additionalProperties":false},"output_schema":null,"strict":true},{"type":"function","name":"write","description":"Write content to a file. Creates the file if it doesn't exist, overwrites if it does. Automatically creates parent directories.","parameters":{"type":"object","required":["path","content"],"properties":{"path":{"type":"string","description":"Path to the file to write (relative or absolute)"},"content":{"type":"string","description":"Content to write to the file"}},"additionalProperties":false},"output_schema":null,"strict":true}],"tool_choice":"auto","parallel_tool_calls":true,"prompt_cache_key":"b1c409cd-1ace-40c3-81a8-0e36bdfbfa45","prompt_cache_retention":"24h","text":{"format":{"type":"text"},"verbosity":"low"},"top_p":0.98,"top_logprobs":0,"temperature":1.0,"reasoning":{"effort":"medium","summary":"detailed","context":"all_turns","mode":"standard"},"user":null,"usage":{"input_tokens":18468,"input_tokens_details":{"cached_tokens":0,"cache_write_tokens":0},"output_tokens":1447,"output_tokens_details":{"reasoning_tokens":89},"total_tokens":19915,"attribution":{"items":{"fc_0b8f447ab6117547016acbd8535590819784622c11a07570e8":{"input_tokens":72,"cached_tokens":0,"cache_write_tokens":0,"output_tokens":0},"fc_0b8f447ab6117547016acbd8556f408197bad242dfbbe311ee":{"input_tokens":29,"cached_tokens":0,"cache_write_tokens":0,"output_tokens":0},"fc_0b8f447ab6117547016acbd855fb708197942610bd1778d036":{"input_tokens":10134,"cached_tokens":0,"cache_write_tokens":0,"output_tokens":0,"conte