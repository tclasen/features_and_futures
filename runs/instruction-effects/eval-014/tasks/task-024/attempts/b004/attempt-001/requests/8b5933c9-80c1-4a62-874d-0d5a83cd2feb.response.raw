ate<=range.through))&&(completed? !x.completed:x.completed)).map(x=>x.id);const response=await fetch('/api/directory/bulk',{method:'PATCH',headers:{'content-type':'application/json'},body:JSON.stringify({ids,completed})});\",\"newText\":\"async function bulk(completed){const q=normalizeSearch(query);const ids=all.filter(x=>!x.archived&&!x.deleted&&(tf.value==='All'||(tf.value==='Completed')===Boolean(x.completed))&&(pf.value==='All'||x.priority===pf.value)&&normalizeSearch(x.title).includes(q)&&(!range.from&&!range.through||Boolean(x.due_date)&&(!range.from||x.due_date>=range.from)&&(!range.through||x.due_date<=range.through))&&(completed? !x.completed:x.completed)).map(x=>x.id);const response=await fetch('/api/directory/bulk',{method:'PATCH',headers:{'content-type':'application/json'},body:JSON.stringify({ids,completed})});\"},{\"oldText\":\"document.getElementById('complete-visible').onclick=()=>bulk(true);document.getElementById('reopen-visible').onclick=()=>bulk(false);\",\"newText\":\"document.getElementById('complete-visible').onclick=()=>bulk(true);document.getElementById('reopen-visible').onclick=()=>bulk(false);async function changeDeleted(deleted){const ids=all.filter(x=>!x.archived&&Boolean(x.deleted)!==deleted&&(tf.value==='Deleted'?Boolean(x.deleted):!x.deleted)&&(scope.value==='Archived')===Boolean(x.archived)&&(pf.value==='All'||x.priority===pf.value)&&normalizeSearch(x.title).includes(normalizeSearch(query))&&(!range.from&&!range.through||Boolean(x.due_date)&&(!range.from||x.due_date>=range.from)&&(!range.through||x.due_date<=range.through))).map(x=>x.id);const response=await fetch('/api/directory/bulk',{method:'PATCH',headers:{'content-type':'application/json'},body:JSON.stringify({ids,deleted})});if(!response.ok)return;const fresh=await(await fetch('/api/directory')).json();all.splice(0,all.length,...fresh);draw()}document.getElementById('delete-visible').onclick=()=>changeDeleted(true);document.getElementById('restore-visible').onclick=()=>changeDeleted(false);\"},{\"oldText\":\"if (req.method === 'PATCH' && url.pathname === '/api/directory/bulk') { try { const b=await readBody(req); if(!Array.isArray(b.ids)||typeof b.completed!=='boolean')return send(res,400,{error:'Invalid request'}); const update=db.prepare('UPDATE tasks SET completed=? WHERE id=? AND deleted=0 AND project_id IN (SELECT id FROM projects WHERE archived=0)'); db.exec('BEGIN'); try { for(const id of new Set(b.ids)) if(Number.isInteger(id)) update.run(b.completed?1:0,id); db.exec('COMMIT'); } catch(e){db.exec('ROLLBACK');throw e;} return send(res,200,{status:'ok'}); } catch { return send(res,400,{error:'Invalid request'}); } }\",\"newText\":\"if (req.method === 'PATCH' && url.pathname === '/api/directory/bulk') { try { const b=await readBody(req); if(!Array.isArray(b.ids))return send(res,400,{error:'Invalid request'}); const completion=typeof b.completed==='boolean', deletion=typeof b.deleted==='boolean'; if(completion===deletion)return send(res,400,{error:'Invalid request'}); const update=completion?db.prepare('UPDATE tasks SET completed=? WHERE id=? AND deleted=0 AND project_id IN (SELECT id FROM projects WHERE archived=0)'):db.prepare('UPDATE tasks SET deleted=? WHERE id=? AND project_id IN (SELECT id FROM projects WHERE archived=0)'); db.exec('BEGIN'); try { for(const id of new Set(b.ids)) if(Number.isInteger(id)) update.run((completion?b.completed:b.deleted)?1:0,id); db.exec('COMMIT'); } catch(e){db.exec('ROLLBACK');throw e;} return send(res,200,{status:'ok'}); } catch { return send(res,400,{error:'Invalid request'}); } }\"}]}"}

