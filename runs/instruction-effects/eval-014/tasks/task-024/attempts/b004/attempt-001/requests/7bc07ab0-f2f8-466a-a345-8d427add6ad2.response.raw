) update.run(b.completed?1:0,id); db.exec('COMMIT'); } catch(e){db.exec('ROLLBACK');throw e;} return send(res,200,{status:'ok'}); } catch { return send(res,400,{error:'Invalid request'}); } }\",\"newText\":\"if (req.method === 'PATCH' && url.pathname === '/api/directory/bulk') { try { const b=await readBody(req); if(!Array.isArray(b.ids))return send(res,400,{error:'Invalid request'}); const completion=typeof b.completed==='boolean',deletion=typeof b.deleted==='boolean'; if(completion===deletion)return send(res,400,{error:'Invalid request'}); const update=completion?db.prepare('UPDATE tasks SET completed=? WHERE id=? AND deleted=0 AND project_id IN (SELECT id FROM projects WHERE archived=0)'):db.prepare('UPDATE tasks SET deleted=? WHERE id=? AND project_id IN (SELECT id FROM projects WHERE archived=0)'); db.exec('BEGIN'); try { for(const id of new Set(b.ids)) if(Number.isInteger(id)) update.run((completion?b.completed:b.deleted)?1:0,id); db.exec('COMMIT'); } catch(e){db.exec('ROLLBACK');throw e;} return send(res,200,{status:'ok'}); } catch { return send(res,400,{error:'Invalid request'}); } }\"}]}","status":"completed"}}

