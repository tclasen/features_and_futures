"newText\":\"    (filter === 'Deleted' ? Boolean(task.deleted) :\\n      !task.deleted && (filter === 'All' || Boolean(task.completed) === (filter === 'Completed'))) &&\"},{\"oldText\":\"${['All', 'Open', 'Completed'].map(option\",\"newText\":\"${['All', 'Open', 'Completed', 'Deleted'].map(option\"},{\"oldText\":\"${task.completed ? ' checked' : ''}${project.archived ? ' disabled' : ''}\",\"newText\":\"${task.completed ? ' checked' : ''}${project.archived || task.deleted ? ' disabled' : ''}\"},{\"oldText\":\"<input id=\\\"new-task-title-${task.id}\\\" name=\\\"title\\\" type=\\\"text\\\"${project.archived ? ' disabled' : ''}>\\n          <button type=\\\"submit\\\"${project.archived ? ' disabled' : ''}>Rename task\",\"newText\":\"<input id=\\\"new-task-title-${task.id}\\\" name=\\\"title\\\" type=\\\"text\\\"${project.archived || task.deleted ? ' disabled' : ''}>\\n          <button type=\\\"submit\\\"${project.archived || task.deleted ? ' disabled' : ''}>Rename task\"},{\"oldText\":\"<select id=\\\"task-priority-${task.id}\\\" name=\\\"priority\\\"${project.archived ? ' disabled' : ''}\",\"newText\":\"<select id=\\\"task-priority-${task.id}\\\" name=\\\"priority\\\"${project.archived || task.deleted ? ' disabled' : ''}\"},{\"oldText\":\"value=\\\"${escapeHtml(task.due_date)}\\\"${project.archived ? ' disabled' : ''}>\\n          <button type=\\\"submit\\\"${project.archived ? ' disabled' : ''}>Save due date\",\"newText\":\"value=\\\"${escapeHtml(task.due_date)}\\\"${project.archived || task.deleted ? ' disabled' : ''}>\\n          <button type=\\\"submit\\\"${project.archived || task.deleted ? ' disabled' : ''}>Save due date\"},{\"oldText\":\"rows=\\\"4\\\"${project.archived ? ' disabled' : ''}>${escapeHtml(task.notes).replace(/\\\\r/g, '&#13;').replace(/\\\\n/g, '&#10;')}</textarea>\\n          <button type=\\\"submit\\\"${project.archived ? ' disabled' : ''}>Save notes\",\"newText\":\"rows=\\\"4\\\"${project.archived || task.deleted ? ' disabled' : ''}>${escapeHt