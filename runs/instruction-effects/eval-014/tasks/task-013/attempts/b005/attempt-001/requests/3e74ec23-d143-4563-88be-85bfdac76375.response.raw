enderFilteredProject(project, filter, error, priority, readDueRange(form))\",\"newText\":\"renderFilteredProject(project, filter, error, priority, readDueRange(form), normalizeSearch(form.get('query')))\"},{\"oldText\":\"filteredProjectLocation(project, filter, priority, { from, through })\",\"newText\":\"filteredProjectLocation(project, filter, priority, { from, through }, normalizeSearch(form.get('query')))\"},{\"oldText\":\"readDueRange(searchParams)) : renderNotFound()\",\"newText\":\"readDueRange(searchParams), normalizeSearch(searchParams.get('query'))) : renderNotFound()\"}]}"}

