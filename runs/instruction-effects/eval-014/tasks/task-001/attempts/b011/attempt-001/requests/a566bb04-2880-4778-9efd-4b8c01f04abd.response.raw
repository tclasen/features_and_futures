    catch { app.innerHTML = '<h1>Project not found</h1><button class=\\\"back\\\" type=\\\"button\\\">Projects</button>'; app.querySelector('button').onclick = () => { location.href = '/'; }; return; }\\n    app.innerHTML = `<button class=\\\"back\\\" type=\\\"button\\\">Projects</button><h1>${escapeHtml(project.name)}</h1>`;\\n    app.querySelector('button').onclick = () => { location.href = '/'; };\\n    return;\\n  }\\n  const projects = await (await fetch('/api/projects')).json();\\n  app.innerHTML = `<h1>Workboard</h1><form class=\\\"form\\\"><input aria-label=\\\"Project name\\\" name=\\\"name\\\" type=\\\"text\\\"><button type=\\\"submit\\\">Create project</button></form><div class=\\\"alert-slot\\\" aria-live=\\\"polite\\\"></div><section aria-label=\\\"Projects\\\">${projects.map(p => `<div class=\\\"row\\\" data-testid=\\\"project-row\\\"><span class=\\\"row-name\\\">${escapeHtml(p.name)}</span><button type=\\\"button\\\" data-id=\\\"${escapeHtml(p.id)}\\\">Open project</button></div>`).join('')}</section>`;\\n  app.querySelectorAll('[data-id]').forEach(button => button.addEventListener('click', () => { location.href = '/projects/' + encodeURIComponent(button.dataset.id); }));\\n  app.querySelector('form').addEventListener('submit', async event => {\\n    event.preventDefault();\\n    const name = new FormData(event.currentTarget).get('name').trim();\\n    if (!name) { app.querySelector('.alert-slot').innerHTML = '<p role=\\\"alert\\\">Project name is required</p>'; return; }\\n    const response = await fetch('/api/projects', { method: 'POST', headers: {'content-type':'application/json'}, body: JSON.stringify({name}) });\\n    if (response.ok) render();\\n  });\\n}\\nrender();\\n</script>\\n</body>\\n</html>\\n\"}","status":"completed"}}

