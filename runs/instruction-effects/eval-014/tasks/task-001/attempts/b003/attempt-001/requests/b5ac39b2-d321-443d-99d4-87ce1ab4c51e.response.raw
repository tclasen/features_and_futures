return `<!doctype html>\\n<html lang=\\\"en\\\"><head><meta charset=\\\"utf-8\\\"><meta name=\\\"viewport\\\" content=\\\"width=device-width, initial-scale=1\\\">\\n<title>${escapeHtml(title)} · Workboard</title>\\n<style>\\n  * { box-sizing: border-box; }\\n  body { margin: 0; background: #f4f6fa; color: #182339; font: 16px/1.5 system-ui, sans-serif; }\\n  main { max-width: 760px; margin: 64px auto; padding: 32px; background: white; border: 1px solid #dce2eb; border-radius: 12px; }\\n  h1 { margin: 0 0 24px; overflow-wrap: anywhere; }\\n  label { display: block; font-weight: 600; margin-bottom: 8px; }\\n  input { width: 100%; padding: 10px; font: inherit; border: 1px solid #7c899f; border-radius: 6px; }\\n  button { padding: 10px 16px; font: inherit; font-weight: 600; color: white; background: #2457b8; border: 0; border-radius: 6px; cursor: pointer; }\\n  button:hover { background: #19448f; }\\n  :focus-visible { outline: 3px solid #b25d00; outline-offset: 3px; }\\n  .create button { margin-top: 12px; }\\n  [role=alert] { color: #9d1829; background: #fff0f2; padding: 12px; border-radius: 6px; }\\n  .projects { margin-top: 32px; }\\n  .project { display: flex; align-items: center; justify-content: space-between; gap: 16px; padding: 16px 0; border-top: 1px solid #dce2eb; }\\n  .project span { overflow-wrap: anywhere; min-width: 0; }\\n  .project form { flex-shrink: 0; }\\n  @media (max-width: 600px) { main { margin: 16px; padding: 20px; } .project { align-items: flex-start; flex-direction: column; } }\\n</style></head><body><main>${content}</main></body></html>`;\\n}\\n\\nfunction projectsPage(error = '') {\\n  const projects = listProjects.all();\\n  return page('Projects', `<h1>Workboard</h1>\\n    ${error ? `<p role=\\\"alert\\\">${escapeHtml(error)}</p>` : ''}\\n    <form class=\\\"create\\\" method=\\\"post\\\" action=\\\"/projects\\\">\\n      <label for=\\\"project-name\\\">Project name</label>\\n      <input id=\\\"project-name\\\" name=\\\"name\\\" type=\\\"text\\\">\\n      <button type=\\\"submit\\\">Create project</button>\\n    </form>\\n    <section class=\\\"projects\\\" aria-label=\\\"Projects\\\">${projects.length ? projects.map(project => `\\n      <div class=\\\"project\\\" data-testid=\\\"project-row\\\">\\n        <span>${escapeHtml(project.name)}</span>\\n        <form method=\\\"get\\\" action=\\\"/projects/${project.id}\\\"><button type=\\\"submit\\\">Open project</button></form>\\n      </div>`).join('') : '<p>No projects yet.</p>'}</section>`);\\n}\\n\\nfunction sendHtml(res, status, content) {\\n  res.writeHead(status, { 'Content-Type': 'text/html; charset=utf-8', 'Cache-Control': 'no-store' });\\n  res.end(content);\\n}\\n\\nconst server = http.createServer(async (req, res) => {\\n  try {\\n    const url = new URL(req.url, 'http://localhost');\\n    if (req.method === 'GET' && url.pathname === '/health') {\\n      res.writeHead(200, { 'Content-Type': 'application/json' });\\n      res.end(JSON.stringify({ status: 'ok' }));\\n    } else if (req.method === 'GET' && url.pathname === '/') {\\n      sendHtml(res, 200, projectsPage());\\n    } else if (req.method === 'POST' && url.pathname === '/projects') {\\n      let body = '';\\n      for await (const chunk of req) {\\n        body += chunk.toString();\\n        if (Buffer.byteLength(body) > 1024 * 1024) {\\n          sendHtml(res, 413, page('Request too large', '<h1>Request too large</h1>'));\\n          return;\\n        }\\n      }\\n      const name = (new URLSearchParams(body).get('name') || '').trim();\\n      if (!name) {\\n        sendHtml(res, 200, projectsPage('Project name is required'));\\n        return;\\n      }\\n      createProject.run(name);\\n      res.writeHead(303, { Location: '/' });\\n      res.end();\\n    } else if (req.method === 'GET' && /^\\\\/projects\\\\/\\\\d+$/.test(url.pathname)) {\\n      const id = Number(url.pathname.split('/')[2]);\\n      const project = Number.isSafeInteger(id) ? getProject.get(id) : undefined;\\n      if (!project) {\\n        sendHtml(res, 404, page('Not found', '<h1>Project not found</h1><form action=\\\"/\\\"><button>Projects</button></form>'));\\n        return;\\n      }\\n      sendHtml(res, 200, page(project.name, `<h1>${escapeHtml(project.name)}</h1><form method=\\\"get\\\" action=\\\"/\\\"><button type=\\\"submit\\\">Projects</button></form>`));\\n    } else {\\n      sendHtml(res, 404, page('Not found', '<h1>Page not found</h1>'));\\n    }\\n  } catch (error) {\\n    console.error(error);\\n    if (!res.headersSent) sendHtml(res, 500, page('Error', '<h1>Unable to complete request</h1>'));\\n    else res.end();\\n  }\\n});\\n\\nserver.listen(Number(process.env.PORT || 8080), '0.0.0.0', () => {\\n  console.log(`Workboard listening on port ${server.address().port}`);\\n});\\n\\nfor (const signal of ['SIGINT', 'SIGTERM']) {\\n  process.on(signal, () => server.close(() => {\\n    db.close();\\n    process.exit(0);\\n  }));\\n}\\n\"}","status":"completed"}],"error":null,"incomplete_details":null,"tools":[{"type":"function","name":"read","description":"Read the contents of a file. Supports text files and images (jpg, png, gif, webp, bmp). Images are sent as attachments. For text files, output is truncated to 2000 lines or 50KB (whichever is hit first). Use offset/limit for large files. When you need the full file, continue with offset until complete.","parameters":{"type":"object","required":["path","offset","limit"],"properties":{"path":{"type":"string","description":"Path to the file to read (relative or absolute)"},"offset":{"anyOf":[{"type":"number","description":"Line number to start reading from (1-indexed)"},{"type":"null"}]},"limit":{"anyOf":[{"type":"number","description":"Maximum number of lines to read"},{"type":"null"}]}},"additionalProperties":false},"output_schema":null,"strict":true},{"type":"function","name":"bash","description":"Execute a bash command in the current working directory. Returns stdout and stderr. Output is truncated to last 2000 lines or 50KB (whichever is hit first). If truncated, full output is saved to a temp file. Optionally provide a timeout in seconds.","parameters":{"type":"object","required":["command","timeout"],"properties":{"command":{"type":"string","description":"Shell command to execute"},"timeout":{"anyOf":[{"type":"number","description":"Timeout in seconds (optional, no default timeout)"},{"type":"null"}]}},"additionalProperties":false},"output_schema":null,"strict":true},{"type":"function","name":"edit","description":"Edit a single file using exact text replacement. Every edits[].oldText must match a unique, non-overlapping region of the original file. If two changes affect the same block or nearby lines, merge them into one edit instead of emitting overlapping edits. Do not include large unchanged regions just to connect distant changes.","parameters":{"type":"object","required":["path","edits"],"properties":{"path":{"type":"string","description":"Path to the file to edit (relative or absolute)"},"edits":{"type":"array","items":{"type":"object","required":["oldText","newText"],"properties":{"oldText":{"type":"string","description":"Exact text for one targeted replacement. It must be unique in the original file and must not overlap with any other edits[].oldText in the same call."},"newText":{"type":"string","description":"Replacement text for this targeted edit."}},"additionalProperties":false},"description":"One or more targeted replacements. Each edit is matched against the original file, not incrementally. Do not include overlapping or nested edits. If two changes touch the same block or nearby lines, merge them into one edit instead."}},"additionalProperties":false},"output_schema":null,"strict":true},{"type":"function","name":"write","description":"Write content to a file. Creates the file if it doesn't exist, overwrites if it does. Automatically creates parent directories.","parameters":{"type":"object","required":["path","content"],"properties":{"path":{"type":"string","description":"Path to the file to write (relative or absolute)"},"content":{"type":"string","description":"Content to write to the file"}},"additionalProperties":false},"output_schema":null,"strict":true}],"tool_choice":"auto","parallel_tool_calls":true,"prompt_cache_key":"4cdbabaa-4f75-4b62-8440-c0b77055d1ca","prompt_cache_retention":"24h","text":{"format":{"type":"text"},"verbosity":"low"},"top_p":0.98,"top_logprobs":0,"temperature":1.0,"reasoning":{"effort":"medium","summary":"detailed","context":"all_turns","mode":"standard"},"user":null,"usage":{"input_tokens":2118,"input_tokens_details":{"cached_tokens":0,"cache_write_tokens":0},"output_tokens":1854,"output_tokens_details":{"reasoning_tokens":72},"total_tokens":3972,"attribution":{"items":{"fc_0f382c1bbe15a8f9016acb9828f56c87d299b36995ef9d97f9":{"input_tokens":38,"cached_tokens":0,"cache_write_tokens":0,"output_tokens":0},"fc_0f382c1bbe15a8f9016acb982c31f887d2848e7a4fa40c86e8":{"input_tokens":42,"cached_tokens":0,"cache_write_tokens":0,"output_tokens":0},"fc_0f382c1bbe15a8f9016acb982d6d5087d29cbef8d82aecb138":{"input_tokens":25,"cached_tokens":0,"cache_write_tokens":0,"output_tokens":0},"fc_0f382c1bbe15a8f9016acb982e4ee887d28b9c48085ae76afe":{"input_tokens":26,"cached_tokens":0,"cache_write_tokens":0,"output_tokens":0,"content":[{"input_tokens":26,"cached_tokens":0,"cache_write_tokens":0,"output_tokens":0}]},"fc_0f382c1bbe15a8f9016acb982e4ee887d2a6a1097ccad79cf1":{"input_tokens":58,"cached_tokens":0,"cache_write_tokens":0,"output_tokens":0,"content":[{"input_tokens":58,"cached_tokens":0,"cache_write_tokens":0,"output_tokens":0}]},"fc_0f382c1bbe15a8f9016acb982e4ee887d2acfc8d70fea38243":{"input_tokens":137,"cached_tokens":0,"cache_write_tokens":0,"output_tokens":0,"content":[{"input_tokens":137,"cached_tokens":0,"cache_write_tokens":0,"output_tokens":0}]},"fc_0f382c1bbe15a8f9016acb9834a54887d2926c1d1ab8e8dda6":{"input_tokens":0,"cached_tokens":0,"cache_write_tokens":0,"output_tokens":1750},"msg_0f382