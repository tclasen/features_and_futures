(tmpdir(), 'workboard-directory-priority-'));\\n  const dbPath = join(dir, 'db.sqlite');\\n  let child, db, url;\\n  const start = async () => {\\n    child = spawn(process.execPath, ['server.js'], {\\n      env: { ...process.env, PORT: '0', DB_PATH: dbPath }, stdio: ['ignore', 'pipe', 'inherit'],\\n    });\\n    const port = await new Promise((resolve, reject) => {\\n      child.once('error', reject);\\n      child.stdout.on('data', data => {\\n        const match = /listening on port (\\\\d+)/.exec(data.toString());\\n        if (match) resolve(match[1]);\\n      });\\n    });\\n    url = `http://127.0.0.1:${port}`;\\n  };\\n  const stop = async () => { const exit = once(child, 'exit'); child.kill(); await exit; child = undefined; };\\n  const get = async path => (await fetch(url + path)).text();\\n  const post = (path, data) => fetch(url + path, { method: 'POST', body: new URLSearchParams(data), redirect: 'manual' });\\n  const task = (title, extra = {}) => ({ title, completed: false, priority: 'High', dueDate: '2024-02-29',\\n    notes: '  literal <markup> Ω\\\\nline\\\\t ', deleted: false, ...extra });\\n  const state = { scope: 'Active', filter: 'Open', priorityFilter: 'High', dueFrom: '2024-02-29',\\n    dueThrough: '2024-02-29', search: ' MATCH ', order: 'Priority' };\\n  try {\\n    await start();\\n    for (const [archived, tasks] of [\\n      [false, [task('Z match'), task('Completed match', { completed: true }), task('Deleted match', { deleted: true }),\\n        task('Low match', { priority: 'Low' }), task('Undated match', { dueDate: '' }), task('Other')]],\\n      [false, [task('A match')]], [true, [task('Archived match')]],\\n    ]) {\\n      assert.equal((await post('/projects/import', { importedName: 'Same name', json: JSON.stringify({\\n        format: 'workboard-project', version: 1, project: { name: 'Original', archived, defaultPriority: 'High', tasks },\\n      }) })).status, 303);\\n    }\\n    db = new DatabaseSync(dbPath);\\n    const records = () => db.prepare('SELECT * FROM tasks ORDER BY id').all();\\n    const projects = () => db.prepare('SELECT * FROM projects ORDER BY id').all();\\n    const positions = () => db.prepare('SELECT * FROM task_positions ORDER BY project_id, position').all();\\n    const original = records(), originalProjects = projects(), originalPositions = positions();\\n    let html = await get('/directory');\\n    assert.match(html, /<label for=\\\"visible-tasks-priority\\\">Visible tasks priority<\\\\/label>/);\\n    assert.match(html, /id=\\\"visible-tasks-priority\\\" name=\\\"priority\\\">\\\\s*<option>Low<\\\\/option><option selected>Normal<\\\\/option><option>High<\\\\/option>/);\\n    html = await get(`/directory?${new URLSearchParams(state)}`);\\n    assert.doesNotMatch(html, /<button[^>]* disabled>Set visible priority/);\\n    for (const override of [{ scope: 'Archived' }, { filter: 'Deleted' }, { search: 'not present' }]) {\\n      const protectedState = { ...state, ...override };\\n      html = await get(`/directory?${new URLSearchParams(protectedState)}`);\\n      assert.match(html, /<button[^>]* disabled>Set visible priority/);\\n      await post('/directory/priority', { ...protectedState, priority: 'Low' });\\n      assert.deepEqual(records(), original);\\n    }\\n    for (const priority of [undefined, '', 'Urgent', 'low']) {\\n      const form = { ...state };\\n      if (priority !== undefined) form.priority = priority;\\n      await post('/directory/priority', form);\\n      assert.deepEqual(records(), original);\\n    }\\n    const response = await post('/directory/priority', { ...state, priority: 'Low' });\\n    assert.equal(response.status, 303);\\n    const location = response.headers.get('location');\\n    const params = new URL(location, url).searchParams;\\n    for (const [key, value] of Object.entries(state)) assert.equal(params.get(key), key === 'search' ? value.trim() : value);\\n    assert.equal(params.get('visiblePriority'), 'Low');\\n    html = await get(location);\\n    assert.match(html, /data-testid=\\\"directory-summary\\\">0\\\\/0 completed/);\\n    assert.match(html, /No matching tasks/);\\n    assert.doesNotMatch(html, /data-testid=\\\"directory-owner-row\\\"/);\\n    for (const label of ['Set visible priority', 'Complete visible tasks', 'Reopen visible tasks', 'Delete visible tasks', 'Restore visible tasks']) {\\n      assert.match(html, new RegExp(`<button[^>]* disabled>${label}</button>`));\\n    }\\n    assert.deepEqual(records(), original.map(row => [1, 7].includes(row.id) ? { ...row, priority: 'Low' } : row));\\n    assert.deepEqual(projects(), originalProjects);\\n    assert.deepEqual(positions(), originalPositions);\\n    html = await get(`/directory?${new URLSearchParams({ ...state, priorityFilter: 'Low' })}`);\\n    assert.equal((html.match(/data-testid=\\\"directory-owner-row\\\"/g) || []).length, 2);\\n    assert.match(html, /data-testid=\\\"directory-summary\\\">0\\\\/3 completed/);\\n    await post('/projects/1/tasks/1/move', { destination: '2' });\\n    await post('/projects/2/tasks/1/move', { destination: '1' });\\n    assert.deepEqual(records()[0], { ...original[0], priority: 'Low' });\\n    const saved = records(), savedPositions = positions();\\n    db.close(); db = undefined;\\n    await stop(); await start();\\n    db = new DatabaseSync(dbPath);\\n    assert.deepEqual(records(), saved);\\n    assert.deepEqual(positions(), savedPositions);\\n    assert.deepEqual(projects(), originalProjects);\\n    html = await get('/directory');\\n    assert.match(html, /<option selected>Normal<\\\\/option>/);\\n    // All and Completed are also live, eligible intersections.\\n    await post('/directory/priority', { scope: 'Active', filter: 'Completed', priority: 'Normal' });\\n    assert.equal(records()[1].priority, 'Normal');\\n    await post('/directory/priority', { scope: 'Active', filter: 'All', priority: 'Normal' });\\n    for (const row of records()) assert.equal(row.priority, row.deleted || row.project_id === 3 ? 'High' : 'Normal');\\n  } finally {\\n    db?.close();\\n    if (child) await stop();\\n    await rm(dir, { recursive: true, force: true });\\n  }\\n});\\n\"}","status":"completed"}],"error":null,"incomplete_details":null,"tools":[{"type":"function","name":"read","description":"Read the contents of a file. Supports text files and images (jpg, png, gif, webp, bmp). Images are sent as attachments. For text files, output is truncated to 2000 lines or 50KB (whichever is hit first). Use offset/limit for large files. When you need the full file, continue with offset until complete.","parameters":{"type":"object","required":["path","offset","limit"],"properties":{"path":{"type":"string","description":"Path to the file to read (relative or absolute)"},"offset":{"anyOf":[{"type":"number","description":"Line number to start reading from (1-indexed)"},{"type":"null"}]},"limit":{"anyOf":[{"type":"number","description":"Maximum number of lines to read"},{"type":"null"}]}},"additionalProperties":false},"output_schema":null,"strict":true},{"type":"function","name":"bash","description":"Execute a bash command in the current working directory. Returns stdout and stderr. Output is truncated to last 2000 lines or 50KB (whichever is hit first). If truncated, full output is saved to a temp file. Optionally provide a timeout in seconds.","parameters":{"type":"object","required":["command","timeout"],"properties":{"command":{"type":"string","description":"Shell command to execute"},"timeout":{"anyOf":[{"type":"number","description":"Timeout in seconds (optional, no default timeout)"},{"type":"null"}]}},"additionalProperties":false},"output_schema":null,"strict":true},{"type":"function","name":"edit","description":"Edit a single file using exact text replacement. Every edits[].oldText must match a unique, non-overlapping region of the original file. If two changes affect the same block or nearby lines, merge them into one edit instead of emitting overlapping edits. Do not include large unchanged regions just to connect distant changes.","parameters":{"type":"object","required":["path","edits"],"properties":{"path":{"type":"string","description":"Path to the file to edit (relative or absolute)"},"edits":{"type":"array","items":{"type":"object","required":["oldText","newText"],"properties":{"oldText":{"type":"string","description":"Exact text for one targeted replacement. It must be unique in the original file and must not overlap with any other edits[].oldText in the same call."},"newText":{"type":"string","description":"Replacement text for this targeted edit."}},"additionalProperties":false},"description":"One or more targeted replacements. Each edit is matched against the original file, not incrementally. Do not include overlapping or nested edits. If two changes touch the same block or nearby lines, merge them into one edit instead."}},"additionalProperties":false},"output_schema":null,"strict":true},{"type":"function","name":"write","description":"Write content to a file. Creates the file if it doesn't exist, overwrites if it does. Automatically creates parent directories.","parameters":{"type":"object","required":["path","content"],"properties":{"path":{"type":"string","description":"Path to the file to write (relative or absolute)"},"content":{"type":"string","description":"Content to write to the file"}},"additionalProperties":false},"output_schema":null,"strict":true}],"tool_choice":"auto","parallel_tool_calls":true,"prompt_cache_key":"a366c005-aa03-44c4-92dd-5298f0d64c4c","prompt_cache_retention":"24h","text":{"format":{"type":"text"},"verbosity":"low"},"top_p":0.98,"top_logprobs":0,"temperature":1.0,"reasoning":{"effort":"medium","summary":"detailed","context":"all_turns","mode":"standard"},"user":null,"usage":{"input_tokens":18444,"input_tokens_details":{"cached_tokens":7808,"cache_write_tokens":0},"output_tokens":1841,"output_tokens_details":{"reasoning_tokens":22},"total_tokens":20285,"attribution":{"items":{"fc_0027c