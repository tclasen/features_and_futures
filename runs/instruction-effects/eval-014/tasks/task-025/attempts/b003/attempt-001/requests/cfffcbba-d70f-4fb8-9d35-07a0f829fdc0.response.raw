\\d+)/);\\n      if (match) resolve(match[1]);\\n    });\\n    child.once('error', reject);\\n    child.once('exit', code => reject(new Error(`Server exited: ${code}`)));\\n  });\\n  return { url: `http://127.0.0.1:${port}`, async stop() {\\n    const exited = once(child, 'exit'); child.kill(); await exited;\\n  } };\\n}\\n\\ntest('bulk directory priority targets only matching live active tasks and preserves data and view', async () => {\\n  const temp = await mkdtemp(join(tmpdir(), 'workboard-directory-priority-'));\\n  const dbPath = join(temp, 'db.sqlite');\\n  let server;\\n  let db;\\n  try {\\n    server = await start(dbPath);\\n    db = new DatabaseSync(dbPath);\\n    const get = async path => (await fetch(server.url + path)).text();\\n    const post = async (path, values = {}) => (await fetch(server.url + path, {\\n      method: 'POST', body: new URLSearchParams(values)\\n    })).text();\\n    for (const archived of [false, false, true]) {\\n      await post('/projects/import', { importedName: 'Same owner', projectJson: JSON.stringify({\\n        format: 'workboard-project', version: 1, project: {\\n          name: 'Original', archived, defaultPriority: 'Low', tasks: [\\n            { title: 'MATCH\\\\t  Alpha', completed: true, priority: 'High', dueDate: '2024-02-29', notes: '  雪\\\\n<literal>  ', deleted: false },\\n            { title: 'Match Beta', completed: false, priority: 'High', dueDate: '2024-03-01', notes: '', deleted: false },\\n            { title: 'Outside', completed: false, priority: 'Low', dueDate: '', notes: 'match alpha', deleted: false },\\n            { title: 'Match Alpha deleted', completed: true, priority: 'High', dueDate: '2024-02-29', notes: 'kept', deleted: true }\\n          ]\\n        }\\n      }) });\\n    }\\n    const tasks = () => db.prepare('SELECT * FROM tasks ORDER BY id').all().map(task => ({ ...task }));\\n    const positions = () => db.prepare('SELECT * FROM task_positions ORDER BY project_id, position').all();\\n    const projects = () => db.prepare('SELECT * FROM projects ORDER BY id').all();\\n    const before = tasks();\\n    const originalPositions = positions();\\n    const originalProjects = projects();\\n    const state = { scope: 'Active', filter: 'Completed', priorityFilter: 'High', dueFrom: '2024-02-29', dueThrough: '2024-02-29', search: 'match alpha', order: 'Title' };\\n    const checkButton = (html, disabled) => {\\n      const match = html.match(/<button[^>]*>Set visible priority<\\\\/button>/);\\n      assert.ok(match);\\n      assert.equal(match[0].includes(' disabled'), disabled);\\n    };\\n    let html = await get('/directory');\\n    assert.match(html, /id=\\\"visible-tasks-priority\\\" name=\\\"priority\\\">\\\\s*<option>Low<\\\\/option><option selected>Normal<\\\\/option><option>High<\\\\/option>/);\\n    checkButton(html, false);\\n    html = await post('/directory/priority', { ...state, priority: 'Low' });\\n    checkButton(html, true);\\n    assert.match(html, /directory-summary\\\">0\\\\/0 completed/);\\n    assert.match(html, /No matching tasks/);\\n    assert.doesNotMatch(html, /data-testid=\\\"directory-owner-row\\\"/);\\n    for (const value of ['Completed', 'High', 'Title', 'Low']) assert.match(html, new RegExp(`<option selected>${value}</option>`));\\n    for (const value of ['2024-02-29', 'match alpha']) assert.ok(html.includes(`value=\\\"${value}\\\"`));\\n    const expected = before.map(task => [1, 5].includes(task.id) ? { ...task, priority: 'Low' } : task);\\n    assert.deepEqual(tasks(), expected);\\n    assert.deepEqual(positions(), originalPositions);\\n    assert.deepEqual(projects(), originalProjects);\\n    html = await get('/directory?' + new URLSearchParams({ ...state, priorityFilter: 'Low' }));\\n    assert.match(html, /directory-summary\\\">2\\\\/2 completed/);\\n    assert.equal((html.match(/directory-owner-row/g) || []).length, 2);\\n    assert.match(await get('/'), /1\\\\/3 completed/);\\n    for (const values of [\\n      { ...state, priorityFilter: 'All', scope: 'Archived', priority: 'Normal' },\\n      { ...state, priorityFilter: 'All', filter: 'Deleted', priority: 'Normal' },\\n      { ...state, priorityFilter: 'All', priority: 'invalid' },\\n      { ...state, priorityFilter: 'All' }\\n    ]) await post('/directory/priority', values);\\n    assert.deepEqual(tasks(), expected);\\n    for (const path of ['/directory?scope=Archived', '/directory?filter=Deleted', '/directory?search=absent']) checkButton(await get(path), true);\\n    await server.stop();\\n    server = await start(dbPath);\\n    assert.deepEqual(tasks(), expected);\\n    assert.match(await get('/projects/1'), /<option selected>Low<\\\\/option>/);\\n    await post('/projects/1/tasks/1/move', { destination: '2' });\\n    await post('/projects/2/tasks/1/move', { destination: '1' });\\n    assert.deepEqual(tasks(), expected);\\n    await post('/directory/priority', { scope: 'Active', filter: 'Open', priorityFilter: 'High', priority: 'Normal' });\\n    assert.deepEqual(tasks(), expected.map(task => [2, 6].includes(task.id) ? { ...task, priority: 'Normal' } : task));\\n    await post('/directory/priority', { scope: 'Active', filter: 'All', priorityFilter: 'Normal', priority: 'High' });\\n    assert.deepEqual(tasks(), expected);\\n    assert.deepEqual(projects(), originalProjects);\\n  } finally {\\n    if (server) await server.stop();\\n    if (db?.isOpen) db.close();\\n    await rm(temp, { recursive: true, force: true });\\n  }\\n});\\n\"}","status":"completed"}],"error":null,"incomplete_details":null,"tools":[{"type":"function","name":"read","description":"Read the contents of a file. Supports text files and images (jpg, png, gif, webp, bmp). Images are sent as attachments. For text files, output is truncated to 2000 lines or 50KB (whichever is hit first). Use offset/limit for large files. When you need the full file, continue with offset until complete.","parameters":{"type":"object","required":["path","offset","limit"],"properties":{"path":{"type":"string","description":"Path to the file to read (relative or absolute)"},"offset":{"anyOf":[{"type":"number","description":"Line number to start reading from (1-indexed)"},{"type":"null"}]},"limit":{"anyOf":[{"type":"number","description":"Maximum number of lines to read"},{"type":"null"}]}},"additionalProperties":false},"output_schema":null,"strict":true},{"type":"function","name":"bash","description":"Execute a bash command in the current working directory. Returns stdout and stderr. Output is truncated to last 2000 lines or 50KB (whichever is hit first). If truncated, full output is saved to a temp file. Optionally provide a timeout in seconds.","parameters":{"type":"object","required":["command","timeout"],"properties":{"command":{"type":"string","description":"Shell command to execute"},"timeout":{"anyOf":[{"type":"number","description":"Timeout in seconds (optional, no default timeout)"},{"type":"null"}]}},"additionalProperties":false},"output_schema":null,"strict":true},{"type":"function","name":"edit","description":"Edit a single file using exact text replacement. Every edits[].oldText must match a unique, non-overlapping region of the original file. If two changes affect the same block or nearby lines, merge them into one edit instead of emitting overlapping edits. Do not include large unchanged regions just to connect distant changes.","parameters":{"type":"object","required":["path","edits"],"properties":{"path":{"type":"string","description":"Path to the file to edit (relative or absolute)"},"edits":{"type":"array","items":{"type":"object","required":["oldText","newText"],"properties":{"oldText":{"type":"string","description":"Exact text for one targeted replacement. It must be unique in the original file and must not overlap with any other edits[].oldText in the same call."},"newText":{"type":"string","description":"Replacement text for this targeted edit."}},"additionalProperties":false},"description":"One or more targeted replacements. Each edit is matched against the original file, not incrementally. Do not include overlapping or nested edits. If two changes touch the same block or nearby lines, merge them into one edit instead."}},"additionalProperties":false},"output_schema":null,"strict":true},{"type":"function","name":"write","description":"Write content to a file. Creates the file if it doesn't exist, overwrites if it does. Automatically creates parent directories.","parameters":{"type":"object","required":["path","content"],"properties":{"path":{"type":"string","description":"Path to the file to write (relative or absolute)"},"content":{"type":"string","description":"Content to write to the file"}},"additionalProperties":false},"output_schema":null,"strict":true}],"tool_choice":"auto","parallel_tool_calls":true,"prompt_cache_key":"e3727c8f-c9d5-4fec-a896-30a9dc41b2f3","prompt_cache_retention":"24h","text":{"format":{"type":"text"},"verbosity":"low"},"top_p":0.98,"top_logprobs":0,"temperature":1.0,"reasoning":{"effort":"medium","summary":"detailed","context":"all_turns","mode":"standard"},"user":null,"usage":{"input_tokens":24060,"input_tokens_details":{"cached_tokens":7168,"cache_write_tokens":0},"output_tokens":1750,"output_tokens_details":{"reasoning_tokens":13},"total_tokens":25810,"attribution":{"items":{"fc_0a8f4264df6a007b016acbdc39571c8195878bcafc92682a45":{"input_tokens":34,"cached_tokens":0,"cache_write_tokens":0,"output_tokens":0},"fc_0a8f4264df6a007b016acbdc3c2eb08195a4e8fd589eb92306":{"input_tokens":28,"cached_tokens":0,"cache_write_tokens":0,"output_tokens":0},"fc_0a8f4264df6a007b016acbdc411af08195830680128c40e7e6":{"input_tokens":37,"cached_tokens":0,"cache_write_tokens":0,"output_tokens":0},"fc_0a8f4264df6a007b016acbdc48307481959cccb7f3a5c3cbc9":{"input_tokens":906,"cached_tokens":0,"cache_write_tokens":0,"output_tokens":0},"fc_0a8f4264df6a007b016acbdc5b847c81959c7fe16e64339092":{"input_tokens":373,"cached_tokens":0,"cache_write_tokens":0,"output_tokens":0},"fc_0a8f426