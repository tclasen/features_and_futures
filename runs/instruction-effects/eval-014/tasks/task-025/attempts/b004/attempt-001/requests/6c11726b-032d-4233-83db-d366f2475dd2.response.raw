data: {"type":"response.function_call_arguments.done","sequence_number":774,"item_id":"fc_0a55cbecb1deeae7016acbdc4104108194b4d4bfdb0ca522a1","output_index":1,"arguments":"{\"path\":\"server.js\",\"edits\":[{\"oldText\":\"<button id=\\\"restore-visible\\\">Restore visible tasks</button><p data-testid=\\\"directory-summary\\\"\",\"newText\":\"<button id=\\\"restore-visible\\\">Restore visible tasks</button><label>Visible tasks priority <select id=\\\"visible-priority\\\"><option>Low</option><option selected>Normal</option><option>High</option></select></label><button id=\\\"set-visible-priority\\\">Set visible priority</button><p data-testid=\\\"directory-summary\\\"\"},{\"oldText\":\"document.getElementById('restore-visible').disabled=!canRestore;document.getElementById('directory-results')\",\"newText\":\"document.getElementById('restore-visible').disabled=!canRestore;document.getElementById('set-visible-priority').disabled=!activeLive||items.length===0;document.getElementById('directory-results')\"},{\"oldText\":\"document.getElementById('restore-visible').onclick=()=>changeDeleted(false);document.getElementById('dapply')\",\"newText\":\"document.getElementById('restore-visible').onclick=()=>changeDeleted(false);document.getElementById('set-visible-priority').onclick=async()=>{if(scope.value!=='Active'||tf.value==='Deleted')return;const ids=all.filter(x=>!x.archived&&!x.deleted&&(tf.value==='All'||(tf.value==='Completed')===Boolean(x.completed))&&(pf.value==='All'||pf.value===x.priority)&&normalizeSearch(x.title).includes(normalizeSearch(query))&&(!range.from&&!range.through||Boolean(x.due_date)&&(!range.from||x.due_date>=range.from)&&(!range.through||x.due_date<=range.through))).map(x=>x.id);if(!ids.length)return;const r=await fetch('/api/directory/bulk',{method:'PATCH',headers:{'content-type':'application/json'},body:JSON.stringify({ids,priority:document.getElementById('visible-priority').value})});if(r.ok){const fresh=await(await fetch('/api/directory')).json();all.splice(0,all.length,...fresh);draw()}};document.getElementById('dapply')\"},{\"oldText\":\"const completion=typeof b.completed==='boolean',deletion=typeof b.deleted==='boolean'; if(completion===deletion)return send(res,400,{error:'Invalid request'}); const update=completion?db.prepare('UPDATE tasks SET completed=? WHERE id=? AND deleted=0 AND project_id IN (SELECT id FROM projects WHERE archived=0)'):db.prepare('UPDATE tasks SET deleted=? WHERE id=? AND project_id IN (SELECT id FROM projects WHERE archived=0)');\",\"newText\":\"const completion=typeof b.completed==='boolean',deletion=typeof b.deleted==='boolean',priority=Object.hasOwn(b,'priority'); if([completion,deletion,priority].filter(Boolean).length!==1||priority&&!['Low','Normal','High'].includes(b.priority))return send(res,400,{error:'Invalid request'}); const update=completion?db.prepare('UPDATE tasks SET completed=? WHERE id=? AND deleted=0 AND project_id IN (SELECT id FROM projects WHERE archived=0)'):deletion?db.prepare('UPDATE tasks SET deleted=? WHERE id=? AND project_id IN (SELECT id FROM projects WHERE archived=0)'):db.prepare('UPDATE tasks SET priority=? WHERE id=? AND deleted=0 AND project_id IN (SELECT id FROM projects WHERE archived=0)');\"},{\"oldText\":\"update.run((completion?b.completed:b.deleted)?1:0,id);\",\"newText\":\"update.run(priority?b.priority:(completion?b.completed:b.deleted)?1:0,id);\"}]}"}

