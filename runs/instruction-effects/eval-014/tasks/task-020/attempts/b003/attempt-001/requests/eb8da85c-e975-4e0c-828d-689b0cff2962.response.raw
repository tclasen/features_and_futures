.all([1, 2, 3].map(id => get(`/projects/${id}/export`).then(JSON.parse)));\\n    const expected = structuredClone(before);\\n    expected[0].project.tasks[0].completed = true;\\n    expected[1].project.tasks[0].completed = true;\\n    assert.deepEqual(after, expected);\\n    assert.match(await get('/'), /data-testid=\\\"project-summary\\\">2\\\\\\\\/5 completed/);\\n    assert.match(await get('/'), /data-testid=\\\"project-summary\\\">1\\\\\\\\/2 completed/);\\n    await server.stop();\\n    server = await start(dbPath);\\n    assert.deepEqual(await Promise.all([1, 2, 3].map(id => get(`/projects/${id}/export`).then(JSON.parse))), expected);\\n    // Archived and deleted scopes cannot be updated, even by forged requests.\\n    for (const restricted of [{ ...state, scope: 'Archived', filter: 'All' }, { ...state, filter: 'Deleted' }]) {\\n      html = await get(path(restricted));\\n      for (const label of ['Complete visible tasks', 'Reopen visible tasks']) assert.ok(buttonDisabled(html, label));\\n      await post('/directory/completion', { ...restricted, completed: '1' });\\n      await post('/directory/completion', { ...restricted, completed: '0' });\\n    }\\n    assert.deepEqual(await Promise.all([1, 2, 3].map(id => get(`/projects/${id}/export`).then(JSON.parse))), expected);\\n    html = await post('/directory/completion', { ...state, filter: 'Completed', completed: '0' });\\n    assert.deepEqual(titles(html), []);\\n    assert.match(html, /No matching tasks/);\\n    expected[0].project.tasks[0].completed = false;\\n    expected[0].project.tasks[1].completed = false;\\n    expected[1].project.tasks[0].completed = false;\\n    assert.deepEqual(await Promise.all([1, 2, 3].map(id => get(`/projects/${id}/export`).then(JSON.parse))), expected);\\n    await post('/projects/1/tasks/1/move', { destination: '2' });\\n    await post('/projects/2/tasks/1/move', { destination: '1' });\\n    assert.deepEqual(JSON.parse(await get('/projects/1/export')), expected[0]);\\n    html = await get('/directory');\\n    assert.equal(buttonDisabled(html, 'Complete visible tasks'), false);\\n    assert.equal(buttonDisabled(html, 'Reopen visible tasks'), true);\\n    await server.stop();\\n    server = await start(dbPath);\\n    assert.deepEqual(JSON.parse(await get('/projects/1/export')), expected[0]);\\n  } finally {\\n    if (server) await server.stop();\\n    await rm(directory, { recursive: true, force: true });\\n  }\\n});\\n''')\\nPY\",\"timeout\":null}","status":"completed"}],"error":null,"incomplete_details":null,"tools":[{"type":"function","name":"read","description":"Read the contents of a file. Supports text files and images (jpg, png, gif, webp, bmp). Images are sent as attachments. For text files, output is truncated to 2000 lines or 50KB (whichever is hit first). Use offset/limit for large files. When you need the full file, continue with offset until complete.","parameters":{"type":"object","required":["path","offset","limit"],"properties":{"path":{"type":"string","description":"Path to the file to read (relative or absolute)"},"offset":{"anyOf":[{"type":"number","description":"Line number to start reading from (1-indexed)"},{"type":"null"}]},"limit":{"anyOf":[{"type":"number","description":"Maximum number of lines to read"},{"type":"null"}]}},"additionalProperties":false},"output_schema":null,"strict":true},{"type":"function","name":"bash","description":"Execute a bash command in the current working directory. Returns stdout and stderr. Output is truncated to last 2000 lines or 50KB (whichever is hit first). If truncated, full output is saved to a temp file. Optionally provide a timeout in seconds.","parameters":{"type":"object","required":["command","timeout"],"properties":{"command":{"type":"string","description":"Shell command to execute"},"timeout":{"anyOf":[{"type":"number","description":"Timeout in seconds (optional, no default timeout)"},{"type":"null"}]}},"additionalProperties":false},"output_schema":null,"strict":true},{"ty