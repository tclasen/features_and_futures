event: response.function_call_arguments.done
data: {"type":"response.function_call_arguments.done","sequence_number":1392,"item_id":"fc_00d34b706763c125016acbc7d5e0788197b66f9bcc95963670","output_index":0,"arguments":"{\"path\":\"test/directory-summary.test.js\",\"content\":\"import { test } from 'node:test';\\nimport assert from 'node:assert/strict';\\nimport { spawn } from 'node:child_process';\\nimport { once } from 'node:events';\\nimport { mkdtemp, rm } from 'node:fs/promises';\\nimport { tmpdir } from 'node:os';\\nimport { join } from 'node:path';\\n\\ntest('directory summary counts only resolved matches across scopes, filters, order and bulk actions', async () => {\\n  const temp = await mkdtemp(join(tmpdir(), 'workboard-summary-'));\\n  let child;\\n  try {\\n    child = spawn(process.execPath, ['server.js'], {\\n      env: { ...process.env, PORT: '0', DB_PATH: join(temp, 'db.sqlite') }, stdio: ['ignore', 'pipe', 'pipe']\\n    });\\n    const port = await new Promise((resolve, reject) => {\\n      let output = '';\\n      child.stdout.on('data', chunk => {\\n        output += chunk;\\n        const match = output.match(/listening on port (\\\\d+)/);\\n        if (match) resolve(match[1]);\\n      });\\n      child.once('error', reject);\\n      child.once('exit', code => reject(new Error(`Server exited: ${code}`)));\\n    });\\n    const base = `http://127.0.0.1:${port}`;\\n    const get = async path => (await fetch(base + path)).text();\\n    const post = async (path, values) => (await fetch(base + path, { method: 'POST', body: new URLSearchParams(values) })).text();\\n    const task = (title, completed, priority, dueDate, deleted = false) => ({ title, completed, priority, dueDate, deleted, notes: 'Literal <notes>' });\\n    for (const [index, archived] of [false, false, true].entries()) {\\n      await post('/projects/import', { importedName: `Owner ${index}`, projectJson: JSON.stringify({\\n        format: 'workboard-project', version: 1, project: { name: 'Portable', archived, defaultPriority: 'Normal', tasks: [\\n          task('Match A', false, 'High', '2024-02-29'),\\n          task('MATCH B', true, 'High', '2024-03-01'),\\n          task('Other', true, 'Low', ''),\\n          task('Match deleted', true, 'High', '2024-02-29', true),\\n          task('Other deleted', false, 'Normal', '', true)\\n        ] }\\n      }) });\\n    }\\n    const check = (html, expected) => {\\n      const summaries = [...html.matchAll(/data-testid=\\\"directory-summary\\\">([^<]*)<\\\\/p>/g)];\\n      assert.equal(summaries.length, 1);\\n      assert.equal(summaries[0][1], expected);\\n      const rows = [...html.matchAll(/data-testid=\\\"directory-task-row\\\"/g)].length;\\n      const completed = [...html.matchAll(/data-testid=\\\"directory-task-completion\\\">Completed/g)].length;\\n      assert.equal(expected, `${completed}/${rows} completed`);\\n      assert.equal(html.includes('No matching tasks'), rows === 0);\\n    };\\n    const snapshots = await Promise.all([1, 2, 3].map(id => get(`/projects/${id}/export`)));\\n    for (const order of ['Original', 'Priority', 'Due date', 'Title']) {\\n      check(await get('/directory?' + new URLSearchParams({ order })), '4/6 completed');\\n      check(await get('/directory?' + new URLSearchParams({ order, scope: 'Archived' })), '2/3 completed');\\n      check(await get('/directory?' + new URLSearchParams({ order, filter: 'Deleted' })), '2/4 completed');\\n    }\\n    check(await get('/directory?scope=Archived&filter=Deleted'), '1/2 completed');\\n    check(await get('/directory?filter=Open'), '0/2 completed');\\n    check(await get('/directory?filter=Completed'), '4/4 completed');\\n    check(await get('/directory?priorityFilter=Low'), '2/2 completed');\\n    check(await get('/directory?search=match'), '2/4 completed');\\n    check(await get('/directory?search=Literal'), '0/0 completed');\\n    check(await get('/directory?dueFrom=2024-02-29&dueThrough=2024-02-29'), '0/2 completed');\\n    const state = { scope: 'Active', filter: 'All', priorityFilter: 'High', search: 'match', dueFrom: '2024-02-29', dueThrough: '2024-03-01', order: 'Title' };\\n    check(await post('/directory/due-range', { ...state, from: '2023-02-29', through: '' }), '2/4 completed');\\n    assert.deepEqual(await Promise.all([1, 2, 3].map(id => get(`/projects/${id}/export`))), snapshots);\\n    check(await post('/directory/completion', { ...state, filter: 'Open', completed: '1' }), '0/0 completed');\\n    check(await get('/directory'), '6/6 completed');\\n    check(await post('/directory/completion', { ...state, filter: 'Completed', completed: '0' }), '0/0 completed');\\n    check(await get('/directory'), '2/6 completed');\\n    check(await get('/directory?filter=Deleted'), '2/4 completed');\\n    check(await get('/directory?scope=Archived'), '2/3 completed');\\n    check(await get('/directory?search=other&filter=Completed'), '2/2 completed');\\n  } finally {\\n    if (child && child.exitCode === null) { const exited = once(child, 'exit'); child.kill(); await exited; }\\n    await rm(temp, { recursive: true, force: true });\\n  }\\n});\\n\"}"}

event: response.output_item.done
data: {"type":"response.output_item.done","sequence_number":1393,"output_index":0,"item":{"type":"function_call","id":"fc_00d34b706763c125016acbc7d5e0788197b66f9bcc95963670","call_id":"call_e46e4ee01dff412bacfa4a8ee962d473","name":"write","arguments":"{\"path\":\"test/directory-summary.test.js\",\"content\":\"import { test } from 'node:test';\\nimport assert from 'node:assert/strict';\\nimport { spawn } from 'node:child_process';\\nimport { once } from 'node:events';\\nimport { mkdtemp, rm } from 'node:fs/promises';\\nimport { tmpdir } from 'node:os';\\nimport { join } from 'node:path';\\n\\ntest('directory summary counts only resolved matches across scopes, filters, order and bulk actions', async () => {\\n  const temp = await mkdtemp(join(tmpdir(), 'workboard-summary-'));\\n  let child;\\n  try {\\n    child = spawn(process.execPath, ['server.js'], {\\n      env: { ...process.env, PORT: '0', DB_PATH: join(temp, 'db.sqlite') }, stdio: ['ignore', 'pipe', 'pipe']\\n    });\\n    const port = await new Promise((resolve, reject) => {\\n      let output = '';\\n      child.stdout.on('data', chunk => {\\n        output += chunk;\\n        const match = output.match(/listening on port (\\\\d+)/);\\n        if (match) resolve(match[1]);\\n      });\\n      child.once('error', reject);\\n      child.once('exit', code => reject(new Error(`Server exited: ${code}`)));\\n    });\\n    const base = `http://127.0.0.1:${port}`;\\n    const get = async path => (await fetch(base + path)).text();\\n    const post = async (path, values) => (await fetch(base + path, { method: 'POST', body: new URLSearchParams(values) })).text();\\n    const task = (title, completed, priority, dueDate, deleted = false) => ({ title, completed, priority, dueDate, deleted, notes: 'Literal <notes>' });\\n    for (const [index, archived] of [false, false, true].entries()) {\\n      await post('/projects/import', { importedName: `Owner ${index}`, projectJson: JSON.stringify({\\n        format: 'workboard-project', version: 1, project: { name: 'Portable', archived, defaultPriority: 'Normal', tasks: [\\n          task('Match A', false, 'High', '2024-02-29'),\\n          task('MATCH B', true, 'High', '2024-03-01'),\\n          task('Other', true, 'Low', ''),\\n          task('Match deleted', true, 'High', '2024-02-29', true),\\n          task('Other deleted', false, 'Normal', '', true)\\n        ] }\\n      }) });\\n    }\\n    const check = (html, expected) => {\\n      const summaries = [...html.matchAll(/data-testid=\\\"directory-summary\\\">([^<]*)<\\\\/p>/g)];\\n      assert.equal(summaries.length, 1);\\n      assert.equal(summaries[0][1], expected);\\n      const rows = [...html.matchAll(/data-testid=\\\"directory-task-row\\\"/g)].length;\\n      const completed = [...html.matchAll(/data-testid=\\\"directory-task-completion\\\">Completed/g)].length;\\n      assert.equal(expected, `${completed}/${rows} completed`);\\n      assert.equal(html.includes('No matching tasks'), rows === 0);\\n    };\\n    const snapshots = await Promise.all([1, 2, 3].map(id => get(`/projects/${id}/export`)));\\n    for (const order of ['Original', 'Priority', 'Due date', 'Title']) {\\n      check(await get('/directory?' + new URLSearchParams({ order })), '4/6 completed');\\n      check(await get('/directory?' + new URLSearchParams({ order, scope: 'Archived' })), '2/3 completed');\\n      check(await get('/directory?' + new URLSearchParams({ order, filter: 'Deleted' })), '2/4 completed');\\n    }\\n    check(await get('/directory?scope=Archived&filter=Deleted'), '1/2 completed');\\n    check(await get('/directory?filter=Open'), '0/2 completed');\\n    check(await get('/directory?filter=Completed'), '4/4 completed');\\n    check(await get('/directory?priorityFilter=Low'), '2/2 completed');\\n    check(await get('/directory?search=match'), '2/4 completed');\\n    check(await get('/directory?search=Literal'), '0/0 completed');\\n    check(await get('/directory?dueFrom=2024-02-29&dueThrough=2024-02-29'), '0/2 completed');\\n    const state = { scope: 'Active', filter: 'All', priorityFilter: 'High', search: 'match', dueFrom: '2024-02-29', dueThrough: '2024-03-01', order: 'Title' };\\n    check(await post('/directory/due-range', { ...state, from: '2023-02-29', through: '' }), '2/4 completed');\\n    assert.deepEqual(await Promise.all([1, 2, 3].map(id => get(`/projects/${id}/export`))), snapshots);\\n    check(await post('/directory/completion', { ...state, filter: 'Open', completed: '1' }), '0/0 completed');\\n    check(await get('/directory'), '6/6 completed');\\n    check(await post('/directory/completion', { ...state, filter: 'Completed', completed: '0' }), '0/0 completed');\\n    check(await get('/directory'), '2/6 completed');\\n    check(await get('/directory?filter=Deleted'), '2/4 completed');\\n    check(await get('/directory?scope=Archived'), '2/3 completed');\\n    check(await get('/directory?search=other&filter=Completed'), '2/2 completed');\\n  } finally {\\n    if (child && child.exitCode === null) { const exited = once(child, 'exit'); child.kill(); await exited; }\\n    await rm(temp, { recursive: true, force: true });\\n  }\\n});\\n\"}","status":"completed"}}

event: response.completed
data: {"type":"response.completed","sequence_number":1394,"safety_buffering":false,"response":{"id":"resp_00d34b706763c125016acbc7d4803081979689a099c8996953","object":"response","created_at":1791739860,"completed_at":1791739887,"status":"completed","background":false,"frequency_penalty":0.0,"presence_penalty":0.0,"moderation":null,"model":"gpt-6.1-sol","access_programs":{"cyber":"standard"},"previous_response_id":null,"instructions":"You are an expert coding assistant operating inside pi, a coding agent harness. You help users by reading files, executing commands, editing code, and writing new files.\n\n<tools>\n- read: Read file contents\n- bash: Execute bash commands (ls, grep, find, etc.)\n- edit: Make precise file edits with exact text replacement, including multiple disjoint edits in one call\n- write: Create or overwrite files\n\nIn addition to the tools above, you may have access to other custom tools depending on the project.\n</tools>\n\n<rules>\n- Use bash for file operations like ls, rg, find\n- Use read to examine files instead of cat or sed.\n- You can inspect PI_* environment variables for current model and session details.\n- Use edit for precise changes (edits[].oldText must match exactly)\n- When changing multiple separate locations in one file, use one edit call with multiple entries in edits[] instead of multiple edit calls\n- Each edits[].oldText is matched against the original file, not after earlier edits are applied. Do not emit overlapping or nested edits. Merge nearby changes into one edit.\n- Keep edits[].oldText as small as possible while still being unique in the file. Do not pad with large unchanged regions.\n- Use write only for new files or complete rewrites.\n- Be concise in your responses\n- Show file paths clearly when working with files\n</rules>\n\n<docs>\nPi documentation (read only when the user asks about pi itself, its SDK, extensions, themes, skills, or TUI):\n- Main documentation: /usr/local/share/npm-global/lib/node_modules/@earendil-works/pi-coding-agent/README.md\n- Additional docs: /usr/local/share/npm-global/lib/node_modules/@earendil-works/pi-coding-agent/docs\n- Examples: /usr/local/share/npm-global/lib/node_modules/@earendil-works/pi-coding-agent/examples (extensions, custom tools, SDK)\n- When reading pi docs or examples, resolve docs/... under Additional docs and examples/... under Examples, not the current working directory\n- When asked about: extensions (docs/extensions.md, examples/extensions/), themes (docs/themes.md), skills (docs/skills.md), prompt templates (docs/prompt-templates.md), TUI components (docs/tui.md), keybindings (docs/keybindings.md), SDK integrations (docs/sdk.md), custom providers (docs/custom-provider.md), adding models (docs/models.md), pi packages (docs/packages.md), environment variables (docs/environment-variables.md), MCP servers (docs/mcp.md), codemode scripts and non-LLM models such as classifiers and image models (docs/codemode.md)\n- When working on pi topics, read the docs and examples, and follow .md cross-references before implementing\n- Always read pi .md files completely and follow links to related docs (e.g., tui.md for TUI API details)\n</docs>\n\n<cwd>\n/home/agent/work\n</cwd>","output":[{"type":"function_call","id":"fc_00d34b706763c125016acbc7d5e0788197b66f9bcc95963670","call_id":"call_e46e4ee01dff412bacfa4a8ee962d473","name":"write","arguments":"{\"path\":\"test/directory-summary.test.js\",\"content\":\"import { test } from 'node:test';\\nimport assert from 'node:assert/strict';\\nimport { spawn } from 'node:child_process';\\nimport { once } from 'node:events';\\nimport { mkdtemp, rm } from 'node:fs/promises';\\nimport { tmpdir } from 'node:os';\\nimport { join } from 'node:path';\\n\\ntest('directory summary counts only resolved matches across scopes, filters, order and bulk actions', async () => {\\n  const temp = await mkdtemp(join(tmpdir(), 'workboard-summary-'));\\n  let child;\\n  try {\\n    child = spawn(process.execPath, ['server.js'], {\\n      env: { ...process.env, PORT: '0', DB_PATH: join(temp, 'db.sqlite') }, stdio: ['ignore', 'pipe', 'pipe']\\n    });\\n    const port = await new Promise((resolve, reject) => {\\n      let output = '';\\n      child.stdout.on('data', chunk => {\\n        output += chunk;\\n        const match = output.match(/listening on port (\\\\d+)/);\\n        if (match) resolve(match[1]);\\n      });\\n      child.once('error', reject);\\n      child.once('exit', code => reject(new Error(`Server exited: ${code}`)));\\n    });\\n    const base = `http://127.0.0.1:${port}`;\\n    const get = async path => (await fetch(base + path)).text();\\n    const post = async (path, values) => (await fetch(base + path, { method: 'POST', body: new URLSearchParams(values) })).text();\\n    const task = (title, completed, priority, dueDate, deleted = false) => ({ title, completed, priority, dueDate, deleted, notes: 'Literal <notes>' });\\n    for (const [index, archived] of [false, false, true].entries()) {\\n      await post('/projects/import', { importedName: `Owner ${index}`, projectJson: JSON.stringify({\\n        format: 'workboard-project', version: 1, project: { name: 'Portable', archived, defaultPriority: 'Normal', tasks: [\\n          task('Match A', false, 'High', '2024-02-29'),\\n          task('MATCH B', true, 'High', '2024-03-01'),\\n          task('Other', true, 'Low', ''),\\n          task('Match deleted', true, 'High', '2024-02-29', true),\\n          task('Other deleted', false, 'Normal', '', true)\\n        ] }\\n      }) });\\n    }\\n    const check = (html, expected) => {\\n      const summaries = [...html.matchAll(/data-testid=\\\"directory-summary\\\">([^<]*)<\\\\/p>/g)];\\n      assert.equal(summaries.length, 1);\\n      assert.equal(summaries[0][1], expected);\\n      const rows = [...html.matchAll(/data-testid=\\\"directory-task-row\\\"/g)].length;\\n      const completed = [...html.matchAll(/data-testid=\\\"directory-task-completion\\\">Completed/g)].length;\\n      assert.equal(expected, `${completed}/${rows} completed`);\\n      assert.equal(html.includes('No matching tasks'), rows === 0);\\n    };\\n    const snapshots = await Promise.all([1, 2, 3].map(id => get(`/projects/${id}/export`)));\\n    for (const order of ['Original', 'Priority', 'Due date', 'Title']) {\\n      check(await get('/directory?' + new URLSearchParams({ order })), '4/6 completed');\\n      check(await get('/directory?' + new URLSearchParams({ order, scope: 'Archived' })), '2/3 completed');\\n      check(await get('/directory?' + new URLSearchParams({ order, filter: 'Deleted' })), '2/4 completed');\\n    }\\n    check(await get('/directory?scope=Archived&filter=Deleted'), '1/2 completed');\\n    check(await get('/directory?filter=Open'), '0/2 completed');\\n    check(await get('/directory?filter=Completed'), '4/4 completed');\\n    check(await get('/directory?priorityFilter=Low'), '2/2 completed');\\n    check(await get('/directory?search=match'), '2/4 completed');\\n    check(await get('/directory?search=Literal'), '0/0 completed');\\n    check(await get('/directory?dueFrom=2024-02-29&dueThrough=2024-02-29'), '0/2 completed');\\n    const state = { scope: 'Active', filter: 'All', priorityFilter: 'High', search: 'match', dueFrom: '2024-02-29', dueThrough: '2024-03-01', order: 'Title' };\\n    check(await post('/directory/due-range', { ...state, from: '2023-02-29', through: '' }), '2/4 completed');\\n    assert.deepEqual(await Promise.all([1, 2, 3].map(id => get(`/projects/${id}/export`))), snapshots);\\n    check(await post('/directory/completion', { ...state, filter: 'Open', completed: '1' }), '0/0 completed');\\n    check(await get('/directory'), '6/6 completed');\\n    check(await post('/directory/completion', { ...state, filter: 'Completed', completed: '0' }), '0/0 completed');\\n    check(await get('/directory'), '2/6 completed');\\n    check(await get('/directory?filter=Deleted'), '2/4 completed');\\n    check(await get('/directory?scope=Archived'), '2/3 completed');\\n    check(await get('/directory?search=other&filter=Completed'), '2/2 completed');\\n  } finally {\\n    if (child && child.exitCode === null) { const exited = once(child, 'exit'); child.kill(); await exited; }\\n    await rm(temp, { recursive: true, force: true });\\n  }\\n});\\n\"}","status":"completed"}],"error":null,"incomplete_details":null,"tools":[{"type":"function","name":"read","description":"Read the contents of a file. Supports text files and images (jpg, png, gif, webp, bmp). Images are sent as attachments. For text files, output is truncated to 2000 lines or 50KB (whichever is hit first). Use offset/limit for large files. When you need the full file, continue with offset until complete.","parameters":{"type":"object","required":["path","offset","limit"],"properties":{"path":{"type":"string","description":"Path to the file to read (relative or absolute)"},"offset":{"anyOf":[{"type":"number","description":"Line number to start reading from (1-indexed)"},{"type":"null"}]},"limit":{"anyOf":[{"type":"number","description":"Maximum number of lines to read"},{"type":"null"}]}},"additionalProperties":false},"output_schema":null,"strict":true},{"type":"function","name":"bash","description":"Execute a bash command in the current working directory. Returns stdout and stderr. Output is truncated to last 2000 lines or 50KB (whichever is hit first). If truncated, full output is saved to a temp file. Optionally provide a timeout in seconds.","parameters":{"type":"object","required":["command","timeout"],"properties":{"command":{"type":"string","description":"Shell command to execute"},"timeout":{"anyOf":[{"type":"number","description":"Timeout in seconds (optional, no default timeout)"},{"type":"null"}]}},"additionalProperties":false},"output_schema":null,"strict":true},{"type":"function","name":"edit","description":"Edit a single file using exact text replacement. Every edits[].oldText must match a unique, non-overlapping region of the original file. If two changes affect the same block or nearby lines, merge them into one edit instead of emitting overlapping edits. Do not include large unchanged regions just to connect distant changes.","parameters":{"type":"object","required":["path","edits"],"properties":{"path":{"type":"string","description":"Path to the file to edit (relative or absolute)"},"edits":{"type":"array","items":{"type":"object","required":["oldText","newText"],"properties":{"oldText":{"type":"string","description":"Exact text for one targeted replacement. It must be unique in the original file and must not overlap with any other edits[].oldText in the same call."},"newText":{"type":"string","description":"Replacement text for this targeted edit."}},"additionalProperties":false},"description":"One or more targeted replacements. Each edit is matched against the original file, not incrementally. Do not include overlapping or nested edits. If two changes touch the same block or nearby lines, merge them into one edit instead."}},"additionalProperties":false},"output_schema":null,"strict":true},{"type":"function","name":"write","description":"Write content to a file. Creates the file if it doesn't exist, overwrites if it does. Automatically creates parent directories.","parameters":{"type":"object","required":["path","content"],"properties":{"path":{"type":"string","description":"Path to the file to write (relative or absolute)"},"content":{"type":"string","description":"Content to write to the file"}},"additionalProperties":false},"output_schema":null,"strict":true}],"tool_choice":"auto","parallel_tool_calls":true,"prompt_cache_key":"9ffa759b-a39e-4c19-9605-0a01a593fe57","prompt_cache_retention":"24h","text":{"format":{"type":"text"},"verbosity":"low"},"top_p":0.98,"top_logprobs":0,"temperature":1.0,"reasoning":{"effort":"medium","summary":"detailed","context":"all_turns","mode":"standard"},"user":null,"usage":{"input_tokens":13210,"input_tokens_details":{"cached_tokens":0,"cache_write_tokens":0},"output_tokens":1401,"output_tokens_details":{"reasoning_tokens":0},"total_tokens":14611,"attribution":{"items":{"fc_00d34b706763c125016acbc7c25b48819796f824a1a644944b":{"input_tokens":42,"cached_tokens":0,"cache_write_tokens":0,"output_tokens":0},"fc_00d34b706763c125016acbc7c5f23c8197893646ab50d1d11f":{"input_tokens":40,"cached_tokens":0,"cache_write_tokens":0,"output_tokens":0},"fc_00d34b706763c125016acbc7c8b4f48197b11ac94fec4339b6":{"input_tokens":28,"cached_tokens":0,"cache_write_tokens":0,"output_tokens":0},"fc_00d34b706763c125016acbc7cc507481978001bc45ec8cf8b8":{"input_tokens":42,"cached_tokens":0,"cache_write_tokens":0,"output_tokens":0},"fc_00d34b706763c125016acbc7ce4e6c819782c003eb6cf7330a":{"input_tokens":26,"cached_tokens":0,"cache_write_tokens":0,"output_tokens":0},"fc_00d34b706763c125016acbc7ce4e6c8197975540b24aa23879":{"input_tokens":22,"cached_tokens":0,"cache_write_tokens":0,"output_tokens":0},"fc_00d34b706763c125016acbc7ce4e6c8197b9c29484f7f40e74":{"input_tokens":24,"cached_tokens":0,"cache_write_tokens":0,"output_tokens":0},"fc_00d34b706763c125016acbc7d2445881979427a6a10a0f25bb":{"input_tokens":104,"cached_tokens":0,"cache_write_tokens":0,"output_tokens":0},"fc_00d34b706763c125016acbc7d480ac81978e93a712000da4c0":{"input_tokens":19,"cached_tokens":0,"cache_write_tokens":0,"output_tokens":0,"content":[{"input_tokens":19,"cached_tokens":0,"cache_write_tokens":0,"output_tokens":0}]},"fc_00d34b706763c125016acbc7d480ac8197945b203815ecd2a3":{"input_tokens":67,"cached_tokens":0,"cache_write_tokens":0,"output_tokens":0,"content":[{"input_tokens":67,"cached_tokens":0,"cache_write_tokens":0,"output_tokens":0}]},"fc_00d34b706763c125016acbc7d480ac8197960cb7bbf80af9c8":{"input_tokens":1100,"cached_tokens":0,"cache_write_tokens":0,"output_tokens":0,"content":[{"input_tokens":1100,"cached_tokens":0,"cache_write_tokens":0,"output_tokens":0}]},"fc_00d34b706763c125016acbc7d480ac81979c778bc0aea1d477":{"input_tokens":933,"cached_tokens":0,"cache_