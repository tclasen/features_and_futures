,"fc_03119e3e9f980435016acbc7cdc6ec87d19c163f205865c062":{"cache_write_tokens":0,"cached_tokens":0,"input_tokens":28,"output_tokens":0},"fc_03119e3e9f980435016acbc7d2bf7c87d1b30dace236691994":{"cache_write_tokens":0,"cached_tokens":0,"content":[{"cache_write_tokens":0,"cached_tokens":0,"input_tokens":1596,"output_tokens":0}],"input_tokens":1596,"output_tokens":0},"rs_03119e3e9f980435016acbc7d0022887d1a75a5115a9ad4edf":{"cache_write_tokens":0,"cached_tokens":0,"input_tokens":25,"output_tokens":0},"fc_03119e3e9f980435016acbc7d1653887d1835fa6c1e7483b12":{"cache_write_tokens":0,"cached_tokens":0,"input_tokens":88,"output_tokens":0},"fc_03119e3e9f980435016acbc7d2c08487d19e52fc72cdce49ae":{"cache_write_tokens":0,"cached_tokens":0,"content":[{"cache_write_tokens":0,"cached_tokens":0,"input_tokens":19,"output_tokens":0}],"input_tokens":19,"output_tokens":0},"fc_03119e3e9f980435016acbc7d4780887d19a6cc828879cd3e7":{"cache_write_tokens":0,"cached_tokens":0,"input_tokens":2,"output_tokens":1832}},"request_fields":{"tools":{"cache_write_tokens":0,"cached_tokens":0,"input_tokens":493,"output_tokens":0},"instructions":{"cache_write_tokens":0,"cached_tokens":0,"input_tokens":649,"output_tokens":0}}},"input_tokens":13942,"input_tokens_details":{"cache_write_tokens":0,"cached_tokens":0},"output_tokens":1832,"output_tokens_details":{"reasoning_tokens":0},"total_tokens":15774},"user":null,"metadata":{}},"sequence_number":1825}
