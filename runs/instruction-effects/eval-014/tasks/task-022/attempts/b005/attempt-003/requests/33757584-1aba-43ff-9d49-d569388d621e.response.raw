from 'node:test';\\nimport assert from 'node:assert/strict';\\nimport { runInNewContext } from 'node:vm';\\nimport { renderProject } from '../views.js';\\n\\nconst project = { id: 'project', name: 'Range intersections', default_task_priority: 'Normal', archived: false };\\nconst task = { id: 'task', title: 'Range completed', completed: true, priority: 'High', due_date: '2029-01-15', notes: '', deleted: false };\\n\\nfunction completionPage() {\\n  return renderProject(project, [task], 'Completed', '', 'High', { from: '2029-01-01', through: '2029-01-31' });\\n}\\n\\nconst flush = () => new Promise((resolve) => setImmediate(resolve));\\n\\nfunction browserHarness() {\\n  const timers = new Map();\\n  const requests = [];\\n  const navigations = [];\\n  const submissions = [];\\n  const alerts = [];\\n  let onSubmit;\\n  let nextTimer = 0;\\n  const context = {\\n    URLSearchParams,\\n    FormData: class {\\n      constructor(form) { this.fields = Object.entries(form.fields); }\\n      [Symbol.iterator]() { return this.fields[Symbol.iterator](); }\\n    },\\n    fetch(action, options) {\\n      return new Promise((resolve) => requests.push({ action, options, resolve }));\\n    },\\n    HTMLFormElement: { prototype: { submit() { submissions.push(this.action); } } },\\n    document: {\\n      addEventListener(type, listener) { assert.equal(type, 'submit'); onSubmit = listener; },\\n      createElement() { return { setAttribute() {} }; },\\n      querySelector() { return { prepend(alert) { alerts.push(alert.textContent); } }; },\\n    },\\n    window: { location: { assign(url) { navigations.push(url); } } },\\n    setTimeout(callback, delay) {\\n      assert.equal(delay, 150);\\n      timers.set(++nextTimer, callback);\\n      return nextTimer;\\n    },\\n    clearTimeout(timer) { timers.delete(timer); },\\n  };\\n  runInNewContext(completionPage().match(/<script>([\\\\s\\\\S]*?)<\\\\/script>/)[1], context);\\n  return {\\n    context, timers, requests, navigations, submissions, alerts,\\n    submit(form) {\\n      let prevented = false;\\n      const result = onSubmit({ target: form, preventDefault() { prevented = true; } });\\n      assert.equal(prevented, true);\\n      return result;\\n    },\\n    resolve(index = 0, ok = true) { requests[index].resolve({ ok, url: '/projects/project?filter=Completed' }); },\\n    runTimer() {\\n      const [id, callback] = [...timers.entries()][0];\\n      timers.delete(id);\\n      return callback();\\n    },\\n  };\\n}\\n\\nfunction completionForm(completed = '1') {\\n  return { action: '/projects/project/tasks/task', fields: { completed, filter: 'Completed', priorityFilter: 'High' } };\\n}\\n\\ntest('completion persistence starts immediately but navigation waits for native checkbox interaction', async () => {\\n  const browser = browserHarness();\\n  browser.context.deferCompletionSubmit(completionForm());\\n  assert.deepEqual(browser.navigations, []);\\n  await flush();\\n  assert.equal(browser.requests[0].options.body.get('completed'), '1');\\n  browser.resolve();\\n  await flush();\\n  assert.deepEqual(browser.navigations, []);\\n  await browser.runTimer();\\n  assert.deepEqual(browser.navigations, ['/projects/project?filter=Completed']);\\n\\n  const html = completionPage();\\n  assert.match(html, /aria-label=\\\"Complete Range completed\\\"[^>]*onchange=\\\"deferCompletionSubmit\\\\(this.form\\\\)\\\"/);\\n  const form = html.match(/<form method=\\\"post\\\" action=\\\"\\\\/projects\\\\/project\\\\/tasks\\\\/task\\\">([\\\\s\\\\S]*?)<\\\\/form>/)[1];\\n  for (const [name, value] of Object.entries({ filter: 'Completed', priorityFilter: 'High', dueFrom: '2029-01-01', dueThrough: '2029-01-31' })) {\\n    assert.ok(form.includes(`name=\\\"${name}\\\" value=\\\"${value}\\\"`));\\n  }\\n});\\n\\ntest('quick deletion, edits, filters and export wait for completion to be saved', async () => {\\n  for (const action of ['tasks/task/delete', 'tasks/task/priority', 'tasks/task/notes', 'export', '']) {\\n    const browser = browserHarness();\\n    browser.context.deferCompletionSubmit(completionForm());\\n    const nextAction = `/projects/project/${action}`;\\n    const submitting = browser.submit({ action: nextAction });\\n    await flush();\\n    assert.deepEqual(browser.submissions, [], 'later action must not overtake completion');\\n    assert.equal(browser.timers.size, 0, 'later action cancels delayed navigation');\\n    browser.resolve();\\n    await submitting;\\n    assert.deepEqual(browser.submissions, [nextAction]);\\n    assert.deepEqual(browser.navigations, []);\\n  }\\n});\\n\\ntest('a later form also wins while completion navigation is already waiting for its response', async () => {\\n  const browser = browserHarness();\\n  browser.context.deferCompletionSubmit(completionForm());\\n  await flush();\\n  const navigation = browser.runTimer();\\n  const deletion = browser.submit({ action: '/projects/project/tasks/task/delete' });\\n  browser.resolve();\\n  await Promise.all([navigation, deletion]);\\n  assert.deepEqual(browser.navigations, []);\\n  assert.deepEqual(browser.submissions, ['/projects/project/tasks/task/delete']);\\n});\\n\\ntest('rapid toggles save snapshots sequentially and later actions wait for the final state', async () => {\\n  const browser = browserHarness();\\n  const form = completionForm('1');\\n  browser.context.deferCompletionSubmit(form);\\n  form.fields.completed = '';\\n  browser.context.deferCompletionSubmit(form);\\n  assert.equal(browser.timers.size, 1);\\n  const deletion = browser.submit({ action: '/projects/project/tasks/task/delete' });\\n  await flush();\\n  assert.equal(browser.requests.length, 1);\\n  assert.equal(browser.requests[0].options.body.get('completed'), '1');\\n  browser.resolve();\\n  await flush();\\n  assert.equal(browser.requests.length, 2);\\n  assert.equal(browser.requests[1].options.body.get('completed'), '');\\n  assert.deepEqual(browser.submissions, []);\\n  browser.resolve(1);\\n  await deletion;\\n  assert.equal(browser.submissions.length, 1);\\n});\\n\\ntest('failed completion saves show an alert and do not permit a later action', async () => {\\n  const browser = browserHarness();\\n  browser.context.deferCompletionSubmit(completionForm());\\n  const deletion = browser.submit({ action: '/projects/project/tasks/task/delete' });\\n  await flush();\\n  browser.resolve(0, false);\\n  await deletion;\\n  assert.deepEqual(browser.submissions, []);\\n  assert.equal(browser.alerts.length, 1);\\n  assert.match(browser.alerts[0], /Could not save task completion/);\\n});\\n\\ntest('archived and deleted completion checkboxes remain disabled', () => {\\n  for (const [owner, record] of [[{ ...project, archived: true }, task], [project, { ...task, deleted: true }]]) {\\n    assert.match(renderProject(owner, [record]), /type=\\\"checkbox\\\"[^>]* disabled[^>]*onchange=\\\"deferCompletionSubmit\\\\(this.form\\\\)\\\"/);\\n  }\\n});\\n\"}","status":"completed"}],"error":null,"incomplete_details":null,"tools":[{"type":"function","name":"read","description":"Read the contents of a file. Supports text files and images (jpg, png, gif, webp, bmp). Images are sent as attachments. For text files, output is truncated to 2000 lines or 50KB (whichever is hit first). Use offset/limit for large files. When you need the full file, continue with offset until complete.","parameters":{"type":"object","required":["path","offset","limit"],"properties":{"path":{"type":"string","description":"Path to the file to read (relative or absolute)"},"offset":{"anyOf":[{"type":"number","description":"Line number to start reading from (1-indexed)"},{"type":"null"}]},"limit":{"anyOf":[{"type":"number","description":"Maximum number of lines to read"},{"type":"null"}]}},"additionalProperties":false},"output_schema":null,"strict":true},{"type":"function","name":"bash","description":"Execute a bash command in the current working directory. Returns stdout and stderr. Output is truncated to last 2000 lines or 50KB (whichever is hit first). If truncated, full output is saved to a temp file. Optionally provide a timeout in seconds.","parameters":{"type":"object","required":["command","timeout"],"properties":{"command":{"type":"string","description":"Shell command to execute"},"timeout":{"anyOf":[{"type":"number","description":"Timeout in seconds (optional, no default timeout)"},{"type":"null"}]}},"additionalProperties":false},"output_schema":null,"strict":true},{"type":"function","name":"edit","description":"Edit a single file using exact text replacement. Every edits[].oldText must match a unique, non-overlapping region of the original file. If two changes affect the same block or nearby lines, merge them into one edit instead of emitting overlapping edits. Do not include large unchanged regions just to connect distant changes.","parameters":{"type":"object","required":["path","edits"],"properties":{"path":{"type":"string","description":"Path to the file to edit (relative or absolute)"},"edits":{"type":"array","items":{"type":"object","required":["oldText","newText"],"properties":{"oldText":{"type":"string","description":"Exact text for one targeted replacement. It must be unique in the original file and must not overlap with any other edits[].oldText in the same call."},"newText":{"type":"string","description":"Replacement text for this targeted edit."}},"additionalProperties":false},"description":"One or more targeted replacements. Each edit is matched against the original file, not incrementally. Do not include overlapping or nested edits. If two changes touch the same block or nearby lines, merge them into one edit instead."}},"additionalProperties":false},"output_schema":null,"strict":true},{"type":"function","name":"write","description":"Write content to a file. Creates the file if it doesn't exist, overwrites if it does. Automatically creates parent directories.","parameters":{"type":"object","required":["path","content"],"properties":{"path":{"type":"string","description":"Path to the file to write (relative or absolute)"},"content":{"type":"string","description":"Content to write to the file"}},"additionalProperties":false},"output_schema":null,"strict":true}],"tool_choice":"auto","parallel_tool_calls":true,"prompt_cache_key":"241b82fa-d057-4ee4-aa5c-28811a66609a","prompt_cache_retention":"24h","text":{"format":{"type":"text"},"verbosity":"low"},"top_p":0.98,"top_logprobs":0,"temperature":1.0,"reasoning":{"effort":"medium","summary":"detailed","context":"all_turns","mode":"standard"},"user":null,"usage":{"input_tokens":19992,"input_tokens_details":{"cached_tokens":0,"cache_write_tokens":0},"output_tokens":1897,"output_tokens_details":{"reasoning_tokens":88},"total_tokens":21889,"attribution":{"items":{"fc_022ad883f78adc35016acbcbb2b66087d2abed67df6c7c9286":{"input_tokens":34,"cached_tokens":0,"cache_write_tokens":0,"output_tokens":0},"fc_022ad883f78adc35016acbcbb585c887d29adaf0946234959a":{"input_tokens":28,"cached_tokens":0,"cache_write_tokens":0,"output_tokens":0},"fc_022ad883f78adc35016acbcbc3b1dc87d28e4aef02e72dcb1c":{"input_tokens":53,"cached_tokens":0,"cache_write_tokens":0,"output_tokens":0},"fc_022ad883f78adc35016acbcbd18ee887d28ba2f1f4fad91531":{"input_tokens":33,"cached_tokens":0,"cache_write_tokens":0,"output_tokens":0},"fc_022ad883f78adc35016acbcbdbb1d887d287fa9f35688bfb92":{"input_tokens":540,"cached_tokens":0,"cache_write_tokens":0,"output_tokens":0},"fc_022ad883f78adc35016acbcbe7b8e887d2899528f9f52340b0":{"input_tokens":4934,"cached_tokens":0,"cache_write_tokens":0,"output_tokens":0,"content":[{"input_tokens":4934,"cached_tokens":0,"cache_write_tokens":0,"output_tokens":0}]},"fc_022ad883f78adc35016acbcbe7b8e887d28b7da236211f7d0a":{"input_tokens":642,"cached_tokens":0,"cache_write_tokens":0,"output_tokens":0,"content":[{"input_tokens":642,"cached_tokens":0,"cache_write_tokens":0,"output_tokens":0}]},"fc_022ad883f78adc35016acbcbe7b8e887d29375c55189d90409":{"input_tokens":344,"cached_tokens":0,"cache_wri