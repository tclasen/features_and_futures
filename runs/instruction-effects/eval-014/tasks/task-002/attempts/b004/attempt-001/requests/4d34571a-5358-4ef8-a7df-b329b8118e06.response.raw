data: {"type":"response.function_call_arguments.done","sequence_number":2589,"item_id":"fc_043fe58e78f450c0016acb98eaada48196b931130080451e1d","output_index":1,"arguments":"{\"path\":\"server.js\",\"content\":\"import http from 'node:http';\\nimport { DatabaseSync } from 'node:sqlite';\\nimport { mkdirSync } from 'node:fs';\\nimport { dirname, resolve } from 'node:path';\\n\\nconst dbPath = resolve(process.env.DB_PATH || './data/workboard.sqlite');\\nmkdirSync(dirname(dbPath), { recursive: true });\\nconst db = new DatabaseSync(dbPath);\\ndb.exec(`CREATE TABLE IF NOT EXISTS projects (\\n  id INTEGER PRIMARY KEY AUTOINCREMENT,\\n  name TEXT NOT NULL,\\n  created_at TEXT NOT NULL DEFAULT CURRENT_TIMESTAMP\\n);\\nCREATE TABLE IF NOT EXISTS tasks (\\n  id INTEGER PRIMARY KEY AUTOINCREMENT,\\n  project_id INTEGER NOT NULL REFERENCES projects(id) ON DELETE CASCADE,\\n  title TEXT NOT NULL,\\n  completed INTEGER NOT NULL DEFAULT 0\\n)`);\\n\\nconst html = `<!doctype html>\\n<html lang=\\\"en\\\"><head><meta charset=\\\"utf-8\\\"><meta name=\\\"viewport\\\" content=\\\"width=device-width, initial-scale=1\\\"><title>Workboard</title>\\n<style>\\n*{box-sizing:border-box}body{margin:0;background:#f5f7fb;color:#172033;font:16px/1.5 system-ui,-apple-system,\\\"Segoe UI\\\",sans-serif}header{background:#fff;border-bottom:1px solid #e1e6ef;padding:18px max(24px,calc((100% - 900px)/2));font-size:20px;font-weight:700}.container{max-width:900px;margin:48px auto;padding:0 24px}h1{font-size:32px;margin:0 0 24px}form{display:flex;gap:12px;max-width:600px;margin-bottom:24px}input,select{border:1px solid #b9c3d2;border-radius:6px;padding:11px 12px;font:inherit}input{flex:1;min-width:0}button{border:0;border-radius:6px;background:#265bd5;color:white;padding:11px 16px;font:600 15px inherit;cursor:pointer}button:hover{background:#1949b7}.row{background:white;border:1px solid #e1e6ef;border-radius:8px;padding:16px;margin:10px 0;display:flex;align-items:center;justify-content:space-between}.row button{padding:8px 14px}.alert{color:#a32626;margin:0 0 14px}[hidden]{display:none}.task-label{display:flex;align-items:center;gap:12px}.task-label input{flex:initial}\\n</style></head><body><header>Workboard</header><main class=\\\"container\\\" id=\\\"app\\\"></main>\\n<script>\\nconst app=document.getElementById('app');\\nfunction escapeHtml(value){return String(value).replace(/[&<>\\\"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','\\\"':'&quot;',\\\"'\\\":'&#39;'}[c]));}\\nasync function render(){const match=location.pathname.match(/^\\\\\\\\/projects\\\\\\\\/(\\\\\\\\d+)\\\\\\\\/?$/);if(match){const response=await fetch('/api/projects/'+match[1]);if(!response.ok){history.replaceState({},'', '/');return render()}const p=await response.json();app.innerHTML='<button id=\\\"back\\\">Projects</button><h1>'+escapeHtml(p.name)+'</h1><form id=\\\"create-task\\\"><input id=\\\"task-title\\\" aria-label=\\\"Task title\\\" placeholder=\\\"Task title\\\"><button type=\\\"submit\\\">Create task</button></form><p class=\\\"alert\\\" id=\\\"task-alert\\\" role=\\\"alert\\\" hidden></p><label>Task filter <select id=\\\"task-filter\\\"><option>All</option><option>Open</option><option>Completed</option></select></label><section id=\\\"tasks\\\"></section>';document.getElementById('back').onclick=()=>{history.pushState({},'','/');render()};const filter=document.getElementById('task-filter');async function loadTasks(){const tasks=await(await fetch('/api/projects/'+p.id+'/tasks')).json();const shown=tasks.filter(t=>filter.value==='All'||(filter.value==='Completed')===Boolean(t.completed));document.getElementById('tasks').innerHTML=shown.map(t=>'<div class=\\\"row\\\" data-testid=\\\"task-row\\\"><span>'+escapeHtml(t.title)+'</span><label class=\\\"task-label\\\"><input type=\\\"checkbox\\\" aria-label=\\\"Complete '+escapeHtml(t.title)+'\\\" data-id=\\\"'+t.id+'\\\" '+(t.completed?'checked':'')+'></label></div>').join('');document.querySelectorAll('#tasks input').forEach(box=>box.onchange=async()=>{await fetch('/api/tasks/'+box.dataset.id,{method:'PATCH',headers:{'content-type':'application/json'},body:JSON.stringify({completed:box.checked})});loadTasks()})}filter.onchange=loadTasks;document.getElementById('create-task').onsubmit=async e=>{e.preventDefault();const input=document.getElementById('task-title'),title=input.value.trim(),alert=document.getElementById('task-alert');if(!title){alert.textContent='Task title is required';alert.hidden=false;return}const r=await fetch('/api/projects/'+p.id+'/tasks',{method:'POST',headers:{'content-type':'application/json'},body:JSON.stringify({title})});if(r.ok){input.value='';alert.hidden=true;loadTasks()}};loadTasks();return}\\nconst response=await fetch('/api/projects');const projects=await response.json();app.innerHTML='<h1>Workboard</h1><form id=\\\"create\\\"><input id=\\\"name\\\" aria-label=\\\"Project name\\\" placeholder=\\\"Project name\\\"><button type=\\\"submit\\\">Create project</button></form><p class=\\\"alert\\\" id=\\\"alert\\\" role=\\\"alert\\\" hidden></p><section id=\\\"projects\\\"></section>';const list=document.getElementById('projects');list.innerHTML=projects.map(p=>'<div class=\\\"row\\\" data-testid=\\\"project-row\\\"><span>'+escapeHtml(p.name)+'</span><button data-id=\\\"'+p.id+'\\\">Open project</button></div>').join('');list.querySelectorAll('button').forEach(b=>b.onclick=()=>{history.pushState({},'','/projects/'+b.dataset.id);render()});document.getElementById('create').onsubmit=async e=>{e.preventDefault();const input=document.getElementById('name'),name=input.value.trim(),alert=document.getElementById('alert');if(!name){alert.textContent='Project name is required';alert.hidden=false;return}const r=await fetch('/api/projects',{method:'POST',headers:{'content-type':'application/json'},body:JSON.stringify({name})});if(r.ok)render()};}\\naddEventListener('popstate',render);render();\\n</script></main></body></html>`;\\n\\nfunction send(res, status, data, contentType = 'application/json; charset=utf-8') {\\n  res.writeHead(status, { 'content-type': contentType, 'cache-control': 'no-store' });\\n  res.end(typeof data === 'string' ? data : JSON.stringify(data));\\n}\\nasync function readBody(req) {\\n  let body = '';\\n  for await (const chunk of req) { body += chunk; if (body.length > 100_000) throw new Error('Request too large'); }\\n  return JSON.parse(body);\\n}\\nconst server = http.createServer(async (req, res) => {\\n  const url = new URL(req.url, 'http://localhost');\\n  if (req.method === 'GET' && url.pathname === '/health') return send(res, 200, { status: 'ok' });\\n  if (req.method === 'GET' && url.pathname === '/api/projects') return send(res, 200, db.prepare('SELECT id, name FROM projects ORDER BY id').all());\\n  const projectItem = url.pathname.match(/^\\\\/api\\\\/projects\\\\/(\\\\d+)$/);\\n  const projectTasks = url.pathname.match(/^\\\\/api\\\\/projects\\\\/(\\\\d+)\\\\/tasks$/);\\n  if (req.method === 'GET' && projectItem) {\\n    const project = db.prepare('SELECT id, name FROM projects WHERE id = ?').get(Number(projectItem[1]));\\n    return project ? send(res, 200, project) : send(res, 404, { error: 'Not found' });\\n  }\\n  if (req.method === 'GET' && projectTasks) {\\n    const id = Number(projectTasks[1]);\\n    if (!db.prepare('SELECT id FROM projects WHERE id = ?').get(id)) return send(res, 404, { error: 'Not found' });\\n    return send(res, 200, db.prepare('SELECT id, title, completed FROM tasks WHERE project_id = ? ORDER BY id').all(id));\\n  }\\n  if (req.method === 'POST' && projectTasks) {\\n    try {\\n      const projectId = Number(projectTasks[1]);\\n      if (!db.prepare('SELECT id FROM projects WHERE id = ?').get(projectId)) return send(res, 404, { error: 'Not found' });\\n      const title = String((await readBody(req)).title ?? '').trim();\\n      if (!title) return send(res, 400, { error: 'Task title is required' });\\n      const result = db.prepare('INSERT INTO tasks (project_id, title) VALUES (?, ?)').run(projectId, title);\\n      return send(res, 201, db.prepare('SELECT id, title, completed FROM tasks WHERE id = ?').get(Number(result.lastInsertRowid)));\\n    } catch { return send(res, 400, { error: 'Invalid request' }); }\\n  }\\n  const taskItem = url.pathname.match(/^\\\\/api\\\\/tasks\\\\/(\\\\d+)$/);\\n  if (req.method === 'PATCH' && taskItem) {\\n    try {\\n      const completed = (await readBody(req)).completed;\\n      if (typeof completed !== 'boolean') return send(res, 400, { error: 'Invalid completion state' });\\n      const result = db.prepare('UPDATE tasks SET completed = ? WHERE id = ?').run(completed ? 1 : 0, Number(taskItem[1]));\\n      if (!result.changes) return send(res, 404, { error: 'Not found' });\\n      return send(res, 200, db.prepare('SELECT id, title, completed FROM tasks WHERE id = ?').get(Number(taskItem[1])));\\n    } catch { return send(res, 400, { error: 'Invalid request' }); }\\n  }\\n  if (req.method === 'POST' && url.pathname === '/api/projects') {\\n    try {\\n      const name = String((await readBody(req)).name ?? '').trim();\\n      if (!name) return send(res, 400, { error: 'Project name is required' });\\n      const result = db.prepare('INSERT INTO projects (name) VALUES (?)').run(name);\\n      return send(res, 201, db.prepare('SELECT id, name FROM projects WHERE id = ?').get(Number(result.lastInsertRowid)));\\n    } catch { return send(res, 400, { error: 'Invalid request' }); }\\n  }\\n  if (req.method === 'GET' && (url.pathname === '/' || url.pathname.startsWith('/projects/'))) return send(res, 200, html, 'text/html; charset=utf-8');\\n  send(res, 404, { error: 'Not found' });\\n});\\nconst port = Number(process.env.PORT || 8080);\\nserver.listen(port, '0.0.0.0');\\n\"}"}

