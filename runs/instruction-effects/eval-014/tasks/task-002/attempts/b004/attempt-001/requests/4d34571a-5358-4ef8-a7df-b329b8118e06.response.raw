margin:10px 0;display:flex;align-items:center;justify-content:space-between}.row button{padding:8px 14px}.alert{color:#a32626;margin:0 0 14px}[hidden]{display:none}.task-label{display:flex;align-items:center;gap:12px}.task-label input{flex:initial}\\n</style></head><body><header>Workboard</header><main class=\\\"container\\\" id=\\\"app\\\"></main>\\n<script>\\nconst app=document.getElementById('app');\\nfunction escapeHtml(value){return String(value).replace(/[&<>\\\"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','\\\"':'&quot;',\\\"'\\\":'&#39;'}[c]));}\\nasync function render(){const match=location.pathname.match(/^\\\\\\\\/projects\\\\\\\\/(\\\\\\\\d+)\\\\\\\\/?$/);if(match){const response=await fetch('/api/projects/'+match[1]);if(!response.ok){history.replaceState({},'', '/');return render()}const p=await response.json();app.innerHTML='<button id=\\\"back\\\">Projects</button><h1>'+escapeHtml(p.name)+'</h1><form id=\\\"create-task\\\"><input id=\\\"task-title\\\" aria-label=\\\"Task title\\\" placeholder=\\\"Task title\\\"><button type=\\\"submit\\\">Create task</button></form><p class=\\\"alert\\\" id=\\\"task-alert\\\" role=\\\"alert\\\" hidden></p><label>Task filter <select id=\\\"task-filter\\\"><option>All</option><option>Open</option><option>Completed</option></select></label><section id=\\\"tasks\\\"></section>';document.getElementById('back').onclick=()=>{history.pushState({},'','/');render()};const filter=document.getElementById('task-filter');async function loadTasks(){const tasks=await(await fetch('/api/projects/'+p.id+'/tasks')).json();const shown=tasks.filter(t=>filter.value==='All'||(filter.value==='Completed')===Boolean(t.completed));document.getElementById('tasks').innerHTML=shown.map(t=>'<div class=\\\"row\\\" data-testid=\\\"task-row\\\"><span>'+escapeHtml(t.title)+'</span><label class=\\\"task-label\\\"><input type=\\\"checkbox\\\" aria-label=\\\"Complete '+escapeHtml(t.title)+'\\\" data-id=\\\"'+t.id+'\\\" '+(t.completed?'checked':'')+'></label