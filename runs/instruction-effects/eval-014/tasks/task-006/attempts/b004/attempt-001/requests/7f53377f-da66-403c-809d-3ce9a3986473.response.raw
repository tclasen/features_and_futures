data: {"type":"response.function_call_arguments.done","sequence_number":717,"item_id":"fc_0948cabe6306d94a016acb9c97545087d1863c2f4f63f0c4f4","output_index":0,"arguments":"{\"path\":\"server.js\",\"edits\":[{\"oldText\":\"try { db.exec('ALTER TABLE projects ADD COLUMN archived INTEGER NOT NULL DEFAULT 0'); } catch {}\",\"newText\":\"try { db.exec('ALTER TABLE projects ADD COLUMN archived INTEGER NOT NULL DEFAULT 0'); } catch {}\\ntry { db.exec(\\\"ALTER TABLE tasks ADD COLUMN priority TEXT NOT NULL DEFAULT 'Normal'\\\"); } catch {}\"},{\"oldText\":\"+'<button data-rename=\\\"'+t.id+'\\\"'+(p.archived?' disabled':'')+'>Rename task</button></div>').join('')\",\"newText\":\"+'<button data-rename=\\\"'+t.id+'\\\"'+(p.archived?' disabled':'')+'>Rename task</button><select aria-label=\\\"Task priority\\\" data-priority=\\\"'+t.id+'\\\"'+(p.archived?' disabled':'')+'><option'+(t.priority==='Low'?' selected':'')+'>Low</option><option'+(t.priority==='Normal'?' selected':'')+'>Normal</option><option'+(t.priority==='High'?' selected':'')+'>High</option></select></div>').join('')\"},{\"oldText\":\"});document.querySelectorAll('#tasks [data-rename]').forEach(button=>button.onclick=\",\"newText\":\"});document.querySelectorAll('#tasks [data-priority]').forEach(select=>select.onchange=()=>fetch('/api/tasks/'+select.dataset.priority,{method:'PATCH',headers:{'content-type':'application/json'},body:JSON.stringify({priority:select.value})}));document.querySelectorAll('#tasks [data-rename]').forEach(button=>button.onclick=\"},{\"oldText\":\"SELECT id, title, completed FROM tasks WHERE project_id = ? ORDER BY id\",\"newText\":\"SELECT id, title, completed, priority FROM tasks WHERE project_id = ? ORDER BY id\"},{\"oldText\":\"SELECT id, title, completed FROM tasks WHERE id = ?\",\"newText\":\"SELECT id, title, completed, priority FROM tasks WHERE id = ?\"},{\"oldText\":\"      if (Object.hasOwn(body, 'title')) {\",\"newText\":\"      if (Object.hasOwn(body, 'priority')) {\\n        if (!['Low', 'Normal', 'High'].includes(body.priority)) return send(res, 400, { error: 'Invalid priority' });\\n        const task = db.prepare('SELECT tasks.id, projects.archived FROM tasks JOIN projects ON projects.id=tasks.project_id WHERE tasks.id=?').get(Number(taskItem[1]));\\n        if (!task) return send(res, 404, { error: 'Not found' });\\n        if (task.archived) return send(res, 409, { error: 'Archived projects cannot be changed' });\\n        db.prepare('UPDATE tasks SET priority=? WHERE id=?').run(body.priority, Number(taskItem[1]));\\n        return send(res, 200, db.prepare('SELECT id, title, completed, priority FROM tasks WHERE id=?').get(Number(taskItem[1])));\\n      }\\n      if (Object.hasOwn(body, 'title')) {\"},{\"oldText\":\"SELECT id, title, completed FROM tasks WHERE id=?\",\"newText\":\"SELECT id, title, completed, priority FROM tasks WHERE id=?\"},{\"oldText\":\"SELECT id, title, completed FROM tasks WHERE id = ?\",\"newText\":\"SELECT id, title, completed, priority FROM tasks WHERE id = ?\"}]}"}

