n    CREATE TABLE projects (\\n      position INTEGER PRIMARY KEY AUTOINCREMENT, id TEXT NOT NULL UNIQUE, name TEXT NOT NULL\\n    );\\n    CREATE TABLE tasks (\\n      position INTEGER PRIMARY KEY AUTOINCREMENT, id TEXT NOT NULL UNIQUE,\\n      project_id TEXT NOT NULL REFERENCES projects(id), title TEXT NOT NULL,\\n      completed INTEGER NOT NULL DEFAULT 0 CHECK (completed IN (0, 1))\\n    );\\n    INSERT INTO projects (id, name) VALUES ('owner', 'Owner'), ('other', 'Other');\\n    INSERT INTO tasks (id, project_id, title, completed) VALUES ('old', 'owner', 'Existing', 1);\\n  `);\\n  legacy.close();\\n  let server;\\n  try {\\n    server = await startServer(databasePath);\\n    const get = async (path) => (await fetch(`${server.url}${path}`)).text();\\n    const post = (path, values = {}) => fetch(`${server.url}${path}`, {\\n      method: 'POST', body: new URLSearchParams(values), redirect: 'manual',\\n    });\\n    const path = '/projects/owner';\\n    const taskPath = `${path}/tasks/old`;\\n    const priorities = (html) => [...html.matchAll(/<select id=\\\"task-priority-[^\\\"]+\\\"[^>]*>\\\\s*([\\\\s\\\\S]*?)<\\\\/select>/g)].map((match) => match[1].trim());\\n    const normalOptions = '<option>Low</option><option selected>Normal</option><option>High</option>';\\n    assert.deepEqual(priorities(await get(path)), [normalOptions]);\\n    await post(`${path}/tasks`, { title: 'New task' });\\n    await post('/projects/other/tasks', { title: 'Other task' });\\n    const before = await get(path);\\n    const other = await get('/projects/other');\\n    const listing = await get('/');\\n    assert.deepEqual(priorities(before), [normalOptions, normalOptions]);\\n    assert.equal((before.match(/>Task priority<\\\\/label>/g) ?? []).length, 2);\\n    for (const priority of ['Low', 'Normal', 'High']) {\\n      const response = await post(`${taskPath}/priority`, { priority, filter: 'Completed' });\\n      assert.equal(response.status, 303);\\n      assert.equal(response.headers.get('location'), `${path}?filter=Completed`);\\n      const options = ['Low', 'Normal', 'High'].map((value) => `<option${value === priority ? ' selected' : ''}>${value}</option>`).join('');\\n      assert.equal(await get(path), before.replace(normalOptions, options));\\n      assert.equal(await get('/projects/other'), other);\\n      assert.equal(await get('/'), listing);\\n      assert.doesNotMatch(await get(`${path}?filter=Open`), /Existing/);\\n      assert.deepEqual(priorities(await get(`${path}?filter=Completed`)), [options]);\\n    }\\n    const high = await get(path);\\n    for (const values of [{}, { priority: 'Urgent' }, { priority: ' High ' }]) {\\n      const response = await post(`${taskPath}/priority`, values);\\n      assert.equal(response.status, 422);\\n      assert.match(await response.text(), /role=\\\"alert\\\">Invalid task priority/);\\n      assert.equal(await get(path), high);\\n    }\\n    assert.equal((await post('/projects/other/tasks/old/priority', { priority: 'Low' })).status, 404);\\n    assert.equal((await post(`${path}/tasks/missing/priority`, { priority: 'Low' })).status, 404);\\n    await post(`${taskPath}/rename`, { title: 'Renamed' });\\n    const renamed = high.replaceAll('Existing', 'Renamed');\\n    assert.equal(await get(path), renamed);\\n    await server.stop();\\n    server = await startServer(databasePath);\\n    assert.equal(await get(path), renamed);\\n    assert.equal(await get('/'), listing);\\n    await post(`${path}/archive`);\\n    const archived = await get(path);\\n    assert.equal((archived.match(/<select id=\\\"task-priority-[^\\\"]+\\\"[^>]* disabled/g) ?? []).length, 2);\\n    assert.equal((await post(`${taskPath}/priority`, { priority: 'Low' })).status, 403);\\n    assert.equal(await get(path), archived);\\n    await server.stop();\\n    server = await startServer(databasePath);\\n    assert.equal(await get(path), archived);\\n    await post(`${path}/restore`);\\n    assert.equal(await get(path), renamed);\\n    assert.equal((await post(`${taskPath}/priority`, { priority: 'Low' })).status, 303);\\n    assert.deepEqual(priorities(await get(path)), [\\n      '<option selected>Low</option><option>Normal</option><option>High</option>', normalOptions,\\n    ]);\\n    await post(taskPath, {});\\n    assert.deepEqual(priorities(await get(path)), [\\n      '<option selected>Low</option><option>Normal</option><option>High</option>', normalOptions,\\n    ]);\\n  } finally {\\n    if (server) await server.stop();\\n    await rm(directory, { recursive: true, force: true });\\n  }\\n});\"}]}","status":"completed"}],"error":null,"incomplete_details":null,"tools":[{"type":"function","name":"read","description":"Read the contents of a file. Supports text files and images (jpg, png, gif, webp, bmp). Images are sent as attachments. For text files, output is truncated to 2000 lines or 50KB (whichever is hit first). Use offset/limit for large files. When you need the full file, continue with offset until complete.","parameters":{"type":"object","required":["path","offset","limit"],"properties":{"path":{"type":"string","description":"Path to the file to read (relative or absolute)"},"offset":{"anyOf":[{"type":"number","description":"Line number to start reading from (1-indexed)"},{"type":"null"}]},"limit":{"anyOf":[{"type":"number","description":"Maximum number of lines to read"},{"type":"null"}]}},"additionalProperties":false},"output_schema":null,"strict":true},{"type":"function","name":"bash","description":"Execute a bash command in the current working directory. Returns stdout and stderr. Output is truncated to last 2000 lines or 50KB (whichever is hit first). If truncated, full output is saved to a temp file. Optionally provide a timeout in seconds.","parameters":{"type":"object","required":["command","timeout"],"properties":{"command":{"type":"string","description":"Shell command to execute"},"timeout":{"anyOf":[{"type":"number","description":"Timeout in seconds (optional, no default timeout)"},{"type":"null"}]}},"additionalProperties":false},"output_schema":null,"strict":true},{"type":"function","name":"edit","description":"Edit a single file using exact text replacement. Every edits[].oldText must match a unique, non-overlapping region of the original file. If two changes affect the same block or nearby lines, merge them into one edit instead of emitting overlapping edits. Do not include large unchanged regions just to connect distant changes.","parameters":{"type":"object","required":["path","edits"],"properties":{"path":{"type":"string","description":"Path to the file to edit (relative or absolute)"},"edits":{"type":"array","items":{"type":"object","required":["oldText","newText"],"properties":{"oldText":{"type":"string","description":"Exact text for one targeted replacement. It must be unique in the original file and must not overlap with any other edits[].oldText in the same call."},"newText":{"type":"string","description":"Replacement text for this targeted edit."}},"additionalProperties":false},"description":"One or more targeted replacements. Each edit is matched against the original file, not incrementally. Do not include overlapping or nested edits. If two changes touch the same block or nearby lines, merge them into one edit instead."}},"additionalProperties":false},"output_schema":null,"strict":true},{"type":"function","name":"write","description":"Write content to a file. Creates the file if it doesn't exist, overwrites if it does. Automatically creates parent directories.","parameters":{"type":"object","required":["path","content"],"properties":{"path":{"type":"string","description":"Path to the file to write (relative or absolute)"},"content":{"type":"string","description":"Content to write to the file"}},"additionalProperties":false},"output_schema":null,"strict":true}],"tool_choice":"auto","parallel_tool_calls":true,"prompt_cache_key":"c378d5b5-8973-4b22-bd2b-3693d9e4f06e","prompt_cache_retention":"24h","text":{"format":{"t