data: {"type":"response.function_call_arguments.done","sequence_number":356,"item_id":"fc_0c710f731195c022016acba1b5d2288193a96dd2fa76407ff4","output_index":1,"arguments":"{\"path\":\"README.md\",\"edits\":[{\"oldText\":\"SQLite assigns an internal creation sequence for stable project and task ordering; public IDs are UUIDs.\",\"newText\":\"SQLite assigns an internal sequence for stable project and task ordering; moving a task assigns it a fresh position to append it in its destination. Public IDs are UUIDs and never change on a move.\"},{\"oldText\":\"Restoring a project preserves its tasks. Small browser event handlers\",\"newText\":\"Restoring a project preserves its tasks. Each task row provides a Destination project selector listing only other active projects in project creation order, using their current names, and a Move task button. Moving appends the task after the destination's existing tasks, preserves its ID, title, completion, priority and due date, and updates both summaries. The source page stays open with its filters and applied range retained. Move controls are disabled for archived sources or when no eligible destination exists; direct requests also reject archived, missing, or same-project destinations and tasks not owned by the source. Small browser event handlers\"},{\"oldText\":\"archived range controls, and persistence across process restarts.\",\"newText\":\"archived range controls, task move destination eligibility and ordering, append order including subsequent creation and repeat moves, task data and filter retention, summary updates, move archive protections, and persistence across process restarts.\"}]}"}

