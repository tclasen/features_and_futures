event: response.function_call_arguments.done
data: {"type":"response.function_call_arguments.done","arguments":"{\"path\":\"server.js\",\"edits\":[{\"oldText\":\"try { db.exec('ALTER TABLE tasks ADD COLUMN due_date TEXT'); } catch {}\",\"newText\":\"try { db.exec('ALTER TABLE tasks ADD COLUMN due_date TEXT'); } catch {}\\ntry { db.exec('ALTER TABLE tasks ADD COLUMN position INTEGER'); } catch {}\\ndb.exec('UPDATE tasks SET position=id WHERE position IS NULL');\"},{\"oldText\":\"async function loadTasks(){const tasks=await(await fetch('/api/projects/'+p.id+'/tasks')).json();const shown=\",\"newText\":\"async function loadTasks(){const tasks=await(await fetch('/api/projects/'+p.id+'/tasks')).json(),allProjects=await(await fetch('/api/projects')).json(),destinations=allProjects.filter(x=>!x.archived&&x.id!==p.id);const shown=\"},{\"oldText\":\"+'<button data-save-date=\\\"'+t.id+'\\\"'+(p.archived?' disabled':'')+'>Save due date</button></div>').join('');\",\"newText\":\"+'<button data-save-date=\\\"'+t.id+'\\\"'+(p.archived?' disabled':'')+'>Save due date</button><select aria-label=\\\"Destination project\\\" data-destination=\\\"'+t.id+'\\\"'+(p.archived||!destinations.length?' disabled':'')+'>'+destinations.map(d=>'<option value=\\\"'+d.id+'\\\">'+escapeHtml(d.name)+'</option>').join('')+'</select><button data-move=\\\"'+t.id+'\\\"'+(p.archived||!destinations.length?' disabled':'')+'>Move task</button></div>').join('');\"},{\"oldText\":\"document.querySelectorAll('#tasks [data-rename]').forEach(button=>button.onclick=\",\"newText\":\"document.querySelectorAll('#tasks [data-move]').forEach(button=>button.onclick=async()=>{const select=document.querySelector('[data-destination=\\\"'+button.dataset.move+'\\\"]');if(!select.value)return;await fetch('/api/tasks/'+button.dataset.move,{method:'PATCH',headers:{'content-type':'application/json'},body:JSON.stringify({project_id:Number(select.value)})});loadTasks()});document.querySelectorAll('#tasks [data-rename]').forEach(button=>button.onclick=\"},{\"oldText\":\"ORDER BY id').all(id));\",\"newText\":\"ORDER BY position,id').all(id));\"},{\"oldText\":\"INSERT INTO tasks (project_id, title, priority) VALUES (?, ?, ?)\",\"newText\":\"INSERT INTO tasks (project_id, title, priority, position) VALUES (?, ?, ?, COALESCE((SELECT MAX(position)+1 FROM tasks WHERE project_id=?),0))\"},{\"oldText\":\"run(projectId, title, project.default_priority);\",\"newText\":\"run(projectId, title, project.default_priority, projectId);\"},{\"oldText\":\"if (Object.hasOwn(body, 'due_date')) {\",\"newText\":\"if (Object.hasOwn(body, 'project_id')) {\\n        const task=db.prepare('SELECT tasks.id,tasks.project_id,projects.archived FROM tasks JOIN projects ON projects.id=tasks.project_id WHERE tasks.id=?').get(Number(taskItem[1]));\\n        if(!task) return send(res,404,{error:'Not found'});\\n        const destination=db.prepare('SELECT id,archived FROM projects WHERE id=?').get(Number(body.project_id));\\n        if(task.archived||!destination||destination.archived||destination.id===task.project_id) return send(res,400,{error:'Invalid destination'});\\n        db.prepare('UPDATE tasks SET project_id=?,position=COALESCE((SELECT MAX(position)+1 FROM tasks WHERE project_id=?),0) WHERE id=?').run(destination.id,destination.id,task.id);\\n        return send(res,200,{status:'ok'});\\n      }\\n      if (Object.hasOwn(body, 'due_date')) {\"}] }","item_id":"fc_02142e6a408378ef016acba1537dcc87d1868369bd203399fa","output_index":1,"sequence_number":820}

