ment.querySelectorAll('#tasks [data-rename]').forEach(button=>button.onclick=\"},{\"oldText\":\"ORDER BY id').all(id));\",\"newText\":\"ORDER BY position,id').all(id));\"},{\"oldText\":\"INSERT INTO tasks (project_id, title, priority) VALUES (?, ?, ?)\",\"newText\":\"INSERT INTO tasks (project_id, title, priority, position) VALUES (?, ?, ?, COALESCE((SELECT MAX(position)+1 FROM tasks WHERE project_id=?),0))\"},{\"oldText\":\"run(projectId, title, project.default_priority);\",\"newText\":\"run(projectId, title, project.default_priority, projectId);\"},{\"oldText\":\"if (Object.hasOwn(body, 'due_date')) {\",\"newText\":\"if (Object.hasOwn(body, 'project_id')) {\\n        const task=db.prepare('SELECT tasks.id,tasks.project_id,projects.archived FROM tasks JOIN projects ON projects.id=tasks.project_id WHERE tasks.id=?').get(Number(taskItem[1]));\\n        if(!task) return send(res,404,{error:'Not found'});\\n        const destination=db.prepare('SELECT id,archived FROM projects WHERE id=?').get(Number(body.project_id));\\n        if(task.archived||!destination||destination.archived||destination.id===task.project_id) return send(res,400,{error:'Invalid destination'});\\n        db.prepare('UPDATE tasks SET project_id=?,position=COALESCE((SELECT MAX(position)+1 FROM tasks WHERE project_id=?),0) WHERE id=?').run(destination.id,destination.id,task.id);\\n        return send(res,200,{status:'ok'});\\n      }\\n      if (Object.hasOwn(body, 'due_date')) {\"}] }","call_id":"call_6LuRF2OqTUA4XoT3PEJ8HNBI","name":"edit"},"output_index":1,"sequence_number":821}

