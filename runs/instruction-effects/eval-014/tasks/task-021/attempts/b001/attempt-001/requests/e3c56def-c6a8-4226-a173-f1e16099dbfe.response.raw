data: {"type":"response.function_call_arguments.done","sequence_number":951,"item_id":"fc_0b22fc6b0de0ce90016acbc1e8a95c819081ad438727aa12a6","output_index":2,"arguments":"{\"path\":\"server.js\",\"edits\":[{\"oldText\":\"function directoryPage(scope, filter, prioritySelection, range, query, error = '', rangeInput = range) {\\n  const tasks = matchingDirectoryTasks(scope, filter, prioritySelection, range, query);\",\"newText\":\"function directoryOrder(value) {\\n  return ['Original', 'Priority', 'Due date', 'Title'].includes(value) ? value : 'Original';\\n}\\n\\nfunction compareTitles(left, right) {\\n  const fold = title => Array.from(title.replace(/[A-Z]/g, letter => letter.toLowerCase()), character => character.codePointAt(0));\\n  const a = fold(left);\\n  const b = fold(right);\\n  for (let index = 0; index < Math.min(a.length, b.length); index++) {\\n    if (a[index] !== b[index]) return a[index] - b[index];\\n  }\\n  return a.length - b.length;\\n}\\n\\nfunction orderDirectoryTasks(tasks, order) {\\n  // Stable sorting retains Original order for equal keys; never alter stored positions.\\n  if (order === 'Priority') {\\n    const rank = { High: 0, Normal: 1, Low: 2 };\\n    tasks.sort((a, b) => rank[a.priority] - rank[b.priority]);\\n  } else if (order === 'Due date') {\\n    tasks.sort((a, b) => {\\n      if (!a.due_date || !b.due_date) return Number(!a.due_date) - Number(!b.due_date);\\n      return a.due_date < b.due_date ? -1 : a.due_date > b.due_date ? 1 : 0;\\n    });\\n  } else if (order === 'Title') {\\n    tasks.sort((a, b) => compareTitles(a.title, b.title));\\n  }\\n  return tasks;\\n}\\n\\nfunction directoryPage(scope, filter, prioritySelection, range, query, error = '', rangeInput = range, order = 'Original') {\\n  const tasks = orderDirectoryTasks(matchingDirectoryTasks(scope, filter, prioritySelection, range, query), order);\"},{\"oldText\":\"const selections = `<input type=\\\"hidden\\\" name=\\\"scope\\\" value=\\\"${scope}\\\">\",\"newText\":\"const selections = `<input type=\\\"hidden\\\" name=\\\"order\\\" value=\\\"${order}\\\">\\n    <input type=\\\"hidden\\\" name=\\\"scope\\\" value=\\\"${scope}\\\">\"},{\"oldText\":\"${select('Priority filter', 'priorityFilter', ['All', ...priorities], prioritySelection)}\",\"newText\":\"${select('Priority filter', 'priorityFilter', ['All', ...priorities], prioritySelection)}\\n      ${select('Directory order', 'order', ['Original', 'Priority', 'Due date', 'Title'], order)}\"},{\"oldText\":\"dueRange(url.searchParams), searchQuery(url.searchParams)));\",\"newText\":\"dueRange(url.searchParams), searchQuery(url.searchParams), '', undefined, directoryOrder(url.searchParams.get('order'))));\"},{\"oldText\":\"dueFrom: range.from, dueThrough: range.through, search: query });\",\"newText\":\"dueFrom: range.from, dueThrough: range.through, search: query, order: directoryOrder(form.get('order')) });\"},{\"oldText\":\"directoryPage(scope, filter, prioritySelection, dueRange(form), searchQuery(form), error, range)\",\"newText\":\"directoryPage(scope, filter, prioritySelection, dueRange(form), searchQuery(form), error, range, directoryOrder(form.get('order')))\"},{\"oldText\":\"dueFrom: range.from, dueThrough: range.through, search: searchQuery(form) });\",\"newText\":\"dueFrom: range.from, dueThrough: range.through, search: searchQuery(form), order: directoryOrder(form.get('order')) });\"}]}"}

