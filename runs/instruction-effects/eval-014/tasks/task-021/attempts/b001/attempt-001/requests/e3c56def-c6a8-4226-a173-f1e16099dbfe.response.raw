ut type=\\\"hidden\\\" name=\\\"scope\\\" value=\\\"${scope}\\\">\",\"newText\":\"const selections = `<input type=\\\"hidden\\\" name=\\\"order\\\" value=\\\"${order}\\\">\\n    <input type=\\\"hidden\\\" name=\\\"scope\\\" value=\\\"${scope}\\\">\"},{\"oldText\":\"${select('Priority filter', 'priorityFilter', ['All', ...priorities], prioritySelection)}\",\"newText\":\"${select('Priority filter', 'priorityFilter', ['All', ...priorities], prioritySelection)}\\n      ${select('Directory order', 'order', ['Original', 'Priority', 'Due date', 'Title'], order)}\"},{\"oldText\":\"dueRange(url.searchParams), searchQuery(url.searchParams)));\",\"newText\":\"dueRange(url.searchParams), searchQuery(url.searchParams), '', undefined, directoryOrder(url.searchParams.get('order'))));\"},{\"oldText\":\"dueFrom: range.from, dueThrough: range.through, search: query });\",\"newText\":\"dueFrom: range.from, dueThrough: range.through, search: query, order: directoryOrder(form.get('order')) });\"},{\"oldText\":\"directoryPage(scope, filter, prioritySelection, dueRange(form), searchQuery(form), error, range)\",\"newText\":\"directoryPage(scope, filter, prioritySelection, dueRange(form), searchQuery(form), error, range, directoryOrder(form.get('order')))\"},{\"oldText\":\"dueFrom: range.from, dueThrough: range.through, search: searchQuery(form) });\",\"newText\":\"dueFrom: range.from, dueThrough: range.through, search: searchQuery(form), order: directoryOrder(form.get('order')) });\"}]}","status":"completed"}}

