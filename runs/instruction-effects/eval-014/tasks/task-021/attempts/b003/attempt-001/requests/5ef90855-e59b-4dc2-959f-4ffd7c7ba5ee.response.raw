test';\\nimport assert from 'node:assert/strict';\\nimport { spawn } from 'node:child_process';\\nimport { once } from 'node:events';\\nimport { mkdtemp, rm } from 'node:fs/promises';\\nimport { tmpdir } from 'node:os';\\nimport { join } from 'node:path';\\n\\nconst titles = html => [...html.matchAll(/data-testid=\\\"directory-task-title\\\"[^>]*>([^<]*)/g)].map(match => match[1]);\\ntest('directory ordering is stable, code-point based, retained across actions, and view-only', async () => {\\n  const temp = await mkdtemp(join(tmpdir(), 'workboard-order-'));\\n  let child;\\n  try {\\n    child = spawn(process.execPath, ['server.js'], {\\n      env: { ...process.env, PORT: '0', DB_PATH: join(temp, 'db.sqlite') }, stdio: ['ignore', 'pipe', 'pipe']\\n    });\\n    const port = await new Promise((resolve, reject) => {\\n      let output = '';\\n      child.stdout.on('data', chunk => {\\n        output += chunk;\\n        const match = output.match(/listening on port (\\\\d+)/);\\n        if (match) resolve(match[1]);\\n      });\\n      child.once('error', reject);\\n      child.once('exit', code => reject(new Error(`Server exited: ${code}`)));\\n    });\\n    const base = `http://127.0.0.1:${port}`;\\n    const get = async path => (await fetch(base + path)).text();\\n    const post = async (path, values) => (await fetch(base + path, { method: 'POST', body: new URLSearchParams(values) })).text();\\n    const task = (title, priority = 'Normal', dueDate = '') => ({ title, priority, dueDate, completed: false, deleted: false, notes: '' });\\n    const imports = [\\n      [task('z', 'Low'), task('Alpha', 'High', '2025-01-01'), task('a  b', 'Normal', '2024-02-29'), task('\\\\u{10000}')],\\n      [task('alpha', 'High', '2025-01-01'), task('a b', 'Low', '0001-01-01'), task('\\\\uE000')]\\n    ];\\n    for (const [index, tasks] of imports.entries()) {\\n      await post('/projects/import', { importedName: `Owner ${index}`, projectJson: JSON.stringify({\\n        format: 'workboard-project', version: 1, project: { name: 'Portable', archived: false, defaultPriority: 'Normal', tasks }\\n      }) });\\n    }\\n    const original = imports.flat().map(task => task.title);\\n    const snapshots = await Promise.all([1, 2].map(id => get(`/projects/${id}/export`)));\\n    assert.deepEqual(titles(await get('/directory')), original);\\n    assert.match(await get('/directory'), /id=\\\"directory-order\\\"[^>]*><option selected>Original<\\\\/option><option>Priority<\\\\/option><option>Due date<\\\\/option><option>Title<\\\\/option>/);\\n    const expected = {\\n      Priority: ['Alpha', 'alpha', 'a  b', '\\\\u{10000}', '\\\\uE000', 'z', 'a b'],\\n      'Due date': ['a b', 'a  b', 'Alpha', 'alpha', 'z', '\\\\u{10000}', '\\\\uE000'],\\n      Title: ['a  b', 'a b', 'Alpha', 'alpha', 'z', '\\\\uE000', '\\\\u{10000}']\\n    };\\n    for (const [order, result] of Object.entries(expected)) {\\n      const html = await get('/directory?' + new URLSearchParams({ order }));\\n      assert.deepEqual(titles(html), result);\\n      for (const form of html.matchAll(/<form[^>]*action=\\\"\\\\/directory[^\\\\\\\"]*\\\"[\\\\s\\\\S]*?<\\\\/form>/g)) {\\n        assert.ok(form[0].includes('name=\\\"order\\\"'));\\n        assert.ok(form[0].includes(`value=\\\"${order}\\\"`) || form[0].includes(`<option selected>${order}</option>`));\\n      }\\n    }\\n    assert.deepEqual(await Promise.all([1, 2].map(id => get(`/projects/${id}/export`))), snapshots);\\n    assert.deepEqual(titles(await get('/directory?order=invalid')), original);\\n    let state = { scope: 'Active', filter: 'Open', priorityFilter: 'All', order: 'Title', search: 'a', dueFrom: '', dueThrough: '' };\\n    let html = await post('/directory/due-range', { ...state, from: 'bad', through: '' });\\n    assert.match(html, /role=\\\"alert\\\">Due range must use valid/);\\n    assert.deepEqual(titles(html), ['a  b', 'a b', 'Alpha', 'alpha']);\\n    assert.match(html, /<option selected>Title<\\\\/option>/);\\n    html = await post('/directory/due-range', { ...state, from: '0001-01-01', through: '9999-12-31' });\\n    assert.deepEqual(titles(html), ['a  b', 'a b', 'Alpha', 'alpha']);\\n    state = { ...state, dueFrom: '0001-01-01', dueThrough: '9999-12-31' };\\n    html = await post('/directory/completion', { ...state, completed: '1' });\\n    assert.deepEqual(titles(html), []);\\n    assert.match(html, /No matching tasks/);\\n    assert.match(html, /<option selected>Title<\\\\/option>/);\\n    assert.deepEqual(titles(await get('/directory?filter=Completed&order=Title')), ['a  b', 'a b', 'Alpha', 'alpha']);\\n    // The same comparators apply to read-only archived and deleted views.\\n    await post('/projects/1/tasks/1/delete', {});\\n    await post('/projects/2/tasks/6/delete', {});\\n    assert.deepEqual(titles(await get('/directory?filter=Deleted&order=Title')), ['a b', 'z']);\\n    await post('/projects/1/archive', {});\\n    await post('/projects/2/archive', {});\\n    assert.deepEqual(titles(await get('/directory?scope=Archived&filter=Deleted&order=Title')), ['a b', 'z']);\\n    assert.deepEqual(titles(await get('/directory?scope=Archived&order=Priority')), ['Alpha', 'alpha', 'a  b', '\\\\u{10000}', '\\\\uE000']);\\n    assert.deepEqual(titles(await get('/directory?scope=Archived')), ['Alpha', 'a  b', '\\\\u{10000}', 'alpha', '\\\\uE000']);\\n  } finally {\\n    if (child && child.exitCode === null) { const exited = once(child, 'exit'); child.kill(); await exited; }\\n    await rm(temp, { recursive: true, force: true });\\n  }\\n});\\n\"}","status":"completed"}],"error":null,"incomplete_details":null,"tools":[{"type":"function","name":"read","description":"Read the contents of a file. Supports text files and images (jpg, png, gif, webp, bmp). Images are sent as attachments. For text files, output is truncated to 2000 lines or 50KB (whichever is hit first). Use offset/limit for large files. When you need the full file, continue with offset until complete.","parameters":{"type":"object","required":["path","offset","limit"],"properties":{"path":{"type":"string","description":"Path to the file to read (relative or absolute)"},"offset":{"anyOf":[{"type":"number","description":"Line number to start reading from (1-indexed)"},{"type":"null"}]},"limit":{"anyOf":[{"type":"number","description":"Maximum number of lines to read"},{"type":"null"}]}},"additionalProperties":false},"output_schema":null,"strict":true},{"type":"function","name":"bash","description":"Execute a bash command in the current working directory. Returns stdout and stderr. Output is truncated to last 2000 lines or 50KB (whichever is hit first). If truncated, full output is saved to a temp file. Optionally provide a timeout in seconds.","parameters":{"type":"object","required":["command","timeout"],"properties":{"command":{"type":"string","description":"Shell command to execute"},"timeout":{"anyOf":[{"type":"number","description":"Timeout in seconds (optional, no default timeout)"},{"type":"null"}]}},"additionalProperties":false},"output_schema":null,"strict":true},{"type":"function","name":"edit","description":"Edit a single file using exact text replacement. Every edits[].oldText must match a unique, non-overlapping region of the original file. If two changes affect the same block or nearby lines, merge them into one edit instead of emitting overlapping edits. Do not include large unchanged regions just to connect distant changes.","parameters":{"type":"object","required":["path","edits"],"properties":{"path":{"type":"string","description":"Path to the file to edit (relative or absolute)"},"edits":{"type":"array","items":{"type":"object","required":["oldText","newText"],"properties":{"oldText":{"type":"string","description":"Exact text for one targeted replacement. It must be unique in the original file and must not overlap with any other edits[].oldText in the same call."},"newText":{"type":"string","description":"Replacement text for this targeted edit."}},"additionalProperties":false},"description":"One or more targeted replacements. Each edit is matched against the original file, not incrementally. Do not include overlapping or nested edits. If two changes touch the same block or nearby lines, merge them into one edit instead."}},"additionalProperties":false},"output_schema":null,"strict":true},{"type":"function","name":"write","description":"Write content to a file. Creates the file if it doesn't exist, overwrites if it does. Automatically creates parent directories.","parameters":{"type":"object","required":["path","content"],"properties":{"path":{"type":"string","description":"Path to the file to write (relative or absolute)"},"content":{"type":"string","description":"Content to write to the file"}},"additionalProperties":false},"output_schema":null,"strict":true}],"tool_choice":"auto","parallel_tool_calls":true,"prompt_cache_key":"af85722a-5dbe-451f-8d42-0acdc7cecbfd","prompt_cache_retention":"24h","text":{"format":{"type":"text"},"verbosity":"low"},"top_p":0.98,"top_logprobs":0,"temperature":1.0,"reasoning":{"effort":"medium","summary":"detailed","context":"all_turns","mode":"standard"},"user":null,"usage":{"input_tokens":18778,"input_tokens_details":{"cached_tokens":0,"cache_write_tokens":0},"output_tokens":1685,"output_tokens_details":{"reasoning_tokens":24},"total_tokens":20463,"attribution":{"items":{"fc_0d48484d1ffe37d2016acbc1dd97d48197be58082d7849c442":{"input_tokens":34,"cached_tokens":0,"cache_write_tokens":0,"output_tokens":0},"fc_0d48484d1ffe37d2016acbc1e0b6208197982949a39113e106":{"input_tokens":44,"cached_tokens":0,"cache_write_tokens":0,"output_tokens":0},"fc_0d48484d1ffe37d2016acbc1e324348197871a479a0067c401":{"input_tokens":28,"cached_tokens":0,"cache_write_tokens":0,"output_tokens":0},"fc_0d48484d1ffe37d2016acbc1e5d0608197b72d30e355095a27":{"input_tokens":42,"cached_tokens":0,"cache_write_tokens":0,"output_tokens":0},"fc_0d48484d1ffe37d2016acbc1e88dec8197819f7b3484e5ab2b":{"input_tokens":22,"cached_tokens":0,