data: {"type":"response.function_call_arguments.done","sequence_number":682,"item_id":"fc_0361b6322a5aef3a016acb9bc5d8e08196acb855bb7eb1e0bd","output_index":1,"arguments":"{\"path\":\"server.js\",\"edits\":[{\"oldText\":\"const updateTask = db.prepare('UPDATE tasks SET completed = ? WHERE id = ? AND project_id = ?');\",\"newText\":\"const updateTask = db.prepare('UPDATE tasks SET completed = ? WHERE id = ? AND project_id = ?');\\nconst getTask = db.prepare('SELECT id FROM tasks WHERE id = ? AND project_id = ?');\\nconst renameTask = db.prepare('UPDATE tasks SET title = ? WHERE id = ? AND project_id = ?');\"},{\"oldText\":\"        </form>\\n      </div>`).join('') : '<p>No matching tasks.</p>'}\",\"newText\":\"        </form>\\n        <form class=\\\"create\\\" method=\\\"post\\\" action=\\\"/projects/${project.id}/tasks/${task.id}/rename\\\">\\n          <input type=\\\"hidden\\\" name=\\\"filter\\\" value=\\\"${filter}\\\">\\n          <label for=\\\"new-task-title-${task.id}\\\">New task title</label>\\n          <input id=\\\"new-task-title-${task.id}\\\" name=\\\"title\\\" type=\\\"text\\\"${project.archived ? ' disabled' : ''}>\\n          <button type=\\\"submit\\\"${project.archived ? ' disabled' : ''}>Rename task</button>\\n        </form>\\n      </div>`).join('') : '<p>No matching tasks.</p>'}\"},{\"oldText\":\"/^\\\\/projects\\\\/\\\\d+\\\\/tasks(?:\\\\/\\\\d+)?$/.test(url.pathname)\",\"newText\":\"/^\\\\/projects\\\\/\\\\d+\\\\/tasks(?:\\\\/\\\\d+(?:\\\\/rename)?)?$/.test(url.pathname)\"},{\"oldText\":\"        if (!Number.isSafeInteger(taskId) || !updateTask.run(form.get('completed') === '1' ? 1 : 0, taskId, projectId).changes) {\\n          sendHtml(res, 404, page('Not found', '<h1>Task not found</h1>'));\\n          return;\\n        }\",\"newText\":\"        if (!Number.isSafeInteger(taskId) || !getTask.get(taskId, projectId)) {\\n          sendHtml(res, 404, page('Not found', '<h1>Task not found</h1>'));\\n          return;\\n        }\\n        if (parts[5] === 'rename') {\\n          const title = (form.get('title') || '').trim();\\n          if (!title) {\\n            sendHtml(res, 200, projectPage(project, filter, 'Task title is required'));\\n            return;\\n          }\\n          renameTask.run(title, taskId, projectId);\\n        } else {\\n          updateTask.run(form.get('completed') === '1' ? 1 : 0, taskId, projectId);\\n        }\"}]}"}

