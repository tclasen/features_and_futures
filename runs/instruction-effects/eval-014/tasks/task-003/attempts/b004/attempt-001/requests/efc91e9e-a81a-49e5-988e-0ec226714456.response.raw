R NOT NULL DEFAULT 0\\n)`);\\ntry { db.exec('ALTER TABLE projects ADD COLUMN archived INTEGER NOT NULL DEFAULT 0'); } catch {}\"},{\"oldText\":\"async function render(){const match=location.pathname.match(/^\\\\\\\\/projects\\\\\\\\/(\\\\\\\\d+)\\\\\\\\/?$/);if(match){const response=await fetch('/api/projects/'+match[1]);if(!response.ok){history.replaceState({},'', '/');return render()}const p=await response.json();app.innerHTML='<button id=\\\"back\\\">Projects</button><h1>'+escapeHtml(p.name)+'</h1><form id=\\\"create-task\\\"><input id=\\\"task-title\\\" aria-label=\\\"Task title\\\" placeholder=\\\"Task title\\\"><button type=\\\"submit\\\">Create task</button></form><p class=\\\"alert\\\" id=\\\"task-alert\\\" role=\\\"alert\\\" hidden></p><label>Task filter <select id=\\\"task-filter\\\"><option>All</option><option>Open</option><option>Completed</option></select></label><section id=\\\"tasks\\\"></section>';document.getElementById('back').onclick=()=>{history.pushState({},'','/');render()};const filter=document.getElementById('task-filter');async function loadTasks(){const tasks=await(await fetch('/api/projects/'+p.id+'/tasks')).json();const shown=tasks.filter(t=>filter.value==='All'||(filter.value==='Completed')===Boolean(t.completed));document.getElementById('tasks').innerHTML=shown.map(t=>'<div class=\\\"row\\\" data-testid=\\\"task-row\\\"><span>'+escapeHtml(t.title)+'</span><label class=\\\"task-label\\\"><input type=\\\"checkbox\\\" aria-label=\\\"Complete '+escapeHtml(t.title)+'\\\" data-id=\\\"'+t.id+'\\\" '+(t.completed?'checked':'')+'></label></div>').join('');document.querySelectorAll('#tasks input').forEach(box=>box.onchange=async()=>{await fetch('/api/tasks/'+box.dataset.id,{method:'PATCH',headers:{'content-type':'application/json'},body:JSON.stringify({completed:box.checked})});loadTasks()})}filter.onchange=loadTasks;document.getElementById('create-task').onsubmit=async e=>{e.preventDefault();const input=document.getElementById('task-title'),title=input.value.trim(),alert=document.getElementById('task-alert');if(!title){alert.textContent='Task title is required';alert.hidden=false;return}const r=await fetch('/api/projects/'+p.id+'/tasks',{method:'POST',headers:{'content-type':'application/json'},body:JSON.stringify({title})});if(r.ok){input.value='';alert.hidden=true;loadTasks()}};loadTasks();return}\\nconst response=await fetch('/api/projects');const projects=await response.json();app.innerHTML='<h1>Workboard</h1><form id=\\\"create\\\"><input id=\\\"name\\\" aria-label=\\\"Project name\\\" placeholder=\\\"Project name\\\"><button type=\\\"submit\\\">Create project</button></form><p class=\\\"alert\\\" id=\\\"alert\\\" role=\\\"alert\\\" hidden></p><section id=\\\"projects\\\"></section>';const list=document.getElementById('projects');list.innerHTML=projects.map(p=>'<div class=\\\"row\\\" data-testid=\\\"project-row\\\"><span>'+escapeHtml(p.name)+'</span><button data-id=\\\"'+p.id+'\\\">Open project</button></div>').join('');list.querySelectorAll('button').forEach(b=>b.onclick=()=>{history.pushState({},'','/projects/'+b.dataset.id);render()});document.getElementById('create').onsubmit=async e=>{e.preventDefault();const input=document.getElementById('name'),name=input.value.trim(),alert=document.getElementById('alert');if(!name){alert.textContent='Project name is required';alert.hidden=false;return}const r=await fetch('/api/projects',{method:'POST',headers:{'content-type':'application/json'},body:JSON.stringify({name})});if(r.ok)render()};}\",\"newText\":\"async function render(){const match=location.pathname.match(/^\\\\\\\\/projects\\\\\\\\/(\\\\\\\\d+)\\\\\\\\/?$/);if(match){const response=await fetch('/api/projects/'+match[1]);if(!response.ok){history.replaceState({},'', '/');return render()}const p=await response.json();app.innerHTML='<button id=\\\"back\\\">Projects</button><h1>'+escapeHtml(p.name)+'</h1>'+(p.archived?'<p>Archived project</p>':'')+'<form id=\\\"create-task\\\"><input id=\\\"task-title\\\" aria-label=\\\"Task title\\\" placeholder=\\\"Task title\\\"><button type=\\\"submit\\\">Create task</button></form><p class=\\\"alert\\\" id=\\\"task-alert\\\" role=\\\"alert\\\" hidden></p><label>Task filter <select id=\\\"task-filter\\\"><option>All</option><option>Open</option><option>Completed</option></select></label><section id=\\\"tasks\\\"></section>';document.getElementById('back').onclick=()=>{history.pushState({},'','/');render()};if(p.archived){document.querySelector('#create-task input').disabled=true;document.querySelector('#create-task button').disabled=true}const filter=document.getElementById('task-filter');async function loadTasks(){const tasks=await(await fetch('/api/projects/'+p.id+'/tasks')).json();const shown=tasks.filter(t=>filter.value==='All'||(filter.value==='Completed')===Boolean(t.completed));document.getElementById('tasks').innerHTML=shown.map(t=>'<div class=\\\"row\\\" data-testid=\\\"task-row\\\"><span>'+escapeHtml(t.title)+'</span><label class=\\\"task-label\\\"><input type=\\\"checkbox\\\" aria-label=\\\"Complete '+escapeHtml(t.title)+'\\\" data-id=\\\"'+t.id+'\\\" '+(t.completed?'checked':'')+(p.archived?' disabled':'')+'></label></div>').join('');document.querySelectorAll('#tasks input').forEach(box=>box.onchange=async()=>{await fetch('/api/tasks/'+box.dataset.id,{method:'PATCH',headers:{'content-type':'application/json'},body:JSON.stringify({completed:box.checked})});loadTasks()})}filter.onchange=loadTasks;document.getElementById('create-task').onsubmit=async e=>{e.preventDefault();const input=document.getElementById('task-title'),title=input.value.trim(),alert=document.getElementById('task-alert');if(!title){alert.textContent='Task title is required';alert.hidden=false;return}const r=await fetch('/api/projects/'+p.id+'/tasks',{method:'POST',headers:{'content-type':'application/json'},body:JSON.stringify({title})});if(r.ok){input.value='';alert.hidden=true;loadTasks()}};loadTasks();return}\\nconst projects=await(await fetch('/api/projects')).json();app.innerHTML='<h1>Workboard</h1><label>Project filter <select id=\\\"project-filter\\\"><option>Active</option><option>Archived</option></select></label><form id=\\\"create\\\"><input id=\\\"name\\\" aria-label=\\\"Project name\\\" placeholder=\\\"Project name\\\"><button type=\\\"submit\\\">Create project</button></form><p class=\\\"alert\\\" id=\\\"alert\\\" role=\\\"alert\\\" hidden></p><section id=\\\"projects\\\"></section>';const list=document.getElementById('projects'),filter=document.getElementById('project-filter');function draw(){const shown=projects.filter(p=>Boolean(p.archived)===(filter.value==='Archived'));list.innerHTML=shown.map(p=>'<div class=\\\"row\\\" data-testid=\\\"project-row\\\"><span>'+escapeHtml(p.name)+'</span><span data-testid=\\\"project-summary\\\">'+p.completed+'/'+p.total+' completed</span><button data-open=\\\"'+p.id+'\\\">Open project</button>'+(p.archived?'<button data-restore=\\\"'+p.id+'\\\">Restore project</button>':'<button data-archive=\\\"'+p.id+'\\\">Archive project</button>')+'</div>').join('');list.querySelectorAll('[data-open]').forEach(b=>b.onclick=()=>{history.pushState({},'','/projects/'+b.dataset.open);render()});list.querySelectorAll('[data-archive],[data-restore]').forEach(b=>b.onclick=async()=>{await fetch('/api/projects/'+(b.dataset.archive||b.dataset.restore)+'/archive',{method:'PATCH',headers:{'content-type':'application/json'},body:JSON.stringify({archived:!!b.dataset.archive})});render()})}filter.onchange=draw;draw();document.getElementById('create').onsubmit=async e=>{e.preventDefault();const input=document.getElementById('name'),name=input.value.trim(),alert=document.getElementById('alert');if(!name){alert.textContent='Project name is required';alert.hidden=false;return}const r=await fetch('/api/projects',{method:'POST',headers:{'content-type':'application/json'},body:JSON.stringify({name})});if(r.ok)render()};}\"}]}","status":"completed"}],"error":null,"incomplete_details":null,"tools":[{"type":"function","name":"read","description":"Read the contents of a file. Supports text files and images (jpg, png, gif, webp, bmp). Images are sent as attachments. For text files, output is truncated to 2000 lines or 50KB (whichever is hit first). Use offset/limit for large files. When you need the full file, continue with offset until complete.","parameters":{"type":"object","required":["path","offset","limit"],"properties":{"path":{"type":"string","description":"Path to the file to read (relative or absolute)"},"offset":{"anyOf":[{"type":"number","description":"Line number to start reading from (1-indexed)"},{"type":"null"}]},"limit":{"anyOf":[{"type":"number","description":"Maximum number of lines to read"},{"type":"null"}]}},"additionalProperties":false},"output_schema":null,"strict":true},{"type":"function","name":"bash","description":"Execute a bash command in the current working directory. Returns stdout and stderr. Output is truncated to last 2000 lines or 50KB (whichever is hit first). If truncated, full output is saved to a temp file. Optionally provide a timeout in seconds.","parameters":{"type":"object","required":["command","timeout"],"properties":{"command":{"type":"string","description":"Shell command to execute"},"timeout":{"anyOf":[{"type":"number","description":"Timeout in seconds (optional, no default timeout)"},{"type":"null"}]}},"additionalProperties":false},"output_schema":null,"strict":true},{"type":"function","name":"edit","description":"Edit a single file using exact text replacement. Every edits[].oldText must match a unique, non-overlapping region of the original file. If two changes affect the same block or nearby lines, merge them into one edit instead of emitting overlapping edits. Do not include large unchanged regions just to connect distant changes.","parameters":{"type":"object","required":["path","edits"],"properties":{"path":{"type":"string","description":"Path to the file to edit (relative or absolute)"},"edits":{"type"