g:12px;border:1px solid #cbd3e1;border-radius:8px;font:inherit;background:white}button{border:0;border-radius:8px;padding:11px 16px;background:#315fe8;color:white;font:inherit;cursor:pointer}button:disabled{opacity:.5;cursor:not-allowed}.row{display:flex;align-items:center;justify-content:space-between;gap:16px;padding:16px;margin:10px 0;background:white;border:1px solid #e0e5ee;border-radius:10px}.row-name{font-weight:600;overflow-wrap:anywhere}.actions{display:flex;align-items:center;gap:8px}.back{margin-bottom:24px}[role=alert]{color:#b42318}\\n</style></head><body><main class=\\\"shell\\\" id=\\\"app\\\"></main><script type=\\\"module\\\">\\nconst app=document.querySelector('#app'), esc=s=>String(s).replace(/[&<>\\\"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','\\\"':'&quot;',\\\"'\\\":'&#39;'}[c]));\\nasync function request(url,opts){const r=await fetch(url,opts);if(!r.ok)throw Error((await r.json()).error||'Request failed');return r.status===204?null:r.json()}\\nasync function render(){const match=location.pathname.match(/^\\\\/projects\\\\/([^/]+)\\\\/?$/);if(match){const id=decodeURIComponent(match[1]);let p,tasks;try{p=await request('/api/projects/'+encodeURIComponent(id));tasks=await request(`/api/projects/${encodeURIComponent(id)}/tasks`)}catch{app.innerHTML='<h1>Project not found</h1><button>Projects</button>';app.querySelector('button').onclick=()=>location.href='/';return}\\napp.innerHTML=`<button class=\\\"back\\\">Projects</button><h1>${esc(p.name)}</h1>${p.archived?'<p>Archived project</p>':''}<form class=\\\"form\\\"><input type=\\\"text\\\" aria-label=\\\"Task title\\\" name=\\\"title\\\"><button ${p.archived?'disabled':''}>Create task</button></form><div class=\\\"alert-slot\\\" aria-live=\\\"polite\\\"></div><label>Task filter <select aria-label=\\\"Task filter\\\"><option>All</option><option>Open</option><option>Completed</option></select></label><section aria-label=\\\"Tasks\\\"></section>`;\\napp.querySelector('.back').onclick=()=>location.href='/';const filter=app.querySelector('select'),section=app.querySelector('section');function draw(){section.innerHTML=tasks.filter(t=>filter.value==='All'||(filter.value==='Completed')===Boolean(t.completed)).map(t=>`<div class=\\\"row\\\" data-testid=\\\"task-row\\\"><span class=\\\"row-name\\\">${esc(t.title)}</span><input type=\\\"checkbox\\\" aria-label=\\\"Complete ${esc(t.title)}\\\" data-id=\\\"${esc(t.id)}\\\" ${t.completed?'checked':''} ${p.archived?'disabled':''}></div>`).join('');section.querySelectorAll('[data-id]').forEach(box=>box.onchange=async()=>{try{await request(`/api/projects/${encodeURIComponent(id)}/tasks/${encodeURIComponent(box.dataset.id)}`,{method:'PATCH',headers:{'content-type':'application/json'},body:JSON.stringify({completed:box.checked})});tasks.find(t=>t.id===box.dataset.id).completed=box.checked?1:0;draw()}catch{box.checked=!box.checked}})}filter.onchange=draw;draw();app.querySelector('form').onsubmit=async e=>{e.preventDefault();const f=e.currentTarget,title=new FormData(f).get('title').trim();if(!title){app.querySelector('.alert-slot').innerHTML='<p role=\\\"alert\\\">Task title is required</p>';return}try{tasks.push(await request(`/api/projects/${encodeURIComponent(id)}/tasks`,{method:'POST',headers:{'content-type':'application/json'},body:JSON.stringify({title})}));f.reset();app.querySelector('.alert-slot').innerHTML='';draw()}catch(err){app.querySelector('.alert-slot').innerHTML=`<p role=\\\"alert\\\">${esc(err.message)}</p>`}};return}\\nconst filterValue=new URLSearchParams(location.search).get('filter')==='Archived'?'Archived':'Active',projects=await request('/api/projects?filter='+filterValue);app.innerHTML=`<h1>Workboard</h1><form class=\\\"form\\\"><input type=\\\"text\\\" aria-label=\\\"Project name\\\" name=\\\"name\\\"><button>Create project</button></form><div class=\\\"alert-slot\\\" aria-live=\\\"polite\\\"></div><label>Project filter <select aria-label=\\\"Project filter\\\"><option ${filterValue==='Active'?'selected':''}>Active</option><option ${filterValue==='Archived'?'selected':''}>Archived</option></select></label><section aria-label=\\\"Projects\\\">${projects.map(p=>`<div class=\\\"row\\\" data-testid=\\\"project-row\\\"><span class=\\\"row-name\\\">${esc(p.name)}</span><span class=\\\"actions\\\"><span data-testid=\\\"project-summary\\\">${p.completed}/${p.total} completed</span><button data-open=\\\"${esc(p.id)}\\\">Open project</button><button data-state=\\\"${esc(p.id)}\\\">${p.archived?'Restore project':'Archive project'}</button></span></div>`).join('')}</section>`;\\napp.querySelector('select').onchange=e=>{location.search='?filter='+encodeURIComponent(e.target.value)};app.querySelectorAll('[data-open]').forEach(b=>b.onclick=()=>location.href='/projects/'+encodeURIComponent(b.dataset.open));app.querySelectorAll('[data-state]').forEach(b=>b.onclick=async()=>{await request(`/api/projects/${encodeURIComponent(b.dataset.state)}/${filterValue==='Active'?'archive':'restore'}`,{method:'POST'});render()});app.querySelector('form').onsubmit=async e=>{e.preventDefault();const f=e.currentTarget,name=new FormData(f).get('name').trim();if(!name){app.querySelector('.alert-slot').innerHTML='<p role=\\\"alert\\\">Project name is required</p>';return}await request('/api/projects',{method:'POST',headers:{'content-type':'application/json'},body:JSON.stringify({name})});render()}}\\nrender();\\n</script></body></html>\\n\"}","status":"completed"}],"error":null,"incomplete_details":null,"tools":[{"type":"function","name":"read","description":"Read the contents of a file. Supports text files and images (jpg, png, gif, webp, bmp). Images are sent as attachments. For text files, output is truncated to 2000 lines or 50KB (whichever is hit first). Use offset/limit for large files. When you need the full file, continue with offset until complete.","parameters":{"type":"object","required":["path","offset","limit"],"properties":{"path":{"type":"string","description":"Path to the file to read (relative or absolute)"},"offset":{"anyOf":[{"type":"number","description":"Line number to start reading from (1-indexed)"},{"type":"null"}]},"limit":{"anyOf":[{"type":"number","description":"Maximum number of lines to read"},{"type":"null"}]}},"additionalProperties":false},"output_schema":null,"strict":true},{"type":"function","name":"bash","description":"Execute a bash command in the current working directory. Returns stdout and stderr. Output is truncated to last 2000 lines or 50KB (whichever is hit first). If truncated, full output is saved to a temp file. Optionally provide a timeout in seconds.","parameters":{"type":"object","required":["command","timeout"],"properties":{"command":{"type":"string","description":"Shell command to execute"},"timeout":{"anyOf":[{"type":"number","description":"Timeout in seconds (optional, no default timeout)"},{"type":"null"}]}},"additionalProperties":false},"output_schema":null,"strict":true},{"type":"function","name":"edit","description":"Edit a single file using exact text replacement. Every edits[].oldText must match a unique, non-overlapping region of the original file. If two changes affect the same block or nearby lines, merge them into one edit instead of emitting overlapping edits. Do not include large unchanged regions just to connect distant changes.","parameters":{"type":"object","required":["path","edits"],"properties":{"path":{"type":"string","description":"Path to the file to edit (relative or absolute)"},"edits":{"type":"array","items":{"type":"object","required":["oldText","newText"],"properties":{"oldText":{"type":"string","description":"Exact text for one targeted replacement. It must be unique in the original file and must not overlap with any other edits[].oldText in the same call."},"newText":{"type":"string","description":"Replacement text for this targeted edit."}},"additionalProperties":false},"description":"One or more targeted replacements. Each edit is matched against the original file, not incrementally. Do not include overlapping or nested edits. If two changes touch the same block or nearby lines, merge them into one edit instead."}},"additionalProperties":false},"output_schema":null,"strict":true},{"type":"function","name":"write","description":"Write content to a file. Creates the file if it doesn't exist, overwrites if it does. Automatically creates parent directories.","parameters":{"type":"object","required":["path","content"],"properties":{"path":{"type":"string","description":"Path to the file to write (relative or absolute)"},"content":{"type":"string","description":"Content to write to the file"}},"additionalProperties":false},"output_schema":null,"strict":true}],"tool_choice":"auto","parallel_tool_calls":true,"prompt_cache_key":"aa288d28-0808-4241-93ac-17b08f636286","prompt_cache_retention":"24h","text":{"format":{"type":"text"},"verbosity":"low"},"top_p":0.98,"top_logprobs":0,"temperature":1.0,"reasoning":{"effort":"medium","summary":"detailed","context":"all_turns","mode":"standard"},"user":null,"usage":{"input_tokens":6165,"input_tokens_details":{"cached_tokens":4608,"cache_write_tokens":0},"output_tokens":1552,"output_tokens_details":{"reasoning_tokens":17},"total_tokens":7717,"attribution":{"items":{"fc_01eaa95975d0f103016acb9a31f4b88194bbd5d22535cb236b":{"input_tokens":50,"cached_tokens":50,"cache_write_tokens":0,"output_tokens":0},"fc_01eaa95975d0f103016acb9a33b8908194a3c0e34a6366c728":{"input_tokens":42,"cached_tokens":42,"cache_write_tokens":0,"output_tokens":0},"fc_01eaa95975d0f103016acb9a34361881949df1fc870f2840db":{"input_tokens":30,"cached_tokens":30,"cache_write_tokens":0,"output_tokens":0},"fc_01eaa95975d0f103016acb9a3436188194bb443a10b001bf28":{"input_tokens":22,"cached_tokens":22,"cache_write_tokens":0,"output_tokens":0},"fc_01eaa95975d0f103016acb9a3567748194901453fd8d74b3b9":{"input_tokens":29,"cached_tokens":29,"cache_write_tokens":0,"output_tokens":0},"fc_01eaa95975d0f103016acb9a390dd881949b6441a99bc025cb":{"input_tokens":143,"cac