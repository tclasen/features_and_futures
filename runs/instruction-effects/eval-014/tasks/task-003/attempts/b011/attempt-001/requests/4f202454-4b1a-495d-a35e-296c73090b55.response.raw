data: {"type":"response.function_call_arguments.done","sequence_number":638,"item_id":"fc_01eaa95975d0f103016acb9a3cee48819489ef83968859db2d","output_index":1,"arguments":"{\"path\":\"server.js\",\"edits\":[{\"oldText\":\"const insertProject = db.prepare('INSERT INTO projects (id, name, created_at) VALUES (?, ?, ?)');\\nconst getProjects = db.prepare('SELECT id, name FROM projects ORDER BY created_at, rowid');\\nconst getProject = db.prepare('SELECT id, name FROM projects WHERE id = ?');\",\"newText\":\"try { db.exec('ALTER TABLE projects ADD COLUMN archived INTEGER NOT NULL DEFAULT 0'); } catch {}\\nconst insertProject = db.prepare('INSERT INTO projects (id, name, created_at) VALUES (?, ?, ?)');\\nconst getProjects = db.prepare(`SELECT p.id, p.name, p.archived, SUM(CASE WHEN t.completed = 1 THEN 1 ELSE 0 END) AS completed, COUNT(t.id) AS total FROM projects p LEFT JOIN tasks t ON t.project_id = p.id WHERE p.archived = ? GROUP BY p.id ORDER BY p.created_at, p.rowid`);\\nconst getProject = db.prepare('SELECT id, name, archived FROM projects WHERE id = ?');\\nconst setArchived = db.prepare('UPDATE projects SET archived = ? WHERE id = ?');\"} ,{\"oldText\":\"if (req.method === 'GET' && url.pathname === '/api/projects') return json(200, getProjects.all());\",\"newText\":\"if (req.method === 'GET' && url.pathname === '/api/projects') return json(200, getProjects.all(url.searchParams.get('filter') === 'Archived' ? 1 : 0));\\n  const archiveMatch = url.pathname.match(/^\\\\/api\\\\/projects\\\\/([^/]+)\\\\/(archive|restore)$/);\\n  if (req.method === 'POST' && archiveMatch) {\\n    const id = decodeURIComponent(archiveMatch[1]);\\n    if (!getProject.get(id)) return json(404, { error: 'Not found' });\\n    setArchived.run(archiveMatch[2] === 'archive' ? 1 : 0, id);\\n    return json(200, { status: 'ok' });\\n  }\"} ,{\"oldText\":\"    if (req.method === 'POST') {\\n      let body;\",\"newText\":\"    if (req.method === 'POST') {\\n      if (getProject.get(projectId).archived) return json(403, { error: 'Archived project' });\\n      let body;\"},{\"oldText\":\"    const result = updateTask.run(body.completed ? 1 : 0, decodeURIComponent(taskMatch[2]), decodeURIComponent(taskMatch[1]));\",\"newText\":\"    const project = getProject.get(decodeURIComponent(taskMatch[1]));\\n    if (!project || project.archived) return json(403, { error: 'Archived project' });\\n    const result = updateTask.run(body.completed ? 1 : 0, decodeURIComponent(taskMatch[2]), decodeURIComponent(taskMatch[1]));\"}]}"}

