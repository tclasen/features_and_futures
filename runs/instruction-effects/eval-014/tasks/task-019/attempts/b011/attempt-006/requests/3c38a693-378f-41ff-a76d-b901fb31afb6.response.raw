'/directory'){const rows=await request('/api/directory');app.innerHTML=`<button class=\\\"back\\\" onclick=\\\"location.href='/'\\\">Projects</button><h1>Task directory</h1><label>Project scope <select aria-label=\\\"Project scope\\\"><option>Active</option><option>Archived</option></select></label> <label>Task filter <select aria-label=\\\"Task filter\\\"><option>All</option><option>Open</option><option>Completed</option><option>Deleted</option></select></label> <label>Priority filter <select aria-label=\\\"Priority filter\\\"><option>All</option><option>Low</option><option>Normal</option><option>High</option></select></label><form class=\\\"form\\\"><input aria-label=\\\"Directory search\\\"><button>Search directory</button></form><label>Due from <input aria-label=\\\"Due from\\\"></label> <label>Due through <input aria-label=\\\"Due through\\\"></label> <button class=\\\"apply\\\">Apply due range</button><div class=\\\"alert-slot\\\" role=\\\"status\\\"></div><section></section>`;let query='',range={from:'',through:''};const scope=app.querySelector('[aria-label=\\\"Project scope\\\"]'),tf=app.querySelector('[aria-label=\\\"Task filter\\\"]'),pf=app.querySelector('[aria-label=\\\"Priority filter\\\"]');function draw(){app.querySelector('section').innerHTML=rows.filter(t=>(t.archived===(scope.value==='Archived'))&&(tf.value==='Deleted'?t.deleted:!t.deleted&&(tf.value==='All'||(tf.value==='Completed')===t.completed))&&(pf.value==='All'||pf.value===t.priority)&&t.title.replace(/[ \\\\\\\\t]+/g,' ').toLowerCase().includes(query.replace(/[ \\\\\\\\t]+/g,' ').toLowerCase())&&(!range.from&&!range.through||t.dueDate&&(!range.from||t.dueDate>=range.from)&&(!range.through||t.dueDate<=range.through))).map(t=>`<div class=\\\"row\\\" data-testid=\\\"directory-task-row\\\"><span data-testid=\\\"directory-task-title\\\">${esc(t.title)}</span><span data-testid=\\\"directory-project-name\\\">${esc(t.projectName)}</span><span data-testid=\\\"directory-task-completion\\\">${t.completed?'Completed':'Open'}</span><span data-testid=\\\"directory-task-priority\\\">${esc(t.priority)}</span><span data-testid=\\\"directory-task-due-date\\\">${esc(t.dueDate)}</span><span data-testid=\\\"directory-task-notes\\\">${esc(t.notes)}</span><button onclick=\\\"location.href='/projects/${encodeURIComponent(t.projectId)}'\\\">Open project</button></div>`).join('')}[scope,tf,pf].forEach(x=>x.onchange=draw);app.querySelector('form').onsubmit=e=>{e.preventDefault();query=app.querySelector('[aria-label=\\\"Directory search\\\"]').value.trim();draw()};app.querySelector('.apply').onclick=()=>{range={from:app.querySelector('[aria-label=\\\"Due from\\\"]').value.trim(),through:app.querySelector('[aria-label=\\\"Due through\\\"]').value.trim()};draw()};draw();return}const match=location.pathname.match(/^\\\\\\\\/projects\\\\\\\\/([^/]+)\\\\\\\\/?$/);if(match){\"},{\"oldText\":\"<h1>Workboard</h1><form class=\\\"form\\\">\",\"newText\":\"<h1>Workboard</h1><button type=\\\"button\\\" onclick=\\\"location.href='/directory'\\\">Task directory</button><form class=\\\"form\\\">\"}]}","status":"completed"}],"error":null,"incomplete_details":null,"tools":[{"type":"function","name":"read","description":"Read the contents of a file. Supports text files and images (jpg, png, gif, webp, bmp). Images are sent as attachments. For text files, output is truncated to 2000 lines or 50KB (whichever is hit first). Use offset/limit for large files. When you need the full file, continue with offset until complete.","parameters":{"type":"object","required":["path","offset","limit"],"properties":{"path":{"type":"string","description":"Path to the file to read (relative or absolute)"},"offset":{"anyOf":[{"type":"number","description":"Line number to start reading from (1-indexed)"},{"type":"null"}]},"limit":{"anyOf":[{"type":"number","description":"Maximum number of lines to read"},{"type":"null"}]}},"additionalProperties":false},"output_schema":null,"strict":true},{"type":"function","name":"bash","description":"Execute a bash command in the current working directory. Returns stdout and stderr. Output is truncated to last 2000 lines or 50KB (whichever is hit first). If truncated, full output is saved to a temp file. Optionally provide a timeout in seconds.","parameters":{"type":"object","required":["command","timeout"],"properties":{"command":{"type":"string","description":"Shell command to execute"},"timeout":{"anyOf":[{"type":"number","description":"Timeout in seconds (optional, no default timeout)"},{"type":"null"}]}},"additionalProperties":false},"output_schema":null,"strict":true},{"type":"function","name":"edit","description":"Edit a single file using exact text replacement. Every edits[].oldText must match a unique, non-overlapping region of the original file. If two changes affect the same block or nearby lines, merge them into one edit instead of emitting overlapping edits. Do not include large unchanged regions just to connect distant changes.","parameters":{"type":"object","required":["path","edits"],"properties":{"path":{"type":"string","description":"Path to the file to edit (relative or absolute)"},"edits":{"type":"array","items":{"type":"object","required":["oldText","newText"],"properties":{"oldText":{"type":"string","description":"Exact text for one targeted replacement. It must be unique in the original file and must not overlap with any other edits[].oldText in the same call."},"newText":{"type":"string","description":"Replacement text for this targeted edit."}},"additionalProperties":false},"description":"One or more targeted replacements. Each edit is matched against the original file, not incrementally. Do not include overlapping or nested edits. If two changes touch the same block or nearby lines, merge them into one edit instead."}},"additionalProperties":false},"output_schema":null,"strict":true},{"type":"function","name":"write","description":"Write content to a file. Creates the file if it doesn't exist, overwrites if it does. Automatically creates parent directories.","parameters":{"type":"object","required":["path","content"],"properties":{"path":{"type":"string","description":"Path to the file to write (relative or absolute)"},"content":{"type":"string","description":"Content to write to the file"}},"additionalProperties":false},"output_schema":null,"strict":true}],"tool_choice":"auto","parallel_tool_calls":true,"prompt_cache_key":"52cdfe19-d94a-40b9-a0fd-86a8a88e5e32","prompt_cache_retention":"24h","text":{"format":{"type":"text"},"verbosity":"low"},"top_p":0.98,"top_logprobs":0,"temperature":1.0,"reasoning":{"effort":"medium","summary":"detailed","context":"all_turns","mode":"standard"},"user":null,"usage":{"input_tokens":16748,"input_tokens_details":{"cached_tokens":5632,"cache_write_tokens":0},"output_tokens":856,"output_tokens_details":{"reasoning_tokens":36},"total_tokens":17604,"attribution":{"items":{"fc_003d18d338300b84016acbb111adec87d2b142f79afce0d93e":{"input_tokens":57,"cached_tokens":0,"cache_write_tokens":0,"output_tokens":0},"fc_003d18d338300b84016acbb113f06c87d2949300df51b2345d":{"input_tokens":28,"cached_tokens":0,"cache_write_tokens":0,"output_tokens":0},"fc_003d18d338300b84016acbb1154b4887d2bd4a7341f81de23f":{"input_tokens":28,"cached_tokens":0,"cache_write_tokens":0,"output_tokens":0},"fc_003d18d338300b84016acbb11677b087d28802c28345cae665":{"input_tokens":29,"cached_tokens":0,"cache_write_tokens":0,"output_tokens":0},"fc_003d18d338300b84016acbb119c74487d2b77183d392c8ab8f":{"input_tokens":286,"cached_tokens":0,"cache_write_tokens":0,"output_tokens":0},"fc_003d18d338300b84016acbb11a944c87d2866d4b1340a51b8f":{"input_tokens":880,"cached_tokens":0,"cache_write_tokens":0,"output_tokens":0,"content":[{"input_tokens":880,"cached_tokens":0,"cache_write_tokens":0,"output_tokens":0}]},"fc_003d18d338300b84016acbb11a944c87d2a56f64d3acaf9d73":{"input_tokens":298,"cached_tokens":0,"cache_write_tokens":0,"output_tokens":0,"content":[{"input_tokens":298,"cached_tokens":0,"cache_writ