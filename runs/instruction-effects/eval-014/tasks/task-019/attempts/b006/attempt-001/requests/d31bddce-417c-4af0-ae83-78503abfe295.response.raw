,"ctco_01a12ba5-eccc-7953-aeab-a6d8dce8bc4d":{"input_tokens":644,"cached_tokens":0,"cache_write_tokens":0,"output_tokens":0,"content":[{"input_tokens":20,"cached_tokens":0,"cache_write_tokens":0,"output_tokens":0},{"input_tokens":1,"cached_tokens":0,"cache_write_tokens":0,"output_tokens":0},{"input_tokens":623,"cached_tokens":0,"cache_write_tokens":0,"output_tokens":0}]},"msg_01a12ba4-de8b-7df3-a4ce-68765724313a":{"input_tokens":728,"cached_tokens":0,"cache_write_tokens":0,"output_tokens":0,"content":[{"input_tokens":482,"cached_tokens":0,"cache_write_tokens":0,"output_tokens":0},{"input_tokens":67,"cached_tokens":0,"cache_write_tokens":0,"output_tokens":0},{"input_tokens":179,"cached_tokens":0,"cache_write_tokens":0,"output_tokens":0}]},"msg_01a12ba4-de8b-7df3-a4ce-688051107eed":{"input_tokens":534,"cached_tokens":0,"cache_write_tokens":0,"output_tokens":0,"content":[{"input_tokens":534,"cached_tokens":0,"cache_write_tokens":0,"output_tokens":0}]},"msg_01a12ba4-de8b-7df3-a4ce-689a692d142f":{"input_tokens":56,"cached_tokens":0,"cache_write_tokens":0,"output_tokens":0,"content":[{"input_tokens":56,"cached_tokens":0,"cache_write_tokens":0,"output_tokens":0}]},"msg_01a12ba4-de8b-7df3-a4ce-68a0a39da7c1":{"input_tokens":97,"cached_tokens":0,"cache_write_tokens":0,"output_tokens":0,"content":[{"input_tokens":97,"cached_tokens":0,"cache_write_tokens":0,"output_tokens":0}]},"msg_01a12ba4-de8c-7423-a427-be4f456a11b8":{"input_tokens":5307,"cached_tokens":0,"cache_write_tokens":0,"output_tokens":0,"content":[{"input_tokens":5307,"cached_tokens":0,"cache_write_tokens":0,"output_tokens":0}]},"msg_07ea51e14d48cdb7016acbaf557fd087d1bc5fbbe8ccad7fa4":{"input_tokens":28,"cached_tokens":0,"cache_write_tokens":0,"output_tokens":0,"content":[{"input_tokens":28,"cached_tokens":0,"cache_write_tokens":0,"output_tokens":0}]},"msg_07ea51e14d48cdb7016acbaf6778b087d186ba25be585a2158":{"input_tokens":43,"cached_tokens":0,"cache_write_tokens":0,"output_tokens":0,"content":[{"input_tokens":43,"cached_tokens":0,"cache_write_tokens":0,"output_tokens":0}]},"msg_8e755851-834c-5723-8487-8e6347931c09":{"input_tokens":4216,"cached_tokens":3992,"cache_write_tokens":0,"output_tokens":0,"content":[{"input_tokens":4216,"cached_tokens":3992,"cache_write_tokens":0,"output_tokens":0}]},"rs_07ea51e14d48cdb7016acbaf5ecec087d191e452218c3a4eb4":{"input_tokens":28,"cached_tokens":0,"cache_write_tokens":0,"output_tokens":0},"rs_07ea51e14d48cdb7016acbaf64c5bc87d1955da19a2e457bfa":{"input_tokens":20,"cached_tokens":0,"cache_write_tokens":0,"output_tokens":0},"rs_07ea51e14d48cdb7016acbaf8a1d2887d199b4db1abc1e6e16":{"input_tokens":20,"cached_tokens":0,"cache_write_tokens":0,"output_tokens":0},"rs_07ea51e14d48cdb7016acbaf9d07b887d1903f0182b8a6a078":{"input_tokens":2,"cached_tokens":0,"cache_write_tokens":0,"output_tokens":38}}}},"tool_usage":{"image_gen":{"input_tokens":0,"output_tokens":0,"total_tokens":0,"input_tokens_details":{"text_tokens":0,"image_tokens":0},"output_tokens_details":{"image_tokens":0,"text_tokens":0}},"web_search":{"num_requests":0}},"safety_identifier":"user-ZglLa0AK1sUTDt85g9NsGTX5","store":false,"metadata":{},"max_output_tokens":null,"max_tool_calls":null,"service_tier":"default","truncation":"disabled"}}
