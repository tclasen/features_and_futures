r=Low`)), ['Low open', 'High renamed']);\\n    assert.match(await get('/'), /3\\\\/5 completed/);\\n  } finally {\\n    if (server) await server.stop();\\n    await rm(directory, { recursive: true, force: true });\\n  }\\n});\\n\\ntest('due dates migrate, validate, clear, and persist independently with archive protection', async () => {\\n  const directory = await mkdtemp(join(tmpdir(), 'workboard-dates-'));\\n  const databasePath = join(directory, 'workboard.sqlite');\\n  const legacy = new DatabaseSync(databasePath);\\n  legacy.exec(`\\n    CREATE TABLE projects (position INTEGER PRIMARY KEY AUTOINCREMENT, id TEXT NOT NULL UNIQUE, name TEXT NOT NULL);\\n    CREATE TABLE tasks (position INTEGER PRIMARY KEY AUTOINCREMENT, id TEXT NOT NULL UNIQUE, project_id TEXT NOT NULL, title TEXT NOT NULL, completed INTEGER NOT NULL DEFAULT 0);\\n    INSERT INTO projects (id, name) VALUES ('first', 'First'), ('second', 'Second');\\n    INSERT INTO tasks (id, project_id, title, completed) VALUES ('old', 'first', 'Existing', 1);\\n  `);\\n  legacy.close();\\n  let server;\\n  try {\\n    server = await startServer(databasePath);\\n    const get = async (path) => (await fetch(`${server.url}${path}`)).text();\\n    const post = (path, values = {}) => fetch(`${server.url}${path}`, {\\n      method: 'POST', body: new URLSearchParams(values), redirect: 'manual',\\n    });\\n    const taskPath = '/projects/first/tasks/old';\\n    const fields = { filter: 'Completed', priorityFilter: 'Normal' };\\n    const filteredPath = '/projects/first?filter=Completed&priorityFilter=Normal';\\n    const dateInput = /id=\\\"task-due-date-old\\\" name=\\\"dueDate\\\" type=\\\"text\\\" value=\\\"([^\\\"]*)\\\"/;\\n    assert.equal((await get('/projects/first')).match(dateInput)[1], '');\\n    await post('/projects/first/tasks', { title: 'New' });\\n    assert.equal((await get('/projects/first')).match(/name=\\\"dueDate\\\" type=\\\"text\\\" value=\\\"\\\"/g).length, 2);\\n    const summary = await get('/');\\n    let response = await post(`${taskPath}/due-date`, { ...fields, dueDate: '  2000-02-29  ' });\\n    assert.equal(response.status, 303);\\n    assert.equal(response.headers.get('location'), filteredPath);\\n    let html = await get(filteredPath);\\n    assert.equal(html.match(dateInput)[1], '2000-02-29');\\n    assert.match(html, /<option selected>Completed/);\\n    assert.match(html, /id=\\\"priority-filter\\\"[\\\\s\\\\S]*?<option selected>Normal/);\\n    assert.equal((await get('/projects/first')).match(/name=\\\"dueDate\\\" type=\\\"text\\\" value=\\\"\\\"/g).length, 1);\\n    assert.equal(await get('/'), summary);\\n    for (const dueDate of ['1900-02-29', '2025-04-31', '0000-01-01', '10000-01-01', '2025-1-01', '<script>']) {\\n      response = await post(`${taskPath}/due-date`, { ...fields, dueDate });\\n      assert.equal(response.status, 422);\\n      const invalid = await response.text();\\n      assert.match(invalid, /role=\\\"alert\\\">Due date must be a valid YYYY-MM-DD date/);\\n      assert.equal(invalid.match(dateInput)[1], '2000-02-29');\\n      assert.equal(await get(filteredPath), html);\\n    }\\n    assert.equal((await post('/projects/second/tasks/old/due-date', { dueDate: '2025-01-01' })).status, 404);\\n    await post(`${taskPath}/rename`, { ...fields, title: 'Renamed' });\\n    html = await get(filteredPath);\\n    assert.match(html, /Complete Renamed\\\" checked/);\\n    assert.equal(html.match(dateInput)[1], '2000-02-29');\\n    await server.stop();\\n    server = await startServer(databasePath);\\n    assert.equal(await get(filteredPath), html);\\n    await post('/projects/first/archive');\\n    const archived = await get(filteredPath);\\n    assert.match(archived, /name=\\\"dueDate\\\" type=\\\"text\\\" value=\\\"2000-02-29\\\" disabled/);\\n    assert.match(archived, /<button type=\\\"submit\\\" disabled>Save due date/);\\n    assert.equal((await post(`${taskPath}/due-date`, { dueDate: '' })).status, 403);\\n    assert.equal(await get(filteredPath), archived);\\n    await server.stop();\\n    server = await startServer(databasePath);\\n    assert.equal(await get(filteredPath), archived);\\n    await post('/projects/first/restore');\\n    assert.equal(await get(filteredPath), html);\\n    for (const dueDate of ['', '  \\\\t ']) {\\n      await post(`${taskPath}/due-date`, { ...fields, dueDate: '9999-12-31' });\\n      response = await post(`${taskPath}/due-date`, { ...fields, dueDate });\\n      assert.equal(response.headers.get('location'), filteredPath);\\n      assert.equal((await get(filteredPath)).match(dateInput)[1], '');\\n    }\\n    html = await get(filteredPath);\\n    await server.stop();\\n    server = await startServer(databasePath);\\n    assert.equal(await get(filteredPath), html);\\n    assert.equal(await get('/'), summary);\\n  } finally {\\n    if (server) await server.stop();\\n    await rm(directory, { recursive: true, force: true });\\n  }\\n});\"}]}","status":"completed"}],"error":null,"incomplete_details":null,"tools":[{"type":"function","name":"read","description":"Read the contents of a file. Supports text files and images (jpg, png, gif, webp, bmp). Images are sent as attachments. For text files, output is truncated to 2000 lines or 50KB (whichever is hit first). Use offset/limit for large files. When you need the full file, continue with offset until complete.","parameters":{"type":"object","required":["path","offset","limit"],"properties":{"path":{"type":"string","description":"Path to the file to read (relative or absolute)"},"offset":{"anyOf":[{"type":"number","description":"Line number to start reading from (1-indexed)"},{"type":"null"}]},"limit":{"anyOf":[{"type":"number","description":"Maximum number of lines to read"},{"type":"null"}]}},"additionalProperties":false},"output_schema":null,"strict":true},{"type":"function","name":"bash","description":"Execute a bash command in the current working directory. Returns stdout and stderr. Output is truncated to last 2000 lines or 50KB (whichever is hit first). If truncated, full output is saved to a temp file. Optionally provide a timeout in seconds.","parameters":{"type":"object","required":["command","timeout"],"properties":{"command":{"type":"string","description":"Shell command to execute"},"timeout":{"anyOf":[{"type":"number","description":"Timeout in seconds (optional, no default timeout)"},{"type":"null"}]}},"additionalProperties":false},"output_schema":null,"strict":true},{"type":"function","name":"edit","description":"Edit a single file using exact text replacement. Every edits[].oldText must match a unique, non-overlapping region of the original file. If two changes affect the same block or nearby lines, merge them into one edit instead of emitting overlapping edits. Do not include large unchanged regions just to connect distant changes.","parameters":{"type":"object","required":["path","edits"],"properties":{"path":{"type":"string","description":"Path to the file to edit (relative or absolute)"},"edits":{"type":"array","items":{"type":"object","required":["oldText","newText"],"properties":{"oldText":{"type":"string","description":"Exact text for one targeted replacement. It must be unique in the original file and must not overlap with any other edits[].oldText in the same call."},"newText":{"type":"string","description":"Replacement text for this targeted edit."}},"additionalProperties":false},"description":"One or more targeted replacements. Each edit is matched against the original file, not incrementally. Do not include overlapping or nested edits. If two changes touch the same block or nearby lines, merge them into one edit instead."}},"additionalProperties":false},"output_schema":null,"strict":true},{"type":"function","name":"write","description":"Write content to a file. Creates the file if it doesn't exist, overwrites if it does. Automatically creates parent directories.","parameters":{"type":"object","required":["path","content"],"properties":{"path":{"type":