\":\"try { db.exec(\\\"ALTER TABLE tasks ADD COLUMN priority TEXT NOT NULL DEFAULT 'Normal'\\\"); } catch {}\\ntry { db.exec(\\\"ALTER TABLE projects ADD COLUMN default_priority TEXT NOT NULL DEFAULT 'Normal'\\\"); } catch {}\"},{\"oldText\":\"+'<form id=\\\"create-task\\\"><input id=\\\"task-title\\\"\",\"newText\":\"+'<label>Default task priority <select id=\\\"default-priority\\\"'+(p.archived?' disabled':'')+'><option'+(p.default_priority==='Low'?' selected':'')+'>Low</option><option'+(p.default_priority==='Normal'?' selected':'')+'>Normal</option><option'+(p.default_priority==='High'?' selected':'')+'>High</option></select></label><form id=\\\"create-task\\\"><input id=\\\"task-title\\\"\"},{\"oldText\":\"if(!p.archived){document.getElementById('rename').onsubmit=async e=>\",\"newText\":\"if(!p.archived){document.getElementById('default-priority').onchange=async e=>{await fetch('/api/projects/'+p.id,{method:'PATCH',headers:{'content-type':'application/json'},body:JSON.stringify({default_priority:e.target.value})})};document.getElementById('rename').onsubmit=async e=>\"},{\"oldText\":\"const project = db.prepare('SELECT id, name, archived FROM projects WHERE id = ?').get(Number(projectItem[1]));\",\"newText\":\"const project = db.prepare('SELECT id, name, archived, default_priority FROM projects WHERE id = ?').get(Number(projectItem[1]));\"},{\"oldText\":\"const name = String((await readBody(req)).name ?? '').trim();\\n      if (!name) return send(res, 400, { error: 'Project name is required' });\\n      const project = db.prepare('SELECT archived FROM projects WHERE id = ?').get(Number(projectItem[1]));\\n      if (!project) return send(res, 404, { error: 'Not found' });\\n      if (project.archived) return send(res, 409, { error: 'Archived projects cannot be renamed' });\\n      db.prepare('UPDATE projects SET name = ? WHERE id = ?').run(name, Number(projectItem[1]));\\n      return send(res, 200, db.prepare('SELECT id, name FROM projects WHERE id = ?').get(Number(projectItem[1])));\",\"newText\":\"const body = await readBody(req);\\n      const project = db.prepare('SELECT archived FROM projects WHERE id = ?').get(Number(projectItem[1]));\\n      if (!project) return send(res, 404, { error: 'Not found' });\\n      if (project.archived) return send(res, 409, { error: 'Archived projects cannot be changed' });\\n      if (Object.hasOwn(body, 'default_priority')) {\\n        if (!['Low', 'Normal', 'High'].includes(body.default_priority)) return send(res, 400, { error: 'Invalid priority' });\\n        db.prepare('UPDATE projects SET default_priority=? WHERE id=?').run(body.default_priority, Number(projectItem[1]));\\n      } else {\\n        const name = String(body.name ?? '').trim();\\n        if (!name) return send(res, 400, { error: 'Project name is required' });\\n        db.prepare('UPDATE projects SET name = ? WHERE id = ?').run(name, Number(projectItem[1]));\\n      }\\n      return send(res, 200, db.prepare('SELECT id, name, default_priority FROM projects WHERE id = ?').get(Number(projectItem[1])));\"},{\"oldText\":\"if (!db.prepare('SELECT id FROM projects WHERE id = ?').get(projectId)) return send(res, 404, { error: 'Not found' });\",\"newText\":\"const project = db.prepare('SELECT id, archived, default_priority FROM projects WHERE id = ?').get(projectId);\\n      if (!project) return send(res, 404, { error: 'Not found' });\\n      if (project.archived) return send(res, 409, { error: 'Archived projects cannot be changed' });\"},{\"oldText\":\"const result = db.prepare('INSERT INTO tasks (project_id, title) VALUES (?, ?)').run(projectId, title);\",\"newText\":\"const result = db.prepare('INSERT INTO tasks (project_id, title, priority) VALUES (?, ?, ?)').run(projectId, title, project.default_priority);\"}]}","status":"completed"}],"error":null,"incomplete_details":null,"tools":[{"type":"function","name":"read","description":"Read the contents of a file. Supports text files and images (jpg, png, gif, webp, bmp). Images are sent as attachments. For text files, output is truncated to 2000 lines or 50KB (whichever is hit first). Use offset/limit for large files. When you need the full file, continue with offset until complete.","parameters":{"type":"object","required":["path","offset","limit"],"properties":{"path":{"type":"string","description":"Path to the file to read (relative or absolute)"},"offset":{"anyOf":[{"type":"number","description":"Line number to start reading from (1-indexed)"},{"type":"null"}]},"limit":{"anyOf":[{"type":"number","description":"Maximum number of lines to read"},{"type":"null"}]}},"additionalProperties":false},"output_schema":null,"strict":true},{"type":"function","name":"bash","description":"Execute a bash command in the current working directory. Returns stdout and stderr. Output is truncated to last 2000 lines or 50KB (whichever is hit first). If truncated, full output is saved to a temp file. Optionally provide a timeout in seconds.","parameters":{"type":"object","required":["command","timeout"],"properties":{"command":{"type":"string","description":"Shell command to execute"},"timeout":{"anyOf":[{"type":"number","description":"Timeout in seconds (optional, no default timeout)"},{"type":"null"}]}},"additionalProperties":false},"output_schema":null,"strict":true},{"type":"function","name":"edit","description":"Edit a single file using exact text replacement. Every edits[].oldText must match a unique, non-overlapping region of the original file. If two changes affect the same block or nearby lines, merge them into one edit instead of emitting overlapping edits. Do not include large unchanged regions just to connect distant changes.","parameters":{"type":"object","required":["path","edits"],"properties":{"path":{"type":"string","description":"Path to the file to edit (relative or absolute)"},"edits":{"type":"array","items":{"type":"object","required":["oldText","newText"],"properties":{"oldText":{"type":"string","description":"Exact text for one targeted replacement. It must be unique in the original file and must not overlap with any other edits[].oldText in the same call."},"newText":{"type":"string","description":"Replacement text for this targeted edit."}},"additionalProperties":false},"description":"One or more targeted replacements. Each edit is matched against the original file, not incrementally. Do not include overlapping or nested edits. If two changes touch the same block or nearby lines, merge them into one edit instead."}},"additionalProperties":false},"output_schema":null,"strict":true},{"type":"function","name":"write","description":"Write content to a file. Creates the file if it doesn't exist, overwrites if it does. Automatically creates parent directories.","parameters":{"type":"object","required":["path","content"],"properties":{"path":{"type":"string","description":"Path to the file to write (relative or absolute)"},"content":{"type":"string","description":"Content to write to the file"}},"additionalProperties":false},"output_schema":null,"strict":true}],"tool_choice":"auto","parallel_tool_calls":true,"prompt_cache_key":"05aae9aa-ff2b-4040-838a-a151a40549aa","prompt_cache_retention":"24h","text":{"format":{"type":"text"},"verbosity":"low"},"top_p":0.98,"top_logprobs":0,"temperature":1.0,"reasoning":{"effort":"medium","summary":"detailed","context":"all_turns","mode":"standard"},"user":null,"usage":{"input_tokens":7696,"input_tokens_details":{"cached_tokens":1536,"cache_write_tokens":0},"output_tokens":1065,"output_tokens_details":{"reasoning_tokens":54},"total_tokens":8761,"attribution":{"items":{"fc_03cdcaa6edcc4df6016acb9e27bbc087d1bb103a0054ac2979":{"input_tokens":78,"cached_tokens":0,"cache_write_tokens":0,"output_tokens":0},"fc_03cdcaa6edcc4df6016acb9e2a03d087d1803cc63ca243fabd":{"input_tokens":28,"cached_tokens":0,"cache_write_tokens":0,"output_tokens":0},"fc_03cdcaa6edcc4df6016acb9e2a94dc87d1938c1a4d4cf8cccd":{"input_tokens":280,"cached_tokens":0,"cache_write_tokens":0,"output_tokens":0,"content":[{"input_tokens":280,"cached_tokens":0,"cache_write_tokens":0,"output_tokens":0}]},"fc_03cdcaa6edcc4df6016acb9e2a94dc87d1be552a440f5cef02":{"input_tokens":4157,"cached_tokens":0,"cache_write_tokens":0,"output_tokens":0,"content":[{"input_tokens":4157,"cached_tokens":0,"cache_write_tokens":0,"output_tokens":0}]},"fc_03cdcaa6edcc4df6016acb9e2e0ca487d1b109395d0f9850d6":{"input_tokens":0,"cached_tokens":0,"cache_write_tokens":0,"output_tokens":1011},"msg_03cdcaa6edcc4df6016acb9e2a94dc87d1ad215ebab83454ee":{"input_tokens":2041,"cached_tokens":426,"cache_write_tokens":0,"output_tokens":0,"content":[{"input_tokens":2041,"cached_tokens":426,"cache_write_tokens":0,"output_tokens":0}]},"rs_03cdcaa6edcc4df6016acb9e2b1bc887d1855b9d6242833602":{"input_tokens":2,"cached_tokens":0,"cache_write_tokens":0,"output_tokens":54}},"request_fields":{"instructions":{"input_tokens":617,"cached_tokens":617,"cache_write_tokens":0,"output_tokens":0},"tools":{"input_tokens":493,"cached_tokens":493,"cache_write_tokens":0,"output_tokens":0}}}},"tool_usage":{"image_gen":{"input_tokens":0,"output_tokens":0,"total_tokens":0,"input_tokens_details":{"text_tokens":0,"image_tokens":0},"output_tokens_details":{"image_tokens":0,"text_tokens":0}},"web_search":{"num_requests":0}},"safety_identifier":"user-ZglLa0AK1sUTDt85g9NsGTX5","store":false,"metadata":{},"max_output_tokens":null,"max_tool_calls":null,"service_tier":"default","truncation":"disabled"}}
