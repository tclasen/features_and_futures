est('project defaults migrate, inherit independently and persist without altering existing tasks', async () => {\\n  const directory = await mkdtemp(join(tmpdir(), 'workboard-defaults-'));\\n  let server;\\n  try {\\n    const dbPath = join(directory, 'db.sqlite');\\n    const db = new DatabaseSync(dbPath);\\n    db.exec(`CREATE TABLE projects (id INTEGER PRIMARY KEY AUTOINCREMENT, name TEXT NOT NULL);\\n      CREATE TABLE tasks (id INTEGER PRIMARY KEY AUTOINCREMENT, project_id INTEGER NOT NULL REFERENCES projects(id),\\n        title TEXT NOT NULL, completed INTEGER NOT NULL DEFAULT 0);\\n      INSERT INTO projects (name) VALUES ('Existing');\\n      INSERT INTO tasks (project_id, title, completed) VALUES (1, 'Original', 1);`);\\n    db.close();\\n    server = await start(dbPath);\\n    const get = async path => (await fetch(server.url + path)).text();\\n    const post = (path, values = {}) => fetch(server.url + path, {\\n      method: 'POST', body: new URLSearchParams(values)\\n    });\\n    const defaultSelect = html => html.match(/<select id=\\\"default-task-priority\\\"[^>]*>[\\\\s\\\\S]*?<\\\\/select>/)[0];\\n    const taskSelect = (html, id) => html.match(new RegExp(`<select id=\\\"task-priority-${id}\\\"[^>]*>[\\\\\\\\s\\\\\\\\S]*?<\\\\\\\\/select>`))[0];\\n    let html = await get('/projects/1');\\n    assert.match(defaultSelect(html), /<option>Low<\\\\/option>\\\\s*<option selected>Normal<\\\\/option>\\\\s*<option>High<\\\\/option>/);\\n    assert.match(taskSelect(html, 1), /<option selected>Normal/);\\n    await post('/projects', { name: 'Independent' });\\n    assert.match(defaultSelect(await get('/projects/2')), /<option selected>Normal/);\\n    const selected = { filter: 'Completed', priorityFilter: 'Normal' };\\n    html = await (await post('/projects/1/default-priority', { ...selected, priority: 'High' })).text();\\n    assert.match(defaultSelect(html), /<option selected>High/);\\n    assert.match(html, /id=\\\"task-filter\\\"[\\\\s\\\\S]*?<option selected>Completed/);\\n    assert.match(html, /id=\\\"priority-filter\\\"[\\\\s\\\\S]*?<option selected>Normal/);\\n    assert.match(html, /aria-label=\\\"Complete Original\\\" checked/);\\n    assert.equal((html.match(/data-testid=\\\"task-row\\\"/g) || []).length, 1);\\n    await post('/projects/1/tasks', { title: 'Inherited high' });\\n    await post('/projects/2/tasks', { title: 'Independent normal' });\\n    html = await get('/projects/1');\\n    assert.match(taskSelect(html, 1), /<option selected>Normal/);\\n    assert.match(taskSelect(html, 2), /<option selected>High/);\\n    assert.match(taskSelect(await get('/projects/2'), 3), /<option selected>Normal/);\\n    await post('/projects/1/default-priority', { priority: 'Low' });\\n    await post('/projects/1/tasks', { title: 'Inherited low' });\\n    await post('/projects/1/tasks/2/rename', { title: 'Renamed high' });\\n    await post('/projects/1/rename', { name: 'Renamed project' });\\n    html = await get('/projects/1');\\n    assert.match(taskSelect(html, 2), /<option selected>High/);\\n    assert.match(taskSelect(html, 4), /<option selected>Low/);\\n    assert.ok(html.indexOf('Complete Original') < html.indexOf('Complete Renamed high'));\\n    assert.ok(html.indexOf('Complete Renamed high') < html.indexOf('Complete Inherited low'));\\n    assert.match(await get('/'), /1\\\\/3 completed/);\\n    assert.equal((await post('/projects/1/default-priority', { priority: 'Invalid' })).status, 400);\\n    assert.equal((await post('/projects/999/default-priority', { priority: 'High' })).status, 404);\\n    await post('/projects/1/archive');\\n    html = await get('/projects/1');\\n    assert.match(defaultSelect(html), / disabled/);\\n    assert.match(defaultSelect(html), /<option selected>Low/);\\n    assert.equal((await post('/projects/1/default-priority', { priority: 'High' })).status, 403);\\n    await server.stop();\\n    server = await start(dbPath);\\n    assert.equal(await get('/projects/1'), html);\\n    await post('/projects/1/restore');\\n    html = await get('/projects/1');\\n    assert.doesNotMatch(defaultSelect(html), / disabled/);\\n    assert.match(defaultSelect(html), /<option selected>Low/);\\n    await post('/projects/1/tasks', { title: 'After restore' });\\n    assert.match(taskSelect(await get('/projects/1'), 5), /<option selected>Low/);\\n    assert.match(await get('/'), /1\\\\/4 completed/);\\n    await post('/projects/1/default-priority', { priority: 'Normal' });\\n    html = await get('/projects/1');\\n    await server.stop();\\n    server = await start(dbPath);\\n    assert.equal(await get('/projects/1'), html);\\n  } finally {\\n    if (server) await server.stop();\\n    await rm(directory, { recursive: true, force: true });\\n  }\\n});\\n\\ntest('combined filters preserve selections through edits, archive and restart', async () => {\"}]}","status":"completed"}],"error":null,"incomplete_details":null,"tools":[{"type":"function","name":"read","description":"Read the contents of a file. Supports text files and images (jpg, png, gif, webp, bmp). Images are sent as attachments. For text files, output is truncated to 2000 lines or 50KB (whichever is hit first). Use offset/limit for large files. When you need the full file, continue with offset until complete.","parameters":{"type":"object","required":["path","offset","limit"],"properties":{"path":{"type":"string","description":"Path to the file to read (relative or absolute)"},"offset":{"anyOf":[{"type":"number","description":"Line number to start reading from (1-indexed)"},{"type":"null"}]},"limit":{"anyOf":[{"type":"number","description":"Maximum number of lines to read"},{"type":"null"}]}},"additionalProperties":false},"output_schema":null,"strict":true},{"type":"function","name":"bash","description":"Execute a bash command in the current working directory. Returns stdout and stderr. Output is truncated to last 2000 lines or 50KB (whichever is hit first). If truncated, full output is saved to a temp file. Optionally provide a timeout in seconds.","parameters":{"type":"object","required":["command","timeout"],"properties":{"command":{"type":"string","description":"Shell command to execute"},"timeout":{"anyOf":[{"type":"number","description":"Timeout in seconds (optional, no default timeout)"},{"type":"null"}]}},"additionalProperties":false},"output_schema":null,"strict":true},{"type":"function","name":"edit","description":"Edit a single file using exact text replacement. Every edits[].oldText must match a unique, non-overlapping region of the original file. If two changes affect the same block or nearby lines, merge them into one edit instead of emitting overlapping edits. Do not include large unchanged regions just to connect distant changes.","parameters":{"type":"object","required":["path","edits"],"properties":{"path":{"type":"string","description":"Path to the file to edit (relative or absolute)"},"edits":{"type":"array","items":{"type":"object","required":["oldText","newText"],"properties":{"oldText":{"type":"string","description":"Exact text for one targeted replacement. It must be unique in the original file and must not overlap with any other edits[].oldText in the same call."},"newText":{"type":"string","description":"Replacement text for this targeted edit."}},"additionalProperties":false},"description":"One or more targeted replacements. Each edit is matched against the original file, not incrementally. Do not include overlapping or nested edits. If two changes touch the same block or nearby lines, merge them into one edit instead."}},"additionalProperties":false},"output_schema":null,"strict":true},{"type":"function","name":"write","description":"Write content to a file. Creates the file if it doesn't exist, overwrites if it does. Automatically creates parent directories.","parameters":{"type":"object","required":["path","content"],"properties":{"path":{"type":"string","description":"Path to the file to write (relative or absolute)"},"content":{"type":"string","description":"Content to write to the file"}},"additionalProperties":false},"output_schema":null,"strict":true}],"tool_choice":"auto","parallel_tool_calls":true,"prompt_cache_key":"16455d88-339e-4ac8-bcfd-144a85515019","prompt_cache_retention":"24h","text":{"format":{"type":"text"},"verbosity":"low"},"top_p":0.98,"top_logprobs":0,"temperature":1.0,"reasoning":{"effort":"medium","summary":"detailed","context":"all_turns","mode":"standard"},"user":null,"usage":{"input_tokens":11700,"input_tokens_details":{"cached_tokens":0,"cache_write_tokens":0},"output_tokens":1366,"output_tokens_details":{"reasoning_tokens":24},"total_tokens":13066,"attribution":{"items":{"fc_0facdaf722f9671c016acb9e26c74881978bed339b827ea516":{"input_tokens":46,"cached_tokens":0,"cache_write_tokens":0,"output_tokens":0},"fc_0facdaf722f9671c016acb9e2abb4c81979f0a24eca90564a5":{"input_tokens":42,"cached_tokens":0,"cache_write_tokens":0,"output_tokens":0},"fc_0facdaf722f9671c016acb9e2d0fc481978902b36df15fa769":{"input_tokens":24,"cached_tokens":0,"cache_write_tokens":0,"output_tokens":0},"fc_0facdaf722f9671c016acb9e2d0fc48197a81650eea812d6bc":{"input_tokens":22,"cached_tokens":0,"cache_write_tokens":0,"output_tokens":0},"fc_0facdaf722f9671c016acb9e2d0fc48197bbfeec8c84c2c6e4":{"input_tokens":19,"cached_tokens":0,"cache_write_tokens":0,"output_tokens":0},"fc_0facdaf722f9671c016acb9e3038c48197ba91f15d44b3b447":{"input_tokens":30,"cached_tokens":0,"cache_write_tokens":0,"output_tokens":0},"fc_0facdaf722f9671c016acb9e3273508197a083d388df1ba3d9":{"input_tokens":825,"cached_tokens":0,"cache_write_tokens":0,"output_tokens":0},"fc_0facdaf722f9671c016acb9e41ebc481978eccabb285f9cf71":{"input_tokens":255,"cached_tokens":0,"cache_write_tokens":0,"output_tokens":0,"content":[{"input_tokens":255,"cached_tokens":0,"cache_write_tokens":0,"output_tokens":0}]},"fc_0facdaf722f9671c016acb9e41ebc48197915d4e090045536f":{"input_tokens":13,"cached_tokens":0,"cache_write_tokens":0,"output_tokens":0,"content":[{"input_t