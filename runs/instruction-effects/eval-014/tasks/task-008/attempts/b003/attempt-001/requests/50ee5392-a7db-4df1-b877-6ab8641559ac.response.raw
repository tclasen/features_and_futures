data: {"type":"response.function_call_arguments.done","sequence_number":814,"item_id":"fc_0facdaf722f9671c016acb9e3273508197a083d388df1ba3d9","output_index":0,"arguments":"{\"path\":\"server.js\",\"edits\":[{\"oldText\":\"const createTask = db.prepare('INSERT INTO tasks (project_id, title) VALUES (?, ?)');\",\"newText\":\"if (!db.prepare('PRAGMA table_info(projects)').all().some(column => column.name === 'default_priority')) {\\n  db.exec(\\\"ALTER TABLE projects ADD COLUMN default_priority TEXT NOT NULL DEFAULT 'Normal' CHECK (default_priority IN ('Low', 'Normal', 'High'))\\\");\\n}\\nconst updateDefaultPriority = db.prepare('UPDATE projects SET default_priority = ? WHERE id = ? AND archived = 0');\\nconst createTask = db.prepare('INSERT INTO tasks (project_id, title, priority) VALUES (?, ?, ?)');\"},{\"oldText\":\"const getProject = db.prepare('SELECT id, name, archived FROM projects WHERE id = ?');\",\"newText\":\"const getProject = db.prepare('SELECT id, name, archived, default_priority FROM projects WHERE id = ?');\"},{\"oldText\":\"    <form class=\\\"create\\\" method=\\\"post\\\" action=\\\"/projects/${project.id}/tasks\\\">\",\"newText\":\"    <form class=\\\"filter\\\" method=\\\"post\\\" action=\\\"/projects/${project.id}/default-priority\\\">\\n      <input type=\\\"hidden\\\" name=\\\"filter\\\" value=\\\"${filter}\\\">\\n      <input type=\\\"hidden\\\" name=\\\"priorityFilter\\\" value=\\\"${priority}\\\">\\n      <label for=\\\"default-task-priority\\\">Default task priority</label>\\n      <select id=\\\"default-task-priority\\\" name=\\\"priority\\\"${project.archived ? ' disabled' : ''} onchange=\\\"this.form.requestSubmit()\\\">\\n        ${['Low', 'Normal', 'High'].map(option => `<option${option === project.default_priority ? ' selected' : ''}>${option}</option>`).join('')}\\n      </select>\\n    </form>\\n    <form class=\\\"create\\\" method=\\\"post\\\" action=\\\"/projects/${project.id}/tasks\\\">\"},{\"oldText\":\"    } else if (req.method === 'POST' && /^\\\\/projects\\\\/\\\\d+\\\\/rename$/.test(url.pathname)) {\",\"newText\":\"    } else if (req.method === 'POST' && /^\\\\/projects\\\\/\\\\d+\\\\/default-priority$/.test(url.pathname)) {\\n      const id = Number(url.pathname.split('/')[2]);\\n      const project = Number.isSafeInteger(id) ? getProject.get(id) : undefined;\\n      if (!project) {\\n        sendHtml(res, 404, page('Not found', '<h1>Project not found</h1>'));\\n        return;\\n      }\\n      const form = await readForm(req);\\n      const filter = taskFilter(form.get('filter'));\\n      const selectedPriority = priorityFilter(form.get('priorityFilter'));\\n      if (project.archived) {\\n        sendHtml(res, 403, projectPage(project, filter, 'Archived project cannot be changed', selectedPriority));\\n        return;\\n      }\\n      const priority = form.get('priority');\\n      if (!['Low', 'Normal', 'High'].includes(priority)) {\\n        sendHtml(res, 400, projectPage(project, filter, 'Invalid task priority', selectedPriority));\\n        return;\\n      }\\n      updateDefaultPriority.run(priority, id);\\n      res.writeHead(303, { Location: `/projects/${id}?filter=${filter}${selectedPriority === 'All' ? '' : `&priorityFilter=${selectedPriority}`}` });\\n      res.end();\\n    } else if (req.method === 'POST' && /^\\\\/projects\\\\/\\\\d+\\\\/rename$/.test(url.pathname)) {\"},{\"oldText\":\"        createTask.run(projectId, title);\",\"newText\":\"        createTask.run(projectId, title, project.default_priority);\"}]}"}

