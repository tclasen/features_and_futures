_tokens":0,"input_tokens":1581,"output_tokens":0},"ctco_01a12b69-9bd2-74f1-b2be-6591e89208c8":{"cache_write_tokens":0,"cached_tokens":0,"content":[{"cache_write_tokens":0,"cached_tokens":0,"input_tokens":20,"output_tokens":0},{"cache_write_tokens":0,"cached_tokens":0,"input_tokens":834,"output_tokens":0}],"input_tokens":854,"output_tokens":0},"rs_0480fcd722730c6a016acba02a709c87d1999429b8baffb7a3":{"cache_write_tokens":0,"cached_tokens":0,"input_tokens":27,"output_tokens":0},"ctc_0480fcd722730c6a016acba02a989487d182faf7212fe3b243":{"cache_write_tokens":0,"cached_tokens":0,"input_tokens":48,"output_tokens":0},"ctco_01a12b69-ace8-75e3-a629-d42f2373a992":{"cache_write_tokens":0,"cached_tokens":0,"content":[{"cache_write_tokens":0,"cached_tokens":0,"input_tokens":20,"output_tokens":0},{"cache_write_tokens":0,"cached_tokens":0,"input_tokens":4073,"output_tokens":0}],"input_tokens":4093,"output_tokens":0},"rs_0480fcd722730c6a016acba02f66d087d1926216599e30610e":{"cache_write_tokens":0,"cached_tokens":0,"input_tokens":2,"output_tokens":32},"ctc_0480fcd722730c6a016acba030855487d1929c97fc791efb13":{"cache_write_tokens":0,"cached_tokens":0,"input_tokens":0,"output_tokens":2615}}},"input_tokens":34946,"input_tokens_details":{"cache_write_tokens":0,"cached_tokens":9088},"output_tokens":2647,"output_tokens_details":{"reasoning_tokens":32},"total_tokens":37593},"user":null,"metadata":{}},"sequence_number":2610}
