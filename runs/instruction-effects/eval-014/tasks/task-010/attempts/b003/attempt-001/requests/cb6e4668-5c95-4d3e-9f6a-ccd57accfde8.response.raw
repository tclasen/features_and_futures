{\\n        sendHtml(res, 200, projectPage(project, filter, error, priority, previous));\\n        return;\\n      }\\n      res.writeHead(303, { Location: projectLocation(id, filter, priority, { from, through }) });\\n      res.end();\\n    } else if (req.method === 'POST' && /^\\\\/projects\\\\/\\\\d+\\\\/default-priority$/.test(url.pathname)) {\"},{\"oldText\":\"projectPage(project, taskFilter(url.searchParams.get('filter')), '', priorityFilter(url.searchParams.get('priorityFilter')))\",\"newText\":\"projectPage(project, taskFilter(url.searchParams.get('filter')), '', priorityFilter(url.searchParams.get('priorityFilter')), dueRange(url.searchParams))\"}]}","status":"completed"}}

