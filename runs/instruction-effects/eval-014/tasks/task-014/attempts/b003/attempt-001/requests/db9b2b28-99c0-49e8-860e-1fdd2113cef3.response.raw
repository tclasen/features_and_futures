it get('/'), /1\\\\/5 completed/);\\n  } finally {\\n    if (server) await server.stop();\\n    await rm(directory, { recursive: true, force: true });\\n  }\\n});\",\"newText\":\"    assert.match(await get('/'), /1\\\\/5 completed/);\\n  } finally {\\n    if (server) await server.stop();\\n    await rm(directory, { recursive: true, force: true });\\n  }\\n});\\n\\ntest('search collapses only ASCII spaces and tabs without rewriting persistent text', async () => {\\n  const directory = await mkdtemp(join(tmpdir(), 'workboard-spaces-'));\\n  let server;\\n  try {\\n    const dbPath = join(directory, 'db.sqlite');\\n    server = await start(dbPath);\\n    const get = async path => (await fetch(server.url + path)).text();\\n    const post = async (path, values = {}) => (await fetch(server.url + path, {\\n      method: 'POST', body: new URLSearchParams(values)\\n    })).text();\\n    const projects = html => [...html.matchAll(/data-testid=\\\"project-row\\\">\\\\s*<span>([^<]*)/g)].map(match => match[1]);\\n    const tasks = html => [...html.matchAll(/aria-label=\\\"Complete ([^\\\"]*)\\\"/g)].map(match => match[1]);\\n    const projectNames = ['Alpha  \\\\t Board', 'ALPHA Board', 'Alpha\\\\nBoard', 'Alpha\\\\u00a0Board'];\\n    for (const name of projectNames) await post('/projects', { name });\\n    const projectPath = '/?' + new URLSearchParams({ search: ' \\\\talpha\\\\t  board\\\\t ' });\\n    assert.deepEqual(projects(await get(projectPath)), projectNames.slice(0, 2));\\n    await post('/projects/2/archive');\\n    assert.deepEqual(projects(await get(projectPath)), projectNames.slice(0, 1));\\n    assert.deepEqual(projects(await get(projectPath + '&filter=Archived')), projectNames.slice(1, 2));\\n    assert.deepEqual(projects(await get('/')), [projectNames[0], ...projectNames.slice(2)]);\\n\\n    const titles = ['Read \\\\t  BOOK', 'Read Book', 'Read\\\\nBook', 'Read\\\\u00a0Book'];\\n    for (const title of titles) await post('/projects/1/tasks', { title });\\n    const query = 'read\\\\t \\\\tbook';\\n    assert.deepEqual(tasks(await post('/projects/1/search', { query })), titles.slice(0, 2));\\n    await post('/projects/1/tasks/1/priority', { priority: 'High' });\\n    await post('/projects/1/tasks/1/due-date', { dueDate: '2024-02-29' });\\n    await post('/projects/1/tasks/1', { completed: '1' });\\n    const state = { search: query, filter: 'Completed', priorityFilter: 'High', dueFrom: '2024-02-29', dueThrough: '2024-02-29' };\\n    const filteredPath = '/projects/1?' + new URLSearchParams(state);\\n    assert.deepEqual(tasks(await get(filteredPath)), titles.slice(0, 1));\\n    let html = await post('/projects/1/tasks/1/rename', { ...state, title: 'READ\\\\t\\\\t  Book' });\\n    assert.deepEqual(tasks(html), ['READ\\\\t\\\\t  Book']);\\n    assert.match(html, /name=\\\"dueFrom\\\" value=\\\"2024-02-29\\\"/);\\n    html = await post('/projects/1/tasks/1/priority', { ...state, priority: 'Low' });\\n    assert.deepEqual(tasks(html), []);\\n    await post('/projects/1/tasks/1/priority', { priority: 'High' });\\n    await post('/projects/1/archive');\\n    assert.deepEqual(tasks(await get(filteredPath)), ['READ\\\\t\\\\t  Book']);\\n    await server.stop();\\n    server = await start(dbPath);\\n    assert.deepEqual(projects(await get(projectPath + '&filter=Archived')), projectNames.slice(0, 2));\\n    assert.deepEqual(tasks(await get(filteredPath)), ['READ\\\\t\\\\t  Book']);\\n    assert.deepEqual(tasks(await get('/projects/1')), ['READ\\\\t\\\\t  Book', ...titles.slice(1)]);\\n    await post('/projects/1/restore');\\n    assert.deepEqual(projects(await get('/')), [projectNames[0], ...projectNames.slice(2)]);\\n    assert.match(await get('/'), /1\\\\/4 completed/);\\n  } finally {\\n    if (server) await server.stop();\\n    await rm(directory, { recursive: true, force: true });\\n  }\\n});\"}]}","status":"completed"}],"error":null,"incomplete_details":null,"tools":[{"type":"function","name":"read","description":"Read the contents of a file. Supports text files and images (jpg, png, gif, webp, bmp). Images are sent as attachments. For text files, output is truncated to 2000 lines or 50KB (whichever is hit first). Use offset/limit for large files. When you need the full file, continue with offset until complete.","parameters":{"type":"object","required":["path","offset","limit"],"properties":{"path":{"type":"string","description":"Path to the file to read (relative or absolute)"},"offset":{"anyOf":[{"type":"number","description":"Line number to start reading from (1-indexed)"},{"type":"null"}]},"limit":{"anyOf":[{"type":"number","description":"Maximum number of lines to read"},{"type":"null"}]}},"additionalProperties":false},"output_schema":null,"strict":true},{"type":"function","name":"bash","description":"Execute a bash command in the current working directory. Returns stdout and stderr. Output is truncated to last 2000 lines or 50KB (whichever is hit first). If truncated, full output is saved to a temp file. Optionally provide a timeout in seconds.","parameters":{"type":"object","required":["command","timeout"],"properties":{"command":{"type":"string","description":"Shell command to execute"},"timeout":{"anyOf":[{"type":"number","description":"Timeout in seconds (optional, no default timeout)"},{"type":"null"}]}},"additionalProperties":false},"output_schema":null,"strict":true},{"type":"function","name":"edit","description":"Edit a single file using exact text replacement. Every edits[].oldText must match a unique, non-overlapping region of the original file. If two changes affect the same block or nearby lines, merge them into one edit instead of emitting overlapping edits. Do not include large unchanged regions just to connect distant changes.","parameters":{"type":"object","required":["path","edits"],"properties":{"path":{"type":"string","description":"Path to the file to edit (relative or absolute)"},"edits":{"type":"array","items":{"type":"object","required":["oldText","newText"],"properties":{"oldText":{"type":"string","description":"Exact text for one targeted replacement. It must be unique in the original file and must not overlap with any other edits[].oldText in the same call."},"newText":{"type":"string","description":"Replacement text for this targeted edit."}},"additionalProperties":false},"description":"One or more targeted replacements. Each edit is matched against the original file, not incrementally. Do not include overlapping or nested edits. If two changes touch the same block or nearby lines, merge them into one edit instead."}},"additionalProperties":false},"output_schema":null,"strict":true},{"type":"function","name":"write","description":"Write content to a file. Creates the file if it doesn't exist, overwrites if it does. Automatically creates parent directories.","parameters":{"type":"object","required":["path","content"],"properties":{"path":{"type":"string","description":"Path to the file to write (relative or absolute)"},"content":{"type":"string","description":"Content to write to the file"}},"additionalProperties":false},"output_schema":null,"strict":true}],"tool_choice":"auto","parallel_tool_calls":true,"prompt_cache_key":"872d5298-06e2-400b-8460-722576e50350","prompt_cache_retention":"24h","text":{"format":{"type":"text"},"verbosity":"low"},"top_p":0.98,"top_logprobs":0,"temperature":1.0,"reasoning":{"effort":"medium","summary":"detailed","context":"all_turns","mode":"standard"},"user":null,"usage":{"input_tokens":11960,"input_tokens_details":{"cached_tokens":0,"cache_write_tokens":0},"output_tokens":1160,"output_tokens_details":{"reasoning_tokens":29},"total_tokens":13120,"attribution":{"items":{"fc_07049cc23a98ff30016acba4e5526c87d2bb9e761844b0f342":{"input_tokens":34,"cached_tokens":0,"cache_write_tokens":0,"output_tokens":0},"fc_07049cc23a98ff30016acba4e99ed887d28228e038dd243762":{"input_tokens":28,"cached_tokens":0,"cache_write_tokens":0,"output_tokens":0},"fc_07049cc23a98ff30016acba4ec2a5487d28a9e8b2700ca04