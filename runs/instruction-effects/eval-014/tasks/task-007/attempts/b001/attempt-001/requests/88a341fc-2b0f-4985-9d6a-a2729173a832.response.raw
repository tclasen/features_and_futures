t('priorityFilter'));\\n        const enteredName\"},\n{\"oldText\":\"projectPage(project, filter, 'Project name is required', '', enteredName)\",\"newText\":\"projectPage(project, filter, 'Project name is required', '', enteredName, prioritySelection)\"},\n{\"oldText\":\"const filter = taskFilter(form.get('filter'));\\n        const priority =\",\"newText\":\"const filter = taskFilter(form.get('filter'));\\n        const prioritySelection = priorityFilter(form.get('priorityFilter'));\\n        const priority =\"},\n{\"oldText\":\"projectPage(project, filter, 'Invalid task priority')\",\"newText\":\"projectPage(project, filter, 'Invalid task priority', '', '', prioritySelection)\"},\n{\"oldText\":\"const filter = taskFilter(form.get('filter'));\\n        const title =\",\"newText\":\"const filter = taskFilter(form.get('filter'));\\n        const prioritySelection = priorityFilter(form.get('priorityFilter'));\\n        const title =\"},\n{\"oldText\":\"projectPage(project, filter, 'Task title is required')\",\"newText\":\"projectPage(project, filter, 'Task title is required', '', '', prioritySelection)\"},\n{\"oldText\":\"const filter = taskFilter(form.get('filter'));\\n        if (taskMatch[2])\",\"newText\":\"const filter = taskFilter(form.get('filter'));\\n        const prioritySelection = priorityFilter(form.get('priorityFilter'));\\n        if (taskMatch[2])\"},\n{\"oldText\":\"projectPage(project, filter, 'Task title is required', enteredTitle)\",\"newText\":\"projectPage(project, filter, 'Task title is required', enteredTitle, '', prioritySelection)\"},\n{\"oldText\":\"renameProject.run(name, project.id);\\n        redirect(response, `/projects/${project.id}?filter=${filter}`);\",\"newText\":\"renameProject.run(name, project.id);\\n        redirect(response, projectLocation(project.id, filter, prioritySelection));\"},\n{\"oldText\":\"updatePriority.run(priority, priorityMatch[2], project.id);\\n        redirect(response, `/projects/${project.id}?filter=${filter}`);\",\"newText\":\"updatePriority.run(priority, priorityMatch[2], project.id);\\n        redirect(response, projectLocation(project.id, filter, prioritySelection));\"},\n{\"oldText\":\"renameTask.run(title, taskRenameMatch[2], project.id);\\n        redirect(response, `/projects/${project.id}?filter=${filter}`);\",\"newText\":\"renameTask.run(title, taskRenameMatch[2], project.id);\\n        redirect(response, projectLocation(project.id, filter, prioritySelection));\"},\n{\"oldText\":\"createTask.run(project.id, title);\\n        }\\n        redirect(response, `/projects/${project.id}?filter=${filter}`);\",\"newText\":\"createTask.run(project.id, title);\\n        }\\n        redirect(response, projectLocation(project.id, filter, prioritySelection));\"}]}","item_id":"fc_02fc14813e3cbf8b016acb9d55cbf48194917e79c5aed3b9ac","output_index":1,"sequence_number":1523}

