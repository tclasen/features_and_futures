roject, filter, 'Invalid task priority')\",\"newText\":\"projectPage(project, filter, 'Invalid task priority', selectedPriority)\"},{\"oldText\":\"          sendHtml(res, 200, projectPage(project, filter, 'Task title is required'));\\n          return;\",\"newText\":\"          sendHtml(res, 200, projectPage(project, filter, 'Task title is required', selectedPriority));\\n          return;\"},{\"oldText\":\"Location: `/projects/${projectId}?filter=${filter}`\",\"newText\":\"Location: `/projects/${projectId}?filter=${filter}&priorityFilter=${selectedPriority}`\"}]}"}

