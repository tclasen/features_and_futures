change=\\\"this.form.submit()\\\">\",\"newText\":\"${task.completed ? ' checked' : ''}${project.archived ? ' disabled' : ''} onchange=\\\"this.form.submit()\\\">\"},{\"oldText\":\"      sendHtml(response, 200, projectsPage());\",\"newText\":\"      sendHtml(response, 200, projectsPage('', '', projectFilter(url.searchParams.get('filter'))));\"},{\"oldText\":\"sendHtml(response, 400, projectsPage('Project name is required'));\",\"newText\":\"sendHtml(response, 400, projectsPage('Project name is required', '', projectFilter(form.get('filter'))));\"},{\"oldText\":\"    } else if (request.method === 'GET' && /^\\\\/projects\\\\/\\\\d+$/.test(path)) {\",\"newText\":\"    } else if (request.method === 'POST' && /^\\\\/projects\\\\/\\\\d+\\\\/(archive|restore)$/.test(path)) {\\n      const [, , projectId, action] = path.split('/');\\n      const result = setArchived.run(action === 'archive' ? 1 : 0, projectId);\\n      if (!result.changes) {\\n        sendHtml(response, 404, page('Not found', '<h1>Project not found</h1>'));\\n        return;\\n      }\\n      response.writeHead(303, { Location: action === 'archive' ? '/' : '/?filter=Archived' });\\n      response.end();\\n    } else if (request.method === 'GET' && /^\\\\/projects\\\\/\\\\d+$/.test(path)) {\"},{\"oldText\":\"      const form = await readForm(request);\\n      const filter = taskFilter(form.get('filter'));\",\"newText\":\"      const form = await readForm(request);\\n      const filter = taskFilter(form.get('filter'));\\n      if (project.archived) {\\n        sendHtml(response, 403, projectPage(project, filter, 'Archived project is read-only'));\\n        return;\\n      }\"}]}","status":"completed"}}

