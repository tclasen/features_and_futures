), alertBox=document.querySelector('#alert');\\nasync function load(){const response=await fetch('/api/projects');const projects=await response.json();const container=document.querySelector('#projects');container.replaceChildren();for(const project of projects){const row=document.createElement('div');row.className='row';row.dataset.testid='project-row';const name=document.createElement('span');name.textContent=project.name;const button=document.createElement('button');button.type='button';button.textContent='Open project';button.addEventListener('click',()=>{history.pushState({},'',`/projects/${project.id}`);render()});row.append(name,button);container.append(row)}}\\nasync function render(){const match=location.pathname.match(/^\\\\/projects\\\\/(\\\\d+)\\\\/?$/);if(match){const response=await fetch('/api/projects');const projects=await response.json();const project=projects.find(item=>String(item.id)===match[1]);if(project){listView.hidden=true;detailView.hidden=false;document.querySelector('#project-title').textContent=project.name;return}history.replaceState({},'','/')};detailView.hidden=true;listView.hidden=false;await load()}\\ndocument.querySelector('#create-form').addEventListener('submit',async event=>{event.preventDefault();alertBox.hidden=true;const field=document.querySelector('#project-name');const response=await fetch('/api/projects',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({name:field.value})});if(!response.ok){alertBox.textContent='Project name is required';alertBox.hidden=false;return}field.value='';await load()});document.querySelector('#back').addEventListener('click',()=>{history.pushState({},'','/');render()});addEventListener('popstate',render);render();\\n</script></body></html>\\n\"}","status":"completed"}}

event: response.completed
