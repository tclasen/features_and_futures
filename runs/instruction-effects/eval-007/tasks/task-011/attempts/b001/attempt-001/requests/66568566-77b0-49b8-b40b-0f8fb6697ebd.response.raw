data: {"type":"response.function_call_arguments.done","arguments":"{\"path\":\"server.js\",\"edits\":[{\"oldText\":\"const setTaskDueDate = db.prepare\",\"newText\":\"// Persist per-project ordering separately from task identity so moves can append.\\nif (!db.prepare('PRAGMA table_info(tasks)').all().some(column => column.name === 'position')) {\\n  db.exec('ALTER TABLE tasks ADD COLUMN position INTEGER NOT NULL DEFAULT 0; UPDATE tasks SET position = id');\\n}\\nconst moveTask = db.prepare(`UPDATE tasks SET project_id = ?,\\n  position = (SELECT COALESCE(MAX(position), 0) + 1 FROM tasks WHERE project_id = ?)\\n  WHERE id = ? AND project_id = ?`);\\nconst destinations = db.prepare('SELECT id, name FROM projects WHERE archived = 0 AND id != ? ORDER BY id');\\nconst setTaskDueDate = db.prepare\"},{\"oldText\":\"FROM tasks WHERE project_id = ? ORDER BY id');\",\"newText\":\"FROM tasks WHERE project_id = ? ORDER BY position, id');\"},{\"oldText\":\"const createTask = db.prepare('INSERT INTO tasks (project_id, title, priority) VALUES (?, ?, ?)');\",\"newText\":\"const createTask = db.prepare(`INSERT INTO tasks (project_id, title, priority, position)\\n  VALUES (?, ?, ?, (SELECT COALESCE(MAX(position), 0) + 1 FROM tasks WHERE project_id = ?))`);\"},{\"oldText\":\"  const rows = listTasks.all(project.id)\",\"newText\":\"  const eligibleDestinations = destinations.all(project.id);\\n  const moveDisabled = project.archived || !eligibleDestinations.length;\\n  const rows = listTasks.all(project.id)\"},{\"oldText\":\"        <form action=\\\"/projects/${project.id}/tasks/${task.id}/rename\\\" method=\\\"post\\\">\",\"newText\":\"        <form action=\\\"/projects/${project.id}/tasks/${task.id}/move\\\" method=\\\"post\\\">\\n          ${filterFields}\\n          <label for=\\\"destination-project-${task.id}\\\">Destination project</label>\\n          <select id=\\\"destination-project-${task.id}\\\" name=\\\"destination\\\"${moveDisabled ? ' disabled' : ''}>\\n            ${eligibleDestinations.map(destination => `<option value=\\\"${destination.id}\\\">${escapeHtml(destination.name)}</option>`).join('')}\\n          </select>\\n          <button type=\\\"submit\\\"${moveDisabled ? ' disabled' : ''}>Move task</button>\\n        </form>\\n        <form action=\\\"/projects/${project.id}/tasks/${task.id}/rename\\\" method=\\\"post\\\">\"},{\"oldText\":\"    const taskPriorityMatch =\",\"newText\":\"    const moveMatch = /^\\\\/projects\\\\/([1-9]\\\\d*)\\\\/tasks\\\\/([1-9]\\\\d*)\\\\/move$/.exec(url.pathname);\\n    if (request.method === 'POST' && moveMatch) {\\n      const project = getProject.get(moveMatch[1]);\\n      const task = project && getTask.get(moveMatch[2], project.id);\\n      if (task) {\\n        const form = await readForm();\\n        const filter = taskFilter(form.get('filter'));\\n        const priority = priorityFilter(form.get('priorityFilter'));\\n        const destinationId = form.get('destination') || '';\\n        const destination = /^[1-9]\\\\d*$/.test(destinationId) && getProject.get(destinationId);\\n        if (project.archived || !destination || destination.archived || destination.id === project.id) {\\n          sendHtml(response, project.archived ? 403 : 400, projectPage(project, filter,\\n            project.archived ? 'Archived project is read-only' : 'Choose an active destination project', '', null, priority));\\n          return;\\n        }\\n        moveTask.run(destination.id, destination.id, task.id, project.id);\\n        redirect(response, projectLocation(project.id, filter, priority));\\n        return;\\n      }\\n    }\\n    const taskPriorityMatch =\"},{\"oldText\":\"createTask.run(project.id, title, project.default_priority);\",\"newText\":\"createTask.run(project.id, title, project.default_priority, project.id);\"}]}","item_id":"fc_08c533bb4bbba195016aca84cb663887d1bb10c62cff1b9cc7","output_index":0,"sequence_number":884}

