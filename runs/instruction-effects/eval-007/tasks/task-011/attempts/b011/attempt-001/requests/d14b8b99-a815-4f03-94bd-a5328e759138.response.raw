Html(destination.name)}</option>`).join('')}</select><button type=\\\"button\\\" data-move-task-id=\\\"${task.id}\\\" ${project.archived || !destinations.length ? 'disabled' : ''}>Move task</button></div>`).join('')}</section>`;\"},{\"oldText\":\"        app.querySelectorAll('.task-rename-form').forEach(form => form.addEventListener('submit', async event => {\",\"newText\":\"        app.querySelectorAll('[data-move-task-id]').forEach(button => button.addEventListener('click', async () => {\\n          const destination = app.querySelector(`[data-destination-task-id=\\\"${button.dataset.moveTaskId}\\\"]`).value;\\n          const response = await fetch(`/api/tasks/${button.dataset.moveTaskId}`, { method: 'PATCH', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ projectId: Number(destination) }) });\\n          if (!response.ok) return showProject(id, (await response.json()).error, filter.value, priorityFilter.value, appliedRange, draftRange);\\n          showProject(id, '', filter.value, priorityFilter.value, appliedRange, draftRange);\\n        }));\\n        app.querySelectorAll('.task-rename-form').forEach(form => form.addEventListener('submit', async event => {\"}]}","call_id":"call_D6HB0cGVOQiPX8lJO6mJMZws","name":"edit"},"output_index":0,"sequence_number":702}

