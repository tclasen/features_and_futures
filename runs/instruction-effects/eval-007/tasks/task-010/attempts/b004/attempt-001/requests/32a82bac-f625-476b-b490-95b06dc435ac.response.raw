alue='All';appliedDueFrom='';appliedDueThrough='';document.querySelector('#due-from').value='';document.querySelector('#due-through').value='';history.pushState\"},{\"oldText\":\"document.querySelector('#back').addEventListener('click',()=>{history.pushState({},'','/');render()});\",\"newText\":\"document.querySelector('#apply-due-range').addEventListener('click',()=>{const from=document.querySelector('#due-from').value.trim(),through=document.querySelector('#due-through').value.trim(),alert=document.querySelector('#due-range-alert');alert.hidden=true;const valid=value=>{const m=/^(\\\\\\\\d{4})-(\\\\\\\\d{2})-(\\\\\\\\d{2})$/.exec(value);if(!m)return false;const y=+m[1],mo=+m[2],d=+m[3];if(y<1||mo<1||mo>12)return false;const leap=y%4===0&&(y%100!==0||y%400===0);return d>=1&&d<=[31,leap?29:28,31,30,31,30,31,31,30,31,30,31][mo-1]};if(from&&!valid(from)||through&&!valid(through)){alert.textContent='Due range must use valid YYYY-MM-DD dates';alert.hidden=false;return}if(from&&through&&from>through){alert.textContent='Due from must not be after Due through';alert.hidden=false;return}appliedDueFrom=from;appliedDueThrough=through;const match=location.pathname.match(/^\\\\\\\\/projects\\\\\\\\/(\\\\\\\\d+)/);if(match)loadTasks(match[1],currentProjectArchived)});document.querySelector('#back').addEventListener('click',()=>{history.pushState({},'','/');render()});\"}]}"}

