data: {"type":"response.output_item.added","sequence_number":2,"output_index":0,"item":{"type":"reasoning","id":"rs_09d8d8fb58135698016ac94645a5c88190af0fce12369a472a","metadata":{"turn_id":"01a1223a-623b-7e90-854b-218fc7f224ed"},"internal_chat_message_metadata_passthrough":{"turn_id":"01a1223a-623b-7e90-854b-218fc7f224ed"},"summary":[],"content":[],"encrypted_content":"gAAAAABqyUZFOhJhHm1e3MJFxKPAjEjhS9yfYKLFsjgdFSnPbwEEndOTiUd87bWaHafmKlU8kegtj0P1IzEIW3YILa_nwyA4IUAVGToSAN5u8kn7-7A5eZOB7ebTVk5UrNVxvd3U4gcUSHUnxPaGX6pu-Wq010Fym1GaZ3GowHQFpjhNW2SmY5jMmAVEkNvBbvVlGicLdrFMo86yXDngtdeXp1pmunfOgd-klgKgKbyRzwUGH8VIvOPoC2toc1t8QaMqvoVAG5a-Is-TMN2-y0BRyiia7n6z6kFhLJg05JkuLaotm_PJdlgNYp3G-GIEFrh5vO0w8xFbcKKMct9JEM3GkpXTOizbJS30wuGnAJchyKMIvY9zTbLfQ_UknrDNprgorC97xWoXkTCNSngeBd-8aNQNU-Jb0cUdpzdwwEPqI2bmefTahVrd6-UZsRjO76bE2sc6drSAT_IwoinAyJca9YCo_gQVwuki96cQN19FEi9jzULN858M6rB32FQo6_32FxkzuCCycQhbBR2cP4TicH6WbTMgSK1ladXBHKiWcnoHSUzbBgWm15wctwzS6K3o2dTuxyeUN7-lAKXoeQxWlCerVuhfyelYbrNoVCuefvi7sgwUkxcZEtEpCFa_tPKOVvgxGpQeeFA54WVKq6jhslplEridNfe8wjxex7vV1zh9nJrXcwx0R4VwbmNle0USKEENZVSHQ2qEF5y7ox2DJiZKLJA8C1dEAfYhBz8ZCu9-wi2gZtFIx_yEvJFVM-Q2fpqNLzMcKr8QvwRQtarK6lPgnGh2dW1SifNyftsZlaLrGjnyjWkdtQKBMWLMDC6utXLrsYCTpZS39X-z_1Zdkz9A1C2iosVmr3khxXmF2_1vKOjAMPjpOWoJkZOFai3lNO0IPn2iRl4B4sxSK4TffrUIyAUGPUHIdt0PgwblEo1fVJGKJ4-dTEEn0XYVWzL0svnJ4MzUFkLlAgbNVjiy2V8aqesWbLyJiKuWoVSWXQ946tzSxE4LwPSw958VCnVotlu1QDowyDxeD3yuW-Bi3ac3DJXrsNV1Au5L1WyCjKALFjCk8P_8kRrqpIXo6mPgwtrf0Qh7y-pHRUG90teejdvZcAmhfQYja7xF4GZEG-WZGH3wFxtsqU7Lrxf1wN8TrPJEPShh9M9zxfhpehoDTIWj19Fkb0BMx-si4xTLPC_wzH7zeJPPPUlKlURkpHq4UsFmrW-974fHc8AFLz_mqUqVWqwwCih1akcjngQVxocv11X7O0SHA-Hu6cGfwF5uaQTbpqxr84na8Bruh1qELSkJiXxlloi3_TW2hzaWop2ExUR52EWRgf81JgX7u0sIUK8_UKdFg7dWHX4av-Js3xqtpeVPm_XuKdBVQbWdie205Ai2Gim_gW42scP7sHoXTp-_Ip3xUHK5YcxzgDiUhlA7RHwYd3YeYLjNFqivatMovHhQCktGvMhsOwr4ALe5wJNur8Uo9A1RCmVabzhcTPt1kXmRN6jbBXKOae6LdEVfxcQS1fuhQtczyIjDMZbtiwDaD1fCtnlZw0lio2p-6JzMtue3dgwFoHk-05nRFZgD7UFmDxGTUtXvgfp5eQC8qrZzaCc7WbuyCJRLSIWRmLC