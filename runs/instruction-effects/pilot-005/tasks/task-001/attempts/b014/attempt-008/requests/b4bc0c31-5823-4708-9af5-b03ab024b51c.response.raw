().catch(err =\\\\u003e {\\n  console.error('Failed to start server:', err);\\n  process.exit(1);\\n});\\n\"},{\"newText\":\"db.all('SELECT id, name FROM projects ORDER BY id');\\n\",\"oldText\":\"await db.all('SELECT id, name FROM projects ORDER BY id');\\n\"},{\"newText\":\"const stmt = db.prepare('INSERT INTO projects (name) VALUES (?)');\\n          const result = stmt.run(name);\\n          const newId = result.lastID;\\n          jsonResponse(res, { id: newId, name }, 201);\\n\",\"oldText\":\"const result = await db.run('INSERT INTO projects (name) VALUES (?)', name);\\n          const newId = result.lastID;\\n          jsonResponse(res, { id: newId, name }, 201);\\n\"},{\"newText\":\"const row = db.get('SELECT id, name FROM projects WHERE id = ?', id);\\n\",\"oldText\":\"const row = await db.get('SELECT id, name FROM projects WHERE id = ?', id);\\n\"}]}"}}]},"finish_reason":null}]}

