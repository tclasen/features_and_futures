data: {"id":"chatcmpl-666","object":"chat.completion.chunk","created":1791558306,"model":"gpt-oss:120b","system_fingerprint":"fp_ollama","choices":[{"index":0,"delta":{"content":"","tool_calls":[{"id":"call_iqf431wz","index":0,"type":"function","function":{"name":"edit","arguments":"{\"path\":\"server.js\",\"edits\":[{\"newText\":\"import { open } from 'node:sqlite';\\n\\nconst PORT = process.env.PORT ? Number(process.env.PORT) : 8080;\\nconst DB_PATH = process.env.DB_PATH || 'workboard.db';\\n\\nasync function initDb() {\\n  const db = await open({ filename: DB_PATH, driver: (await import('node:sqlite')).default?.Database ?? (await import('node:sqlite')).Database });\\n  // Ensure table exists\\n  await db.exec(`CREATE TABLE IF NOT EXISTS projects (\\n    id INTEGER PRIMARY KEY AUTOINCREMENT,\\n    name TEXT NOT NULL\\n  );`);\\n  return db;\\n}\\n\",\"oldText\":\"import * as sqlite from 'node:sqlite';\\n\\n\\nconst PORT = process.env.PORT ? Number(process.env.PORT) : 8080;\\nconst DB_PATH = process.env.DB_PATH || 'workboard.db';\\n\\nasync function initDb() {\\n  const db = new sqlite.DatabaseSync(DB_PATH);\\n  db.exec(`CREATE TABLE IF NOT EXISTS projects (\\n    id INTEGER PRIMARY KEY AUTOINCREMENT,\\n    name TEXT NOT NULL\\n  );`);\\n  return db;\\n}\\n\"},{\"newText\":\"if (req.method === 'GET' \\u0026\\u0026 pathname === '/projects') {\\n      try {\\n        const rows = await db.all('SELECT id, name FROM projects ORDER BY id ASC');\\n        return sendJson(res, 200, rows);\\n      } catch (e) {\\n        res.writeHead(500, { 'Content-Type': 'text/plain' });\\n        return res.end('Server Error');\\n      }\\n    }\\n\",\"oldText\":\"if (req.method === 'GET' \\u0026\\u0026 pathname === '/projects') {\\n      const rows = db.all('SELECT id, name FROM projects ORDER BY id ASC');\\n      return sendJson(res, 200, rows);\\n    }\\n\"},{\"newText\":\"if (req.method === 'POST' \\u0026\\u0026 pathname === '/projects') {\\n      try {\\n        const body = await parseBody(req);\\n        const data = JSON.parse(body);\\n        const name = (data.name || '').trim();\\n        if (!name) {\\n          res.writeHead(400, { 'Content-Type': 'text/plain' });\\n          return res.end('Project name is required');\\n        }\\n        const result = await db.run('INSERT INTO projects (name) VALUES (?)', name);\\n        const project = { id: result.lastID, name };\\n        return sendJson(res, 201, project);\\n      } catch (e) {\\n        res.writeHead(500, { 'Content-Type': 'text/plain' });\\n        return res.end('Server Error');\\n      }\\n    }\\n\",\"oldText\":\"if (req.method === 'POST' \\u0026\\u0026 pathname === '/projects') {\\n      try {\\n        const body = await parseBody(req);\\n        const data = JSON.parse(body);\\n        const name = (data.name || '').trim();\\n        if (!name) {\\n          res.writeHead(400, { 'Content-Type': 'text/plain' });\\n          return res.end('Project name is required');\\n        }\\n        const result = db.run('INSERT INTO projects (name) VALUES (?)', name);\\n        const project = { id: result.lastID, name };\\n        return sendJson(res, 201, project);\\n      } catch (e) {\\n        res.writeHead(500, { 'Content-Type': 'text/plain' });\\n        return res.end('Server Error');\\n      }\\n    }\\n\"},{\"newText\":\"const row = await db.get('SELECT id, name FROM projects WHERE id = ?', id);\\n      if (!row) return notFound(res);\\n\",\"oldText\":\"const row = db.get('SELECT id, name FROM projects WHERE id = ?', id);\\n      if (!row) return notFound(res);\\n\"}]}"}}]},"finish_reason":null}]}

