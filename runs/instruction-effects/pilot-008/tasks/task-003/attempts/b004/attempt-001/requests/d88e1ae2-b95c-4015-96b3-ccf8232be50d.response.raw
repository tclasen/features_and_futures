data: {"type":"response.function_call_arguments.done","sequence_number":795,"item_id":"fc_017d83722e31837e016ac91fa5695c819791ffcc5088e4c19e","output_index":1,"arguments":"{\"path\":\"index.html\",\"edits\":[{\"oldText\":\"<button class=\\\"secondary\\\" id=\\\"back\\\">Projects</button><h1>${escapeHtml(project.name)}</h1><div id=\\\"alert\\\"></div><form id=\\\"task-form\\\">\",\"newText\":\"<button class=\\\"secondary\\\" id=\\\"back\\\">Projects</button><h1>${escapeHtml(project.name)}</h1>${project.archived ? '<p>Archived project</p>' : ''}<div id=\\\"alert\\\"></div><form id=\\\"task-form\\\">\"},{\"oldText\":\"const tasks = await (await fetch(`/api/projects/${match[1]}/tasks`)).json();\",\"newText\":\"const tasks = await (await fetch(`/api/projects/${match[1]}/tasks`)).json();\"},{\"oldText\":\"${task.completed ? 'checked' : ''}></label></div>`).join('');\",\"newText\":\"${task.completed ? 'checked' : ''} ${project.archived ? 'disabled' : ''}></label></div>`).join('');\"},{\"oldText\":\"          const loadTasks = async () => {\",\"newText\":\"          if (project.archived) document.querySelector('#task-form button').disabled = true;\\n          const loadTasks = async () => {\"},{\"oldText\":\"app.innerHTML = `<h1>Workboard</h1><div id=\\\"alert\\\"></div><form id=\\\"create-form\\\">\",\"newText\":\"app.innerHTML = `<h1>Workboard</h1><div class=\\\"field\\\"><label for=\\\"project-filter\\\">Project filter</label><select id=\\\"project-filter\\\"><option>Active</option><option>Archived</option></select></div><div id=\\\"alert\\\"></div><form id=\\\"create-form\\\">\"},{\"oldText\":\"const projects = await response.json();\\n      document.querySelector('#projects').innerHTML = projects.map(p => `<div class=\\\"project-row\\\" data-testid=\\\"project-row\\\"><span class=\\\"project-name\\\">${escapeHtml(p.name)}</span><button type=\\\"button\\\" data-id=\\\"${p.id}\\\">Open project</button></div>`).join('');\\n      document.querySelectorAll('#projects button').forEach(button => button.addEventListener('click', () => { history.pushState({}, '', `/projects/${button.dataset.id}`); render(); }));\",\"newText\":\"const projects = await response.json();\\n      const drawProjects = () => {\\n        const archived = document.querySelector('#project-filter').value === 'Archived';\\n        const shown = projects.filter(p => p.archived === archived);\\n        document.querySelector('#projects').innerHTML = shown.map(p => `<div class=\\\"project-row\\\" data-testid=\\\"project-row\\\"><span class=\\\"project-name\\\">${escapeHtml(p.name)}</span><span data-testid=\\\"project-summary\\\">${p.completedCount}/${p.totalCount} completed</span><button type=\\\"button\\\" data-action=\\\"open\\\" data-id=\\\"${p.id}\\\">Open project</button><button class=\\\"secondary\\\" type=\\\"button\\\" data-action=\\\"${archived ? 'restore' : 'archive'}\\\" data-id=\\\"${p.id}\\\">${archived ? 'Restore project' : 'Archive project'}</button></div>`).join('');\\n        document.querySelectorAll('#projects button').forEach(button => button.addEventListener('click', async () => {\\n          if (button.dataset.action === 'open') { history.pushState({}, '', `/projects/${button.dataset.id}`); render(); return; }\\n          await fetch(`/api/projects/${button.dataset.id}/${button.dataset.action}`, {method:'POST'}); render();\\n        }));\\n      };\\n      document.querySelector('#project-filter').addEventListener('change', drawProjects);\\n      drawProjects();\"}]}"}

