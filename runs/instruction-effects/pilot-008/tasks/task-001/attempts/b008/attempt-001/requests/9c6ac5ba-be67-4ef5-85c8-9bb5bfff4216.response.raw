o a temp file. Optionally provide a timeout in seconds.","parameters":{"type":"object","required":["command","timeout"],"properties":{"command":{"type":"string","description":"Shell command to execute"},"timeout":{"anyOf":[{"type":"number","description":"Timeout in seconds (optional, no default timeout)"},{"type":"null"}]}},"additionalProperties":false},"output_schema":null,"strict":true},{"type":"function","name":"edit","description":"Edit a single file using exact text replacement. Every edits[].oldText must match a unique, non-overlapping region of the original file. If two changes affect the same block or nearby lines, merge them into one edit instead of emitting overlapping edits. Do not include large unchanged regions just to connect distant changes.","parameters":{"type":"object","required":["path","edits"],"properties":{"path":{"type":"string","description":"Path to the file to edit (relative or absolute)"},"edits":{"type":"array","items":{"type":"object","required":["oldText","newText"],"properties":{"oldText":{"type":"string","description":"Exact text for one targeted replacement. It must be unique in the original file and must not overlap with any other edits[].oldText in the same call."},"newText":{"type":"string","description":"Replacement text for this targeted edit."}},"additionalProperties":false},"description":"One or more targeted replacements. Each edit is matched against the original file, not incrementally. Do not include overlapping or nested edits. If two changes touch the same block or nearby lines, merge them into one edit instead."}},"additionalProperties":false},"output_schema":null,"strict":true},{"type":"function","name":"write","description":"Write content to a file. Creates the file if it doesn't exist, overwrites if it does. Automatically creates parent directories.","parameters":{"type":"object","required":["path","content"],"properties":{"path":{"type":"string","description":"Path to the file to write (relative or absolute)"},"content":{"type":"string","description":"Content to write to the file"}},"additionalProperties":false},"output_schema":null,"strict":true}],"tool_choice":"auto","parallel_tool_calls":true,"prompt_cache_key":"171fdb5f-b699-4989-806c-4124bd0282d8","prompt_cache_retention":"24h","text":{"format":{"type":"text"},"verbosity":"low"},"top_p":0.98,"top_logprobs":0,"temperature":1.0,"reasoning":{"effort":"medium","summary":"detailed","context":"all_turns","mode":"standard"},"user":null,"usage":{"input_tokens":4444,"input_tokens_details":{"cached_tokens":1536,"cache_write_tokens":0},"output_tokens":120,"output_tokens_details":{"reasoning_tokens":14},"total_tokens":4564,"attribution":{"items":{"fc_07dcfa929fea43b2016ac91dddb69081978e4f2acc1ed07f5c":{"input_tokens":50,"cached_tokens":0,"cache_write_tokens":0,"output_tokens":0},"fc_07dcfa929fea43b2016ac91dde2af08197a14b1b16b219c547":{"input_tokens":41,"cached_tokens":0,"cache_write_tokens":0,"output_tokens":0},"fc_07dcfa929fea43b2016ac91ddf630c8197ac72ac927bcd48bf":{"input_tokens":28,"cached_tokens":0,"cache_write_tokens":0,"output_tokens":0},"fc_07dcfa929fea43b2016ac91de2506081979eaba64148dfc93d":{"input_tokens":676,"cached_tokens":0,"cache_write_tokens":0,"output_tokens":0},"fc_07dcfa929fea43b2016ac91de75b14819796f6b9973a6ddb02":{"input_tokens":1238,"cached_tokens":0,"cache_write_tokens":0,"output_tokens":0},"fc_07dcfa929fea43b2016ac91df0c1d08197b91e611e8bf814bb":{"input_tokens":49,"cached_tokens":0,"cache_write_tokens":0,"output_tokens":0},"fc_07dcfa929fea43b2016ac91df1945c81979025c1a5365ef127":{"input_tokens":138,"cached_tokens":0,"cache_write_tokens":0,"output_tokens":0,"content":[{"input_tokens":138,"cached_tokens":0,"cache_write_tokens":0,"output_tokens":0}]},"fc_07dcfa929fea43b2016ac91df1945c819796043de92c287112":{"input_tokens":13,"cached_tokens":0,"cache_write_tokens":0,"output_tokens":0,"content":[{"input_tokens":13,"cached_tokens":0,"cache_write_tokens":0,"output_tokens":0}]},"fc_07dcfa929fea43b2016ac91df1945c8197a40073c6