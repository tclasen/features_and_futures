e preserves ownership, order, completion and persistence', async () => {\\n  const directory = await mkdtemp(join(tmpdir(), 'workboard-task-rename-'));\\n  const dbPath = join(directory, 'workboard.sqlite');\\n  let server;\\n  try {\\n    server = await start(dbPath);\\n    const html = path => fetch(server.url + path).then(response => response.text());\\n    const post = (path, fields = {}) => fetch(server.url + path, {\\n      method: 'POST', body: new URLSearchParams(fields), redirect: 'manual'\\n    });\\n    await post('/projects', { name: 'One' });\\n    await post('/projects', { name: 'Two' });\\n    const paths = [...(await html('/')).matchAll(/action=\\\"(\\\\/projects\\\\/[^\\\" ]+)\\\" method=\\\"get\\\"/g)].map(match => match[1]);\\n    const path = paths[0];\\n    await post(`${path}/tasks`, { title: 'Original' });\\n    await post(`${path}/tasks`, { title: 'Second' });\\n    const taskPath = (await html(path)).match(/action=\\\"([^\\\" ]+\\\\/tasks\\\\/[^\\\" ]+)\\\"/)[1];\\n    await post(taskPath, { completed: '1' });\\n    assert.match(await html(path), />New task title<\\\\/label>/);\\n    for (const title of ['', '  \\\\t ']) {\\n      const response = await post(`${taskPath}/rename`, { title, filter: 'Completed' });\\n      assert.equal(response.status, 400);\\n      const detail = await response.text();\\n      assert.match(detail, /role=\\\"alert\\\">Task title is required/);\\n      assert.match(detail, /aria-label=\\\"Complete Original\\\" checked/);\\n      assert.match(detail, /<option selected>Completed/);\\n    }\\n    const response = await post(`${taskPath}/rename`, { title: '  Renamed <task>  ', filter: 'Completed' });\\n    assert.equal(response.status, 303);\\n    assert.equal(response.headers.get('location'), `${path}?filter=Completed`);\\n    const detail = await html(path);\\n    assert.match(detail, /aria-label=\\\"Complete Renamed &lt;task&gt;\\\" checked/);\\n    assert.ok(detail.indexOf('<span>Renamed &lt;task&gt;</span>') < detail.indexOf('<span>Second</span>'));\\n    assert.ok(detail.includes(`action=\\\"${taskPath}\\\"`));\\n    assert.match(await html('/'), /1\\\\/2 completed/);\\n    assert.doesNotMatch(await html(`${path}?filter=Open`), /<span>Renamed/);\\n    assert.match(await html(`${path}?filter=Completed`), /<span>Renamed/);\\n    assert.doesNotMatch(await html(paths[1]), /data-testid=\\\"task-row\\\"/);\\n    assert.equal((await post(`${taskPath.replace(path, paths[1])}/rename`, { title: 'Wrong owner' })).status, 404);\\n    await server.stop();\\n    server = await start(dbPath);\\n    assert.equal(await html(path), detail);\\n    await post(`${path}/archive`);\\n    const archived = await html(path);\\n    assert.equal((archived.match(/name=\\\"title\\\" type=\\\"text\\\" disabled/g) || []).length, 2);\\n    assert.equal((archived.match(/disabled>Rename task/g) || []).length, 2);\\n    assert.equal((await post(`${taskPath}/rename`, { title: 'Forbidden' })).status, 403);\\n    await server.stop();\\n    server = await start(dbPath);\\n    assert.equal(await html(path), archived);\\n    await post(`${path}/restore`);\\n    assert.doesNotMatch(await html(path), / disabled/);\\n    assert.equal((await post(`${taskPath}/rename`, { title: 'Restored' })).status, 303);\\n    await server.stop();\\n    server = await start(dbPath);\\n    assert.match(await html(path), /aria-label=\\\"Complete Restored\\\" checked/);\\n    assert.match(await html('/'), /1\\\\/2 completed/);\\n    assert.equal((await post(`${path}/tasks/missing/rename`, { title: 'Missing' })).status, 404);\\n  } finally {\\n    if (server) await server.stop();\\n    await rm(directory, { recursive: true, force: true });\\n  }\\n});\\n\\ntest('rename validates and preserves identity, order, tasks and archive protection', async () => {\"}]}","status":"completed"}],"error":null,"incomplete_details":null,"tools":[{"type":"function","name":"read","description":"Read the contents of a file. Supports text files and images (jpg, png, gif, webp, bmp). Images are sent as attachments. For text files, output is truncated to 2000 lines or 50KB (whichever is hit first). Use offset/limit for large files. When you need the full file, continue with offset until complete.","parameters":{"type":"object","required":["path","offset","limit"],"properties":{"path":{"type":"string","description":"Path to the file to read (relative or absolute)"},"offset":{"anyOf":[{"type":"number","description":"Line number to start reading from (1-indexed)"},{"type":"null"}]},"limit":{"anyOf":[{"type":"number","description":"Maximum number of lines to read"},{"type":"null"}]}},"additionalProperties":false},"output_schema":null,"strict":true},{"type":"function","name":"bash","description":"Execute a bash command in the current working directory. Returns stdout and stderr. Output is truncated to last 2000 lines or 50KB (whichever is hit first). If truncated, full output is saved to a temp file. Optionally provide a timeout in seconds.","parameters":{"type":"object","required":["command","timeout"],"properties":{"command":{"type":"string","description":"Shell command to execute"},"timeout":{"anyOf":[{"type":"number","description":"Timeout in seconds (optional, no default timeout)"},{"type":"null"}]}},"additionalProperties":false},"output_schema":null,"strict":true},{"type":"function","name":"edit","description":"Edit a single file using exact text replacement. Every edits[].oldText must match a unique, non-overlapping region of the original file. If two changes affect the same block or nearby lines, merge them into one edit instead of emitting overlapping edits. Do not include large unchanged regions just to connect distant changes.","parameters":{"type":"object","required":["path","edits"],"properties":{"path":{"type":"string","description":"Path to the file to edit (relative or absolute)"},"edits":{"type":"array","items":{"type":"object","required":["oldText","newText"],"properties":{"oldText":{"type":"string","description":"Exact text for one targeted replacement. It must be unique in the original file and must not overlap with any other edits[].oldText in the same call."},"newText":{"type":"string","description":"Replacement text for this targeted edit."}},"additionalProperties":false},"description":"One or more targeted replacements. Each edit is matched against the original file, not incrementally. Do not include overlapping or nested edits. If two changes touch the same block or nearby lines, merge them into one edit instead."}},"additionalProperties":false},"output_schema":null,"strict":true},{"type":"function","name":"write","description":"Write content to a file. Creates the file if it doesn't exist, overwrites if it does. Automatically creates parent directories.","parameters":{"type":"object","required":["path","content"],"properties":{"path":{"type":"string","description":"Path to the file to write (relative or absolute)"},"content":{"type":"string","description":"Content to write to the file"}},"additionalProperties":false},"output_schema":null,"strict":true}],"tool_choice":"auto","parallel_tool_calls":true,"prompt_cache_key":"84509582-4a73-4fcd-9841-0b9eecd5955a","prompt_cache_retention":"24h","text":{"format":{"type":"text"},"verbosity":"low"},"top_p":0.98,"top_logprobs":0,"temperature":1.0,"reasoning":{"effort":"medium","summary":"detailed","context":"all_turns","mode":"standard"},"user":null,"usage":{"input_tokens":10732,"input_tokens_details":{"cached_tokens":0,"cache_write_tokens":0},"output_tokens":1119,"output_tokens_details":{"reasoning_tokens":51},"total_tokens":11851,"attribution":{"items":{"fc_079a42b7f225d9c5016ac966ec34c08196a6e72ced57201dff":{"input_tokens":34,"cached_tokens":0,"cache_write_tokens":0,"output_tokens":0},"fc_079a42b7f225d9c5016ac966f017688196b2b63ea69f513252":{"input_tokens":42,"cached_tokens":0,"cache_write_tokens":0,"output_tokens":0},"fc_079a42b7f225d9c5016ac966f0177c8196afd3717117f2872d":{"input_tokens":22,"cached_tokens":0,"cache_w