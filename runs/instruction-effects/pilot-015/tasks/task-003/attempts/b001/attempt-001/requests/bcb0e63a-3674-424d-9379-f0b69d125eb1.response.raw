);\",\"newText\":\"      sendHtml(res, 200, projectList('', projectFilter(url.searchParams.get('filter'))));\"},{\"oldText\":\"        sendHtml(res, 400, projectList('Project name is required'));\",\"newText\":\"        sendHtml(res, 400, projectList('Project name is required', projectFilter(form.get('filter'))));\"},{\"oldText\":\"    const taskMatch = url.pathname.match(\",\"newText\":\"    const archiveMatch = url.pathname.match(/^\\\\/projects\\\\/([a-zA-Z0-9-]+)\\\\/(archive|restore)$/);\\n    if (req.method === 'POST' && archiveMatch) {\\n      const result = setArchived.run(archiveMatch[2] === 'archive' ? 1 : 0, archiveMatch[1]);\\n      if (result.changes) {\\n        redirect(res, archiveMatch[2] === 'archive' ? '/' : '/?filter=Archived');\\n        return;\\n      }\\n    }\\n    const taskMatch = url.pathname.match(\"},{\"oldText\":\"        const filter = taskFilter(form.get('filter'));\\n        if (taskMatch[2])\",\"newText\":\"        const filter = taskFilter(form.get('filter'));\\n        if (project.archived) {\\n          sendHtml(res, 403, projectPage(project, filter, 'Archived project'));\\n          return;\\n        }\\n        if (taskMatch[2])\"}]}","status":"completed"}}

