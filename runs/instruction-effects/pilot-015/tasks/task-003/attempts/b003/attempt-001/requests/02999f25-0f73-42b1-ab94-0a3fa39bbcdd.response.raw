[{ ...summary, archived: 1 }, second]);\\n    const restored = await taskRequest(projectPath, 'PATCH', { archived: false });\\n    assert.equal(restored.status, 200);\\n    assert.deepEqual(await restored.json(), summary);\\n    const unchecked = await taskRequest\"},{\"oldText\":\"    assert.deepEqual(await (await fetch(`${base}/api/projects`)).json(), [first, second]);\\n    assert.deepEqual(await (await fetch(`${base}/api/projects/${first.id}`)).json(), first);\",\"newText\":\"    assert.deepEqual(await (await fetch(`${base}/api/projects`)).json(), [{ ...first, total: 2 }, second]);\\n    assert.deepEqual(await (await fetch(`${base}/api/projects/${first.id}`)).json(), { ...first, total: 2 });\"}]}","status":"completed"}}

