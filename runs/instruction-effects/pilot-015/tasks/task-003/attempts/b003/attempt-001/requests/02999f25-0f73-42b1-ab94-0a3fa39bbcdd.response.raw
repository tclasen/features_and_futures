data: {"type":"response.function_call_arguments.done","sequence_number":694,"item_id":"fc_037dac643fd387e8016ac9643c547c8196a5d794f945565c83","output_index":1,"arguments":"{\"path\":\"test/server.test.js\",\"edits\":[{\"oldText\":\"import net from 'node:net';\",\"newText\":\"import net from 'node:net';\\nimport { DatabaseSync } from 'node:sqlite';\"},{\"oldText\":\"test('projects and tasks validate, stay isolated and survive server restart', async () => {\\n  const directory = await mkdtemp(join(tmpdir(), 'workboard-test-'));\",\"newText\":\"test('projects, tasks and archive summaries survive migration and server restart', async () => {\\n  const directory = await mkdtemp(join(tmpdir(), 'workboard-test-'));\\n  const legacy = new DatabaseSync(join(directory, 'projects.sqlite'));\\n  legacy.exec('CREATE TABLE projects (id INTEGER PRIMARY KEY AUTOINCREMENT, name TEXT NOT NULL)');\\n  legacy.close();\"},{\"oldText\":\"    const unchecked = await taskRequest\",\"newText\":\"    const projectPath = `/api/projects/${first.id}`;\\n    const summary = { ...first, total: 2, completed: 1 };\\n    assert.deepEqual(await (await fetch(base + projectPath)).json(), summary);\\n    const archived = await taskRequest(projectPath, 'PATCH', { archived: true });\\n    assert.equal(archived.status, 200);\\n    assert.deepEqual(await archived.json(), { ...summary, archived: 1 });\\n    assert.equal((await taskRequest(tasksPath, 'POST', { title: 'Forbidden task' })).status, 409);\\n    assert.equal((await taskRequest(`${tasksPath}/${task.id}`, 'PATCH', { completed: false })).status, 409);\\n    await stop();\\n    await start();\\n    assert.deepEqual(await (await fetch(base + projectPath)).json(), { ...summary, archived: 1 });\\n    assert.deepEqual(await (await fetch(base + tasksPath)).json(), [{ ...task, completed: true }, nextTask]);\\n    assert.deepEqual(await (await fetch(`${base}/api/projects`)).json(), [{ ...summary, archived: 1 }, second]);\\n    const restored = await taskRequest(projectPath, 'PATCH', { archived: false });\\n    assert.equal(restored.status, 200);\\n    assert.deepEqual(await restored.json(), summary);\\n    const unchecked = await taskRequest\"},{\"oldText\":\"    assert.deepEqual(await (await fetch(`${base}/api/projects`)).json(), [first, second]);\\n    assert.deepEqual(await (await fetch(`${base}/api/projects/${first.id}`)).json(), first);\",\"newText\":\"    assert.deepEqual(await (await fetch(`${base}/api/projects`)).json(), [{ ...first, total: 2 }, second]);\\n    assert.deepEqual(await (await fetch(`${base}/api/projects/${first.id}`)).json(), { ...first, total: 2 });\"}]}"}

