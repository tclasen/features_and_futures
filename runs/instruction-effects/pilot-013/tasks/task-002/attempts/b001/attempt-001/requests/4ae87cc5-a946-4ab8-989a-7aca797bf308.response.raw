data: {"type":"response.function_call_arguments.done","sequence_number":1635,"item_id":"fc_0a1a61b1d52e6884016ac953b616b08195870d92bd7a5f4715","output_index":0,"arguments":"{\"path\":\"server.js\",\"edits\":[{\"oldText\":\"const listProjects = db.prepare\",\"newText\":\"db.exec(`CREATE TABLE IF NOT EXISTS tasks (\\n  id INTEGER PRIMARY KEY AUTOINCREMENT,\\n  project_id INTEGER NOT NULL REFERENCES projects(id),\\n  title TEXT NOT NULL,\\n  completed INTEGER NOT NULL DEFAULT 0 CHECK (completed IN (0, 1))\\n)`);\\nconst listTasks = db.prepare('SELECT id, title, completed FROM tasks WHERE project_id = ? ORDER BY id');\\nconst createTask = db.prepare('INSERT INTO tasks (project_id, title) VALUES (?, ?)');\\nconst updateTask = db.prepare('UPDATE tasks SET completed = ? WHERE id = ? AND project_id = ?');\\nconst listProjects = db.prepare\"},{\"oldText\":\"    button { background:\",\"newText\":\"    input[type=\\\"checkbox\\\"] { flex: none; min-width: auto; width: 20px; height: 20px; }\\n    select { padding: 10px; font: inherit; }\\n    .task-filter { margin-top: 24px; }\\n    button { background:\"},{\"oldText\":\"function sendHtml(response, status, html) {\",\"newText\":\"function taskFilter(value) {\\n  return ['All', 'Open', 'Completed'].includes(value) ? value : 'All';\\n}\\n\\nfunction projectPage(project, filter = 'All', error = '') {\\n  const tasks = listTasks.all(project.id).filter(task =>\\n    filter === 'All' || Boolean(task.completed) === (filter === 'Completed'));\\n  const path = `/projects/${project.id}`;\\n  return page(project.name, `<h1>${escapeHtml(project.name)}</h1>\\n    <form method=\\\"get\\\" action=\\\"/\\\"><button type=\\\"submit\\\">Projects</button></form>\\n    <h2>Tasks</h2>\\n    <form method=\\\"post\\\" action=\\\"${path}/tasks\\\">\\n      <input type=\\\"hidden\\\" name=\\\"filter\\\" value=\\\"${filter}\\\">\\n      <label for=\\\"task-title\\\">Task title</label>\\n      <div class=\\\"input-group\\\"><input id=\\\"task-title\\\" name=\\\"title\\\" type=\\\"text\\\">\\n      <button type=\\\"submit\\\">Create task</button></div>\\n    </form>\\n    ${error ? `<p role=\\\"alert\\\">${escapeHtml(error)}</p>` : ''}\\n    <form class=\\\"task-filter\\\" method=\\\"get\\\" action=\\\"${path}\\\">\\n      <label for=\\\"task-filter\\\">Task filter</label>\\n      <select id=\\\"task-filter\\\" name=\\\"filter\\\" onchange=\\\"this.form.requestSubmit()\\\">\\n        ${['All', 'Open', 'Completed'].map(value => `<option${filter === value ? ' selected' : ''}>${value}</option>`).join('')}\\n      </select>\\n    </form>\\n    ${tasks.length ? `<ul aria-label=\\\"Tasks\\\">${tasks.map(task => `\\n      <li data-testid=\\\"task-row\\\"><span>${escapeHtml(task.title)}</span>\\n        <form method=\\\"post\\\" action=\\\"${path}/tasks/${task.id}\\\">\\n          <input type=\\\"hidden\\\" name=\\\"filter\\\" value=\\\"${filter}\\\">\\n          <input type=\\\"checkbox\\\" name=\\\"completed\\\" value=\\\"1\\\" aria-label=\\\"Complete ${escapeHtml(task.title)}\\\"${task.completed ? ' checked' : ''} onchange=\\\"this.form.requestSubmit()\\\">\\n        </form>\\n      </li>`).join('')}</ul>` : '<p class=\\\"empty\\\">No matching tasks.</p>'}`);\\n}\\n\\nasync function readForm(request) {\\n  let body = '';\\n  request.setEncoding('utf8');\\n  for await (const chunk of request) {\\n    body += chunk;\\n    if (Buffer.byteLength(body) > 65536) {\\n      const error = new Error('Request too large');\\n      error.status = 413;\\n      throw error;\\n    }\\n  }\\n  return new URLSearchParams(body);\\n}\\n\\nfunction redirect(response, location) {\\n  response.writeHead(303, { Location: location });\\n  response.end();\\n}\\n\\nfunction sendHtml(response, status, html) {\"},{\"oldText\":\"      let body = '';\\n      request.setEncoding('utf8');\\n      for await (const chunk of request) {\\n        body += chunk;\\n        if (Buffer.byteLength(body) > 65536) {\\n          sendHtml(response, 413, page('Request too large', '<h1>Request too large</h1>'));\\n          return;\\n        }\\n      }\\n      const name = (new URLSearchParams(body).get('name') || '').trim();\",\"newText\":\"      const form = await readForm(request);\\n      const name = (form.get('name') || '').trim();\"},{\"oldText\":\"      response.writeHead(303, { Location: '/' });\\n      response.end();\",\"newText\":\"      redirect(response, '/');\"},{\"oldText\":\"        sendHtml(response, 200, page(project.name, `<h1>${escapeHtml(project.name)}</h1>\\n          <form method=\\\"get\\\" action=\\\"/\\\"><button type=\\\"submit\\\">Projects</button></form>`));\",\"newText\":\"        sendHtml(response, 200, projectPage(project, taskFilter(url.searchParams.get('filter'))));\"},{\"oldText\":\"    } else {\\n      sendHtml(response, 404, page('Not found', '<h1>Page not found</h1>'));\",\"newText\":\"    } else if (request.method === 'POST' && /^\\\\/projects\\\\/\\\\d+\\\\/tasks(?:\\\\/\\\\d+)?$/.test(url.pathname)) {\\n      const [, , projectId, , taskId] = url.pathname.split('/');\\n      const id = Number(projectId);\\n      const project = Number.isSafeInteger(id) ? findProject.get(id) : undefined;\\n      if (!project) {\\n        sendHtml(response, 404, page('Not found', '<h1>Project not found</h1>'));\\n        return;\\n      }\\n      const form = await readForm(request);\\n      const filter = taskFilter(form.get('filter'));\\n      if (taskId) {\\n        const result = updateTask.run(form.get('completed') === '1' ? 1 : 0, Number(taskId), id);\\n        if (!result.changes) {\\n          sendHtml(response, 404, page('Not found', '<h1>Task not found</h1>'));\\n          return;\\n        }\\n      } else {\\n        const title = (form.get('title') || '').trim();\\n        if (!title) {\\n          sendHtml(response, 400, projectPage(project, filter, 'Task title is required'));\\n          return;\\n        }\\n        createTask.run(id, title);\\n      }\\n      redirect(response, `/projects/${id}?filter=${filter}`);\\n    } else {\\n      sendHtml(response, 404, page('Not found', '<h1>Page not found</h1>'));\"},{\"oldText\":\"    if (!response.headersSent) sendHtml(response, 500, page('Error', '<h1>Something went wrong</h1>'));\",\"newText\":\"    if (!response.headersSent) sendHtml(response, error.status || 500, page('Error', `<h1>${error.status === 413 ? 'Request too large' : 'Something went wrong'}</h1>`));\"}]}"}

