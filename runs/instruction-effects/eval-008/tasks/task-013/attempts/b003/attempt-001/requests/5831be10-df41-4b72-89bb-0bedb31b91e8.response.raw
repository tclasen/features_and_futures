er}\\\">\\n      <label for=\\\"project-search\\\">Project search</label>\\n      <div class=\\\"controls\\\"><input id=\\\"project-search\\\" name=\\\"search\\\" type=\\\"text\\\" value=\\\"${escapeHtml(search)}\\\"><button type=\\\"submit\\\">Search projects</button></div>\\n    </form>\\n    <section class=\\\"projects\\\" aria-label=\\\"Projects\\\">${rows}</section>\"},{\"oldText\":\"range = { from: '', through: '' }) {\\n  const rangeFields\",\"newText\":\"range = { from: '', through: '' }, search = '') {\\n  const searchField = `<input type=\\\"hidden\\\" name=\\\"search\\\" value=\\\"${escapeHtml(search)}\\\">`;\\n  const rangeFields\"},{\"oldText\":\"${rangeFields}`;\\n  const destinations\",\"newText\":\"${rangeFields}${searchField}`;\\n  const destinations\"},{\"oldText\":\".filter(task => (filter === 'All'\",\"newText\":\".filter(task => matchesSearch(task.title, search) && (filter === 'All'\"},{\"oldText\":\"      ${rangeFields}\\n      <label for=\\\"task-filter\\\">\",\"newText\":\"      ${rangeFields}${searchField}\\n      <label for=\\\"task-filter\\\">\"},{\"oldText\":\"    <section class=\\\"projects\\\" aria-label=\\\"Tasks\\\">${rows}</section>\",\"newText\":\"    <form class=\\\"panel task-filter\\\" action=\\\"/projects/${project.id}\\\" method=\\\"get\\\">\\n      <input type=\\\"hidden\\\" name=\\\"filter\\\" value=\\\"${filter}\\\"><input type=\\\"hidden\\\" name=\\\"priorityFilter\\\" value=\\\"${priority}\\\">${rangeFields}\\n      <label for=\\\"task-search\\\">Task search</label>\\n      <div class=\\\"controls\\\"><input id=\\\"task-search\\\" name=\\\"search\\\" type=\\\"text\\\" value=\\\"${escapeHtml(search)}\\\"><button type=\\\"submit\\\">Search tasks</button></div>\\n    </form>\\n    <section class=\\\"projects\\\" aria-label=\\\"Tasks\\\">${rows}</section>\"},{\"oldText\":\"const projectLocation = (id, filter, priority, range) =>\",\"newText\":\"const projectLocation = (id, filter, priority, range, search = '') =>\"},{\"oldText\":\"${range?.through ? `&dueThrough=${range.through}` : ''}`;\",\"newText\":\"${range?.through ? `&dueThrough=${range.through}` : ''}${search ? `&search=${encodeURIComponent(search)}` : ''}`;\"},{\"oldText\":\"home('', url.searchParams.get('filter') === 'Archived' ? 'Archived' : 'Active')\",\"newText\":\"home('', url.searchParams.get('filter') === 'Archived' ? 'Archived' : 'Active', searchQuery(url.searchParams))\"},{\"oldText\":\"      const name = (new URLSearchParams(body).get('name') || '').trim();\",\"newText\":\"      const form = new URLSearchParams(body);\\n      const name = (form.get('name') || '').trim();\\n      const filter = form.get('filter') === 'Archived' ? 'Archived' : 'Active';\\n      const location = `/?filter=${filter}&search=${encodeURIComponent(searchQuery(form))}`;\"},{\"oldText\":\"home('Project name is required')\",\"newText\":\"home('Project name is required', filter, searchQuery(form))\"},{\"oldText\":\"res.writeHead(303, { Location: '/' });\",\"newText\":\"res.writeHead(303, { Location: location });\"},{\"oldText\":\"      const result = setArchived.run\",\"newText\":\"      const form = await readForm(req);\\n      if (!form) {\\n        html(res, 413, page('Request too large', '<h1>Request too large</h1>'));\\n        return;\\n      }\\n      const result = setArchived.run\"},{\"oldText\":\"redirect(res, archiveMatch[2] === 'archive' ? '/' : '/?filter=Archived');\",\"newText\":\"redirect(res, `/?filter=${archiveMatch[2] === 'archive' ? 'Active' : 'Archived'}&search=${encodeURIComponent(searchQuery(form))}`);\"},{\"oldText\":\"appliedRange(url.searchParams)))\",\"newText\":\"appliedRange(url.searchParams), searchQuery(url.searchParams)))\"},{\"oldText\":\"projectLocation(project.id, filter, priority, { from, through })\",\"newText\":\"projectLocation(project.id, filter, priority, { from, through }, searchQuery(form))\"}]}"}

