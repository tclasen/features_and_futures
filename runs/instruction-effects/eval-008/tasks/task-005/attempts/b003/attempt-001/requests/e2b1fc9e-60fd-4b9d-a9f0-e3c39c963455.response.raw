data: {"type":"response.function_call_arguments.done","sequence_number":766,"item_id":"fc_0a5a642c273a457b016aca95484f5481949e387a6a97c845e2","output_index":1,"arguments":"{\"path\":\"server.js\",\"edits\":[{\"oldText\":\"const updateTask = db.prepare('UPDATE tasks SET completed = ? WHERE id = ? AND project_id = ?');\",\"newText\":\"const updateTask = db.prepare('UPDATE tasks SET completed = ? WHERE id = ? AND project_id = ?');\\nconst renameTask = db.prepare('UPDATE tasks SET title = ? WHERE id = ? AND project_id = ?');\\nconst getTask = db.prepare('SELECT id FROM tasks WHERE id = ? AND project_id = ?');\"},{\"oldText\":\"    .task-row input { flex-shrink: 0; width: 20px; height: 20px; }\",\"newText\":\"    .task-row input[type=\\\"checkbox\\\"] { flex-shrink: 0; width: 20px; height: 20px; }\\n    .task-rename { margin-top: 16px; }\"},{\"oldText\":\"<span>${escapeHtml(task.title)}</span></label>\\n      </form>\\n    </div>\",\"newText\":\"<span>${escapeHtml(task.title)}</span></label>\\n      </form>\\n      <form class=\\\"task-rename\\\" action=\\\"/projects/${project.id}/tasks/${task.id}/rename\\\" method=\\\"post\\\">\\n        <input type=\\\"hidden\\\" name=\\\"filter\\\" value=\\\"${filter}\\\">\\n        <label for=\\\"new-task-title-${task.id}\\\">New task title</label>\\n        <div class=\\\"controls\\\"><input id=\\\"new-task-title-${task.id}\\\" name=\\\"title\\\" type=\\\"text\\\" autocomplete=\\\"off\\\"${project.archived ? ' disabled' : ''}><button type=\\\"submit\\\"${project.archived ? ' disabled' : ''}>Rename task</button></div>\\n      </form>\\n    </div>\"},{\"oldText\":\"const taskMatch = url.pathname.match(/^\\\\/projects\\\\/([1-9]\\\\d*)\\\\/tasks(?:\\\\/([1-9]\\\\d*))?$/);\",\"newText\":\"const taskMatch = url.pathname.match(/^\\\\/projects\\\\/([1-9]\\\\d*)\\\\/tasks(?:\\\\/([1-9]\\\\d*)(\\\\/rename)?)?$/);\"},{\"oldText\":\"        if (taskMatch[2]) {\\n          const result = updateTask.run(form.get('completed') === '1' ? 1 : 0, taskMatch[2], project.id);\",\"newText\":\"        if (taskMatch[3]) {\\n          if (!getTask.get(taskMatch[2], project.id)) {\\n            html(res, 404, page('Not found', '<h1>Not found</h1>'));\\n            return;\\n          }\\n          const title = (form.get('title') || '').trim();\\n          if (!title) {\\n            html(res, 200, projectPage(project, filter, 'Task title is required'));\\n            return;\\n          }\\n          renameTask.run(title, taskMatch[2], project.id);\\n        } else if (taskMatch[2]) {\\n          const result = updateTask.run(form.get('completed') === '1' ? 1 : 0, taskMatch[2], project.id);\"}]}"}

