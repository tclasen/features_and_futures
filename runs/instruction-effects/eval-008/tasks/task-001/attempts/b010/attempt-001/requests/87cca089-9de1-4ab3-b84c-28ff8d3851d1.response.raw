data: {"type":"response.completed","sequence_number":2672,"response":{"id":"resp_068bb9d417c89d3e016aca9016693c81909d794749e4b4a1bd","object":"response","created_at":1791660054,"completed_at":1791660070,"status":"completed","background":false,"frequency_penalty":0.0,"presence_penalty":0.0,"moderation":null,"model":"gpt-6-luna","access_programs":null,"previous_response_id":null,"instructions":null,"output":[{"type":"reasoning","id":"rs_068bb9d417c89d3e016aca9017bdb081909eb40db1bddffd9e","metadata":{"turn_id":"01a12742-ca4b-74a2-9714-ef40895cc12a"},"internal_chat_message_metadata_passthrough":{"turn_id":"01a12742-ca4b-74a2-9714-ef40895cc12a"},"summary":[],"content":[],"encrypted_content":"gAAAAABqypAXDQagBmugcbY-hg7-rwKOoBIzGpUxvXJlhJzEbM8_Xb1pHO12CIE3wKssUWG5daxcAjWWQ30fqeJLef2vVoNR0wnkGZ7hHu_pg_zU7cc1tp8cHQ7TKIcEPNMlvmsrS4KfRs3NYp0eNxjTIu39CDHnqUjWQEXuM6_2OjYzioMKUrDk27IcnQ6TK-faGdVWBCW5gIyVCioDODiP-W19VrWxyDJIL9heg1VkIQsfOT4SVW5K5v29zXBEOX2jdlqH1pZJG__QuwfQsc1d1pig3d-8N8vav4UIXXDS-5ihz4slKoXRHcbca0AXluAHD6Be_zPydZT4oiwxtgwCWC3sCyMVW7l63SqrZCWzLe6GtrhfZPbF6D8KQUz6j1av4Toaqai6nG6gnM4RbSZSnS92Jd-7Pm4oUxfBvr-jvohWw0_GJQISDm-z5R_i9fGhg1-YD2xOCjUrcNhce8WAeZieszx2EXor45JvgcJ_iaqWgJi9f1yn4kfn2mF6HurAZdcVlyGgQf4tdL6Y_qru9IxJbgr6L-0txfhXEirQzi0aJuclnn6IoC1pXi-ub96uLCV_ZMfwHh49L3KsGsh1WtXeWAtlDI0Lr1JlVJm2GLOtDZRDzp8ZeUS_yE_xLJ1JC6ouk_tsTFGg6WExGH3j0BzxS_BE7qai367dYXA4LHa37W_Ve_KH5PACfqGH-bXwhZXw-ib5nl6Q7-NST-d5GwR_zg6pLEgPC8B3-Ft4uy5DiF881pec0eB2zdD9drr7Tx7G-6A84NMW47Ebp7F9jYXtsIttGOjbDnpTAdw60A5D5Tj1mfjoC9MnAy2_2HgK4rM9ksi8Q4PqpPiHt5nj-Onrf1DIqQYST5gM2cNFBOSSkNmMRM1LkXx6WFk-957VfaDodOcg5xDgTteu4SXk3aBYpnRE1pDHQrnEEAu9A7jG1zogyrPs-hyFZXDt3HPhBxaD25PYSjViEIoKdpduEtOQKQdXc4WR-QjoxVeSrMp6E19BmrowBumFnxpJJYtFZWWv6e4x7mZ6ZonS_gjN1GfeBOzD_v9XhA3Ofr6Aqsp9w286sTqIcdIqjJWkrzQPOUMclkNNwBg0fMGmR1mTfpMGlx-Q8hgyUq3-u99rdvFr3fmtjaVRsG7O-_mptgnJvA9y_sZubagcp9-yZC6iibYlqwnqw6JKeZqTJZV3mCslD91DONQ5JnclSEWDr7QnKWPmA8lGK1yYta6tke-IySwsCJA_DW0fM6YAaPHpaiTkWBgXIwZAaKWMiYG4t2RvYaeASO2B7m7JcTxPaWZC