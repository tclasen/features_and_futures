n    }\\n    async function renderList() {\\n      app.innerHTML = `<h1>Workboard</h1>\\n        <form id=\\\"create-form\\\"><label for=\\\"project-name\\\">Project name</label><input id=\\\"project-name\\\" name=\\\"name\\\" type=\\\"text\\\" aria-label=\\\"Project name\\\"><button type=\\\"submit\\\">Create project</button></form>\\n        <div id=\\\"message\\\" role=\\\"alert\\\" hidden></div><section id=\\\"project-list\\\" aria-label=\\\"Projects\\\"></section>`;\\n      const list = app.querySelector('#project-list');\\n      const renderRows = async () => {\\n        list.innerHTML = (await projects()).map(project => `<div class=\\\"project-row\\\" data-testid=\\\"project-row\\\"><span class=\\\"project-name\\\">${escapeHtml(project.name)}</span><button type=\\\"button\\\" data-open=\\\"${project.id}\\\">Open project</button></div>`).join('');\\n        list.querySelectorAll('[data-open]').forEach(button => button.addEventListener('click', () => {\\n          window.location.href = `/projects/${encodeURIComponent(button.dataset.open)}`;\\n        }));\\n      };\\n      await renderRows();\\n      app.querySelector('#create-form').addEventListener('submit', async event => {\\n        event.preventDefault();\\n        const input = app.querySelector('#project-name');\\n        const message = app.querySelector('#message');\\n        const name = input.value.trim();\\n        if (!name) { message.textContent = 'Project name is required'; message.hidden = false; return; }\\n        const response = await fetch('/api/projects', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ name }) });\\n        if (!response.ok) { message.textContent = 'Project name is required'; message.hidden = false; return; }\\n        message.hidden = true;\\n        input.value = '';\\n        await renderRows();\\n      });\\n    }\\n    async function renderDetail(id) {\\n      const project = await fetch(`/api/projects/${encodeURIComponent(id)}`).then(async response => response.ok ? response.json() : null);\\n      if (!project) { app.innerHTML = '<h1>Project not found</h1><button id=\\\"back\\\">Projects</button>'; }\\n      else app.innerHTML = `<div class=\\\"detail-header\\\"><button id=\\\"back\\\" type=\\\"button\\\">Projects</button></div><h1>${escapeHtml(project.name)}</h1>`;\\n      app.querySelector('#back').addEventListener('click', () => { window.location.href = '/'; });\\n    }\\n    const match = window.location.pathname.match(/^\\\\/projects\\\\/(\\\\d+)\\\\/?$/);\\n    if (match) renderDetail(match[1]).catch(() => { app.innerHTML = '<h1>Unable to load project</h1>'; });\\n    else renderList().catch(() => { app.innerHTML = '<h1>Unable to load projects</h1>'; });\\n  </script>\\n</body>\\n</html>\\n\"}","call_id":"call_s6CjVHR7Gt2xPFGeCw0DLRFq","name":"write"},"output_index":0,"sequence_number":1260}

