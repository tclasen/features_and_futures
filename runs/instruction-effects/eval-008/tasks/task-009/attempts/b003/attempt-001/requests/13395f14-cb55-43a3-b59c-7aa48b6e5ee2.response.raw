data: {"type":"response.function_call_arguments.done","sequence_number":798,"item_id":"fc_0896c1be4617b73f016aca988b1b9081938293440db4245a83","output_index":2,"arguments":"{\"path\":\"server.js\",\"edits\":[{\"oldText\":\"const setDefaultPriority = db.prepare\",\"newText\":\"if (!db.prepare('PRAGMA table_info(tasks)').all().some(column => column.name === 'due_date')) {\\n  db.exec(\\\"ALTER TABLE tasks ADD COLUMN due_date TEXT NOT NULL DEFAULT ''\\\");\\n}\\nconst setDueDate = db.prepare('UPDATE tasks SET due_date = ? WHERE id = ? AND project_id = ?');\\nconst setDefaultPriority = db.prepare\"},{\"oldText\":\"SELECT id, title, completed, priority FROM tasks\",\"newText\":\"SELECT id, title, completed, priority, due_date FROM tasks\"},{\"oldText\":\"      <form class=\\\"task-rename\\\" action=\\\"/projects/${project.id}/tasks/${task.id}/rename\\\" method=\\\"post\\\">\",\"newText\":\"      <form class=\\\"task-rename\\\" action=\\\"/projects/${project.id}/tasks/${task.id}/due-date\\\" method=\\\"post\\\">\\n        ${filterFields}\\n        <label for=\\\"task-due-date-${task.id}\\\">Task due date</label>\\n        <div class=\\\"controls\\\"><input id=\\\"task-due-date-${task.id}\\\" name=\\\"dueDate\\\" type=\\\"text\\\" value=\\\"${escapeHtml(task.due_date)}\\\" autocomplete=\\\"off\\\"${project.archived ? ' disabled' : ''}><button type=\\\"submit\\\"${project.archived ? ' disabled' : ''}>Save due date</button></div>\\n      </form>\\n      <form class=\\\"task-rename\\\" action=\\\"/projects/${project.id}/tasks/${task.id}/rename\\\" method=\\\"post\\\">\"},{\"oldText\":\"async function readForm(req) {\",\"newText\":\"function validDueDate(value) {\\n  if (value === '') return true;\\n  if (!/^\\\\d{4}-\\\\d{2}-\\\\d{2}$/.test(value)) return false;\\n  const [year, month, day] = value.split('-').map(Number);\\n  if (year < 1 || month < 1 || month > 12) return false;\\n  const leap = year % 4 === 0 && (year % 100 !== 0 || year % 400 === 0);\\n  const days = [31, leap ? 29 : 28, 31, 30, 31, 30, 31, 31, 30, 31, 30, 31];\\n  return day >= 1 && day <= days[month - 1];\\n}\\n\\nasync function readForm(req) {\"},{\"oldText\":\"(\\\\/(?:rename|priority))?\",\"newText\":\"(\\\\/(?:rename|priority|due-date))?\"},{\"oldText\":\"        if (taskMatch[3] === '/priority') {\",\"newText\":\"        if (taskMatch[3] === '/due-date') {\\n          if (!getTask.get(taskMatch[2], project.id)) {\\n            html(res, 404, page('Not found', '<h1>Not found</h1>'));\\n            return;\\n          }\\n          const dueDate = (form.get('dueDate') || '').trim();\\n          if (!validDueDate(dueDate)) {\\n            html(res, 200, projectPage(project, filter, 'Due date must be a valid YYYY-MM-DD date', selectedPriority));\\n            return;\\n          }\\n          setDueDate.run(dueDate, taskMatch[2], project.id);\\n        } else if (taskMatch[3] === '/priority') {\"}]}"}

