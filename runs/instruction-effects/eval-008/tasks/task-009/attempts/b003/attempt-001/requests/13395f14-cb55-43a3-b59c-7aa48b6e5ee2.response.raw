r % 4 === 0 && (year % 100 !== 0 || year % 400 === 0);\\n  const days = [31, leap ? 29 : 28, 31, 30, 31, 30, 31, 31, 30, 31, 30, 31];\\n  return day >= 1 && day <= days[month - 1];\\n}\\n\\nasync function readForm(req) {\"},{\"oldText\":\"(\\\\/(?:rename|priority))?\",\"newText\":\"(\\\\/(?:rename|priority|due-date))?\"},{\"oldText\":\"        if (taskMatch[3] === '/priority') {\",\"newText\":\"        if (taskMatch[3] === '/due-date') {\\n          if (!getTask.get(taskMatch[2], project.id)) {\\n            html(res, 404, page('Not found', '<h1>Not found</h1>'));\\n            return;\\n          }\\n          const dueDate = (form.get('dueDate') || '').trim();\\n          if (!validDueDate(dueDate)) {\\n            html(res, 200, projectPage(project, filter, 'Due date must be a valid YYYY-MM-DD date', selectedPriority));\\n            return;\\n          }\\n          setDueDate.run(dueDate, taskMatch[2], project.id);\\n        } else if (taskMatch[3] === '/priority') {\"}]}","status":"completed"}}

