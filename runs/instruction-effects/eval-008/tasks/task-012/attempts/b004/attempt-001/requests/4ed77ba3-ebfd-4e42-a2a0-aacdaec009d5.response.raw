data: {"type":"response.function_call_arguments.done","sequence_number":605,"item_id":"fc_0574dad3e0574539016aca9f46839887d18319c72cfd1534f4","output_index":1,"arguments":"{\"path\":\"server.js\",\"edits\":[{\"oldText\":\"try { db.exec('ALTER TABLE tasks ADD COLUMN due_date TEXT'); } catch {}\\n\",\"newText\":\"try { db.exec('ALTER TABLE tasks ADD COLUMN due_date TEXT'); } catch {}\\ndb.exec(`CREATE TABLE IF NOT EXISTS task_positions (task_id TEXT NOT NULL, project_id TEXT NOT NULL, position INTEGER NOT NULL, PRIMARY KEY(task_id, project_id));\\n  INSERT OR IGNORE INTO task_positions (task_id, project_id, position)\\n  SELECT id, project_id, ROW_NUMBER() OVER (PARTITION BY project_id ORDER BY created_at, rowid) FROM tasks;`);\\n\"},{\"oldText\":\"const listTasks = db.prepare('SELECT id, title, completed, priority, due_date FROM tasks WHERE project_id = ? ORDER BY created_at, rowid');\",\"newText\":\"const listTasks = db.prepare('SELECT t.id, t.title, t.completed, t.priority, t.due_date FROM tasks t JOIN task_positions p ON p.task_id = t.id AND p.project_id = t.project_id WHERE t.project_id = ? ORDER BY p.position, p.task_id');\"},{\"oldText\":\"const moveTask = db.prepare('UPDATE tasks SET project_id = ?, created_at = ? WHERE id = ? AND project_id = ?');\\nconst nextTaskOrder = db.prepare('SELECT COALESCE(MAX(created_at), 0) + 1 AS next FROM tasks WHERE project_id = ?');\",\"newText\":\"const moveTask = db.prepare('UPDATE tasks SET project_id = ? WHERE id = ? AND project_id = ?');\\nconst nextTaskOrder = db.prepare('SELECT COALESCE(MAX(position), 0) + 1 AS next FROM task_positions WHERE project_id = ?');\\nconst insertTaskPosition = db.prepare('INSERT OR IGNORE INTO task_positions (task_id, project_id, position) VALUES (?, ?, ?)');\"} ,{\"oldText\":\"const id = randomUUID(); const priority = findProject.get(projectId).default_priority; insertTask.run(id, projectId, title, nextTaskOrder.get(projectId).next, priority);\",\"newText\":\"const id = randomUUID(); const priority = findProject.get(projectId).default_priority; const order = nextTaskOrder.get(projectId).next; insertTask.run(id, projectId, title, order, priority); insertTaskPosition.run(id, projectId, order);\"},{\"oldText\":\"const order = nextTaskOrder.get(destinationId).next;\\n          const result = moveTask.run(destinationId, order, taskId, projectId);\",\"newText\":\"const order = nextTaskOrder.get(destinationId).next;\\n          const result = moveTask.run(destinationId, taskId, projectId);\\n          if (Number(result.changes)) insertTaskPosition.run(taskId, destinationId, order);\"}]}"}

