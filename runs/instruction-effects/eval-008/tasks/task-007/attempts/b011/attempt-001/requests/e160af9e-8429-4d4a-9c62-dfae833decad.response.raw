ent(id)}/tasks/${select.dataset.priority}`, { method: 'PATCH', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ priority: select.value }) });\\n            await refresh();\\n          }));\"},{\"oldText\":\"        app.querySelector('#task-filter').addEventListener('change', refresh);\\n        app.querySelector('#task-form')\",\"newText\":\"        app.querySelector('#task-filter').addEventListener('change', refresh);\\n        app.querySelector('#priority-filter').addEventListener('change', refresh);\\n        app.querySelector('#task-form')\"}]}"}

