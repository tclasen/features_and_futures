data: {"type":"response.function_call_arguments.done","arguments":"{\"path\":\"server.js\",\"edits\":[{\"oldText\":\"const setPriority = db.prepare\",\"newText\":\"if (!db.prepare('PRAGMA table_info(projects)').all().some(column => column.name === 'default_priority')) {\\n  db.exec(\\\"ALTER TABLE projects ADD COLUMN default_priority TEXT NOT NULL DEFAULT 'Normal' CHECK (default_priority IN ('Low', 'Normal', 'High'))\\\");\\n}\\nconst setDefaultPriority = db.prepare('UPDATE projects SET default_priority = ? WHERE id = ? AND archived = 0');\\nconst setPriority = db.prepare\"},{\"oldText\":\"const addTask = db.prepare('INSERT INTO tasks (project_id, title) VALUES (?, ?)');\",\"newText\":\"const addTask = db.prepare('INSERT INTO tasks (project_id, title, priority) VALUES (?, ?, ?)');\"},{\"oldText\":\"SELECT id, name, archived FROM projects WHERE id = ?\",\"newText\":\"SELECT id, name, archived, default_priority FROM projects WHERE id = ?\"},{\"oldText\":\"    <form class=\\\"panel task-create\\\" action=\\\"/projects/${project.id}/tasks\\\" method=\\\"post\\\">\",\"newText\":\"    <form class=\\\"panel task-create\\\" action=\\\"/projects/${project.id}/default-priority\\\" method=\\\"post\\\">\\n      ${filterFields}\\n      <label for=\\\"default-task-priority\\\">Default task priority</label>\\n      <select id=\\\"default-task-priority\\\" name=\\\"priority\\\"${project.archived ? ' disabled' : ''} onchange=\\\"this.form.requestSubmit()\\\">\\n        ${['Low', 'Normal', 'High'].map(option => `<option${project.default_priority === option ? ' selected' : ''}>${option}</option>`).join('')}\\n      </select>\\n    </form>\\n    <form class=\\\"panel task-create\\\" action=\\\"/projects/${project.id}/tasks\\\" method=\\\"post\\\">\"},{\"oldText\":\"    const renameMatch = url.pathname.match\",\"newText\":\"    const defaultMatch = url.pathname.match(/^\\\\/projects\\\\/([1-9]\\\\d*)\\\\/default-priority$/);\\n    if (req.method === 'POST' && defaultMatch) {\\n      const project = getProject.get(defaultMatch[1]);\\n      if (project) {\\n        const form = await readForm(req);\\n        if (!form) {\\n          html(res, 413, page('Request too large', '<h1>Request too large</h1>'));\\n          return;\\n        }\\n        const filter = taskFilter(form.get('filter'));\\n        const priority = priorityFilter(form.get('priorityFilter'));\\n        if (project.archived) {\\n          html(res, 403, projectPage(project, filter, 'Archived project is read-only', priority));\\n          return;\\n        }\\n        const value = form.get('priority');\\n        if (!['Low', 'Normal', 'High'].includes(value)) {\\n          html(res, 400, projectPage(project, filter, 'Invalid task priority', priority));\\n          return;\\n        }\\n        setDefaultPriority.run(value, project.id);\\n        redirect(res, projectLocation(project.id, filter, priority));\\n        return;\\n      }\\n    }\\n    const renameMatch = url.pathname.match\"},{\"oldText\":\"addTask.run(project.id, title);\",\"newText\":\"addTask.run(project.id, title, project.default_priority);\"}]}","item_id":"fc_0591896b44f8079f016aca9760afec81908c271272fe4a438a","output_index":0,"sequence_number":723}

