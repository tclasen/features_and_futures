data: {"type":"response.function_call_arguments.done","sequence_number":797,"item_id":"fc_0cab1f2e58273ea6016aca25e719448193840a1bb6784d7603","output_index":1,"arguments":"{\"path\":\"server.js\",\"edits\":[{\"oldText\":\"const priorities = ['Low', 'Normal', 'High'];\",\"newText\":\"if (!db.prepare('PRAGMA table_info(tasks)').all().some(column => column.name === 'due_date')) {\\n  db.exec(\\\"ALTER TABLE tasks ADD COLUMN due_date TEXT NOT NULL DEFAULT ''\\\");\\n}\\nconst priorities = ['Low', 'Normal', 'High'];\"},{\"oldText\":\"SELECT id, title, completed, priority FROM tasks\",\"newText\":\"SELECT id, title, completed, priority, due_date FROM tasks\"},{\"oldText\":\"function escapeHtml(value) {\",\"newText\":\"const setTaskDueDate = db.prepare('UPDATE tasks SET due_date = ? WHERE id = ? AND project_id = ?');\\n\\nfunction isValidDueDate(value) {\\n  if (value === '') return true;\\n  if (!/^\\\\d{4}-\\\\d{2}-\\\\d{2}$/.test(value)) return false;\\n  const [year, month, day] = value.split('-').map(Number);\\n  if (year < 1 || month < 1 || month > 12) return false;\\n  const leapYear = year % 4 === 0 && (year % 100 !== 0 || year % 400 === 0);\\n  const days = [31, leapYear ? 29 : 28, 31, 30, 31, 30, 31, 31, 30, 31, 30, 31];\\n  return day >= 1 && day <= days[month - 1];\\n}\\n\\nfunction escapeHtml(value) {\"},{\"oldText\":\"        <form method=\\\"post\\\" action=\\\"/projects/${project.id}/tasks/${task.id}/rename\\\">\",\"newText\":\"        <form method=\\\"post\\\" action=\\\"/projects/${project.id}/tasks/${task.id}/due-date\\\">\\n          ${filterFields}\\n          <label for=\\\"task-due-date-${task.id}\\\">Task due date</label>\\n          <input id=\\\"task-due-date-${task.id}\\\" name=\\\"dueDate\\\" type=\\\"text\\\" value=\\\"${escapeHtml(task.due_date)}\\\"${project.archived ? ' disabled' : ''}>\\n          <button type=\\\"submit\\\"${project.archived ? ' disabled' : ''}>Save due date</button>\\n        </form>\\n        <form method=\\\"post\\\" action=\\\"/projects/${project.id}/tasks/${task.id}/rename\\\">\"},{\"oldText\":\"(?:rename|priority)\",\"newText\":\"(?:rename|priority|due-date)\"},{\"oldText\":\"      if (parts[5] === 'priority') {\",\"newText\":\"      if (parts[5] === 'due-date') {\\n        const taskId = Number(parts[4]);\\n        if (!Number.isSafeInteger(taskId) || !findTask.get(taskId, projectId)) {\\n          sendHtml(response, 404, page('Not found', '<h1>Task not found</h1>'));\\n          return;\\n        }\\n        const dueDate = (body.get('dueDate') || '').trim();\\n        if (!isValidDueDate(dueDate)) {\\n          sendHtml(response, 400, projectPage(project, filter, 'Due date must be a valid YYYY-MM-DD date', '', selectedPriority));\\n          return;\\n        }\\n        setTaskDueDate.run(dueDate, taskId, projectId);\\n      } else if (parts[5] === 'priority') {\"}]}"}

