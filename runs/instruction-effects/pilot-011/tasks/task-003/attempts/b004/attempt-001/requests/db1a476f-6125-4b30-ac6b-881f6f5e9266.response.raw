data: {"type":"response.function_call_arguments.done","sequence_number":806,"item_id":"fc_0367ef94a4c7d979016ac942783404819496f15105a9babce4","output_index":0,"arguments":"{\"path\":\"server.js\",\"edits\":[{\"oldText\":\"name TEXT NOT NULL, created_at TEXT NOT NULL DEFAULT CURRENT_TIMESTAMP);\",\"newText\":\"name TEXT NOT NULL, archived INTEGER NOT NULL DEFAULT 0, created_at TEXT NOT NULL DEFAULT CURRENT_TIMESTAMP);\"},{\"oldText\":\"const html = `<!doctype html>\",\"newText\":\"try { db.exec('ALTER TABLE projects ADD COLUMN archived INTEGER NOT NULL DEFAULT 0'); } catch {}\\n\\nconst html = `<!doctype html>\"},{\"oldText\":\"const project=await response.json();app.innerHTML=\",\"newText\":\"const project=await response.json();app.innerHTML=\"},{\"oldText\":\"<h1>'+esc(project.name)+'</h1><form id=\\\"create-task\\\">\",\"newText\":\"<h1>'+esc(project.name)+'</h1>'+(project.archived?'<p>Archived project</p>':'')+'<form id=\\\"create-task\\\">\"},{\"oldText\":\"name=\\\"title\\\" aria-label=\\\"Task title\\\"><button>Create task\",\"newText\":\"name=\\\"title\\\" aria-label=\\\"Task title\\\" '+(project.archived?'disabled':'')+'><button '+(project.archived?'disabled':'')+'>Create task\"},{\"oldText\":\"(t.completed?'checked':'')+'></label></div>').join('')\",\"newText\":\"(t.completed?'checked':'')+(project.archived?' disabled':'')+'></label></div>').join('')\"},{\"oldText\":\"if (req.method === 'GET' && url.pathname === '/api/projects') return send(res, 200, db.prepare('SELECT id, name FROM projects ORDER BY id').all());\",\"newText\":\"if (req.method === 'GET' && url.pathname === '/api/projects') { const archived=url.searchParams.get('archived')==='true'; return send(res,200,db.prepare('SELECT p.id,p.name,p.archived,COUNT(t.id) total,SUM(CASE WHEN t.completed=1 THEN 1 ELSE 0 END) completed FROM projects p LEFT JOIN tasks t ON t.project_id=p.id WHERE p.archived=? GROUP BY p.id ORDER BY p.id').all(archived?1:0).map(p=>({...p,id:Number(p.id),archived:Boolean(p.archived),total:Number(p.total),completed:Number(p.completed)}))); }\"},{\"oldText\":\"const result=db.prepare('UPDATE tasks SET completed=? WHERE id=?').run(body.completed?1:0,Number(taskMatch[1]));\",\"newText\":\"const result=db.prepare('UPDATE tasks SET completed=? WHERE id=? AND project_id IN (SELECT id FROM projects WHERE archived=0)').run(body.completed?1:0,Number(taskMatch[1]));\"},{\"oldText\":\"if(req.method==='GET'&&projectMatch){const project=db.prepare('SELECT id,name FROM projects WHERE id=?').get(Number(projectMatch[1]));return project?send(res,200,project):send(res,404,{error:'Project not found'});}\",\"newText\":\"if(req.method==='GET'&&projectMatch){const project=db.prepare('SELECT id,name,archived FROM projects WHERE id=?').get(Number(projectMatch[1]));return project?send(res,200,{...project,id:Number(project.id),archived:Boolean(project.archived)}):send(res,404,{error:'Project not found'});}\\n if(projectMatch&&req.method==='PATCH'){try{const body=await readBody(req);if(typeof body.archived!=='boolean')return send(res,400,{error:'Invalid archive state'});const result=db.prepare('UPDATE projects SET archived=? WHERE id=?').run(body.archived?1:0,Number(projectMatch[1]));return result.changes?send(res,200,{ok:true}):send(res,404,{error:'Project not found'});}catch{return send(res,400,{error:'Invalid request'});}}\"}]}"}

