data: {"type":"response.output_item.done","sequence_number":701,"output_index":1,"item":{"type":"function_call","id":"fc_00a4d88c659ded0d016acb740a43ec87d2bc4553e1e94bcb6c","call_id":"call_a6646f0862134c7a841bb63f87b6ca2c","name":"edit","arguments":"{\"path\":\"test/server.test.js\",\"edits\":[{\"oldText\":\"import { once } from 'node:events';\",\"newText\":\"import { once } from 'node:events';\\nimport { DatabaseSync } from 'node:sqlite';\"},{\"oldText\":\"test('launch, project validation, creation order, routes, and restart persistence', async () => {\",\"newText\":\"test('projects, tasks, archive/restore, summaries, migration, and restart persistence', async () => {\"},{\"oldText\":\"  let child;\\n  async function start()\",\"newText\":\"  const legacy = new DatabaseSync(join(dir, 'projects.sqlite'));\\n  legacy.exec('CREATE TABLE projects (id INTEGER PRIMARY KEY AUTOINCREMENT, name TEXT NOT NULL)');\\n  legacy.close();\\n  let child;\\n  async function start()\"},{\"oldText\":\"    assert.equal(first.name, 'First project');\",\"newText\":\"    assert.equal(first.name, 'First project');\\n    assert.equal(first.archived, 0);\\n    assert.equal(first.completed, 0);\\n    assert.equal(first.total, 0);\"},{\"oldText\":\"    await complete(task.id, true);\\n    await stop();\",\"newText\":\"    await complete(task.id, true);\\n    async function archive(archived) {\\n      return fetch(`${base}/api/projects/${first.id}`, {\\n        method: 'PATCH', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ archived })\\n      });\\n    }\\n    assert.equal((await archive('true')).status, 400);\\n    first.total = 2;\\n    first.completed = 1;\\n    first.archived = 1;\\n    assert.deepEqual(await (await archive(true)).json(), first);\\n    assert.equal((await createTask('Forbidden')).status, 409);\\n    assert.equal((await complete(task.id, false)).status, 409);\\n    assert.deepEqual(await tasksFor(first.id), [task, nextTask]);\\n    await stop();\"},{\"oldText\":\"    assert.deepEqual(await (await fetch(`${base}/api/projects/${first.id}`)).json(), first);\\n  } finally {\",\"newText\":\"    assert.deepEqual(await (await fetch(`${base}/api/projects/${first.id}`)).json(), first);\\n    first.archived = 0;\\n    assert.deepEqual(await (await archive(false)).json(), first);\\n    assert.deepEqual(await tasksFor(first.id), [task, nextTask]);\\n    task.completed = false;\\n    await complete(task.id, false);\\n    first.completed = 0;\\n    await stop();\\n    await start();\\n    assert.deepEqual(await (await fetch(`${base}/api/projects`)).json(), expected);\\n    assert.deepEqual(await tasksFor(first.id), [task, nextTask]);\\n  } finally {\"}]}","status":"completed"}}

