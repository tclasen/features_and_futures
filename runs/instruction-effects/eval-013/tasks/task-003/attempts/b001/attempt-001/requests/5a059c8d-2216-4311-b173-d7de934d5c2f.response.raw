'], {\\n    env: { ...process.env, PORT: '0', DB_PATH: databasePath },\\n    stdio: ['ignore', 'pipe', 'pipe'],\\n  });\\n  const base = await new Promise((resolve, reject) => {\\n    let output = '';\\n    child.stdout.on('data', data => {\\n      output += data;\\n      const match = output.match(/listening on port (\\\\d+)/);\\n      if (match) resolve(`http://127.0.0.1:${match[1]}`);\\n    });\\n    child.once('error', reject);\\n    child.once('exit', code => reject(new Error(`Server exited: ${code}`)));\\n  });\\n  return {\\n    base,\\n    stop: () => new Promise(resolve => {\\n      child.once('exit', resolve);\\n      child.kill('SIGTERM');\\n    }),\\n  };\\n}\\n\\nconst rows = (html, type = 'project') => html.match(new RegExp(`<li data-testid=\\\"${type}-row\\\">[\\\\\\\\s\\\\\\\\S]*?<\\\\\\\\/li>`, 'g')) || [];\\n\\ntest('archive and restore preserve tasks, summaries, filtering, and persisted state', async () => {\\n  const directory = await mkdtemp(join(tmpdir(), 'workboard-archive-'));\\n  let server;\\n  try {\\n    const databasePath = join(directory, 'workboard.sqlite');\\n    // Exercise migration from the original project schema with existing data.\\n    const db = new DatabaseSync(databasePath);\\n    db.exec(\\\"CREATE TABLE projects (id INTEGER PRIMARY KEY AUTOINCREMENT, name TEXT NOT NULL); INSERT INTO projects (name) VALUES ('Existing');\\\");\\n    db.close();\\n    server = await start(databasePath);\\n    const post = (path, body = {}) => fetch(`${server.base}${path}`, {\\n      method: 'POST', body: new URLSearchParams(body), redirect: 'manual',\\n    });\\n    const get = async path => (await fetch(`${server.base}${path}`)).text();\\n    let html = await get('/');\\n    assert.match(html, /<label for=\\\"project-filter\\\">Project filter<\\\\/label>/);\\n    assert.match(html, /<option selected>Active<\\\\/option><option>Archived<\\\\/option>/);\\n    assert.match(rows(html)[0], /data-testid=\\\"project-summary\\\">0\\\\/0 completed/);\\n    assert.match(rows(html)[0], />Archive project<\\\\/button>/);\\n    await post('/projects', { name: 'Second' });\\n    await post('/projects/1/tasks', { title: 'Done' });\\n    await post('/projects/1/tasks', { title: 'Pending' });\\n    await post('/projects/1/tasks/1', { completed: '1' });\\n    assert.match(rows(await get('/'))[0], /1\\\\/2 completed/);\\n    assert.equal((await post('/projects/1/archive')).status, 303);\\n    assert.equal(rows(await get('/')).length, 1);\\n    assert.match(rows(await get('/'))[0], /Second/);\\n    html = await get('/?filter=Archived');\\n    assert.equal(rows(html).length, 1);\\n    assert.match(rows(html)[0], /Existing/);\\n    assert.match(rows(html)[0], /1\\\\/2 completed/);\\n    assert.match(rows(html)[0], />Open project<\\\\/button>/);\\n    assert.match(rows(html)[0], />Restore project<\\\\/button>/);\\n    assert.doesNotMatch(rows(html)[0], />Archive project<\\\\/button>/);\\n    const archivedList = html;\\n    const archivedPage = await get('/projects/1');\\n    assert.match(archivedPage, /Archived project/);\\n    assert.match(archivedPage, /<button type=\\\"submit\\\" disabled>Create task/);\\n    for (const row of rows(archivedPage, 'task')) assert.match(row, /disabled/);\\n    assert.equal(rows(await get('/projects/1?filter=Open'), 'task').length, 1);\\n    assert.match(rows(await get('/projects/1?filter=Completed'), 'task')[0], /Done/);\\n    assert.equal((await post('/projects/1/tasks', { title: 'Blocked' })).status, 403);\\n    assert.equal((await post('/projects/1/tasks/1')).status, 403);\\n    assert.equal(await get('/projects/1'), archivedPage);\\n    await server.stop();\\n    server = await start(databasePath);\\n    assert.equal(await get('/?filter=Archived'), archivedList);\\n    assert.equal(await get('/projects/1'), archivedPage);\\n    assert.equal((await post('/projects/1/restore')).status, 303);\\n    assert.equal(rows(await get('/?filter=Archived')).length, 0);\\n    html = await get('/');\\n    assert.equal(rows(html).length, 2);\\n    assert.match(rows(html)[0], /Existing/);\\n    assert.match(rows(html)[0], /1\\\\/2 completed/);\\n    const restoredPage = await get('/projects/1');\\n    assert.doesNotMatch(restoredPage, /disabled|Archived project/);\\n    assert.match(rows(restoredPage, 'task')[0], /checked/);\\n    await server.stop();\\n    server = await start(databasePath);\\n    assert.equal(await get('/projects/1'), restoredPage);\\n    assert.equal(await get('/'), html);\\n    await post('/projects/1/tasks/1');\\n    assert.match(rows(await get('/'))[0], /0\\\\/2 completed/);\\n    assert.equal((await post('/projects/999/archive')).status, 404);\\n  } finally {\\n    if (server) await server.stop();\\n    await rm(directory, { recursive: true, force: true });\\n  }\\n});\\n\"}","status":"completed"}],"error":null,"incomplete_details":null,"tools":[{"type":"function","name":"read","description":"Read the contents of a file. Supports text files and images (jpg, png, gif, webp, bmp). Images are sent as attachments. For text files, output is truncated to 2000 lines or 50KB (whichever is hit first). Use offset/limit for large files. When you need the full file, continue with offset until complete.","parameters":{"type":"object","required":["path","offset","limit"],"properties":{"path":{"type":"string","description":"Path to the file to read (relative or absolute)"},"offset":{"anyOf":[{"type":"number","description":"Line number to start reading from (1-indexed)"},{"type":"null"}]},"limit":{"anyOf":[{"type":"number","description":"Maximum number of lines to read"},{"type":"null"}]}},"additionalProperties":false},"output_schema":null,"strict":true},{"type":"function","name":"bash","description":"Execute a bash command in the current working directory. Returns stdout and stderr. Output is truncated to last 2000 lines or 50KB (whichever is hit first). If truncated, full output is saved to a temp file. Optionally provide a timeout in seconds.","parameters":{"type":"object","required":["command","timeout"],"properties":{"command":{"type":"string","description":"Shell command to execute"},"timeout":{"anyOf":[{"type":"number","description":"Timeout in seconds (optional, no default timeout)"},{"type":"null"}]}},"additionalProperties":false},"output_schema":null,"strict":true},{"type":"function","name":"edit","description":"Edit a single file using exact text replacement. Every edits[].oldText must match a unique, non-overlapping region of the original file. If two changes affect the same block or nearby lines, merge them into one edit instead of emitting overlapping edits. Do not include large unchanged regions just to connect distant changes.","parameters":{"type":"object","required":["path","edits"],"properties":{"path":{"type":"string","description":"Path to the file to edit (relative or absolute)"},"edits":{"type":"array","items":{"type":"object","required":["oldText","newText"],"properties":{"oldText":{"type":"string","description":"Exact text for one targeted replacement. It must be unique in the original file and must not overlap with any other edits[].oldText in the same call."},"newText":{"type":"string","description":"Replacement text for this targeted edit."}},"additionalProperties":false},"description":"One or more targeted replacements. Each edit is matched against the original file, not incrementally. Do not include overlapping or nested edits. If two changes touch the same block or nearby lines, merge them into one edit instead."}},"additionalProperties":false},"output_schema":null,"strict":true},{"type":"function","name":"write","description":"Write content to a file. Creates the file if it doesn't exist, overwrites if it does. Automatically creates parent directories.","parameters":{"type":"object","required":["path","content"],"properties":{"path":{"type":"string","description":"Path to the file to write (relative or absolute)"},"content":{"type":"string","description":"Content to write to the file"}},"additionalProperties":false},"output_schema":null,"strict":true}],"tool_choice":"auto","parallel_tool_calls":true,"prompt_cache_key":"f46ba37e-05c3-47d7-a9a8-a74505d4b482","prompt_cache_retention":"24h","text":{"format":{"type":"text"},"verbosity":"low"},"top_p":0.98,"top_logprobs":0,"temperature":1.0,"reasoning":{"effort":"medium","summary":"detailed","context":"all_turns","mode":"standard"},"user":null,"usage":{"input_tokens":7992,"input_tokens_details":{"cached_tokens":0,"cache_write_tokens":0},"output_tokens":1465,"output_tokens_details":{"reasoning_tokens":25},"total_tokens":9457,"attribution":{"items":{"fc_0ebae1da2419a5f8016acb73d3bdfc8196a92a987221d7790a":{"input_tokens":38,"cached_tokens":0,"cache_write_tokens":0,"output_tokens":0},"fc_0ebae1da2419a5f8016acb73d6e7048196953225607d8ded35":{"input_tokens":42,"cached_tokens":0,"cache_write_tokens":0,"output_tokens":0},"fc_0ebae1da2419a5f8016acb73d8c280819681e15a2de4f6f111":{"input_tokens":22,"cached_tokens":0,"cache_write_tokens":0,"output_tokens":0},"fc_0ebae1da2419a5f8016acb73d8c280819694076ded49c96cdd":{"input_tokens":21,"cached_tokens":0,"cache_write_tokens":0,"output_tokens":0},"fc_0ebae1da2419a5f8016acb73d8c2808196aa737f8a4f139830":{"input_tokens":24,"cached_tokens":0,"cache_write_tokens":0,"output_tokens":0},"fc_0ebae1da2419a5f8016acb73dbc5808196828639b2e22204e8":{"input_tokens":37,"cached_tokens":0,"cache_write_tokens":0,"output_tokens":0},"fc_0ebae1da2419a5f8016acb73de06bc8196b64da83c69b86eac":{"input_tokens":30,"cached_tokens":0,"cache_write_tokens":0,"output_tokens":0},"fc_0ebae1da2419a5f8016acb73e09c908196bc6971c63c424833":{"input_tokens":1299,"cached_tokens":0,"cache_write_tokens":0,"output_tokens":0},"fc_0ebae1da2419a5f8016acb73f90750819686797f4e2135f576":{"input_tokens":177,"cached_tokens":0,"cache_write_tokens":0,"output_tokens":0,"content":[{"input_tokens":177,"cached_tokens":0,"cache_write_tokens":0,"output_tokens":0}]},"fc_0ebae1da2419a5f8016acb73f9075081968ffc28bd9f92ecea":{"input_tokens":7