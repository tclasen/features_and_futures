",\"newText\":\" const filter=new URLSearchParams(location.search).get('filter')==='Archived'?'Archived':'Active';\\n const projects=await fetch('/api/projects?filter='+filter).then(r=>r.json());\\n app.innerHTML='<h1>Workboard</h1><label for=\\\"project-filter\\\">Project filter</label><select id=\\\"project-filter\\\"><option'+(filter==='Active'?' selected':'')+'>Active</option><option'+(filter==='Archived'?' selected':'')+'>Archived</option></select><form id=\\\"create-form\\\">\"},{\"oldText\":\"for(const project of projects){const row=document.createElement('div');row.className='row';row.dataset.testid='project-row';row.innerHTML='<span>'+escapeText(project.name)+'</span><button type=\\\"button\\\">Open project</button>';row.querySelector('button').onclick=()=>{history.pushState({},'', '/projects/'+project.id);render()};rows.append(row)}\",\"newText\":\"for(const project of projects){const row=document.createElement('div');row.className='row';row.dataset.testid='project-row';row.innerHTML='<span>'+escapeText(project.name)+' <span data-testid=\\\"project-summary\\\">'+project.completed_count+'/'+project.total_count+' completed</span></span><span><button type=\\\"button\\\" class=\\\"open\\\">Open project</button> <button type=\\\"button\\\" class=\\\"archive\\\">'+(project.archived?'Restore project':'Archive project')+'</button></span>';row.querySelector('.open').onclick=()=>{history.pushState({},'', '/projects/'+project.id);render()};row.querySelector('.archive').onclick=async()=>{await fetch('/api/projects/'+project.id+'/archive',{method:'PATCH',headers:{'Content-Type':'application/json'},body:JSON.stringify({archived:!project.archived})});render()};rows.append(row)}\\n document.getElementById('project-filter').onchange=e=>{history.pushState({},'','/?filter='+e.target.value);render()};\"},{\"oldText\":\"  if (req.method === 'GET' && url.pathname === '/api/projects') return send(200, JSON.stringify(listProjects.all()));\",\"newText\":\"  if (req.method === 'GET