ting IDs and tasks.\\n  const legacy = new DatabaseSync(databasePath);\\n  legacy.exec(`\\n    CREATE TABLE projects (id INTEGER PRIMARY KEY AUTOINCREMENT, name TEXT NOT NULL);\\n    CREATE TABLE tasks (id INTEGER PRIMARY KEY AUTOINCREMENT, project_id INTEGER NOT NULL\\n      REFERENCES projects(id), title TEXT NOT NULL, completed INTEGER NOT NULL DEFAULT 0);\\n    INSERT INTO projects (name) VALUES ('Existing');\\n    INSERT INTO tasks (project_id, title, completed) VALUES (1, 'Done', 1), (1, 'Pending', 0);\\n  `);\\n  legacy.close();\\n  let server;\\n  try {\\n    server = await startServer(databasePath);\\n    const get = async path => (await fetch(server.baseUrl + path)).text();\\n    let html = await get('/');\\n    assert.match(html, /<label for=\\\"project-filter\\\">Project filter<\\\\/label>/);\\n    assert.match(html, /<option selected>Active<\\\\/option><option>Archived<\\\\/option>/);\\n    assert.match(html, /data-testid=\\\"project-summary\\\">1\\\\/2 completed/);\\n    assert.match(html, />Archive project<\\\\/button>/);\\n    assert.doesNotMatch(html, />Restore project<\\\\/button>/);\\n    await create(server.baseUrl, 'New');\\n    assert.match(await get('/'), /data-testid=\\\"project-summary\\\">0\\\\/0 completed/);\\n    assert.equal((await post(server.baseUrl, '/projects/999/archive', {})).status, 404);\\n    assert.equal((await post(server.baseUrl, '/projects/1/archive', {})).status, 303);\\n    assert.doesNotMatch(await get('/'), /<span>Existing<\\\\/span>/);\\n    html = await get('/?filter=Archived');\\n    assert.match(html, /<span>Existing<\\\\/span>/);\\n    assert.doesNotMatch(html, /<span>New<\\\\/span>/);\\n    assert.match(html, />Open project<\\\\/button>/);\\n    assert.match(html, />Restore project<\\\\/button>/);\\n    assert.match(html, /data-testid=\\\"project-summary\\\">1\\\\/2 completed/);\\n    const archivedListing = html;\\n    html = await get('/projects/1');\\n    assert.match(html, /Archived project/);\\n    assert.match(html, /<button type=\\\"submit\\\" disabled>Create task/);\\n    assert.equal((html.match(/type=\\\"checkbox\\\"[^>]* disabled/g) || []).length, 2);\\n    assert.match(html, /aria-label=\\\"Complete Done\\\" checked disabled/);\\n    for (const filter of ['Open', 'Completed']) {\\n      assert.equal(((await get(`/projects/1?filter=${filter}`)).match(/data-testid=\\\"task-row\\\"/g) || []).length, 1);\\n    }\\n    assert.equal((await post(server.baseUrl, '/projects/1/tasks', { title: 'Blocked' })).status, 403);\\n    assert.equal((await post(server.baseUrl, '/projects/1/tasks/1', {})).status, 403);\\n    await server.stop();\\n    server = undefined;\\n    server = await startServer(databasePath);\\n    assert.equal(await get('/?filter=Archived'), archivedListing);\\n    assert.equal(await get('/projects/1'), html);\\n    assert.equal((await post(server.baseUrl, '/projects/1/restore', {})).status, 303);\\n    assert.doesNotMatch(await get('/?filter=Archived'), /data-testid=\\\"project-row\\\"/);\\n    assert.match(await get('/'), /data-testid=\\\"project-summary\\\">1\\\\/2 completed/);\\n    assert.doesNotMatch(await get('/projects/1'), / disabled|Archived project/);\\n    await post(server.baseUrl, '/projects/1/tasks/2', { completed: '1' });\\n    assert.match(await get('/'), /data-testid=\\\"project-summary\\\">2\\\\/2 completed/);\\n    await post(server.baseUrl, '/projects/1/tasks', { title: 'Another' });\\n    assert.match(await get('/'), /data-testid=\\\"project-summary\\\">2\\\\/3 completed/);\\n    const restoredListing = await get('/');\\n    const restoredPage = await get('/projects/1');\\n    await server.stop();\\n    server = undefined;\\n    server = await startServer(databasePath);\\n    assert.equal(await get('/'), restoredListing);\\n    assert.equal(await get('/projects/1'), restoredPage);\\n  } finally {\\n    if (server) await server.stop();\\n    await rm(directory, { recursive: true, force: true });\\n  }\\n});\"}]}","status":"completed"}],"error":null,"incomplete_details":null,"tools":[{"type":"function","name":"read","description":"Read the contents of a file. Supports text files and images (jpg, png, gif, webp, bmp). Images are sent as attachments. For text files, output is truncated to 2000 lines or 50KB (whichever is hit first). Use offset/limit for large files. When you need the full file, continue with offset until complete.","parameters":{"type":"object","required":["path","offset","limit"],"properties":{"path":{"type":"string","description":"Path to the file to read (relative or absolute)"},"offset":{"anyOf":[{"type":"number","description":"Line number to start reading from (1-indexed)"},{"type":"null"}]},"limit":{"anyOf":[{"type":"number","description":"Maximum number of lines to read"},{"type":"null"}]}},"additionalProperties":false},"output_schema":null,"strict":true},{"type":"function","name":"bash","description":"Execute a bash command in the current working directory. Returns stdout and stderr. Output is truncated to last 2000 lines or 50KB (whichever is hit first). If truncated, full output is saved to a temp file. Optionally provide a timeout in seconds.","parameters":{"type":"object","required":["command","timeout"],"properties":{"command":{"type":"string","description":"Shell command to execute"},"timeout":{"anyOf":[{"type":"number","description":"Timeout in seconds (optional, no default timeout)"},{"type":"null"}]}},"additionalProperties":false},"output_schema":null,"strict":true},{"type":"function","name":"edit","description":"Edit a single file using exact text replacement. Every edits[].oldText must match a unique, non-overlapping region of the original file. If two changes affect the same block or nearby lines, merge them into one edit instead of emitting overlapping edits. Do not include large unchanged regions just to connect distant changes.","parameters":{"type":"object","required":["path","edits"],"properties":{"path":{"type":"string","description":"Path to the file to edit (relative or absolute)"},"edits":{"type":"array","items":{"type":"object","required":["oldText","newText"],"properties":{"oldText":{"type":"string","description":"Exact text for one targeted replacement. It must be unique in the original file and must not overlap with any other edits[].oldText in the same call."},"newText":{"type":"string","description":"Replacement text for this targeted edit."}},"additionalProperties":false},"description":"One or more targeted replacements. Each edit is matched against the original file, not incrementally. Do not include overlapping or nested edits. If two changes touch the same block or nearby lines, merge them into one edit instead."}},"additionalProperties":false},"output_schema":null,"strict":true},{"type":"function","name":"write","description":"Write content to a file. Creates the file if it doesn't exist, overwrites if it does. Automatically creates parent directories.","parameters":{"type":"object","required":["path","content"],"properties":{"path":{"type":"string","description":"Path to the file to write (relative or absolute)"},"content":{"type":"string","description":"Content to write to the file"}},"additionalProperties":false},"output_schema":null,"strict":true}],"tool_choice":"auto","parallel_tool_calls":true,"prompt_cache_key":"5f4925ea-a685-4a34-9534-9adc9853db71","prompt_cache_retention":"24h","text":{"format":{"type":"text"},"verbosity":"low"},"top_p":0.98,"top_logprobs":0,"temperature":1.0,"reasoning":{"effort":"medium","summary":"detailed","context":"all_turns","mode":"standard"},"user":null,"usage":{"input_tokens":9097,"input_tokens_details":{"cached_tokens":2304,"cache_write_tokens":0},"output_tokens":1274,"output_tokens_details":{"reasoning_tokens":37},"total_tokens":10371,"attribution":{"items":{"fc_0f88ecb665aba853016acb73d312208195845bd5f958128754":{"input_tokens":38,"cached_tokens":0,"cache_write_tokens":0,"output_tokens":0},"fc_0f88ecb665aba853016acb73d7670c8195a756e75ae3259418":{"input_tokens":42,"cac