data: {"type":"response.function_call_arguments.done","sequence_number":712,"item_id":"fc_074635d3d954815a016acd1bd4786881979d1b573930acb6f4","output_index":0,"arguments":"{\"path\":\"server.js\",\"edits\":[{\"oldText\":\"const listProjects = db.prepare(`\",\"newText\":\"if (!db.prepare('PRAGMA table_info(tasks)').all().some(column => column.name === 'priority')) {\\n  db.exec(\\\"ALTER TABLE tasks ADD COLUMN priority TEXT NOT NULL DEFAULT 'Normal' CHECK (priority IN ('Low', 'Normal', 'High'))\\\");\\n}\\nconst priorities = ['Low', 'Normal', 'High'];\\nconst listProjects = db.prepare(`\"},{\"oldText\":\"SELECT id, title, completed FROM tasks WHERE\",\"newText\":\"SELECT id, title, completed, priority FROM tasks WHERE\"},{\"oldText\":\"const findTask = db.prepare\",\"newText\":\"const setTaskPriority = db.prepare('UPDATE tasks SET priority = ? WHERE id = ? AND project_id = ?');\\nconst findTask = db.prepare\"},{\"oldText\":\"        <form method=\\\"post\\\" action=\\\"/projects/${project.id}/tasks/${task.id}/rename\\\">\",\"newText\":\"        <form method=\\\"post\\\" action=\\\"/projects/${project.id}/tasks/${task.id}/priority\\\">\\n          <input type=\\\"hidden\\\" name=\\\"filter\\\" value=\\\"${filter}\\\">\\n          <label for=\\\"task-priority-${task.id}\\\">Task priority</label>\\n          <select id=\\\"task-priority-${task.id}\\\" name=\\\"priority\\\"${project.archived ? ' disabled' : ''} onchange=\\\"this.form.submit()\\\">\\n            ${priorities.map(value => `<option${value === task.priority ? ' selected' : ''}>${value}</option>`).join('')}\\n          </select>\\n        </form>\\n        <form method=\\\"post\\\" action=\\\"/projects/${project.id}/tasks/${task.id}/rename\\\">\"},{\"oldText\":\"    } else if (req.method === 'POST' && /^\\\\/projects\\\\/\\\\d+\\\\/tasks\\\\/\\\\d+\\\\/rename$/.test(path)) {\",\"newText\":\"    } else if (req.method === 'POST' && /^\\\\/projects\\\\/\\\\d+\\\\/tasks\\\\/\\\\d+\\\\/priority$/.test(path)) {\\n      const [, , projectId, , taskId] = path.split('/');\\n      const project = findProject.get(projectId);\\n      if (!project || !findTask.get(taskId, projectId)) {\\n        html(res, 404, page('Not found', '<h1>Task not found</h1>'));\\n        return;\\n      }\\n      const body = await formBody(req);\\n      const filter = validFilter(body.get('filter'));\\n      if (project.archived) {\\n        html(res, 403, projectPage(project, filter, 'Archived project is read-only'));\\n        return;\\n      }\\n      const priority = body.get('priority');\\n      if (!priorities.includes(priority)) {\\n        html(res, 422, projectPage(project, filter, 'Invalid task priority'));\\n        return;\\n      }\\n      setTaskPriority.run(priority, taskId, project.id);\\n      res.writeHead(303, { Location: `/projects/${project.id}?filter=${filter}` });\\n      res.end();\\n    } else if (req.method === 'POST' && /^\\\\/projects\\\\/\\\\d+\\\\/tasks\\\\/\\\\d+\\\\/rename$/.test(path)) {\"}] }"}

