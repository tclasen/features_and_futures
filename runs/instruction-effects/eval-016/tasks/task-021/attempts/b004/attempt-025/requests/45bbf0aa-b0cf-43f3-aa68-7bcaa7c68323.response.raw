data: {"type":"response.function_call_arguments.done","sequence_number":566,"item_id":"fc_031dc3031090ed56016acd5fb1c9ec81978bd1c1a74ca61704","output_index":0,"arguments":"{\"path\":\"public/app.js\",\"edits\":[{\"oldText\":\"    document.querySelector('#directory-priority-filter').value = 'All';\\n\",\"newText\":\"    document.querySelector('#directory-priority-filter').value = 'All';\\n    document.querySelector('#directory-order').value = 'Original';\\n\"},{\"oldText\":\"  const matching = [];\\n  for (const task of directoryRows) {\\n\",\"newText\":\"  const matching = [];\\n  for (const task of directoryRows) {\\n\"},{\"oldText\":\"    matching.push(task);\\n    const row = document.createElement('div'); row.dataset.testid = 'directory-task-row';\\n\",\"newText\":\"    matching.push(task);\\n  }\\n  const originalIndex = new Map(directoryRows.map((task, index) => [task.id, index]));\\n  const order = document.querySelector('#directory-order').value;\\n  if (order === 'Priority') {\\n    const rank = { High: 0, Normal: 1, Low: 2 };\\n    matching.sort((a, b) => rank[a.priority || 'Normal'] - rank[b.priority || 'Normal'] || originalIndex.get(a.id) - originalIndex.get(b.id));\\n  } else if (order === 'Due date') {\\n    matching.sort((a, b) => {\\n      if (!a.dueDate && b.dueDate) return 1;\\n      if (a.dueDate && !b.dueDate) return -1;\\n      return (a.dueDate || '').localeCompare(b.dueDate || '') || originalIndex.get(a.id) - originalIndex.get(b.id);\\n    });\\n  } else if (order === 'Title') {\\n    matching.sort((a, b) => {\\n      const left = a.title.replace(/[A-Z]/g, c => c.toLowerCase());\\n      const right = b.title.replace(/[A-Z]/g, c => c.toLowerCase());\\n      return (left < right ? -1 : left > right ? 1 : 0) || originalIndex.get(a.id) - originalIndex.get(b.id);\\n    });\\n  }\\n  for (const task of matching) {\\n    const row = document.createElement('div'); row.dataset.testid = 'directory-task-row';\\n\"} ,{\"oldText\":\"for (const id of ['directory-scope', 'directory-task-filter', 'directory-priority-filter'])\",\"newText\":\"for (const id of ['directory-scope', 'directory-task-filter', 'directory-priority-filter', 'directory-order'])\"}]}"}

