data: {"type":"response.function_call_arguments.done","sequence_number":553,"item_id":"fc_0982c8c70bb397ca016acd4da708c4819581417f919762bfb9","output_index":0,"arguments":"{\"path\":\"public/app.js\",\"edits\":[{\"oldText\":\"    document.querySelector('#directory-priority-filter').value = 'All';\\n    document.querySelector('#directory-search').value = '';\",\"newText\":\"    document.querySelector('#directory-priority-filter').value = 'All';\\n    document.querySelector('#directory-order').value = 'Original';\\n    document.querySelector('#directory-search').value = '';\"},\n{\"oldText\":\"  const matching = [];\\n  for (const task of directoryRows) {\",\"newText\":\"  const matching = [];\\n  for (const task of directoryRows) {\"},\n{\"oldText\":\"    matching.push(task);\\n    const row = document.createElement('div');\",\"newText\":\"    matching.push(task);\\n  }\\n  const originalIndex = new Map(directoryRows.map((task, index) => [task.id, index]));\\n  const order = document.querySelector('#directory-order').value;\\n  const rank = { High: 0, Normal: 1, Low: 2 };\\n  if (order === 'Priority') matching.sort((a, b) => rank[a.priority || 'Normal'] - rank[b.priority || 'Normal'] || originalIndex.get(a.id) - originalIndex.get(b.id));\\n  else if (order === 'Due date') matching.sort((a, b) => {\\n    if (!a.dueDate) return b.dueDate ? 1 : originalIndex.get(a.id) - originalIndex.get(b.id);\\n    if (!b.dueDate) return -1;\\n    return a.dueDate.localeCompare(b.dueDate) || originalIndex.get(a.id) - originalIndex.get(b.id);\\n  });\\n  else if (order === 'Title') matching.sort((a, b) => {\\n    const left = a.title.replace(/[A-Z]/g, c => c.toLowerCase()), right = b.title.replace(/[A-Z]/g, c => c.toLowerCase());\\n    return (left < right ? -1 : left > right ? 1 : 0) || originalIndex.get(a.id) - originalIndex.get(b.id);\\n  });\\n  for (const task of matching) {\\n    const row = document.createElement('div');\"},\n{\"oldText\":\"document.querySelector('#directory-scope').addEventListener('change', renderDirectory);\",\"newText\":\"document.querySelector('#directory-scope').addEventListener('change', renderDirectory);\\ndocument.querySelector('#directory-order').addEventListener('change', renderDirectory);\"}]}"}

