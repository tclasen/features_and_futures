gnore', 'pipe', 'pipe'] });\\n    base = await new Promise((resolve, reject) => {\\n      let output = '';\\n      child.on('error', reject);\\n      child.stdout.on('data', chunk => {\\n        output += chunk;\\n        const match = output.match(/listening on port (\\\\d+)/);\\n        if (match) resolve(`http://127.0.0.1:${match[1]}`);\\n      });\\n    });\\n  }\\n  async function stop() { const exit = once(child, 'exit'); child.kill('SIGTERM'); await exit; child = null; }\\n  const post = (path, body) => fetch(base + path, { method: 'POST', body: new URLSearchParams(body), redirect: 'manual' });\\n  const get = async path => (await fetch(base + path)).text();\\n  const titles = html => [...html.matchAll(/data-testid=\\\"directory-task-title\\\"[^>]*>(.*?)<\\\\/span>/gs)].map(match => match[1]);\\n  const snapshot = () => {\\n    const db = new DatabaseSync(dbPath);\\n    try { return ['projects', 'tasks', 'task_positions'].map(table => db.prepare(`SELECT * FROM ${table} ORDER BY rowid`).all().map(row => ({ ...row }))); }\\n    finally { db.close(); }\\n  };\\n  const task = (title, priority, dueDate, deleted = false) => ({ title, priority, dueDate, completed: false, notes: '  literal\\\\nnotes  ', deleted });\\n  async function imported(name, archived, tasks) {\\n    await post('/projects/import', { name, json: JSON.stringify({ format: 'workboard-project', version: 1, project: { name, archived, defaultPriority: 'Normal', tasks } }) });\\n  }\\n  try {\\n    await start();\\n    await imported('First', false, [task('Zulu', 'Low', ''), task('alpha', 'High', '2024-03-01'), task('ALPHA', 'Normal', '2024-02-29'), task('a  b', 'Normal', ''), task('a b', 'High', '2024-02-29')]);\\n    await imported('Second', false, [task('Alpha', 'High', '2024-02-29'), task('\\\\u{10000}', 'Low', ''), task('\\\\uE000', 'Low', '')]);\\n    await imported('Archived', true, [task('z archived', 'Low', ''), task('a archived', 'High', '0001-01-01'), task('z deleted', 'Normal', '', true), task('a deleted', 'High', '9999-12-31', true)]);\\n    const before = snapshot();\\n    const original = ['Zulu', 'alpha', 'ALPHA', 'a  b', 'a b', 'Alpha', '\\\\u{10000}', '\\\\uE000'];\\n    const priority = ['alpha', 'a b', 'Alpha', 'ALPHA', 'a  b', 'Zulu', '\\\\u{10000}', '\\\\uE000'];\\n    const due = ['ALPHA', 'a b', 'Alpha', 'alpha', 'Zulu', 'a  b', '\\\\u{10000}', '\\\\uE000'];\\n    const title = ['a  b', 'a b', 'alpha', 'ALPHA', 'Alpha', 'Zulu', '\\\\uE000', '\\\\u{10000}'];\\n    for (const [order, expected] of [['Original', original], ['Priority', priority], ['Due date', due], ['Title', title]]) {\\n      const html = await get('/directory?' + new URLSearchParams({ order }));\\n      assert.deepEqual(titles(html), expected);\\n      assert.match(html, new RegExp(`<option selected>${order}</option>`));\\n      // Every GET/POST directory form carries the order through navigation.\\n      for (const form of html.matchAll(/<form[^>]*action=\\\"\\\\/directory[^\\\\\\\"]*\\\"[^>]*>(.*?)<\\\\/form>/gs)) {\\n        assert.match(form[1], /name=\\\"order\\\"/);\\n      }\\n    }\\n    assert.deepEqual(titles(await get('/directory?scope=Archived&order=Title')), ['a archived', 'z archived']);\\n    assert.deepEqual(titles(await get('/directory?scope=Archived&filter=Deleted&order=Priority')), ['a deleted', 'z deleted']);\\n    const fields = { scope: 'Active', filter: 'Open', priorityFilter: 'High', dueFrom: '2024-02-29', dueThrough: '2024-03-01', search: 'alpha', order: 'Due date' };\\n    assert.deepEqual(titles(await get('/directory?' + new URLSearchParams(fields))), ['Alpha', 'alpha']);\\n    const invalid = await get('/directory/due-range?' + new URLSearchParams({ ...fields, dueFrom: '2024-02-30', appliedFrom: fields.dueFrom, appliedThrough: fields.dueThrough }));\\n    assert.match(invalid, /Due range must use valid/);\\n    assert.match(invalid, /<option selected>Due date<\\\\/option>/);\\n    assert.deepEqual(titles(invalid), ['Alpha', 'alpha']);\\n    assert.deepEqual(snapshot(), before);\\n    // Export remains in original stored order regardless of directory ordering.\\n    const exported = await (await fetch(base + '/projects/1/download')).json();\\n    assert.deepEqual(exported.project.tasks.map(task => task.title), original.slice(0, 5));\\n    const response = await post('/directory/complete', fields);\\n    const location = response.headers.get('location');\\n    const params = new URL(location, base).searchParams;\\n    for (const [key, value] of Object.entries(fields)) assert.equal(params.get(key), value);\\n    const empty = await get(location);\\n    assert.match(empty, /No matching tasks/);\\n    assert.match(empty, /<option selected>Due date<\\\\/option>/);\\n    assert.deepEqual(titles(await get('/directory?' + new URLSearchParams({ ...fields, filter: 'Completed' }))), ['Alpha', 'alpha']);\\n    const after = snapshot();\\n    const expected = structuredClone(before);\\n    expected[1][1].completed = 1;\\n    expected[1][5].completed = 1;\\n    assert.deepEqual(after, expected);\\n    await stop();\\n    await start();\\n    assert.deepEqual(snapshot(), after);\\n    assert.deepEqual(titles(await get('/directory')), original);\\n    assert.match(await get('/directory'), /<option selected>Original<\\\\/option>/);\\n    assert.deepEqual(titles(await get('/directory?order=Title')), title);\\n    // Moves and returns still use remembered original positions.\\n    await post('/projects/1/tasks/2/move', { destination: '2' });\\n    await post('/projects/2/tasks/2/move', { destination: '1' });\\n    assert.deepEqual(snapshot()[1], after[1]);\\n    assert.deepEqual(titles(await get('/directory')), original);\\n  } finally {\\n    if (child) await stop();\\n    await rm(directory, { recursive: true, force: true });\\n  }\\n});\\n\"}","status":"completed"}],"error":null,"incomplete_details":null,"tools":[{"type":"function","name":"read","description":"Read the contents of a file. Supports text files and images (jpg, png, gif, webp, bmp). Images are sent as attachments. For text files, output is truncated to 2000 lines or 50KB (whichever is hit first). Use offset/limit for large files. When you need the full file, continue with offset until complete.","parameters":{"type":"object","required":["path","offset","limit"],"properties":{"path":{"type":"string","description":"Path to the file to read (relative or absolute)"},"offset":{"anyOf":[{"type":"number","description":"Line number to start reading from (1-indexed)"},{"type":"null"}]},"limit":{"anyOf":[{"type":"number","description":"Maximum number of lines to read"},{"type":"null"}]}},"additionalProperties":false},"output_schema":null,"strict":true},{"type":"function","name":"bash","description":"Execute a bash command in the current working directory. Returns stdout and stderr. Output is truncated to last 2000 lines or 50KB (whichever is hit first). If truncated, full output is saved to a temp file. Optionally provide a timeout in seconds.","parameters":{"type":"object","required":["command","timeout"],"properties":{"command":{"type":"string","description":"Shell command to execute"},"timeout":{"anyOf":[{"type":"number","description":"Timeout in seconds (optional, no default timeout)"},{"type":"null"}]}},"additionalProperties":false},"output_schema":null,"strict":true},{"type":"function","name":"edit","description":"Edit a single file using exact text replacement. Every edits[].oldText must match a unique, non-overlapping region of the original file. If two changes affect the same block or nearby lines, merge them into one edit instead of emitting overlapping edits. Do not include large unchanged regions just to connect distant changes.","parameters":{"type":"object","required":["path","edits"],"properties":{"path":{"type":"string","description":"Path to the file to edit (relative or absolute)"},"edits":{"type":"array","items":{"type":"object","required":["oldText","newText"],"properties":{"oldText":{"type":"string","description":"Exact text for one targeted replacement. It must be unique in the original file and must not overlap with any other edits[].oldText in the same call."},"newText":{"type":"string","description":"Replacement text for this targeted edit."}},"additionalProperties":false},"description":"One or more targeted replacements. Each edit is matched against the original file, not incrementally. Do not include overlapping or nested edits. If two changes touch the same block or nearby lines, merge them into one edit instead."}},"additionalProperties":false},"output_schema":null,"strict":true},{"type":"function","name":"write","description":"Write content to a file. Creates the file if it doesn't exist, overwrites if it does. Automatically creates parent directories.","parameters":{"type":"object","required":["path","content"],"properties":{"path":{"type":"string","description":"Path to the file to write (relative or absolute)"},"content":{"type":"string","description":"Content to write to the file"}},"additionalProperties":false},"output_schema":null,"strict":true}],"tool_choice":"auto","parallel_tool_calls":true,"prompt_cache_key":"d995ea81-231c-48a6-9fa4-83db73d5984b","prompt_cache_retention":"24h","text":{"format":{"type":"text"},"verbosity":"low"},"top_p":0.98,"top_logprobs":0,"temperature":1.0,"reasoning":{"effort":"medium","summary":"detailed","context":"all_turns","mode":"standard"},"user":null,"usage":{"input_tokens":23457,"input_tokens_details":{"cached_tokens":0,"cache_write_tokens":0},"output_tokens":1885,"output_tokens_details":{"reasoning_tokens":14},"total_tokens":25342,"attribution":{"items":{"fc_02c011122b5b5630016acd3adb9f308193870eb3967886a833":{"input_tokens":34,"cached_tokens":0,"cache_write_tokens":0,"output_tokens":0},"fc_02c011122b5b5630016acd3ade9bec8193bc16834287ef9d4c":{"input_tokens":28,"cached_tokens":0,"cache_write_tokens":0,"output_tokens":0},"fc_02c011122b5b5630016acd3ae0deb081938002310927f86f2b":{"input_tokens":29,"cached_tokens":0,"cache_writ