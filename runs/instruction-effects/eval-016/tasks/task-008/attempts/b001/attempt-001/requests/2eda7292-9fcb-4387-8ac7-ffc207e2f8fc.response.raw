data: {"type":"response.function_call_arguments.done","sequence_number":908,"item_id":"fc_0f4e7e280b13e58d016acd1daecdd88195a10c4475b20ea0f4","output_index":2,"arguments":"{\"path\":\"server.js\",\"edits\":[{\"oldText\":\"// Existing tasks receive the same default as new tasks.\",\"newText\":\"// Existing projects start with Normal without changing their existing tasks.\\nif (!db.prepare('PRAGMA table_info(projects)').all().some((column) => column.name === 'default_priority')) {\\n  db.exec(\\\"ALTER TABLE projects ADD COLUMN default_priority TEXT NOT NULL DEFAULT 'Normal' CHECK (default_priority IN ('Low', 'Normal', 'High'))\\\");\\n}\\n// Existing tasks retain their original Normal priority on migration.\"},{\"oldText\":\"const getProject = db.prepare('SELECT id, name, archived FROM projects WHERE id = ?');\",\"newText\":\"const getProject = db.prepare('SELECT id, name, archived, default_priority FROM projects WHERE id = ?');\\nconst setDefaultPriority = db.prepare('UPDATE projects SET default_priority = ? WHERE id = ?');\"},{\"oldText\":\"const createTask = db.prepare('INSERT INTO tasks (project_id, title) VALUES (?, ?)');\",\"newText\":\"const createTask = db.prepare('INSERT INTO tasks (project_id, title, priority) VALUES (?, ?, ?)');\"},{\"oldText\":\"    <form class=\\\"create task-create\\\" method=\\\"post\\\" action=\\\"/projects/${project.id}/tasks\\\">\",\"newText\":\"    <form class=\\\"filter\\\" method=\\\"post\\\" action=\\\"/projects/${project.id}/default-priority\\\">\\n      ${filterFields}\\n      <label for=\\\"default-task-priority\\\">Default task priority</label>\\n      <select id=\\\"default-task-priority\\\" name=\\\"priority\\\"${project.archived ? ' disabled' : ''} onchange=\\\"this.form.requestSubmit()\\\">\\n        ${priorities.map((option) => `<option${project.default_priority === option ? ' selected' : ''}>${option}</option>`).join('')}\\n      </select>\\n    </form>\\n    <form class=\\\"create task-create\\\" method=\\\"post\\\" action=\\\"/projects/${project.id}/tasks\\\">\"},{\"oldText\":\"    } else if (request.method === 'POST' && /^\\\\/projects\\\\/[1-9]\\\\d*\\\\/rename$/.test(url.pathname)) {\",\"newText\":\"    } else if (request.method === 'POST' && /^\\\\/projects\\\\/[1-9]\\\\d*\\\\/default-priority$/.test(url.pathname)) {\\n      const project = getProject.get(url.pathname.split('/')[2]);\\n      if (!project) {\\n        html(response, 404, page('Not found', '<h1>Project not found</h1>'));\\n        return;\\n      }\\n      const form = await readForm(request);\\n      const filter = taskFilter(form.get('filter'));\\n      const priority = priorityFilter(form.get('priorityFilter'));\\n      if (project.archived) {\\n        html(response, 403, projectPage(project, filter, 'Archived projects cannot be changed', priority));\\n        return;\\n      }\\n      const defaultPriority = form.get('priority');\\n      if (!priorities.includes(defaultPriority)) {\\n        html(response, 400, projectPage(project, filter, 'Invalid task priority', priority));\\n        return;\\n      }\\n      setDefaultPriority.run(defaultPriority, project.id);\\n      response.writeHead(303, { Location: projectLocation(project.id, filter, priority) });\\n      response.end();\\n    } else if (request.method === 'POST' && /^\\\\/projects\\\\/[1-9]\\\\d*\\\\/rename$/.test(url.pathname)) {\"},{\"oldText\":\"createTask.run(projectId, title);\",\"newText\":\"createTask.run(projectId, title, project.default_priority);\"}]}"}

