\\\">/g)].map(match => [match[1], match[2]]));\\n}\\n\\ntest('search intersects filters and survives edits, movement, archive, and restart without changing data', async () => {\\n  const directory = await mkdtemp(join(tmpdir(), 'workboard-search-'));\\n  let child, base;\\n  async function start() {\\n    child = spawn(process.execPath, ['server.js'], { env: { ...process.env, PORT: '0', DB_PATH: join(directory, 'db.sqlite') }, stdio: ['ignore', 'pipe', 'pipe'] });\\n    base = await new Promise((resolve, reject) => {\\n      let output = '';\\n      child.on('error', reject);\\n      child.stdout.on('data', chunk => {\\n        output += chunk;\\n        const match = output.match(/listening on port (\\\\d+)/);\\n        if (match) resolve(`http://127.0.0.1:${match[1]}`);\\n      });\\n    });\\n  }\\n  async function stop() { const exit = once(child, 'exit'); child.kill('SIGTERM'); await exit; child = null; }\\n  const get = async path => (await fetch(base + path)).text();\\n  const post = (path, body = {}) => fetch(base + path, { method: 'POST', body: new URLSearchParams(body), redirect: 'manual' });\\n  try {\\n    await start();\\n    for (const name of ['Alpha  Space', 'ALPHA Space', 'Other', 'Ä']) await post('/projects', { name });\\n    assert.deepEqual(rows(await get('/?search=+alpha+'), 'project'), ['Alpha  Space', 'ALPHA Space']);\\n    assert.deepEqual(rows(await get('/?search=alpha++space'), 'project'), ['Alpha  Space']);\\n    assert.deepEqual(rows(await get('/?search=%C3%A4'), 'project'), []);\\n    let html = await get('/?search=alpha');\\n    let response = await post('/projects/1/archive', fields(html, '/projects/1/archive'));\\n    assert.deepEqual(rows(await get(response.headers.get('location')), 'project'), ['ALPHA Space']);\\n    html = await get('/?filter=Archived&search=alpha');\\n    assert.deepEqual(rows(html, 'project'), ['Alpha  Space']);\\n    assert.equal(fields(html, '/').get('search'), 'alpha');\\n    await post('/projects/1/restore', fields(html, '/projects/1/restore'));\\n    for (const title of ['Find First', 'FIND Second', 'Find  Third', 'Other']) await post('/projects/1/tasks', { title });\\n    for (const id of [1, 2, 3]) {\\n      await post(`/projects/1/tasks/${id}/priority`, { priority: 'High' });\\n      await post(`/projects/1/tasks/${id}/due-date`, { dueDate: '2024-02-29' });\\n    }\\n    await post('/projects/1/tasks/2', { completed: '1' });\\n    const location = '/projects/1?filter=Open&priorityFilter=High&dueFrom=2024-02-01&dueThrough=2024-03-01&search=find';\\n    html = await get(location);\\n    assert.deepEqual(rows(html, 'task'), ['Find First', 'Find  Third']);\\n    assert.deepEqual(rows(await get('/projects/1?search=find++third'), 'task'), ['Find  Third']);\\n    for (const [action, extra] of [\\n      ['/projects/1/rename', { name: 'Renamed' }],\\n      ['/projects/1/default-priority', { priority: 'Low' }],\\n      ['/projects/1/tasks', { title: 'Find Undated' }],\\n      ['/projects/1/tasks/1/rename', { title: 'Still FIND First' }]\\n    ]) {\\n      const params = fields(html, action);\\n      for (const [key, value] of Object.entries(extra)) params.set(key, value);\\n      response = await post(action, params);\\n      assert.equal(response.headers.get('location'), location);\\n      html = await get(location);\\n    }\\n    assert.deepEqual(rows(html, 'task'), ['Still FIND First', 'Find  Third']);\\n    const range = fields(html, '/projects/1/due-range');\\n    range.set('dueFrom', '2024-02-30');\\n    response = await fetch(base + '/projects/1/due-range?' + range);\\n    html = await response.text();\\n    assert.equal(response.status, 422);\\n    assert.deepEqual(rows(html, 'task'), ['Still FIND First', 'Find  Third']);\\n    assert.equal(fields(html, '/projects/1/tasks/1/move').get('search'), 'find');\\n    const move = fields(html, '/projects/1/tasks/1/move');\\n    move.set('destination', '2');\\n    response = await post('/projects/1/tasks/1/move', move);\\n    assert.equal(response.headers.get('location'), location);\\n    assert.deepEqual(rows(await get(location), 'task'), ['Find  Third']);\\n    await post('/projects/2/tasks/1/move', { destination: '1' });\\n    assert.deepEqual(rows(await get(location), 'task'), ['Still FIND First', 'Find  Third']);\\n    html = await get(location);\\n    const rename = fields(html, '/projects/1/tasks/1/rename');\\n    rename.set('title', 'No match');\\n    response = await post('/projects/1/tasks/1/rename', rename);\\n    assert.equal(response.headers.get('location'), location);\\n    assert.deepEqual(rows(await get(location), 'task'), ['Find  Third']);\\n    await post('/projects/1/archive');\\n    html = await get(location);\\n    assert.deepEqual(rows(html, 'task'), ['Find  Third']);\\n    assert.ok(html.includes('Search tasks'));\\n    assert.ok(html.includes('name=\\\"priority\\\" disabled'));\\n    await stop(); await start();\\n    assert.deepEqual(rows(await get(location), 'task'), ['Find  Third']);\\n    await post('/projects/1/restore');\\n    html = await get('/projects/1');\\n    assert.deepEqual(rows(html, 'task'), ['No match', 'FIND Second', 'Find  Third', 'Other', 'Find Undated']);\\n    assert.ok(html.includes('id=\\\"task-search\\\" name=\\\"search\\\" type=\\\"text\\\" value=\\\"\\\"'));\\n    assert.ok((await get('/')).includes('1/5 completed'));\\n    assert.deepEqual(await (await fetch(base + '/health')).json(), { status: 'ok' });\\n  } finally {\\n    if (child) await stop();\\n    await rm(directory, { recursive: true, force: true });\\n  }\\n});\\n\"}","status":"completed"}],"error":null,"incomplete_details":null,"tools":[{"type":"function","name":"read","description":"Read the contents of a file. Supports text files and images (jpg, png, gif, webp, bmp). Images are sent as attachments. For text files, output is truncated to 2000 lines or 50KB (whichever is hit first). Use offset/limit for large files. When you need the full file, continue with offset until complete.","parameters":{"type":"object","required":["path","offset","limit"],"properties":{"path":{"type":"string","description":"Path to the file to read (relative or absolute)"},"offset":{"anyOf":[{"type":"number","description":"Line number to start reading from (1-indexed)"},{"type":"null"}]},"limit":{"anyOf":[{"type":"number","description":"Maximum number of lines to read"},{"type":"null"}]}},"additionalProperties":false},"output_schema":null,"strict":true},{"type":"function","name":"bash","description":"Execute a bash command in the current working directory. Returns stdout and stderr. Output is truncated to last 2000 lines or 50KB (whichever is hit first). If truncated, full output is saved to a temp file. Optionally provide a timeout in seconds.","parameters":{"type":"object","required":["command","timeout"],"properties":{"command":{"type":"string","description":"Shell command to execute"},"timeout":{"anyOf":[{"type":"number","description":"Timeout in seconds (optional, no default timeout)"},{"type":"null"}]}},"additionalProperties":false},"output_schema":null,"strict":true},{"type":"function","name":"edit","description":"Edit a single file using exact text replacement. Every edits[].oldText must match a unique, non-overlapping region of the original file. If two changes affect the same block or nearby lines, merge them into one edit instead of emitting overlapping edits. Do not include large unchanged regions just to connect distant changes.","parameters":{"type":"object","required":["path","edits"],"properties":{"path":{"type":"string","description":"Path to the file to edit (relative or absolute)"},"edits":{"type":"array","items":{"type":"object","required":["oldText","newText"],"properties":{"oldText":{"type":"string","description":"Exact text for one targeted replacement. It must be unique in the original file and must not overlap with any other edits[].oldText in the same call."},"newText":{"type":"string","description":"Replacement text for this targeted edit."}},"additionalProperties":false},"description":"One or more targeted replacements. Each edit is matched against the original file, not incrementally. Do not include overlapping or nested edits. If two changes touch the same block or nearby lines, merge them into one edit instead."}},"additionalProperties":false},"output_schema":null,"strict":true},{"type":"function","name":"write","description":"Write content to a file. Creates the file if it doesn't exist, overwrites if it does. Automatically creates parent directories.","parameters":{"type":"object","required":["path","content"],"properties":{"path":{"type":"string","description":"Path to the file to write (relative or absolute)"},"content":{"type":"string","description":"Content to write to the file"}},"additionalProperties":false},"output_schema":null,"strict":true}],"tool_choice":"auto","parallel_tool_calls":true,"prompt_cache_key":"4ecf81cb-9b01-476d-8bcb-ee7e221255e5","prompt_cache_retention":"24h","text":{"format":{"type":"text"},"verbosity":"low"},"top_p":0.98,"top_logprobs":0,"temperature":1.0,"reasoning":{"effort":"medium","summary":"detailed","context":"all_turns","mode":"standard"},"user":null,"usage":{"input_tokens":16525,"input_tokens_details":{"cached_tokens":0,"cache_write_tokens":0},"output_tokens":1834,"output_tokens_details":{"reasoning_tokens":10},"total_tokens":18359,"attribution":{"items":{"fc_0fb23dbbdc7e6145016acd233de7cc8190baeb48a35283c325":{"input_tokens":38,"cached_tokens":0,"cache_write_tokens":0,"output_tokens":0},"fc_0fb23dbbdc7e6145016acd234149bc8190b9d56ff9f72d71fa":{"input_tokens":28,"cached_tokens":0,"cache_write_tokens":0,"output_tokens":0},"fc_0fb23dbbdc7e6145016acd2347f62081909ab39908fbfb7930":{"input_tokens":28,"cached_tokens":0,"cache_write_tokens":0,"output_tokens":0},"fc_0fb23dbbdc7e6145016acd234c83d08190bd861b14816b853e":{"input_tokens":33,"cached_tokens":0,"cache_write_tokens":0,"output_tokens":0},"fc_0fb23dbbdc7e6145016acd234f71bc8190804920ce238d03c3":{"input_toke