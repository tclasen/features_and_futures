abel for=\\\"project-search\\\">Project search</label>\\n      <input id=\\\"project-search\\\" name=\\\"search\\\" type=\\\"text\\\" value=\\\"${escapeHtml(query)}\\\">\\n      <button type=\\\"submit\\\">Search projects</button>\\n    </form>\\n    ${projects.length ? projects.map(project => `\"},{\"oldText\":\"        <form method=\\\"post\\\" action=\\\"/projects/${project.id}/${project.archived ? 'restore' : 'archive'}\\\">\\n          <button\",\"newText\":\"        <form method=\\\"post\\\" action=\\\"/projects/${project.id}/${project.archived ? 'restore' : 'archive'}\\\">\\n          ${searchField(query)}\\n          <button\"},{\"oldText\":\"function renderProjectPage(project, filter = 'All', error = '', priorityFilter = 'All', range = emptyRange, draft = range) {\\n  const rangeFields = `\",\"newText\":\"function renderProjectPage(project, filter = 'All', error = '', priorityFilter = 'All', range = emptyRange, draft = range, query = '') {\\n  const rangeFields = `${searchField(query)}\"},{\"oldText\":\"  const tasks = listTasks.all(project.id).filter(task =>\\n    (filter\",\"newText\":\"  const tasks = listTasks.all(project.id).filter(task =>\\n    matchesSearch(task.title, query) &&\\n    (filter\"},{\"oldText\":\"    <form method=\\\"get\\\" action=\\\"/projects/${project.id}/due-range\\\">\\n      <input\",\"newText\":\"    <form method=\\\"get\\\" action=\\\"/projects/${project.id}\\\">\\n      <input type=\\\"hidden\\\" name=\\\"filter\\\" value=\\\"${filter}\\\">\\n      <input type=\\\"hidden\\\" name=\\\"priorityFilter\\\" value=\\\"${priorityFilter}\\\">\\n      <input type=\\\"hidden\\\" name=\\\"dueFrom\\\" value=\\\"${escapeHtml(range.from)}\\\">\\n      <input type=\\\"hidden\\\" name=\\\"dueThrough\\\" value=\\\"${escapeHtml(range.through)}\\\">\\n      <label for=\\\"task-search\\\">Task search</label>\\n      <input id=\\\"task-search\\\" name=\\\"search\\\" type=\\\"text\\\" value=\\\"${escapeHtml(query)}\\\">\\n      <button type=\\\"submit\\\">Search tasks</button>\\n    </form>\\n    <form method=\\\"get\\\" action=\\\"/projects/${project.id}/due-range\\\">\\n      ${searchField(query)}\\n      <input\"},{\"oldText\":\"    let appliedRange = readRange(url.searchParams);\",\"newText\":\"    let appliedRange = readRange(url.searchParams);\\n    let appliedQuery = searchQuery(url.searchParams);\"},{\"oldText\":\"      appliedRange = readRange(body);\",\"newText\":\"      appliedRange = readRange(body);\\n      appliedQuery = searchQuery(body);\"},{\"oldText\":\"      renderProjectPage(project, filter, error, priorityFilter, range, draft);\",\"newText\":\"      renderProjectPage(project, filter, error, priorityFilter, range, draft, appliedQuery);\"},{\"oldText\":\"      buildProjectLocation(id, filter, priorityFilter, range);\",\"newText\":\"      buildProjectLocation(id, filter, priorityFilter, range, appliedQuery);\"},{\"oldText\":\"projectsPage('', validProjectFilter(url.searchParams.get('filter')))\",\"newText\":\"projectsPage('', validProjectFilter(url.searchParams.get('filter')), appliedQuery)\"},{\"oldText\":\"projectsPage('Project name is required', validProjectFilter(body.get('filter')))\",\"newText\":\"projectsPage('Project name is required', validProjectFilter(body.get('filter')), appliedQuery)\"},{\"oldText\":\"res.writeHead(303, { Location: '/' });\",\"newText\":\"res.writeHead(303, { Location: projectsLocation(validProjectFilter(body.get('filter')), appliedQuery) });\"},{\"oldText\":\"      archiveProject.run(action === 'archive' ? 1 : 0, projectId);\\n      res.writeHead(303, { Location: action === 'archive' ? '/' : '/?filter=Archived' });\",\"newText\":\"      await formBody(req);\\n      archiveProject.run(action === 'archive' ? 1 : 0, projectId);\\n      res.writeHead(303, { Location: projectsLocation(action === 'archive' ? 'Active' : 'Archived', appliedQuery) });\"}]}","item_id":"fc_0fb23dbbdc7e6145016acd235213fc8190a205c61c5b2660cc","output_index":0,"sequence_number":1372}

