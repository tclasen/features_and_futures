ive' : 'Archived')), searchQuery(form))\"},\n{\"oldText\":\"projectPage(project, taskFilter(url.searchParams.get('filter')), '', priorityFilter(url.searchParams.get('priorityFilter')), appliedRange(url.searchParams))\",\"newText\":\"projectPage(project, taskFilter(url.searchParams.get('filter')), '', priorityFilter(url.searchParams.get('priorityFilter')), appliedRange(url.searchParams), undefined, searchQuery(url.searchParams))\"},\n{\"oldText\":\"projectPage(project, filter, error, priority, appliedRange(form), range)\",\"newText\":\"projectPage(project, filter, error, priority, appliedRange(form), range, searchQuery(form))\"},\n{\"oldText\":\"projectLocation(project.id, filter, priority, range)\",\"newText\":\"projectLocation(project.id, filter, priority, range, searchQuery(form))\"}]}"}

