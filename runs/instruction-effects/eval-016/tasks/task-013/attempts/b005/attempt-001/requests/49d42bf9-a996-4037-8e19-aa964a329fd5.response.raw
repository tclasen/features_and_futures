, range)}\",\"newText\":\"    <form action=\\\"${path}/rename\\\" method=\\\"post\\\">\\n      ${taskFilterFields(filter, priority, range, search)}\"},{\"oldText\":\"    <form action=\\\"${path}/default-priority\\\" method=\\\"post\\\">\\n      ${taskFilterFields(filter, priority, range)}\",\"newText\":\"    <form action=\\\"${path}/default-priority\\\" method=\\\"post\\\">\\n      ${taskFilterFields(filter, priority, range, search)}\"},{\"oldText\":\"    <form action=\\\"${path}/tasks\\\" method=\\\"post\\\">\\n      ${taskFilterFields(filter, priority, range)}\",\"newText\":\"    <form action=\\\"${path}/tasks\\\" method=\\\"post\\\">\\n      ${taskFilterFields(filter, priority, range, search)}\"},{\"oldText\":\"      ${taskFilterFields(filter, priority, range)}\\n      <label for=\\\"task-search\\\">\",\"newText\":\"      <input type=\\\"hidden\\\" name=\\\"filter\\\" value=\\\"${filter}\\\">\\n      <input type=\\\"hidden\\\" name=\\\"priorityFilter\\\" value=\\\"${priority}\\\">\\n      ${dueRangeFields(range)}\\n      <label for=\\\"task-search\\\">\"},{\"oldText\":\"      sendHtml(response, 200, projectList('', projectFilter(url.searchParams.get('filter'))));\",\"newText\":\"      sendHtml(response, 200, projectList('', projectFilter(url.searchParams.get('filter')), readSearch(url.searchParams)));\"},{\"oldText\":\"      const name = (form.get('name') || '').trim();\\n      if (!name) {\\n        sendHtml(response, 400, projectList('Project name is required'));\\n      } else {\\n        createProject.run(name);\\n        response.writeHead(303, { Location: '/' });\",\"newText\":\"      const name = (form.get('name') || '').trim();\\n      const filter = projectFilter(form.get('filter'));\\n      const search = readSearch(form);\\n      if (!name) {\\n        sendHtml(response, 400, projectList('Project name is required', filter, search));\\n      } else {\\n        createProject.run(name);\\n        response.writeHead(303, { Location: search || filter !== 'Active'\\n          ? `/?${new URLSearchParams({ filter, search })}` : '/' });\"},{\"oldText\":\"      updateProjectArchive.run(action === 'archive' ? 1 : 0, id);\\n      response.writeHead(303, { Location: action === 'archive' ? '/' : '/?filter=Archived' });\",\"newText\":\"      const search = readSearch(await readForm(request));\\n      updateProjectArchive.run(action === 'archive' ? 1 : 0, id);\\n      const location = action === 'archive' ? '/' : '/?filter=Archived';\\n      response.writeHead(303, { Location: search\\n        ? `${location}${location.includes('?') ? '&' : '?'}${new URLSearchParams({ search })}` : location });\"},{\"oldText\":\"          priorityFilter(url.searchParams.get('priorityFilter')), range, draftRange));\",\"newText\":\"          priorityFilter(url.searchParams.get('priorityFilter')), range, readSearch(url.searchParams), draftRange));\"}]}"}

