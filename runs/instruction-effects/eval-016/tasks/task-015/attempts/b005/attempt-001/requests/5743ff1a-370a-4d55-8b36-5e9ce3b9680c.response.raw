 new DatabaseSync(databasePath);\\n  legacy.exec(`\\n    CREATE TABLE projects (id INTEGER PRIMARY KEY, name TEXT NOT NULL);\\n    CREATE TABLE tasks (id INTEGER PRIMARY KEY, project_id INTEGER NOT NULL, title TEXT NOT NULL, completed INTEGER NOT NULL DEFAULT 0);\\n    INSERT INTO projects VALUES (1, 'Source'), (2, 'Destination');\\n    INSERT INTO tasks VALUES (1, 1, 'Original', 1);\\n  `);\\n  legacy.close();\\n  const readTask = () => {\\n    const db = new DatabaseSync(databasePath);\\n    try { return db.prepare('SELECT * FROM tasks WHERE id = 1').get(); }\\n    finally { db.close(); }\\n  };\\n  try {\\n    server = await startServer(databasePath);\\n    const get = async (path) => (await fetch(`${server.baseUrl}${path}`)).text();\\n    const original = readTask();\\n    assert.equal(original.notes, '');\\n    await post(server.baseUrl, '/projects/1/tasks', { title: 'Second' });\\n    await post(server.baseUrl, '/projects/1/tasks/1/priority', { priority: 'High' });\\n    await post(server.baseUrl, '/projects/1/tasks/1/due-date', { dueDate: '2026-03-05' });\\n    const before = readTask();\\n    const notes = '\\\\n  Unicode café 📝\\\\n<em>literal</em> & </textarea><script>alert(1)</script>\\\\n  ';\\n    const filters = { filter: 'Completed', priorityFilter: 'High', dueFrom: '2026-03-01', dueThrough: '2026-03-31', search: 'orig' };\\n    const saved = await post(server.baseUrl, '/projects/1/tasks/1/notes', { ...filters, notes });\\n    assert.equal(saved.status, 303);\\n    const location = saved.headers.get('location');\\n    assert.deepEqual(Object.fromEntries(new URL(location, server.baseUrl).searchParams), filters);\\n    assert.deepEqual(readTask(), { ...before, notes });\\n    let html = await get(location);\\n    assert.deepEqual(taskRows(html).map((row) => row.title), ['Original']);\\n    assert.match(html, /<label for=\\\"task-notes-1\\\">Task notes<\\\\/label>/);\\n    assert.match(html, /<textarea id=\\\"task-notes-1\\\" name=\\\"notes\\\" rows=\\\"4\\\">\\\\n\\\\n  Unicode café 📝/);\\n    assert.match(html, /&lt;\\\\/textarea&gt;&lt;script&gt;alert\\\\(1\\\\)&lt;\\\\/script&gt;/);\\n    assert.doesNotMatch(html, /<script>alert/);\\n    assert.deepEqual(taskRows(await get('/projects/1?search=Unicode')), []);\\n    assert.deepEqual(projectSummaries(await get('/')), ['1/2 completed', '0/0 completed']);\\n    assert.equal((await post(server.baseUrl, '/projects/2/tasks/1/notes', { notes: 'Wrong owner' })).status, 404);\\n    await post(server.baseUrl, '/projects/1/tasks/1/move', { destination: '2' });\\n    await post(server.baseUrl, '/projects/2/tasks/1/rename', { title: 'Renamed' });\\n    await post(server.baseUrl, '/projects/2/tasks/1/move', { destination: '1' });\\n    assert.equal(readTask().notes, notes);\\n    assert.deepEqual(taskRows(await get('/projects/1')).map((row) => row.title), ['Renamed', 'Second']);\\n    await post(server.baseUrl, '/projects/1/archive', {});\\n    html = await get('/projects/1');\\n    assert.match(html, /<textarea id=\\\"task-notes-1\\\" name=\\\"notes\\\" rows=\\\"4\\\" disabled>/);\\n    assert.match(html, /<button type=\\\"submit\\\" disabled>Save notes<\\\\/button>/);\\n    assert.equal((await post(server.baseUrl, '/projects/1/tasks/1/notes', { notes: 'Blocked' })).status, 409);\\n    assert.equal(readTask().notes, notes);\\n    await server.stop();\\n    server = undefined;\\n    server = await startServer(databasePath);\\n    assert.equal(readTask().notes, notes);\\n    assert.match(await get('/projects/1'), /Unicode café 📝/);\\n    await post(server.baseUrl, '/projects/1/restore', {});\\n    assert.doesNotMatch(await get('/projects/1'), / disabled/);\\n    await post(server.baseUrl, '/projects/1/tasks/1/notes', { notes: '   \\\\n\\\\t ' });\\n    assert.equal(readTask().notes, '   \\\\n\\\\t ');\\n    await post(server.baseUrl, '/projects/1/tasks/1/notes', { notes: '' });\\n    assert.equal(readTask().notes, '');\\n    await server.stop();\\n    server = undefined;\\n    server = await startServer(databasePath);\\n    assert.equal(readTask().notes, '');\\n    assert.equal(readTask().title, 'Renamed');\\n  } finally {\\n    if (server) await server.stop();\\n    await rm(directory, { recursive: true, force: true });\\n  }\\n});\\n\\ntest('project search uses trimmed ASCII-insensitive substrings and intersects archive filtering',\"}]}","status":"completed"}],"error":null,"incomplete_details":null,"tools":[{"type":"function","name":"read","description":"Read the contents of a file. Supports text files and images (jpg, png, gif, webp, bmp). Images are sent as attachments. For text files, output is truncated to 2000 lines or 50KB (whichever is hit first). Use offset/limit for large files. When you need the full file, continue with offset until complete.","parameters":{"type":"object","required":["path","offset","limit"],"properties":{"path":{"type":"string","description":"Path to the file to read (relative or absolute)"},"offset":{"anyOf":[{"type":"number","description":"Line number to start reading from (1-indexed)"},{"type":"null"}]},"limit":{"anyOf":[{"type":"number","description":"Maximum number of lines to read"},{"type":"null"}]}},"additionalProperties":false},"output_schema":null,"strict":true},{"type":"function","name":"bash","description":"Execute a bash command in the current working directory. Returns stdout and stderr. Output is truncated to last 2000 lines or 50KB (whichever is hit first). If truncated, full output is saved to a temp file. Optionally provide a timeout in seconds.","parameters":{"type":"object","required":["command","timeout"],"properties":{"command":{"type":"string","description":"Shell command to execute"},"timeout":{"anyOf":[{"type":"number","description":"Timeout in seconds (optional, no default timeout)"},{"type":"null"}]}},"additionalProperties":false},"output_schema":null,"strict":true},{"type":"function","name":"edit","description":"Edit a single file using exact text replacement. Every edits[].oldText must match a unique, non-overlapping region of the original file. If two changes affect the same block or nearby lines, merge them into one edit instead of emitting overlapping edits. Do not include large unchanged regions just to connect distant changes.","parameters":{"type":"object","required":["path","edits"],"properties":{"path":{"type":"string","description":"Path to the file to edit (relative or absolute)"},"edits":{"type":"array","items":{"type":"object","required":["oldText","newText"],"properties":{"oldText":{"type":"string","description":"Exact text for one targeted replacement. It must be unique in the original file and must not overlap with any other edits[].oldText in the same call."},"newText":{"type":"string","description":"Replacement text for this targeted edit."}},"additionalProperties":false},"description":"One or more targeted replacements. Each edit is matched against the original file, not incrementally. Do not include overlapping or nested edits. If two changes touch the same block or nearby lines, merge them into one edit instead."}},"additionalProperties":false},"output_schema":null,"strict":true},{"type":"function","name":"write","description":"Write content to a file. Creates the file if it doesn't exist, overwrites if it does. Automatically creates parent directories.","parameters":{"type":"object","required":["path","content"],"properties":{"path":{"type":"string","description":"Path to the file to write (relative or absolute)"},"content":{"type":"string","description":"Content to write to the file"}},"additionalProperties":false},"output_schema":null,"strict":true}],"tool_choice":"auto","parallel_tool_calls":true,"prompt_cache_key":"d90d65e0-3a59-459f-adb8-d0cd6033680b","prompt_cache_retention":"24h","text":{"format":{"type":"text"},"verbosity":"low"},"top_p":0.98,"top_logprobs":0,"temperature":1.0,"reasoning":{"effort":"medium","summary":"detailed","context":"all_turns","mode":"standard"},"user":null,"usage":{"input_tokens":17618,"