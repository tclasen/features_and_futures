t.js\",\"content\":\"import { test } from 'node:test';\\nimport assert from 'node:assert/strict';\\nimport { spawn } from 'node:child_process';\\nimport { once } from 'node:events';\\nimport { mkdtemp, rm } from 'node:fs/promises';\\nimport { tmpdir } from 'node:os';\\nimport { join } from 'node:path';\\nimport { DatabaseSync } from 'node:sqlite';\\n\\ntest('deleted tasks migrate live, retain fields and positions, intersect filters, and persist', async () => {\\n  const directory = await mkdtemp(join(tmpdir(), 'workboard-deletion-'));\\n  const dbPath = join(directory, 'db.sqlite');\\n  const seed = new DatabaseSync(dbPath);\\n  seed.exec(`CREATE TABLE projects (id INTEGER PRIMARY KEY AUTOINCREMENT, name TEXT NOT NULL);\\n    CREATE TABLE tasks (id INTEGER PRIMARY KEY AUTOINCREMENT, project_id INTEGER NOT NULL REFERENCES projects(id), title TEXT NOT NULL, completed INTEGER NOT NULL DEFAULT 0);\\n    INSERT INTO projects (name) VALUES ('Source'), ('Destination');\\n    INSERT INTO tasks (project_id, title, completed) VALUES (1, 'First', 1), (1, 'Second', 0);`);\\n  seed.close();\\n  let child, base;\\n  async function start() {\\n    child = spawn(process.execPath, ['server.js'], { env: { ...process.env, PORT: '0', DB_PATH: dbPath }, stdio: ['ignore', 'pipe', 'pipe'] });\\n    base = await new Promise((resolve, reject) => {\\n      let output = '';\\n      child.on('error', reject);\\n      child.stdout.on('data', chunk => {\\n        output += chunk;\\n        const match = output.match(/listening on port (\\\\d+)/);\\n        if (match) resolve(`http://127.0.0.1:${match[1]}`);\\n      });\\n    });\\n  }\\n  async function stop() { const exit = once(child, 'exit'); child.kill('SIGTERM'); await exit; child = null; }\\n  const get = async path => (await fetch(base + path)).text();\\n  const post = (path, body = {}) => fetch(base + path, { method: 'POST', body: new URLSearchParams(body), redirect: 'manual' });\\n  const snapshot = () => {\\n    const db = new DatabaseSync(dbPath);\\n    try { return db.prepare('SELECT * FROM tasks ORDER BY id').all().map(task => ({ ...task })); } finally { db.close(); }\\n  };\\n  const rows = html => (html.match(/data-testid=\\\"task-row\\\"/g) || []).length;\\n  try {\\n    await start();\\n    assert.ok(snapshot().every(task => task.deleted === 0));\\n    await post('/projects/1/tasks/1/priority', { priority: 'High' });\\n    await post('/projects/1/tasks/1/due-date', { dueDate: '0001-01-01' });\\n    await post('/projects/1/tasks/1/notes', { notes: '  saved\\\\n日本語 <b>literal</b>  ' });\\n    await post('/projects/1/tasks/1/move', { destination: '2' });\\n    await post('/projects/2/tasks/1/move', { destination: '1' });\\n    const before = snapshot();\\n    const filters = { filter: 'Completed', priorityFilter: 'High', dueFrom: '0001-01-01', dueThrough: '9999-12-31', search: 'first' };\\n    const response = await post('/projects/1/tasks/1/delete', filters);\\n    assert.equal(response.headers.get('location'), '/projects/1?filter=Completed&priorityFilter=High&dueFrom=0001-01-01&dueThrough=9999-12-31&search=first');\\n    assert.deepEqual(snapshot(), before.map(task => task.id === 1 ? { ...task, deleted: 1 } : task));\\n    assert.equal(rows(await get(response.headers.get('location'))), 0);\\n    assert.equal(rows(await get('/projects/1')), 1);\\n    assert.equal(rows(await get('/projects/1?filter=Completed')), 0);\\n    assert.ok((await get('/')).includes('0/1 completed'));\\n    let html = await get('/projects/1?filter=Deleted&priorityFilter=High&dueFrom=0001-01-01&search=FIRST');\\n    assert.equal(rows(html), 1);\\n    assert.ok(html.includes('<fieldset class=\\\"task-controls\\\" disabled>'));\\n    assert.ok(html.includes('>Restore task</button>'));\\n    assert.equal(rows(await get('/projects/1?filter=Deleted&priorityFilter=Low')), 0);\\n    assert.equal(rows(await get('/projects/1?filter=Deleted&dueFrom=0001-01-02')), 0);\\n    assert.equal(rows(await get('/projects/1?filter=Deleted&search=saved')), 0);\\n    for (const [action, body] of [['', { completed: '0' }], ['/rename', { title: 'changed' }], ['/priority', { priority: 'Low' }], ['/due-date', { dueDate: '' }], ['/notes', { notes: '' }], ['/move', { destination: '2' }]]) {\\n      assert.equal((await post(`/projects/1/tasks/1${action}`, body)).status, 403);\\n    }\\n    await post('/projects/1/tasks/2/delete');\\n    assert.ok((await get('/')).includes('0/0 completed'));\\n    await post('/projects/1/tasks', { title: 'Third' });\\n    await post('/projects/1/default-priority', { priority: 'Low' });\\n    await post('/projects/1/archive');\\n    html = await get('/projects/1?filter=Deleted');\\n    assert.equal(rows(html), 2);\\n    assert.ok(html.includes('disabled>Restore task</button>'));\\n    assert.equal((await post('/projects/1/tasks/1/restore')).status, 403);\\n    assert.equal((await post('/projects/1/tasks/3/delete')).status, 403);\\n    await stop(); await start();\\n    assert.equal(snapshot()[0].deleted, 1);\\n    await post('/projects/1/restore');\\n    const restored = await post('/projects/1/tasks/1/restore', { ...filters, filter: 'Deleted' });\\n    assert.ok(restored.headers.get('location').includes('filter=Deleted'));\\n    assert.equal(rows(await get(restored.headers.get('location'))), 0);\\n    await post('/projects/1/tasks/2/restore');\\n    assert.deepEqual(snapshot().slice(0, 2), before);\\n    html = await get('/projects/1');\\n    assert.ok(html.indexOf('<span>First</span>') < html.indexOf('<span>Second</span>'));\\n    assert.ok(html.indexOf('<span>Second</span>') < html.indexOf('<span>Third</span>'));\\n    assert.ok((await get('/')).includes('1/3 completed'));\\n    await post('/projects/1/tasks/1/move', { destination: '2' });\\n    await post('/projects/2/tasks/1/move', { destination: '1' });\\n    await stop(); await start();\\n    assert.deepEqual(snapshot().slice(0, 2), before);\\n    assert.equal(rows(await get('/projects/1?filter=Deleted')), 0);\\n  } finally {\\n    if (child) await stop();\\n    await rm(directory, { recursive: true, force: true });\\n  }\\n});\\n\"}","status":"completed"}],"error":null,"incomplete_details":null,"tools":[{"type":"function","name":"read","description":"Read the contents of a file. Supports text files and images (jpg, png, gif, webp, bmp). Images are sent as attachments. For text files, output is truncated to 2000 lines or 50KB (whichever is hit first). Use offset/limit for large files. When you need the full file, continue with offset until complete.","parameters":{"type":"object","required":["path","offset","limit"],"properties":{"path":{"type":"string","description":"Path to the file to read (relative or absolute)"},"offset":{"anyOf":[{"type":"number","description":"Line number to start reading from (1-indexed)"},{"type":"null"}]},"limit":{"anyOf":[{"type":"number","description":"Maximum number of lines to read"},{"type":"null"}]}},"additionalProperties":false},"output_schema":null,"strict":true},{"type":"function","name":"bash","description":"Execute a bash command in the current working directory. Returns stdout and stderr. Output is truncated to last 2000 lines or 50KB (whichever is hit first). If truncated, full output is saved to a temp file. Optionally provide a timeout in seconds.","parameters":{"type":"object","required":["command","timeout"],"properties":{"command":{"type":"string","description":"Shell command to execute"},"timeout":{"anyOf":[{"type":"number","description":"Timeout in seconds (optional, no default timeout)"},{"type":"null"}]}},"additionalProperties":false},"output_schema":null,"strict":true},{"type":"function","name":"edit","description":"Edit a single file using exact text replacement. Every edits[].oldText must match a unique, non-overlapping region of the original file. If two changes affect the same block or nearby lines, merge them into one edit instead of emitting overlapping edits. Do not include large unchanged regions just to connect distant changes.","parameters":{"type":"object","required":["path","edits"],"properties":{"path":{"type":"string","description":"Path to the file to edit (relative or absolute)"},"edits":{"type":"array","items":{"type":"object","required":["oldText","newText"],"properties":{"oldText":{"type":"string","description":"Exact text for one targeted replacement. It must be unique in the original file and must not overlap with any other edits[].oldText in the same call."},"newText":{"type":"string","description":"Replacement text for this targeted edit."}},"additionalProperties":false},"description":"One or more targeted replacements. Each edit is matched against the original file, not incrementally. Do not include overlapping or nested edits. If two changes touch the same block or nearby lines, merge them into one edit instead."}},"additionalProperties":false},"output_schema":null,"strict":true},{"type":"function","name":"write","description":"Write content to a file. Creates the file if it doesn't exist, overwrites if it does. Automatically creates parent directories.","parameters":{"type":"object","required":["path","content"],"properties":{"path":{"type":"string","description":"Path to the file to write (relative or absolute)"},"content":{"type":"string","description":"Content to write to the file"}},"additionalProperties":false},"output_schema":null,"strict":true}],"tool_choice":"auto","parallel_tool_calls":true,"prompt_cache_key":"c7eefa2e-6232-40e1-82bd-ef49add2a00c","prompt_cache_retention":"24h","text":{"format":{"type":"text"},"verbosity":"low"},"top_p":0.98,"top_logprobs":0,"temperature":1.0,"reasoning":{"effort":"medium","summary":"detailed","context":"all_turns","mode":"standard"},"user":null,"usage":{"input_tokens":17931,"input_tokens_details":{"cached_tokens":5376,"cache_write_tokens":0},"output_tokens":1802,"output_tokens_details":{"reasoning_tokens":28},"total_tokens":19733,"attribution":{"items":{"fc_0aa88361b46e9e9b016acd2b1a8f3c819582f2ae4983ff0c35":{"input_tokens":