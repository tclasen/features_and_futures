ER PRIMARY KEY, project_id INTEGER NOT NULL, title TEXT NOT NULL, completed INTEGER NOT NULL DEFAULT 0);\\n    INSERT INTO projects VALUES (1, 'Source'), (2, 'Destination');\\n    INSERT INTO tasks VALUES (1, 1, 'Original', 1), (2, 1, 'Second', 0);\\n  `);\\n  legacy.close();\\n  let server;\\n  const readTask = () => {\\n    const db = new DatabaseSync(databasePath);\\n    try { return { ...db.prepare('SELECT * FROM tasks WHERE id = 1').get() }; }\\n    finally { db.close(); }\\n  };\\n  try {\\n    server = await startServer(databasePath);\\n    const get = async (path) => (await fetch(`${server.baseUrl}${path}`)).text();\\n    const titles = async (query = '') => taskRows(await get(`/projects/1${query}`)).map((row) => row.title);\\n    assert.equal(readTask().deleted, 0);\\n    await post(server.baseUrl, '/projects/1/tasks/1/priority', { priority: 'High' });\\n    await post(server.baseUrl, '/projects/1/tasks/1/due-date', { dueDate: '2026-03-05' });\\n    await post(server.baseUrl, '/projects/1/tasks/1/notes', { notes: '  notes\\\\n<literal> 📝' });\\n    // Remember a second project's position before deletion.\\n    await post(server.baseUrl, '/projects/1/tasks/1/move', { destination: '2' });\\n    await post(server.baseUrl, '/projects/2/tasks/1/move', { destination: '1' });\\n    const before = readTask();\\n    const filters = { filter: 'Completed', priorityFilter: 'High', dueFrom: '2026-03-01', dueThrough: '2026-03-31', search: 'orig' };\\n    const deleted = await post(server.baseUrl, '/projects/1/tasks/1/delete', filters);\\n    assert.equal(deleted.status, 303);\\n    const location = new URL(deleted.headers.get('location'), server.baseUrl);\\n    for (const [key, value] of Object.entries(filters)) assert.equal(location.searchParams.get(key), value);\\n    assert.deepEqual(readTask(), { ...before, deleted: 1 });\\n    assert.deepEqual(await titles(), ['Second']);\\n    assert.deepEqual(await titles('?filter=Completed'), []);\\n    assert.deepEqual(projectSummaries(await get('/')), ['0/1 completed', '0/0 completed']);\\n    const query = '?filter=Deleted&priorityFilter=High&dueFrom=2026-03-01&dueThrough=2026-03-31&search=orig';\\n    const html = await get(`/projects/1${query}`);\\n    assert.deepEqual(taskRows(html).map((row) => row.title), ['Original']);\\n    const row = html.match(/<li data-testid=\\\"task-row\\\">([\\\\s\\\\S]*?)<\\\\/li>/)[1];\\n    for (const control of row.matchAll(/<(?:input|select|textarea)\\\\b[^>]*>/g)) {\\n      if (!/type=\\\"hidden\\\"/.test(control[0])) assert.match(control[0], / disabled/);\\n    }\\n    for (const button of row.matchAll(/<button[^>]*>(.*?)<\\\\/button>/g)) {\\n      if (button[1] === 'Restore task') assert.doesNotMatch(button[0], / disabled/);\\n      else assert.match(button[0], / disabled/);\\n    }\\n    assert.deepEqual(await titles('?filter=Deleted&priorityFilter=Low'), []);\\n    assert.deepEqual(await titles('?filter=Deleted&dueFrom=2026-04-01'), []);\\n    assert.deepEqual(await titles('?filter=Deleted&search=notes'), []);\\n    for (const [action, fields] of Object.entries({ rename: { title: 'Blocked' }, completion: {}, priority: { priority: 'Low' }, 'due-date': { dueDate: '' }, notes: { notes: '' }, move: { destination: '2' }, delete: {} })) {\\n      assert.equal((await post(server.baseUrl, `/projects/1/tasks/1/${action}`, fields)).status, 409);\\n    }\\n    assert.equal((await post(server.baseUrl, '/projects/2/tasks/1/restore', {})).status, 404);\\n    await post(server.baseUrl, '/projects/1/tasks/2/delete', {});\\n    assert.deepEqual(projectSummaries(await get('/')), ['0/0 completed', '0/0 completed']);\\n    await post(server.baseUrl, '/projects/1/tasks', { title: 'Third' });\\n    await post(server.baseUrl, '/projects/1/default-priority', { priority: 'Low' });\\n    await post(server.baseUrl, '/projects/1/archive', {});\\n    assert.match(await get(`/projects/1${query}`), /disabled>Restore task/);\\n    assert.equal((await post(server.baseUrl, '/projects/1/tasks/1/restore', {})).status, 409);\\n    assert.equal((await post(server.baseUrl, '/projects/1/tasks/3/delete', {})).status, 409);\\n    await server.stop();\\n    server = await startServer(databasePath);\\n    assert.deepEqual(readTask(), { ...before, deleted: 1 });\\n    await post(server.baseUrl, '/projects/1/restore', {});\\n    // Restore in reverse order; reserved positions, not restoration time, determine order.\\n    await post(server.baseUrl, '/projects/1/tasks/2/restore', { filter: 'Deleted' });\\n    const restored = await post(server.baseUrl, '/projects/1/tasks/1/restore', { ...filters, filter: 'Deleted' });\\n    assert.equal(new URL(restored.headers.get('location'), server.baseUrl).searchParams.get('filter'), 'Deleted');\\n    assert.deepEqual(await titles('?filter=Deleted'), []);\\n    assert.deepEqual(await titles(), ['Original', 'Second', 'Third']);\\n    assert.deepEqual(readTask(), before);\\n    assert.deepEqual(projectSummaries(await get('/')), ['1/3 completed', '0/0 completed']);\\n    await post(server.baseUrl, '/projects/1/tasks/1/move', { destination: '2' });\\n    await post(server.baseUrl, '/projects/2/tasks/1/move', { destination: '1' });\\n    await server.stop();\\n    server = await startServer(databasePath);\\n    assert.deepEqual(await titles(), ['Original', 'Second', 'Third']);\\n    assert.deepEqual(readTask(), before);\\n  } finally {\\n    if (server) await server.stop();\\n    await rm(directory, { recursive: true, force: true });\\n  }\\n});\\n\\ntest('notes migrate, preserve plain text and filters, travel with tasks, and respect archival',\"}]}","status":"completed"}],"error":null,"incomplete_details":null,"tools":[{"type":"function","name":"read","description":"Read the contents of a file. Supports text files and images (jpg, png, gif, webp, bmp). Images are sent as attachments. For text files, output is truncated to 2000 lines or 50KB (whichever is hit first). Use offset/limit for large files. When you need the full file, continue with offset until complete.","parameters":{"type":"object","required":["path","offset","limit"],"properties":{"path":{"type":"string","description":"Path to the file to read (relative or absolute)"},"offset":{"anyOf":[{"type":"number","description":"Line number to start reading from (1-indexed)"},{"type":"null"}]},"limit":{"anyOf":[{"type":"number","description":"Maximum number of lines to read"},{"type":"null"}]}},"additionalProperties":false},"output_schema":null,"strict":true},{"type":"function","name":"bash","description":"Execute a bash command in the current working directory. Returns stdout and stderr. Output is truncated to last 2000 lines or 50KB (whichever is hit first). If truncated, full output is saved to a temp file. Optionally provide a timeout in seconds.","parameters":{"type":"object","required":["command","timeout"],"properties":{"command":{"type":"string","description":"Shell command to execute"},"timeout":{"anyOf":[{"type":"number","description":"Timeout in seconds (optional, no default timeout)"},{"type":"null"}]}},"additionalProperties":false},"output_schema":null,"strict":true},{"type":"function","name":"edit","description":"Edit a single file using exact text replacement. Every edits[].oldText must match a unique, non-overlapping region of the original file. If two changes affect the same block or nearby lines, merge them into one edit instead of emitting overlapping edits. Do not include large unchanged regions just to connect distant changes.","parameters":{"type":"object","required":["path","edits"],"properties":{"path":{"type":"string","description":"Path to the file to edit (relative or absolute)"},"edits":{"type":"array","items":{"type":"object","required":["oldText","newText"],"properties":{"oldText":{"type":"string","description":"Exact text for one targeted replacement. It must be unique in the original file and must not overlap with any other edits[].oldText in the same call."},"newText":{"type":"string","description":"Replacement text for this targeted edit."}},"additionalProperties":false},"description":"One or more targeted replacements. Each edit is matched against the original file, not incrementally. Do not include overlapping or nested edits. If two changes touch the same block or nearby lines, merge them into one edit instead."}},"additionalProperties":false},"output_schema":null,"strict":true},{"type":"function","name":"write","description":"Write content to a file. Creates the file if it doesn't exist, overwrites if it does. Automatically creates parent directories.","parameters":{"type":"object","required":["path","content"],"properties":{"path":{"type":"string","description":"Path to the file to write (relative or absolute)"},"content":{"type":"string","description":"Content to write to the file"}},"additionalProperties":false},"output_schema":null,"strict":true}],"tool_choice":"auto","parallel_tool_calls":true,"prompt_cache_key":"0f5b8629-7db8-4bdc-a338-cedda13e2ab8","prompt_cache_retention":"24h","text":{"format":{"type":"text"},"verbosity":"low"},"top_p":0.98,"top_logprobs":0,"temperature":1.0,"reasoning":{"effort":"medium","summary":"detailed","context":"all_turns","mode":"standard"},"user":null,"usage":{"input_tokens":17405,"input_tokens_details":{"cached_tokens":4608,"cache_write_tokens":0},"output_tokens":1729,"output_tokens_details":{"reasoning_tokens":13},"total_tokens":19134,"attribution":{"items":{"fc_057110ffd9b27857016acd2b18104487d2b78e8f21de90e409":{"input_tokens":34,"cached_tokens":0,"cache_write_tokens":0,"output_tokens":0},"fc_057110ffd9b27857016acd2b1af94887d2914a81779839b657":{"input_tokens":28,"cached_tokens":0,"cache_write_tokens":0,"output_tokens":0},"fc_057110ffd9b27857016acd2b1ebf6487d2bcc18db3a8603978":{"input_tokens":28,"cached_tokens":0,"cache_write_tokens":0,"output_tokens":0},"fc_057110ffd9b27857016acd2b22f79087d2a24599191239dee2":{"input_tokens":46,"cached_tokens":0,"cache_write_tokens":0,"output_tokens":0},"fc_057110ffd9b27857016acd2b