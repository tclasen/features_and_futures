 archive restrictions'\",\"newText\":\"test('portable project downloads include all ordered state without changing data or filters', { timeout: 15000 }, async () => {\\n  const directory = await mkdtemp(join(tmpdir(), 'workboard-export-'));\\n  const databasePath = join(directory, 'board.sqlite');\\n  const legacy = new DatabaseSync(databasePath);\\n  legacy.exec(`\\n    CREATE TABLE projects (id INTEGER PRIMARY KEY, name TEXT NOT NULL);\\n    CREATE TABLE tasks (id INTEGER PRIMARY KEY, project_id INTEGER NOT NULL, title TEXT NOT NULL, completed INTEGER NOT NULL DEFAULT 0);\\n    INSERT INTO projects VALUES (1, 'Source  Name'), (2, 'Other'), (3, 'Empty');\\n    INSERT INTO tasks VALUES (1, 1, 'First  Title', 1), (2, 1, 'Second', 0), (3, 2, 'Other task', 0);\\n  `);\\n  legacy.close();\\n  const snapshot = () => {\\n    const db = new DatabaseSync(databasePath);\\n    try {\\n      return ['projects', 'tasks', 'task_positions'].map((table) =>\\n        db.prepare(`SELECT * FROM ${table} ORDER BY 1, 2`).all());\\n    } finally { db.close(); }\\n  };\\n  let server;\\n  try {\\n    server = await startServer(databasePath);\\n    const get = (path) => fetch(`${server.baseUrl}${path}`);\\n    const download = async (id, query = '') => {\\n      const response = await get(`/projects/${id}/download${query}`);\\n      assert.equal(response.status, 200);\\n      assert.equal(response.headers.get('content-type'), 'application/json; charset=utf-8');\\n      assert.equal(response.headers.get('content-disposition'), 'attachment; filename=\\\"workboard-project.json\\\"');\\n      return response.json();\\n    };\\n    const defaultTask = (title, completed = false) => ({\\n      title, completed, priority: 'Normal', dueDate: '', notes: '', deleted: false,\\n    });\\n    // Upgrading old records supplies public defaults and exports no internal IDs/positions.\\n    assert.deepEqual(await download(1), {\\n      format: 'workboard-project', version: 1,\\n      project: { name: 'Source  Name', archived: false, defaultPriority: 'Normal',\\n        tasks: [defaultTask('First  Title', true), defaultTask('Second')] },\\n    });\\n    assert.deepEqual((await download(3)).project.tasks, []);\\n    const notes = '  \\\\r\\\\nUnicode 📝 café\\\\rline\\\\n<script>& literal</script>  ';\\n    await post(server.baseUrl, '/projects/1/tasks/1/notes', { notes });\\n    await post(server.baseUrl, '/projects/1/tasks/1/priority', { priority: 'High' });\\n    await post(server.baseUrl, '/projects/1/tasks/1/due-date', { dueDate: '0001-01-01' });\\n    await post(server.baseUrl, '/projects/1/tasks/1/move', { destination: '2' });\\n    await post(server.baseUrl, '/projects/2/tasks/1/rename', { title: 'First  Updated 📝' });\\n    await post(server.baseUrl, '/projects/2/tasks/1/move', { destination: '1' });\\n    await post(server.baseUrl, '/projects/1/tasks/2/delete', {});\\n    await post(server.baseUrl, '/projects/1/default-priority', { priority: 'Low' });\\n    await post(server.baseUrl, '/projects/1/tasks', { title: 'Third' });\\n    await post(server.baseUrl, '/projects/1/rename', { name: 'Saved  Project 📝' });\\n    const expected = {\\n      format: 'workboard-project', version: 1,\\n      project: { name: 'Saved  Project 📝', archived: false, defaultPriority: 'Low', tasks: [\\n        { ...defaultTask('First  Updated 📝', true), priority: 'High', dueDate: '0001-01-01', notes: notes.replace(/\\\\r\\\\n?/g, '\\\\n') },\\n        { ...defaultTask('Second'), deleted: true },\\n        { ...defaultTask('Third'), priority: 'Low' },\\n      ] },\\n    };\\n    const query = '?filter=Deleted&priorityFilter=High&dueFrom=2026-01-01&dueThrough=2026-12-31&search=absent';\\n    const html = await (await get(`/projects/1${query}`)).text();\\n    assert.deepEqual(taskRows(html), []);\\n    assert.match(html, /<form action=\\\"\\\\/projects\\\\/1\\\\/download\\\" method=\\\"get\\\"><button type=\\\"submit\\\">Download project<\\\\/button>/);\\n    const before = snapshot();\\n    assert.deepEqual(await download(1, query), expected);\\n    assert.deepEqual(snapshot(), before);\\n    assert.equal(snapshot()[1][0].notes, notes); // LF conversion never rewrites stored notes.\\n    assert.equal(await (await get(`/projects/1${query}`)).text(), html);\\n    assert.deepEqual((await download(2)).project.tasks, [defaultTask('Other task')]);\\n    await post(server.baseUrl, '/projects/1/archive', {});\\n    expected.project.archived = true;\\n    assert.deepEqual(await download(1), expected);\\n    assert.match(await (await get('/projects/1')).text(), /<button type=\\\"submit\\\">Download project<\\\\/button>/);\\n    await post(server.baseUrl, '/projects/3/tasks', { title: 'Only deleted' });\\n    await post(server.baseUrl, '/projects/3/tasks/5/delete', {});\\n    await post(server.baseUrl, '/projects/3/archive', {});\\n    assert.deepEqual((await download(3)).project.tasks, [{ ...defaultTask('Only deleted'), deleted: true }]);\\n    const archivedSnapshot = snapshot();\\n    await server.stop();\\n    server = await startServer(databasePath);\\n    assert.deepEqual(await download(1), expected);\\n    assert.deepEqual(snapshot(), archivedSnapshot);\\n    assert.equal((await get('/projects/999/download')).status, 404);\\n    assert.equal((await get('/projects/99999999999999999/download')).status, 404);\\n  } finally {\\n    if (server) await server.stop();\\n    await rm(directory, { recursive: true, force: true });\\n  }\\n});\\n\\ntest('deletion migrates live tasks, preserves fields and positions, filters and archive restrictions'\"}]}","status":"completed"}],"error":null,"incomplete_details":null,"tools":[{"type":"function","name":"read","description":"Read the contents of a file. Supports text files and images (jpg, png, gif, webp, bmp). Images are sent as attachments. For text files, output is truncated to 2000 lines or 50KB (whichever is hit first). Use offset/limit for large files. When you need the full file, continue with offset until complete.","parameters":{"type":"object","required":["path","offset","limit"],"properties":{"path":{"type":"string","description":"Path to the file to read (relative or absolute)"},"offset":{"anyOf":[{"type":"number","description":"Line number to start reading from (1-indexed)"},{"type":"null"}]},"limit":{"anyOf":[{"type":"number","description":"Maximum number of lines to read"},{"type":"null"}]}},"additionalProperties":false},"output_schema":null,"strict":true},{"type":"function","name":"bash","description":"Execute a bash command in the current working directory. Returns stdout and stderr. Output is truncated to last 2000 lines or 50KB (whichever is hit first). If truncated, full output is saved to a temp file. Optionally provide a timeout in seconds.","parameters":{"type":"object","required":["command","timeout"],"properties":{"command":{"type":"string","description":"Shell command to execute"},"timeout":{"anyOf":[{"type":"number","description":"Timeout in seconds (optional, no default timeout)"},{"type":"null"}]}},"additionalProperties":false},"output_schema":null,"strict":true},{"type":"function","name":"edit","description":"Edit a single file using exact text replacement. Every edits[].oldText must match a unique, non-overlapping region of the original file. If two changes affect the same block or nearby lines, merge them into one edit instead of emitting overlapping edits. Do not include large unchanged regions just to connect distant changes.","parameters":{"type":"object","required":["path","edits"],"properties":{"path":{"type":"string","description":"Path to the file to edit (relative or absolute)"},"edits":{"type":"array","items":{"type":"object","required":["oldText","newText"],"properties":{"oldText":{"type":"string","description":"Exact text for one targeted replacement. It must be unique in the original file and must not overlap with any other edits[].oldText in the same call."},"newText":{"type":"string","description":"Replacement text for this targeted edit."}},"additionalProperties":false},"description":"One or more targeted replacements. Each edit is matched against the original file, not incrementally. Do not include overlapping or nested edits. If two changes touch the same block or nearby lines, merge them into one edit instead."}},"additionalProperties":false},"output_schema":null,"strict":true},{"type":"function","name":"write","description":"Write content to a file. Creates the file if it doesn't exist, overwrites if it does. Automatically creates parent directories.","parameters":{"type":"object","required":["path","content"],"properties":{"path":{"type":"string","description":"Path to the file to write (relative or absolute)"},"content":{"type":"string","description":"Content to write to the file"}},"additionalProperties":false},"output_schema":null,"strict":true}],"tool_choice":"auto","parallel_tool_calls":true,"prompt_cache_key":"31d82ab0-2861-44c6-9c80-26b8dcf36aff","prompt_cache_retention":"24h","text":{"format":{"type":"text"},"verbosity":"low"},"top_p":0.98,"top_logprobs":0,"temperature":1.0,"reasoning":{"effort":"medium","summary":"detailed","context":"all_turns","mode":"standard"},"user":null,"usage":{"input_tokens":17419,"input_tokens_details":{"cached_tokens":5120,"cache_write_tokens":0},"output_tokens":1631,"output_tokens_details":{"reasoning_tokens":89},"total_tokens":19050,"attribution":{"items":{"fc_0c9973e10f35a47b016acd2d3c6d788190ad2833c6a6a4f79e":{"input_tokens":42,"cached_tokens":0,"cache_write_tokens":0,"output_tokens":0},"fc_0c9973e10f35a47b016acd2d4046f08190a8bdb1c3aa3049f5":{"input_tokens":28,"cached_tokens":0,"cache_write_tokens":0,"output_tokens":0},"fc_0c9973e10f35a47b016acd2d42803c8190a310782d34f4e065":{"input_tokens":28,"cached_tokens":0,"cache_write_tokens":0,"output_tokens":0},"fc_0c9973e10f35a47b016acd2d46ab9481908adf50a594ab7199":{"input_tokens":29,"cached_tokens":0,"cache_write_tokens":0,"output_tokens":0},"fc_0c9973e10f35a47b016acd2d496bd48190a14839ba6bb99f38":{"input_tok