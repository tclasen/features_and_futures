 server = undefined;\\n    server = await startServer(databasePath);\\n    assert.deepEqual(projectRows(await get()), expectedProjects);\\n    assert.match(await get(path), /<h1>Renamed &lt;board&gt;<\\\\/h1>/);\\n    assert.deepEqual(taskRows(await get(path)), originalTasks);\\n    await post(server.baseUrl, `${path}/archive`, {});\\n    html = await get(path);\\n    assert.match(html, /id=\\\"new-project-name\\\" name=\\\"name\\\" type=\\\"text\\\" disabled/);\\n    assert.match(html, /<button type=\\\"submit\\\" disabled>Rename project<\\\\/button>/);\\n    assert.equal((await post(server.baseUrl, `${path}/rename`, { name: 'Blocked' })).status, 409);\\n    assert.deepEqual(projectRows(await get('/?filter=Archived')), [expectedProjects[0]]);\\n    await post(server.baseUrl, `${path}/restore`, {});\\n    html = await get(path);\\n    assert.doesNotMatch(html, / disabled/);\\n    assert.equal((await post(server.baseUrl, `${path}/rename`, { name: 'Restored name' })).status, 303);\\n    assert.match(await get(path), /<h1>Restored name<\\\\/h1>/);\\n    assert.deepEqual(taskRows(await get(path)), originalTasks);\\n    assert.deepEqual(projectSummaries(await get()), ['1/2 completed', '0/0 completed']);\\n    await server.stop();\\n    server = undefined;\\n    server = await startServer(databasePath);\\n    assert.deepEqual(projectRows(await get()), [{ name: 'Restored name', path }, originalProjects[1]]);\\n    assert.deepEqual(taskRows(await get(path)), originalTasks);\\n    assert.deepEqual(projectSummaries(await get()), ['1/2 completed', '0/0 completed']);\\n  } finally {\\n    if (server) await server.stop();\\n    await rm(directory, { recursive: true, force: true });\\n  }\\n});\\n\\ntest('projects validate, render safely, retain order and persist after restart',\"}]}","status":"completed"}],"error":null,"incomplete_details":null,"tools":[{"type":"function","name":"read","description":"Read the contents of a file. Supports text files and images (jpg, png, gif, webp, bmp). Images are sent as attachments. For text files, output is truncated to 2000 lines or 50KB (whichever is hit first). Use offset/limit for large files. When you need the full file, continue with offset until complete.","parameters":{"type":"object","required":["path","offset","limit"],"properties":{"path":{"type":"string","description":"Path to the file to read (relative or absolute)"},"offset":{"anyOf":[{"type":"number","description":"Line number to start reading from (1-indexed)"},{"type":"null"}]},"limit":{"anyOf":[{"type":"number","description":"Maximum number of lines to read"},{"type":"null"}]}},"additionalProperties":false},"output_schema":null,"strict":true},{"type":"function","name":"bash","description":"Execute a bash command in the current working directory. Returns stdout and stderr. Output is truncated to last 2000 lines or 50KB (whichever is hit first). If truncated, full output is saved to a temp file. Optionally provide a timeout in seconds.","parameters":{"type":"object","required":["command","timeout"],"properties":{"command":{"type":"string","description":"Shell command to execute"},"timeout":{"anyOf":[{"type":"number","description":"Timeout in seconds (optional, no default timeout)"},{"type":"null"}]}},"additionalProperties":false},"output_schema":null,"strict":true},{"type":"function","name":"edit","description":"Edit a single file using exact text replacement. Every edits[].oldText must match a unique, non-overlapping region of the original file. If two changes affect the same block or nearby lines, merge them into one edit instead of emitting overlapping edits. Do not include large unchanged regions just to connect distant changes.","parameters":{"type":"object","required":["path","edits"],"properties":{"path":{"type":"string","description":"Path to the file to edit (relative or absolute)"},"edits":{"type":"array","items":{"type":"object","required":["oldText","newText"],"properties":{"oldText":{"type":"string","description":"Exact text