`)));\\n    process.stdout.on('data', chunk => {\\n      output += chunk;\\n      const match = output.match(/listening on port (\\\\d+)/);\\n      if (match) resolve(`http://127.0.0.1:${match[1]}`);\\n    });\\n  });\\n  return { base, async stop() { const exited = once(process, 'exit'); process.kill('SIGTERM'); await exited; } };\\n}\\n\\ntest('projects validate, navigate, escape names, and survive restart', async () => {\\n  const directory = await mkdtemp(join(tmpdir(), 'workboard-test-'));\\n  const database = join(directory, 'nested', 'projects.sqlite');\\n  let server;\\n  try {\\n    server = await start(database);\\n    const get = path => fetch(server.base + path);\\n    const create = name => fetch(server.base + '/projects', {\\n      method: 'POST', body: new URLSearchParams({ name }), redirect: 'manual'\\n    });\\n    const health = await get('/health');\\n    assert.equal(health.status, 200);\\n    assert.deepEqual(await health.json(), { status: 'ok' });\\n    assert.match(await (await get('/')).text(), /<h1>Workboard<\\\\/h1>/);\\n    const invalid = await create('   ');\\n    assert.equal(invalid.status, 422);\\n    const invalidHtml = await invalid.text();\\n    assert.match(invalidHtml, /role=\\\"alert\\\">Project name is required/);\\n    assert.doesNotMatch(invalidHtml, /data-testid=\\\"project-row\\\"/);\\n    assert.equal((await create('  First project  ')).status, 303);\\n    assert.equal((await create('<Second & project>')).status, 303);\\n    const listing = await (await get('/')).text();\\n    assert.equal((listing.match(/data-testid=\\\"project-row\\\"/g) || []).length, 2);\\n    assert.ok(listing.indexOf('First project') < listing.indexOf('&lt;Second &amp; project&gt;'));\\n    assert.match(listing, /action=\\\"\\\\/projects\\\\/1\\\"/);\\n    const detail = await (await get('/projects/1')).text();\\n    assert.match(detail, /<h1>First project<\\\\/h1>/);\\n    assert.match(detail, /action=\\\"\\\\/\\\".*>Projects<\\\\/button>/);\\n    await server.stop();\\n    server = await start(database);\\n    assert.equal(await (await get('/')).text(), listing);\\n    assert.equal(await (await get('/projects/1')).text(), detail);\\n    assert.equal((await get('/projects/999')).status, 404);\\n  } finally {\\n    if (server) await server.stop();\\n    await rm(directory, { recursive: true, force: true });\\n  }\\n});\\n\"}","status":"completed"}],"error":null,"incomplete_details":null,"tools":[{"type":"function","name":"read","description":"Read the contents of a file. Supports text files and images (jpg, png, gif, webp, bmp). Images are sent as attachments. For text files, output is truncated to 2000 lines or 50KB (whichever is hit first). Use offset/limit for large files. When you need the full file, continue with offset until complete.","parameters":{"type":"object","required":["path","offset","limit"],"properties":{"path":{"type":"string","description":"Path to the file to read (relative or absolute)"},"offset":{"anyOf":[{"type":"number","description":"Line number to start reading from (1-indexed)"},{"type":"null"}]},"limit":{"anyOf":[{"type":"number","description":"Maximum number of lines to read"},{"type":"null"}]}},"additionalProperties":false},"output_schema":null,"strict":true},{"type":"function","name":"bash","description":"Execute a bash command in the current working directory. Returns stdout and stderr. Output is truncated to last 2000 lines or 50KB (whichever is hit first). If truncated, full output is saved to a temp file. Optionally provide a timeout in seconds.","parameters":{"type":"object","required":["command","timeout"],"properties":{"command":{"type":"string","description":"Shell command to execute"},"timeout":{"anyOf":[{"type":"number","description":"Timeout in seconds (optional, no default timeout)"},{"type":"null"}]}},"additionalProperties":false},"output_schema":null,"strict":true},{"type":"function","name":"edit","description":"Edit a single file using exact text replacement. Every edits[].oldText must match a unique, non-overlapping region of the original file. If two changes affect the same block or nearby lines, merge them into one edit instead of emitting overlapping edits. Do not include large unchanged regions just to connect distant changes.","parameters":{"type":"object","required":["path","edits"],"properties":{"path":{"type":"string","description":"Path to the file to edit (relative or absolute)"},"edits":{"type":"array","items":{"type":"object","required":["oldText","newText"],"properties":{"oldText":{"type":"string","description":"Exact text for one targeted replacement. It must be unique in the original file and must not overlap with any other edits[].oldText in the same call."},"newText":{"type":"string","description":"Replacement text for this targeted edit."}},"additionalProperties":false},"description":"One or more targeted replacements. Each edit is matched against the original file, not incrementally. Do not include overlapping or nested edits. If two changes touch the same block or nearby lines, merge them into one edit instead."}},"additionalProperties":false},"output_schema":null,"strict":true},{"type":"function","name":"write","description":"Write content to a file. Creates the file if it doesn't exist, overwrites if it does. Automatically creates parent directories.","parameters":{"type":"object","required":["path","content"],"properties":{"path":{"type":"string","description":"Path to the file to write (relative or absolute)"},"content":{"type":"string","description":"Content to write to the file"}},"additionalProperties":false},"output_schema":null,"strict":true}],"tool_choice":"auto","parallel_tool_calls":true,"prompt_cache_key":"47002e05-db7c-4580-bf2e-8e762d141417","prompt_cache_retention":"24h","text":{"format":{"type":"text"},"verbosity":"low"},"top_p":0.98,"top_logprobs":0,"temperature":1.0,"reasoning":{"effort":"medium","summary":"detailed","context":"all_turns","mode":"standard"},"user":null,"usage":{"input_tokens":4005,"input_tokens_details":{"cached_tokens":0,"cache_write_tokens":0},"output_tokens":888,"output_tokens_details":{"reasoning_tokens":15},"total_tokens":4893,"attribution":{"items":{"fc_0122dd821ea740a0016acd17402e5481958a993fac7b678634":{"input_tokens":38,"cached_tokens":0,"cache_write_tokens":0,"output_tokens":0},"fc_0122dd821ea740a0016acd1744f9a48195919726a7050125c8":{"input_tokens":42,"cached_tokens":0,"cache_write_tokens":0,"output_tokens":0},"fc_0122dd821ea740a0016acd1744f9b48195b78bb8abf6c16ac6":{"input_tokens":25,"cached_tokens":0,"cache_write_tokens":0,"output_tokens":0},"fc_0122dd821ea740a0016acd174ca05c819594d96dce147bc83a":{"input_tokens":1741,"cached_tokens":0,"cache_write_tokens":0,"output_tokens":0},"fc_0122dd821ea740a0016acd1769105481959abb9557e5c3a8d3":{"input_tokens":137,"cached_tokens":0,"cache_write_tokens":0,"output_tokens":0,"content":[{"input_tokens":137,"cached_tokens":0,"cache_write_tokens":0,"output_tokens":0}]},"fc_0122dd821ea740a0016acd176910548195a4779c8a446d7d47":{"input_tokens":26,"cached_tokens":0,"cache_write_tokens":0,"output_tokens":0,"content":[{"input_tokens":26,"cached_tokens":0,"cache_write_tokens":0,"output_tokens":0}]},"fc_0122dd821ea740a0016acd176910548195af29e7675bd145fb":{"input_tokens":58,"cached_tokens":0,"cache_write_tokens":0,"output_tokens":0,"content":[{"input_tokens":58,"cached_tokens":0,"cache_write_tokens":0,"output_tokens":0}]},"fc_0122dd821ea740a0016acd176910548195bad18c533607fe7c":{"input_tokens":13,"cached_tokens":0,"cache_write_tokens":0,"output_tokens":0,"content":[{"input_tokens":13,"cached_tokens":0,"cache_write_tokens":0,"output_tokens":0}]},"fc_0122dd821ea740a0016acd176bda208195bcef550cbe459101":{"input_tokens":0,"cached_tokens":0,"cache_write_tokens":0,"output_tokens":873},"msg_0122dd821ea740a0016acd174c2aa88195b28b9079b60e621e":{"input_tokens":33,"cached_tokens":0,"cache_write_tokens":0,"output_tokens":0,"content":[{"input_tokens":33,"cached_tokens":0,"cache_write_tokens":0,"output_tokens":0}]},