data: {"type":"response.function_call_arguments.done","sequence_number":986,"item_id":"fc_028be0af4df7be0a016acdcc2472a08196a32266dfc2e45f63","output_index":1,"arguments":"{\"path\":\"server.js\",\"edits\":[{\"oldText\":\"const priorities = ['Low', 'Normal', 'High'];\",\"newText\":\"// Keep owner lookups and summaries fast as the persistent dataset grows.\\ndb.exec(`\\n  CREATE INDEX IF NOT EXISTS tasks_owner_order ON tasks(project_id, sort_order, id);\\n  CREATE INDEX IF NOT EXISTS tasks_owner_live ON tasks(project_id, deleted, completed);\\n  CREATE INDEX IF NOT EXISTS projects_archive_order ON projects(archived, id);\\n`);\\nconst priorities = ['Low', 'Normal', 'High'];\"},{\"oldText\":\"<body><main>${content}</main></body>\",\"newText\":\"<body><main>${content}</main>\\n<script>\\n  // Resolve forms without a full document navigation for every small edit.\\n  // Keep native forms as a fallback and leave downloads to the browser.\\n  let updates = Promise.resolve();\\n  document.addEventListener('submit', (event) => {\\n    const form = event.target;\\n    if (new URL(form.action).pathname.endsWith('/export')) return;\\n    event.preventDefault();\\n    const data = new URLSearchParams(new FormData(form));\\n    if (event.submitter?.name) data.append(event.submitter.name, event.submitter.value);\\n    const method = form.method.toUpperCase();\\n    const target = new URL(form.action);\\n    if (method === 'GET') target.search = data.toString();\\n    updates = updates.then(async () => {\\n      const main = document.querySelector('main');\\n      main.setAttribute('aria-busy', 'true');\\n      main.querySelector('[role=\\\"status\\\"]')?.remove();\\n      try {\\n        const response = await fetch(target, method === 'GET' ? {} : {\\n          method, body: data,\\n        });\\n        const next = new DOMParser().parseFromString(await response.text(), 'text/html');\\n        const changedPage = location.pathname !== new URL(response.url).pathname;\\n        main.replaceWith(next.querySelector('main'));\\n        document.title = next.title;\\n        history.pushState(null, '', response.url);\\n        if (changedPage) window.scrollTo(0, 0);\\n      } catch {\\n        // A failed transport must not silently lose the user's submitted values.\\n        main.removeAttribute('aria-busy');\\n        const alert = document.createElement('p');\\n        alert.setAttribute('role', 'alert');\\n        alert.textContent = 'Unable to complete request. Please try again.';\\n        main.prepend(alert);\\n      }\\n    });\\n  });\\n  window.addEventListener('popstate', () => location.reload());\\n</script></body>\"},{\"oldText\":\"function directoryTasks(scope, filter, priority, range, query) {\\n  return listProjects.all(scope === 'Archived' ? 1 : 0).flatMap((project) =>\\n    listTasks.all(project.id)\\n      .filter((task) => matchesTask(task, filter, priority, range, query))\\n      .map((task) => ({ project, task })));\\n}\",\"newText\":\"const listDirectoryTasks = db.prepare(`\\n  SELECT t.*, p.name AS owner_name\\n  FROM projects p JOIN tasks t ON t.project_id = p.id\\n  WHERE p.archived = ?\\n  ORDER BY p.id, t.sort_order, t.id\\n`);\\n\\nfunction directoryTasks(scope, filter, priority, range, query) {\\n  return listDirectoryTasks.all(scope === 'Archived' ? 1 : 0)\\n    .filter((task) => matchesTask(task, filter, priority, range, query))\\n    .map((task) => ({ project: { id: task.project_id, name: task.owner_name }, task }));\\n}\"},{\"oldText\":\"const destinations = listProjects.all(0).filter((destination) => destination.id !== project.id);\",\"newText\":\"const destinations = db.prepare('SELECT id, name FROM projects WHERE archived = 0 AND id != ? ORDER BY id').all(project.id);\"}]}"}

