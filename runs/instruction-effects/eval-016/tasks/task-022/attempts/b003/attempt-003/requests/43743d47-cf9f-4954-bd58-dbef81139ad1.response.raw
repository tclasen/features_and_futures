join } from 'node:path';\\n\\ntest('directory summary counts the resolved intersection without changing saved data', async () => {\\n  const directory = await mkdtemp(join(tmpdir(), 'workboard-summary-'));\\n  let child, base;\\n  async function start() {\\n    child = spawn(process.execPath, ['server.js'], {\\n      env: { ...process.env, PORT: '0', DB_PATH: join(directory, 'db.sqlite') },\\n      stdio: ['ignore', 'pipe', 'pipe'],\\n    });\\n    base = await new Promise((resolve, reject) => {\\n      let output = '';\\n      child.on('error', reject);\\n      child.stdout.on('data', chunk => {\\n        output += chunk;\\n        const match = output.match(/listening on port (\\\\d+)/);\\n        if (match) resolve(`http://127.0.0.1:${match[1]}`);\\n      });\\n    });\\n  }\\n  async function stop() { const exit = once(child, 'exit'); child.kill('SIGTERM'); await exit; child = null; }\\n  const post = (path, body) => fetch(base + path, { method: 'POST', body: new URLSearchParams(body), redirect: 'manual' });\\n  const task = (title, completed, priority = 'High', dueDate = '2024-02-29', deleted = false) => ({ title, completed, priority, dueDate, deleted, notes: 'literal notes' });\\n  async function imported(name, archived, tasks) {\\n    await post('/projects/import', { name, json: JSON.stringify({ format: 'workboard-project', version: 1, project: { name, archived, defaultPriority: 'Normal', tasks } }) });\\n  }\\n  async function check(fields, expected) {\\n    const html = await (await fetch(base + '/directory?' + new URLSearchParams(fields))).text();\\n    const summaries = [...html.matchAll(/data-testid=\\\"directory-summary\\\">([^<]*)<\\\\/p>/g)];\\n    assert.equal(summaries.length, 1);\\n    assert.equal(summaries[0][1], expected);\\n    const rows = [...html.matchAll(/data-testid=\\\"directory-task-row\\\"/g)].length;\\n    assert.equal(rows, Number(expected.split('/')[1].split(' ')[0]));\\n    assert.equal(html.includes('No matching tasks'), rows === 0);\\n    return html;\\n  }\\n  const exported = async id => (await fetch(base + `/projects/${id}/download`)).json();\\n  try {\\n    await start();\\n    await imported('First', false, [task('Match one', false), task('Match two', true), task('Other', true, 'Low', ''), task('Match deleted', true, 'High', '2024-02-29', true)]);\\n    await imported('Second', false, [task('MATCH\\\\t three', false), task('Match late', true, 'High', '2025-01-01')]);\\n    await imported('Archived', true, [task('Match archived', true), task('Open archived', false), task('Deleted archived', false, 'High', '', true)]);\\n    const before = await Promise.all([1, 2, 3].map(exported));\\n    await check({}, '3/6 completed');\\n    await check({ filter: 'Open' }, '0/3 completed');\\n    await check({ filter: 'Completed' }, '3/3 completed');\\n    await check({ filter: 'Deleted' }, '1/1 completed');\\n    await check({ scope: 'Archived' }, '1/2 completed');\\n    await check({ scope: 'Archived', filter: 'Deleted' }, '0/1 completed');\\n    const fields = { priorityFilter: 'High', search: '  match  ', dueFrom: '2024-02-29', dueThrough: '2024-02-29' };\\n    for (const order of ['Original', 'Priority', 'Due date', 'Title']) await check({ ...fields, order }, '1/3 completed');\\n    await check({ search: 'literal notes' }, '0/0 completed');\\n    assert.deepEqual(await Promise.all([1, 2, 3].map(exported)), before);\\n    const invalid = await (await fetch(base + '/directory/due-range?' + new URLSearchParams({ ...fields, appliedFrom: fields.dueFrom, appliedThrough: fields.dueThrough, dueFrom: '2024-02-30' }))).text();\\n    assert.match(invalid, /Due range must use valid/);\\n    assert.match(invalid, /data-testid=\\\"directory-summary\\\">1\\\\/3 completed/);\\n    const bulk = { ...fields, filter: 'Open', order: 'Title' };\\n    await post('/directory/complete', bulk);\\n    await check(bulk, '0/0 completed');\\n    await check(fields, '3/3 completed');\\n    await check({ filter: 'Deleted' }, '1/1 completed');\\n    await check({ scope: 'Archived' }, '1/2 completed');\\n    await post('/directory/reopen', { ...fields, filter: 'Completed', order: 'Priority' });\\n    await check({ ...fields, filter: 'Completed', order: 'Priority' }, '0/0 completed');\\n    await check(fields, '0/3 completed');\\n    await stop();\\n    await start();\\n    await check(fields, '0/3 completed');\\n    await check({}, '2/6 completed');\\n    const home = await (await fetch(base)).text();\\n    assert.match(home, /data-testid=\\\"project-summary\\\">1\\\\/3 completed/);\\n    assert.match(home, /data-testid=\\\"project-summary\\\">1\\\\/2 completed/);\\n  } finally {\\n    if (child) await stop();\\n    await rm(directory, { recursive: true, force: true });\\n  }\\n});\\n\"}","status":"completed"}],"error":null,"incomplete_details":null,"tools":[{"type":"function","name":"read","description":"Read the contents of a file. Supports text files and images (jpg, png, gif, webp, bmp). Images are sent as attachments. For text files, output is truncated to 2000 lines or 50KB (whichever is hit first). Use offset/limit for large files. When you need the full file, continue with offset until complete.","parameters":{"type":"object","required":["path","offset","limit"],"properties":{"path":{"type":"string","description":"Path to the file to read (relative or absolute)"},"offset":{"anyOf":[{"type":"number","description":"Line number to start reading from (1-indexed)"},{"type":"null"}]},"limit":{"anyOf":[{"type":"number","description":"Maximum number of lines to read"},{"type":"null"}]}},"additionalProperties":false},"output_schema":null,"strict":true},{"type":"function","name":"bash","description":"Execute a bash command in the current working directory. Returns stdout and stderr. Output is truncated to last 2000 lines or 50KB (whichever is hit first). If truncated, full output is saved to a temp file. Optionally provide a timeout in seconds.","parameters":{"type":"object","required":["command","timeout"],"properties":{"command":{"type":"string","description":"Shell command to execute"},"timeout":{"anyOf":[{"type":"number","description":"Timeout in seconds (optional, no default timeout)"},{"type":"null"}]}},"additionalProperties":false},"output_schema":null,"strict":true},{"type":"function","name":"edit","description":"Edit a single file using exact text replacement. Every edits[].oldText must match a unique, non-overlapping region of the original file. If two changes affect the same block or nearby lines, merge them into one edit instead of emitting overlapping edits. Do not include large unchanged regions just to connect distant changes.","parameters":{"type":"object","required":["path","edits"],"properties":{"path":{"type":"string","description":"Path to the file to edit (relative or absolute)"},"edits":{"type":"array","items":{"type":"object","required":["oldText","newText"],"properties":{"oldText":{"type":"string","description":"Exact text for one targeted replacement. It must be unique in the original file and must not overlap with any other edits[].oldText in the same call."},"newText":{"type":"string","description":"Replacement text for this targeted edit."}},"additionalProperties":false},"description":"One or more targeted replacements. Each edit is matched against the original file, not incrementally. Do not include overlapping or nested edits. If two changes touch the same block or nearby lines, merge them into one edit instead."}},"additionalProperties":false},"output_schema":null,"strict":true},{"type":"function","name":"write","description":"Write content to a file. Creates the file if it doesn't exist, overwrites if it does. Automatically creates parent directories.","parameters":{"type":"object","required":["path","content"],"properties":{"path":{"type":"string","description":"Path to the file to write (relative or absolute)"},"content":{"type":"string","description":"Content to write to the file"}},"additionalProperties":false},"output_schema":null,"strict":true}],"tool_choice":"auto","parallel_tool_calls":true,"prompt_cache_key":"b2e425fb-0e2d-4d35-a4b1-475dffd98f68","prompt_cache_retention":"24h","text":{"format":{"type":"text"},"verbosity":"low"},"top_p":0.98,"top_logprobs":0,"temperature":1.0,"reasoning":{"effort":"medium","summary":"detailed","context":"all_turns","mode":"standard"},"user":null,"usage":{"input_tokens":12080,"input_tokens_details":{"cached_tokens":0,"cache_write_tokens":0},"output_tokens":1517,"output_tokens_details":{"reasoning_tokens":14},"total_tokens":13597,"attribution":{"items":{"fc_0d952e515aebdf90016acdc7fa88688193917ef9fee69ae3d8":{"input_tokens":42,"cached_tokens":0,"cache_write_tokens":0,"output_tokens":0},"fc_0d952e515aebdf90016acdc803b00c8193afd8d0cac89083f8":{"input_tokens":44,"cached_tokens":0,"cache_write_tokens":0,"output_tokens":0},"fc_0d952e515aebdf90016acdc80cf13481938e3e30d6db22eab3":{"input_tokens":32,"cached_tokens":0,"cache_write_tokens":0,"output_tokens":0},"fc_0d952e515aebdf90016acdc815f5708193ad1943aec83034bf":{"input_tokens":28,"cached_tokens":0,"cache_write_tokens":0,"output_tokens":0},"fc_0d952e515aebdf90016acdc8171bc481938bb013463c4b465f":{"input_tokens":605,"cached_tokens":0,"cache_write_tokens":0,"output_tokens":0,"content":[{"input_tokens":605,"cached_tokens":0,"cache_write_tokens":0,"output_tokens":0}]},"fc_0d952e515aebdf90016acdc8171bc481939398211ada58aec3":{"input_tokens":1691,"cached_tokens":0,"cache_write_tokens":0,"output_tokens":0,"content":[{"input_tokens":1691,"cached_tokens":0,"cache_write_tokens":0,"output_tokens":0}]},"fc_0d952e515aebdf90016acdc8171bc481939bdfb2897fdba11b":{"input_tokens":246,"cached_tokens":0,"cache_write_tokens":0,"output_tokens":0,"content":[{"input_tokens":246,"cached_tokens":0,"cache_write_tokens":0,"output_tokens":0}]},"fc_0d952e515aebdf90016acdc8171bc481939fadad9fe49d7a28":{"input_tokens":1983,"cached_tokens":0,"cache_write_tokens":0,"output_tokens":0,"content":[{"input_tokens":1983,"cached_tokens":0,"cache_write_tokens":0,"output_tokens":0}]},"fc_0d952e515aebdf90016acdc81dce7c8193988471c62304e5de":{"input_tokens":0,"cached_tokens":0,"cache_write_tokens":0,"output_tokens":1455},"msg_0d952e515aebdf90016acdc8171bc48193b260d076f7041fd3":{"input_tokens":6297,"cached_tokens":0,"cache_write_tokens":0,"output_tokens":0,"content":[{"input_tokens":6297,"cached_tokens":0,"cache_write_tokens":0,"output_tokens":0}]},"msg_0d952e515aebdf90016acdc81d0ae081938db807045cd9f1ae":{"input_tokens":0,"cached_tokens":0,"cache_write_tokens":0,"output_tokens":48,"content":[{"input_tokens":0,"cached_tokens":0,"cache_write_tokens":0,"output_tokens":48}]},"rs_0d952e515aebdf90016acdc81b347c8193b5648c549f66f96c":{"input_tokens":2,"cached_tokens":0,"cache_write_tokens":0,"output_tokens":14}},"request_fields":{"instructions":{"input_tokens":617,"cached_tokens":0,"cache_write_tokens":0,"output_tokens":0},"tools":{"input_tokens":493,"cached_tokens":0,"cache_write_tokens":0,"output_tokens":0}}}},"tool_usage":{"image_gen":{"input_tokens":0,"output_tokens":0,"total_tokens":0,"input_tokens_details":{"text_tokens":0,"image_tokens":0},"output_tokens_details":{"image_tokens":0,"text_tokens":0}},"web_search":{"num_requests":0}},"safety_identifier":"user-ZglLa0AK1sUTDt85g9NsGTX5","store":false,"metadata":{},"max_output_tokens":null,"max_tool_calls":null,"service_tier":"default","truncation":"disabled"}}
