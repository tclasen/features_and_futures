\\n      if (project.archived) {\\n        sendHtml(response, 409, projectPage(project, filter, 'Archived project cannot be changed', selectedPriority, range));\\n        return;\\n      }\\n      const priority\"},{\"oldText\":\"projectPage(project, filter, 'Invalid task priority', selectedPriority));\\n        return;\\n      }\\n      updateProject\",\"newText\":\"projectPage(project, filter, 'Invalid task priority', selectedPriority, range));\\n        return;\\n      }\\n      updateProject\"},{\"oldText\":\"projectLocation(id, filter, selectedPriority) });\\n      response.end();\\n    } else if (request.method === 'POST' && /^\\\\/projects\\\\/[1-9]\\\\d*\\\\/rename\",\"newText\":\"projectLocation(id, filter, selectedPriority, range) });\\n      response.end();\\n    } else if (request.method === 'POST' && /^\\\\/projects\\\\/[1-9]\\\\d*\\\\/rename\"},{\"oldText\":\"      const priority = priorityFilter(form.get('priorityFilter'));\\n      if (project.archived) {\\n        sendHtml(response, 409, projectPage(project, filter, 'Archived project cannot be changed', priority));\",\"newText\":\"      const priority = priorityFilter(form.get('priorityFilter'));\\n      const range = savedDueRange(form);\\n      if (project.archived) {\\n        sendHtml(response, 409, projectPage(project, filter, 'Archived project cannot be changed', priority, range));\"},{\"oldText\":\"projectPage(project, filter, 'Project name is required', priority)\",\"newText\":\"projectPage(project, filter, 'Project name is required', priority, range)\"},{\"oldText\":\"projectLocation(id, filter, priority)\",\"newText\":\"projectLocation(id, filter, priority, range)\"},{\"oldText\":\"      const selectedPriority = priorityFilter(form.get('priorityFilter'));\\n      if (project.archived) {\\n        sendHtml(response, 409, projectPage(project, filter, 'Archived project cannot be changed', selectedPriority));\\n        return;\\n      }\\n      if (taskId)\",\"newText\":\"      const selectedPriority = priorityFilter(form.get('priorityFilter'));\\n      const range = savedDueRange(form);\\n      if (project.archived) {\\n        sendHtml(response, 409, projectPage(project, filter, 'Archived project cannot be changed', selectedPriority, range));\\n        return;\\n      }\\n      if (taskId)\"},{\"oldText\":\"projectPage(project, filter, 'Task title is required', selectedPriority));\\n          return;\\n        }\\n        const priority\",\"newText\":\"projectPage(project, filter, 'Task title is required', selectedPriority, range));\\n          return;\\n        }\\n        const priority\"},{\"oldText\":\"projectPage(project, filter, 'Invalid task priority', selectedPriority));\\n          return;\",\"newText\":\"projectPage(project, filter, 'Invalid task priority', selectedPriority, range));\\n          return;\"},{\"oldText\":\"projectPage(project, filter, 'Due date must be a valid YYYY-MM-DD date', selectedPriority)\",\"newText\":\"projectPage(project, filter, 'Due date must be a valid YYYY-MM-DD date', selectedPriority, range)\"},{\"oldText\":\"projectPage(project, filter, 'Task title is required', selectedPriority));\\n          return;\\n        }\\n        createTask\",\"newText\":\"projectPage(project, filter, 'Task title is required', selectedPriority, range));\\n          return;\\n        }\\n        createTask\"},{\"oldText\":\"projectLocation(id, filter, selectedPriority)\",\"newText\":\"projectLocation(id, filter, selectedPriority, range)\"}]}","item_id":"fc_065bf45199317461016acd1fa90c0c8197bf90784912b04d55","output_index":1,"sequence_number":1228}

