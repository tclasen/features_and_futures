ents';\\n\\n test('inclusive due ranges intersect filters and survive edits, validation errors and archival', async () => {\\n  const directory = await mkdtemp(join(tmpdir(), 'workboard-range-'));\\n  let child;\\n  let base;\\n  async function start() {\\n    child = spawn(process.execPath, ['server.js'], {\\n      env: { ...process.env, PORT: '0', DB_PATH: join(directory, 'data.sqlite') },\\n      stdio: ['ignore', 'pipe', 'pipe'],\\n    });\\n    base = await new Promise((resolve, reject) => {\\n      let output = '';\\n      child.stdout.on('data', chunk => {\\n        output += chunk;\\n        const match = output.match(/listening on port (\\\\d+)/);\\n        if (match) resolve(`http://127.0.0.1:${match[1]}`);\\n      });\\n      child.on('error', reject);\\n      child.on('exit', code => reject(new Error(`Server exited: ${code}`)));\\n    });\\n  }\\n  async function stop() {\\n    const exited = once(child, 'exit');\\n    child.kill('SIGTERM');\\n    await exited;\\n    child = null;\\n  }\\n  const get = async path => (await fetch(base + path)).text();\\n  const post = (path, values = {}) => fetch(base + path, {\\n    method: 'POST', body: new URLSearchParams(values), redirect: 'manual',\\n  });\\n  const rows = body => [...body.matchAll(/aria-label=\\\"Complete ([^\\\"]+)\\\"/g)].map(match => match[1]);\\n  const state = { filter: 'Open', priorityFilter: 'High', dueFrom: '2024-02-29', dueThrough: '2024-03-01' };\\n  const location = '/projects/1?filter=Open&priorityFilter=High&dueFrom=2024-02-29&dueThrough=2024-03-01';\\n  try {\\n    await start();\\n    await post('/projects', { name: 'Range project' });\\n    for (const title of ['Before', 'Start', 'End', 'After', 'Undated']) {\\n      await post('/projects/1/tasks', { title });\\n    }\\n    for (const [index, dueDate] of ['2024-02-28', '2024-02-29', '2024-03-01', '2024-03-02', ''].entries()) {\\n      await post(`/projects/1/tasks/${index + 1}/due-date`, { dueDate });\\n      await post(`/projects/1/tasks/${index + 1}/priority`, { priority: 'High' });\\n    }\\n    const summary = await get('/');\\n    const result = await post('/projects/1/due-range', { filter: 'Open', priorityFilter: 'High', from: ' 2024-02-29 ', through: '2024-03-01 ' });\\n    assert.equal(result.headers.get('location'), location);\\n    let body = await get(location);\\n    assert.deepEqual(rows(body), ['Start', 'End']);\\n    assert.match(body, /name=\\\"dueFrom\\\" value=\\\"2024-02-29\\\"/);\\n    assert.match(body, /id=\\\"due-through\\\" name=\\\"through\\\" type=\\\"text\\\" value=\\\"2024-03-01\\\"/);\\n    for (const [from, through, message] of [\\n      ['1900-02-29', '', 'Due range must use valid YYYY-MM-DD dates'],\\n      ['0000-01-01', '', 'Due range must use valid YYYY-MM-DD dates'],\\n      ['', '2024-04-31', 'Due range must use valid YYYY-MM-DD dates'],\\n      ['2024-03-02', '2024-03-01', 'Due from must not be after Due through'],\\n    ]) {\\n      const invalid = await post('/projects/1/due-range', { ...state, from, through });\\n      assert.equal(invalid.status, 400);\\n      body = await invalid.text();\\n      assert.ok(body.includes(`role=\\\"alert\\\">${message}`));\\n      assert.deepEqual(rows(body), ['Start', 'End']);\\n      assert.match(body, /name=\\\"dueFrom\\\" value=\\\"2024-02-29\\\"/);\\n    }\\n    assert.deepEqual(rows(await get('/projects/1?dueFrom=2024-03-01')), ['End', 'After']);\\n    assert.deepEqual(rows(await get('/projects/1?dueThrough=2024-02-29')), ['Before', 'Start']);\\n    assert.equal(rows(await get('/projects/1')).length, 5);\\n    for (const [path, values] of [\\n      ['/projects/1/tasks/2/rename', { title: 'Renamed' }],\\n      ['/projects/1/rename', { name: 'Renamed project' }],\\n      ['/projects/1/default-priority', { priority: 'Low' }],\\n      ['/projects/1/tasks', { title: 'New undated' }],\\n    ]) {\\n      const edited = await post(path, { ...state, ...values });\\n      assert.equal(edited.headers.get('location'), location);\\n      assert.deepEqual(rows(await get(location)), ['Renamed', 'End']);\\n    }\\n    await post('/projects/1/tasks/2/priority', { ...state, priority: 'Low' });\\n    assert.deepEqual(rows(await get(location)), ['End']);\\n    assert.deepEqual(rows(await get(location.replace('High', 'Low'))), ['Renamed']);\\n    await post('/projects/1/tasks/2/priority', { ...state, priority: 'High' });\\n    await post('/projects/1/tasks/2', { ...state, completed: '1' });\\n    assert.deepEqual(rows(await get(location)), ['End']);\\n    assert.deepEqual(rows(await get(location.replace('Open', 'Completed'))), ['Renamed']);\\n    await post('/projects/1/tasks/2', state);\\n    await post('/projects/1/tasks/2/due-date', { ...state, dueDate: '2024-03-03' });\\n    assert.deepEqual(rows(await get(location)), ['End']);\\n    const invalidDate = await post('/projects/1/tasks/3/due-date', { ...state, dueDate: 'bad' });\\n    assert.deepEqual(rows(await invalidDate.text()), ['End']);\\n    await post('/projects/1/tasks/3/due-date', { ...state, dueDate: '' });\\n    assert.deepEqual(rows(await get(location)), []);\\n    await stop();\\n    await start();\\n    assert.deepEqual(rows(await get(location)), []);\\n    assert.equal(rows(await get('/projects/1')).length, 6);\\n    await post('/projects/1/archive');\\n    const archived = await post('/projects/1/due-range', { ...state, from: '', through: '' });\\n    const archivedBody = await get(archived.headers.get('location'));\\n    assert.equal(rows(archivedBody).length, 5);\\n    assert.match(archivedBody, /Archived project/);\\n    assert.match(archivedBody, /id=\\\"due-from\\\" name=\\\"from\\\" type=\\\"text\\\" value=\\\"\\\">/);\\n    assert.match(archivedBody, /disabled>Save due date/);\\n    await post('/projects/1/restore');\\n    assert.deepEqual(rows(await get(location)), []);\\n    // Filtering alone never changes summaries.\\n    const finalSummary = await get('/');\\n    await get('/projects/1?dueFrom=0001-01-01&dueThrough=9999-12-31');\\n    assert.equal(await get('/'), finalSummary);\\n    assert.match(summary, /5 completed/);\\n    assert.match(finalSummary, /0\\\\/6 completed/);\\n  } finally {\\n    if (child) await stop();\\n    await rm(directory, { recursive: true, force: true });\\n  }\\n});\\n\"}","status":"completed"}],"error":null,"incomplete_details":null,"tools":[{"type":"function","name":"read","description":"Read the contents of a file. Supports text files and images (jpg, png, gif, webp, bmp). Images are sent as attachments. For text files, output is truncated to 2000 lines or 50KB (whichever is hit first). Use offset/limit for large files. When you need the full file, continue with offset until complete.","parameters":{"type":"object","required":["path","offset","limit"],"properties":{"path":{"type":"string","description":"Path to the file to read (relative or absolute)"},"offset":{"anyOf":[{"type":"number","description":"Line number to start reading from (1-indexed)"},{"type":"null"}]},"limit":{"anyOf":[{"type":"number","description":"Maximum number of lines to read"},{"type":"null"}]}},"additionalProperties":false},"output_schema":null,"strict":true},{"type":"function","name":"bash","description":"Execute a bash command in the current working directory. Returns stdout and stderr. Output is truncated to last 2000 lines or 50KB (whichever is hit first). If truncated, full output is saved to a temp file. Optionally provide a timeout in seconds.","parameters":{"type":"object","required":["command","timeout"],"properties":{"command":{"type":"string","description":"Shell command to execute"},"timeout":{"anyOf":[{"type":"number","description":"Timeout in seconds (optional, no default timeout)"},{"type":"null"}]}},"additionalProperties":false},"output_schema":null,"strict":true},{"type":"function","name":"edit","description":"Edit a single file using exact text replacement. Every edits[].oldText must match a unique, non-overlapping region of the original file. If two changes affect the same block or nearby lines, merge them into one edit instead of emitting overlapping edits. Do not include large unchanged regions just to connect distant changes.","parameters":{"type":"object","required":["path","edits"],"properties":{"path":{"type":"string","description":"Path to the file to edit (relative or absolute)"},"edits":{"type":"array","items":{"type":"object","required":["oldText","newText"],"properties":{"oldText":{"type":"string","description":"Exact text for one targeted replacement. It must be unique in the original file and must not overlap with any other edits[].oldText in the same call."},"newText":{"type":"string","description":"Replacement text for this targeted edit."}},"additionalProperties":false},"description":"One or more targeted replacements. Each edit is matched against the original file, not incrementally. Do not include overlapping or nested edits. If two changes touch the same block or nearby lines, merge them into one edit instead."}},"additionalProperties":false},"output_schema":null,"strict":true},{"type":"function","name":"write","description":"Write content to a file. Creates the file if it doesn't exist, overwrites if it does. Automatically creates parent directories.","parameters":{"type":"object","required":["path","content"],"properties":{"path":{"type":"string","description":"Path to the file to write (relative or absolute)"},"content":{"type":"string","description":"Content to write to the file"}},"additionalProperties":false},"output_schema":null,"strict":true}],"tool_choice":"auto","parallel_tool_calls":true,"prompt_cache_key":"68f9e133-3e7d-4ece-bd66-ff5554dddb1a","prompt_cache_retention":"24h","text":{"format":{"type":"text"},"verbosity":"low"},"top_p":0.98,"top_logprobs":0,"temperature":1.0,"reasoning":{"effort":"medium","summary":"detailed","context":"all_turns","mode":"standard"},"user":null,"usage":{"input_tokens":13574,"input_tokens_details":{"cached_tokens":0,"cache_write_tokens":0},"output_tokens":19