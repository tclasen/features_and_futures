\n  if (!object(document) || document.format !== 'workboard-project' || document.version !== 1) return false;\\n  const project = document.project;\\n  return object(project) && nonblank(project.name) && typeof project.archived === 'boolean'\\n    && priorities.includes(project.defaultPriority) && Array.isArray(project.tasks)\\n    && project.tasks.every((task) => object(task) && nonblank(task.title)\\n      && typeof task.completed === 'boolean' && priorities.includes(task.priority)\\n      && typeof task.dueDate === 'string' && validDueDate(task.dueDate)\\n      && typeof task.notes === 'string' && typeof task.deleted === 'boolean');\\n}\\n\\nconst insertImportedProject = db.prepare('INSERT INTO projects (name, archived, default_priority) VALUES (?, ?, ?)');\\nconst insertImportedTask = db.prepare(`\\n  INSERT INTO tasks (project_id, title, completed, priority, due_date, notes, deleted, sort_order)\\n  VALUES (?, ?, ?, ?, ?, ?, ?, ?)\\n`);\\n\\nfunction importProject(name, project) {\\n  return transaction(() => {\\n    const projectId = insertImportedProject.run(name, Number(project.archived), project.defaultPriority).lastInsertRowid;\\n    project.tasks.forEach((task, index) => {\\n      const position = index + 1;\\n      const taskId = insertImportedTask.run(projectId, task.title, Number(task.completed), task.priority,\\n        task.dueDate, task.notes.replace(/\\\\r\\\\n?/g, '\\\\n'), Number(task.deleted), position).lastInsertRowid;\\n      rememberPosition.run(taskId, projectId, position);\\n    });\\n    return projectId;\\n  });\\n}\\n\\nfunction escapeHtml(value) {\"},{\"oldText\":\"function projectsPage(error = '', filter = 'Active', query = '') {\",\"newText\":\"function projectsPage(error = '', filter = 'Active', query = '', importValues = {}) {\"},{\"oldText\":\"    <form class=\\\"filter\\\" method=\\\"get\\\" action=\\\"/\\\">\\n      ${searchField}\",\"newText\":\"    <form class=\\\"create\\\" method=\\\"post\\\" action=\\\"/projects/import\\\">\\n      <input type=\\\"hidden\\\" name=\\\"filter\\\" value=\\\"${filter}\\\">\\n      ${searchField}\\n      <label for=\\\"project-json\\\">Project JSON</label>\\n      <textarea id=\\\"project-json\\\" name=\\\"json\\\" rows=\\\"6\\\">${escapeHtml(importValues.json || '')}</textarea>\\n      <label for=\\\"imported-project-name\\\">Imported project name</label>\\n      <input id=\\\"imported-project-name\\\" name=\\\"name\\\" type=\\\"text\\\" value=\\\"${escapeHtml(importValues.name || '')}\\\">\\n      <button type=\\\"submit\\\">Import project</button>\\n    </form>\\n    <form class=\\\"filter\\\" method=\\\"get\\\" action=\\\"/\\\">\\n      ${searchField}\"},{\"oldText\":\"async function readForm(request) {\",\"newText\":\"async function readForm(request, maxSize = 65536) {\"},{\"oldText\":\"    if (size > 65536) {\",\"newText\":\"    if (size > maxSize) {\"},{\"oldText\":\"    } else if (request.method === 'POST' && url.pathname === '/projects') {\",\"newText\":\"    } else if (request.method === 'POST' && url.pathname === '/projects/import') {\\n      const form = await readForm(request, Infinity);\\n      const values = { json: form.get('json') || '', name: form.get('name') || '' };\\n      const name = values.name.trim();\\n      let document;\\n      try { document = JSON.parse(values.json); } catch { /* Invalid JSON is reported below. */ }\\n      const error = !name ? 'Project name is required'\\n        : !validProjectDocument(document) ? 'Invalid project JSON' : '';\\n      if (error) {\\n        html(response, 400, projectsPage(error, projectFilter(form.get('filter')), searchQuery(form), values));\\n        return;\\n      }\\n      const projectId = importProject(name, document.project);\\n      response.writeHead(303, { Location: `/projects/${projectId}` });\\n      response.end();\\n    } else if (request.method === 'POST' && url.pathname === '/projects') {\"}]}","status":"completed"}],"error":null,"incomplete_details":null,"tools":[{"type":"function","name":"read","description":"Read the contents of a file. Supports text files and images (jpg, png, gif, webp, bmp). Images are sent as attachments. For text files, output is truncated to 2000 lines or 50KB (whichever is hit first). Use offset/limit for large files. When you need the full file, continue with offset until complete.","parameters":{"type":"object","required":["path","offset","limit"],"properties":{"path":{"type":"string","description":"Path to the file to read (relative or absolute)"},"offset":{"anyOf":[{"type":"number","description":"Line number to start reading from (1-indexed)"},{"type":"null"}]},"limit":{"anyOf":[{"type":"number","description":"Maximum number of lines to read"},{"type":"null"}]}},"additionalProperties":false},"output_schema":null,"strict":true},{"type":"function","name":"bash","description":"Execute a bash command in the current working directory. Returns stdout and stderr. Output is truncated to last 2000 lines or 50KB (whichever is hit first). If truncated, full output is saved to a temp file. Optionally provide a timeout in seconds.","parameters":{"type":"object","required":["command","timeout"],"properties":{"command":{"type":"string","description":"Shell command to execute"},"timeout":{"anyOf":[{"type":"number","description":"Timeout in seconds (optional, no default timeout)"},{"type":"null"}]}},"additionalProperties":false},"output_schema":null,"strict":true},{"type":"function","name":"edit","description":"Edit a single file using exact text replacement. Every edits[].oldText must match a unique, non-overlapping region of the original file. If two changes affect the same block or nearby lines, merge them into one edit instead of emitting overlapping edits. Do not include large unchanged regions just to connect distant changes.","parameters":{"type":"object","required":["path","edits"],"properties":{"path":{"type":"string","description":"Path to the file to edit (relative or absolute)"},"edits":{"type":"array","items":{"type":"object","required":["oldText","newText"],"properties":{"oldText":{"type":"string","description":"Exact text for one targeted replacement. It must be unique in the original file and must not overlap with any other edits[].oldText in the same call."},"newText":{"type":"string","description":"Replacement text for this targeted edit."}},"additionalProperties":false},"description":"One or more targeted replacements. Each edit is matched against the original file, not incrementally. Do not include overlapping or nested edits. If two changes touch the same block or nearby lines, merge them into one edit instead."}},"additionalProperties":false},"output_schema":null,"strict":true},{"type":"function","name":"write","description":"Write content to a file. Creates the file if it doesn't exist, overwrites if it does. Automatically creates parent directories.","parameters":{"type":"object","required":["path","content"],"properties":{"path":{"type":"string","description":"Path to the file to write (relative or absolute)"},"content":{"type":"string","description":"Content to write to the file"}},"additionalProperties":false},"output_schema":null,"strict":true}],"tool_choice":"auto","parallel_tool_calls":true,"prompt_cache_key":"1e48a223-854f-4aca-b957-3ff0e4f8409f","prompt_cache_retention":"24h","text":{"format":{"type":"text"},"verbosity":"low"},"top_p":0.98,"top_logprobs":0,"temperature":1.0,"reasoning":{"effort":"medium","summary":"detailed","context":"all_turns","mode":"standard"},"user":null,"usage":{"input_tokens":13827,"input_tokens_details":{"cached_tokens":5504,"cache_write_tokens":0},"output_tokens":1168,"output_tokens_details":{"reasoning_tokens":139},"total_tokens":14995,"attribution":{"items":{"fc_0c96195ccc6f49a8016acd3041d84481958122e387a413bff9":{"input_tokens":34,"cached_tokens":0,"cache_write_tokens":0,"output_tokens":0},"fc_0c96195ccc6f49a8016acd3044c3b081958de116fa4aec1c20":{"input_tokens":28,"cached_tokens":0,"cache_write_tokens":0,"output_tokens":0},