  try {\\n    server = await startServer(databasePath);\\n    await create(server.baseUrl, 'Original');\\n    await post(server.baseUrl, '/projects/1/tasks', { title: 'Original task' });\\n    const task = { title: '  Exact  Title 📝  ', completed: true, priority: 'High',\\n      dueDate: '2000-02-29', notes: '  <script>& 📝\\\\r\\\\nsecond\\\\rline  ', deleted: false };\\n    const document = { format: 'workboard-project', version: 1,\\n      project: { name: 'Portable', archived: false, defaultPriority: 'Low',\\n        tasks: [task, { ...task, title: 'Deleted', deleted: true, dueDate: '', notes: '' }] } };\\n    const snapshot = () => {\\n      const db = new DatabaseSync(databasePath);\\n      try { return ['projects', 'tasks', 'task_positions'].map((table) =>\\n        db.prepare(`SELECT * FROM ${table} ORDER BY 1, 2`).all()); }\\n      finally { db.close(); }\\n    };\\n    const before = snapshot();\\n    const invalid = ['{', '{}'];\\n    const change = (mutate) => {\\n      const copy = structuredClone(document);\\n      mutate(copy);\\n      invalid.push(JSON.stringify(copy));\\n    };\\n    change((d) => { d.format = 'other'; });\\n    change((d) => { d.version = '1'; });\\n    change((d) => { d.version = 2; });\\n    change((d) => { d.project = []; });\\n    change((d) => { d.project.name = ' \\\\t '; });\\n    change((d) => { d.project.archived = 0; });\\n    change((d) => { d.project.defaultPriority = 'Urgent'; });\\n    change((d) => { d.project.tasks = {}; });\\n    for (const key of Object.keys(task)) {\\n      change((d) => { delete d.project.tasks[1][key]; });\\n      change((d) => { d.project.tasks[1][key] = null; });\\n    }\\n    for (const date of ['1900-02-29', '0000-01-01', '2025-04-31', '2025-1-01', ' 2025-01-01 ', '9999-12-32']) {\\n      change((d) => { d.project.tasks[1].dueDate = date; });\\n    }\\n    change((d) => { d.project.tasks[1].title = '\\\\t '; });\\n    change((d) => { d.project.tasks[1].priority = 'low'; });\\n    for (const json of invalid) {\\n      const response = await post(server.baseUrl, '/projects/import', { json, name: '  Copy  ' });\\n      assert.equal(response.status, 400);\\n      const html = await response.text();\\n      assert.match(html, /role=\\\"alert\\\">Invalid project JSON/);\\n      assert.match(html, /value=\\\"  Copy  \\\"/);\\n      assert.deepEqual(snapshot(), before);\\n    }\\n    const blank = await post(server.baseUrl, '/projects/import', { json: JSON.stringify(document), name: ' \\\\t ' });\\n    assert.match(await blank.text(), /role=\\\"alert\\\">Project name is required/);\\n    assert.deepEqual(snapshot(), before);\\n    // Additional properties cannot choose application IDs or ordering positions.\\n    document.project.id = 1;\\n    document.project.tasks[0].id = 1;\\n    document.project.tasks[0].position = -999;\\n    const response = await post(server.baseUrl, '/projects/import', { json: JSON.stringify(document), name: '  Copy  ' });\\n    assert.equal(response.status, 303);\\n    assert.equal(response.headers.get('location'), '/projects/2');\\n    const expected = structuredClone(document);\\n    delete expected.project.id;\\n    delete expected.project.tasks[0].id;\\n    delete expected.project.tasks[0].position;\\n    expected.project.name = 'Copy';\\n    expected.project.tasks[0].notes = task.notes.replace(/\\\\r\\\\n?/g, '\\\\n');\\n    const download = async (id) => (await fetch(`${server.baseUrl}/projects/${id}/download`)).json();\\n    assert.deepEqual(await download(2), expected);\\n    assert.deepEqual(projectSummaries(await (await fetch(`${server.baseUrl}/`)).text()), ['0/1 completed', '1/1 completed']);\\n    await post(server.baseUrl, '/projects/2/tasks', { title: 'Later' });\\n    await post(server.baseUrl, '/projects/2/tasks/3/restore', { filter: 'Deleted' });\\n    assert.deepEqual((await download(2)).project.tasks.map((t) => t.title), [task.title, 'Deleted', 'Later']);\\n    await post(server.baseUrl, '/projects/2/tasks/2/move', { destination: '1' });\\n    await post(server.baseUrl, '/projects/1/tasks/2/move', { destination: '2' });\\n    assert.deepEqual((await download(2)).project.tasks.map((t) => t.title), [task.title, 'Deleted', 'Later']);\\n    assert.equal((await download(1)).project.tasks[0].title, 'Original task');\\n    const saved = await download(2);\\n    await server.stop();\\n    server = await startServer(databasePath);\\n    assert.deepEqual(await download(2), saved);\\n    document.project.archived = true;\\n    const archived = await post(server.baseUrl, '/projects/import', { json: JSON.stringify(document), name: 'Archived copy' });\\n    assert.equal(archived.headers.get('location'), '/projects/3');\\n    const html = await (await fetch(`${server.baseUrl}/projects/3?filter=Deleted`)).text();\\n    assert.match(html, /Archived project/);\\n    assert.match(html, /disabled>Restore task/);\\n    await post(server.baseUrl, '/projects/3/restore', {});\\n    assert.equal((await download(3)).project.tasks[1].deleted, true);\\n    const empty = structuredClone(document);\\n    empty.project.tasks = [];\\n    assert.equal((await post(server.baseUrl, '/projects/import', { json: JSON.stringify(empty), name: 'Empty' })).status, 303);\\n    assert.deepEqual((await download(4)).project.tasks, []);\\n  } finally {\\n    if (server) await server.stop();\\n    await rm(directory, { recursive: true, force: true });\\n  }\\n});\\n\\ntest('portable project downloads include all ordered state without changing data or filters'\"}]}","status":"completed"}],"error":null,"incomplete_details":null,"tools":[{"type":"function","name":"read","description":"Read the contents of a file. Supports text files and images (jpg, png, gif, webp, bmp). Images are sent as attachments. For text files, output is truncated to 2000 lines or 50KB (whichever is hit first). Use offset/limit for large files. When you need the full file, continue with offset until complete.","parameters":{"type":"object","required":["path","offset","limit"],"properties":{"path":{"type":"string","description":"Path to the file to read (relative or absolute)"},"offset":{"anyOf":[{"type":"number","description":"Line number to start reading from (1-indexed)"},{"type":"null"}]},"limit":{"anyOf":[{"type":"number","description":"Maximum number of lines to read"},{"type":"null"}]}},"additionalProperties":false},"output_schema":null,"strict":true},{"type":"function","name":"bash","description":"Execute a bash command in the current working directory. Returns stdout and stderr. Output is truncated to last 2000 lines or 50KB (whichever is hit first). If truncated, full output is saved to a temp file. Optionally provide a timeout in seconds.","parameters":{"type":"object","required":["command","timeout"],"properties":{"command":{"type":"string","description":"Shell command to execute"},"timeout":{"anyOf":[{"type":"number","description":"Timeout in seconds (optional, no default timeout)"},{"type":"null"}]}},"additionalProperties":false},"output_schema":null,"strict":true},{"type":"function","name":"edit","description":"Edit a single file using exact text replacement. Every edits[].oldText must match a unique, non-overlapping region of the original file. If two changes affect the same block or nearby lines, merge them into one edit instead of emitting overlapping edits. Do not include large unchanged regions just to connect distant changes.","parameters":{"type":"object","required":["path","edits"],"properties":{"path":{"type":"string","description":"Path to the file to edit (relative or absolute)"},"edits":{"type":"array","items":{"type":"object","required":["oldText","newText"],"properties":{"oldText":{"type":"string","description":"Exact text for one targeted replacement. It must be unique in the original file and must not overlap with any other edits[].oldText in the same call."},"newText":{"type":"string","description":"Replacement text for this targeted edit."}},"additionalProperties":false},"description":"One or more targeted replacements. Each edit is matched against the original file, not incrementally. Do not include overlapping or nested edits. If two changes touch the same block or nearby lines, merge them into one edit instead."}},"additionalProperties":false},"output_schema":null,"strict":true},{"type":"function","name":"write","description":"Write content to a file. Creates the file if it doesn't exist, overwrites if it does. Automatically creates parent directories.","parameters":{"type":"object","required":["path","content"],"properties":{"path":{"type":"string","description":"Path to the file to write (relative or absolute)"},"content":{"type":"string","description":"Content to write to the file"}},"additionalProperties":false},"output_schema":null,"strict":true}],"tool_choice":"auto","parallel_tool_calls":true,"prompt_cache_key":"fcc8bd74-ae96-4ce2-9a28-29874080a054","prompt_cache_retention":"24h","text":{"format":{"type":"text"},"verbosity":"low"},"top_p":0.98,"top_logprobs":0,"temperature":1.0,"reasoning":{"effort":"medium","summary":"detailed","context":"all_turns","mode":"standard"},"user":null,"usage":{"input_tokens":17646,"input_tokens_details":{"cached_tokens":0,"cache_write_tokens":0},"output_tokens":1665,"output_tokens_details":{"reasoning_tokens":26},"total_tokens":19311,"attribution":{"items":{"fc_0509ef6a69b5530f016acd30440bac87d29cb7c2f2a427e843":{"input_tokens":34,"cached_tokens":0,"cache_write_tokens":0,"output_tokens":0},"fc_0509ef6a69b5530f016acd30471ca887d2859cdd63337e5d7c":{"input_tokens":28,"cached_tokens":0,"cache_write_tokens":0,"output_tokens":0},"fc_0509ef6a69b5530f016acd3049f9a887d282be8349798d336f":{"input_tokens":37,"cached_tokens":0,"cache_write_tokens":0,"output_tokens":0},"fc_0509ef6a69b5530f016acd304d0b3087d2b826c51725c4bdcb":{"input_tokens":30,"cached_tokens":0,"cache_write_tokens":0,"output_tokens":0},"fc_0509ef6a69b5530f016acd30524e0c87d2bb94deebd3653c8c":{"input_tokens":1017,"cached_tokens":0,"cache_write_tokens":0,"o