che_write_tokens":0,"cached_tokens":0,"input_tokens":2,"output_tokens":0}],"input_tokens":22,"output_tokens":0},"rs_08d3d36d5ff3e846016acd306485048196a109d17f6be686a2":{"cache_write_tokens":0,"cached_tokens":0,"input_tokens":2,"output_tokens":20},"msg_08d3d36d5ff3e846016acd306545208196a4312ccaffb06c6f":{"cache_write_tokens":0,"cached_tokens":0,"content":[{"cache_write_tokens":0,"cached_tokens":0,"input_tokens":0,"output_tokens":64}],"input_tokens":0,"output_tokens":64},"ctc_08d3d36d5ff3e846016acd306743988196ae93530ec9c0afcd":{"cache_write_tokens":0,"cached_tokens":0,"input_tokens":0,"output_tokens":2850}}},"input_tokens":34570,"input_tokens_details":{"cache_write_tokens":0,"cached_tokens":9088},"output_tokens":2934,"output_tokens_details":{"reasoning_tokens":20},"total_tokens":37504},"user":null,"metadata":{}},"sequence_number":2907}
