data: {"type":"response.output_item.done","sequence_number":1454,"output_index":1,"item":{"type":"function_call","id":"fc_0398d395664ca68f016acd1cd16a7c819099670b955bffdfe4","call_id":"call_aa5e4f96f2b54101b3ac4c3ed904ce24","name":"edit","arguments":"{\"path\":\"test/projects.test.js\",\"edits\":[{\"oldText\":\"test('task priorities migrate, remain independent, and persist through rename and archive', async () => {\",\"newText\":\"test('combined priority and completion filters preserve selections through edits and archive', async () => {\\n  const directory = await mkdtemp(join(tmpdir(), 'workboard-filters-'));\\n  const databasePath = join(directory, 'projects.sqlite');\\n  let server;\\n  try {\\n    server = await start(databasePath);\\n    const get = async (path) => (await fetch(server.baseUrl + path)).text();\\n    const post = (path, values = {}) => fetch(server.baseUrl + path, {\\n      method: 'POST', body: new URLSearchParams(values), redirect: 'manual',\\n    });\\n    const rows = (body) => [...body.matchAll(/aria-label=\\\"Complete ([^\\\"]+)\\\"/g)].map((match) => match[1]);\\n    const selection = (body, id, expected, options) => {\\n      const select = body.match(new RegExp(`<select id=\\\"${id}\\\"[^>]*>([\\\\\\\\s\\\\\\\\S]*?)</select>`));\\n      assert.ok(select);\\n      assert.doesNotMatch(select[0], / disabled/);\\n      assert.equal(select[1].trim(), options.map((value) =>\\n        `<option${value === expected ? ' selected' : ''}>${value}</option>`).join(''));\\n    };\\n    await post('/projects', { name: 'Filters' });\\n    const tasks = [];\\n    for (const priority of ['Low', 'Normal', 'High']) {\\n      for (const completed of [false, true]) {\\n        const id = tasks.length + 1;\\n        const title = `${priority} ${completed ? 'done' : 'open'}`;\\n        tasks.push({ id, title, priority, completed });\\n        await post('/projects/1/tasks', { title });\\n        await post(`/projects/1/tasks/${id}/priority`, { priority });\\n        if (completed) await post(`/projects/1/tasks/${id}`, { completed: '1' });\\n      }\\n    }\\n    const summary = await get('/');\\n    assert.match(summary, /3\\\\/6 completed/);\\n    for (const filter of ['All', 'Open', 'Completed']) {\\n      for (const priorityFilter of ['All', 'Low', 'Normal', 'High']) {\\n        const body = await get(`/projects/1?filter=${filter}&priorityFilter=${priorityFilter}`);\\n        selection(body, 'task-filter', filter, ['All', 'Open', 'Completed']);\\n        selection(body, 'priority-filter', priorityFilter, ['All', 'Low', 'Normal', 'High']);\\n        assert.deepEqual(rows(body), tasks.filter((task) =>\\n          (filter === 'All' || task.completed === (filter === 'Completed')) &&\\n          (priorityFilter === 'All' || task.priority === priorityFilter)).map((task) => task.title));\\n      }\\n    }\\n    const values = { filter: 'Open', priorityFilter: 'High' };\\n    const path = '/projects/1?filter=Open&priorityFilter=High';\\n    let response = await post('/projects/1/tasks/5/rename', { ...values, title: '  Renamed  ' });\\n    assert.equal(response.headers.get('location'), path);\\n    assert.deepEqual(rows(await get(path)), ['Renamed']);\\n    response = await post('/projects/1/tasks/5/rename', { ...values, title: ' ' });\\n    const invalid = await response.text();\\n    assert.match(invalid, /role=\\\"alert\\\">Task title is required/);\\n    selection(invalid, 'task-filter', 'Open', ['All', 'Open', 'Completed']);\\n    selection(invalid, 'priority-filter', 'High', ['All', 'Low', 'Normal', 'High']);\\n    assert.deepEqual(rows(invalid), ['Renamed']);\\n    response = await post('/projects/1/tasks/5/priority', { ...values, priority: 'Low' });\\n    assert.equal(response.headers.get('location'), path);\\n    assert.deepEqual(rows(await get(path)), []);\\n    assert.equal(await get('/'), summary);\\n    await post('/projects/1/tasks/1/priority', { ...values, priority: 'High' });\\n    assert.deepEqual(rows(await get(path)), ['Low open']);\\n    response = await post('/projects/1/tasks/1', { ...values, completed: '1' });\\n    assert.equal(response.headers.get('location'), path);\\n    assert.deepEqual(rows(await get(path)), []);\\n    const saved = await get('/projects/1?filter=Completed&priorityFilter=High');\\n    await server.stop();\\n    server = await start(databasePath);\\n    assert.equal(await get('/projects/1?filter=Completed&priorityFilter=High'), saved);\\n    selection(await get('/projects/1'), 'priority-filter', 'All', ['All', 'Low', 'Normal', 'High']);\\n    await post('/projects/1/archive');\\n    const archived = await get('/projects/1?filter=Completed&priorityFilter=High');\\n    assert.deepEqual(rows(archived), ['Low open', 'High done']);\\n    selection(archived, 'priority-filter', 'High', ['All', 'Low', 'Normal', 'High']);\\n    assert.match(archived, /name=\\\"completed\\\"[^>]* disabled/);\\n    assert.match(archived, /name=\\\"priority\\\" disabled/);\\n    assert.match(archived, /name=\\\"title\\\" type=\\\"text\\\" disabled/);\\n    await post('/projects/1/restore');\\n    assert.equal(await get('/projects/1?filter=Completed&priorityFilter=High'), saved);\\n  } finally {\\n    if (server) await server.stop();\\n    await rm(directory, { recursive: true, force: true });\\n  }\\n});\\n\\ntest('task priorities migrate, remain independent, and persist through rename and archive', async () => {\"}]}","status":"completed"}}

