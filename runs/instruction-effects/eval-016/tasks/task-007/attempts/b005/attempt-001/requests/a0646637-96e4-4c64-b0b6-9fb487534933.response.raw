() => {\\n  const directory = await mkdtemp(join(tmpdir(), 'workboard-filters-'));\\n  let server;\\n  try {\\n    const databasePath = join(directory, 'board.sqlite');\\n    server = await startServer(databasePath);\\n    const get = async (path = '/') => (await fetch(`${server.baseUrl}${path}`)).text();\\n    await create(server.baseUrl, 'Filtered');\\n    const path = '/projects/1';\\n    for (const title of ['First', 'Second', 'Third', 'Fourth']) {\\n      await post(server.baseUrl, `${path}/tasks`, { title });\\n    }\\n    await post(server.baseUrl, `${path}/tasks/1/priority`, { priority: 'High' });\\n    await post(server.baseUrl, `${path}/tasks/3/priority`, { priority: 'High' });\\n    await post(server.baseUrl, `${path}/tasks/4/priority`, { priority: 'Low' });\\n    await post(server.baseUrl, `${path}/tasks/3/completion`, { completed: '1' });\\n    const selections = (html, completion, priority) => {\\n      for (const [id, value] of [['task-filter', completion], ['priority-filter', priority]]) {\\n        const select = html.match(new RegExp(`<select id=\\\"${id}\\\"[^>]*>([\\\\\\\\s\\\\\\\\S]*?)</select>`));\\n        assert.ok(select);\\n        assert.doesNotMatch(select[0], / disabled/);\\n        assert.ok(select[1].includes(`<option selected>${value}</option>`));\\n      }\\n    };\\n    const initial = await get(path);\\n    selections(initial, 'All', 'All');\\n    assert.deepEqual([...initial.match(/<select id=\\\"priority-filter\\\"[^>]*>([\\\\s\\\\S]*?)<\\\\/select>/)[1]\\n      .matchAll(/<option(?: selected)?>(.*?)<\\\\/option>/g)].map((m) => m[1]), ['All', 'Low', 'Normal', 'High']);\\n    const expected = {\\n      All: { All: ['First', 'Second', 'Third', 'Fourth'], Low: ['Fourth'], Normal: ['Second'], High: ['First', 'Third'] },\\n      Open: { All: ['First', 'Second', 'Fourth'], Low: ['Fourth'], Normal: ['Second'], High: ['First'] },\\n      Completed: { All: ['Third'], Low: [], Normal: [], High: ['Third'] },\\n    };\\n    for (const [completion, priorities] of Object.entries(expected)) {\\n      for (const [priority, titles] of Object.entries(priorities)) {\\n        const html = await get(`${path}?filter=${completion}&priorityFilter=${priority}`);\\n        selections(html, completion, priority);\\n        assert.deepEqual(taskRows(html).map((row) => row.title), titles);\\n      }\\n    }\\n    const fields = { filter: 'Open', priorityFilter: 'High' };\\n    const edit = async (action, values) => {\\n      const response = await post(server.baseUrl, `${path}/tasks/1/${action}`, { ...fields, ...values });\\n      assert.equal(response.status, 303);\\n      assert.equal(response.headers.get('location'), `${path}?filter=Open&priorityFilter=High`);\\n      const html = await get(response.headers.get('location'));\\n      selections(html, 'Open', 'High');\\n      return html;\\n    };\\n    let html = await edit('rename', { title: ' Renamed ' });\\n    assert.deepEqual(taskRows(html).map((row) => row.title), ['Renamed']);\\n    assert.match(html, /aria-label=\\\"Complete Renamed\\\"/);\\n    const invalid = await post(server.baseUrl, `${path}/tasks/1/rename`, { ...fields, title: ' ' });\\n    selections(await invalid.text(), 'Open', 'High');\\n    html = await edit('priority', { priority: 'Low' });\\n    assert.equal(taskRows(html).length, 0);\\n    await edit('priority', { priority: 'High' });\\n    html = await edit('completion', { completed: '1' });\\n    assert.equal(taskRows(html).length, 0);\\n    assert.deepEqual(projectSummaries(await get()), ['2/4 completed']);\\n    await post(server.baseUrl, `${path}/archive`, {});\\n    html = await get(`${path}?filter=Completed&priorityFilter=High`);\\n    selections(html, 'Completed', 'High');\\n    assert.deepEqual(taskRows(html).map((row) => row.title), ['Renamed', 'Third']);\\n    assert.ok(priorityControls(html).every((control) => control.disabled));\\n    await post(server.baseUrl, `${path}/restore`, {});\\n    await server.stop();\\n    server = await startServer(databasePath);\\n    html = await get(`${path}?filter=Completed&priorityFilter=High`);\\n    assert.deepEqual(taskRows(html).map((row) => row.title), ['Renamed', 'Third']);\\n    assert.ok(priorityControls(html).every((control) => !control.disabled && control.selected === 'High'));\\n    selections(await get(path), 'All', 'All');\\n    assert.deepEqual(projectSummaries(await get()), ['2/4 completed']);\\n  } finally {\\n    if (server) await server.stop();\\n    await rm(directory, { recursive: true, force: true });\\n  }\\n});\\n\\ntest('priorities default, persist independently, preserve task data and respect archives',\"}]}","status":"completed"}],"error":null,"incomplete_details":null,"tools":[{"type":"function","name":"read","description":"Read the contents of a file. Supports text files and images (jpg, png, gif, webp, bmp). Images are sent as attachments. For text files, output is truncated to 2000 lines or 50KB (whichever is hit first). Use offset/limit for large files. When you need the full file, continue with offset until complete.","parameters":{"type":"object","required":["path","offset","limit"],"properties":{"path":{"type":"string","description":"Path to the file to read (relative or absolute)"},"offset":{"anyOf":[{"type":"number","description":"Line number to start reading from (1-indexed)"},{"type":"null"}]},"limit":{"anyOf":[{"type":"number","description":"Maximum number of lines to read"},{"type":"null"}]}},"additionalProperties":false},"output_schema":null,"strict":true},{"type":"function","name":"bash","description":"Execute a bash command in the current working directory. Returns stdout and stderr. Output is truncated to last 2000 lines or 50KB (whichever is hit first). If truncated, full output is saved to a temp file. Optionally provide a timeout in seconds.","parameters":{"type":"object","required":["command","timeout"],"properties":{"command":{"type":"string","description":"Shell command to execute"},"timeout":{"anyOf":[{"type":"number","description":"Timeout in seconds (optional, no default timeout)"},{"type":"null"}]}},"additionalProperties":false},"output_schema":null,"strict":true},{"type":"function","name":"edit","description":"Edit a single file using exact text replacement. Every edits[].oldText must match a unique, non-overlapping region of the original file. If two changes affect the same block or nearby lines, merge them into one edit instead of emitting overlapping edits. Do not include large unchanged regions just to connect distant changes.","parameters":{"type":"object","required":["path","edits"],"properties":{"path":{"type":"string","description":"Path to the file to edit (relative or absolute)"},"edits":{"type":"array","items":{"type":"object","required":["oldText","newText"],"properties":{"oldText":{"type":"string","description":"Exact text for one targeted replacement. It must be unique in the original file and must not overlap with any other edits[].oldText in the same call."},"newText":{"type":"string","description":"Replacement text for this targeted edit."}},"additionalProperties":false},"description":"One or more targeted replacements. Each edit is matched against the original file, not incrementally. Do not include overlapping or nested edits. If two changes touch the same block or nearby lines, merge them into one edit instead."}},"additionalProperties":false},"output_schema":null,"strict":true},{"type":"function","name":"write","description":"Write content to a file. Creates the file if it doesn't exist, overwrites if it does. Automatically creates parent directories.","parameters":{"type":"object","required":["path","content"],"properties":{"path":{"type":"string","description":"Path to the file to write (relative or absolute)"},"content":{"type":"string","description":"Content to write to the file"}},"additionalProperties":false},"output_schema":null,"strict":true}],"tool_choice":"auto","parallel_tool_calls":true,"prompt_cache_key":"4c5bbf61-0818-403a-a0e2-2b6