\\n  const tasks = matchingDirectoryTasks(scope, filter, priority, range, search);\\n  const editable = scope === 'Active' && filter !== 'Deleted';\\n  const rows = tasks.map((task) => `\"},{\"oldText\":\"      <button type=\\\"submit\\\">Search directory</button>\\n    </form>\\n    <div data-filter-results>${rows ? `<ul class=\\\"projects\\\">${rows}</ul>` : '<p class=\\\"empty\\\">No matching tasks.</p>'}</div>\",\"newText\":\"      <button type=\\\"submit\\\">Search directory</button>\\n    </form>\\n    <div data-filter-results>\\n      <form action=\\\"/directory/completion\\\" method=\\\"post\\\">\\n        <input type=\\\"hidden\\\" name=\\\"scope\\\" value=\\\"${scope}\\\">\\n        ${taskFilterFields(filter, priority, range, search)}\\n        <button type=\\\"submit\\\" name=\\\"completed\\\" value=\\\"1\\\" data-directory-action${editable && tasks.some((task) => !task.completed) ? '' : ' disabled'}>Complete visible tasks</button>\\n        <button type=\\\"submit\\\" name=\\\"completed\\\" value=\\\"0\\\" data-directory-action${editable && tasks.some((task) => task.completed) ? '' : ' disabled'}>Reopen visible tasks</button>\\n      </form>\\n      ${rows ? `<ul class=\\\"projects\\\">${rows}</ul>` : '<p class=\\\"empty\\\" data-directory-empty role=\\\"status\\\">No matching tasks</p>'}\\n    </div>\"},{\"oldText\":\"    } else if (request.method === 'POST' && url.pathname === '/projects/import') {\",\"newText\":\"    } else if (request.method === 'POST' && url.pathname === '/directory/completion') {\\n      const form = await readForm(request);\\n      const scope = projectFilter(form.get('scope'));\\n      const filter = taskFilter(form.get('filter'));\\n      const priority = priorityFilter(form.get('priorityFilter'));\\n      const search = readSearch(form);\\n      const range = readDueRange(form);\\n      const error = dueRangeError(range);\\n      if (error || !['0', '1'].includes(form.get('completed'))) {\\n        sendHtml(response, 400, directoryPage(scope, filter, priority, savedDueRange(form), search,\\n          error || 'Invalid completion state', range));\\n        return;\\n      }\\n      if (scope === 'Active' && filter !== 'Deleted') {\\n        inTransaction(() => {\\n          const completed = Number(form.get('completed'));\\n          for (const task of matchingDirectoryTasks(scope, filter, priority, range, search)) {\\n            if (task.completed !== completed) updateTask.run(completed, task.id, task.project_id);\\n          }\\n        });\\n      }\\n      const query = new URLSearchParams({ scope, filter, priorityFilter: priority,\\n        dueFrom: range.from, dueThrough: range.through, search });\\n      response.writeHead(303, { Location: `/directory?${query}` });\\n      response.end();\\n    } else if (request.method === 'POST' && url.pathname === '/projects/import') {\"}]}","status":"completed"}],"error":null,"incomplete_details":null,"tools":[{"type":"function","name":"read","description":"Read the contents of a file. Supports text files and images (jpg, png, gif, webp, bmp). Images are sent as attachments. For text files, output is truncated to 2000 lines or 50KB (whichever is hit first). Use offset/limit for large files. When you need the full file, continue with offset until complete.","parameters":{"type":"object","required":["path","offset","limit"],"properties":{"path":{"type":"string","description":"Path to the file to read (relative or absolute)"},"offset":{"anyOf":[{"type":"number","description":"Line number to start reading from (1-indexed)"},{"type":"null"}]},"limit":{"anyOf":[{"type":"number","description":"Maximum number of lines to read"},{"type":"null"}]}},"additionalProperties":false},"output_schema":null,"strict":true},{"type":"function","name":"bash","description":"Execute a bash command in the current working directory. Returns stdout and stderr. Output is truncated to last 2000 lines or 50KB (whichever is hit first). If truncated, full output is saved to a temp file. Optionally provide a timeout in seconds.","parameters":{"type":"object","required":["command","timeout"],"properties":{"command":{"type":"string","description":"Shell command to execute"},"timeout":{"anyOf":[{"type":"number","description":"Timeout in seconds (optional, no default timeout)"},{"type":"null"}]}},"additionalProperties":false},"output_schema":null,"strict":true},{"type":"function","name":"edit","description":"Edit a single file using exact text replacement. Every edits[].oldText must match a unique, non-overlapping region of the original file. If two changes affect the same block or nearby lines, merge them into one edit instead of emitting overlapping edits. Do not include large unchanged regions just to connect distant changes.","parameters":{"type":"object","required":["path","edits"],"properties":{"path":{"type":"string","description":"Path to the file to edit (relative or absolute)"},"edits":{"type":"array","items":{"type":"object","required":["oldText","newText"],"properties":{"oldText":{"type":"string","description":"Exact text for one targeted replacement. It must be unique in the original file and must not overlap with any other edits[].oldText in the same call."},"newText":{"type":"string","description":"Replacement text for this targeted edit."}},"additionalProperties":false},"description":"One or more targeted replacements. Each edit is matched against the original file, not incrementally. Do not include overlapping or nested edits. If two changes touch the same block or nearby lines, merge them into one edit instead."}},"additionalProperties":false},"output_schema":null,"strict":true},{"type":"function","name":"write","description":"Write content to a file. Creates the file if it doesn't exist, overwrites if it does. Automatically creates parent directories.","parameters":{"type":"object","required":["path","content"],"properties":{"path":{"type":"string","description":"Path to the file to write (relative or absolute)"},"content":