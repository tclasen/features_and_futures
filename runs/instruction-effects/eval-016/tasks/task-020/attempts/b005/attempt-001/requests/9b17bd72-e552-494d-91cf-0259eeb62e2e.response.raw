th = join(directory, 'board.sqlite');\\n  let server;\\n  try {\\n    server = await startServer(databasePath);\\n    const task = (title, fields = {}) => ({ title, completed: false, priority: 'High',\\n      dueDate: '2024-02-29', notes: '  literal <b>📝</b>\\\\n  ', deleted: false, ...fields });\\n    const imported = async (name, archived, tasks) => post(server.baseUrl, '/projects/import', {\\n      name, json: JSON.stringify({ format: 'workboard-project', version: 1,\\n        project: { name, archived, defaultPriority: 'Low', tasks } }),\\n    });\\n    await imported('First', false, [task('Hit  One'), task('Hit Two', { completed: true }),\\n      task('Hit Deleted', { deleted: true }), task('Hit Low', { priority: 'Low' }),\\n      task('Hit Undated', { dueDate: '' }), task('Miss'), task('Hit Later', { dueDate: '2024-03-01' })]);\\n    await imported('Second', false, [task('HIT\\\\tThree')]);\\n    await imported('Archived', true, [task('Hit Archived')]);\\n    const snapshot = () => {\\n      const db = new DatabaseSync(databasePath);\\n      try { return {\\n        tasks: db.prepare('SELECT * FROM tasks ORDER BY id').all(),\\n        projects: db.prepare('SELECT * FROM projects ORDER BY id').all(),\\n        positions: db.prepare('SELECT * FROM task_positions ORDER BY project_id, position').all(),\\n      }; } finally { db.close(); }\\n    };\\n    const before = snapshot();\\n    const fields = { scope: 'Active', filter: 'Open', priorityFilter: 'High',\\n      search: '  hit ', dueFrom: '2024-02-29', dueThrough: '2024-02-29' };\\n    const get = async (query = fields) => (await fetch(`${server.baseUrl}/directory?${new URLSearchParams(query)}`)).text();\\n    const enabled = (html, label) => !new RegExp(`<button[^>]*disabled[^>]*>${label}</button>`).test(html);\\n    let html = await get();\\n    assert.equal(enabled(html, 'Complete visible tasks'), true);\\n    assert.equal(enabled(html, 'Reopen visible tasks'), false);\\n    assert.deepEqual(directoryRows(html).map((row) => row.title), ['Hit  One', 'HIT\\\\tThree']);\\n    const bulk = (query, completed) => post(server.baseUrl, '/directory/completion', { ...query, completed });\\n    let response = await bulk(fields, '1');\\n    assert.equal(response.status, 303);\\n    const location = response.headers.get('location');\\n    assert.equal(new URL(location, server.baseUrl).searchParams.get('search'), 'hit');\\n    html = await (await fetch(`${server.baseUrl}${location}`)).text();\\n    assert.deepEqual(directoryRows(html), []);\\n    assert.match(html, />No matching tasks<\\\\/p>/);\\n    assert.equal(enabled(html, 'Complete visible tasks'), false);\\n    assert.equal(enabled(html, 'Reopen visible tasks'), false);\\n    const after = snapshot();\\n    assert.deepEqual(after.projects, before.projects);\\n    assert.deepEqual(after.positions, before.positions);\\n    assert.deepEqual(after.tasks, before.tasks.map((row) => ({ ...row,\\n      completed: [1, 8].includes(row.id) ? 1 : row.completed })));\\n    assert.deepEqual(projectSummaries(await (await fetch(server.baseUrl)).text()), ['2/6 completed', '1/1 completed']);\\n\\n    for (const query of [{ ...fields, scope: 'Archived' }, { ...fields, filter: 'Deleted' },\\n      { ...fields, search: 'no match' }]) {\\n      html = await get(query);\\n      assert.equal(enabled(html, 'Complete visible tasks'), false);\\n      assert.equal(enabled(html, 'Reopen visible tasks'), false);\\n      await bulk(query, '0');\\n      assert.deepEqual(snapshot(), after);\\n    }\\n    response = await bulk({ ...fields, dueFrom: '1900-02-29' }, '0');\\n    assert.equal(response.status, 400);\\n    assert.deepEqual(snapshot(), after);\\n    response = await bulk(fields, 'bad');\\n    assert.equal(response.status, 400);\\n    assert.deepEqual(snapshot(), after);\\n\\n    await server.stop();\\n    server = await startServer(databasePath);\\n    assert.deepEqual(snapshot(), after);\\n    const completedFields = { ...fields, filter: 'Completed' };\\n    html = await get(completedFields);\\n    assert.equal(enabled(html, 'Complete visible tasks'), false);\\n    assert.equal(enabled(html, 'Reopen visible tasks'), true);\\n    assert.equal(directoryRows(html).length, 3);\\n    response = await bulk(completedFields, '0');\\n    html = await (await fetch(`${server.baseUrl}${response.headers.get('location')}`)).text();\\n    assert.deepEqual(directoryRows(html), []);\\n    assert.match(html, /<option selected>Completed<\\\\/option>/);\\n    const reopened = snapshot();\\n    assert.deepEqual(reopened.tasks, before.tasks.map((row) => ({ ...row,\\n      completed: [1, 2, 8].includes(row.id) ? 0 : row.completed })));\\n    await server.stop();\\n    server = await startServer(databasePath);\\n    assert.deepEqual(snapshot(), reopened);\\n    await post(server.baseUrl, '/projects/1/tasks/1/move', { destination: '2' });\\n    await post(server.baseUrl, '/projects/2/tasks/1/move', { destination: '1' });\\n    assert.deepEqual(snapshot(), reopened);\\n    // All allows mixed completion states; repeated actions are idempotent.\\n    const all = { ...fields, filter: 'All' };\\n    await bulk(all, '1');\\n    const complete = snapshot();\\n    await bulk(all, '1');\\n    assert.deepEqual(snapshot(), complete);\\n    await bulk(all, '0');\\n    assert.deepEqual(snapshot(), reopened);\\n  } finally {\\n    if (server) await server.stop();\\n    await rm(directory, { recursive: true, force: true });\\n  }\\n});\\n\\ntest('task directory intersects read-only filters and preserves project order and stored data',\"}]}","status":"completed"}],"error":null,"incomplete_details":null,"tools":[{"type":"function","name":"read","description":"Read the contents of a file. Supports text files and images (jpg, png, gif, webp, bmp). Images are sent as attachments. For text files, output is truncated to 2000 lines or 50KB (whichever is hit first). Use offset/limit for large files. When you need the full file, continue with offset until complete.","parameters":{"type":"object","required":["path","offset","limit"],"properties":{"path":{"type":"string","description":"Path to the file to read (relative or absolute)"},"offset":{"anyOf":[{"type":"number","description":"Line number to start reading from (1-indexed)"},{"type":"null"}]},"limit":{"anyOf":[{"type":"number","description":"Maximum number of lines to read"},{"type":"null"}]}},"additionalProperties":false},"output_schema":null,"strict":true},{"type":"function","name":"bash","description":"Execute a bash command in the current working directory. Returns stdout and stderr. Output is truncated to last 2000 lines or 50KB (whichever is hit first). If truncated, full output is saved to a temp file. Optionally provide a timeout in seconds.","parameters":{"type":"object","required":["command","timeout"],"properties":{"command":{"type":"string","description":"Shell command to execute"},"timeout":{"anyOf":[{"type":"number","description":"Timeout in seconds (optional, no default timeout)"},{"type":"null"}]}},"additionalProperties":false},"output_schema":null,"strict":true},{"type":"function","name":"edit","description":"Edit a single file using exact text replacement. Every edits[].oldText must match a unique, non-overlapping region of the original file. If two changes affect the same block or nearby lines, merge them into one edit instead of emitting overlapping edits. Do not include large unchanged regions just to connect distant changes.","parameters":{"type":"object","required":["path","edits"],"properties":{"path":{"type":"string","description":"Path to the file to edit (relative or absolute)"},"edits":{"type":"array","items":{"type":"object","required":["oldText","newText"],"properties":{"oldText":{"type":"string","description":"Exact text for one targeted replacement. It must be unique in the original file and must not overlap with any other edits[].oldText in the same call."},"newText":{"type":"string","description":"Replacement text for this targeted edit."}},"additionalProperties":false},"description":"One or more targeted replacements. Each edit is matched against the original file, not incrementally. Do not include overlapping or nested edits. If two changes touch the same block or nearby lines, merge them into one edit instead."}},"additionalProperties":false},"output_schema":null,"strict":true},{"type":"function","name":"write","description":"Write content to a file. Creates the file if it doesn't exist, overwrites if it does. Automatically creates parent directories.","parameters":{"type":"object","required":["path","content"],"properties":{"path":{"type":"string","description":"Path to the file to write (relative or absolute)"},"content":{"type":"string","description":"Content to write to the file"}},"additionalProperties":false},"output_schema":null,"strict":true}],"tool_choice":"auto","parallel_tool_calls":true,"prompt_cache_key":"29c73657-db67-4eea-a1f3-2313f698e296","prompt_cache_retention":"24h","text":{"format":{"type":"text"},"verbosity":"low"},"top_p":0.98,"top_logprobs":0,"temperature":1.0,"reasoning":{"effort":"medium","summary":"detailed","context":"all_turns","mode":"standard"},"user":null,"usage":{"input_tokens":23984,"input_tokens_details":{"cached_tokens":4352,"cache_write_tokens":0},"output_tokens":1601,"output_tokens_details":{"reasoning_tokens":32},"total_tokens":25585,"attribution":{"items":{"fc_0a3f2212d385702a016acd35df71d887d2bb27a551f4b9981b":{"input_tokens":34,"cached_tokens":0,"cache_write_tokens":0,"output_tokens":0},"fc_0a3f2212d385702a016acd35e2543487d2b631b5a21b749f22":{"input_tokens":28,"cached_tokens":0,"cache_write_tokens":0,"output_tokens":0},"fc_0a3f2212d385702a016acd35e5802087d28f570bf64df7042a":{"input_tokens":47,"cached_tokens":0,"cache_write_tokens":0,"output_tokens":0},"fc_0a3f2212d385702a016acd35e8977487d2b1d450455c264c5b":{"input_tokens":29,"cached_tokens":0,"cache_write_tokens":0,"output_tokens":0},"fc_0a3f2212d385702a016acd35eabf9887d2b380b9d98f702999":{"inpu