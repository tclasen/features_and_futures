event: response.function_call_arguments.done
data: {"type":"response.function_call_arguments.done","sequence_number":615,"item_id":"fc_061e5d0a0b380629016acd35fa96e88193bb864919520bc4a3","output_index":0,"arguments":"{\"path\":\"public/index.html\",\"edits\":[{\"oldText\":\"<div id=\\\"directory-alert\\\" class=\\\"alert\\\" role=\\\"alert\\\" hidden></div><div id=\\\"directory-rows\\\" class=\\\"rows\\\"></div>`;\",\"newText\":\"<div id=\\\"directory-alert\\\" class=\\\"alert\\\" role=\\\"alert\\\" hidden></div><button id=\\\"complete-visible\\\" type=\\\"button\\\">Complete visible tasks</button><button id=\\\"reopen-visible\\\" type=\\\"button\\\">Reopen visible tasks</button><div id=\\\"directory-empty\\\" role=\\\"status\\\" hidden>No matching tasks</div><div id=\\\"directory-rows\\\" class=\\\"rows\\\"></div>`;\"},{\"oldText\":\"document.querySelector('#directory-rows').innerHTML=rows.filter(t=>!!t.archived===(scope==='Archived')&&(f==='Deleted'?!!t.deleted:!t.deleted&&(f==='All'||(f==='Open'&&!t.completed)||(f==='Completed'&&t.completed)))&&(priority==='All'||priority===t.priority)&&(!from&&!through||!!t.dueDate&&(!from||t.dueDate>=from)&&(!through||t.dueDate<=through))&&fold(t.title).includes(fold(query))).map(t=>`\",\"newText\":\"const visible=rows.filter(t=>!!t.archived===(scope==='Archived')&&(f==='Deleted'?!!t.deleted:!t.deleted&&(f==='All'||(f==='Open'&&!t.completed)||(f==='Completed'&&t.completed)))&&(priority==='All'||priority===t.priority)&&(!from&&!through||!!t.dueDate&&(!from||t.dueDate>=from)&&(!through||t.dueDate<=through))&&fold(t.title).includes(fold(query)));document.querySelector('#directory-empty').hidden=visible.length!==0;const bulkAllowed=scope==='Active'&&f!=='Deleted',open=visible.filter(t=>!t.completed),completed=visible.filter(t=>!!t.completed),complete=document.querySelector('#complete-visible'),reopen=document.querySelector('#reopen-visible');complete.disabled=!bulkAllowed||!open.length;reopen.disabled=!bulkAllowed||!completed.length;complete.onclick=()=>bulk(open,true);reopen.onclick=()=>bulk(completed,false);document.querySelector('#directory-rows').innerHTML=visible.map(t=>`\"},{\"oldText\":\"document.querySelectorAll('[data-project]').forEach(b=>b.onclick=()=>go(`/projects/${b.dataset.project}`))};\",\"newText\":\"document.querySelectorAll('[data-project]').forEach(b=>b.onclick=()=>go(`/projects/${b.dataset.project}`))};const bulk=async(items,completed)=>{const r=await fetch('/api/directory/bulk',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({ids:items.map(t=>t.id),completed})});if(r.ok){for(const t of items)t.completed=+completed;draw()}};\"}]}"}

