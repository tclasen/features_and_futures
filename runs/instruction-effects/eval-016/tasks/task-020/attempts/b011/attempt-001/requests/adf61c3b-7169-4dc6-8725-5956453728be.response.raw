ctor('#directory-rows').innerHTML=rows.filter(t=>!!t.archived===(scope==='Archived')&&(f==='Deleted'?!!t.deleted:!t.deleted&&(f==='All'||(f==='Open'&&!t.completed)||(f==='Completed'&&t.completed)))&&(priority==='All'||priority===t.priority)&&(!from&&!through||!!t.dueDate&&(!from||t.dueDate>=from)&&(!through||t.dueDate<=through))&&fold(t.title).includes(fold(query))).map(t=>`\",\"newText\":\"const visible=rows.filter(t=>!!t.archived===(scope==='Archived')&&(f==='Deleted'?!!t.deleted:!t.deleted&&(f==='All'||(f==='Open'&&!t.completed)||(f==='Completed'&&t.completed)))&&(priority==='All'||priority===t.priority)&&(!from&&!through||!!t.dueDate&&(!from||t.dueDate>=from)&&(!through||t.dueDate<=through))&&fold(t.title).includes(fold(query)));document.querySelector('#directory-empty').hidden=visible.length!==0;const bulkAllowed=scope==='Active'&&f!=='Deleted';const open=visible.filter(t=>!t.completed),completed=visible.filter(t=>!!t.completed);const complete=document.querySelector('#complete-visible'),reopen=document.querySelector('#reopen-visible');complete.disabled=!bulkAllowed||!open.length;reopen.disabled=!bulkAllowed||!completed.length;complete.onclick=()=>bulk(open,true);reopen.onclick=()=>bulk(completed,false);document.querySelector('#directory-rows').innerHTML=visible.map(t=>`\"},{\"oldText\":\"document.querySelectorAll('[data-project]').forEach(b=>b.onclick=()=>go(`/projects/${b.dataset.project}`))};\",\"newText\":\"document.querySelectorAll('[data-project]').forEach(b=>b.onclick=()=>go(`/projects/${b.dataset.project}`))};const bulk=async(items,completed)=>{const ids=items.map(t=>t.id);if(!ids.length)return;const r=await fetch('/api/directory/bulk',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({ids,completed})});if(r.ok){for(const t of items)t.completed=+completed;draw()}};\"}]}","status":"completed"}],"error":null,"incomplete_details":null,"tools":[{"type":"function","name":"read","description":"Read the contents of a file. Supports text files and images (jpg, png, gif, webp, bmp). Images are sent as attachments. For text files, output is truncated to 2000 lines or 50KB (whichever is hit first). Use offset/limit for large files. When you need the full file, continue with offset until complete.","parameters":{"type":"object","required":["path","offset","limit"],"properties":{"path":{"type":"string","description":"Path to the file to read (relative or absolute)"},"offset":{"anyOf":[{"type":"number","description":"Line number to start reading from (1-indexed)"},{"type":"null"}]},"limit":{"anyOf":[{"type":"number","description":"Maximum number of lines to read"},{"type":"null"}]}},"additionalProperties":false},"output_schema":null,"strict":true},{"type":"function","name":"bash","description":"Execute a bash command in the current working directory. Returns stdout and stderr. Output is truncated to last 2000 lines or 50KB (whichever is hit first). If truncated, full output is saved to a temp file. Optionally provide a timeout in seconds.","parameters":{"type":"object","required":["command","timeout"],"properties":{"command":{"type":"string","description":"Shell command to execute"},"timeout":{"anyOf":[{"type":"number","description":"Timeout in seconds (optional, no default timeout)"},{"type":"null"}]}},"additionalProperties":false},"output_schema":null,"strict":true},{"type":"function","name":"edit","description":"Edit a single file using exact text replacement. Every edits[].oldText must match a unique, non-overlapping region of the original file. If two changes affect the same block or nearby lines, merge them into one edit instead of emitting overlapping edits. Do not include large unchanged regions just to connect distant changes.","parameters":{"type":"object","required":["path","edits"],"properties":{"path":{"type":"string","description":"Path to the file to edit (relative or absolute)"},"edits":{"type":"array","items":{"type":"object","required":["oldText","newText"],"properties":{"oldText":{"type":"string","description":"Exact text for one targeted replacement. It must be unique in the original file and must not overlap with any other edits[].oldText in the same call."},"newText":{"type":"string","description":"Replacement text for this targeted edit."}},"additionalProperties":false},"description":"One or more targeted replacements. Each edit is matched against the original file, not incrementally. Do not include overlapping or nested edits. If two changes touch the same block or nearby lines, merge them into one edit instead."}},"additionalProperties":false},"output_schema":null,"strict":true},{"type":"function","name":"write","description":"Write content to a file. Creates the file if it doesn't exist, overwrites if it does. Automatically creates parent directories.","parameters":{"type":"object","required":["path","content"],"properties":{"path":{"type":"string","description":"Path to the file to write (relative or absolute)"},"content":{"type":"string","description":"Content to write to the file"}},"additionalProperties":false},"output_schema":null,"strict":true}],"tool_choice":"auto","parallel_tool_calls":true,"prompt_cache_key":"b7461b8c-637a-41b7-b503-372a1e58733f","prompt_cache_retention":"24h","text":{"format":{"type":"text"},"verbosity":"low"},"top_p":0.98,"top_logprobs":0,"temperature":1.0,"reasoning":{"effort":"medium","summary":"detailed","context":"all_turns","mode":"standard"},"user":null,"usage":{"input_tokens":15480,"input_tokens_details":{"cached_tokens":4608,"cache_write_tokens":0},"output_tokens":1006,"output_tokens_details":{"reasoning_tokens":64},"total_tokens":16486,"attribution":{"items":{"fc_061e5d0a0b380629016acd35e346d881939ab3ebbce70f9657":{"input_tokens":56,"cached_tokens":0,"cache_write_tokens":0,"output_tokens":0},"fc_061e5d0a0b380629016acd35e707048193b10e58ef4dbf192d":{"input_tokens":42,"cached_tokens":0,"cache_write_tokens":0,"output_tokens":0},"fc_061e5d0a0b380629016acd35e707148193b6b0cfb523009615":{"input_tokens":23,"