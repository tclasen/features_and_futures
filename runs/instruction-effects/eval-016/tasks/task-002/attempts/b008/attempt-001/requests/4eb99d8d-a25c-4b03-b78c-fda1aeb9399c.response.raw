`);\",\"newText\":\"const server = createServer(async (request, response) => {\\n  const url = new URL(request.url, `http://${request.headers.host || 'localhost'}`);\\n  const taskRoute = url.pathname.match(/^\\\\/api\\\\/projects\\\\/(\\\\d+)\\\\/tasks(?:\\\\/(\\\\d+))?$/);\\n  if (taskRoute) {\\n    const projectId = Number(taskRoute[1]);\\n    const taskId = taskRoute[2] ? Number(taskRoute[2]) : null;\\n    if (request.method === 'GET' && !taskId) {\\n      return sendJson(response, 200, db.prepare('SELECT id, project_id AS projectId, title, completed FROM tasks WHERE project_id = ? ORDER BY id').all(projectId).map(task => ({ ...task, completed: Boolean(task.completed) })));\\n    }\\n    if (request.method === 'POST' && !taskId) {\\n      const body = await readBody(request);\\n      if (body.error) return sendJson(response, 400, { error: body.error });\\n      const title = typeof body.value?.title === 'string' ? body.value.title.trim() : '';\\n      if (!title) return sendJson(response, 400, { error: 'Task title is required' });\\n      if (!db.prepare('SELECT 1 FROM projects WHERE id = ?').get(projectId)) return sendJson(response, 404, { error: 'Project not found' });\\n      const result = db.prepare('INSERT INTO tasks (project_id, title) VALUES (?, ?)').run(projectId, title);\\n      return sendJson(response, 201, { id: Number(result.lastInsertRowid), projectId, title, completed: false });\\n    }\\n    if (request.method === 'PATCH' && taskId) {\\n      const body = await readBody(request);\\n      if (body.error) return sendJson(response, 400, { error: body.error });\\n      if (typeof body.value?.completed !== 'boolean') return sendJson(response, 400, { error: 'Completion must be boolean' });\\n      const result = db.prepare('UPDATE tasks SET completed = ? WHERE id = ? AND project_id = ?').run(Number(body.value.completed), taskId, projectId);\\n      if (!result.changes) return sendJson(response, 404, { error: 'Task not found' });\\n      return sendJson(response, 200, { id: taskId, completed: body.value.completed });\\n    }\\n    return sendJson(response, 404, { error: 'Not found' });\\n  }\"} ,{\"oldText\":\"function sendJson(response, status, body) {\",\"newText\":\"async function readBody(request) {\\n  try {\\n    let raw = '';\\n    for await (const chunk of request) raw += chunk;\\n    return { value: JSON.parse(raw) };\\n  } catch {\\n    return { error: 'Invalid JSON' };\\n  }\\n}\\n\\nfunction sendJson(response, status, body) {\"},{\"oldText\":\"    let body;\\n    try {\\n      let raw = '';\\n      for await (const chunk of request) raw += chunk;\\n      body = JSON.parse(raw);\\n    } catch {\\n      return sendJson(response, 400, { error: 'Invalid JSON' });\\n    }\\n    const name = typeof body?.name === 'string' ? body.name.trim() : '';\",\"newText\":\"    const parsed = await readBody(request);\\n    if (parsed.error) return sendJson(response, 400, { error: parsed.error });\\n    const name = typeof parsed.value?.name === 'string' ? parsed.value.name.trim() : '';\"}]}","status":"completed"}],"error":null,"incomplete_details":null,"tools":[{"type":"function","name":"read","description":"Read the contents of a file. Supports text files and images (jpg, png, gif, webp, bmp). Images are sent as attachments. For text files, output is truncated to 2000 lines or 50KB (whichever is hit first). Use offset/limit for large files. When you need the full file, continue with offset until complete.","parameters":{"type":"object","required":["path","offset","limit"],"properties":{"path":{"type":"string","description":"Path to the file to read (relative or absolute)"},"offset":{"anyOf":[{"type":"number","description":"Line number to start reading from (1-indexed)"},{"type":"null"}]},"limit":{"anyOf":[{"type":"number","description":"Maximum number of lines to read"},{"type":"null"}]}},"additionalProperties":false},"output_schema":null,"strict":true},{"type":"function","name":"bash","description":"Execute a bash command in the current working directory. Returns stdout and stderr. Output is truncated to last 2000 lines or 50KB (whichever is hit first). If truncated, full output is saved to a temp file. Optionally provide a timeout in seconds.","parameters":{"type":"object","required":["command","timeout"],"properties":{"command":{"type":"string","description":"Shell command to execute"},"timeout":{"anyOf":[{"type":"number","description":"Timeout in seconds (optional, no default timeout)"},{"type":"null"}]}},"additionalProperties":false},"output_schema":null,"strict":true},{"type":"function","name":"edit","description":"Edit a single file using exact text replacement. Every edits[].oldText must match a unique, non-overlapping region of the original file. If two changes affect the same block or nearby lines, merge them into one edit instead of emitting overlapping edits. Do not include large unchanged regions just to connect distant changes.","parameters":{"type":"object","required":["path","edits"],"properties":{"path":{"type":"string","description":"Path to the file to edit (relative or absolute)"},"edits":{"type":"array","items":{"type":"object","required":["oldText","newText"],"properties":{"oldText":{"type":"string","description":"Exact text for one targeted replacement. It must be unique in the original file and must not overlap with any other edits[].oldText in the same call."},"newText":{"type":"string","description":"Replacement text for this targeted edit."}},"additionalProperties":false},"description":"One or more targeted replacements. Each edit is matched against the original file, not incrementally. Do not include overlapping or nested edits. If two changes touch the same block or nearby lines, merge them into one edit instead."}},"additionalProperties":false},"output_schema":null,"strict":true},{"type":"function","name":"write","description":"Write content to a file. Creates the file if it doesn't exist, overwrites if it does. Automatically creates parent directories.","parameters":{"type":"object","required":["path","content"],"properties":{"path":{"type":"string","description":"Path to the file to write (relative or absolute)"},"content":{"type":"string","description":"Content to write to the file"}},"additionalProperties":false},"output_schema":null,"strict":true}],"tool_choice":"auto","parallel_tool_calls":true,"prompt_cache_key":"bd106fb6-05f8-48ac-ac8a-1fda5c174d4d","prompt_cache_retention":"24h","text":{"format":{"type":"text"},"verbosity":"low"},"top_p":0.98,"top_logprobs":0,"temperature":1.0,"reasoning":{"effort":"medium","summary":"detailed","context":"all_turns","mode":"standard"},"user":null,"usage":{"input_tokens":4669,"input_tokens_details":{"cached_tokens":1536,"cache_write_tokens":0},"output_tokens":1069,"output_tokens_details":{"reasoning_tokens":29},"total_tokens":5738,"attribution":{"items":{"fc_0f67ecef0a534dfd016acd18259cec8194bc574c0554cb604e":{"input_tokens":56,"cached_tokens":0,"cache_write_tokens":0,"output_tokens":0},"fc_0f67ecef0a534dfd016acd182611fc8194af08d2beb5c4bed6":{"input_tokens":40,"cached_tokens":0,"cache_write_tokens":0,"output_tokens":0},"fc_0f67ecef0a534dfd016acd182718d48194bea5bbf9564d2484":{"input_tokens":42,"cached_tokens":0,"cache_write_tokens":0,"output_tokens":0},"fc_0f67ecef0a534dfd016acd1827da9c819481d42cf23fb22a19":{"input_tokens":23,"cached_tokens":0,"cache_write_tokens":0,"output_tokens":0},"fc_0f67ecef0a534dfd016acd1827da9c81948eee975c112abd72":{"input_tokens":23,"cached_tokens":0,"cache_write_tokens":0,"output_tokens":0},"fc_0f67ecef0a534dfd016acd1827da9c819496ea6398a72b9214":{"input_tokens":25,"cached_tokens":0,"cache_write_tokens":0,"output_tokens":0},"fc_0f67ecef0a534dfd016acd1827da9c8194974bb2cd0db9758a":{"input_tokens":22,"cached_tokens":0,"cache_write_tokens":0,"output_tokens":0},"fc_0f67ecef0a534dfd016acd18283fa88194867b458515c2d120":{"input_tokens":634,"cached_tokens":0,"cache_write_tokens":0,"output_tokens":0,"content":[{"input_tokens":634,"cached_tokens":0,"cache_