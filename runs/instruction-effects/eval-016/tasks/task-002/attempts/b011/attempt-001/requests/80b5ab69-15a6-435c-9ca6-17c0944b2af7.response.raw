utton>';\\n  document.querySelector('#back').onclick=()=>{history.pushState({},'', '/');render()};\\n  if(!project)return;\\n  let tasks=await (await fetch(`/api/projects/${match[1]}/tasks`)).json();\\n  const drawTasks=()=>{const filter=document.querySelector('#task-filter').value;const shown=tasks.filter(t=>filter==='All'||(filter==='Open'?!t.completed:!!t.completed));document.querySelector('#tasks').innerHTML=shown.map(t=>`<div class=\\\"row\\\" data-testid=\\\"task-row\\\"><span class=\\\"task-title\\\">${esc(t.title)}</span><label><input class=\\\"task-check\\\" type=\\\"checkbox\\\" aria-label=\\\"Complete ${esc(t.title)}\\\" data-id=\\\"${t.id}\\\" ${t.completed?'checked':''}></label></div>`).join('');document.querySelectorAll('.task-check').forEach(box=>box.onchange=async()=>{await fetch(`/api/projects/${match[1]}/tasks/${box.dataset.id}`,{method:'PATCH',headers:{'Content-Type':'application/json'},body:JSON.stringify({completed:box.checked})});tasks.find(t=>String(t.id)===box.dataset.id).completed=box.checked?1:0;drawTasks()})};\\n  document.querySelector('#task-filter').onchange=drawTasks;drawTasks();\\n  document.querySelector('#create-task').onsubmit=async e=>{e.preventDefault();const title=document.querySelector('#task-title').value.trim();const alert=document.querySelector('#alert');if(!title){alert.textContent='Task title is required';alert.hidden=false;return}const response=await fetch(`/api/projects/${match[1]}/tasks`,{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({title})});if(response.ok){tasks.push(await response.json());document.querySelector('#task-title').value='';alert.hidden=true;drawTasks()}};\\n  return;\"}]}"}

