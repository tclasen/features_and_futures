.archived) {\\n        html(res, 403, projectPage(project, filter, 'Archived project cannot be changed'));\\n        return;\\n      }\\n      const name\",\"newText\":\"      const filter = taskFilter(body.get('filter'));\\n      const priority = priorityFilter(body.get('priorityFilter'));\\n      if (project.archived) {\\n        html(res, 403, projectPage(project, filter, 'Archived project cannot be changed', priority));\\n        return;\\n      }\\n      const name\"},{\"oldText\":\"projectPage(project, filter, 'Project name is required')\",\"newText\":\"projectPage(project, filter, 'Project name is required', priority)\"},{\"oldText\":\"      renameProject.run(name, project.id);\\n      res.writeHead(303, { Location: `/projects/${project.id}?filter=${filter}` });\",\"newText\":\"      renameProject.run(name, project.id);\\n      res.writeHead(303, { Location: projectLocation(project.id, filter, priority) });\"},{\"oldText\":\"      const filter = taskFilter(body.get('filter'));\\n      if (project.archived) {\\n        html(res, 403, projectPage(project, filter, 'Archived project cannot be changed'));\\n        return;\\n      }\\n      if (parts[4])\",\"newText\":\"      const filter = taskFilter(body.get('filter'));\\n      const selectedPriority = priorityFilter(body.get('priorityFilter'));\\n      if (project.archived) {\\n        html(res, 403, projectPage(project, filter, 'Archived project cannot be changed', selectedPriority));\\n        return;\\n      }\\n      if (parts[4])\"},{\"oldText\":\"            html(res, 400, projectPage(project, filter, 'Task title is required'));\",\"newText\":\"            html(res, 400, projectPage(project, filter, 'Task title is required', selectedPriority));\"},{\"oldText\":\"projectPage(project, filter, 'Invalid task priority')\",\"newText\":\"projectPage(project, filter, 'Invalid task priority', selectedPriority)\"},{\"oldText\":\"          html(res, 400, projectPage(project, filter, 'Task title is required'));\",\"n