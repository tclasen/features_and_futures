data: {"type":"response.function_call_arguments.done","arguments":"{\"path\":\"server.js\",\"edits\":[{\"oldText\":\"const setTaskDueDate =\",\"newText\":\"if (!database.prepare('PRAGMA table_info(tasks)').all().some(column => column.name === 'position')) {\\n  database.exec('ALTER TABLE tasks ADD COLUMN position INTEGER NOT NULL DEFAULT 0; UPDATE tasks SET position = id');\\n}\\nconst destinations = database.prepare('SELECT id, name FROM projects WHERE archived = 0 AND id != ? ORDER BY id');\\nconst moveTask = database.prepare(`\\n  UPDATE tasks SET project_id = ?, position = (SELECT COALESCE(MAX(position), 0) + 1 FROM tasks WHERE project_id = ?)\\n  WHERE id = ? AND project_id = ?\\n`);\\nconst setTaskDueDate =\"},{\"oldText\":\"const listTasks = database.prepare('SELECT id, title, completed, priority, due_date FROM tasks WHERE project_id = ? ORDER BY id');\\nconst createTask = database.prepare('INSERT INTO tasks (project_id, title, priority) VALUES (?, ?, ?)');\",\"newText\":\"const listTasks = database.prepare('SELECT id, title, completed, priority, due_date FROM tasks WHERE project_id = ? ORDER BY position, id');\\nconst createTask = database.prepare(`INSERT INTO tasks (project_id, title, priority, position)\\n  VALUES (?, ?, ?, (SELECT COALESCE(MAX(position), 0) + 1 FROM tasks WHERE project_id = ?))`);\"},{\"oldText\":\"  const rangeFields = `<input\",\"newText\":\"  const eligibleDestinations = destinations.all(project.id);\\n  const moveDisabled = project.archived || eligibleDestinations.length === 0;\\n  const rangeFields = `<input\"},{\"oldText\":\"          <button type=\\\"submit\\\"${project.archived ? ' disabled' : ''}>Save due date</button>\\n        </form>\",\"newText\":\"          <button type=\\\"submit\\\"${project.archived ? ' disabled' : ''}>Save due date</button>\\n        </form>\\n        <form class=\\\"create\\\" method=\\\"post\\\" action=\\\"/projects/${project.id}/tasks/${task.id}/move\\\">\\n          ${filterFields}\\n          <label for=\\\"destination-project-${task.id}\\\">Destination project</label>\\n          <select id=\\\"destination-project-${task.id}\\\" name=\\\"destination\\\"${moveDisabled ? ' disabled' : ''}>\\n            ${eligibleDestinations.map(destination => `<option value=\\\"${destination.id}\\\">${escapeHtml(destination.name)}</option>`).join('')}\\n          </select>\\n          <button type=\\\"submit\\\"${moveDisabled ? ' disabled' : ''}>Move task</button>\\n        </form>\"},{\"oldText\":\"(?:rename|priority|due-date)\",\"newText\":\"(?:rename|priority|due-date|move)\"},{\"oldText\":\"        const isRename = parts[5] === 'rename';\",\"newText\":\"        const isMove = parts[5] === 'move';\\n        const destinationId = Number(form.get('destination'));\\n        const destination = isMove && Number.isSafeInteger(destinationId) ? findProject.get(destinationId) : null;\\n        if (isMove && (!destination || destination.archived || destinationId === projectId)) {\\n          sendHtml(response, 400, projectPage(project, filter, 'Select an active destination project', selectedPriority, dueRange(form)));\\n          return;\\n        }\\n        const isRename = parts[5] === 'rename';\"},{\"oldText\":\"          ? (isRename\\n            ? renameTask.run(title, taskId, projectId)\",\"newText\":\"          ? (isMove\\n            ? moveTask.run(destinationId, destinationId, taskId, projectId)\\n            : isRename\\n            ? renameTask.run(title, taskId, projectId)\"},{\"oldText\":\"        createTask.run(projectId, title, project.default_priority);\",\"newText\":\"        createTask.run(projectId, title, project.default_priority, projectId);\"}]}","item_id":"fc_0b8bb9b5fe7120e3016aca6076fa008194b1d3bc0605e7e85f","output_index":0,"sequence_number":851}

