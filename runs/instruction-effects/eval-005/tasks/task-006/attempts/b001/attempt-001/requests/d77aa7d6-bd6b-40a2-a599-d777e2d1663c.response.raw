event: response.function_call_arguments.done
data: {"type":"response.function_call_arguments.done","sequence_number":755,"item_id":"fc_0cb6a5ed9ec75165016aca545c3d5481948ca6c3db91c46cc3","output_index":1,"arguments":"{\"path\":\"server.js\",\"edits\":[{\"oldText\":\"const listProjects = database.prepare(`\",\"newText\":\"if (!database.prepare('PRAGMA table_info(tasks)').all().some(column => column.name === 'priority')) {\\n  database.exec(\\\"ALTER TABLE tasks ADD COLUMN priority TEXT NOT NULL DEFAULT 'Normal' CHECK (priority IN ('Low', 'Normal', 'High'))\\\");\\n}\\nconst listProjects = database.prepare(`\"},{\"oldText\":\"SELECT id, title, completed FROM tasks\",\"newText\":\"SELECT id, title, completed, priority FROM tasks\"},{\"oldText\":\"const renameTask = database.prepare('UPDATE tasks SET title = ? WHERE id = ? AND project_id = ?');\",\"newText\":\"const renameTask = database.prepare('UPDATE tasks SET title = ? WHERE id = ? AND project_id = ?');\\nconst taskPriorities = ['Low', 'Normal', 'High'];\\nconst setTaskPriority = database.prepare('UPDATE tasks SET priority = ? WHERE id = ? AND project_id = ?');\"},{\"oldText\":\"button:disabled, input:disabled\",\"newText\":\"button:disabled, input:disabled, select:disabled\"},{\"oldText\":\"        <form class=\\\"create\\\" method=\\\"post\\\" action=\\\"/projects/${project.id}/tasks/${task.id}/rename\\\">\",\"newText\":\"        <form class=\\\"filter\\\" method=\\\"post\\\" action=\\\"/projects/${project.id}/tasks/${task.id}/priority\\\">\\n          <input type=\\\"hidden\\\" name=\\\"filter\\\" value=\\\"${filter}\\\">\\n          <label for=\\\"task-priority-${task.id}\\\">Task priority</label>\\n          <select id=\\\"task-priority-${task.id}\\\" name=\\\"priority\\\"${project.archived ? ' disabled' : ''} onchange=\\\"this.form.requestSubmit()\\\">\\n            ${taskPriorities.map(priority => `<option${task.priority === priority ? ' selected' : ''}>${priority}</option>`).join('')}\\n          </select>\\n        </form>\\n        <form class=\\\"create\\\" method=\\\"post\\\" action=\\\"/projects/${project.id}/tasks/${task.id}/rename\\\">\"},{\"oldText\":\"\\\\/tasks(?:\\\\/\\\\d+(?:\\\\/rename)?)?$\",\"newText\":\"\\\\/tasks(?:\\\\/\\\\d+(?:\\\\/(?:rename|priority))?)?$\"},{\"oldText\":\"        const isRename = parts[5] === 'rename';\",\"newText\":\"        const isRename = parts[5] === 'rename';\\n        const isPriority = parts[5] === 'priority';\\n        const priority = form.get('priority');\\n        if (isPriority && !taskPriorities.includes(priority)) {\\n          sendHtml(response, 400, projectPage(project, filter, 'Invalid task priority'));\\n          return;\\n        }\"},{\"oldText\":\"            : updateTask.run(form.get('completed') === '1' ? 1 : 0, taskId, projectId))\",\"newText\":\"            : isPriority\\n              ? setTaskPriority.run(priority, taskId, projectId)\\n              : updateTask.run(form.get('completed') === '1' ? 1 : 0, taskId, projectId))\"}]}"}

