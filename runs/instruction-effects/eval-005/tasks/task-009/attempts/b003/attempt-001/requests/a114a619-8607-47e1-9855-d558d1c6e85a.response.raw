data: {"type":"response.function_call_arguments.done","sequence_number":656,"item_id":"fc_0ec07918ef8be3d7016aca56e91c6c8194bb8e7e4b03d4b859","output_index":0,"arguments":"{\"path\":\"server.js\",\"edits\":[{\"oldText\":\"const updateDefaultPriority = db.prepare\",\"newText\":\"if (!db.prepare('PRAGMA table_info(tasks)').all().some(column => column.name === 'due_date')) {\\n  db.exec(\\\"ALTER TABLE tasks ADD COLUMN due_date TEXT NOT NULL DEFAULT ''\\\");\\n}\\nconst updateDueDate = db.prepare('UPDATE tasks SET due_date = ? WHERE id = ? AND project_id = ?');\\nconst updateDefaultPriority = db.prepare\"},{\"oldText\":\"SELECT id, title, completed, priority FROM tasks\",\"newText\":\"SELECT id, title, completed, priority, due_date FROM tasks\"},{\"oldText\":\"function taskFilter(value) {\",\"newText\":\"function validDueDate(value) {\\n  if (!/^\\\\d{4}-\\\\d{2}-\\\\d{2}$/.test(value)) return false;\\n  const [year, month, day] = value.split('-').map(Number);\\n  if (year < 1 || month < 1 || month > 12 || day < 1) return false;\\n  const leap = year % 4 === 0 && (year % 100 !== 0 || year % 400 === 0);\\n  const days = [31, leap ? 29 : 28, 31, 30, 31, 30, 31, 31, 30, 31, 30, 31];\\n  return day <= days[month - 1];\\n}\\n\\nfunction taskFilter(value) {\"},{\"oldText\":\"</form></div>`).join('')}`);\",\"newText\":\"</form>\\n<form class=\\\"create\\\" method=\\\"post\\\" action=\\\"/projects/${project.id}/tasks/${task.id}/due-date\\\">\\n${filterFields}\\n<div class=\\\"field\\\"><label for=\\\"task-due-date-${task.id}\\\">Task due date</label><input type=\\\"text\\\" id=\\\"task-due-date-${task.id}\\\" name=\\\"dueDate\\\" value=\\\"${escape(task.due_date)}\\\"${project.archived ? ' disabled' : ''}></div>\\n<button type=\\\"submit\\\"${project.archived ? ' disabled' : ''}>Save due date</button>\\n</form></div>`).join('')}`);\"},{\"oldText\":\"(?:completion|rename|priority)\",\"newText\":\"(?:completion|rename|priority|due-date)\"},{\"oldText\":\"        } else if (parts[5] === 'priority') {\",\"newText\":\"        } else if (parts[5] === 'due-date') {\\n          const dueDate = (body.get('dueDate') || '').trim();\\n          if (dueDate && !validDueDate(dueDate)) {\\n            html(res, 400, projectPage(project, filter, 'Due date must be a valid YYYY-MM-DD date', selectedPriority));\\n            return;\\n          }\\n          result = updateDueDate.run(dueDate, parts[4], project.id);\\n        } else if (parts[5] === 'priority') {\"}]}"}

