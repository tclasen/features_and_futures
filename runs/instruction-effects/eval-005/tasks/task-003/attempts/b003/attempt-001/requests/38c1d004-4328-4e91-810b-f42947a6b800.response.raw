data: {"type":"response.function_call_arguments.done","sequence_number":94,"item_id":"fc_0186412807acc3a9016aca51cc3430819597846f6d224cde1c","output_index":2,"arguments":"{\"path\": \"README.md\", \"edits\": [{\"oldText\": \"Defaults are port 8080 and `data/workboard.sqlite`.\", \"newText\": \"Filter the project list by Active or Archived, archive projects, or restore them without losing tasks. Archived projects remain viewable with read-only tasks. Each project row shows its completed/total task count. Defaults are port 8080 and `data/workboard.sqlite`.\"}, {\"oldText\": \"and persistence across server restarts.\", \"newText\": \"archive/restore, read-only archived tasks, completion summaries, legacy schema migration, and persistence across server restarts.\"}]}"}

