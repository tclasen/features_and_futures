/\\\">\\n      <label for=\\\"project-filter\\\">\",\"newText\":\"    <form class=\\\"filter\\\" method=\\\"get\\\" action=\\\"/\\\">\\n      ${searchField}\\n      <label for=\\\"project-filter\\\">\"},{\"oldText\":\"    <section class=\\\"projects\\\" aria-label=\\\"Projects\\\">\",\"newText\":\"    <form class=\\\"filter\\\" method=\\\"get\\\" action=\\\"/\\\">\\n      <input type=\\\"hidden\\\" name=\\\"filter\\\" value=\\\"${filter}\\\">\\n      <label for=\\\"project-search\\\">Project search</label>\\n      <input id=\\\"project-search\\\" name=\\\"search\\\" type=\\\"text\\\" value=\\\"${escapeHtml(search)}\\\">\\n      <button type=\\\"submit\\\">Search projects</button>\\n    </form>\\n    <section class=\\\"projects\\\" aria-label=\\\"Projects\\\">\"},{\"oldText\":\"<form method=\\\"post\\\" action=\\\"/projects/${project.id}/${project.archived ? 'restore' : 'archive'}\\\"><button\",\"newText\":\"<form method=\\\"post\\\" action=\\\"/projects/${project.id}/${project.archived ? 'restore' : 'archive'}\\\">${searchField}<button\"},{\"oldText\":\"      <input type=\\\"hidden\\\" name=\\\"dueThrough\\\" value=\\\"${range.through}\\\">`;\",\"newText\":\"      <input type=\\\"hidden\\\" name=\\\"dueThrough\\\" value=\\\"${range.through}\\\">\\n      <input type=\\\"hidden\\\" name=\\\"search\\\" value=\\\"${escapeHtml(range.search || '')}\\\">`;\"},{\"oldText\":\"  const tasks = listTasks.all(project.id).filter(task =>\\n    (filter\",\"newText\":\"  const tasks = listTasks.all(project.id).filter(task =>\\n    matchesSearch(task.title, range.search || '') &&\\n    (filter\"},{\"oldText\":\"    <section class=\\\"tasks\\\" aria-label=\\\"Tasks\\\">\",\"newText\":\"    <form class=\\\"filter\\\" method=\\\"get\\\" action=\\\"/projects/${project.id}\\\">\\n      <input type=\\\"hidden\\\" name=\\\"filter\\\" value=\\\"${filter}\\\">\\n      <input type=\\\"hidden\\\" name=\\\"priorityFilter\\\" value=\\\"${priority}\\\">\\n      <input type=\\\"hidden\\\" name=\\\"dueFrom\\\" value=\\\"${range.from}\\\">\\n      <input type=\\\"hidden\\\" name=\\\"dueThrough\\\" value=\\\"${range.through}\\\">\\n      <label for=\\\"task-search\\\">Task search</label>\\n      <input id=\\\"task-search\\\" name=\\\"search\\\" type=\\\"text\\\" value=\\\"${escapeHtml(range.search || '')}\\\">\\n      <button type=\\\"submit\\\">Search tasks</button>\\n    </form>\\n    <section class=\\\"tasks\\\" aria-label=\\\"Tasks\\\">\"},{\"oldText\":\"projectsPage('', projectFilter(url.searchParams.get('filter')))\",\"newText\":\"projectsPage('', projectFilter(url.searchParams.get('filter')), (url.searchParams.get('search') || '').trim())\"},{\"oldText\":\"projectsPage('Project name is required', projectFilter(form.get('filter')))\",\"newText\":\"projectsPage('Project name is required', projectFilter(form.get('filter')), (form.get('search') || '').trim())\"},{\"oldText\":\"      response.writeHead(303, { Location: '/' });\",\"newText\":\"      response.writeHead(303, { Location: `/?filter=${projectFilter(form.get('filter'))}${searchQuery((form.get('search') || '').trim())}` });\"},{\"oldText\":\"${rangeQuery({ from, through })}\",\"newText\":\"${rangeQuery({ from, through, search: (form.get('search') || '').trim() })}\"},{\"oldText\":\"      setArchived.run(action === 'archive' ? 1 : 0, projectId);\\n      response.writeHead(303, { Location: action === 'archive' ? '/' : '/?filter=Archived' });\",\"newText\":\"      const form = await readForm(request);\\n      setArchived.run(action === 'archive' ? 1 : 0, projectId);\\n      response.writeHead(303, { Location: `/?filter=${action === 'archive' ? 'Active' : 'Archived'}${searchQuery((form.get('search') || '').trim())}` });\"}]}"}

