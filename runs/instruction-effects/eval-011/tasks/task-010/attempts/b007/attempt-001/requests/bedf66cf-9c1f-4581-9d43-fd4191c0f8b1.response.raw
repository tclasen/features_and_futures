data: {"type":"response.completed","sequence_number":3122,"safety_buffering":false,"response":{"id":"resp_006cad67a3ff7a11016acb0be0c99087d1a5c4f3420c23a669","object":"response","created_at":1791691745,"completed_at":1791691794,"status":"completed","background":false,"frequency_penalty":0.0,"presence_penalty":0.0,"moderation":null,"model":"gpt-6.1-sol","access_programs":{"cyber":"standard"},"previous_response_id":null,"instructions":null,"output":[{"type":"reasoning","id":"rs_006cad67a3ff7a11016acb0be4982c87d1bf73c68127f8841a","metadata":{"turn_id":"01a12925-b0fe-71e2-bfe2-06132fc58dfd"},"internal_chat_message_metadata_passthrough":{"turn_id":"01a12925-b0fe-71e2-bfe2-06132fc58dfd"},"summary":[],"content":[],"encrypted_content":"gAAAAABqywvkkKFe540a1KHOTvpFQ4SZEHZF8qsWpDPYdg-6pN2ScTxR0SAD_VSjE8iXsjnP_JvePA133hVxtFV9tAklSJyjJxwjvOL_Z1PQJS9AEl7EixLNyvJl2qyQslYA9FR3FVJsiWU4TUTMmmIQBCgO2OKESpnx6k4klZ1ilZnyh7BNZQjNraF1HrFzMROQdOuJ5h6yAOom_wrY3RXYrChPwjrft9w378jVs03JbvALsHLmrc6hUk8KFHnhWQrn1t45jEv2Jcf61CAGZ25VyW0JUZeS446PzgaAj-AGI5noiTBHZgqbGj1fsjfMIWDbDCWNjGOA8_Y5ceqpK3Fujr_SNUq-HnE8RBAZIOYGOsZE-ozK3KYc1JlUcRtkdNSCuF6wNc37VUHbjGSktw1fdpwOcbcmQ5eSXhbe3HccJhZ8obg0bIzyYnjXOXtS5OnFDPJ39ULIY5YuNMZizKPWOW0Wr3EDF-1xnvsdjubOCCqQlHh5cv529BuXOgC7jHW1MU2vX3U6LbvXxrYOa--rkk9KgQlr5-2MAv64MLp0vJ26Z0fk9brhfEB2EL9o-40eB9bAydGu079uLAtk3LHL8rwnHtZIHPJDuvKBhjlQS4LcmtjygVWP-vOPvO0jhT2_vvEXKYwJkltMb-lxr3zTyHJxd50wnVCcslrTb7-OK24L-eb8jR5xf21YGvhlQsWlGJQg5ddaaQP_1vtFNaF2P1HN1McTziSGXuF_fQtZ22FlueECl5SNQvJz648NRd798AvnJw6jxeXqZkrXlEOoP-lmSRvBXFgqatYXvz_a-Q_mWr7XkJN1dC7Zv6eDBhyJmdvG2_V9aL72pDXOSsms8eSRn_JhDXshlTXOqgJdkF2XbILIrAPU6O5SchixiX7i9ZyfWVmSdNTKRoiqnebWO3YOpTwiATmzzVZSgpQXMwt2sq1lLkLAqMBqvx5FqcEgnBSp5G96Wk8HxLJ27yf2haz_7FlMr67lGvKrRD77aa1UeT5wfTPbet8URuxnwwtlLA3i_b2icirNC3DvaoT3Fh8Z2WGmoyxxIjmlhlGqbcw0vbXt1A5HuYB3CgAcHd2o67qZQxkI6_uhrPlDJqUv7sv-YbY-ScWV-qw9GPkGFiIgiYncjwiAOH-amsb1MzILxDGYBqbNYKSszQ40oMJM7XIQzvx3ihdWG44khWEXP0iXwAX0q6Uo_CSSEZa9wBA0M6QggIgZVwOJVju-Yk8UPGKBDkk5U5QV5PLhj2tFj4FYV_triz2DNqMzUpA8mQfTjSEMB38fkhiq8-b5LeQdVPomfr7Uf_w0A70uXCOwEST9fHWE4GLaxy7fzWRYbGcj5IwPeUv4ky_QCa21uXejFq5mtKzfARny8Ybafd1Got11FABee5oVeAZEhGamtufzltMFBtEvG_jyKphkgSSRTXNQsmQysKhEZZXFngfva5vKS4LyzkKLZGPp0N2PIa2yAEBNWv_KBwlLNcvDsXXmi6_NiaZBP9f4Vk7cQ8BH5x1Kl2I-Sj-h5IPPycyeGoqbRrDU7alkl0e-6Utg26k7OzAVTiRRG983kziCsraBeNUlXA5rmiPjO5yMBKxTv25xyJWitC1_xJV9ggN7WK_K4_Fz66RdTaEOCzv6l7KrE_MXWLVCg8wBbrf0N56IYER8T0xZlyDQ_vkEC8IKo4CgdA-Q5xLYNLau4aqhk5Y64nXp9-Rcn4lZlnh_B4XOWGrkVaTCMe8C4lV4mP41OTogIsP6fzxVM0EbpI25Jw8RVelA4dQTQi6CEwESxowaGqS8SKlPkYFeHzoU_mjbyRkjRi-QeTMPTdRyD-aBs2ee-NFn4iki7p-89G2oYomq9xsvylMyhpOT0tb788mrcJ9gXq_DBuNGk_pN3mTpq7u66ODHPXQpuSto8rmGEAKpOr4AOcUzKvnDC4iQDz7eOvz81KreqFOJlsOryhcCDusMcY2U6l1LlUpXRsQHHKG7FWTgnN8o0Ss8A1roD1FeY78rq_mhtOFrTZg4yTXNnvNHDR3c04ZST72djLbX-Yoo7IdQpm27Xrow6bpm1hNtX-vVubkc1TPTeg8fKAxTwpVpdSRHxUw-MaCEbxdp-nT3dA-y0t2p7wsqYxHPYKnLqPxR8Z_Xj76fjkAxxHczn1uZn_AXMYP8Yz7t4mcoSOfgFNziWhnX3pgo"},{"type":"custom_tool_call","id":"ctc_006cad67a3ff7a11016acb0be4b13487d1a1a78fcb35c2c31a","metadata":{"turn_id":"01a12925-b0fe-71e2-bfe2-06132fc58dfd"},"internal_chat_message_metadata_passthrough":{"create_time":1791691748.69514,"turn_id":"01a12925-b0fe-71e2-bfe2-06132fc58dfd"},"call_id":"call_66943c62d4c646e2a1e5632341625076","name":"exec","input":"text(await tools.apply_patch(\"*** Begin Patch\\n*** Update File: /home/agent/work/test/due-date.test.js\\n@@\\n-import { normalizeDueDate } from '../due-date.js';\\n+import { normalizeDueDate, normalizeDueRange } from '../due-date.js';\\n@@\\n });\\n+\\n+test('due ranges normalize optional inclusive boundaries and distinguish invalid dates from reversed ranges', () => {\\n+  for (const [from, through, expected] of [\\n+    ['', ' \\\\t ', { dueFrom: '', dueThrough: '' }],\\n+    [' 0001-01-01 ', '9999-12-31', { dueFrom: '0001-01-01', dueThrough: '9999-12-31' }],\\n+    ['2000-02-29', '2000-02-29', { dueFrom: '2000-02-29', dueThrough: '2000-02-29' }],\\n+    ['', '2026-01-01', { dueFrom: '', dueThrough: '2026-01-01' }],\\n+    ['2026-01-01', '', { dueFrom: '2026-01-01', dueThrough: '' }],\\n+  ]) assert.deepEqual(normalizeDueRange(from, through), expected);\\n+  for (const [from, through] of [['1900-02-29', ''], ['', '0000-01-01'],\\n+    ['2026-1-01', '2026-01-01'], ['2026-04-31', '2026-01-01']]) {\\n+    assert.deepEqual(normalizeDueRange(from, through), { error: 'Due range must use valid YYYY-MM-DD dates' });\\n+  }\\n+  assert.deepEqual(normalizeDueRange('2026-01-02', '2026-01-01'), {\\n+    error: 'Due from must not be after Due through',\\n+  });\\n+});\\n*** Update File: /home/agent/work/README.md\\n@@\\n disable due-date controls and reject direct date edits until restored.\\n+Due from and Due through apply an inclusive date range that intersects completion\\n+and priority filters. Blank boundaries are unbounded; undated tasks match only\\n+when both boundaries are blank. Invalid dates or reversed ranges show an alert\\n+and preserve the previously applied range. Applying a range never edits task data.\\n+Task edits immediately re-evaluate membership, and all edits retain the three\\n+filters. Range controls remain usable in archived projects. Applied boundaries\\n+are page state in the URL, preserved on reload; reopening from the project list\\n+starts with empty boundaries.\\n*** End Patch\"));\ntext(await tools.exec_command({cmd:\"cat >> test/workboard.test.js <<'EOF'\\n\\ntest('inclusive due ranges combine with filters, preserve applied state, and remain usable when archived', async () => {\\n  const directory = await mkdtemp(join(process.cwd(), '.workboard-test-'));\\n  const databasePath = join(directory, 'workboard.sqlite');\\n  let running;\\n  try {\\n    running = await start(databasePath);\\n    const get = async (path) => (await fetch(`${running.baseUrl}${path}`)).text();\\n    const post = (path, values = {}) => fetch(`${running.baseUrl}${path}`, {\\n      method: 'POST', body: new URLSearchParams(values), redirect: 'manual',\\n    });\\n    const titles = (html) => [...html.matchAll(/data-testid=\\\"task-row\\\"[^>]*>\\\\s*<span>(.*?)<\\\\/span>/g)]\\n      .map((match) => match[1]);\\n    const hiddenFields = (html, action) => {\\n      const form = [...html.matchAll(/<form[^>]*action=\\\"([^\\\"]+)\\\"[^>]*>([\\\\s\\\\S]*?)<\\\\/form>/g)]\\n        .find((match) => match[1] === action);\\n      assert.ok(form, `Missing form ${action}`);\\n      return Object.fromEntries([...form[2].matchAll(/<input type=\\\"hidden\\\" name=\\\"([^\\\"]+)\\\" value=\\\"([^\\\"]*)\\\">/g)]\\n        .map((match) => [match[1], match[2]]));\\n    };\\n    await post('/projects', { name: 'First' });\\n    await post('/projects', { name: 'Other' });\\n    for (const [index, title, date, priority, completed] of [\\n      [1, 'Undated', '', 'High', '1'],\\n      [2, 'Before', '2026-01-01', 'High', '1'],\\n      [3, 'From', '2026-02-01', 'High', '1'],\\n      [4, 'Inside', '2026-02-15', 'High', '1'],\\n      [5, 'Through', '2026-02-28', 'High', '1'],\\n      [6, 'After', '2026-03-01', 'High', '1'],\\n      [7, 'Open', '2026-02-15', 'High', ''],\\n      [8, 'Low', '2026-02-15', 'Low', '1'],\\n    ]) {\\n      await post('/projects/1/tasks', { title });\\n      await post(`/projects/1/tasks/${index}/due-date`, { dueDate: date });\\n      await post(`/projects/1/tasks/${index}/priority`, { priority });\\n      await post(`/projects/1/tasks/${index}/completion`, { completed });\\n    }\\n    const originalList = await get('/');\\n    assert.match(originalList, /data-testid=\\\"project-summary\\\">7\\\\/8 completed/);\\n    const initial = await get('/projects/1');\\n    assert.match(initial, /<label for=\\\"due-from\\\">Due from<\\\\/label>/);\\n    assert.match(initial, /<label for=\\\"due-through\\\">Due through<\\\\/label>/);\\n    assert.match(initial, /id=\\\"due-from\\\"[^>]*value=\\\"\\\"/);\\n    assert.match(initial, /id=\\\"due-through\\\"[^>]*value=\\\"\\\"/);\\n    const apply = async (html, dueFrom, dueThrough) => post('/projects/1/due-range', {\\n      ...hiddenFields(html, '/projects/1/due-range'), dueFrom, dueThrough,\\n    });\\n    // Exercise the actual form state, inclusive endpoints and each unbounded side.\\n    for (const [from, through, expected] of [\\n      ['', '', ['Undated', 'Before', 'From', 'Inside', 'Through', 'After', 'Open', 'Low']],\\n      ['', '2026-02-01', ['Before', 'From']],\\n      ['2026-02-28', '', ['Through', 'After']],\\n      ['2026-02-15', '2026-02-15', ['Inside', 'Open', 'Low']],\\n      [' 2026-02-01 ', ' 2026-02-28 ', ['From', 'Inside', 'Through', 'Open', 'Low']],\\n    ]) {\\n      const response = await apply(initial, from, through);\\n      assert.equal(response.status, 303);\\n      assert.deepEqual(titles(await get(response.headers.get('location'))), expected);\\n    }\\n    const path = '/projects/1?filter=Completed&priorityFilter=High&dueFrom=2026-02-01&dueThrough=2026-02-28';\\n    let html = await get(path);\\n    assert.deepEqual(titles(html), ['From', 'Inside', 'Through']);\\n    const filters = { filter: 'Completed', priorityFilter: 'High', dueFrom: '2026-02-01', dueThrough: '2026-02-28' };\\n    assert.deepEqual(hiddenFields(html, '/projects/1/tasks/3/due-date'), filters);\\n    // Combobox submissions carry the applied range while retaining the other selection.\\n    const fields = hiddenFields(html, '/projects/1');\\n    assert.deepEqual(fields, { dueFrom: filters.dueFrom, dueThrough: filters.dueThrough });\\n    assert.deepEqual(titles(await get(`/projects/1?${new URLSearchParams({ ...fields, filter: 'Open', priorityFilter: 'High' })}`)), ['Open']);\\n    assert.deepEqual(titles(await get(`/projects/1?${new URLSearchParams({ ...fields, filter: 'Completed', priorityFilter: 'Low' })}`)), ['Low']);\\n    for (const [from, through, error] of [\\n      ['2026-02-30', '', 'Due range must use valid YYYY-MM-DD dates'],\\n      ['', '1900-02-29', 'Due range must use valid YYYY-MM-DD dates'],\\n      ['0000-01-01', '9999-12-31', 'Due range must use valid YYYY-MM-DD dates'],\\n      ['2026-03-01', '2026-02-28', 'Due from must not be after Due through'],\\n    ]) {\\n      const response = await apply(html, from, through);\\n      assert.equal(response.status, 400);\\n      const invalidHtml = await response.text();\\n      assert.match(invalidHtml, new RegExp(`role=\\\"alert\\\"[^>]*>${error}`));\\n      assert.deepEqual(titles(invalidHtml), ['From', 'Inside', 'Through']);\\n      assert.deepEqual(hiddenFields(invalidHtml, '/projects/1/tasks/3/due-date'), filters);\\n    }\\n    assert.equal(await get('/'), originalList);\\n    // All editing paths retain all filters; membership reacts to saved changes.\\n    const edit = async (action, values, expected) => {\\n      const response = await post(action, { ...hiddenFields(html, action), ...values });\\n      assert.equal(response.status, 303);\\n      assert.equal(response.headers.get('location'), path);\\n      html = await get(path);\\n      assert.deepEqual(titles(html), expected);\\n    };\\n    await edit('/projects/1/tasks/3/rename', { title: ' Renamed from ' }, ['Renamed from', 'Inside', 'Through']);\\n    await edit('/projects/1/rename', { name: ' Renamed project ' }, ['Renamed from', 'Inside', 'Through']);\\n    await edit('/projects/1/default-priority', { priority: 'Low' }, ['Renamed from', 'Inside', 'Through']);\\n    await edit('/projects/1/tasks', { title: 'Created undated' }, ['Renamed from', 'Inside', 'Through']);\\n    await edit('/projects/1/tasks/3/due-date', { dueDate: '2026-03-01' }, ['Inside', 'Through']);\\n    await edit('/projects/1/tasks/4/priority', { priority: 'Low' }, ['Through']);\\n    await edit('/projects/1/tasks/5/completion', {}, []);\\n    assert.match(await get('/'), /data-testid=\\\"project-summary\\\">6\\\\/9 completed/);\\n    assert.deepEqual(titles(await get('/projects/2')), []);\\n    const saved = await get('/projects/1');\\n    const savedList = await get('/');\\n    assert.match(saved, /aria-label=\\\"Complete Renamed from\\\" checked/);\\n    assert.match(saved, /id=\\\"task-due-date-3\\\"[^>]*value=\\\"2026-03-01\\\"/);\\n    await running.stop();\\n    running = undefined;\\n    running = await start(databasePath);\\n    assert.equal(await get('/projects/1'), saved);\\n    assert.equal(await get('/'), savedList);\\n    await post('/projects/1/archive');\\n    const archived = await get('/projects/1');\\n    const applied = await apply(archived, '2026-02-15', '2026-02-15');\\n    assert.equal(applied.status, 303);\\n    const archivedRange = applied.headers.get('location');\\n    const archivedHtml = await get(archivedRange);\\n    assert.deepEqual(titles(archivedHtml), ['Inside', 'Open', 'Low']);\\n    assert.match(archivedHtml, /id=\\\"task-due-date-4\\\"[^>]* disabled/);\\n    for (const id of ['due-from', 'due-through']) {\\n      const control = new RegExp(`<input id=\\\"${id}\\\"[^>]*>`).exec(archivedHtml)[0];\\n      assert.doesNotMatch(control, / disabled/);\\n    }\\n    assert.match(archivedHtml, /<button type=\\\"submit\\\">Apply due range<\\\\/button>/);\\n    assert.equal((await post('/projects/1/tasks/4/due-date', { dueDate: '', ...filters })).status, 409);\\n    await running.stop();\\n    running = undefined;\\n    running = await start(databasePath);\\n    assert.equal(await get(archivedRange), archivedHtml);\\n    await post('/projects/1/restore');\\n    assert.equal(await get('/projects/1'), saved);\\n    const cleared = await apply(await get(archivedRange), ' \\\\t ', '');\\n    assert.equal(cleared.headers.get('location'), '/projects/1');\\n    assert.deepEqual(titles(await get('/projects/1')), titles(saved));\\n    // Opening from the list has no range or combobox state in the target URL.\\n    assert.match(await get('/'), /action=\\\"\\\\/projects\\\\/1\\\"><button type=\\\"submit\\\">Open project/);\\n    assert.match(await get('/projects/1'), /id=\\\"due-from\\\"[^>]*value=\\\"\\\"/);\\n  } finally {\\n    if (running) await running.stop();\\n    await rm(directory, { recursive: true, force: true });\\n  }\\n});\\nEOF\\nnpm test\",\"max_output_tokens\":2500}));\n","status":"completed"}],"error":null,"incomplete_details":null,"tools":[{"type":"namespace","name":"functions","description":"","tools":[{"type":"function","strict":false,"name":"wait","description":"Waits on a yielded `exec` cell and returns new output or completion.\n- Use `wait` only after `exec` returns `Script running with cell ID ...`.\n- `cell_id` identifies the running `exec` cell to resume.\n- `yield_time_ms` controls how long to wait for more output before yielding again. Defaults to 10000 ms.\n- `max_tokens` limits how much new output this wait call returns. Defaults to 10000 tokens.\n- `terminate: true` stops the running cell; false or omitted waits for output.\n- `wait` returns only the new output since the last yield, or the final completion or termination result for that cell.\n- If the cell is still running, `wait` may yield again with the same `cell_id`.\n- If the cell has already finished, `wait` returns the completed result and closes the cell.","output_schema":null,"parameters":{"type":"object","properties":{"cell_id":{"type":"string","description":"Identifier of the running exec cell."},"max_tokens":{"type":"number","description":"Output token budget for this wait call. Defaults to 10000 tokens."},"terminate":{"type":"boolean","description":"True stops the running exec cell; false or omitted waits for output."},"yield_time_ms":{"type":"number","description":"Wait before yielding more output. Defaults to 10000 ms."}},"required":["cell_id"],"additionalProperties":false}},{"type":"function","strict":false,"name":"request_user_input","description":"Request user input for one to three short questions and wait for the response. This tool is only available in Plan mode.","output_schema":null,"parameters":{"type":"object","properties":{"questions":{"type":"array","description":"Questions to show the user. Prefer 1 and do not exceed 3","items":{"type":"object","properties":{"header":{"type":"string","description":"Short header label shown in the UI (12 or fewer chars)."},"id":{"type":"string","description":"Stable identifier for mapping answers (snake_case)."},"options":{"type":"array","description":"Provide 2-3 mutually exclusive choices. Put the recommended option first and suffix its label with \"(Recommended)\". Do not include an \"Other\" option in this list; the client will add a free-form \"Other\" option automatically.","items":{"type":"object","properties":{"description":{"type":"string","description":"One short sentence explaining impact/tradeoff if selected."},"label":{"type":"string","description":"User-facing label (1-5 words)."}},"required":["label","description"],"additionalProperties":false}},"question":{"type":"string","description":"Single-sentence prompt shown to the user."}},"required":["id","header","question","options"],"additionalProperties":false}}},"required":["questions"],"additionalProperties":false}},{"type":"function","strict":false,"name":"request_user_input_async","description":"Ask the user one or more questions during ongoing work. Use this tool only to request missing information, preferences, constraints, clarification, or approval. The tool returns immediately without ending the turn or waiting for a reply; any reply arrives asynchronously as a new user message. Keep questions concise, self-contained, and easy to understand, using a level of detail appropriate to the user and task. The UI always allows a free-text answer, including when suggested options are provided. A preselected option is not submitted automatically.","output_schema":null,"parameters":{"type":"object","properties":{"questions":{"type":"array","description":"One or more self-contained questions to present together, in display order.","items":{"type":"object","properties":{"options":{"type":"array","description":"Suggested answers, in display order. Put the recommended answer first; the first option is preselected by default. The user can select one option or enter a free-text answer. Do not include an Other option or a free-text placeholder; the UI provides free-text input automatically. Omit options for a free-text-only question.","items":{"type":"string"},"minItems":1},"title":{"type":"string","description":"The complete question shown to the user, including any context needed to answer it."}},"required":["title"],"additionalProperties":false},"minItems":1}},"required":["questions"],"additionalProperties":false}},{"type":"custom","name":"exec","description":"Run JavaScript code to orchestrate/compose tool calls\n- Evaluates the provided JavaScript code in a fresh V8 isolate as an async module.\n- All nested tools are available on the global `tools` object, for example `await tools.exec_command(...)`. Tool names are exposed as normalized JavaScript identifiers, for example `await tools.mcp__ologs__get_profile(...)`.\n- Nested tool methods take either a string or an object as their input argument.\n- Nested tools return either an object or a string, based on the description.\n- Runs raw JavaScript -- no Node, no file system, no network access, no console.\n- Accepts raw JavaScript source text, not JSON, quoted strings, or markdown code fences.\n- You may optionally start the tool input with a first-line pragma like `// @exec: {\"yield_time_ms\": 10000, \"max_output_tokens\": 1000}`.\n- `yield_time_ms` asks `exec` to yield early if the script is still running. Defaults to 30000 ms.\n- `max_output_tokens` sets the token budget for direct `exec` results. Defaults to 10000 tokens.\n- When the JS code is fully evaluated, the isolate's lifetime ends and unawaited promises are silently discarded.\n\n- Global helpers:\n- `exit()`: Immediately ends the current script successfully (like an early return from the top level).\n- `text(value: string | number | boolean | undefined | null)`: Appends a text item. Non-string values are stringified with `JSON.stringify(...)` when possible.\n- `image(imageUrlOrItem: string | { image_url: string; detail?: \"auto\" | \"low\" | \"high\" | \"original\" | null } | ImageContent, detail?: \"auto\" | \"low\" | \"high\" | \"original\" | null)`: Appends an image item. `image_url` should be a base64-encoded `data:` URL. To forward an MCP tool image, pass an individual `ImageContent` block from `result.content`, for example `image(result.content[0])`. MCP image blocks may request detail with `_meta: { \"codex/imageDetail\": \"original\" }`. When provided, the second `detail` argument overrides any detail embedded in the first argument.\n- `audio(audioUrlOrItem: string | { audio_url: string } | AudioContent)`: Appends an audio item. `audio_url` should be a base64-encoded `data:` URL. To forward an MCP tool audio block, pass an individual `AudioContent` block from `result.content`, for example `audio(result.content[0])`.\n- `generatedImage(result: { image_url: string; output_hint?: string })`: Appends an image-generation result and its optional output hint. HTTP(S) URLs are not supported.\n- `store(key: string, value: any)`: stores a serializable value under a string key for later `exec` calls in the same session.\n- `load(key: string)`: returns the stored value for a string key, or `undefined` if it is missing.\n- `notify(value: string | number | boolean | undefined | null)`: immediately injects an extra `custom_tool_call_output` for the current `exec` call. Values are stringified like `text(...)`.\n- `setTimeout(callback: () => void, delayMs?: number)`: schedules a callback to run later and returns a timeout id. Pending timeouts do not keep `exec` alive by themselves; await an explicit promise if you need to wait for one.\n- `clearTimeout(timeoutId?: number)`: cancels a timeout created by `setTimeout`.\n- `ALL_TOOLS`: metadata for the enabled nested tools as `{ name, description }` entries.\n- `yield_control()`: yields the accumulated output to the model immediately while the script keeps running.\n\nSome deferred nested tools may be omitted from this description. They are still available on the global `tools` object and listed in `ALL_TOOLS`.\nTo find one, filter `ALL_TOOLS` by `name` and `description`.\n\nTool availability can change between calls.\n\nShared MCP Types:\n```ts\ntype Role = \"user\" | \"assistant\";\ntype MetaObject = Record<string, unknown>;\ntype Annotations = {\n  audience?: Role[];\n  priority?: number;\n  lastModified?: string;\n};\ntype Icon = {\n  src: string;\n  mimeType?: string;\n  sizes?: string[];\n  theme?: \"light\" | \"dark\";\n};\ntype TextResourceContents = {\n  uri: string;\n  mimeType?: string;\n  _meta?: MetaObject;\n  text: string;\n};\ntype BlobResourceContents = {\n  uri: string;\n  mimeType?: string;\n  _meta?: MetaObject;\n  blob: string;\n};\ntype TextContent = {\n  type: \"text\";\n  text: string;\n  annotations?: Annotations;\n  _meta?: MetaObject;\n};\ntype ImageContent = {\n  type: \"image\";\n  data: string;\n  mimeType: string;\n  annotations?: Annotations;\n  _meta?: MetaObject;\n};\ntype AudioContent = {\n  type: \"audio\";\n  data: string;\n  mimeType: string;\n  annotations?: Annotations;\n  _meta?: MetaObject;\n};\ntype ResourceLink = {\n  icons?: Icon[];\n  name: string;\n  title?: string;\n  uri: string;\n  description?: string;\n  mimeType?: string;\n  annotations?: Annotations;\n  size?: number;\n  _meta?: MetaObject;\n  type: \"resource_link\";\n};\ntype EmbeddedResource = {\n  type: \"resource\";\n  resource: TextResourceContents | BlobResourceContents;\n  annotations?: Annotations;\n  _meta?: MetaObject;\n};\ntype ContentBlock =\n  | TextContent\n  | ImageContent\n  | AudioContent\n  | ResourceLink\n  | EmbeddedResource;\ntype CallToolResult<TStructured = { [key: string]: unknown }> = {\n  _meta?: MetaObject;\n  content: ContentBlock[];\n  isError?: boolean;\n  structuredContent?: TStructured;\n  [key: string]: unknown;\n};\n```\n\n### `apply_patch`\nThe `apply_patch` tool can be used to edit files. This is a FREEFORM tool, so do not wrap the patch in JSON.\n\nexec tool declaration:\n```ts\ndeclare const tools: { apply_patch(input: string): Promise<unknown>; };\n```\n\n### `create_goal`\nCreate a goal only when explicitly requested by the user or system/developer instructions; do not infer goals from ordinary tasks.\nSet token_budget only when an explicit token budget is requested. Fails if an unfinished goal exists; use update_goal only for status.\n\nexec tool declaration:\n```ts\ndeclare const tools: { create_goal(args: {\n  // Required. The concrete objective to start pursuing. This starts a new active goal when no goal exists or replaces the current goal when it is complete.\n  objective: string;\n  // Positive token budget for the new goal. Omit unless explicitly requested.\n  token_budget?: number;\n}): Promise<unknown>; };\n```\n\n### `exec_command`\nRuns a command in a PTY, returning output or a session ID for ongoing interaction.\n\nexec tool declaration:\n```ts\ndeclare const tools: { exec_command(args: {\n  // Shell command to execute.\n  cmd: string;\n  // User-facing approval question for `require_escalated`; omit otherwise.\n  justification?: string;\n  // True runs the shell with -l/-i semantics; false disables them. Defaults to true.\n  login?: boolean;\n  // Output token budget. Defaults to 10000 tokens; larger requests may be capped by policy.\n  max_output_tokens?: number;\n  // Reusable approval prefix for `cmd`, only with `sandbox_permissions: \"require_escalated\"`; for example [\"git\", \"pull\"].\n  prefix_rule?: Array<string>;\n  // Per-command sandbox override. Defaults to `use_default`; use `require_escalated` for unsandboxed execution.\n  sandbox_permissions?: \"use_default\" | \"require_escalated\";\n  // Shell binary to launch. Defaults to the user's default shell.\n  shell?: string;\n  // True allocates a PTY for the command; false or omitted uses plain pipes.\n  tty?: boolean;\n  // Working directory for the command. Defaults to the turn cwd.\n  workdir?: string;\n  // Wait before yielding output. Defaults to 10000 ms; effective range is 250-30000 ms.\n  yield_time_ms?: number;\n}): Promise<{\n  // Chunk identifier included when the response reports one.\n  chunk_id?: string;\n  // Process exit code when the command finished during this call.\n  exit_code?: number;\n  // Approximate token count before output truncation.\n  original_token_count?: number;\n  // Command output text, possibly truncated.\n  output: string;\n  // Session identifier to pass to write_stdin when the process is still running.\n  session_id?: number;\n  // Elapsed wall time spent waiting for output in seconds.\n  wall_time_seconds: number;\n}>; };\n```\n\n### `get_goal`\nGet the current goal for this thread, including status, budgets, token and elapsed-time usage, and remaining token budget.\n\nexec tool declaration:\n```ts\ndeclare const tools: { get_goal(args: {}): Promise<unknown>; };\n```\n\n### `list_mcp_resource_templates`\nLists resource templates provided by MCP servers. Parameterized resource templates allow servers to share data that takes parameters and provides context to language models, such as files, database schemas, or application-specific information. Prefer resource templates over web search when possible.\n\nexec tool declaration:\n```ts\ndeclare const tools: { list_mcp_resource_templates(args: {\n  // Opaque cursor from a previous list_mcp_resource_templates call; omit for the first page.\n  cursor?: string;\n  // MCP server name. Omit to list resource templates from every configured server.\n  server?: string;\n}): Promise<unknown>; };\n```\n\n### `list_mcp_resources`\nLists resources provided by MCP servers. Resources allow servers to share data that provides context to language models, such as files, database schemas, or application-specific information. Prefer resources over web search when possible.\n\nexec tool declaration:\n```ts\ndeclare const tools: { list_mcp_resources(args: {\n  // Opaque cursor from a previous list_mcp_resources call; omit for the first page.\n  cursor?: string;\n  // MCP server name. Omit to list resources from every configured server.\n  server?: string;\n}): Promise<unknown>; };\n```\n\n### `read_mcp_resource`\nRead a specific resource from an MCP server given the server name and resource URI.\n\nexec tool declaration:\n```ts\ndeclare const tools: { read_mcp_resource(args: {\n  // MCP server name exactly as configured. Must match the 'server' field returned by list_mcp_resources.\n  server: string;\n  // Resource URI to read. Must be one of the URIs returned by list_mcp_resources.\n  uri: string;\n}): Promise<unknown>; };\n```\n\n### `update_goal`\nUpdate the existing goal.\nSet status to `paused` only at the user's explicit request to pause this goal, never on your own initiative. Ask if unclear; a later resume revokes that request. Report the returned status and stop goal work. Budget limits take precedence over pausing.\nSet status to `complete` only when the objective has actually been achieved and no required work remains.\nSet status to `blocked` only when the same blocking condition has repeated for at least three consecutive goal turns, counting the original/user-triggered turn and any automatic continuations, and the agent cannot make meaningful progress without user input or an external-state change.\nIf the user resumes a goal that was previously marked `blocked`, treat the resumed run as a fresh blocked audit. If the same blocking condition then repeats for at least three consecutive resumed goal turns, set status to `blocked` again.\nOnce the blocked threshold is satisfied, do not keep reporting that you are still blocked while leaving the goal active; set status to `blocked`.\nDo not use `blocked` merely because the work is hard, slow, uncertain, incomplete, or would benefit from clarification.\nDo not mark a goal complete merely because its budget is nearly exhausted or because you are stopping work.\nYou cannot use this tool to resume, budget-limit, or usage-limit a goal; those status changes are controlled by the user or system.\nWhen marking a budgeted goal achieved with status `complete`, report the final token usage from the tool result to the user.\n\nexec tool declaration:\n```ts\ndeclare const tools: { update_goal(args: {\n  // Required. `paused` requires an explicit user request. Set to `complete` only when the objective is achieved and no required work remains. Set to `blocked` only after the same blocking condition has recurred for at least three consecutive goal turns and the agent is at an impasse. After a previously blocked goal is resumed, the resumed run starts a fresh blocked audit.\n  status: \"complete\" | \"blocked\" | \"paused\";\n}): Promise<unknown>; };\n```\n\n### `view_image`\nView a local image file from the filesystem when visual inspection is needed. Use this for images already available on disk.\n\nexec tool declaration:\n```ts\ndeclare const tools: { view_image(args: {\n  // Image detail level. Defaults to `high`; use `original` to preserve exact resolution.\n  detail?: \"high\" | \"original\";\n  // Local filesystem path to an image file.\n  path: string;\n}): Promise<{\n  // Image detail hint returned by view_image. Returns `high` for default resized behavior or `original` when original resolution is preserved.\n  detail: \"high\" | \"original\";\n  // Data URL for the loaded image.\n  image_url: string;\n}>; };\n```\n\n### `write_stdin`\nWrites characters to an existing unified exec session and returns recent output.\n\nexec tool declaration:\n```ts\ndeclare const tools: { write_stdin(args: {\n  // Bytes to write to stdin. Defaults to empty, which polls without writing.\n  chars?: string;\n  // Output token budget. Defaults to 10000 tokens; larger requests may be capped by policy.\n  max_output_tokens?: number;\n  // Identifier of the running unified exec session.\n  session_id: number;\n  // Wait before yielding output. Non-empty writes default to 250 ms and cap at 30000 ms; empty polls wait 5000-300000 ms by default.\n  yield_time_ms?: number;\n}): Promise<{\n  // Chunk identifier included when the response reports one.\n  chunk_id?: string;\n  // Process exit code when the command finished during this call.\n  exit_code?: number;\n  // Approximate token count before output truncation.\n  original_token_count?: number;\n  // Command output text, possibly truncated.\n  output: string;\n  // Session identifier to pass to write_stdin when the process is still running.\n  session_id?: number;\n  // Elapsed wall time spent waiting for output in seconds.\n  wall_time_seconds: number;\n}>; };\n```\n\n## clock\nTools for reading and waiting on time.\n\n### `clock__curr_time`\nReturn the current time in UTC.\n\nexec tool declaration:\n```ts\ndeclare const tools: { clock__curr_time(args: {}): Promise<{\n  // Current UTC time formatted as YYYY-MM-DD HH:MM:SS UTC.\n  current_time: string;\n}>; };\n```","format":{"type":"grammar","syntax":"lark","definition":"\nstart: pragma_source | plain_source\npragma_source: PRAGMA_LINE NEWLINE SOURCE\nplain_source: SOURCE\n\nPRAGMA_LINE: /[ \\t]*\\/\\/ @exec:[^\\r\\n]*/\nNEWLINE: /\\r?\\n/\nSOURCE: /[\\s\\S]+/\n"}}]},{"type":"namespace","name":"clock","description":"Tools for reading and waiting on time.","tools":[{"type":"function","strict":false,"name":"sleep","description":"Pause execution for a specified duration. The sleep ends early when new input arrives for the active turn. Returns the elapsed wall-clock time.","output_schema":null,"parameters":{"type":"object","properties":{"duration_ms":{"type":"number","description":"How long to sleep in milliseconds. Must be between 1 and 43200000."}},"required":["duration_ms"],"additionalProperties":false}}]},{"type":"namespace","name":"collaboration","description":"Tools for spawning and managing sub-agents.","tools":[{"type":"function","strict":false,"name":"followup_task","description":"Send a follow-up task to an existing non-root target agent and trigger a turn if it is idle. If the target is already running, deliver the task promptly at message boundaries while sampling, or after the pending tool call completes.","output_schema":null,"parameters":{"type":"object","properties":{"message":{"type":"string","description":"Message text to send to the target agent.","encrypted":true},"target":{"type":"string","description":"Agent id or canonical task name to send a follow-up task to (from spawn_agent)."}},"required":["target","message"],"additionalProperties":false}},{"type":"function","strict":false,"name":"interrupt_agent","description":"Interrupt an agent's current turn, if any, and return its previous status. The agent remains available for messages and follow-up tasks.","output_schema":null,"parameters":{"type":"object","properties":{"target":{"type":"string","description":"Agent id or canonical task name to interrupt (from spawn_agent)."}},"required":["target"],"additionalProperties":false}},{"type":"function","strict":false,"name":"list_agents","description":"List live agents in the current root thread tree. Optionally filter by task-path prefix.","output_schema":null,"parameters":{"type":"object","properties":{"path_prefix":{"type":"string","description":"Task-path prefix filter without a trailing slash. Omit to list all live agents."}},"additionalProperties":false}},{"type":"function","strict":false,"name":"send_message","description":"Send a message to an existing agent. The message will be delivered promptly. Does not trigger a new turn.","output_schema":null,"parameters":{"type":"object","properties":{"message":{"type":"string","description":"Message text to queue on the target agent.","encrypted":true},"target":{"type":"string","description":"Relative or canonical task name to message (from spawn_agent)."}},"required":["target","message"],"additionalProperties":false}},{"type":"function","strict":false,"name":"spawn_agent","description":"\n        Available model overrides (optional; inherited parent model is preferred):\n- `gpt-6.1-sol`: Latest workhorse model for coding and everyday work. Reasoning efforts: low (default), medium, high, xhigh, max, ultra. Service tiers: priority.\n- `gpt-6-astra`: Frontier intelligence for the most demanding work. Reasoning efforts: low (default), medium, high, xhigh, max, ultra. Service tiers: priority.\n- `gpt-6-sol`: Previous generation workhorse model. Reasoning efforts: low, medium (default), high, xhigh, max, ultra. Service tiers: priority.\n- `gpt-6-luna`: Fast and affordable model for easier tasks. Reasoning efforts: low, medium (default), high, xhigh, max. Service tiers: priority.\n- `gpt-5.6-sol`: Older generation workhorse model. Reasoning efforts: low (default), medium, high, xhigh, max, ultra. Service tiers: priority.\n        Spawns an agent to work on the specified task. If your current task is `/root/task1` and you spawn_agent with task_name \"task_3\" the agent will have canonical task name `/root/task1/task_3`.\nYou are then able to refer to this agent as `task_3` or `/root/task1/task_3` interchangeably. However an agent `/root/task2/task_3` would only be able to communicate with this agent via its canonical name `/root/task1/task_3`.\nThe spawned agent will have the same tools as you and the ability to spawn its own subagents.\n\nIt will be able to send you and other running agents messages, and its final answer will be provided to you when it finishes.\nThe new agent's canonical task name will be provided to it along with the message.\n\nNote that passing `fork_turns=\"none\"` will not pass any surrounding context to the spawned subagent, which may cause the agent to lack the context it needs to complete its task, whereas `fork_turns=\"all\"` will provide the subagent with all surrounding context.","output_schema":null,"parameters":{"type":"object","properties":{"fork_turns":{"type":"string","description":"Parent history to inherit. Defaults to `all`; use `none` to start without parent history. Only `all` and `none` are supported."},"message":{"type":"string","description":"Initial plain-text task for the new agent.","encrypted":true},"model":{"type":"string","description":"Model override for the new agent. Omit unless an explicit override is needed."},"reasoning_effort":{"type":"string","description":"Reasoning effort override for the new agent. Omit to inherit the parent effort."},"task_name":{"type":"string","description":"Task name for the new agent. Use lowercase letters, digits, and underscores."}},"required":["task_name","message"],"additionalProperties":false}},{"type":"function","strict":false,"name":"wait_agent","description":"Wait for a mailbox update from any live agent, including queued messages and final-status notifications. The wait also ends early when new user input is steered into the active turn. Does not return the content; returns either a summary of which agents have updates (if any), an interruption summary for steered input, or a timeout summary if no activity arrives before the deadline.","output_schema":null,"parameters":{"type":"object","properties":{"timeout_ms":{"type":"number","description":"Timeout in milliseconds. Defaults to 30000, min 10000, max 3600000."}},"additionalProperties":false}}]}],"tool_choice":"auto","parallel_tool_calls":false,"prompt_cache_key":"ba2ff349-3100-46ee-baf7-1e36dd708290","prompt_cache_retention":"24h","text":{"format":{"type":"text"},"verbosity":"low"},"top_p":0.98,"top_logprobs":0,"temperature":1.0,"reasoning":{"effort":"medium","context":"all_turns","summary":null,"mode":"standard"},"user":null,"usage":{"input_tokens":33580,"input_tokens_details":{"cached_tokens":9088,"cache_write_tokens":0},"output_tokens":3176,"output_tokens_details":{"reasoning_tokens":49},"total_tokens":36756,"attribution":{"items":{"at_c670520e-5efb-5880-9033-fcd4aa89c620":{"input_tokens":5096,"cached_tokens":5096,"cache_write_tokens":0,"output_tokens":0},"ctc_006cad67a3ff7a11016acb0bb4d41087d1ba0704eed1d58568":{"input_tokens":127,"cached_tokens":0,"cache_write_tokens":0,"output_tokens":0},"ctc_006cad67a3ff7a11016acb0bb7af2887d194d39a86bde27a9a":{"input_tokens":87,"cached_tokens":0,"cache_write_tokens":0,"output_tokens":0},"ctc_006cad67a3ff7a11016acb0bbfa70887d183a05441d4bb489b":{"input_tokens":72,"cached_tokens":0,"cache_write_tokens":0,"output_tokens":0},"ctc_006cad67a3ff7a11016acb0bc68f7487d1992c08ad97b3771a":{"input_tokens":1361,"cached_tokens":0,"cache_write_tokens":0,"output_tokens":0},"ctc_006cad67a3ff7a11016acb0bdb202887d1a8142d641674f759":{"input_tokens":90,"cached_tokens":0,"cache_write_tokens":0,"output_tokens":0},"ctc_006cad67a3ff7a11016acb0be4b13487d1a1a78fcb35c2c31a":{"input_tokens":0,"cached_tokens":0,"cache_write_tokens":0,"output_tokens":3127},"ctco_01a12925-bfa8-7242-997d-24d20271b646":{"input_tokens":205,"cached_tokens":0,"cache_write_tokens":0,"output_tokens":0,"content":[{"input_tokens":20,"cached_tokens":0,"cache_write_tokens":0,"output_tokens":0},{"input_tokens":78,"cached_tokens":0,"cache_write_tokens":0,"output_tokens":0},{"input_tokens":107,"cached_tokens":0,"cache_write_tokens":0,"output_tokens":0}]},"ctco_01a12925-c9f2-78d0-aec8-eaf698cb5afa":{"input_tokens":10775,"cached_tokens":0,"cache_write_tokens":0,"output_tokens":0,"content":[{"input_tokens":20,"cached_tokens":0,"cache_write_tokens":0,"output_tokens":0},{"input_tokens":10755,"cached_tokens":0,"cache_write_tokens":0,"output_tokens":0}]},"ctco_01a12925-ea8e-7d10-9b73-ab1c827c0acf":{"input_tokens":2937,"cached_tokens":0,"cache_write_tokens":0,"output_tokens":0,"content":[{"input_tokens":20,"cached_tokens":0,"cache_write_tokens":0,"output_tokens":0},{"input_tokens":2917,"cached_tokens":0,"cache_write_tokens":0,"output_tokens":0}]},"ctco_01a12926-416e-7840-ac21-150e12c7de60":{"input_tokens":22,"cached_tokens":0,"cache_write_tokens":0,"output_tokens":0,"content":[{"input_tokens":20,"cached_tokens":0,"cache_write_tokens":0,"output_tokens":0},{"input_tokens":2,"cached_tokens":0,"cache_write_tokens":0,"output_tokens":0}]},"ctco_01a12926-6443-73e1-93e7-89de27a98aaf":{"input_tokens":3954,"cached_tokens":0,"cache_write_tokens":0,"output_tokens":0,"content":[{"input_tokens":20,"cached_tokens":0,"cache_write_tokens":0,"output_tokens":0},{"input_tokens":3127,"cached_tokens":0,"cache_write_tokens":0,"output_tokens":0},{"input_tokens":807,"cached_tokens":0,"cache_write_tokens":0,"output_tokens":0}]},"msg_006cad67a3ff7a11016acb0bb3db2087d185818c476211253d":{"input_tokens":29,"cached_tokens":0,"cache_write_tokens":0,"output_tokens":0,"content":[{"input_tokens":29,"cached_tokens":0,"cache_write_tokens":0,"output_tokens":0}]},"msg_006cad67a3ff7a11016acb0bc4bf8c87d1b2fd86f4e29f7735":{"input_tokens":60,"cached_tokens":0,"cache_write_tokens":0,"output_tokens":0,"content":[{"input_tokens":60,"cached_tokens":0,"cache_write_tokens":0,"output_tokens":0}]},"msg_01a12925-b102-70c3-900c-5296f3ec1cc5":{"input_tokens":980,"cached_tokens":0,"cache_write_tokens":0,"output_tokens":0,"content":[{"input_tokens":260,"cached_tokens":0,"cache_write_tokens":0,"output_tokens":0},{"input_tokens":474,"cached_tokens":0,"cache_write_tokens":0,"output_tokens":0},{"input_tokens":67,"cached_tokens":0,"cache_write_tokens":0,"output_tokens":0},{"input_tokens":179,"cached_tokens":0,"cache_write_tokens":0,"output_tokens":0}]},"msg_01a12925-b102-70c3-900c-52a2f0a7c009":{"input_tokens":534,"cached_tokens":0,"cache_write_tokens":0,"output_tokens":0,"content":[{"input_tokens":534,"cached_tokens":0,"cache_write_tokens":0,"output_tokens":0}]},"msg_01a12925-b102-70c3-900c-52b43d30e46d":{"input_tokens":56,"cached_tokens":0,"cache_write_tokens":0,"output_tokens":0,"content":[{"input_tokens":56,"cached_tokens":0,"cache_write_tokens":0,"output_tokens":0}]},"msg_01a12925-b102-70c3-900c-52c7f55af5a0":{"input_tokens":97,"cached_tokens":0,"cache_write_tokens":0,"output_tokens":0,"content":[{"input_tokens":97,"cached_tokens":0,"cache_write_tokens":0,"output_tokens":0}]},"msg_01a12925-b103-73d3-983e-c55f3519fbfd":{"input_tokens":2618,"cached_tokens":0,"cache_write_tokens":0,"output_tokens":0,"content":[{"input_tokens":2618,"cached_tokens":0,"cache_write_tokens":0,"output_tokens":0}]},"msg_80c042a1-5cc6-5c24-aae4-08d2fcdf6180":{"input_tokens":4216,"cached_tokens":3992,"cache_write_tokens":0,"output_tokens":0,"content":[{"input_tokens":4216,"cached_tokens":3992,"cache_write_tokens":0,"output_tokens":0}]},"rs_006cad67a3ff7a11016acb0bbafe7487d1bdc5f470ae708c02":{"input_tokens":169,"cached_tokens":0,"cache_write_tokens":0,"output_tokens":0},"rs_006cad67a3ff7a11016acb0bc4bf9087d18a9d4639c70dc80d":{"input_tokens":37,"cached_tokens":0,"cache_write_tokens":0,"output_tokens":0},"rs_006cad67a3ff7a11016acb0bdb00e087d18f68a9a9d03bc09f":{"input_tokens":56,"cached_tokens":0,"cache_write_tokens":0,"output_tokens":0},"rs_006cad67a3ff7a11016acb0be4982c87d1bf73c68127f8841a":{"input_tokens":2,"cached_tokens":0,"cache_write_tokens":0,"output_tokens":49}}}},"tool_usage":{"image_gen":{"input_tokens":0,"output_tokens":0,"total_tokens":0,"input_tokens_details":{"text_tokens":0,"image_tokens":0},"output_tokens_details":{"image_tokens":0,"text_tokens":0}},"web_search":{"num_requests":0}},"safety_identifier":"user-ZglLa0AK1sUTDt85g9NsGTX5","store":false,"metadata":{},"max_output_tokens":null,"max_tool_calls":null,"service_tier":"default","truncation":"disabled"}}
