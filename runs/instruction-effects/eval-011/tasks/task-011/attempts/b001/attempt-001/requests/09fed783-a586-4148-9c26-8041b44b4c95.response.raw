data: {"type":"response.function_call_arguments.done","sequence_number":886,"item_id":"fc_01b0b413febab242016acb0cc5227c87d1b031acefb7d564b4","output_index":0,"arguments":"{\"path\":\"server.js\",\"edits\":[{\"oldText\":\"const listProjects = db.prepare(`\",\"newText\":\"// Preserve historical creation order, while allowing moves to append in a project.\\nif (!db.prepare('PRAGMA table_info(tasks)').all().some(column => column.name === 'position')) {\\n  db.exec('ALTER TABLE tasks ADD COLUMN position INTEGER NOT NULL DEFAULT 0; UPDATE tasks SET position = id');\\n}\\nconst destinationsFor = db.prepare('SELECT id, name FROM projects WHERE archived = 0 AND id != ? ORDER BY id');\\nconst moveTask = db.prepare(`\\n  UPDATE tasks SET project_id = ?,\\n    position = (SELECT COALESCE(MAX(position), 0) + 1 FROM tasks WHERE project_id = ?)\\n  WHERE id = ? AND project_id = ?\\n`);\\nconst listProjects = db.prepare(`\"},{\"oldText\":\"const listTasks = db.prepare('SELECT id, title, completed, priority, due_date FROM tasks WHERE project_id = ? ORDER BY id');\\nconst createTask = db.prepare('INSERT INTO tasks (project_id, title, priority) VALUES (?, ?, ?)');\",\"newText\":\"const listTasks = db.prepare('SELECT id, title, completed, priority, due_date FROM tasks WHERE project_id = ? ORDER BY position, id');\\nconst createTask = db.prepare(`INSERT INTO tasks (project_id, title, priority, position)\\n  VALUES (?, ?, ?, (SELECT COALESCE(MAX(position), 0) + 1 FROM tasks WHERE project_id = ?))`);\"},{\"oldText\":\"  const rangeFields = `<input type=\\\"hidden\\\" name=\\\"dueFrom\\\"\",\"newText\":\"  const destinations = destinationsFor.all(project.id);\\n  const moveDisabled = project.archived || destinations.length === 0;\\n  const rangeFields = `<input type=\\\"hidden\\\" name=\\\"dueFrom\\\"\"},{\"oldText\":\"      <form method=\\\"post\\\" action=\\\"/projects/${project.id}/tasks/${task.id}/rename\\\">\",\"newText\":\"      <form method=\\\"post\\\" action=\\\"/projects/${project.id}/tasks/${task.id}/move\\\">\\n        ${rangeFields}\\n        <input type=\\\"hidden\\\" name=\\\"filter\\\" value=\\\"${filter}\\\">\\n        <input type=\\\"hidden\\\" name=\\\"priorityFilter\\\" value=\\\"${priority}\\\">\\n        <label for=\\\"destination-project-${task.id}\\\">Destination project</label>\\n        <select id=\\\"destination-project-${task.id}\\\" name=\\\"destination\\\"${moveDisabled ? ' disabled' : ''}>\\n          ${destinations.map(destination => `<option value=\\\"${destination.id}\\\">${escapeHtml(destination.name)}</option>`).join('')}\\n        </select>\\n        <button type=\\\"submit\\\"${moveDisabled ? ' disabled' : ''}>Move task</button>\\n      </form>\\n      <form method=\\\"post\\\" action=\\\"/projects/${project.id}/tasks/${task.id}/rename\\\">\"},{\"oldText\":\"(completion|rename|priority|due-date))?$/\",\"newText\":\"(completion|rename|priority|due-date|move))?$/\"},{\"oldText\":\"          if (taskMatch[3] === 'due-date') {\\n            result = setTaskDueDate.run\",\"newText\":\"          if (taskMatch[3] === 'move') {\\n            const destinationId = body.get('destination') || '';\\n            const destination = /^[1-9]\\\\d*$/.test(destinationId) ? findProject.get(destinationId) : null;\\n            if (!destination || destination.archived || destination.id === project.id) {\\n              sendHtml(response, 400, projectPage(project, filter, 'Choose an active destination project', selectedPriority, dueRange(body)));\\n              return;\\n            }\\n            result = moveTask.run(destination.id, destination.id, taskMatch[2], project.id);\\n          } else if (taskMatch[3] === 'due-date') {\\n            result = setTaskDueDate.run\"},{\"oldText\":\"          createTask.run(project.id, title, project.default_priority);\",\"newText\":\"          createTask.run(project.id, title, project.default_priority, project.id);\"}]}"}

