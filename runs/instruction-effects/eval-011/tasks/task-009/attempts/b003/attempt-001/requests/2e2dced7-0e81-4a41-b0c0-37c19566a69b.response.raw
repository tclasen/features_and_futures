data: {"type":"response.output_item.done","sequence_number":1064,"output_index":2,"item":{"type":"function_call","id":"fc_0c0d1c705e02c7ee016acb0ada46cc8197b59cf7ecdeb444c4","call_id":"call_d8e4cc65e35346a5ace95553e85e4fbf","name":"edit","arguments":"{\"path\":\"server.js\",\"edits\":[{\"oldText\":\"const listTasks = db.prepare('SELECT id, title, completed, priority FROM tasks WHERE project_id = ? ORDER BY id');\",\"newText\":\"// Older tasks have no due date; dates are stored as calendar strings, not timestamps.\\nif (!db.prepare('PRAGMA table_info(tasks)').all().some((column) => column.name === 'due_date')) {\\n  db.exec(\\\"ALTER TABLE tasks ADD COLUMN due_date TEXT NOT NULL DEFAULT ''\\\");\\n}\\nconst listTasks = db.prepare('SELECT id, title, completed, priority, due_date FROM tasks WHERE project_id = ? ORDER BY id');\\nconst setTaskDueDate = db.prepare('UPDATE tasks SET due_date = ? WHERE id = ? AND project_id = ?');\"},{\"oldText\":\"function page(title, content) {\",\"newText\":\"function validDueDate(value) {\\n  if (!/^\\\\d{4}-\\\\d{2}-\\\\d{2}$/.test(value)) return false;\\n  const [year, month, day] = value.split('-').map(Number);\\n  if (year < 1 || month < 1 || month > 12) return false;\\n  const leap = year % 4 === 0 && (year % 100 !== 0 || year % 400 === 0);\\n  const days = [31, leap ? 29 : 28, 31, 30, 31, 30, 31, 31, 30, 31, 30, 31];\\n  return day >= 1 && day <= days[month - 1];\\n}\\n\\nfunction page(title, content) {\"},{\"oldText\":\"taskRenameError = null, priority = 'All') {\",\"newText\":\"taskRenameError = null, priority = 'All', dueDateError = null) {\"},{\"oldText\":\"      </div>`).join('')}\\n    </section>`);\\n}\\n\\nasync function readForm\",\"newText\":\"        <form class=\\\"create\\\" action=\\\"/projects/${project.id}/tasks/${task.id}/due-date\\\" method=\\\"post\\\">\\n          <input type=\\\"hidden\\\" name=\\\"filter\\\" value=\\\"${filter}\\\">\\n          <input type=\\\"hidden\\\" name=\\\"priorityFilter\\\" value=\\\"${priority}\\\">\\n          <label for=\\\"task-due-date-${task.id}\\\">Task due date</label>\\n          <input id=\\\"task-due-date-${task.id}\\\" name=\\\"dueDate\\\" type=\\\"text\\\" value=\\\"${escape(task.due_date)}\\\"${project.archived ? ' disabled' : ''}${dueDateError === task.id ? ` aria-invalid=\\\"true\\\" aria-describedby=\\\"due-date-error-${task.id}\\\"` : ''}>\\n          ${dueDateError === task.id ? `<div id=\\\"due-date-error-${task.id}\\\" role=\\\"alert\\\">Due date must be a valid YYYY-MM-DD date</div>` : ''}\\n          <button type=\\\"submit\\\"${project.archived ? ' disabled' : ''}>Save due date</button>\\n        </form>\\n      </div>`).join('')}\\n    </section>`);\\n}\\n\\nasync function readForm\"},{\"oldText\":\"    const priorityMatch = url.pathname.match(\",\"newText\":\"    const dueDateMatch = url.pathname.match(/^\\\\/projects\\\\/([1-9]\\\\d*)\\\\/tasks\\\\/([1-9]\\\\d*)\\\\/due-date$/);\\n    if (request.method === 'POST' && dueDateMatch) {\\n      const project = getProject.get(dueDateMatch[1]);\\n      const task = project && getTask.get(dueDateMatch[2], project.id);\\n      if (!task) return sendHtml(response, 404, page('Not found', '<h1>Not found</h1>'));\\n      if (project.archived) return sendHtml(response, 403, page('Archived project', '<h1>Archived project</h1><p>Restore the project to change its tasks.</p>'));\\n      const form = await readForm(request);\\n      const dueDate = (form.get('dueDate') || '').trim();\\n      const filter = taskFilter(form.get('filter'));\\n      const priority = priorityFilter(form.get('priorityFilter'));\\n      if (dueDate && !validDueDate(dueDate)) {\\n        return sendHtml(response, 200, projectPage(project, filter, '', '', '', '', null, priority, task.id));\\n      }\\n      setTaskDueDate.run(dueDate, task.id, project.id);\\n      response.writeHead(303, { Location: projectLocation(project.id, filter, priority) });\\n      return response.end();\\n    }\\n    const priorityMatch = url.pathname.match(\"}]}","status":"completed"}}

