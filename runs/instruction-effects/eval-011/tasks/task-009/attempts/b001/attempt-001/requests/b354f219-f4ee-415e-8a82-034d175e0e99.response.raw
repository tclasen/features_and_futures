data: {"type":"response.function_call_arguments.done","arguments":"{\"path\":\"server.js\",\"edits\":[{\"oldText\":\"const listProjects = db.prepare(`\",\"newText\":\"// Dates are calendar strings, never timestamps; older tasks start without a date.\\nif (!db.prepare('PRAGMA table_info(tasks)').all().some(column => column.name === 'due_date')) {\\n  db.exec(\\\"ALTER TABLE tasks ADD COLUMN due_date TEXT NOT NULL DEFAULT ''\\\");\\n}\\nconst listProjects = db.prepare(`\"},{\"oldText\":\"SELECT id, title, completed, priority FROM tasks\",\"newText\":\"SELECT id, title, completed, priority, due_date FROM tasks\"},{\"oldText\":\"function projectFilter(value) {\",\"newText\":\"const setTaskDueDate = db.prepare('UPDATE tasks SET due_date = ? WHERE id = ? AND project_id = ?');\\n\\nfunction validDueDate(value) {\\n  if (value === '') return true;\\n  if (!/^\\\\d{4}-\\\\d{2}-\\\\d{2}$/.test(value)) return false;\\n  const [year, month, day] = value.split('-').map(Number);\\n  if (year < 1 || month < 1 || month > 12) return false;\\n  const leap = year % 4 === 0 && (year % 100 !== 0 || year % 400 === 0);\\n  const days = [31, leap ? 29 : 28, 31, 30, 31, 30, 31, 31, 30, 31, 30, 31];\\n  return day >= 1 && day <= days[month - 1];\\n}\\n\\nfunction projectFilter(value) {\"},{\"oldText\":\"      <form method=\\\"post\\\" action=\\\"/projects/${project.id}/tasks/${task.id}/rename\\\">\",\"newText\":\"      <form method=\\\"post\\\" action=\\\"/projects/${project.id}/tasks/${task.id}/due-date\\\">\\n        <input type=\\\"hidden\\\" name=\\\"filter\\\" value=\\\"${filter}\\\">\\n        <input type=\\\"hidden\\\" name=\\\"priorityFilter\\\" value=\\\"${priority}\\\">\\n        <label for=\\\"task-due-date-${task.id}\\\">Task due date</label>\\n        <div class=\\\"fields\\\"><input id=\\\"task-due-date-${task.id}\\\" name=\\\"dueDate\\\" type=\\\"text\\\" value=\\\"${escapeHtml(task.due_date)}\\\" autocomplete=\\\"off\\\"${project.archived ? ' disabled' : ''}>\\n        <button type=\\\"submit\\\"${project.archived ? ' disabled' : ''}>Save due date</button></div>\\n      </form>\\n      <form method=\\\"post\\\" action=\\\"/projects/${project.id}/tasks/${task.id}/rename\\\">\"},{\"oldText\":\"(completion|rename|priority))?$/\",\"newText\":\"(completion|rename|priority|due-date))?$/\"},{\"oldText\":\"          let result;\\n          if (taskMatch[3] === 'rename') {\",\"newText\":\"          const dueDate = (body.get('dueDate') || '').trim();\\n          if (taskMatch[3] === 'due-date' && !validDueDate(dueDate)) {\\n            sendHtml(response, 400, projectPage(project, filter, 'Due date must be a valid YYYY-MM-DD date', selectedPriority));\\n            return;\\n          }\\n          let result;\\n          if (taskMatch[3] === 'due-date') {\\n            result = setTaskDueDate.run(dueDate, taskMatch[2], project.id);\\n          } else if (taskMatch[3] === 'rename') {\"}]}","item_id":"fc_083f24044c4c0646016acb0add9eec81959e0cbd53a0a4d0cc","output_index":2,"sequence_number":900}

