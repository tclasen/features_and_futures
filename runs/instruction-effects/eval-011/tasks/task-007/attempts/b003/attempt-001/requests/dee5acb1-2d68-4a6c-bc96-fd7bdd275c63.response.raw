(project, filter, '', '', '', '', { id: task.id, title: enteredTitle }, priorityFilter(form.get('priorityFilter')))\"},{\"oldText\":\"projectPage(project, filter, 'Task title is required', enteredTitle)\",\"newText\":\"projectPage(project, filter, 'Task title is required', enteredTitle, '', '', null, priorityFilter(form.get('priorityFilter')))\"},{\"oldText\":\"projectPage(project, taskFilter(url.searchParams.get('filter')))\",\"newText\":\"projectPage(project, taskFilter(url.searchParams.get('filter')), '', '', '', '', null, priorityFilter(url.searchParams.get('priorityFilter')))\"},{\"oldText\":\"response.writeHead(303, { Location: `/projects/${project.id}?filter=${taskFilter(form.get('filter'))}` });\",\"newText\":\"response.writeHead(303, { Location: projectLocation(project.id, taskFilter(form.get('filter')), priorityFilter(form.get('priorityFilter'))) });\"}]}","item_id":"fc_0247122914e58d80016acb097260088193844adcb69009712b","output_index":2,"sequence_number":1227}

