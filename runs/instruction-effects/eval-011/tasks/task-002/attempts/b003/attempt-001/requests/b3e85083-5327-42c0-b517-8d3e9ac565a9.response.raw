data: {"type":"response.function_call_arguments.done","sequence_number":1602,"item_id":"fc_076d5cf627188ddc016acb043c790c8197930acd45590f929b","output_index":0,"arguments":"{\"path\":\"server.js\",\"edits\":[{\"oldText\":\"const escape = (value)\",\"newText\":\"db.exec(`CREATE TABLE IF NOT EXISTS tasks (\\n  id INTEGER PRIMARY KEY AUTOINCREMENT,\\n  project_id INTEGER NOT NULL REFERENCES projects(id),\\n  title TEXT NOT NULL,\\n  completed INTEGER NOT NULL DEFAULT 0 CHECK (completed IN (0, 1))\\n)`);\\nconst listTasks = db.prepare('SELECT id, title, completed FROM tasks WHERE project_id = ? ORDER BY id');\\nconst createTask = db.prepare('INSERT INTO tasks (project_id, title) VALUES (?, ?)');\\nconst completeTask = db.prepare('UPDATE tasks SET completed = ? WHERE id = ? AND project_id = ?');\\nconst getTask = db.prepare('SELECT id FROM tasks WHERE id = ? AND project_id = ?');\\nconst taskFilter = (value) => ['Open', 'Completed'].includes(value) ? value : 'All';\\n\\nconst escape = (value)\"},{\"oldText\":\"  input { width: 100%;\",\"newText\":\"  select { padding: 10px; font: inherit; margin-bottom: 12px; }\\n  .tasks { margin-top: 28px; }\\n  .task-row { padding: 16px 0; border-top: 1px solid #d8e0e9; overflow-wrap: anywhere; }\\n  .task-row label { display: flex; gap: 12px; align-items: center; font-weight: 400; }\\n  .task-row input { width: auto; }\\n  input { width: 100%;\"},{\"oldText\":\"function sendHtml(response, status, body) {\",\"newText\":\"function projectPage(project, filter = 'All', error = '', enteredTitle = '') {\\n  const tasks = listTasks.all(project.id).filter((task) =>\\n    filter === 'All' || Boolean(task.completed) === (filter === 'Completed'));\\n  return page(project.name, `<h1>${escape(project.name)}</h1>\\n    <form action=\\\"/\\\" method=\\\"get\\\"><button type=\\\"submit\\\">Projects</button></form>\\n    <form class=\\\"create\\\" action=\\\"/projects/${project.id}/tasks\\\" method=\\\"post\\\">\\n      <input type=\\\"hidden\\\" name=\\\"filter\\\" value=\\\"${filter}\\\">\\n      <label for=\\\"task-title\\\">Task title</label>\\n      <input id=\\\"task-title\\\" name=\\\"title\\\" type=\\\"text\\\" value=\\\"${escape(enteredTitle)}\\\"${error ? ' aria-invalid=\\\"true\\\" aria-describedby=\\\"task-error\\\"' : ''}>\\n      ${error ? `<div id=\\\"task-error\\\" role=\\\"alert\\\">${escape(error)}</div>` : ''}\\n      <button type=\\\"submit\\\">Create task</button>\\n    </form>\\n    <section class=\\\"tasks\\\" aria-label=\\\"Tasks\\\">\\n      <form action=\\\"/projects/${project.id}\\\" method=\\\"get\\\">\\n        <label for=\\\"task-filter\\\">Task filter</label>\\n        <select id=\\\"task-filter\\\" name=\\\"filter\\\" onchange=\\\"this.form.requestSubmit()\\\">\\n          ${['All', 'Open', 'Completed'].map((option) => `<option${option === filter ? ' selected' : ''}>${option}</option>`).join('')}\\n        </select>\\n      </form>\\n      ${tasks.map((task) => `<div class=\\\"task-row\\\" data-testid=\\\"task-row\\\">\\n        <form action=\\\"/projects/${project.id}/tasks/${task.id}\\\" method=\\\"post\\\">\\n          <input type=\\\"hidden\\\" name=\\\"filter\\\" value=\\\"${filter}\\\">\\n          <label><input type=\\\"checkbox\\\" name=\\\"completed\\\" value=\\\"1\\\" aria-label=\\\"${escape(`Complete ${task.title}`)}\\\"${task.completed ? ' checked' : ''} onchange=\\\"this.form.requestSubmit()\\\"><span>${escape(task.title)}</span></label>\\n        </form>\\n      </div>`).join('')}\\n    </section>`);\\n}\\n\\nasync function readForm(request) {\\n  let body = '';\\n  for await (const chunk of request) {\\n    body += chunk;\\n    if (Buffer.byteLength(body) > 1024 * 1024) {\\n      const error = new Error('Request too large');\\n      error.status = 413;\\n      throw error;\\n    }\\n  }\\n  return new URLSearchParams(body);\\n}\\n\\nfunction sendHtml(response, status, body) {\"},{\"oldText\":\"      let body = '';\\n      for await (const chunk of request) {\\n        body += chunk;\\n        if (Buffer.byteLength(body) > 1024 * 1024) {\\n          return sendHtml(response, 413, page('Request too large', '<h1>Request too large</h1>'));\\n        }\\n      }\\n      const enteredName = new URLSearchParams(body).get('name') || '';\",\"newText\":\"      const enteredName = (await readForm(request)).get('name') || '';\"},{\"oldText\":\"    const match = url.pathname.match(/^\\\\/projects\\\\/([1-9]\\\\d*)$/);\",\"newText\":\"    const taskMatch = url.pathname.match(/^\\\\/projects\\\\/([1-9]\\\\d*)\\\\/tasks(?:\\\\/([1-9]\\\\d*))?$/);\\n    if (request.method === 'POST' && taskMatch) {\\n      const project = getProject.get(taskMatch[1]);\\n      if (!project || (taskMatch[2] && !getTask.get(taskMatch[2], project.id))) {\\n        return sendHtml(response, 404, page('Not found', '<h1>Not found</h1>'));\\n      }\\n      const form = await readForm(request);\\n      const filter = taskFilter(form.get('filter'));\\n      if (taskMatch[2]) {\\n        completeTask.run(form.get('completed') === '1' ? 1 : 0, taskMatch[2], project.id);\\n      } else {\\n        const enteredTitle = form.get('title') || '';\\n        const title = enteredTitle.trim();\\n        if (!title) return sendHtml(response, 200, projectPage(project, filter, 'Task title is required', enteredTitle));\\n        createTask.run(project.id, title);\\n      }\\n      response.writeHead(303, { Location: `/projects/${project.id}?filter=${filter}` });\\n      return response.end();\\n    }\\n    const match = url.pathname.match(/^\\\\/projects\\\\/([1-9]\\\\d*)$/);\"},{\"oldText\":\"      if (project) return sendHtml(response, 200, page(project.name, `<h1>${escape(project.name)}</h1>\\n        <form action=\\\"/\\\" method=\\\"get\\\"><button type=\\\"submit\\\">Projects</button></form>`));\",\"newText\":\"      if (project) return sendHtml(response, 200, projectPage(project, taskFilter(url.searchParams.get('filter'))));\"},{\"oldText\":\"    if (!response.headersSent) sendHtml(response, 500, page('Error', '<h1>Something went wrong</h1>'));\",\"newText\":\"    if (!response.headersSent) sendHtml(response, error.status || 500, page('Error', `<h1>${error.status === 413 ? 'Request too large' : 'Something went wrong'}</h1>`));\"}]}"}

