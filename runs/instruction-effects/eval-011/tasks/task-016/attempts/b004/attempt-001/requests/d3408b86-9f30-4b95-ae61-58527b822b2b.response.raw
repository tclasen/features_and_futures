Id);\\n    if (!task) return json(res, 404, { error: 'Task not found' });\\n    if (db.prepare('SELECT archived FROM projects WHERE id=?').get(task.project_id)?.archived) return json(res, 403, { error: 'Project is archived' });\\n    db.prepare('UPDATE tasks SET deleted=? WHERE id=?').run(deletionMatch[2] === 'delete' ? 1 : 0, taskId);\\n    return json(res, 200, { ok: true });\\n  }\\n  const moveMatch = url.pathname.match(/^\\\\/api\\\\/tasks\\\\/(\\\\d+)\\\\/move$/);\"},{\"oldText\":\"const task = db.prepare('SELECT project_id FROM tasks WHERE id=?').get(taskId);\",\"newText\":\"const task = db.prepare('SELECT project_id, deleted FROM tasks WHERE id=?').get(taskId);\"},{\"oldText\":\"if (!task) return json(res, 404, { error: 'Task not found' });\\n    if (db.prepare('SELECT archived FROM projects WHERE id=?').get(task.project_id)?.archived) return json(res, 403, { error: 'Project is archived' });\\n    const destination\",\"newText\":\"if (!task) return json(res, 404, { error: 'Task not found' });\\n    if (task.deleted) return json(res, 403, { error: 'Task is deleted' });\\n    if (db.prepare('SELECT archived FROM projects WHERE id=?').get(task.project_id)?.archived) return json(res, 403, { error: 'Project is archived' });\\n    const destination\"},{\"oldText\":\"const task = db.prepare('SELECT project_id FROM tasks WHERE id=?').get(Number(taskMatch[1]));\\n    if (!task) return json(res, 404, { error: 'Task not found' });\",\"newText\":\"const task = db.prepare('SELECT project_id, deleted FROM tasks WHERE id=?').get(Number(taskMatch[1]));\\n    if (!task) return json(res, 404, { error: 'Task not found' });\\n    if (task.deleted) return json(res, 403, { error: 'Task is deleted' });\"}]}","status":"completed"}}

