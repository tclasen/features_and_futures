kens":203,"cache_write_tokens":0,"output_tokens":0}]},"fc_045542114a8a87a7016acb192a975c8193a7794717cb91e0ed":{"input_tokens":2,"cached_tokens":0,"cache_write_tokens":0,"output_tokens":1747},"msg_045542114a8a87a7016acb190f7ffc8193aac06477f8a7bb19":{"input_tokens":38,"cached_tokens":38,"cache_write_tokens":0,"output_tokens":0,"content":[{"input_tokens":38,"cached_tokens":38,"cache_write_tokens":0,"output_tokens":0}]},"msg_045542114a8a87a7016acb1929634481939a5384373b42294c":{"input_tokens":4197,"cached_tokens":4197,"cache_write_tokens":0,"output_tokens":0,"content":[{"input_tokens":4197,"cached_tokens":4197,"cache_write_tokens":0,"output_tokens":0}]},"rs_045542114a8a87a7016acb1907d6588193b464b05c1b78a9d6":{"input_tokens":199,"cached_tokens":199,"cache_write_tokens":0,"output_tokens":0},"rs_045542114a8a87a7016acb192631748193866ddd26838efa1a":{"input_tokens":65,"cached_tokens":0,"cache_write_tokens":0,"output_tokens":0}},"request_fields":{"instructions":{"input_tokens":649,"cached_tokens":649,"cache_write_tokens":0,"output_tokens":0},"tools":{"input_tokens":493,"cached_tokens":493,"cache_write_tokens":0,"output_tokens":0}}}},"tool_usage":{"image_gen":{"input_tokens":0,"output_tokens":0,"total_tokens":0,"input_tokens_details":{"text_tokens":0,"image_tokens":0},"output_tokens_details":{"image_tokens":0,"text_tokens":0}},"web_search":{"num_requests":0}},"safety_identifier":"user-ZglLa0AK1sUTDt85g9NsGTX5","store":false,"metadata":{},"max_output_tokens":null,"max_tool_calls":null,"service_tier":"default","truncation":"disabled"}}
