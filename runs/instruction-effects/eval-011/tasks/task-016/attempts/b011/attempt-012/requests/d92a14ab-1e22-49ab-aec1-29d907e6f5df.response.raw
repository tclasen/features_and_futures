data: {"type":"response.function_call_arguments.done","sequence_number":843,"item_id":"fc_0317fae36428a528016acb205b7ae08193876c15a3f08da9a5","output_index":1,"arguments":"{\"path\":\"public/index.html\",\"edits\":[{\"oldText\":\"<option>Completed</option></select></label>\",\"newText\":\"<option>Completed</option><option>Deleted</option></select></label>\"},{\"oldText\":\"(filter.value === 'All' || (filter.value === 'Completed') === Boolean(task.completed)) &&\",\"newText\":\"(filter.value === 'Deleted' ? Boolean(task.deleted) : !task.deleted && (filter.value === 'All' || (filter.value === 'Completed') === Boolean(task.completed))) &&\"},{\"oldText\":\"${locked ? ' disabled' : ''}><label>New task title\",\"newText\":\"${locked || task.deleted ? ' disabled' : ''}><label>New task title\"},{\"oldText\":\"data-rename-title=\\\"${task.id}\\\"${locked ? ' disabled' : ''}\",\"newText\":\"data-rename-title=\\\"${task.id}\\\"${locked || task.deleted ? ' disabled' : ''}\"},{\"oldText\":\"data-rename-task=\\\"${task.id}\\\"${locked ? ' disabled' : ''}\",\"newText\":\"data-rename-task=\\\"${task.id}\\\"${locked || task.deleted ? ' disabled' : ''}\"},{\"oldText\":\"data-priority=\\\"${task.id}\\\"${locked ? ' disabled' : ''}\",\"newText\":\"data-priority=\\\"${task.id}\\\"${locked || task.deleted ? ' disabled' : ''}\"},{\"oldText\":\"data-due-date=\\\"${task.id}\\\" value=\",\"newText\":\"data-due-date=\\\"${task.id}\\\" value=\"},{\"oldText\":\"${locked ? ' disabled' : ''}></label><button type=\\\"button\\\" data-save-due\",\"newText\":\"${locked || task.deleted ? ' disabled' : ''}></label><button type=\\\"button\\\" data-save-due\"},{\"oldText\":\"data-save-due=\\\"${task.id}\\\"${locked ? ' disabled' : ''}\",\"newText\":\"data-save-due=\\\"${task.id}\\\"${locked || task.deleted ? ' disabled' : ''}\"},{\"oldText\":\"${locked || !destinations.length ? ' disabled' : ''}>${destinations\",\"newText\":\"${locked || task.deleted || !destinations.length ? ' disabled' : ''}>${destina