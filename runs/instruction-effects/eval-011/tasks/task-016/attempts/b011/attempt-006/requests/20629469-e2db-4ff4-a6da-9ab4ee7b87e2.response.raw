 task title\\\" data-rename-title=\\\"${task.id}\\\"${readonly ? ' disabled' : ''}></label><button type=\\\"button\\\" data-rename-task=\\\"${task.id}\\\"${readonly ? ' disabled' : ''}>Rename task</button><label>Task priority<select aria-label=\\\"Task priority\\\" data-priority=\\\"${task.id}\\\"${readonly ? ' disabled' : ''}>\"} ,{\"oldText\":\"${locked ? ' disabled' : ''}></select></label><label>Task due date<input type=\\\"text\\\" aria-label=\\\"Task due date\\\" placeholder=\\\"YYYY-MM-DD\\\" data-due-date=\\\"${task.id}\\\" value=\\\"${escapeHtml(task.dueDate || '')}\\\"${locked ? ' disabled' : ''}></label><button type=\\\"button\\\" data-save-due=\\\"${task.id}\\\"${locked ? ' disabled' : ''}>Save due date</button><label>Destination project<select aria-label=\\\"Destination project\\\" data-destination=\\\"${task.id}\\\"${locked || !destinations.length ? ' disabled' : ''}>\",\"newText\":\"${readonly ? ' disabled' : ''}></select></label><label>Task due date<input type=\\\"text\\\" aria-label=\\\"Task due date\\\" placeholder=\\\"YYYY-MM-DD\\\" data-due-date=\\\"${task.id}\\\" value=\\\"${escapeHtml(task.dueDate || '')}\\\"${readonly ? ' disabled' : ''}></label><button type=\\\"button\\\" data-save-due=\\\"${task.id}\\\"${readonly ? ' disabled' : ''}>Save due date</button><label>Destination project<select aria-label=\\\"Destination project\\\" data-destination=\\\"${task.id}\\\"${readonly || !destinations.length ? ' disabled' : ''}>\"} ,{\"oldText\":\"${locked ? ' disabled' : ''}>${destinations.map(destination => `<option value=\\\"${destination.id}\\\">${escapeHtml(destination.name)}</option>`).join('')}</select></label><button type=\\\"button\\\" data-move-task=\\\"${task.id}\\\"${locked || !destinations.length ? ' disabled' : ''}>Move task</button><label>Task notes<textarea aria-label=\\\"Task notes\\\" data-notes=\\\"${task.id}\\\"${locked ? ' disabled' : ''}>${escapeHtml(task.notes || '')}</textarea></label><button type=\\\"button\\\" data-save-notes=\\\"${task.id}\\\"${locked ? ' disabled' : ''}>Save notes</button></li>`).join('');\",\"newText\":\"${readonly ? ' disabled' : ''}>${destinations.map(destination => `<option value=\\\"${destination.id}\\\">${escapeHtml(destination.name)}</option>`).join('')}</select></label><button type=\\\"button\\\" data-move-task=\\\"${task.id}\\\"${readonly || !destinations.length ? ' disabled' : ''}>Move task</button><label>Task notes<textarea aria-label=\\\"Task notes\\\" data-notes=\\\"${task.id}\\\"${readonly ? ' disabled' : ''}>${escapeHtml(task.notes || '')}</textarea></label><button type=\\\"button\\\" data-save-notes=\\\"${task.id}\\\"${readonly ? ' disabled' : ''}>Save notes</button><button type=\\\"button\\\" data-delete-task=\\\"${task.id}\\\"${locked ? ' disabled' : ''}>${task.deleted ? 'Restore task' : 'Delete task'}</button></li>`; }).join('');\"}]}"}

