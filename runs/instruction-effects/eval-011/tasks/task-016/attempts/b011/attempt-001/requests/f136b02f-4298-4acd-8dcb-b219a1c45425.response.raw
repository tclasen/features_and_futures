data: {"type":"response.function_call_arguments.done","arguments":"{\"path\":\"public/index.html\",\"edits\":[{\"oldText\":\"${locked ? ' disabled' : ''}></label><button type=\\\"button\\\" data-save-due=\\\"${task.id}\\\"${locked ? ' disabled' : ''}>Save due date</button><label>Destination project<select aria-label=\\\"Destination project\\\" data-destination=\\\"${task.id}\\\"${locked || !destinations.length ? ' disabled' : ''}>\",\"newText\":\"${readonly ? ' disabled' : ''}></label><button type=\\\"button\\\" data-save-due=\\\"${task.id}\\\"${readonly ? ' disabled' : ''}>Save due date</button><label>Destination project<select aria-label=\\\"Destination project\\\" data-destination=\\\"${task.id}\\\"${readonly || !destinations.length ? ' disabled' : ''}>\"},{\"oldText\":\"data-move-task=\\\"${task.id}\\\"${locked || !destinations.length ? ' disabled' : ''}>Move task</button><label>Task notes<textarea aria-label=\\\"Task notes\\\" data-notes=\\\"${task.id}\\\"${locked ? ' disabled' : ''}>\",\"newText\":\"data-move-task=\\\"${task.id}\\\"${readonly || !destinations.length ? ' disabled' : ''}>Move task</button><label>Task notes<textarea aria-label=\\\"Task notes\\\" data-notes=\\\"${task.id}\\\"${readonly ? ' disabled' : ''}>\"},{\"oldText\":\"data-save-notes=\\\"${task.id}\\\"${locked ? ' disabled' : ''}>Save notes</button></li>`).join('');\",\"newText\":\"data-save-notes=\\\"${task.id}\\\"${readonly ? ' disabled' : ''}>Save notes</button><button type=\\\"button\\\" data-toggle-deleted=\\\"${task.id}\\\" data-deleted=\\\"${task.deleted ? 'true' : 'false'}\\\"${locked ? ' disabled' : ''}>${task.deleted ? 'Restore task' : 'Delete task'}</button></li>`; }).join('');\"},{\"oldText\":\"        list.querySelectorAll('[data-rename-task]').forEach(button => button.addEventListener('click', async () => {\",\"newText\":\"        list.querySelectorAll('[data-toggle-deleted]').forEach(button => button.addEventListener('click', async () => {\\n          await fetch(`/api/tasks/${button.dataset.toggleDeleted}`, { method: 'PATCH', headers: {'content-type':'application/json'}, body: JSON.stringify({deleted: button.dataset.deleted !== 'true'}) });\\n          await loadTasks();\\n        }));\\n        list.querySelectorAll('[data-rename-task]').forEach(button => button.addEventListener('click', async () => {\"}]}","item_id":"fc_08ef4d17b363baf9016acb1927e0e08197852cf744b2682ede","output_index":1,"sequence_number":562}

