data: {"type":"response.function_call_arguments.done","sequence_number":1135,"item_id":"fc_037e2da916fa3041016acb2b518f3081969b0f3c6bfccbb2ba","output_index":1,"arguments":"{\"path\":\"public/index.html\",\"edits\":[{\"oldText\":\"        list.innerHTML = shown.map(task => `<li class=\\\"task-row\\\" data-testid=\\\"task-row\\\"><span>${escapeHtml(task.title)}</span><input type=\\\"checkbox\\\" aria-label=\\\"Complete ${escapeHtml(task.title)}\\\" data-task=\\\"${task.id}\\\" ${task.completed ? 'checked' : ''}${locked ? ' disabled' : ''}><label>New task title<input aria-label=\\\"New task title\\\" data-rename-title=\\\"${task.id}\\\"${locked ? ' disabled' : ''}></label><button type=\\\"button\\\" data-rename-task=\\\"${task.id}\\\"${locked ? ' disabled' : ''}>Rename task</button><label>Task priority<select aria-label=\\\"Task priority\\\" data-priority=\\\"${task.id}\\\"${locked ? ' disabled' : ''}><option${task.priority === 'Low' ? ' selected' : ''}>Low</option><option${task.priority === 'Normal' ? ' selected' : ''}>Normal</option><option${task.priority === 'High' ? ' selected' : ''}>High</option></select></label><label>Task due date<input type=\\\"text\\\" aria-label=\\\"Task due date\\\" placeholder=\\\"YYYY-MM-DD\\\" data-due-date=\\\"${task.id}\\\" value=\\\"${escapeHtml(task.dueDate || '')}\\\"${locked ? ' disabled' : ''}></label><button type=\\\"button\\\" data-save-due=\\\"${task.id}\\\"${locked ? ' disabled' : ''}>Save due date</button><label>Destination project<select aria-label=\\\"Destination project\\\" data-destination=\\\"${task.id}\\\"${locked || !destinations.length ? ' disabled' : ''}>${destinations.map(destination => `<option value=\\\"${destination.id}\\\">${escapeHtml(destination.name)}</option>`).join('')}</select></label><button type=\\\"button\\\" data-move-task=\\\"${task.id}\\\"${locked || !destinations.length ? ' disabled' : ''}>Move task</button><label>Task notes<textarea aria-label=\\\"Task notes\\\" data-notes=\\\"${task.id}\\\"${locked ? ' disabled' : ''}>${escapeHtml(task.notes || '')}</textarea></label><button type=\\\"button\\\" data-save-notes=\\\"${task.id}\\\"${locked || task.deleted ? ' disabled' : ''}>Save notes</button>${task.deleted ? `<button type=\\\"button\\\" data-restore-task=\\\"${task.id}\\\"${locked ? ' disabled' : ''}>Restore task</button>` : `<button type=\\\"button\\\" data-delete-task=\\\"${task.id}\\\"${locked ? ' disabled' : ''}>Delete task</button>`}</li>`).join('');\",\"newText\":\"        list.innerHTML = shown.map(task => { const readOnly = locked || Boolean(task.deleted); return `<li class=\\\"task-row\\\" data-testid=\\\"task-row\\\"><span>${escapeHtml(task.title)}</span><input type=\\\"checkbox\\\" aria-label=\\\"Complete ${escapeHtml(task.title)}\\\" data-task=\\\"${task.id}\\\" ${task.completed ? 'checked' : ''}${readOnly ? ' disabled' : ''}><label>New task title<input aria-label=\\\"New task title\\\" data-rename-title=\\\"${task.id}\\\"${readOnly ? ' disabled' : ''}></label><button type=\\\"button\\\" data-rename-task=\\\"${task.id}\\\"${readOnly ? ' disabled' : ''}>Rename task</button><label>Task priority<select aria-label=\\\"Task priority\\\" data-priority=\\\"${task.id}\\\"${readOnly ? ' disabled' : ''}><option${task.priority === 'Low' ? ' selected' : ''}>Low</option><option${task.priority === 'Normal' ? ' selected' : ''}>Normal</option><option${task.priority === 'High' ? ' selected' : ''}>High</option></select></label><label>Task due date<input type=\\\"text\\\" aria-label=\\\"Task due date\\\" placeholder=\\\"YYYY-MM-DD\\\" data-due-date=\\\"${task.id}\\\" value=\\\"${escapeHtml(task.dueDate || '')}\\\"${readOnly ? ' disabled' : ''}></label><button type=\\\"button\\\" data-save-due=\\\"${task.id}\\\"${readOnly ? ' disabled' : ''}>Save due date</button><label>Destination project<select aria-label=\\\"Destination project\\\" data-destination=\\\"${task.id}\\\"${readOnly || !destinations.length ? ' disabled' : ''}>${destinations.map(destination => `<option value=\\\"${destination.id}\\\">${escapeHtml(destination.name)}</option>`).join('')}</select></label><button type=\\\"button\\\" data-move-task=\\\"${task.id}\\\"${readOnly || !destinations.length ? ' disabled' : ''}>Move task</button><label>Task notes<textarea aria-label=\\\"Task notes\\\" data-notes=\\\"${task.id}\\\"${readOnly ? ' disabled' : ''}>${escapeHtml(task.notes || '')}</textarea></label><button type=\\\"button\\\" data-save-notes=\\\"${task.id}\\\"${readOnly ? ' disabled' : ''}>Save notes</button>${task.deleted ? `<button type=\\\"button\\\" data-restore-task=\\\"${task.id}\\\"${locked ? ' disabled' : ''}>Restore task</button>` : `<button type=\\\"button\\\" data-delete-task=\\\"${task.id}\\\"${locked ? ' disabled' : ''}>Delete task</button>`}</li>`; }).join('');\"}]}"}

