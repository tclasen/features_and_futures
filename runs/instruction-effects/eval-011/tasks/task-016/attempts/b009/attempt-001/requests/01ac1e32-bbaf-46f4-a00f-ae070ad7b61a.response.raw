data: {"type":"response.completed","sequence_number":2862,"safety_buffering":false,"response":{"id":"resp_0b534dcad4dc6e2a016acb1925c0048195b66c6da33a9442f2","object":"response","created_at":1791695141,"completed_at":1791695188,"status":"completed","background":false,"frequency_penalty":0.0,"presence_penalty":0.0,"moderation":null,"model":"gpt-6.1-sol","access_programs":{"cyber":"standard"},"previous_response_id":null,"instructions":null,"output":[{"type":"reasoning","id":"rs_0b534dcad4dc6e2a016acb1928d7dc819585e62c4da77a3424","metadata":{"turn_id":"01a12959-a060-7330-bf1f-4594934f56b9"},"internal_chat_message_metadata_passthrough":{"turn_id":"01a12959-a060-7330-bf1f-4594934f56b9"},"summary":[],"content":[],"encrypted_content":"gAAAAABqyxkoLgrlbYjucWlqWpHsC1Urpfu_6SE2-P_K1PT9qKf7wrgu2OLwXxB4ubSufDDIj0ddT-2r6Yv9GqokZHXPhfstqfkwoIBZqN_Pocy-nd3ypi-oU-Nt-WTmcqLimU_0870neSBp43umW_xpgT_yKJgrvPSrNBytNhrSG8Z4y-UeEyMo5JHDSY-eXrPd-Gt8A0nxTDUoN-XrMa6DOIF8sIJs2mDe553dy1xz2f6gG0Vx116u5erNpctpcq6keJ4FWCJigdOjVg8i5W1kAgiwpyf4LeJR05uWVfSz6qrLMUNk9Pzv3YAPuwWUQfR4ICLRUkiP50CjDlVOb18jbb7JSxge3rtPdGgAD7ggiSsUNDbB-Gh4kSsonivNFN5-0q0GtammvsMNywdG2WUCg_LALtkSOQfS11YfbpKjx_W5VwJqoDqwwI58GbocpA43KdxPpYd3WlD9IvlQVQOhjja6EbjUnMOh8ehDR-fYfZDlkvc483-foKCQqTThvexh4BeGunE0M_oUBLXMyaEatrfXaAA2HM6vxHPLu67D7OedNrz9vEyWRAFpCcwh0Boxm1VFINfHg_jxSPumlA3d24LYCkkopjli2g5vOPlExPrI3G3shPlv6M-aEA6r8ZJoJzLa1MwE_yEI3GxHNbSEc7TnuozBEAObYxUKfbpt_z1YyjB5PmYMHlMi-eBUYRFsUMdxKxs6E-vJzSATzZ3-qeHcn9mKxMn68uZymRYhy9kTPg2ron71CB1UY166AHiB8o-RWZvk39ZNzybRLIef_v9odo-6rdg2oKC_jLP0HxesVqebqbi_um9jgIRr1fkMNE6opuiwXo3_TYg3jZA0hrTAR_vuRkgOzkKqyq2xmLvgrLbjdSrz2c9GV7c8vv0NHQmvjROlA53NDHTNi2oTm8sZguCdc7zdA_snZadiDpuj-s_aO-EgircSwpaBWx9UCNggNvEkEl9IylUTZ5gZfjvGS7iM9DvPgKaHJqg0EDqrc3Bir9uLq4VKRFw_XZ5VIWU2-qnRhSO5D0tN_4u5pBRH0Bkl5TcSqNGiuQQFq3-5T_krPOmfDImQAL9imqKtQp5xd40EVFKDrSFHlzMpEthkQBjJ-ZYo6tWHSy1gpJH11rgw1z0N5c3p8eUO9dvqJWwhXKs26nWWcNWcQ1cE8AywImdljnAosQntfAcj6kpnB_arQkqb9eoYVnDc92uTdUlzixW420Kp5PqGvQU68HCTdx32mNzYfWFtXlJg4fXQGA2kdXli8QYJcnyj_ooJ3rutGW8aZP4ugI03GNNu56KEIo415MRumcQ7PLcC7v7DlBX0qiaef_oGjltpbMGNMSJVOAgnTG9kwAbS8FkM7wvEmcXhNxUjxWQnCV0ca577OpVR69Pw3_xQ0hrdoVgXHuBIQ7nZwXX9uQrR_2JNPAtbergWnkinb6DDsDR3TeT80fPBG4HtV4wuHSpPfL54FQUl5t-OpYxYM5Xea-Z_XQLo6gp5Pzg5mzz_ZGBaZ_PFoDkbSRcVoCytpfd-T0jk9OrKL0Op3yiZhgdfE24QsSNAeYw8WtXwC_Nj3uRyMM9wcL1kiknQKoSnLU0Ze4PCBB1323Py7edf6TMlWAV15JvPvryQpYGB_peBrw_yElGJ4-FkXH12cH_Em69BPoCgOGAzg0tsA3__LtnzDjpX4kjxrBFkVOodhsf5gPcgZCVyg3yUsOPlCLexGz61ey37O5lvPRY24YCLLZKKDBVly-aDzswYPblcbQSsgLOh1SXSSqVDeaULmsYdfmOnWW27VcfZSjKrvnuyO4ixdC6-GVQMzmyYqfUoJdNtpRGfNifJHsFjFr8neqhmdzmHSsxbD228Drg4swfEVXiva2WiWGMhDdld_yxMZCW7kySW1ao8jyabCUoYpiS-UfNiNvCMeiHmXXAwA6vDeaQAh_CC3zQCY52YQYhrHwJxksgWqNoXiZ2QlYOnUCHifErNLL__6-knnAIROh3esvXniG_5ILViRNWWtLUIGNtJmRRX9v-Nh5BDc-yAvxUhmGHaxWwUDY7oYE3LJIAznDD3j7RpGHxEAOX5gmFls8EibHULbImJi-BSrlOTCz7TthxAHe__a_82AXH5myep06sOgPwCQGQimePLW36YfULubQyU734hWOHSVvAFT0RqvBrL1jMyxQzj8qYdaWGxRAI3D5_qGTm2AMh4-uV934YTo_JA8XOccfP44Eq-wre_AKpVI4T-hpzAkpXWtjYW6N32UE50dnX2IY3vRDAvvOUG3b7oF3T0n0VmPJCcBpPl-FikIyUZN0Tc2alkZaO-9U1l901Jgr_mzsEUXhLf9Yp14H0NMlQetQDSjVLZsBLk_SuF2QZKfpRRkR0rwFpgyUs3rYZg3a1AeY3APh2q4XbBNqP_cCH1Cj-bocc_vTCvqIPbjPL7ruTsLtg8h6_yf3MAev4WNl-BReDBXg=="},{"type":"custom_tool_call","id":"ctc_0b534dcad4dc6e2a016acb192909648195a0e79ac929d10b2e","metadata":{"turn_id":"01a12959-a060-7330-bf1f-4594934f56b9"},"internal_chat_message_metadata_passthrough":{"create_time":1791695145.039706,"turn_id":"01a12959-a060-7330-bf1f-4594934f56b9"},"call_id":"call_4bffdd33177d4e26bb14e0f95021b6a3","name":"exec","input":"text(await tools.exec_command({cmd:\"cat >> test/server.test.js <<'EOF'\\n\\ntest('task deletion preserves fields and positions, intersects filters, and survives archive and restart', async () => {\\n  const directory = await mkdtemp(join(tmpdir(), 'workboard-deletion-'));\\n  const dbPath = join(directory, 'workboard.sqlite');\\n  const legacy = new DatabaseSync(dbPath);\\n  legacy.exec(`CREATE TABLE projects (id INTEGER PRIMARY KEY AUTOINCREMENT, name TEXT NOT NULL,\\n      archived INTEGER NOT NULL DEFAULT 0, default_task_priority TEXT NOT NULL DEFAULT 'Normal');\\n    CREATE TABLE tasks (id INTEGER PRIMARY KEY AUTOINCREMENT, project_id INTEGER NOT NULL REFERENCES projects(id),\\n      title TEXT NOT NULL, completed INTEGER NOT NULL DEFAULT 0, priority TEXT NOT NULL DEFAULT 'Normal',\\n      due_date TEXT NOT NULL DEFAULT '', notes TEXT NOT NULL DEFAULT '', position INTEGER NOT NULL);\\n    INSERT INTO projects (name) VALUES ('Source'), ('Destination');\\n    INSERT INTO tasks (project_id, title, completed, priority, due_date, notes, position)\\n      VALUES (1, 'Alpha first', 1, 'High', '2026-10-11', '  saved notes  ', 1),\\n             (1, 'Alpha second', 0, 'Low', '', '', 2),\\n             (1, 'Beta third', 0, 'High', '2026-11-01', '', 3);`);\\n  const originals = legacy.prepare('SELECT * FROM tasks ORDER BY id').all().map(task => ({ ...task, deleted: 0 }));\\n  legacy.close();\\n  let server;\\n  try {\\n    server = await start(dbPath);\\n    const post = (path, values = {}) => fetch(`${server.url}${path}`, {\\n      method: 'POST', body: new URLSearchParams(values), redirect: 'manual',\\n    });\\n    const html = async path => (await fetch(`${server.url}${path}`)).text();\\n    const snapshot = () => {\\n      const db = new DatabaseSync(dbPath);\\n      try {\\n        return {\\n          tasks: db.prepare('SELECT * FROM tasks ORDER BY id').all().map(task => ({ ...task })),\\n          positions: db.prepare('SELECT * FROM task_positions ORDER BY project_id, position').all(),\\n        };\\n      } finally { db.close(); }\\n    };\\n    const rows = page => [...page.matchAll(/<li data-testid=\\\"task-row\\\">([\\\\s\\\\S]*?)<\\\\/li>/g)].map(match => match[1]);\\n    const titles = page => rows(page).map(row => row.match(/<span>([^<]+)<\\\\/span>/)[1]);\\n    const summaries = async (filter = 'Active') => [...(await html(`/?filter=${filter}`))\\n      .matchAll(/data-testid=\\\"project-summary\\\">([^<]+)<\\\\/span>/g)].map(match => match[1]);\\n    const initial = snapshot();\\n    assert.deepEqual(initial.tasks, originals);\\n    assert.deepEqual(titles(await html('/projects/1')), originals.map(task => task.title));\\n    const filterSelect = (await html('/projects/1')).match(/<select id=\\\"task-filter\\\"[^>]*>[\\\\s\\\\S]*?<\\\\/select>/)[0];\\n    assert.deepEqual([...filterSelect.matchAll(/<option(?: selected)?>([^<]+)<\\\\/option>/g)].map(match => match[1]),\\n      ['All', 'Open', 'Completed', 'Deleted']);\\n    const state = { filter: 'Completed', priorityFilter: 'High', dueFrom: '2026-10-01', dueThrough: '2026-10-31', search: 'alpha' };\\n    const pathFor = state => `/projects/1?${new URLSearchParams(state)}`;\\n    const deletedState = { ...state, filter: 'Deleted' };\\n    const deletedPath = pathFor(deletedState);\\n    const deletion = await post('/projects/1/tasks/1/delete', state);\\n    assert.equal(deletion.status, 303);\\n    assert.equal(deletion.headers.get('location'), pathFor(state));\\n    assert.deepEqual(titles(await html(pathFor(state))), []);\\n    assert.deepEqual(titles(await html('/projects/1')), ['Alpha second', 'Beta third']);\\n    assert.deepEqual(summaries && await summaries(), ['0/2 completed', '0/0 completed']);\\n    assert.deepEqual(snapshot(), {\\n      tasks: originals.map(task => ({ ...task, deleted: task.id === 1 ? 1 : 0 })), positions: initial.positions,\\n    });\\n    await post('/projects/1/tasks/2/delete');\\n    await post('/projects/1/tasks/3/delete');\\n    assert.deepEqual(await summaries(), ['0/0 completed', '0/0 completed']);\\n    for (const filter of ['All', 'Open', 'Completed']) {\\n      assert.deepEqual(titles(await html(`/projects/1?filter=${filter}`)), []);\\n    }\\n    // Deleted tasks intersect priority, inclusive due boundaries, and title search.\\n    for (const priority of ['All', 'Low', 'Normal', 'High']) {\\n      for (const search of ['', 'ALPHA', 'beta', 'saved notes']) {\\n        for (const range of [{}, { dueFrom: '2026-10-11', dueThrough: '2026-10-11' }]) {\\n          assert.deepEqual(titles(await html(pathFor({ filter: 'Deleted', priorityFilter: priority, search, ...range }))),\\n            originals.filter(task => (priority === 'All' || task.priority === priority) &&\\n              task.title.toLowerCase().includes(search.toLowerCase()) &&\\n              (!range.dueFrom || task.due_date === range.dueFrom)).map(task => task.title));\\n        }\\n      }\\n    }\\n    const deletedPage = await html(deletedPath);\\n    assert.deepEqual(titles(deletedPage), ['Alpha first']);\\n    const row = rows(deletedPage)[0];\\n    for (const control of row.matchAll(/<(?:input|select|textarea)\\\\b[^>]*>/g)) {\\n      if (!control[0].includes('type=\\\"hidden\\\"')) assert.match(control[0], /disabled/);\\n    }\\n    for (const button of row.matchAll(/<button[^>]*>([^<]+)<\\\\/button>/g)) {\\n      assert.equal(button[0].includes('disabled'), button[1] !== 'Restore task');\\n    }\\n    assert.doesNotMatch(row, />Delete task</);\\n    for (const form of row.matchAll(/<form[^>]*>[\\\\s\\\\S]*?<\\\\/form>/g)) {\\n      for (const [name, value] of Object.entries(deletedState)) {\\n        assert.ok(form[0].includes(`name=\\\"${name}\\\" value=\\\"${value}\\\"`));\\n      }\\n    }\\n    const beforeForbidden = snapshot();\\n    for (const [suffix, values] of [\\n      ['', { completed: '0' }], ['/rename', { title: 'Changed' }], ['/priority', { priority: 'Low' }],\\n      ['/due-date', { dueDate: '' }], ['/notes', { notes: 'Changed' }], ['/move', { destination: '2' }],\\n    ]) {\\n      assert.equal((await post(`/projects/1/tasks/1${suffix}`, values)).status, 403);\\n    }\\n    assert.equal((await post('/projects/2/tasks/1/restore')).status, 404);\\n    assert.equal((await post('/projects/2/tasks/1/delete')).status, 404);\\n    assert.deepEqual(snapshot(), beforeForbidden);\\n    await post('/projects/1/default-priority', { priority: 'Low', ...deletedState });\\n    await post('/projects/1/tasks', { title: 'Later task', ...deletedState });\\n    assert.equal(snapshot().tasks[3].deleted, 0);\\n    assert.deepEqual(titles(await html(deletedPath)), ['Alpha first']);\\n    await post('/projects/1/archive');\\n    assert.deepEqual(await summaries('Archived'), ['0/1 completed']);\\n    const archivedPage = await html(deletedPath);\\n    assert.match(archivedPage, /disabled>Restore task<\\\\/button>/);\\n    assert.match(await html('/projects/1'), /disabled>Delete task<\\\\/button>/);\\n    for (const id of ['task-filter', 'priority-filter', 'task-search', 'due-from', 'due-through']) {\\n      assert.doesNotMatch(archivedPage.match(new RegExp(`<(?:input|select) id=\\\"${id}\\\"[^>]*>`))[0], /disabled/);\\n    }\\n    assert.equal((await post('/projects/1/tasks/1/restore', deletedState)).status, 403);\\n    assert.equal((await post('/projects/1/tasks/4/delete')).status, 403);\\n    await server.stop();\\n    server = undefined;\\n    server = await start(dbPath);\\n    assert.equal(await html(deletedPath), archivedPage);\\n    await post('/projects/1/restore');\\n    // Restore in reverse order; reserved positions outrank tasks created during deletion.\\n    for (const id of [3, 2, 1]) {\\n      const restored = await post(`/projects/1/tasks/${id}/restore`, deletedState);\\n      assert.equal(restored.status, 303);\\n      assert.equal(restored.headers.get('location'), deletedPath);\\n    }\\n    assert.deepEqual(titles(await html(deletedPath)), []);\\n    assert.deepEqual(titles(await html('/projects/1')), ['Alpha first', 'Alpha second', 'Beta third', 'Later task']);\\n    assert.deepEqual(titles(await html(pathFor(state))), ['Alpha first']);\\n    assert.deepEqual(await summaries(), ['1/4 completed', '0/0 completed']);\\n    assert.deepEqual(snapshot().tasks.slice(0, 3), originals);\\n    assert.deepEqual(snapshot().positions.slice(0, 3), initial.positions);\\n    // A restored task can move, be deleted at its new owner, restore, and return to its old slot.\\n    await post('/projects/1/tasks/1/move', { destination: '2', ...state });\\n    await post('/projects/2/tasks/1/delete');\\n    assert.deepEqual(await summaries(), ['0/3 completed', '0/0 completed']);\\n    await post('/projects/2/tasks/1/restore', { filter: 'Deleted' });\\n    await post('/projects/2/tasks/1/move', { destination: '1' });\\n    assert.deepEqual(snapshot().tasks.slice(0, 3), originals);\\n    const finalPage = await html('/projects/1');\\n    assert.deepEqual(titles(finalPage), ['Alpha first', 'Alpha second', 'Beta third', 'Later task']);\\n    await server.stop();\\n    server = undefined;\\n    server = await start(dbPath);\\n    assert.equal(await html('/projects/1'), finalPage);\\n    assert.deepEqual(await summaries(), ['1/4 completed', '0/0 completed']);\\n  } finally {\\n    if (server) await server.stop();\\n    await rm(directory, { recursive: true, force: true });\\n  }\\n});\\nEOF\\npython3 - <<'PY'\\nfrom pathlib import Path\\np=Path('test/server.test.js')\\ns=p.read_text().replace('summaries && await summaries()', 'await summaries()')\\np.write_text(s)\\np=Path('README.md')\\ns=p.read_text().replace('filter tasks by All, Open, or Completed.', 'filter live tasks by All, Open, or Completed, or view deleted tasks with Deleted.').replace('row summarizes completed tasks out of all its tasks.', 'row summarizes completed live tasks out of all its live tasks.')\\ns += '''\\\\nUse Delete task to remove a live task from live filters and completion summaries.\\\\nThe Deleted filter shows deleted tasks within the same priority, due-range, and\\\\ntitle-search filters. Deleted tasks retain all fields and remembered project\\\\npositions, but editing and moving are disabled. Restore task returns a task to\\\\nits reserved position with its saved completion, priority, date, and notes.\\\\nDeletion and restoration retain the current filters and search. Archived projects\\\\nallow reading deleted tasks but disable deletion and task restoration. Existing\\\\ndatabases initialize every earlier task as live; deletion state persists across\\\\nrestarts. Integration checks cover migration, filter intersections, summaries,\\\\nread-only controls and write protection, archive/restart persistence, restoration\\\\norder, and movement after restoration.\\\\n'''\\np.write_text(s)\\nPY\\nnpm test\",\"yield_time_ms\":1000,\"max_output_tokens\":2000}));\n","status":"completed"}],"error":null,"incomplete_details":null,"tools":[{"type":"namespace","name":"functions","description":"","tools":[{"type":"function","strict":false,"name":"wait","description":"Waits on a yielded `exec` cell and returns new output or completion.\n- Use `wait` only after `exec` returns `Script running with cell ID ...`.\n- `cell_id` identifies the running `exec` cell to resume.\n- `yield_time_ms` controls how long to wait for more output before yielding again. Defaults to 10000 ms.\n- `max_tokens` limits how much new output this wait call returns. Defaults to 10000 tokens.\n- `terminate: true` stops the running cell; false or omitted waits for output.\n- `wait` returns only the new output since the last yield, or the final completion or termination result for that cell.\n- If the cell is still running, `wait` may yield again with the same `cell_id`.\n- If the cell has already finished, `wait` returns the completed result and closes the cell.","output_schema":null,"parameters":{"type":"object","properties":{"cell_id":{"type":"string","description":"Identifier of the running exec cell."},"max_tokens":{"type":"number","description":"Output token budget for this wait call. Defaults to 10000 tokens."},"terminate":{"type":"boolean","description":"True stops the running exec cell; false or omitted waits for output."},"yield_time_ms":{"type":"number","description":"Wait before yielding more output. Defaults to 10000 ms."}},"required":["cell_id"],"additionalProperties":false}},{"type":"function","strict":false,"name":"request_user_input","description":"Request user input for one to three short questions and wait for the response. This tool is only available in Plan mode.","output_schema":null,"parameters":{"type":"object","properties":{"questions":{"type":"array","description":"Questions to show the user. Prefer 1 and do not exceed 3","items":{"type":"object","properties":{"header":{"type":"string","description":"Short header label shown in the UI (12 or fewer chars)."},"id":{"type":"string","description":"Stable identifier for mapping answers (snake_case)."},"options":{"type":"array","description":"Provide 2-3 mutually exclusive choices. Put the recommended option first and suffix its label with \"(Recommended)\". Do not include an \"Other\" option in this list; the client will add a free-form \"Other\" option automatically.","items":{"type":"object","properties":{"description":{"type":"string","description":"One short sentence explaining impact/tradeoff if selected."},"label":{"type":"string","description":"User-facing label (1-5 words)."}},"required":["label","description"],"additionalProperties":false}},"question":{"type":"string","description":"Single-sentence prompt shown to the user."}},"required":["id","header","question","options"],"additionalProperties":false}}},"required":["questions"],"additionalProperties":false}},{"type":"function","strict":false,"name":"request_user_input_async","description":"Ask the user one or more questions during ongoing work. Use this tool only to request missing information, preferences, constraints, clarification, or approval. The tool returns immediately without ending the turn or waiting for a reply; any reply arrives asynchronously as a new user message. Keep questions concise, self-contained, and easy to understand, using a level of detail appropriate to the user and task. The UI always allows a free-text answer, including when suggested options are provided. A preselected option is not submitted automatically.","output_schema":null,"parameters":{"type":"object","properties":{"questions":{"type":"array","description":"One or more self-contained questions to present together, in display order.","items":{"type":"object","properties":{"options":{"type":"array","description":"Suggested answers, in display order. Put the recommended answer first; the first option is preselected by default. The user can select one option or enter a free-text answer. Do not include an Other option or a free-text placeholder; the UI provides free-text input automatically. Omit options for a free-text-only question.","items":{"type":"string"},"minItems":1},"title":{"type":"string","description":"The complete question shown to the user, including any context needed to answer it."}},"required":["title"],"additionalProperties":false},"minItems":1}},"required":["questions"],"additionalProperties":false}},{"type":"custom","name":"exec","description":"Run JavaScript code to orchestrate/compose tool calls\n- Evaluates the provided JavaScript code in a fresh V8 isolate as an async module.\n- All nested tools are available on the global `tools` object, for example `await tools.exec_command(...)`. Tool names are exposed as normalized JavaScript identifiers, for example `await tools.mcp__ologs__get_profile(...)`.\n- Nested tool methods take either a string or an object as their input argument.\n- Nested tools return either an object or a string, based on the description.\n- Runs raw JavaScript -- no Node, no file system, no network access, no console.\n- Accepts raw JavaScript source text, not JSON, quoted strings, or markdown code fences.\n- You may optionally start the tool input with a first-line pragma like `// @exec: {\"yield_time_ms\": 10000, \"max_output_tokens\": 1000}`.\n- `yield_time_ms` asks `exec` to yield early if the script is still running. Defaults to 30000 ms.\n- `max_output_tokens` sets the token budget for direct `exec` results. Defaults to 10000 tokens.\n- When the JS code is fully evaluated, the isolate's lifetime ends and unawaited promises are silently discarded.\n\n- Global helpers:\n- `exit()`: Immediately ends the current script successfully (like an early return from the top level).\n- `text(value: string | number | boolean | undefined | null)`: Appends a text item. Non-string values are stringified with `JSON.stringify(...)` when possible.\n- `image(imageUrlOrItem: string | { image_url: string; detail?: \"auto\" | \"low\" | \"high\" | \"original\" | null } | ImageContent, detail?: \"auto\" | \"low\" | \"high\" | \"original\" | null)`: Appends an image item. `image_url` should be a base64-encoded `data:` URL. To forward an MCP tool image, pass an individual `ImageContent` block from `result.content`, for example `image(result.content[0])`. MCP image blocks may request detail with `_meta: { \"codex/imageDetail\": \"original\" }`. When provided, the second `detail` argument overrides any detail embedded in the first argument.\n- `audio(audioUrlOrItem: string | { audio_url: string } | AudioContent)`: Appends an audio item. `audio_url` should be a base64-encoded `data:` URL. To forward an MCP tool audio block, pass an individual `AudioContent` block from `result.content`, for example `audio(result.content[0])`.\n- `generatedImage(result: { image_url: string; output_hint?: string })`: Appends an image-generation result and its optional output hint. HTTP(S) URLs are not supported.\n- `store(key: string, value: any)`: stores a serializable value under a string key for later `exec` calls in the same session.\n- `load(key: string)`: returns the stored value for a string key, or `undefined` if it is missing.\n- `notify(value: string | number | boolean | undefined | null)`: immediately injects an extra `custom_tool_call_output` for the current `exec` call. Values are stringified like `text(...)`.\n- `setTimeout(callback: () => void, delayMs?: number)`: schedules a callback to run later and returns a timeout id. Pending timeouts do not keep `exec` alive by themselves; await an explicit promise if you need to wait for one.\n- `clearTimeout(timeoutId?: number)`: cancels a timeout created by `setTimeout`.\n- `ALL_TOOLS`: metadata for the enabled nested tools as `{ name, description }` entries.\n- `yield_control()`: yields the accumulated output to the model immediately while the script keeps running.\n\nSome deferred nested tools may be omitted from this description. They are still available on the global `tools` object and listed in `ALL_TOOLS`.\nTo find one, filter `ALL_TOOLS` by `name` and `description`.\n\nTool availability can change between calls.\n\nShared MCP Types:\n```ts\ntype Role = \"user\" | \"assistant\";\ntype MetaObject = Record<string, unknown>;\ntype Annotations = {\n  audience?: Role[];\n  priority?: number;\n  lastModified?: string;\n};\ntype Icon = {\n  src: string;\n  mimeType?: string;\n  sizes?: string[];\n  theme?: \"light\" | \"dark\";\n};\ntype TextResourceContents = {\n  uri: string;\n  mimeType?: string;\n  _meta?: MetaObject;\n  text: string;\n};\ntype BlobResourceContents = {\n  uri: string;\n  mimeType?: string;\n  _meta?: MetaObject;\n  blob: string;\n};\ntype TextContent = {\n  type: \"text\";\n  text: string;\n  annotations?: Annotations;\n  _meta?: MetaObject;\n};\ntype ImageContent = {\n  type: \"image\";\n  data: string;\n  mimeType: string;\n  annotations?: Annotations;\n  _meta?: MetaObject;\n};\ntype AudioContent = {\n  type: \"audio\";\n  data: string;\n  mimeType: string;\n  annotations?: Annotations;\n  _meta?: MetaObject;\n};\ntype ResourceLink = {\n  icons?: Icon[];\n  name: string;\n  title?: string;\n  uri: string;\n  description?: string;\n  mimeType?: string;\n  annotations?: Annotations;\n  size?: number;\n  _meta?: MetaObject;\n  type: \"resource_link\";\n};\ntype EmbeddedResource = {\n  type: \"resource\";\n  resource: TextResourceContents | BlobResourceContents;\n  annotations?: Annotations;\n  _meta?: MetaObject;\n};\ntype ContentBlock =\n  | TextContent\n  | ImageContent\n  | AudioContent\n  | ResourceLink\n  | EmbeddedResource;\ntype CallToolResult<TStructured = { [key: string]: unknown }> = {\n  _meta?: MetaObject;\n  content: ContentBlock[];\n  isError?: boolean;\n  structuredContent?: TStructured;\n  [key: string]: unknown;\n};\n```\n\n### `apply_patch`\nThe `apply_patch` tool can be used to edit files. This is a FREEFORM tool, so do not wrap the patch in JSON.\n\nexec tool declaration:\n```ts\ndeclare const tools: { apply_patch(input: string): Promise<unknown>; };\n```\n\n### `create_goal`\nCreate a goal only when explicitly requested by the user or system/developer instructions; do not infer goals from ordinary tasks.\nSet token_budget only when an explicit token budget is requested. Fails if an unfinished goal exists; use update_goal only for status.\n\nexec tool declaration:\n```ts\ndeclare const tools: { create_goal(args: {\n  // Required. The concrete objective to start pursuing. This starts a new active goal when no goal exists or replaces the current goal when it is complete.\n  objective: string;\n  // Positive token budget for the new goal. Omit unless explicitly requested.\n  token_budget?: number;\n}): Promise<unknown>; };\n```\n\n### `exec_command`\nRuns a command in a PTY, returning output or a session ID for ongoing interaction.\n\nexec tool declaration:\n```ts\ndeclare const tools: { exec_command(args: {\n  // Shell command to execute.\n  cmd: string;\n  // User-facing approval question for `require_escalated`; omit otherwise.\n  justification?: string;\n  // True runs the shell with -l/-i semantics; false disables them. Defaults to true.\n  login?: boolean;\n  // Output token budget. Defaults to 10000 tokens; larger requests may be capped by policy.\n  max_output_tokens?: number;\n  // Reusable approval prefix for `cmd`, only with `sandbox_permissions: \"require_escalated\"`; for example [\"git\", \"pull\"].\n  prefix_rule?: Array<string>;\n  // Per-command sandbox override. Defaults to `use_default`; use `require_escalated` for unsandboxed execution.\n  sandbox_permissions?: \"use_default\" | \"require_escalated\";\n  // Shell binary to launch. Defaults to the user's default shell.\n  shell?: string;\n  // True allocates a PTY for the command; false or omitted uses plain pipes.\n  tty?: boolean;\n  // Working directory for the command. Defaults to the turn cwd.\n  workdir?: string;\n  // Wait before yielding output. Defaults to 10000 ms; effective range is 250-30000 ms.\n  yield_time_ms?: number;\n}): Promise<{\n  // Chunk identifier included when the response reports one.\n  chunk_id?: string;\n  // Process exit code when the command finished during this call.\n  exit_code?: number;\n  // Approximate token count before output truncation.\n  original_token_count?: number;\n  // Command output text, possibly truncated.\n  output: string;\n  // Session identifier to pass to write_stdin when the process is still running.\n  session_id?: number;\n  // Elapsed wall time spent waiting for output in seconds.\n  wall_time_seconds: number;\n}>; };\n```\n\n### `get_goal`\nGet the current goal for this thread, including status, budgets, token and elapsed-time usage, and remaining token budget.\n\nexec tool declaration:\n```ts\ndeclare const tools: { get_goal(args: {}): Promise<unknown>; };\n```\n\n### `list_mcp_resource_templates`\nLists resource templates provided by MCP servers. Parameterized resource templates allow servers to share data that takes parameters and provides context to language models, such as files, database schemas, or application-specific information. Prefer resource templates over web search when possible.\n\nexec tool declaration:\n```ts\ndeclare const tools: { list_mcp_resource_templates(args: {\n  // Opaque cursor from a previous list_mcp_resource_templates call; omit for the first page.\n  cursor?: string;\n  // MCP server name. Omit to list resource templates from every configured server.\n  server?: string;\n}): Promise<unknown>; };\n```\n\n### `list_mcp_resources`\nLists resources provided by MCP servers. Resources allow servers to share data that provides context to language models, such as files, database schemas, or application-specific information. Prefer resources over web search when possible.\n\nexec tool declaration:\n```ts\ndeclare const tools: { list_mcp_resources(args: {\n  // Opaque cursor from a previous list_mcp_resources call; omit for the first page.\n  cursor?: string;\n  // MCP server name. Omit to list resources from every configured server.\n  server?: string;\n}): Promise<unknown>; };\n```\n\n### `read_mcp_resource`\nRead a specific resource from an MCP server given the server name and resource URI.\n\nexec tool declaration:\n```ts\ndeclare const tools: { read_mcp_resource(args: {\n  // MCP server name exactly as configured. Must match the 'server' field returned by list_mcp_resources.\n  server: string;\n  // Resource URI to read. Must be one of the URIs returned by list_mcp_resources.\n  uri: string;\n}): Promise<unknown>; };\n```\n\n### `update_goal`\nUpdate the existing goal.\nSet status to `paused` only at the user's explicit request to pause this goal, never on your own initiative. Ask if unclear; a later resume revokes that request. Report the returned status and stop goal work. Budget limits take precedence over pausing.\nSet status to `complete` only when the objective has actually been achieved and no required work remains.\nSet status to `blocked` only when the same blocking condition has repeated for at least three consecutive goal turns, counting the original/user-triggered turn and any automatic continuations, and the agent cannot make meaningful progress without user input or an external-state change.\nIf the user resumes a goal that was previously marked `blocked`, treat the resumed run as a fresh blocked audit. If the same blocking condition then repeats for at least three consecutive resumed goal turns, set status to `blocked` again.\nOnce the blocked threshold is satisfied, do not keep reporting that you are still blocked while leaving the goal active; set status to `blocked`.\nDo not use `blocked` merely because the work is hard, slow, uncertain, incomplete, or would benefit from clarification.\nDo not mark a goal complete merely because its budget is nearly exhausted or because you are stopping work.\nYou cannot use this tool to resume, budget-limit, or usage-limit a goal; those status changes are controlled by the user or system.\nWhen marking a budgeted goal achieved with status `complete`, report the final token usage from the tool result to the user.\n\nexec tool declaration:\n```ts\ndeclare const tools: { update_goal(args: {\n  // Required. `paused` requires an explicit user request. Set to `complete` only when the objective is achieved and no required work remains. Set to `blocked` only after the same blocking condition has recurred for at least three consecutive goal turns and the agent is at an impasse. After a previously blocked goal is resumed, the resumed run starts a fresh blocked audit.\n  status: \"complete\" | \"blocked\" | \"paused\";\n}): Promise<unknown>; };\n```\n\n### `view_image`\nView a local image file from the filesystem when visual inspection is needed. Use this for images already available on disk.\n\nexec tool declaration:\n```ts\ndeclare const tools: { view_image(args: {\n  // Image detail level. Defaults to `high`; use `original` to preserve exact resolution.\n  detail?: \"high\" | \"original\";\n  // Local filesystem path to an image file.\n  path: string;\n}): Promise<{\n  // Image detail hint returned by view_image. Returns `high` for default resized behavior or `original` when original resolution is preserved.\n  detail: \"high\" | \"original\";\n  // Data URL for the loaded image.\n  image_url: string;\n}>; };\n```\n\n### `write_stdin`\nWrites characters to an existing unified exec session and returns recent output.\n\nexec tool declaration:\n```ts\ndeclare const tools: { write_stdin(args: {\n  // Bytes to write to stdin. Defaults to empty, which polls without writing.\n  chars?: string;\n  // Output token budget. Defaults to 10000 tokens; larger requests may be capped by policy.\n  max_output_tokens?: number;\n  // Identifier of the running unified exec session.\n  session_id: number;\n  // Wait before yielding output. Non-empty writes default to 250 ms and cap at 30000 ms; empty polls wait 5000-300000 ms by default.\n  yield_time_ms?: number;\n}): Promise<{\n  // Chunk identifier included when the response reports one.\n  chunk_id?: string;\n  // Process exit code when the command finished during this call.\n  exit_code?: number;\n  // Approximate token count before output truncation.\n  original_token_count?: number;\n  // Command output text, possibly truncated.\n  output: string;\n  // Session identifier to pass to write_stdin when the process is still running.\n  session_id?: number;\n  // Elapsed wall time spent waiting for output in seconds.\n  wall_time_seconds: number;\n}>; };\n```\n\n## clock\nTools for reading and waiting on time.\n\n### `clock__curr_time`\nReturn the current time in UTC.\n\nexec tool declaration:\n```ts\ndeclare const tools: { clock__curr_time(args: {}): Promise<{\n  // Current UTC time formatted as YYYY-MM-DD HH:MM:SS UTC.\n  current_time: string;\n}>; };\n```","format":{"type":"grammar","syntax":"lark","definition":"\nstart: pragma_source | plain_source\npragma_source: PRAGMA_LINE NEWLINE SOURCE\nplain_source: SOURCE\n\nPRAGMA_LINE: /[ \\t]*\\/\\/ @exec:[^\\r\\n]*/\nNEWLINE: /\\r?\\n/\nSOURCE: /[\\s\\S]+/\n"}}]},{"type":"namespace","name":"clock","description":"Tools for reading and waiting on time.","tools":[{"type":"function","strict":false,"name":"sleep","description":"Pause execution for a specified duration. The sleep ends early when new input arrives for the active turn. Returns the elapsed wall-clock time.","output_schema":null,"parameters":{"type":"object","properties":{"duration_ms":{"type":"number","description":"How long to sleep in milliseconds. Must be between 1 and 43200000."}},"required":["duration_ms"],"additionalProperties":false}}]},{"type":"namespace","name":"collaboration","description":"Tools for spawning and managing sub-agents.","tools":[{"type":"function","strict":false,"name":"followup_task","description":"Send a follow-up task to an existing non-root target agent and trigger a turn if it is idle. If the target is already running, deliver the task promptly at message boundaries while sampling, or after the pending tool call completes.","output_schema":null,"parameters":{"type":"object","properties":{"message":{"type":"string","description":"Message text to send to the target agent.","encrypted":true},"target":{"type":"string","description":"Agent id or canonical task name to send a follow-up task to (from spawn_agent)."}},"required":["target","message"],"additionalProperties":false}},{"type":"function","strict":false,"name":"interrupt_agent","description":"Interrupt an agent's current turn, if any, and return its previous status. The agent remains available for messages and follow-up tasks.","output_schema":null,"parameters":{"type":"object","properties":{"target":{"type":"string","description":"Agent id or canonical task name to interrupt (from spawn_agent)."}},"required":["target"],"additionalProperties":false}},{"type":"function","strict":false,"name":"list_agents","description":"List live agents in the current root thread tree. Optionally filter by task-path prefix.","output_schema":null,"parameters":{"type":"object","properties":{"path_prefix":{"type":"string","description":"Task-path prefix filter without a trailing slash. Omit to list all live agents."}},"additionalProperties":false}},{"type":"function","strict":false,"name":"send_message","description":"Send a message to an existing agent. The message will be delivered promptly. Does not trigger a new turn.","output_schema":null,"parameters":{"type":"object","properties":{"message":{"type":"string","description":"Message text to queue on the target agent.","encrypted":true},"target":{"type":"string","description":"Relative or canonical task name to message (from spawn_agent)."}},"required":["target","message"],"additionalProperties":false}},{"type":"function","strict":false,"name":"spawn_agent","description":"\n        Available model overrides (optional; inherited parent model is preferred):\n- `gpt-6.1-sol`: Latest workhorse model for coding and everyday work. Reasoning efforts: low (default), medium, high, xhigh, max, ultra. Service tiers: priority.\n- `gpt-6-astra`: Frontier intelligence for the most demanding work. Reasoning efforts: low (default), medium, high, xhigh, max, ultra. Service tiers: priority.\n- `gpt-6-sol`: Previous generation workhorse model. Reasoning efforts: low, medium (default), high, xhigh, max, ultra. Service tiers: priority.\n- `gpt-6-luna`: Fast and affordable model for easier tasks. Reasoning efforts: low, medium (default), high, xhigh, max. Service tiers: priority.\n- `gpt-5.6-sol`: Older generation workhorse model. Reasoning efforts: low (default), medium, high, xhigh, max, ultra. Service tiers: priority.\n        Spawns an agent to work on the specified task. If your current task is `/root/task1` and you spawn_agent with task_name \"task_3\" the agent will have canonical task name `/root/task1/task_3`.\nYou are then able to refer to this agent as `task_3` or `/root/task1/task_3` interchangeably. However an agent `/root/task2/task_3` would only be able to communicate with this agent via its canonical name `/root/task1/task_3`.\nThe spawned agent will have the same tools as you and the ability to spawn its own subagents.\n\nIt will be able to send you and other running agents messages, and its final answer will be provided to you when it finishes.\nThe new agent's canonical task name will be provided to it along with the message.\n\nNote that passing `fork_turns=\"none\"` will not pass any surrounding context to the spawned subagent, which may cause the agent to lack the context it needs to complete its task, whereas `fork_turns=\"all\"` will provide the subagent with all surrounding context.","output_schema":null,"parameters":{"type":"object","properties":{"fork_turns":{"type":"string","description":"Parent history to inherit. Defaults to `all`; use `none` to start without parent history. Only `all` and `none` are supported."},"message":{"type":"string","description":"Initial plain-text task for the new agent.","encrypted":true},"model":{"type":"string","description":"Model override for the new agent. Omit unless an explicit override is needed."},"reasoning_effort":{"type":"string","description":"Reasoning effort override for the new agent. Omit to inherit the parent effort."},"task_name":{"type":"string","description":"Task name for the new agent. Use lowercase letters, digits, and underscores."}},"required":["task_name","message"],"additionalProperties":false}},{"type":"function","strict":false,"name":"wait_agent","description":"Wait for a mailbox update from any live agent, including queued messages and final-status notifications. The wait also ends early when new user input is steered into the active turn. Does not return the content; returns either a summary of which agents have updates (if any), an interruption summary for steered input, or a timeout summary if no activity arrives before the deadline.","output_schema":null,"parameters":{"type":"object","properties":{"timeout_ms":{"type":"number","description":"Timeout in milliseconds. Defaults to 30000, min 10000, max 3600000."}},"additionalProperties":false}}]}],"tool_choice":"auto","parallel_tool_calls":false,"prompt_cache_key":"37312bb5-80ad-4eaa-82e5-f4e11b72fcbe","prompt_cache_retention":"24h","text":{"format":{"type":"text"},"verbosity":"low"},"top_p":0.98,"top_logprobs":0,"temperature":1.0,"reasoning":{"effort":"medium","context":"all_turns","summary":null,"mode":"standard"},"user":null,"usage":{"input_tokens":34259,"input_tokens_details":{"cached_tokens":9088,"cache_write_tokens":0},"output_tokens":2933,"output_tokens_details":{"reasoning_tokens":66},"total_tokens":37192,"attribution":{"items":{"at_e03aee33-74b5-5bbc-ac0f-30889407e620":{"input_tokens":5096,"cached_tokens":5096,"cache_write_tokens":0,"output_tokens":0},"ctc_0b534dcad4dc6e2a016acb1900c6a88195a07f532ae1ea927d":{"input_tokens":60,"cached_tokens":0,"cache_write_tokens":0,"output_tokens":0},"ctc_0b534dcad4dc6e2a016acb1903e5dc8195b013d03a58a2394e":{"input_tokens":51,"cached_tokens":0,"cache_write_tokens":0,"output_tokens":0},"ctc_0b534dcad4dc6e2a016acb190637e081959acf7627df325cb4":{"input_tokens":61,"cached_tokens":0,"cache_write_tokens":0,"output_tokens":0},"ctc_0b534dcad4dc6e2a016acb1909983481959c0062fb499e2d17":{"input_tokens":86,"cached_tokens":0,"cache_write_tokens":0,"output_tokens":0},"ctc_0b534dcad4dc6e2a016acb190d105881958a044609ad647332":{"input_tokens":1226,"cached_tokens":0,"cache_write_tokens":0,"output_tokens":0},"ctc_0b534dcad4dc6e2a016acb192258048195a417358493a56742":{"input_tokens":91,"cached_tokens":0,"cache_write_tokens":0,"output_tokens":0},"ctc_0b534dcad4dc6e2a016acb192909648195a0e79ac929d10b2e":{"input_tokens":0,"cached_tokens":0,"cache_write_tokens":0,"output_tokens":2867},"ctco_01a12959-af17-7590-9184-a3b15a36d1bf":{"input_tokens":75,"cached_tokens":0,"cache_write_tokens":0,"output_tokens":0,"content":[{"input_tokens":20,"cached_tokens":0,"cache_write_tokens":0,"output_tokens":0},{"input_tokens":55,"cached_tokens":0,"cache_write_tokens":0,"output_tokens":0}]},"ctco_01a12959-ba7d-7610-91dd-00de52ff73e2":{"input_tokens":10625,"cached_tokens":0,"cache_write_tokens":0,"output_tokens":0,"content":[{"input_tokens":20,"cached_tokens":0,"cache_write_tokens":0,"output_tokens":0},{"input_tokens":10605,"cached_tokens":0,"cache_write_tokens":0,"output_tokens":0}]},"ctco_01a12959-c386-7c83-b3aa-198589c5e905":{"input_tokens":4488,"cached_tokens":0,"cache_write_tokens":0,"output_tokens":0,"content":[{"input_tokens":20,"cached_tokens":0,"cache_write_tokens":0,"output_tokens":0},{"input_tokens":4468,"cached_tokens":0,"cache_write_tokens":0,"output_tokens":0}]},"ctco_01a12959-d32e-7183-a26a-bc1aabb738c0":{"input_tokens":565,"cached_tokens":0,"cache_write_tokens":0,"output_tokens":0,"content":[{"input_tokens":20,"cached_tokens":0,"cache_write_tokens":0,"output_tokens":0},{"input_tokens":509,"cached_tokens":0,"cache_write_tokens":0,"output_tokens":0},{"input_tokens":36,"cached_tokens":0,"cache_write_tokens":0,"output_tokens":0}]},"ctco_01a1295a-1c16-7193-87a1-2387c00a04b8":{"input_tokens":56,"cached_tokens":0,"cache_write_tokens":0,"output_tokens":0,"content":[{"input_tokens":20,"cached_tokens":0,"cache_write_tokens":0,"output_tokens":0},{"input_tokens":1,"cached_tokens":0,"cache_write_tokens":0,"output_tokens":0},{"input_tokens":35,"cached_tokens":0,"cache_write_tokens":0,"output_tokens":0}]},"ctco_01a1295a-38b7-72b3-862a-78146b8a453b":{"input_tokens":1756,"cached_tokens":0,"cache_write_tokens":0,"output_tokens":0,"content":[{"input_tokens":20,"cached_tokens":0,"cache_write_tokens":0,"output_tokens":0},{"input_tokens":1505,"cached_tokens":0,"cache_write_tokens":0,"output_tokens":0},{"input_tokens":231,"cached_tokens":0,"cache_write_tokens":0,"output_tokens":0}]},"msg_01a12959-a065-78a1-b8eb-6c64236f6c0f":{"input_tokens":749,"cached_tokens":0,"cache_write_tokens":0,"output_tokens":0,"content":[{"input_tokens":27,"cached_tokens":0,"cache_write_tokens":0,"output_tokens":0},{"input_tokens":476,"cached_tokens":0,"cache_write_tokens":0,"output_tokens":0},{"input_tokens":67,"cached_tokens":0,"cache_write_tokens":0,"output_tokens":0},{"input_tokens":179,"cached_tokens":0,"cache_write_tokens":0,"output_tokens":0}]},"msg_01a12959-a065-78a1-b8eb-6c7d32eb4d2a":{"input_tokens":534,"cached_tokens":0,"cache_write_tokens":0,"output_tokens":0,"content":[{"input_tokens":534,"cached_tokens":0,"cache_write_tokens":0,"output_tokens":0}]},"msg_01a12959-a065-78a1-b8eb-6c8dfa26b087":{"input_tokens":56,"cached_tokens":0,"cache_write_tokens":0,"output_tokens":0,"content":[{"input_tokens":56,"cached_tokens":0,"cache_write_tokens":0,"output_tokens":0}]},"msg_01a12959-a065-78a1-b8eb-6c9ca6491828":{"input_tokens":97,"cached_tokens":0,"cache_write_tokens":0,"output_tokens":0,"content":[{"input_tokens":97,"cached_tokens":0,"cache_write_tokens":0,"output_tokens":0}]},"msg_01a12959-a066-73b0-9d63-added1b68d9b":{"input_tokens":4197,"cached_tokens":0,"cache_write_tokens":0,"output_tokens":0,"content":[{"input_tokens":4197,"cached_tokens":0,"cache_write_tokens":0,"output_tokens":0}]},"msg_0b534dcad4dc6e2a016acb18ffd6208195bcce2fb1bf91b355":{"input_tokens":31,"cached_tokens":0,"cache_write_tokens":0,"output_tokens":0,"content":[{"input_tokens":31,"cached_tokens":0,"cache_write_tokens":0,"output_tokens":0}]},"msg_0b534dcad4dc6e2a016acb1920e7ec8195b9c1e35df3d6a558":{"input_tokens":52,"cached_tokens":0,"cache_write_tokens":0,"output_tokens":0,"content":[{"input_tokens":52,"cached_tokens":0,"cache_write_tokens":0,"output_tokens":0}]},"msg_4cf7fa89-3bcd-5c55-b4d4-e8ac6b6dd9e7":{"input_tokens":4216,"cached_tokens":3992,"cache_write_tokens":0,"output_tokens":0,"content":[{"input_tokens":4216,"cached_tokens":3992,"cache_write_tokens":0,"output_tokens":0}]},"rs_0b534dcad4dc6e2a016acb1908b2608195a962226449daf494":{"input_tokens":30,"cached_tokens":0,"cache_write_tokens":0,"output_tokens":0},"rs_0b534dcad4dc6e2a016acb1920ca388195a9beb970249c483d":{"input_tokens":59,"cached_tokens":0,"cache_write_tokens":0,"output_tokens":0},"rs_0b534dcad4dc6e2a016acb1928d7dc819585e62c4da77a3424":{"input_tokens":2,"cached_tokens":0,"cache_write_tokens":0,"output_tokens":66}}}},"tool_usage":{"image_gen":{"input_tokens":0,"output_tokens":0,"total_tokens":0,"input_tokens_details":{"text_tokens":0,"image_tokens":0},"output_tokens_details":{"image_tokens":0,"text_tokens":0}},"web_search":{"num_requests":0}},"safety_identifier":"user-ZglLa0AK1sUTDt85g9NsGTX5","store":false,"metadata":{},"max_output_tokens":null,"max_tool_calls":null,"service_tier":"default","truncation":"disabled"}}
