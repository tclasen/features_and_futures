>Open project</button><button type=\\\"button\\\" data-action=\\\"archive\\\" data-project-id=\\\"${esc(project.id)}\\\">${archived ? 'Restore project' : 'Archive project'}</button></div>`).join('');\\n        list.querySelectorAll('button').forEach(button => button.addEventListener('click', async () => {\\n          const id = encodeURIComponent(button.dataset.projectId);\\n          if (button.dataset.action === 'open') { location.href = `/projects/${id}`; return; }\\n          try { await request(`/api/projects/${id}/archive`, { method: 'PATCH', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ archived: !archived }) }); await refresh(); }\\n          catch (error) { app.querySelector('#message').textContent = error.message; }\\n        }));\"},{\"oldText\":\"      app.querySelector('form').addEventListener('submit', async (event) => {\",\"newText\":\"      app.querySelector('#project-filter').addEventListener('change', refresh);\\n      app.querySelector('form').addEventListener('submit', async (event) => {\"}]}","status":"completed"}}

