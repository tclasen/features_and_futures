event: response.output_text.done
data: {"type":"response.output_text.done","sequence_number":77,"item_id":"msg_08221e5e56f739cd016aca3613dad887d192f9bd8f64d93115","output_index":1,"content_index":0,"text":"The filter predicates are present, but filter changes currently refetch tasks and rely on request timing to repaint the archived list. I’m changing this to keep the loaded task set for the current project and render from that cache whenever either filter changes. Mutations will still reload the saved task data, so filtering stays immediate and does not depend on network response order.","logprobs":[]}

