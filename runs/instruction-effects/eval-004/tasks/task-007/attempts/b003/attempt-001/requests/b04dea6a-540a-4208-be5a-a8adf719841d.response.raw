rmData(request);\\n      const filter = taskFilter(data.get('filter'));\\n      if (project.archived) {\\n        html(response, 403, projectPage(project, filter, 'Archived project is read-only'));\\n        return;\\n      }\\n      const name = (data.get('name') || '').trim();\",\"newText\":\"const data = await readForm();\\n      const filter = taskFilter(data.get('filter'));\\n      if (project.archived) {\\n        html(response, 403, detailPage(project, filter, 'Archived project is read-only'));\\n        return;\\n      }\\n      const name = (data.get('name') || '').trim();\"},{\"oldText\":\"projectPage(project, filter, 'Project name is required')\",\"newText\":\"detailPage(project, filter, 'Project name is required')\"},{\"oldText\":\"renameProject.run(name, id);\\n      response.writeHead(303, { Location: `/projects/${id}?filter=${filter}` });\",\"newText\":\"renameProject.run(name, id);\\n      response.writeHead(303, { Location: detailLocation(id, filter) });\"},{\"oldText\":\"const data = await formData(request);\\n      const filter = taskFilter(data.get('filter'));\\n      if (project.archived) {\\n        html(response, 403, projectPage(project, filter, 'Archived project is read-only'));\\n        return;\\n      }\\n      const priority = data.get('priority');\",\"newText\":\"const data = await readForm();\\n      const filter = taskFilter(data.get('filter'));\\n      if (project.archived) {\\n        html(response, 403, detailPage(project, filter, 'Archived project is read-only'));\\n        return;\\n      }\\n      const priority = data.get('priority');\"},{\"oldText\":\"projectPage(project, filter, 'Invalid task priority')\",\"newText\":\"detailPage(project, filter, 'Invalid task priority')\"},{\"oldText\":\"setTaskPriority.run(priority, task, id);\\n      response.writeHead(303, { Location: `/projects/${id}?filter=${filter}` });\",\"newText\":\"setTaskPriority.run(priority, task, id);\\n      response.writeHead(303, { Location: detailLocation(i