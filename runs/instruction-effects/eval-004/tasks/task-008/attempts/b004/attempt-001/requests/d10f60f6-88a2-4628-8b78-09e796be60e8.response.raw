data: {"type":"response.function_call_arguments.done","sequence_number":672,"item_id":"fc_0b7386258c4009cc016aca3685ce7c8194861f344d6a03d16a","output_index":0,"arguments":"{\"path\":\"server.js\",\"edits\":[{\"oldText\":\"if (!db.prepare('PRAGMA table_info(tasks)').all().some(column => column.name === 'priority')) db.exec(\\\"ALTER TABLE tasks ADD COLUMN priority TEXT NOT NULL DEFAULT 'Normal'\\\");\",\"newText\":\"if (!db.prepare('PRAGMA table_info(tasks)').all().some(column => column.name === 'priority')) db.exec(\\\"ALTER TABLE tasks ADD COLUMN priority TEXT NOT NULL DEFAULT 'Normal'\\\");\\nif (!db.prepare('PRAGMA table_info(projects)').all().some(column => column.name === 'default_priority')) db.exec(\\\"ALTER TABLE projects ADD COLUMN default_priority TEXT NOT NULL DEFAULT 'Normal'\\\");\"},{\"oldText\":\"SELECT p.id, p.name, p.archived, COUNT(t.id)\",\"newText\":\"SELECT p.id, p.name, p.archived, p.default_priority, COUNT(t.id)\"},{\"oldText\":\"SELECT id, name, archived FROM projects WHERE id = ?\",\"newText\":\"SELECT id, name, archived, default_priority FROM projects WHERE id = ?\"},{\"oldText\":\"const renameProject = db.prepare('UPDATE projects SET name = ? WHERE id = ?');\",\"newText\":\"const renameProject = db.prepare('UPDATE projects SET name = ? WHERE id = ?');\\nconst updateDefaultPriority = db.prepare('UPDATE projects SET default_priority = ? WHERE id = ?');\"},{\"oldText\":\"const insertTask = db.prepare('INSERT INTO tasks (id, project_id, title, completed, created_at) VALUES (?, ?, ?, 0, ?)');\",\"newText\":\"const insertTask = db.prepare('INSERT INTO tasks (id, project_id, title, completed, created_at, priority) VALUES (?, ?, ?, 0, ?, ?)');\"},{\"oldText\":\"  const priorityMatch = url.pathname.match\",\"newText\":\"  const defaultPriorityMatch = url.pathname.match(/^\\\\\\\\/api\\\\\\\\/projects\\\\\\\\/([^/]+)\\\\\\\\/default-priority$/);\\n  if (req.method === 'PATCH' && defaultPriorityMatch) {\\n    let data = '';\\n    for await (const chunk of req) data += chunk;\\n    let input;\\n    try { input = JSON.parse(data); } catch { return send(400, JSON.stringify({ error: 'Invalid JSON' })); }\\n    const projectId = decodeURIComponent(defaultPriorityMatch[1]);\\n    const project = getProject.get(projectId);\\n    if (!project) return send(404, JSON.stringify({ error: 'Not found' }));\\n    if (project.archived) return send(403, JSON.stringify({ error: 'Archived project' }));\\n    if (!['Low', 'Normal', 'High'].includes(input.priority)) return send(400, JSON.stringify({ error: 'Invalid priority' }));\\n    updateDefaultPriority.run(input.priority, projectId);\\n    return send(200, JSON.stringify({ ok: true }));\\n  }\\n  const priorityMatch = url.pathname.match\"},{\"oldText\":\"insertTask.run(task.id, projectId, title, Date.now());\",\"newText\":\"insertTask.run(task.id, projectId, title, Date.now(), getProject.get(projectId).default_priority);\"}]}"}

