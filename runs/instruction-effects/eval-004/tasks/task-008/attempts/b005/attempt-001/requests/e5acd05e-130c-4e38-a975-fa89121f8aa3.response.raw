":0,"content":[{"input_tokens":142,"cached_tokens":0,"cache_write_tokens":0,"output_tokens":0}]},"fc_031a29681283a468016aca36ac2ccc8194a018a4fe947e10c4":{"input_tokens":2,"cached_tokens":0,"cache_write_tokens":0,"output_tokens":1704},"msg_031a29681283a468016aca36979f308194968ec2ce0a939e32":{"input_tokens":34,"cached_tokens":0,"cache_write_tokens":0,"output_tokens":0,"content":[{"input_tokens":34,"cached_tokens":0,"cache_write_tokens":0,"output_tokens":0}]},"msg_031a29681283a468016aca36aa7a308194b78dd29a51231a63":{"input_tokens":2041,"cached_tokens":1697,"cache_write_tokens":0,"output_tokens":0,"content":[{"input_tokens":2041,"cached_tokens":1697,"cache_write_tokens":0,"output_tokens":0}]}},"request_fields":{"instructions":{"input_tokens":882,"cached_tokens":882,"cache_write_tokens":0,"output_tokens":0},"tools":{"input_tokens":493,"cached_tokens":493,"cache_write_tokens":0,"output_tokens":0}}}},"tool_usage":{"image_gen":{"input_tokens":0,"output_tokens":0,"total_tokens":0,"input_tokens_details":{"text_tokens":0,"image_tokens":0},"output_tokens_details":{"image_tokens":0,"text_tokens":0}},"web_search":{"num_requests":0}},"safety_identifier":"user-ZglLa0AK1sUTDt85g9NsGTX5","store":false,"metadata":{},"max_output_tokens":null,"max_tool_calls":null,"service_tier":"default","truncation":"disabled"}}
