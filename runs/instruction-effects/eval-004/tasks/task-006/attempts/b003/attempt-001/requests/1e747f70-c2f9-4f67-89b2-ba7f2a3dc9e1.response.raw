data: {"type":"response.function_call_arguments.done","sequence_number":868,"item_id":"fc_0ce6f1c7d7dfa753016aca34a6b910819095c4694730cbb449","output_index":0,"arguments":"{\"path\":\"server.js\",\"edits\":[{\"oldText\":\"const listProjects = db.prepare(`SELECT p.id, p.name, p.archived,\",\"newText\":\"if (!db.prepare('PRAGMA table_info(tasks)').all().some(column => column.name === 'priority')) {\\n  db.exec(\\\"ALTER TABLE tasks ADD COLUMN priority TEXT NOT NULL DEFAULT 'Normal' CHECK (priority IN ('Low', 'Normal', 'High'))\\\");\\n}\\nconst listProjects = db.prepare(`SELECT p.id, p.name, p.archived,\"},{\"oldText\":\"const listTasks = db.prepare('SELECT id, title, completed FROM tasks WHERE project_id = ? ORDER BY id');\",\"newText\":\"const listTasks = db.prepare('SELECT id, title, completed, priority FROM tasks WHERE project_id = ? ORDER BY id');\"},{\"oldText\":\"const taskFilter = value =>\",\"newText\":\"const setTaskPriority = db.prepare('UPDATE tasks SET priority = ? WHERE id = ? AND project_id = ?');\\nconst priorities = ['Low', 'Normal', 'High'];\\nconst taskFilter = value =>\"},{\"oldText\":\"button:disabled, input:disabled {\",\"newText\":\"button:disabled, input:disabled, select:disabled {\"},{\"oldText\":\"          <button type=\\\"submit\\\"${project.archived ? ' disabled' : ''}>Rename task</button>\\n        </form>\",\"newText\":\"          <button type=\\\"submit\\\"${project.archived ? ' disabled' : ''}>Rename task</button>\\n        </form>\\n        <form method=\\\"post\\\" action=\\\"/projects/${project.id}/tasks/${task.id}/priority\\\">\\n          <input type=\\\"hidden\\\" name=\\\"filter\\\" value=\\\"${filter}\\\">\\n          <label for=\\\"task-priority-${task.id}\\\">Task priority</label>\\n          <select id=\\\"task-priority-${task.id}\\\" name=\\\"priority\\\"${project.archived ? ' disabled' : ''} onchange=\\\"this.form.requestSubmit()\\\">\\n            ${priorities.map(priority => `<option${priority === task.priority ? ' selected' : ''}>${priority}</option>`).join('')}\\n          </select>\\n        </form>\"},{\"oldText\":\"    } else if (request.method === 'POST' && /^\\\\/projects\\\\/\\\\d+\\\\/tasks\\\\/\\\\d+\\\\/rename$/.test(url.pathname)) {\",\"newText\":\"    } else if (request.method === 'POST' && /^\\\\/projects\\\\/\\\\d+\\\\/tasks\\\\/\\\\d+\\\\/priority$/.test(url.pathname)) {\\n      const [, , projectId, , taskId] = url.pathname.split('/');\\n      const id = Number(projectId);\\n      const task = Number(taskId);\\n      const project = Number.isSafeInteger(id) ? findProject.get(id) : undefined;\\n      if (!project) {\\n        html(response, 404, page('<h1>Project not found</h1>'));\\n        return;\\n      }\\n      if (!Number.isSafeInteger(task) || !findTask.get(task, id)) {\\n        html(response, 404, page('<h1>Task not found</h1>'));\\n        return;\\n      }\\n      const data = await formData(request);\\n      const filter = taskFilter(data.get('filter'));\\n      if (project.archived) {\\n        html(response, 403, projectPage(project, filter, 'Archived project is read-only'));\\n        return;\\n      }\\n      const priority = data.get('priority');\\n      if (!priorities.includes(priority)) {\\n        html(response, 400, projectPage(project, filter, 'Invalid task priority'));\\n        return;\\n      }\\n      setTaskPriority.run(priority, task, id);\\n      response.writeHead(303, { Location: `/projects/${id}?filter=${filter}` });\\n      response.end();\\n    } else if (request.method === 'POST' && /^\\\\/projects\\\\/\\\\d+\\\\/tasks\\\\/\\\\d+\\\\/rename$/.test(url.pathname)) {\"}]}"}

