data: {"type":"response.function_call_arguments.done","sequence_number":1036,"item_id":"fc_080301d6aedbff45016aca37b858b08197a273d65dea4b5d3c","output_index":1,"arguments":"{\"path\":\"server.js\",\"edits\":[{\"oldText\":\"const listProjects = db.prepare(`SELECT p.id, p.name, p.archived,\",\"newText\":\"if (!db.prepare('PRAGMA table_info(tasks)').all().some(column => column.name === 'due_date')) {\\n  db.exec(\\\"ALTER TABLE tasks ADD COLUMN due_date TEXT NOT NULL DEFAULT ''\\\");\\n}\\nconst listProjects = db.prepare(`SELECT p.id, p.name, p.archived,\"},{\"oldText\":\"SELECT id, title, completed, priority FROM tasks\",\"newText\":\"SELECT id, title, completed, priority, due_date FROM tasks\"},{\"oldText\":\"const priorities = ['Low', 'Normal', 'High'];\",\"newText\":\"const setTaskDueDate = db.prepare('UPDATE tasks SET due_date = ? WHERE id = ? AND project_id = ?');\\nfunction validDueDate(value) {\\n  if (!/^\\\\d{4}-\\\\d{2}-\\\\d{2}$/.test(value)) return false;\\n  const [year, month, day] = value.split('-').map(Number);\\n  if (year < 1 || month < 1 || month > 12 || day < 1) return false;\\n  const leap = year % 4 === 0 && (year % 100 !== 0 || year % 400 === 0);\\n  const days = [31, leap ? 29 : 28, 31, 30, 31, 30, 31, 31, 30, 31, 30, 31];\\n  return day <= days[month - 1];\\n}\\nconst priorities = ['Low', 'Normal', 'High'];\"},{\"oldText\":\"      </div>`).join('')}\\n    </section>`);\\n}\\n\\nasync function formData\",\"newText\":\"        <form method=\\\"post\\\" action=\\\"/projects/${project.id}/tasks/${task.id}/due-date\\\">\\n          <input type=\\\"hidden\\\" name=\\\"priorityFilter\\\" value=\\\"${selectedPriority}\\\">\\n          <input type=\\\"hidden\\\" name=\\\"filter\\\" value=\\\"${filter}\\\">\\n          <label for=\\\"task-due-date-${task.id}\\\">Task due date</label>\\n          <input id=\\\"task-due-date-${task.id}\\\" name=\\\"dueDate\\\" type=\\\"text\\\" value=\\\"${escapeHtml(task.due_date)}\\\"${project.archived ? ' disabled' : ''}>\\n          <button type=\\\"submit\\\"${project.archived ? ' disabled' : ''}>Save due date</button>\\n        </form>\\n      </div>`).join('')}\\n    </section>`);\\n}\\n\\nasync function formData\"},{\"oldText\":\"    } else if (request.method === 'POST' && /^\\\\/projects\\\\/\\\\d+\\\\/tasks\\\\/\\\\d+\\\\/priority$/.test(url.pathname)) {\",\"newText\":\"    } else if (request.method === 'POST' && /^\\\\/projects\\\\/\\\\d+\\\\/tasks\\\\/\\\\d+\\\\/due-date$/.test(url.pathname)) {\\n      const [, , projectId, , taskId] = url.pathname.split('/');\\n      const id = Number(projectId);\\n      const task = Number(taskId);\\n      const project = Number.isSafeInteger(id) ? findProject.get(id) : undefined;\\n      if (!project) {\\n        html(response, 404, page('<h1>Project not found</h1>'));\\n        return;\\n      }\\n      if (!Number.isSafeInteger(task) || !findTask.get(task, id)) {\\n        html(response, 404, page('<h1>Task not found</h1>'));\\n        return;\\n      }\\n      const data = await readForm();\\n      const filter = taskFilter(data.get('filter'));\\n      if (project.archived) {\\n        html(response, 403, detailPage(project, filter, 'Archived project is read-only'));\\n        return;\\n      }\\n      const dueDate = (data.get('dueDate') || '').trim();\\n      if (dueDate && !validDueDate(dueDate)) {\\n        html(response, 400, detailPage(project, filter, 'Due date must be a valid YYYY-MM-DD date'));\\n        return;\\n      }\\n      setTaskDueDate.run(dueDate, task, id);\\n      response.writeHead(303, { Location: detailLocation(id, filter) });\\n      response.end();\\n    } else if (request.method === 'POST' && /^\\\\/projects\\\\/\\\\d+\\\\/tasks\\\\/\\\\d+\\\\/priority$/.test(url.pathname)) {\"}]}"}

