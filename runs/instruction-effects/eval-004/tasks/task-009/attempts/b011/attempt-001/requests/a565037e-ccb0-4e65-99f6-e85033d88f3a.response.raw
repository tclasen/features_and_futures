data: {"type":"response.function_call_arguments.done","arguments":"{\"path\":\"server.js\",\"edits\":[{\"oldText\":\"try { db.exec(\\\"ALTER TABLE projects ADD COLUMN default_priority TEXT NOT NULL DEFAULT 'Normal'\\\"); } catch (error) { if (!String(error.message).includes('duplicate column')) throw error; }\\n\",\"newText\":\"try { db.exec(\\\"ALTER TABLE projects ADD COLUMN default_priority TEXT NOT NULL DEFAULT 'Normal'\\\"); } catch (error) { if (!String(error.message).includes('duplicate column')) throw error; }\\ntry { db.exec('ALTER TABLE tasks ADD COLUMN due_date TEXT'); } catch (error) { if (!String(error.message).includes('duplicate column')) throw error; }\\n\"},{\"oldText\":\"SELECT id, project_id AS projectId, title, completed, priority FROM tasks WHERE project_id=? ORDER BY created_at,rowid\",\"newText\":\"SELECT id, project_id AS projectId, title, completed, priority, due_date AS dueDate FROM tasks WHERE project_id=? ORDER BY created_at,rowid\"},{\"oldText\":\"  const taskMatch = url.pathname.match(/^\\\\/api\\\\/tasks\\\\/([^/]+)$/);\",\"newText\":\"  const dueDateMatch = url.pathname.match(/^\\\\/api\\\\/tasks\\\\/([^/]+)\\\\/due-date$/);\\n  if (req.method === 'PATCH' && dueDateMatch) {\\n    try {\\n      const body = await bodyJson(req);\\n      const rawDate = typeof body.dueDate === 'string' ? body.dueDate.trim() : '';\\n      let dueDate = null;\\n      if (rawDate) {\\n        const match = rawDate.match(/^(\\\\\\\\d{4})-(\\\\\\\\d{2})-(\\\\\\\\d{2})$/);\\n        if (!match) return sendJson(res, 400, { error: 'Due date must be a valid YYYY-MM-DD date' });\\n        const [, yearText, monthText, dayText] = match;\\n        const year = Number(yearText), month = Number(monthText), day = Number(dayText);\\n        const days = [31, year % 4 === 0 && (year % 100 !== 0 || year % 400 === 0) ? 29 : 28, 31, 30, 31, 30, 31, 31, 30, 31, 30, 31];\\n        if (year < 1 || month < 1 || month > 12 || day < 1 || day > days[month - 1]) return sendJson(res, 400, { error: 'Due date must be a valid YYYY-MM-DD date' });\\n        dueDate = rawDate;\\n      }\\n      const result = db.prepare('UPDATE tasks SET due_date=? WHERE id=? AND project_id IN (SELECT id FROM projects WHERE archived=0)').run(dueDate, decodeURIComponent(dueDateMatch[1]));\\n      return result.changes ? sendJson(res, 200, { ok: true }) : sendJson(res, 404, { error: 'Active task not found' });\\n    } catch { return sendJson(res, 400, { error: 'Invalid request' }); }\\n  }\\n  const taskMatch = url.pathname.match(/^\\\\/api\\\\/tasks\\\\/([^/]+)$/);\"}]}","item_id":"fc_002caee34a0fbcea016aca37b478d081959261c887b64941d5","output_index":1,"sequence_number":703}

