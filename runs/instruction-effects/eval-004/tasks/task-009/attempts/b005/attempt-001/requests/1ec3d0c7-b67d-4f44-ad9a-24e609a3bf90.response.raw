data: {"type":"response.function_call_arguments.done","sequence_number":894,"item_id":"fc_0d6b3f0da71e872c016aca37be118487d284824d2c0df257d8","output_index":2,"arguments":"{\"path\":\"app.js\",\"edits\":[{\"oldText\":\"async function readForm(request) {\",\"newText\":\"function isValidDueDate(value) {\\n  if (!/^\\\\d{4}-\\\\d{2}-\\\\d{2}$/.test(value)) return false;\\n  const [year, month, day] = value.split('-').map(Number);\\n  if (year < 1 || month < 1 || month > 12) return false;\\n  const leapYear = year % 4 === 0 && (year % 100 !== 0 || year % 400 === 0);\\n  const daysInMonth = [31, leapYear ? 29 : 28, 31, 30, 31, 30, 31, 31, 30, 31, 30, 31];\\n  return day >= 1 && day <= daysInMonth[month - 1];\\n}\\n\\nasync function readForm(request) {\"},{\"oldText\":\"  const priorities = ['Low', 'Normal', 'High'];\\n  const listTasks = database.prepare('SELECT id, title, completed, priority FROM tasks WHERE project_id = ? ORDER BY id');\",\"newText\":\"  if (!database.prepare('PRAGMA table_info(tasks)').all().some(column => column.name === 'due_date')) {\\n    database.exec(\\\"ALTER TABLE tasks ADD COLUMN due_date TEXT NOT NULL DEFAULT ''\\\");\\n  }\\n  const priorities = ['Low', 'Normal', 'High'];\\n  const listTasks = database.prepare('SELECT id, title, completed, priority, due_date FROM tasks WHERE project_id = ? ORDER BY id');\\n  const setTaskDueDate = database.prepare('UPDATE tasks SET due_date = ? WHERE id = ? AND project_id = ?');\"},{\"oldText\":\"      </div>`).join('');\\n    return page(project.name,\",\"newText\":\"        <form action=\\\"${path}/tasks/${task.id}/due-date\\\" method=\\\"post\\\">\\n          ${filterFields}\\n          <label for=\\\"task-due-date-${task.id}\\\">Task due date</label>\\n          <input id=\\\"task-due-date-${task.id}\\\" name=\\\"dueDate\\\" type=\\\"text\\\" value=\\\"${escapeHtml(task.due_date)}\\\"${project.archived ? ' disabled' : ''}>\\n          <button type=\\\"submit\\\"${project.archived ? ' disabled' : ''}>Save due date</button>\\n        </form>\\n      </div>`).join('');\\n    return page(project.name,\"},{\"oldText\":\"(?:rename|priority))?)?$\",\"newText\":\"(?:rename|priority|due-date))?)?$\"},{\"oldText\":\"          let result;\\n          if (Number.isSafeInteger(taskNumber)) {\",\"newText\":\"          const dueDate = (form.get('dueDate') ?? '').trim();\\n          if (action === 'due-date' && dueDate && !isValidDueDate(dueDate)) {\\n            html(response, 422, projectPage(project, filter, 'Due date must be a valid YYYY-MM-DD date', selectedPriority));\\n            return;\\n          }\\n          let result;\\n          if (Number.isSafeInteger(taskNumber)) {\"},{\"oldText\":\"              result = setTaskPriority.run(priority, taskNumber, id);\\n            } else {\",\"newText\":\"              result = setTaskPriority.run(priority, taskNumber, id);\\n            } else if (action === 'due-date') {\\n              result = setTaskDueDate.run(dueDate, taskNumber, id);\\n            } else {\"}]}"}

