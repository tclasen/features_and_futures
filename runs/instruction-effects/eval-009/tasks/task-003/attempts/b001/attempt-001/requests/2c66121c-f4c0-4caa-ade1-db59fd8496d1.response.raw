data: {"type":"response.function_call_arguments.done","arguments":"{\"path\":\"server.js\",\"edits\":[{\"oldText\":\"const listProjects = db.prepare('SELECT id, name FROM projects ORDER BY id');\\nconst getProject = db.prepare('SELECT id, name FROM projects WHERE id = ?');\",\"newText\":\"// Upgrade databases created before project archiving was introduced.\\nif (!db.prepare('PRAGMA table_info(projects)').all().some((column) => column.name === 'archived')) {\\n  db.exec('ALTER TABLE projects ADD COLUMN archived INTEGER NOT NULL DEFAULT 0 CHECK (archived IN (0, 1))');\\n}\\nconst listProjects = db.prepare(`SELECT p.id, p.name, p.archived,\\n  COUNT(t.id) AS total, COALESCE(SUM(t.completed), 0) AS completed\\n  FROM projects p LEFT JOIN tasks t ON t.project_id = p.id\\n  WHERE p.archived = ? GROUP BY p.id ORDER BY p.id`);\\nconst getProject = db.prepare('SELECT id, name, archived FROM projects WHERE id = ?');\\nconst setArchived = db.prepare('UPDATE projects SET archived = ? WHERE id = ?');\"},{\"oldText\":\"function projectList(error = '') {\\n  const projects = listProjects.all();\",\"newText\":\"function projectList(error = '', filter = 'Active') {\\n  const projects = listProjects.all(filter === 'Archived' ? 1 : 0);\"},{\"oldText\":\"    ${projects.length ? `<ul>${projects.map((project) => `\",\"newText\":\"    <form class=\\\"task-filter\\\" action=\\\"/\\\" method=\\\"get\\\">\\n      <label for=\\\"project-filter\\\">Project filter</label>\\n      <select id=\\\"project-filter\\\" name=\\\"filter\\\" onchange=\\\"this.form.requestSubmit()\\\">\\n        ${['Active', 'Archived'].map((option) => `<option${filter === option ? ' selected' : ''}>${option}</option>`).join('')}\\n      </select>\\n    </form>\\n    ${projects.length ? `<ul>${projects.map((project) => `\"},{\"oldText\":\"        <span>${escapeHtml(project.name)}</span>\\n        <form action=\\\"/projects/${project.id}\\\" method=\\\"get\\\"><button type=\\\"submit\\\">Open project</button></form>\",\"newText\":\"        <span>${escapeHtml(project.name)}</span>\\n        <span data-testid=\\\"project-summary\\\">${project.completed}/${project.total} completed</span>\\n        <form action=\\\"/projects/${project.id}\\\" method=\\\"get\\\"><button type=\\\"submit\\\">Open project</button></form>\\n        <form action=\\\"/projects/${project.id}/${project.archived ? 'restore' : 'archive'}\\\" method=\\\"post\\\"><button type=\\\"submit\\\">${project.archived ? 'Restore' : 'Archive'} project</button></form>\"},{\"oldText\":\"    <form action=\\\"/\\\" method=\\\"get\\\"><button type=\\\"submit\\\">Projects</button></form>\\n    ${error\",\"newText\":\"    <form action=\\\"/\\\" method=\\\"get\\\"><button type=\\\"submit\\\">Projects</button></form>\\n    ${project.archived ? '<p>Archived project</p>' : ''}\\n    ${error\"},{\"oldText\":\"<button type=\\\"submit\\\">Create task</button>\",\"newText\":\"<button type=\\\"submit\\\"${project.archived ? ' disabled' : ''}>Create task</button>\"},{\"oldText\":\"${task.completed ? ' checked' : ''} onchange\",\"newText\":\"${task.completed ? ' checked' : ''}${project.archived ? ' disabled' : ''} onchange\"},{\"oldText\":\"sendHtml(response, 200, projectList());\",\"newText\":\"sendHtml(response, 200, projectList('', searchParams.get('filter') === 'Archived' ? 'Archived' : 'Active'));\"},{\"oldText\":\"    } else if (request.method === 'GET' && /^\\\\/projects\\\\/\\\\d+$/.test(pathname)) {\",\"newText\":\"    } else if (request.method === 'POST' && /^\\\\/projects\\\\/\\\\d+\\\\/(archive|restore)$/.test(pathname)) {\\n      const [, , projectId, action] = pathname.split('/');\\n      if (!getProject.get(projectId)) {\\n        sendHtml(response, 404, page('Not found', '<h1>Project not found</h1>'));\\n        return;\\n      }\\n      setArchived.run(action === 'archive' ? 1 : 0, projectId);\\n      response.writeHead(303, { Location: action === 'archive' ? '/' : '/?filter=Archived' });\\n      response.end();\\n    } else if (request.method === 'GET' && /^\\\\/projects\\\\/\\\\d+$/.test(pathname)) {\"},{\"oldText\":\"      const filter = taskFilter(form.get('filter'));\\n      if (taskId) {\",\"newText\":\"      const filter = taskFilter(form.get('filter'));\\n      if (project.archived) {\\n        sendHtml(response, 403, projectPage(project, filter, 'Archived project'));\\n        return;\\n      }\\n      if (taskId) {\"},{\"oldText\":\"    button:hover { background: #193c94; }\",\"newText\":\"    button:hover { background: #193c94; }\\n    button:disabled { background: #8b98aa; cursor: not-allowed; }\\n    li { flex-wrap: wrap; }\"}]}","item_id":"fc_07ca6795fffada9a016acaabf822a88195a670a7dfbb214b02","output_index":0,"sequence_number":1154}

