data: {"type":"response.function_call_arguments.done","sequence_number":770,"item_id":"fc_0d95f8f93d5e5f5b016acab60eeb5c8194b4c309cb1f33db50","output_index":0,"arguments":"{\"path\":\"server.js\",\"edits\":[{\"oldText\":\"const priorities = ['Low', 'Normal', 'High'];\\nconst listTasks = db.prepare('SELECT id, title, completed, priority, due_date FROM tasks WHERE project_id = ? ORDER BY id');\",\"newText\":\"// Preserve legacy creation order while allowing moved tasks to append to a project.\\nif (!db.prepare('PRAGMA table_info(tasks)').all().some((column) => column.name === 'position')) {\\n  db.exec('ALTER TABLE tasks ADD COLUMN position INTEGER NOT NULL DEFAULT 0; UPDATE tasks SET position = id');\\n}\\nconst priorities = ['Low', 'Normal', 'High'];\\nconst listTasks = db.prepare('SELECT id, title, completed, priority, due_date FROM tasks WHERE project_id = ? ORDER BY position, id');\\nconst moveTask = db.prepare(`UPDATE tasks SET project_id = ?,\\n  position = (SELECT COALESCE(MAX(position), 0) + 1 FROM tasks WHERE project_id = ?)\\n  WHERE id = ? AND project_id = ?`);\"},{\"oldText\":\"const createTask = db.prepare('INSERT INTO tasks (project_id, title, priority) VALUES (?, ?, ?)');\",\"newText\":\"const createTask = db.prepare(`INSERT INTO tasks (project_id, title, priority, position)\\n  SELECT ?, ?, ?, COALESCE(MAX(position), 0) + 1 FROM tasks WHERE project_id = ?`);\"},{\"oldText\":\"  const tasks = listTasks.all(project.id).filter((task) =>\",\"newText\":\"  const destinations = listProjects.all(0).filter((destination) => destination.id !== project.id);\\n  const moveDisabled = project.archived || destinations.length === 0;\\n  const tasks = listTasks.all(project.id).filter((task) =>\"},{\"oldText\":\"        <form action=\\\"/projects/${project.id}/tasks/${task.id}/rename\\\" method=\\\"post\\\">\",\"newText\":\"        <form action=\\\"/projects/${project.id}/tasks/${task.id}/move\\\" method=\\\"post\\\">\\n          <label for=\\\"destination-project-${task.id}\\\">Destination project</label>\\n          ${filterFields}\\n          <select id=\\\"destination-project-${task.id}\\\" name=\\\"destination\\\"${moveDisabled ? ' disabled' : ''}>\\n            ${destinations.map((destination) => `<option value=\\\"${destination.id}\\\">${escapeHtml(destination.name)}</option>`).join('')}\\n          </select>\\n          <button type=\\\"submit\\\"${moveDisabled ? ' disabled' : ''}>Move task</button>\\n        </form>\\n        <form action=\\\"/projects/${project.id}/tasks/${task.id}/rename\\\" method=\\\"post\\\">\"},{\"oldText\":\"(?:rename|priority|due-date)\",\"newText\":\"(?:rename|priority|due-date|move)\"},{\"oldText\":\"        if (action === 'rename') {\",\"newText\":\"        if (action === 'move') {\\n          const destination = getProject.get(form.get('destination') || '');\\n          if (!destination || destination.archived || destination.id === project.id) {\\n            sendHtml(response, 400, projectPage(project, filter, 'Destination must be another active project', prioritySelection, range));\\n            return;\\n          }\\n          result = moveTask.run(destination.id, destination.id, taskId, project.id);\\n        } else if (action === 'rename') {\"},{\"oldText\":\"        createTask.run(project.id, title, project.default_priority);\",\"newText\":\"        createTask.run(project.id, title, project.default_priority, project.id);\"}]}"}

