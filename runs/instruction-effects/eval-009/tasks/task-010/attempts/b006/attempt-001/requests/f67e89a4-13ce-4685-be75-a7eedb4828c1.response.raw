,"input_tokens":242,"output_tokens":0},"rs_0108b74c42d228dd016acab4ec945c8195b433a297dcd5eae6":{"cache_write_tokens":0,"cached_tokens":0,"input_tokens":2,"output_tokens":60},"msg_0108b74c42d228dd016acab4ee2fa08195b866dc7a626127d9":{"cache_write_tokens":0,"cached_tokens":0,"content":[{"cache_write_tokens":0,"cached_tokens":0,"input_tokens":0,"output_tokens":50}],"input_tokens":0,"output_tokens":50},"ctc_0108b74c42d228dd016acab4ef2eec81959259e2edc8f6ac4c":{"cache_write_tokens":0,"cached_tokens":0,"input_tokens":0,"output_tokens":2815}}},"input_tokens":28846,"input_tokens_details":{"cache_write_tokens":0,"cached_tokens":9088},"output_tokens":2925,"output_tokens_details":{"reasoning_tokens":60},"total_tokens":31771},"user":null,"metadata":{}},"sequence_number":2858}
