data: {"type":"response.completed","sequence_number":2855,"safety_buffering":false,"response":{"id":"resp_08cb1c34bc1221a3016acab4fb1130819386aadef7cea7d3d6","object":"response","created_at":1791669499,"completed_at":1791669545,"status":"completed","background":false,"frequency_penalty":0.0,"presence_penalty":0.0,"moderation":null,"model":"gpt-6.1-sol","access_programs":{"cyber":"standard"},"previous_response_id":null,"instructions":null,"output":[{"type":"reasoning","id":"rs_08cb1c34bc1221a3016acab50254208193aedec8c4a2be45f9","metadata":{"turn_id":"01a127d2-2248-7c12-9cbe-115f6c1df677"},"internal_chat_message_metadata_passthrough":{"turn_id":"01a127d2-2248-7c12-9cbe-115f6c1df677"},"summary":[],"content":[],"encrypted_content":"gAAAAABqyrUCYYeuFgbnpaVdMaaIAmal5VYZdLrTTfI6skAVsM4bmHRLm4mf2t1ofakBqS4itPPfd1K4Ayb1LxbPlc3TaQdwJEURh5Q7BaJnm0mc6rSYEeUqI1J6cLSz02Su_iOmkIBQ8eQIz0SrOHPGvrJC1odO_nfVvIkDYActnisisrgrxahW5AEgTgFcLhSH8YSehM3gDqzJ3C9Dtm7SCtCKzxaAhyeYeGnhZiTvHo11rxR1RCPBKzVvvCQMojEARRAN3ptMf3su98z_SXP6lQtmqUg3i-vFdDyv99vGdwXSORfQ49-QJV6B7lEyN1U7hsZkY7Wnqjv9RaGNa0QI_wernnAxmLHhe8PuNcFjk0e1Fz0cjh6W8Ubx69OLHO8KMZiT_6GiWgRhJL86Jem8eHs4Vnanpu3yz9k0MXTZEFXTWH5Qv62KjZ6HeT0rRxZIe1Qjay2Z0tU7rSHkmdBWW0O7gxgHFK6be1cwrc6rHiLBja2wVbv-oevHuEtlTxwtYc9-04oyzzWj7WValwG7ARxh4cg3L3Fyg-O27PxDDkfuNLqHJz_kLTAlmovkRWB-KGDZFCF-jb1yrtDYf6LWYJ-Xemqm9ND6cG---Gk0OFMOjES-a01L4IU1AlgjFZm4RjBsXdvQvs-n-u7z8Nu1duck1j5P3Wy0D7tKfekfkzSDBk2bvZ3F-3Auzc0uqexbFZ7_3hGWc5OTy7xE5Z3ZCfbcfDuoZWJyL2RGBIZ191wxjAM1GWJJd2PfmA3FYTmb2dmkP6sTSIAcnvhRGBGbr_-J9mgtOEtp0b_qBQhp663W8o2K60KxHN0nd0i9xgice709pLdUXRwt-sSHI9C3Vcjqivw2HvZZFiQc0i2EzoMb-SNWVtE_tkNAqJiylFiP0vWwH3Tli5KiYVIsf60tFybkaGVOZInT3FmwFYzlYZiBG00kvWvbSomTTMA6QmS7K_qZXJ1o8--60xxs6lKWeN4qxSc_-XMbZVQ4RWUT74ACBlpGoi4JHh1VUi1pXvtaaCOFoRs64wgXalYx1nQ4_Ps-ezMq9U80hBeDZi9Odz5LDhfbUfgsnDgDWVmFj_Kl0Kl7l9bRxctIwmLSp7cl7vvjyjZNNh0NGgvPzLBrM7AN8-1mEt9WrjeZFKqcwSegK4rNw_DJRR8D4I80_e5UI7uCmwcwihrg4wgfY8OUuEPAVdF2FXpX2Ss6lrulz2Uj_o-m5VyCvpdy-tVmBtIKmjzPtJeBKYFKtDajwxFSST