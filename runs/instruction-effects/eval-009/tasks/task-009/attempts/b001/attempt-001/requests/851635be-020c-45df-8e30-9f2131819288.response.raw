data: {"type":"response.function_call_arguments.done","sequence_number":896,"item_id":"fc_0ffab57cf5e81a2e016acab3ad952c81908ff9c1974567c2e7","output_index":2,"arguments":"{\"path\":\"server.js\",\"edits\":[{\"oldText\":\"const priorities = ['Low', 'Normal', 'High'];\\nconst listTasks = db.prepare('SELECT id, title, completed, priority FROM tasks WHERE project_id = ? ORDER BY id');\",\"newText\":\"if (!db.prepare('PRAGMA table_info(tasks)').all().some((column) => column.name === 'due_date')) {\\n  db.exec(\\\"ALTER TABLE tasks ADD COLUMN due_date TEXT NOT NULL DEFAULT ''\\\");\\n}\\nconst priorities = ['Low', 'Normal', 'High'];\\nconst listTasks = db.prepare('SELECT id, title, completed, priority, due_date FROM tasks WHERE project_id = ? ORDER BY id');\\nconst setTaskDueDate = db.prepare('UPDATE tasks SET due_date = ? WHERE id = ? AND project_id = ?');\"},{\"oldText\":\"function projectUrl(id, filter, priority) {\",\"newText\":\"function validDueDate(value) {\\n  if (!/^\\\\d{4}-\\\\d{2}-\\\\d{2}$/.test(value)) return false;\\n  const [year, month, day] = value.split('-').map(Number);\\n  if (year < 1 || month < 1 || month > 12) return false;\\n  const leapYear = year % 4 === 0 && (year % 100 !== 0 || year % 400 === 0);\\n  const days = [31, leapYear ? 29 : 28, 31, 30, 31, 30, 31, 31, 30, 31, 30, 31];\\n  return day >= 1 && day <= days[month - 1];\\n}\\n\\nfunction projectUrl(id, filter, priority) {\"},{\"oldText\":\"        <form action=\\\"/projects/${project.id}/tasks/${task.id}/rename\\\" method=\\\"post\\\">\",\"newText\":\"        <form action=\\\"/projects/${project.id}/tasks/${task.id}/due-date\\\" method=\\\"post\\\">\\n          <label for=\\\"task-due-date-${task.id}\\\">Task due date</label>\\n          ${filterFields}\\n          <div class=\\\"create-fields\\\">\\n            <input id=\\\"task-due-date-${task.id}\\\" name=\\\"dueDate\\\" type=\\\"text\\\" value=\\\"${escapeHtml(task.due_date)}\\\" autocomplete=\\\"off\\\"${project.archived ? ' disabled' : ''}>\\n            <button type=\\\"submit\\\"${project.archived ? ' disabled' : ''}>Save due date</button>\\n          </div>\\n        </form>\\n        <form action=\\\"/projects/${project.id}/tasks/${task.id}/rename\\\" method=\\\"post\\\">\"},{\"oldText\":\"/^\\\\/projects\\\\/\\\\d+\\\\/tasks(?:\\\\/\\\\d+(?:\\\\/(?:rename|priority))?)?$/\",\"newText\":\"/^\\\\/projects\\\\/\\\\d+\\\\/tasks(?:\\\\/\\\\d+(?:\\\\/(?:rename|priority|due-date))?)?$/\"},{\"oldText\":\"        } else if (action === 'priority') {\",\"newText\":\"        } else if (action === 'due-date') {\\n          const dueDate = (form.get('dueDate') || '').trim();\\n          if (dueDate && !validDueDate(dueDate)) {\\n            sendHtml(response, 400, projectPage(project, filter, 'Due date must be a valid YYYY-MM-DD date', prioritySelection));\\n            return;\\n          }\\n          result = setTaskDueDate.run(dueDate, taskId, project.id);\\n        } else if (action === 'priority') {\"}]}"}

